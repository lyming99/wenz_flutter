    final origin = pivot ?? bounds.center;
    return copyWith(
      points: [for (final point in points) scalePoint(point, factor, origin)],
      style: style.copyWith(strokeWidth: style.strokeWidth * factor.abs()),
      headSize: headSize * factor.abs(),
