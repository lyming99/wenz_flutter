import 'dart:math' as math;

import 'package:flutter/widgets.dart';

import '../canvas/paint_style.dart';
import '../utils/math_utils.dart';
import 'canvas_element.dart';
import 'element_renderer.dart';

/// A quadratic Bézier curve defined by a start point, an end point and a
/// single control point.
@immutable
class CurveElement extends CanvasElement {
  const CurveElement({
    required this.id,
    required this.start,
    required this.end,
    required this.control,
    this.style = const PaintStyle(),
    this.endArrow = false,
    this.headSize = 14,
    this.layerId = 'default',
    this.visible = true,
    this.opacity = 1,
    this.zIndex = 0,
    this.groupId,
  });

  static const elementType = 'curve';

  @override
  final String id;

  final Offset start;
  final Offset end;
  final Offset control;
  final PaintStyle style;
  final bool endArrow;
  final double headSize;

  @override
  final String layerId;

  @override
  final bool visible;

  @override
  final double opacity;

  @override
  final int zIndex;

  @override
  final String? groupId;

  @override
  String get type => elementType;

  /// Sample the quadratic Bézier at parameter [t] (0 → start, 1 → end).
  Offset pointAt(double t) {
    final u = 1 - t;
    return Offset(
      u * u * start.dx + 2 * u * t * control.dx + t * t * end.dx,
      u * u * start.dy + 2 * u * t * control.dy + t * t * end.dy,
    );
  }

  /// Approximate bounds by sampling the curve plus the control point.
  @override
  Rect get bounds {
    // The convex hull of start, control, end contains the curve.
    final allPoints = [start, control, end];
    return boundsForPoints(allPoints).inflate(
      math.max(style.strokeWidth / 2, endArrow ? headSize : 0.0),
    );
  }

  @override
  bool hitTest(Offset worldPoint, {double tolerance = 5.0}) {
    final threshold = tolerance + style.strokeWidth / 2;
    // Sample the curve densely for hit testing.
    const steps = 32;
    Offset? prev;
    for (var i = 0; i <= steps; i++) {
      final p = pointAt(i / steps);
      if (prev != null && distanceToSegment(worldPoint, prev, p) <= threshold) {
        return true;
      }
      prev = p;
    }
    if (endArrow) {
      final direction = endTangentDirection;
      if (direction == null) {
        return false;
      }
      final angle = math.atan2(direction.dy, direction.dx);
      final wingA = angle + math.pi * 0.82;
      final wingB = angle - math.pi * 0.82;
      final tip1 = end + Offset(math.cos(wingA), math.sin(wingA)) * headSize;
      final tip2 = end + Offset(math.cos(wingB), math.sin(wingB)) * headSize;
      return distanceToSegment(worldPoint, end, tip1) <= threshold ||
          distanceToSegment(worldPoint, end, tip2) <= threshold;
    }
    return false;
  }

  Offset? get endTangentDirection {
    final direct = end - control;
    if (direct.distance >= 0.1) {
      return direct;
    }
    const steps = 32;
    for (var i = steps - 1; i >= 0; i--) {
      final candidate = pointAt(i / steps);
      final direction = end - candidate;
      if (direction.distance >= 0.1) {
        return direction;
      }
    }
    return null;
  }

  @override
  CurveElement copyWith({
    String? id,
    Offset? start,
    Offset? end,
    Offset? control,
    PaintStyle? style,
    bool? endArrow,
    double? headSize,
    String? layerId,
    bool? visible,
    double? opacity,
    int? zIndex,
    Object? groupId = _unset,
  }) {
    return CurveElement(
      id: id ?? this.id,
      start: start ?? this.start,
      end: end ?? this.end,
      control: control ?? this.control,
      style: style ?? this.style,
      endArrow: endArrow ?? this.endArrow,
      headSize: headSize ?? this.headSize,
      layerId: layerId ?? this.layerId,
      visible: visible ?? this.visible,
      opacity: opacity ?? this.opacity,
      zIndex: zIndex ?? this.zIndex,
      groupId: identical(groupId, _unset)
          ? this.groupId
          : groupId as String?,
    );
  }

  @override
  CurveElement translate(Offset delta) {
    return copyWith(
      start: start + delta,
      end: end + delta,
      control: control + delta,
    );
  }

  @override
  CurveElement scaleElement(double factor, {Offset? pivot}) {
    final origin = pivot ?? bounds.center;
    return copyWith(
      start: scalePoint(start, factor, origin),
      end: scalePoint(end, factor, origin),
      control: scalePoint(control, factor, origin),
      style: style.copyWith(strokeWidth: style.strokeWidth * factor.abs()),
      headSize: headSize * factor.abs(),
    );
  }

  @override
  Map<String, dynamic> toJson() {
    return {
      'id': id,
      'type': type,
      'layerId': layerId,
      'visible': visible,
      'opacity': opacity,
      'zIndex': zIndex,
      'groupId': groupId,
      'start': {'x': start.dx, 'y': start.dy},
      'end': {'x': end.dx, 'y': end.dy},
      'control': {'x': control.dx, 'y': control.dy},
      'style': style.toJson(),
      'endArrow': endArrow,
      'headSize': headSize,
    };
  }

  static const _unset = Object();
}

class CurveElementRenderer extends ElementRenderer<CurveElement> {
  const CurveElementRenderer();

  @override
  void render(Canvas canvas, CurveElement element) {
    if (!element.visible) return;
    final paint = element.style
        .copyWith(opacity: element.style.opacity * element.opacity)
        .toPaint();
    final path = Path()
      ..moveTo(element.start.dx, element.start.dy)
      ..quadraticBezierTo(
        element.control.dx,
        element.control.dy,
        element.end.dx,
        element.end.dy,
      );
    canvas.drawPath(path, paint);
    if (element.endArrow) {
      _drawArrowHead(canvas, element, paint);
    }
  }

  void _drawArrowHead(
    Canvas canvas,
    CurveElement element,
    Paint paint,
  ) {
    final direction = element.endTangentDirection;
    if (direction == null) {
      return;
    }
    final angle = math.atan2(direction.dy, direction.dx);
    final wingA = angle + math.pi * 0.82;
    final wingB = angle - math.pi * 0.82;
    final tip1 =
        element.end +
        Offset(math.cos(wingA), math.sin(wingA)) * element.headSize;
    final tip2 =
        element.end +
        Offset(math.cos(wingB), math.sin(wingB)) * element.headSize;

    final arrowPath = Path()
      ..moveTo(element.end.dx, element.end.dy)
      ..lineTo(tip1.dx, tip1.dy)
      ..moveTo(element.end.dx, element.end.dy)
      ..lineTo(tip2.dx, tip2.dy);
    canvas.drawPath(arrowPath, paint);
  }

  @override
  bool hitTest(CurveElement element, Offset worldPoint, double tolerance) {
    return element.hitTest(worldPoint, tolerance: tolerance);
  }
}


