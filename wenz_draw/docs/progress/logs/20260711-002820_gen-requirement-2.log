    }
    if (_editingShapeLabelElementId == id) {
      return;
    }
    _editingShapeLabelElementId = id;
    _editingShapeLabelOriginal = element;
    select(id);
  }

  void updateEditingShapeLabel(String text, {bool clearWhenEmpty = true}) {
    final id = _editingShapeLabelElementId;
