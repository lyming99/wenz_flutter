+++ b/wenz_draw/docs/plan/plan_spec_requirement_2_20260711-002820.json
@@ -0,0 +1,40 @@
+{
+  "title": "修复文字编辑悬浮工具栏的焦点与字体样式设置",
+  "summary": "当前文字编辑覆盖层已经提供预设颜色、自定义颜色、字号和字体族控件，但悬浮工具栏以固定 320 像素宽度渲染，画布指针处理却按文字元素自身宽度估算工具栏命中区，窄文本或不同缩放下点击工具栏两侧会被误判为点击编辑区外；同时 TextField 失焦会立即提交编辑，打开下拉菜单或颜色对话框时也可能提前结束编辑，导致颜色、字号等样式无法可靠设置。需要统一悬浮栏的布局与命中边界，区分工具栏内部的临时焦点转移和真正离开编辑区，并保证 TextElement 与可编辑图形标签的样式更新、焦点恢复、提交和撤销形成一致链路。",
+  "tasks": [
+    {
+      "title": "修复文字编辑悬浮工具栏的命中边界与焦点生命周期",
+      "scope": [
+        "lib/src/infinite_canvas/infinite_canvas_widget.dart"
+      ],
+      "acceptance": [
+        "悬浮工具栏的可交互命中区域与实际固定宽度、位置和当前画布缩放保持一致；即使文字框很窄，点击预设颜色、调色板、字号或字体族控件的任意可见区域也不会被画布误判为外部点击并结束编辑。",
+        "TextField 自动聚焦后，打开字号或字体族下拉菜单、打开或关闭自定义颜色对话框等工具栏内部焦点转移不会提前提交编辑；完成选择或取消弹层后输入焦点能够安全返回编辑框，编辑标识和当前文本保持有效。",
+        "预设颜色、自定义颜色、字号和字体族选择会立即刷新当前 TextElement 或可编辑图形标签的显示与模型样式，连续修改多个样式时悬浮工具栏持续可用并正确反映当前值。",
+        "只有提交输入或点击文字编辑区域与悬浮工具栏之外的位置才结束编辑；一次编辑会话中的文字与字体样式变更作为一次可撤销修改提交，不会因弹层焦点变化重复提交、遗漏历史记录或访问已释放的 FocusNode。"
+      ]
+    },
+    {
+      "title": "补充文字编辑悬浮工具栏交互的 Widget 回归覆盖",
+      "scope": [
+        "test/infinite_canvas_text_editing_test.dart"
+      ],
+      "acceptance": [
+        "覆盖窄文字元素在常规缩放和非 1.0 缩放下进入编辑后点击悬浮栏边缘控件的场景，验证编辑状态不会被画布指针处理提前终止。",
+        "覆盖预设颜色、字号、字体族以及自定义颜色弹层的选择或取消流程，验证样式写入当前元素、工具栏状态同步且输入焦点能够恢复。",
+        "覆盖共享编辑覆盖层处理独立文字元素和可编辑图形标签的场景，验证两类目标均可在不退出编辑的情况下修改字体样式。",
+        "覆盖真正点击编辑区外后只提交一次以及撤销恢复编辑前文字和样式的场景，并验证工具栏弹层关闭、组件重建和焦点节点释放过程中没有异常。"
+      ]
+    }
+  ],
+  "finalValidation": {
+    "command": "flutter analyze && flutter test",
+    "criteria": [
+      "Flutter 静态分析无新增错误或警告，完整测试套件全部通过。",
+      "文字输入框进入编辑后，悬浮工具栏所有可见区域在窄文本、不同字号和不同画布缩放下均可正常交互，不会触发误提交或画布工具操作。",
+      "预设颜色、自定义颜色、字号和字体族均可连续设置并即时显示，关闭下拉菜单或颜色对话框后仍可继续输入文字。",
+      "独立 TextElement 与支持标签编辑的图形均保持一致的字体设置体验，样式结果在结束编辑后保留。",
+      "点击真正的编辑区外或显式提交会结束编辑且仅产生一次可撤销历史记录，撤销可恢复会话开始前的文字与样式，焦点切换和组件销毁期间无异常。"
+    ]
+  }
+}

