                      children: [
                        for (final color in inspectorSwatches)
                          ColorSwatch(
                            color: color,
                            selected: selectedStroke == color,
                            onPressed: canEditPaint(selected)
                                ? () => canvasController.updateShapePaint(
                                    selected!.id,
                                    strokeColor: color,
                                  )
                                : () {
                                    canvasController.updateBrushSettings(
