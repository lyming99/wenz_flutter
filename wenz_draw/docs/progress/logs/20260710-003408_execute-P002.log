                              : () => showShapeColorPicker(
                                  context,
                                  selected,
                                  canvasController,
                                  fill: true,
                                ),
                        ),
                        ColorButtonField(
                          label: '描边',
                          color: selectedStroke,
                          enabled: canEditPaint(selected),
                          onPressed: selected == null
                              ? null
                              : () => showShapeColorPicker(
                                  context,
                                  selected,
                                  canvasController,
                                  fill: false,
                                ),
                        ),
                      ],
                    ),
                    const SizedBox(height: 12),
                    SliderField(
                      label: '描边宽度',
                      value: selectedStrokeWidth,
                      min: 1,
