                        canvasController.reorderLayer(oldIndex, adjusted);
                      },
                      itemBuilder: (context, index) {
                        final layer = canvasController.layers[index];
                        return LayerRow(
                          key: ValueKey(layer.id),
                          layer: layer,
                          index: index,
