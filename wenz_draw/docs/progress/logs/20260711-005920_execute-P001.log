   28: Rect boundsForPoints(Iterable<Offset> points) {
   29:   final iterator = points.iterator;
   30:   if (!iterator.moveNext()) {
   31:     return Rect.zero;
   32:   }
   33: 
   34:   var minX = iterator.current.dx;
   35:   var minY = iterator.current.dy;
   36:   var maxX = iterator.current.dx;
   37:   var maxY = iterator.current.dy;
   38: 
   39:   while (iterator.moveNext()) {
   40:     final point = iterator.current;
   41:     minX = math.min(minX, point.dx);
   42:     minY = math.min(minY, point.dy);
   43:     maxX = math.max(maxX, point.dx);
   44:     maxY = math.max(maxY, point.dy);
   45:   }
   46: 
   47:   return Rect.fromLTRB(minX, minY, maxX, maxY);
   48: }
