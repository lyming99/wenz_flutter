  333:   Rect _shapeLabelEditingBounds(Object? element) {
  334:     final bounds = switch (element) {
  335:       final DrawioShapeElement e => e.rect,
  336:       final RectElement e => e.labelPadding.deflateRect(e.rect),
  337:       final EllipseElement e => e.labelPadding.deflateRect(e.rect),
  338:       final LineElement e => LineLabelPainter.labelBounds(
  339:         points: [e.start, e.end],
  340:         label: e.label?.isEmpty ?? true ? ' ' : e.label,
  341:         style: e.labelStyle,
  342:         labelPosition: e.labelPosition,
  343:         labelOffset: e.labelOffset,
  344:         labelBackground: e.labelBackground,
  345:       ),
  346:       final ArrowElement e => LineLabelPainter.labelBounds(
  347:         points: [e.start, e.end],
  348:         label: e.label?.isEmpty ?? true ? ' ' : e.label,
  349:         style: e.labelStyle,
  350:         labelPosition: e.labelPosition,
  351:         labelOffset: e.labelOffset,
  352:         labelBackground: e.labelBackground,
  353:       ),
  354:       final PolylineElement e => LineLabelPainter.labelBounds(
  355:         points: e.points,
  356:         label: e.label?.isEmpty ?? true ? ' ' : e.label,
  357:         style: e.labelStyle,
  358:         labelPosition: e.labelPosition,
  359:         labelOffset: e.labelOffset,
  360:         labelBackground: e.labelBackground,
  361:       ),
  362:       _ => Rect.zero,
  363:     };
  364:     if (!bounds.isEmpty) {
  365:       return bounds;
  366:     }
  367:     final center = switch (element) {
  368:       final LineElement e => LineLabelPainter.labelCenter(
  369:         [e.start, e.end],
  370:         labelPosition: e.labelPosition,
  371:         labelOffset: e.labelOffset,
  372:       ),
  373:       final ArrowElement e => LineLabelPainter.labelCenter(
  374:         [e.start, e.end],
  375:         labelPosition: e.labelPosition,
  376:         labelOffset: e.labelOffset,
  377:       ),
  378:       final PolylineElement e => LineLabelPainter.labelCenter(
  379:         e.points,
  380:         labelPosition: e.labelPosition,
  381:         labelOffset: e.labelOffset,
  382:       ),
  383:       _ => Offset.zero,
  384:     };
  385:     return Rect.fromCenter(center: center, width: 80, height: 24);
  386:   }
