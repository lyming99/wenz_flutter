  442: 
  443:   TextElement _scaleEditingText(
  444:     TextElement before,
  445:     _EditingTextResizeHandle handle,
  446:     Offset worldAnchor,
  447:     Offset worldPoint,
  448:   ) {
  449:     final localRect = before.localBounds;
  450:     final draggedCorner = _editingTextHandleWorldPoint(before, handle);
  451:     final beforeDistance = (draggedCorner - worldAnchor).distance;
  452:     if (beforeDistance <= 0.0001) {
  453:       return before;
  454:     }
  455:     final rawFactor = (worldPoint - worldAnchor).distance / beforeDistance;
  456:     final minimumFactor = math.min(
  457:       100.0,
  458:       math.max(
  459:         0.05,
  460:         math.max(
  461:           _minEditingTextBoxWidth / localRect.width,
  462:           math.max(
  463:             _minEditingTextBoxHeight / localRect.height,
  464:             _minEditingTextFontSize /
  465:                 math.max((before.style.fontSize ?? 24).abs(), 0.0001),
  466:           ),
  467:         ),
  468:       ),
  469:     );
  470:     final factor = rawFactor.clamp(minimumFactor, 100.0).toDouble();
  471:     final scaled = before.scaleElement(
  472:       factor,
  473:       pivot: handle.anchorFor(localRect),
  474:     );
  475:     return _pinEditingTextAnchor(scaled, handle, worldAnchor);
  476:   }
  477: 
  478:   TextElement _resizeEditingTextBox(
  479:     TextElement before,
  480:     _EditingTextResizeHandle handle,
  481:     Offset worldAnchor,
  482:     Offset worldPoint,
  483:   ) {
  484:     final localRect = before.localBounds;
  485:     final localAnchor = handle.anchorFor(localRect);
  486:     final unrotatedWorldPoint = before.rotation == 0
  487:         ? worldPoint
  488:         : inverseRotatePoint(worldPoint, before.rotation, worldAnchor);
  489:     final localPoint = localAnchor + (unrotatedWorldPoint - worldAnchor);
  490:     var left = localRect.left;
  491:     var top = localRect.top;
  492:     var right = localRect.right;
  493:     var bottom = localRect.bottom;
  494: 
  495:     if (handle.isLeft) {
  496:       left = localPoint.dx.clamp(
  497:         right - 10000,
  498:         right - _minEditingTextBoxWidth,
  499:       );
  500:     }
  501:     if (handle.isRight) {
  502:       right = localPoint.dx.clamp(
  503:         left + _minEditingTextBoxWidth,
  504:         left + 10000,
  505:       );
  506:     }
  507:     if (handle.isTop) {
  508:       top = localPoint.dy.clamp(
  509:         bottom - 10000,
  510:         bottom - _minEditingTextBoxHeight,
  511:       );
  512:     }
  513:     if (handle.isBottom) {
  514:       bottom = localPoint.dy.clamp(
  515:         top + _minEditingTextBoxHeight,
  516:         top + 10000,
  517:       );
  518:     }
  519: 
  520:     final rect = Rect.fromLTRB(left, top, right, bottom);
  521:     final resized = before.copyWith(
  522:       position: rect.topLeft,
  523:       maxWidth: rect.width,
  524:       boxSize: rect.size,
  525:     );
  526:     return _pinEditingTextAnchor(resized, handle, worldAnchor);
  527:   }
  528: 
  529:   TextElement _pinEditingTextAnchor(
  530:     TextElement element,
  531:     _EditingTextResizeHandle handle,
  532:     Offset worldAnchor,
  533:   ) {
  534:     final currentAnchor = _editingTextHandleWorldPoint(
  535:       element,
  536:       handle,
  537:       anchor: true,
  538:     );
  539:     return element.translate(worldAnchor - currentAnchor);
  540:   }
