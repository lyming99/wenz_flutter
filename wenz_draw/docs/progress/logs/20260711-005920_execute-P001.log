  160:   void _handlePointerDown(PointerDownEvent event) {
  161:     // A new pointer cancels any in-flight inertial fling.
  162:     _stopFling();
  163:     _panVelocity = Offset.zero;
  164:     // If we are currently editing text, keep keyboard input in the TextField
  165:     // while pointer handling decides whether the interaction is internal.
  166:     final canvasController = widget.controller.canvasController;
  167:     final isEditing =
  168:         canvasController.editingTextElementId != null ||
  169:         canvasController.editingShapeLabelElementId != null;
  170:     if (!isEditing) {
  171:       _focusNode.requestFocus();
  172:     }
  173:     // Right-click and middle-click are reserved for panning — never dispatch
  174:     // to the active drawing tool.
  175:     if (event.buttons == kSecondaryMouseButton ||
  176:         event.buttons == kMiddleMouseButton) {
  177:       _pointers[event.pointer] = event.localPosition;
  178:       _panPointers.add(event.pointer);
  179:       return;
  180:     }
  181:     if (_handleEditingPointerDown(event)) {
  182:       return;
  183:     }
  184:     if (_dispatchDoubleTapIfNeeded(event)) {
  185:       return;
  186:     }
  187:     if (_shouldDeferToWidget(event.localPosition)) {
  188:       _widgetGesturePointers.add(event.pointer);
  189:       _deferredWidgetGestures[event.pointer] = _DeferredWidgetGesture(
  190:         screenPoint: event.localPosition,
  191:         kind: event.kind,
  192:         buttons: event.buttons,
  193:         pressure: event.pressure,
  194:       );
  195:       return;
  196:     }
  197: 
  198:     _pointers[event.pointer] = event.localPosition;
  199:     if (_pointers.length > 1) {
  200:       _toolSuppressedUntilClear = true;
  201:       widget.controller.canvasController.cancelCurrentInteraction();
  202:       if (widget.config.enablePinch) {
  203:         _updatePinchBaseline();
  204:       }
  205:       return;
  206:     }
  207: 
  208:     if (_toolSuppressedUntilClear) {
  209:       return;
  210:     }
  211: 
  212:     final worldPoint = widget.controller.screenToWorld(event.localPosition);
  213:     if (canvasController.currentTool?.id == TextTool.idValue) {
  214:       final hit = canvasController.hitTest(worldPoint);
  215:       if (hit is TextElement) {
  216:         canvasController.beginTextEditing(hit.id);
  217:         return;
  218:       }
  219:     }
  220:     _dispatch(
  221:       CanvasPointerDownEvent(
  222:         screenPoint: event.localPosition,
  223:         worldPoint: worldPoint,
  224:         transform: widget.controller.transform,
  225:         pointerCount: _pointers.length,
  226:         pointer: event.pointer,
  227:         kind: event.kind,
  228:         buttons: event.buttons,
  229:         pressure: event.pressure,
  230:       ),
  231:     );
  232:   }
