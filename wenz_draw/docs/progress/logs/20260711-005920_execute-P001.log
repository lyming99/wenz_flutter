  339: 
  340:   Rect _shapeLabelEditingBounds(Object? element) {
  341:     final bounds = switch (element) {
  342:       final DrawioShapeElement e => e.rect,
  343:       final RectElement e => e.labelPadding.deflateRect(e.rect),
  344:       final EllipseElement e => e.labelPadding.deflateRect(e.rect),
  345:       final LineElement e => LineLabelPainter.labelBounds(
  346:         points: [e.start, e.end],
  347:         label: e.label?.isEmpty ?? true ? ' ' : e.label,
  348:         style: e.labelStyle,
  349:         labelPosition: e.labelPosition,
  350:         labelOffset: e.labelOffset,
  351:         labelBackground: e.labelBackground,
  352:       ),
  353:       final ArrowElement e => LineLabelPainter.labelBounds(
  354:         points: [e.start, e.end],
  355:         label: e.label?.isEmpty ?? true ? ' ' : e.label,
  356:         style: e.labelStyle,
  357:         labelPosition: e.labelPosition,
  358:         labelOffset: e.labelOffset,
  359:         labelBackground: e.labelBackground,
  360:       ),
  361:       final PolylineElement e => LineLabelPainter.labelBounds(
  362:         points: e.points,
  363:         label: e.label?.isEmpty ?? true ? ' ' : e.label,
  364:         style: e.labelStyle,
  365:         labelPosition: e.labelPosition,
  366:         labelOffset: e.labelOffset,
  367:         labelBackground: e.labelBackground,
  368:       ),
  369:       _ => Rect.zero,
  370:     };
  371:     if (!bounds.isEmpty) {
  372:       return bounds;
  373:     }
  374:     final center = switch (element) {
  375:       final LineElement e => LineLabelPainter.labelCenter(
  376:         [e.start, e.end],
  377:         labelPosition: e.labelPosition,
  378:         labelOffset: e.labelOffset,
  379:       ),
  380:       final ArrowElement e => LineLabelPainter.labelCenter(
  381:         [e.start, e.end],
  382:         labelPosition: e.labelPosition,
  383:         labelOffset: e.labelOffset,
  384:       ),
  385:       final PolylineElement e => LineLabelPainter.labelCenter(
  386:         e.points,
  387:         labelPosition: e.labelPosition,
  388:         labelOffset: e.labelOffset,
  389:       ),
  390:       _ => Offset.zero,
  391:     };
  392:     return Rect.fromCenter(center: center, width: 80, height: 24);
  393:   }
