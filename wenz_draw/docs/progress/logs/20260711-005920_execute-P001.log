  244: 
  245:     if (editingShapeId != null) {
  246:       return _handleShapeLabelEditingPointerDown(event, editingShapeId);
  247:     }
  248: 
  249:     final element = canvasController.elementById(editingId!);
  250:     if (element is! TextElement) {
  251:       canvasController.endTextEditing();
  252:       return true;
  253:     }
  254: 
  255:     if (_textEditingToolbarRect(element.bounds).contains(event.localPosition)) {
  256:       return true;
  257:     }
  258: 
  259:     final worldPoint = widget.controller.screenToWorld(event.localPosition);
  260:     final handle = _editingResizeHandleAt(element, worldPoint);
  261:     if (handle != null) {
  262:       _editingResizePointer = event.pointer;
  263:       _editingResizeBefore = element;
  264:       _editingResizeHandle = handle;
  265:       _editingResizeAnchor = _editingTextHandleWorldPoint(
  266:         element,
  267:         handle,
  268:         anchor: true,
  269:       );
  270:       return true;
  271:     }
  272: 
  273:     if (element.bounds
  274:         .inflate(14 / widget.controller.transform.scale)
  275:         .contains(worldPoint)) {
  276:       return true;
  277:     }
  278: 
  279:     final hit = canvasController.hitTest(worldPoint);
  280:     if (hit is TextElement) {
  281:       canvasController.endTextEditing(removeIfEmpty: false);
  282:       canvasController.beginTextEditing(hit.id);
  283:       return true;
  284:     }
  285: 
  286:     // Clicked outside the editing element — end editing and consume the event
  287:     // so that the active tool (e.g. TextTool) does not create a new element.
  288:     canvasController.endTextEditing();
  289:     return true;
  290:   }
