  414:     final handle = _editingResizeHandle;
  415:     final anchor = _editingResizeAnchor;
  416:     if (before == null || handle == null || anchor == null) {
  417:       return true;
  418:     }
  419: 
  420:     final worldPoint = widget.controller.screenToWorld(event.localPosition);
  421:     final next = handle.isCorner
  422:         ? _scaleEditingText(before, handle, anchor, worldPoint)
  423:         : _resizeEditingTextBox(before, handle, anchor, worldPoint);
  424:     widget.controller.canvasController.updateElement(
  425:       before.id,
