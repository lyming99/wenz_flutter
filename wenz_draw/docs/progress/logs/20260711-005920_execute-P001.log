  440:         (before.position != after.position ||
  441:             before.boxSize != after.boxSize)) {
  442:       widget.controller.canvasController.recordCommand(
  443:         UpdateElementCommand(
  444:           before: before,
  445:           after: after,
  446:           description: 'Resize text',
  447:         ),
  448:       );
  449:     }
  450:     _editingResizePointer = null;
  451:     _editingResizeBefore = null;
  452:     _editingResizeHandle = null;
  453:     _editingResizeAnchor = null;
  454:     return true;
  455:   }
