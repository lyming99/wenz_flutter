 2002: enum _EditingTextResizeHandle {
 2003:   topLeft,
 2004:   topRight,
 2005:   bottomLeft,
 2006:   bottomRight,
 2007:   top,
 2008:   bottom,
 2009:   left,
 2010:   right;
 2011: 
 2012:   bool get isCorner =>
 2013:       this == topLeft ||
 2014:       this == topRight ||
 2015:       this == bottomLeft ||
 2016:       this == bottomRight;
 2017:   bool get isLeft => this == topLeft || this == bottomLeft || this == left;
 2018:   bool get isRight => this == topRight || this == bottomRight || this == right;
 2019:   bool get isTop => this == topLeft || this == topRight || this == top;
 2020:   bool get isBottom =>
 2021:       this == bottomLeft || this == bottomRight || this == bottom;
