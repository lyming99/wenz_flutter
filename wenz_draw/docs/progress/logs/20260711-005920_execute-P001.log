 2023:   Offset pointFor(Rect rect) {
 2024:     return switch (this) {
 2025:       topLeft => rect.topLeft,
 2026:       topRight => rect.topRight,
 2027:       bottomLeft => rect.bottomLeft,
 2028:       bottomRight => rect.bottomRight,
 2029:       top => rect.topCenter,
 2030:       bottom => rect.bottomCenter,
 2031:       left => rect.centerLeft,
 2032:       right => rect.centerRight,
 2033:     };
 2034:   }
 2035: 
 2036:   Offset anchorFor(Rect rect) {
 2037:     return switch (this) {
 2038:       topLeft => rect.bottomRight,
 2039:       topRight => rect.bottomLeft,
 2040:       bottomLeft => rect.topRight,
 2041:       bottomRight => rect.topLeft,
 2042:       top => rect.bottomCenter,
 2043:       bottom => rect.topCenter,
 2044:       left => rect.centerRight,
 2045:       right => rect.centerLeft,
 2046:     };
 2047:   }
 2048: }
