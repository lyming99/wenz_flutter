   54: Offset rotatePoint(Offset point, double radians, Offset pivot) {
   55:   final translated = point - pivot;
   56:   final cosTheta = math.cos(radians);
   57:   final sinTheta = math.sin(radians);
   58:   return Offset(
   59:     pivot.dx + translated.dx * cosTheta - translated.dy * sinTheta,
   60:     pivot.dy + translated.dx * sinTheta + translated.dy * cosTheta,
   61:   );
   62: }
   63: 
   64: Rect rotatedRectBounds(Rect rect, double radians) {
   65:   if (radians == 0) {
   66:     return rect;
   67:   }
   68:   final center = rect.center;
   69:   return boundsForPoints([
   70:     rotatePoint(rect.topLeft, radians, center),
   71:     rotatePoint(rect.topRight, radians, center),
   72:     rotatePoint(rect.bottomRight, radians, center),
   73:     rotatePoint(rect.bottomLeft, radians, center),
   74:   ]);
   75: }
   76: 
   77: Offset inverseRotatePoint(Offset point, double radians, Offset pivot) {
   78:   return rotatePoint(point, -radians, pivot);
