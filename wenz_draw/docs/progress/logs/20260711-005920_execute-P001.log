  457:   Rect _constrainedResizeRect(
  458:     Offset anchor,
  459:     Offset worldPoint,
  460:     _EditingTextResizeHandle handle,
  461:   ) {
  462:     final rawRect = Rect.fromPoints(anchor, worldPoint);
  463:     var left = rawRect.left;
  464:     var top = rawRect.top;
  465:     var right = rawRect.right;
  466:     var bottom = rawRect.bottom;
  467:     const minWidth = 24.0;
  468:     const minHeight = 24.0;
  469: 
  470:     if (rawRect.width < minWidth) {
  471:       if (handle.isLeft) {
  472:         left = right - minWidth;
  473:       } else {
  474:         right = left + minWidth;
  475:       }
  476:     }
  477:     if (rawRect.height < minHeight) {
  478:       if (handle.isTop) {
  479:         top = bottom - minHeight;
  480:       } else {
  481:         bottom = top + minHeight;
  482:       }
  483:     }
  484:     return Rect.fromLTRB(left, top, right, bottom);
  485:   }
