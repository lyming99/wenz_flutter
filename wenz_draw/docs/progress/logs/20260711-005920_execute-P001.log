 2050: Offset _editingTextHandleWorldPoint(
 2051:   TextElement element,
 2052:   _EditingTextResizeHandle handle, {
 2053:   bool anchor = false,
 2054: }) {
 2055:   final localBounds = element.localBounds;
 2056:   final point = anchor
 2057:       ? handle.anchorFor(localBounds)
 2058:       : handle.pointFor(localBounds);
 2059:   return element.rotation == 0
 2060:       ? point
 2061:       : rotatePoint(point, element.rotation, localBounds.center);
