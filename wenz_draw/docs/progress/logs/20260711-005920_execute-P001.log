  285:   bool _handleShapeLabelEditingPointerDown(
  286:     PointerDownEvent event,
  287:     String editingShapeId,
  288:   ) {
  289:     final canvasController = widget.controller.canvasController;
  290:     final element = canvasController.elementById(editingShapeId);
  291:     if (element is! DrawioShapeElement &&
  292:         element is! RectElement &&
  293:         element is! EllipseElement &&
  294:         element is! LineElement &&
  295:         element is! ArrowElement &&
  296:         element is! PolylineElement) {
  297:       canvasController.endShapeLabelEditing();
  298:       return true;
  299:     }
  300: 
  301:     final bounds = _shapeLabelEditingBounds(element);
  302:     if (_textEditingToolbarRect(bounds).contains(event.localPosition)) {
  303:       return true;
  304:     }
  305: 
  306:     final worldPoint = widget.controller.screenToWorld(event.localPosition);
  307:     if (bounds
  308:         .inflate(14 / widget.controller.transform.scale)
  309:         .contains(worldPoint)) {
  310:       return true;
  311:     }
  312: 
  313:     // Clicked outside the editing shape — end editing and consume the event
  314:     // so that the active tool does not create/interact with a new element.
  315:     canvasController.endShapeLabelEditing();
  316:     return true;
  317:   }
