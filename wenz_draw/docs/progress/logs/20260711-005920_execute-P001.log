  319:   Rect _textEditingToolbarRect(Rect worldBounds) {
  320:     final transform = widget.controller.transform;
  321:     final screenBounds = Rect.fromPoints(
  322:       transform.worldToScreen(worldBounds.topLeft),
  323:       transform.worldToScreen(worldBounds.bottomRight),
  324:     );
  325:     return Rect.fromLTWH(
  326:       screenBounds.center.dx - _textEditingToolbarWidth / 2,
  327:       screenBounds.top - _textEditingToolbarTopOffset,
  328:       _textEditingToolbarWidth,
  329:       _textEditingToolbarHeight,
  330:     );
  331:   }
