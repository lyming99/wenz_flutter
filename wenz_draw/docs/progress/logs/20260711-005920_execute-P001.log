  395:   _EditingTextResizeHandle? _editingResizeHandleAt(
  396:     TextElement element,
  397:     Offset worldPoint,
  398:   ) {
  399:     final tolerance = 10 / widget.controller.transform.scale;
  400:     for (final handle in _EditingTextResizeHandle.values) {
  401:       if ((worldPoint - _editingTextHandleWorldPoint(element, handle)).distance <=
  402:           tolerance) {
  403:         return handle;
  404:       }
  405:     }
  406:     return null;
  407:   }
