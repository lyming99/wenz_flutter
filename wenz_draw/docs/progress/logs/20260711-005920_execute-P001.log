  664:   /// Kicks off an inertial fling from [initialVelocity] (pixels/frame at 60fps
  665:   /// reference). Decays exponentially each frame until the speed is negligible.
  666:   void _startFling(Offset initialVelocity) {
  667:     _flingTicker?.dispose();
  668:     _flingVelocity = initialVelocity;
  669:     if (_flingVelocity.distance < 2) {
  670:       return;
  671:     }
  672:     _flingTicker = Ticker(_onFlingTick);
  673:     _flingTicker!.start();
  674:   }
  675: 
  676:   void _onFlingTick(Duration elapsed) {
  677:     // Stop when the residual velocity is below a perceptible threshold.
  678:     if (_flingVelocity.distance < 0.5) {
  679:       _stopFling();
  680:       return;
  681:     }
  682:     widget.controller.pan(_flingVelocity);
  683:     // Exponential decay: friction in (0,1); higher friction = stops sooner.
  684:     // Scale friction per-frame regardless of actual frame rate.
  685:     final decay = 1.0 - widget.config.flingDecayFriction.clamp(0.0, 0.99);
  686:     _flingVelocity = _flingVelocity * decay;
  687:   }
