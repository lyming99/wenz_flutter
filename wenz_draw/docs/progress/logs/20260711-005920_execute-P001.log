  234:   bool _handleEditingPointerDown(PointerDownEvent event) {
  235:     final canvasController = widget.controller.canvasController;
  236:     final editingId = canvasController.editingTextElementId;
  237:     final editingShapeId = canvasController.editingShapeLabelElementId;
  238:     if (editingId == null && editingShapeId == null) {
  239:       return false;
  240:     }
  241: 
  242:     if (editingShapeId != null) {
  243:       return _handleShapeLabelEditingPointerDown(event, editingShapeId);
  244:     }
  245: 
  246:     final element = canvasController.elementById(editingId!);
  247:     if (element is! TextElement) {
  248:       canvasController.endTextEditing();
  249:       return true;
  250:     }
  251: 
  252:     if (_textEditingToolbarRect(element.bounds).contains(event.localPosition)) {
  253:       return true;
  254:     }
  255: 
  256:     final worldPoint = widget.controller.screenToWorld(event.localPosition);
  257:     final handle = _editingResizeHandleAt(element, worldPoint);
  258:     if (handle != null) {
  259:       _editingResizePointer = event.pointer;
  260:       _editingResizeBefore = element;
  261:       _editingResizeHandle = handle;
  262:       _editingResizeAnchor = handle.anchorFor(element.bounds);
  263:       return true;
  264:     }
  265: 
  266:     if (element.bounds
  267:         .inflate(14 / widget.controller.transform.scale)
  268:         .contains(worldPoint)) {
  269:       return true;
  270:     }
  271: 
  272:     final hit = canvasController.hitTest(worldPoint);
  273:     if (hit is TextElement) {
  274:       canvasController.endTextEditing(removeIfEmpty: false);
  275:       canvasController.beginTextEditing(hit.id);
  276:       return true;
  277:     }
  278: 
  279:     // Clicked outside the editing element — end editing and consume the event
  280:     // so that the active tool (e.g. TextTool) does not create a new element.
  281:     canvasController.endTextEditing();
  282:     return true;
  283:   }
