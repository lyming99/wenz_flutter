224:  CanvasElement _resolveSnapBoundElement(
225:    CanvasElement element,
226:    String changedElementId,
227:    Map<String, CanvasElement> elementsById,
228:  ) {
229:    if (element is LineElement) {
230:      final start = element.startBinding?.elementId == changedElementId
231:          ? _resolveSnapBindingFrom(elementsById, element.startBinding)
232:          : null;
233:      final end = element.endBinding?.elementId == changedElementId
234:          ? _resolveSnapBindingFrom(elementsById, element.endBinding)
235:          : null;
236:      if (start == null && end == null) {
237:        return element;
238:      }
239:      return element.copyWith(
240:        start: start ?? element.start,
241:        end: end ?? element.end,
242:      );
243:    }
244:    if (element is PolylineElement) {
245:      final start = element.startBinding?.elementId == changedElementId
246:          ? _resolveSnapBindingFrom(elementsById, element.startBinding)
247:          : null;
248:      final end = element.endBinding?.elementId == changedElementId
249:          ? _resolveSnapBindingFrom(elementsById, element.endBinding)
250:          : null;
251:      if (start == null && end == null || element.points.isEmpty) {
252:        return element;
253:      }
254:      final nextStart = start ?? element.start;
255:      final nextEnd = end ?? element.end;
256:      return element.copyWith(
257:        points: routeConnector(
258:          start: nextStart,
259:          end: nextEnd,
260:          startBinding: element.startBinding,
261:          endBinding: element.endBinding,
262:          connectorId: element.id,
263:          previousRoute: element.points,
264:          quality: connectorRoutingOptions.finalQuality,
265:          elementsOverride: elements,
266:        ),
267:      );
268:    }
269:    if (element is ArrowElement) {
270:      final start = element.startBinding?.elementId == changedElementId
