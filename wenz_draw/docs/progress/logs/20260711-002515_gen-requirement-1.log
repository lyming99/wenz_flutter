272:          : null;
273:      final end = element.endBinding?.elementId == changedElementId
274:          ? _resolveSnapBindingFrom(elementsById, element.endBinding)
275:          : null;
276:      if (start == null && end == null) {
277:        return element;
278:      }
279:      return element.copyWith(
280:        start: start ?? element.start,
281:        end: end ?? element.end,
282:      );
283:    }
