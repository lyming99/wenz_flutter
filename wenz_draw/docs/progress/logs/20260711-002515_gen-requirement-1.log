209:  List<CanvasElement> _syncSnapBoundElements(
210:    List<CanvasElement> elements, {
211:    required String changedElementId,
212:  }) {
213:    final byId = {for (final element in elements) element.id: element};
214:    final resolved = <CanvasElement>[];
215:    var changed = false;
216:    for (final element in elements) {
217:      final next = _resolveSnapBoundElement(element, changedElementId, byId);
218:      resolved.add(next);
219:      changed = changed || !identical(next, element);
220:    }
221:    return changed ? List<CanvasElement>.unmodifiable(resolved) : elements;
222:  }
