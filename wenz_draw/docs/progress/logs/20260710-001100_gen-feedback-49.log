class _LeftShapePanelState extends State<LeftShapePanel> {
  String _searchQuery = '';
  bool _basicToolsExpanded = true;

  List<DrawioShapePaletteEntry> get _allStencilEntries {
    return [
      ...basicSymbolShapePalette,
      ...flowchartShapePalette,
      ...arrowShapePalette,
      ...drawioShapePalette,
