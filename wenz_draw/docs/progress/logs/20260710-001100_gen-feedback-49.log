                    const FieldLabel('瀵归綈'),
                    const SizedBox(height: 6),
                    AlignmentControl(
                      selected: selected,
                      onChanged: (align) {
                        if (selected != null) {
                          if (selected is TextElement) {
                            canvasController.updateTextElementStyle(
                              selected.id,
                              textAlign: align,
                            );
                          } else {
                            canvasController.updateShapeLabelStyle(
                              selected.id,
                              textAlign: align,
