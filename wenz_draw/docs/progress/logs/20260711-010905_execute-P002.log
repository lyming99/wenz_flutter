+Future<void> _dragEditingHandle(
+  WidgetTester tester,
+  Offset start,
+  Offset end,
+) async {
+  final gesture = await tester.startGesture(start);
+  await tester.pump();
+  await gesture.moveTo(end);
+  await tester.pump();
+  await gesture.up();
+  await tester.pump();
+}
