+TextElement _boxedText({
+  Offset position = const Offset(100, 80),
+  Size boxSize = const Size(120, 60),
+  double fontSize = 20,
+  double rotation = 0,
+}) {
+  return TextElement(
+    id: 'text-1',
+    position: position,
+    text: 'Resizable text',
+    maxWidth: boxSize.width,
+    boxSize: boxSize,
+    textAlign: TextAlign.right,
+    rotation: rotation,
+    style: TextStyle(
