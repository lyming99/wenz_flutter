728`t  void _handleControllerChanged() {
729`t    if (mounted) {
730`t      _syncTableToolbarOverlayWithSelection();
731`t      if (_revealCurrentSelectionIfHidden()) {
732`t        _lastScrollCheckedCaret = null;
733`t        _scrollRealignDepth = 0;
734`t      }
735`t      // Drop the cached laid-out painter for blocks whose content changed so a
736`t      // stale painter is not reused on the next build. Selection-only /
737`t      // composition-only changes (empty set) do not invalidate anything.
738`t      //
739`t      // The block *extent* cache is intentionally NOT invalidated here. While a
740`t      // block's text is being edited (most acutely during IME composition such
741`t      // as pinyin input) its content mutates on every keystroke, but its height
742`t      // barely changes. Dropping the cached height mid-edit would fall back to
743`t      // the document-wide average height for one frame, repositioning every
744`t      // following block — a visible flicker of the content below the caret. The
745`t      // real (possibly unchanged) height is reconciled on the next frame by the
746`t      // measured-block widget, so leaving the stale value yields one frame of a
747`t      // near-correct height instead of one frame of a wrong average.
748`t      final dirty = widget.controller.lastChangedBlockIds;
749`t      if (dirty == null) {
750`t        _extentCache.clear();
751`t      } else if (dirty.isNotEmpty) {
752`t        for (final id in dirty) {
753`t          _layoutCache.removeBlock(id);
754`t        }
755`t      }
756`t      // Keep the platform IME candidate window anchored at the caret, and
757`t      // scroll a programmatically-moved caret back into view. Both run in a
758`t      // post-frame callback so the caret's render box reflects the latest
759`t      // selection (and any keep-alive mount) before we read its global rect.
760`t      WidgetsBinding.instance.addPostFrameCallback((_) {
761`t        if (!mounted) {
762`t          return;
763`t        }
764`t        if (_inputClient.isAttached) {
765`t          _inputClient.syncBuffer();
766`t        }
767`t        // Bring an off-screen caret into view — but only when it actually
768`t        // moved. IME composition updates fire notifyListeners without changing
769`t        // the caret's position; skipping the scroll check there avoids a
770`t        // layout + localToGlobal round-trip per composition keystroke.
771`t        final selection = widget.controller.selection;
772`t        if (selection?.isCollapsed == true) {
773`t          final skipCaretScroll = _skipNextCaretScrollIntoView;
774`t          _skipNextCaretScrollIntoView = false;
775`t          final caretKey = _CaretKey(
776`t            selection!.extent.blockIndex,
777`t            selection.extent.offset,
778`t          );
779`t          if (caretKey != _lastScrollCheckedCaret) {
780`t            _lastScrollCheckedCaret = caretKey;
781`t            if (!skipCaretScroll) {
782`t              _scrollCaretIntoView();
783`t            }
784`t          }
785`t        } else {
786`t          _skipNextCaretScrollIntoView = false;
787`t          _lastScrollCheckedCaret = null;
788`t        }
789`t      });
790`t      setState(() {});
791`t    }
792`t  }
