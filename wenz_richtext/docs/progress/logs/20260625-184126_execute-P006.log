            CodeBlockNode(id: 'json1', code: jsonCode, language: 'json'),
            CodeBlockNode(
              id: 'md1',
              code: markdownCode,
              language: 'markdown',
            ),
            CodeBlockNode(
              id: 'plain1',
              code: unsupportedCode,
              language: 'unknown',
            ),
          ],
        ),
      );

      await tester.pumpWidget(
        MaterialApp(
          home: Scaffold(
            body: WenzRichTextEditor(
              controller: controller,
              enableIme: false,
            ),
          ),
        ),
      );

      final dartSpan = _richTextSpan(tester, dartCode);
