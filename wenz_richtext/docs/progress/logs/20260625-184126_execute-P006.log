            attributes: BlockAttributes(indent: 1),
            content: <InlineNode>[TextRun(text: 'Nested bullet')],
          ),
          TextBlockNode(
            id: 'o1',
            type: BlockType.listItem,
            attributes: BlockAttributes(listType: 'ordered'),
            content: <InlineNode>[TextRun(text: 'First ordered')],
