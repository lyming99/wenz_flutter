 2702: class _BlockLayoutMetrics {
 2703:   const _BlockLayoutMetrics({
 2704:     required this.blocks,
 2705:     required this.offsets,
 2706:     required this.totalExtent,
 2707:     required this.cache,
 2708:   });
 2709: 
 2710:   final List<BlockNode> blocks;
 2711:   final List<double> offsets;
 2712:   final double totalExtent;
 2713:   final _BlockExtentCache cache;
 2714: 
 2715:   double topFor(int index) => offsets[index];
 2716: 
 2717:   double bottomFor(int index) => topFor(index) + cache.extentFor(blocks[index]);
 2718: 
 2719:   List<int> visibleIndices(double visibleTop, double visibleBottom) {
 2720:     if (blocks.isEmpty) {
 2721:       return const <int>[];
 2722:     }
 2723:     final start = _firstIndexWithBottomAtOrAfter(visibleTop);
 2724:     if (start >= blocks.length) {
 2725:       return <int>[blocks.length - 1];
 2726:     }
 2727:     final endExclusive = _firstIndexWithTopAfter(visibleBottom);
 2728:     final end = endExclusive <= start ? start + 1 : endExclusive;
 2729:     return <int>[
 2730:       for (var i = start; i < end && i < blocks.length; i++) i,
 2731:     ];
 2732:   }
 2733: 
 2734:   int _firstIndexWithBottomAtOrAfter(double y) {
 2735:     var low = 0;
 2736:     var high = blocks.length;
 2737:     while (low < high) {
 2738:       final mid = low + ((high - low) >> 1);
 2739:       if (bottomFor(mid) < y) {
 2740:         low = mid + 1;
 2741:       } else {
 2742:         high = mid;
 2743:       }
 2744:     }
 2745:     return low;
 2746:   }
 2747: 
 2748:   int _firstIndexWithTopAfter(double y) {
 2749:     var low = 0;
 2750:     var high = offsets.length;
 2751:     while (low < high) {
 2752:       final mid = low + ((high - low) >> 1);
 2753:       if (offsets[mid] <= y) {
 2754:         low = mid + 1;
 2755:       } else {
 2756:         high = mid;
 2757:       }
 2758:     }
 2759:     return low;
 2760:   }
 2761: }
