 2146:   /// Scrolls the scrollable just enough to bring the current caret into view.
 2147:   /// Used after PageUp/PageDown jumps and after programmatic selection
 2148:   /// changes. No-op when the caret is already visible or no scroll client is
 2149:   /// attached.
 2150:   ///
 2151:   /// Under virtualisation the caret's block may not be mounted yet (it has
 2152:   /// never entered the viewport), in which case we cannot read its pixel
 2153:   /// position. We fall back to an estimate — mean block height × target block
 2154:   /// index — to jump the viewport close enough for ListView to build the
 2155:   /// block; a follow-up frame then pixel-aligns via the now-available rect.
 2156:   void _scrollCaretIntoView() {
 2157:     if (!_scrollController.hasClients) {
 2158:       return;
 2159:     }
 2160:     final selection = widget.controller.selection;
 2161:     if (selection == null) {
 2162:       return;
 2163:     }
 2164:     final renderBox = context.findRenderObject() as RenderBox?;
 2165:     if (renderBox == null || !renderBox.hasSize) {
 2166:       return;
 2167:     }
 2168:     final caretRect = _registry.caretRectForPosition(selection.extent);
 2169:     final position = _scrollController.position;
 2170:     final viewportHeight = renderBox.size.height;
 2171: 
 2172:     if (caretRect == null) {
 2173:       // The caret's block is not laid out (virtualised out of view). Estimate
 2174:       // the scroll offset from the average built-block height so the viewport
 2175:       // jumps near the target; the next frame will pixel-align once the block
 2176:       // is mounted.
 2177:       final estimated = _estimateOffsetForBlock(
 2178:         selection.extent.blockIndex,
 2179:         viewportHeight: viewportHeight,
 2180:       );
 2181:       if (estimated != null && (estimated - position.pixels).abs() > 1) {
 2182:         _jumpToScrollOffset(estimated);
 2183:         // Re-run on the next frame so the freshly-mounted block's rect is
 2184:         // available for pixel-accurate alignment. Bound the re-arm depth so a
 2185:         // persistently mis-estimated block height cannot loop forever.
 2186:         _scrollRealignDepth += 1;
 2187:         if (_scrollRealignDepth <= _maxScrollRealignFrames) {
 2188:           WidgetsBinding.instance.addPostFrameCallback((_) {
 2189:             if (mounted) {
 2190:               _scrollCaretIntoView();
 2191:             }
 2192:           });
 2193:         }
 2194:       }
 2195:       return;
 2196:     }
 2197:     // A real rect resolved — the estimate loop has converged (or was never
 2198:     // needed). Reset the guard for the next programmatic jump.
 2199:     _scrollRealignDepth = 0;
 2200: 
 2201:     final viewportTop = renderBox.localToGlobal(Offset.zero).dy;
 2202:     // Convert the caret's global Y into the scrollable's content coordinate
 2203:     // (pixels from the top of the full content).
 2204:     final caretTopInContent = caretRect.top - viewportTop + position.pixels;
 2205:     final caretBottomInContent = caretTopInContent + caretRect.height;
 2206:     final visibleTop = position.pixels;
 2207:     final visibleBottom = position.pixels + viewportHeight;
 2208:     if (caretTopInContent >= visibleTop &&
 2209:         caretBottomInContent <= visibleBottom) {
 2210:       return;
 2211:     }
 2212:     double target;
 2213:     if (caretTopInContent < visibleTop) {
 2214:       // Caret is above the viewport: align it with the top edge.
 2215:       target = caretTopInContent;
 2216:     } else {
 2217:       // Caret is below the viewport: align its bottom with the viewport's
 2218:       // bottom edge.
 2219:       target = caretBottomInContent - viewportHeight;
 2220:     }
 2221:     _jumpToScrollOffset(target);
 2222:   }
