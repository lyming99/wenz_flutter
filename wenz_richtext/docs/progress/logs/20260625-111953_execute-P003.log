  339:   DocumentPosition? _clampToNearest(Offset global) {
  340:     if (_entries.isEmpty) {
  341:       return null;
  342:     }
  343:     BlockEntry? nearest;
  344:     var nearestDelta = double.infinity;
  345:     var clampToEnd = false;
  346:     for (final entry in _entries) {
  347:       final box = entry.hitTestBox;
  348:       if (box == null) {
  349:         continue;
  350:       }
  351:       final rect = box.localToGlobal(Offset.zero) & box.size;
  352:       // 2-D distance from the point to the rect (0 when inside). Using both
  353:       // axes — not just vertical proximity — keeps a tap in a table cell's
  354:       // padding from being mis-attributed to a neighbouring cell/column, and a
  355:       // tap above/below a short cell from jumping to an adjacent row.
  356:       final dx = global.dx < rect.left
  357:           ? rect.left - global.dx
  358:           : (global.dx > rect.right ? global.dx - rect.right : 0.0);
  359:       final dy = global.dy < rect.top
  360:           ? rect.top - global.dy
  361:           : (global.dy > rect.bottom ? global.dy - rect.bottom : 0.0);
