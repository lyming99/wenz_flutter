   1: import 'package:flutter/widgets.dart';
   2: 
   3: import '../core/position/document_position.dart';
   4: 
   5: /// Resolves a global screen coordinate to a [DocumentPosition] across all
   6: /// registered editable blocks.
   7: ///
   8: /// Each [_TextSelectionSurface] registers itself (via [register]) with its
   9: /// block id, path, text length, a [GlobalKey] on its render object, and a
  10: /// callback that converts a *local* offset to a character offset using its
  11: /// own [TextLayoutService]. The document-level gesture overlay queries the
  12: /// registry during a drag to map the pointer position to a document position,
  13: /// which may live in a different block than where the drag started — enabling
  14: /// cross-block drag selection.
  15: class BlockGeometryRegistry {
  16:   BlockGeometryRegistry();
  17: 
  18:   /// Entries in block-index order, for ordered traversal (hit-testing,
  19:   /// nearest-block clamping, average height).
  20:   final List<BlockEntry> _entries = <BlockEntry>[];
  21: 
  22:   /// O(1) lookup by (blockId, path). Kept in sync with [_entries] on
  23:   /// register/unregister so hot paths (caret rect, word range, vertical move —
  24:   /// hit on every IME keystroke and every drag move) avoid a linear scan.
  25:   final Map<String, BlockEntry> _byKey = <String, BlockEntry>{};
  26: 
  27:   /// Top-level block row boxes, keyed by block id. These are wider than the
