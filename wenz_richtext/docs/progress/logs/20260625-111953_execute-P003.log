 537: }
 538: 
 539: Offset _globalTextOffset(WidgetTester tester, String text, int offset) {
 540:   final finder = find.byWidgetPredicate(
 541:     (widget) => widget is RichText && widget.text.toPlainText() == text,
 542:   );
 543:   final richText = tester.widget<RichText>(finder);
 544:   final size = tester.getSize(finder);
 545:   final painter = TextPainter(
 546:     text: richText.text,
 547:     textAlign: richText.textAlign,
 548:     textDirection: TextDirection.ltr,
 549:   )..layout(maxWidth: size.width);
 550:   final local =
 551:       painter.getOffsetForCaret(TextPosition(offset: offset), Rect.zero);
 552:   return tester.getTopLeft(finder) +
 553:       local +
 554:       Offset(1, painter.preferredLineHeight / 2);
 555: }

