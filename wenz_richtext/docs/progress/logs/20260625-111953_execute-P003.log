 2224:   /// Estimates the scroll offset that brings [blockIndex] into view, using the
 2225:   /// cached measured height for each block when available and a measured
 2226:   /// average for blocks the user has not visited yet.
 2227:   double? _estimateOffsetForBlock(
 2228:     int blockIndex, {
 2229:     required double viewportHeight,
 2230:   }) {
 2231:     final blocks = widget.controller.document.blocks;
 2232:     if (blockIndex < 0 || blockIndex >= blocks.length) {
 2233:       return null;
 2234:     }
 2235:     // Offset so the target block sits near the top of the viewport. We aim
 2236:     // one third down from the top so the surrounding context is visible.
 2237:     final targetBlockTop =
 2238:         _extentCache.offsetFor(blocks, blockIndex, widget.blockSpacing);
 2239:     return targetBlockTop - viewportHeight / 3;
 2240:   }

