              TextRun(text: ' from '),
              InlineEmbed(
                embedType: 'mention',
                data: <String, Object?>{'id': 'u1', 'label': 'Ada'},
              ),
              TextRun(text: '\nsecond line'),
            ],
          ),
          TextBlockNode(
            id: 'quote2',
            type: BlockType.quote,
            content: <InlineNode>[],
          ),
          TextBlockNode(
            id: 'p1',
            type: BlockType.paragraph,
            content: <InlineNode>[TextRun(text: 'after quote')],
