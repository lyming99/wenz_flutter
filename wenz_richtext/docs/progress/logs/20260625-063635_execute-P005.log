+      );
+      final toolbarGap = selectedCellRect.top - toolbarRect.bottom;
+
+      expect(toolbarRect.bottom, lessThanOrEqualTo(selectedCellRect.top));
+      expect(toolbarGap, moreOrLessEquals(4, epsilon: 0.1));
+    },
+  );
