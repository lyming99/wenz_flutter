 3259:   /// Cached child from the last build that actually rendered. Reused when the
 3260:   /// block's content and selection-relevance are unchanged.
 3261:   Widget? _cachedChild;
 3262: 
 3263:   @override
 3264:   void didUpdateWidget(covariant _KeepAliveBlock oldWidget) {
 3265:     super.didUpdateWidget(oldWidget);
 3266:     if (oldWidget.keepAlive != widget.keepAlive) {
 3267:       updateKeepAlive();
 3268:     }
 3269:     // Invalidate the cache when something this block renders depends on
 3270:     // changed. Content change, selection/caret/composition touching this block,
 3271:     // or ambient style/debug toggles all force a fresh render.
 3272:     //
 3273:     // Selection requires care: a block that stays selected while the selection
 3274:     // extent moves within it (e.g. dragging to resize a range) does not flip
 3275:     // the boolean "touches" flag, but the rendered highlight/caret offset DID
 3276:     // change. So when this block is touched by the selection, a different
 3277:     // selection object must also invalidate the cache.
 3278:     final selectionTouchedChanged =
 3279:         _selectionTouchesBlock(oldWidget) != _selectionTouchesBlock(widget);
 3280:     final selectionShiftedWhileTouched = _selectionTouchesBlock(widget) &&
 3281:         oldWidget.selection != widget.selection;
 3282:     if (widget.blockChanged ||
 3283:         oldWidget.blockIndex != widget.blockIndex ||
 3284:         oldWidget.blockCount != widget.blockCount ||
 3285:         selectionTouchedChanged ||
 3286:         selectionShiftedWhileTouched ||
 3287:         oldWidget.showCaret != widget.showCaret ||
 3288:         oldWidget.showDebugOverlay != widget.showDebugOverlay ||
 3289:         oldWidget.listMarker != widget.listMarker ||
 3290:         oldWidget.canEdit != widget.canEdit ||
 3291:         oldWidget.textStyle != widget.textStyle ||
 3292:         oldWidget.inlineEmbedRenderer != widget.inlineEmbedRenderer ||
 3293:         oldWidget.headingCollapseState != widget.headingCollapseState ||
 3294:         oldWidget.onHeadingCollapseToggled != widget.onHeadingCollapseToggled ||
 3295:         oldWidget.onCodeLanguageChanged != widget.onCodeLanguageChanged ||
 3296:         oldWidget.onCodeCopied != widget.onCodeCopied ||
 3297:         oldWidget.onCalloutVariantChanged != widget.onCalloutVariantChanged ||
 3298:         oldWidget.onTableToolbarAction != widget.onTableToolbarAction ||
 3299:         oldWidget.tableToolbarOverlayController !=
 3300:             widget.tableToolbarOverlayController ||
 3301:         oldWidget.onTableColumnResize != widget.onTableColumnResize ||
 3302:         oldWidget.onTodoCheckedChanged != widget.onTodoCheckedChanged ||
 3303:         oldWidget.onObjectBlockAction != widget.onObjectBlockAction ||
 3304:         oldWidget.findMatches != widget.findMatches ||
 3305:         oldWidget.currentFindMatch != widget.currentFindMatch ||
