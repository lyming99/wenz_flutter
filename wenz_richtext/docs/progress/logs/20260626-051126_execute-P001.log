double _safeVideoAspectRatio(double aspectRatio) {
  if (!aspectRatio.isFinite || aspectRatio <= 0) {
    return VideoBlockNode.defaultAspectRatio;
  }
  return aspectRatio
      .clamp(_kVideoMinAspectRatio, _kVideoMaxAspectRatio)
      .toDouble();
}

