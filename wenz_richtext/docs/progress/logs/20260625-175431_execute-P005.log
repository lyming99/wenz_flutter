 9800: List<_FindHighlightRange> _findRangesForPath(
 9801:   List<FindReplaceMatch> matches,
 9802:   FindReplaceMatch? current,
 9803:   int blockIndex,
 9804:   PositionPath path,
 9805:   int textLength,
 9806: ) {
 9807:   if (matches.isEmpty) {
 9808:     return const <_FindHighlightRange>[];
 9809:   }
 9810:   return <_FindHighlightRange>[
 9811:     for (final match in matches)
 9812:       if (match.containsPath(path, blockIndex))
 9813:         _FindHighlightRange(
 9814:           start: match.start.clamp(0, textLength).toInt(),
 9815:           end: match.end.clamp(0, textLength).toInt(),
 9816:           active: match == current,
 9817:         ),
 9818:   ];
 9819: }
