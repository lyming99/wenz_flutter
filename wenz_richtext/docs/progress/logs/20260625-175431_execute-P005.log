 1315:       case TableToolbarAction.setBackgroundColor:
 1316:         _forEachVisibleTableCell(tableBlock, range, (row, column) {
 1317:           widget.controller.setTableCellBackground(
 1318:             blockIndex: intent.blockIndex,
 1319:             rowIndex: row,
 1320:             columnIndex: column,
 1321:             backgroundColor: intent.backgroundColor,
 1322:           );
 1323:         });
 1324:         return;
 1325:       case TableToolbarAction.clearBackgroundColor:
 1326:         _forEachVisibleTableCell(tableBlock, range, (row, column) {
 1327:           widget.controller.setTableCellBackground(
 1328:             blockIndex: intent.blockIndex,
 1329:             rowIndex: row,
 1330:             columnIndex: column,
 1331:             backgroundColor: null,
 1332:           );
 1333:         });
 1334:         return;
 1335:       case TableToolbarAction.alignLeft:
 1336:         _setTableColumnAlignment(intent.blockIndex, range, 'left');
 1337:         return;
 1338:       case TableToolbarAction.alignCenter:
 1339:         _setTableColumnAlignment(intent.blockIndex, range, 'center');
 1340:         return;
 1341:       case TableToolbarAction.alignRight:
 1342:         _setTableColumnAlignment(intent.blockIndex, range, 'right');
 1343:         return;
 1344:       case TableToolbarAction.clearAlignment:
