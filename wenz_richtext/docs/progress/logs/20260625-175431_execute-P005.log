 9787: List<FindReplaceMatch> _matchesForBlock(
 9788:   List<FindReplaceMatch> matches,
 9789:   int blockIndex,
 9790: ) {
 9791:   if (matches.isEmpty) {
 9792:     return const <FindReplaceMatch>[];
 9793:   }
