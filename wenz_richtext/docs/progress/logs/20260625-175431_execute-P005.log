 9767: bool _selectionTouchesPath(
 9768:   DocumentSelection? selection,
 9769:   int blockIndex,
 9770:   String blockId,
 9771:   PositionPath path,
 9772:   int textLength,
 9773: ) {
 9774:   if (selection == null) {
 9775:     return false;
 9776:   }
 9777:   if (_selectionRangeForPath(selection, blockIndex, path, textLength) != null) {
 9778:     return true;
 9779:   }
 9780:   if (!selection.isCollapsed) {
 9781:     return false;
 9782:   }
 9783:   final position = selection.extent;
 9784:   return position.blockId == blockId && position.path == path;
 9785: }
