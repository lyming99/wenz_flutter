 9837: _LocalSelectionRange? _selectionRangeForPath(
 9838:   DocumentSelection? selection,
 9839:   int blockIndex,
 9840:   PositionPath path,
 9841:   int textLength,
 9842: ) {
 9843:   if (selection == null || selection.isCollapsed) {
 9844:     return null;
 9845:   }
 9846:   final start = selection.start;
 9847:   final end = selection.end;
 9848:   int? localStart;
 9849:   int? localEnd;
 9850: 
 9851:   if (start.blockIndex == blockIndex) {
 9852:     final pathCompare = path.compare(start.path);
 9853:     if (pathCompare == 0) {
 9854:       localStart = start.offset;
 9855:     } else if (pathCompare > 0) {
 9856:       localStart = 0;
 9857:     }
 9858:   } else if (blockIndex > start.blockIndex) {
 9859:     localStart = 0;
 9860:   }
 9861: 
 9862:   if (end.blockIndex == blockIndex) {
 9863:     final pathCompare = path.compare(end.path);
 9864:     if (pathCompare == 0) {
 9865:       localEnd = end.offset;
 9866:     } else if (pathCompare < 0) {
 9867:       localEnd = textLength;
 9868:     }
 9869:   } else if (blockIndex < end.blockIndex) {
 9870:     localEnd = textLength;
 9871:   }
 9872: 
 9873:   if (localStart == null || localEnd == null) {
