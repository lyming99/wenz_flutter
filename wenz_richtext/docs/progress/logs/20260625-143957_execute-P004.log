  148:   /// Whether [global] sits inside the scrollbar gutter — the trailing-edge
  149:   /// band of a vertically scrollable list. The list's own scrollbar is added by
  150:   /// the ambient scroll behaviour and its MouseRegion defers its cursor to us,
  151:   /// so without this check the thumb would show the text cursor.
  152:   bool _isOverScrollbar(Offset global) {
  153:     final scrollable = widget.scrollController;
  154:     if (!scrollable.hasClients) {
  155:       return false;
  156:     }
  157:     // Only intercept when there is actually something to scroll; a fully
  158:     // visible list has no scrollbar thumb to hover.
  159:     if (scrollable.position.maxScrollExtent <= 0) {
  160:       return false;
  161:     }
  162:     final renderBox = context.findRenderObject() as RenderBox?;
  163:     if (renderBox == null || !renderBox.hasSize) {
  164:       return false;
  165:     }
  166:     final local = renderBox.globalToLocal(global);
  167:     if (local.dx < 0 || local.dy < 0) {
  168:       return false;
  169:     }
  170:     final size = renderBox.size;
