-String _formulaDisplayText(InlineEmbed embed) {
-  final raw = embed.data['text'] ?? embed.data['latex'] ?? embed.data['value'];
-  final text = raw?.toString() ?? '';
-  return text.isEmpty ? '[formula]' : text;
