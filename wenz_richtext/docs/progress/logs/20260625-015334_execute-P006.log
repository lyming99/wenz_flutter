-          widget.controller.setTableCellBackground(
-            blockIndex: intent.blockIndex,
-            rowIndex: row,
-            columnIndex: column,
-            backgroundColor: null,
-          );
-        });
-        return;
-      case TableToolbarAction.alignLeft:
