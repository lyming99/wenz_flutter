-          fontSize: _headingSize(block.attributes.level),
-          fontWeight: FontWeight.w700,
-        ),
-      ),
-    BlockType.quote => baseStyle.merge(
-        theme.textTheme.bodyMedium?.copyWith(fontStyle: FontStyle.italic),
-      ),
