-    final child = _BlockRenderer(
-      block: widget.block,
-      blockIndex: widget.blockIndex,
-      selection: widget.selection,
-      compositionState: widget.compositionState,
-      registry: widget.registry,
-      blockRenderers: widget.blockRenderers,
