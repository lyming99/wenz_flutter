-  @override
-  void paint(Canvas canvas, Size size) {
-    if (ranges.isEmpty) {
-      return;
-    }
-    final painter = layoutService.layout(
-      span: textSpan,
-      textAlign: textAlign,
-      textDirection: textDirection,
-      maxWidth: maxWidth,
-    );
-    for (final range in ranges) {
-      if (range.start == range.end) {
-        continue;
-      }
