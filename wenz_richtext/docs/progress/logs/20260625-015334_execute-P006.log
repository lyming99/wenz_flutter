-  Widget _withHighContrastFocusHighlight(
-    BuildContext context,
-    FocusNode focusNode,
-    Widget child,
-  ) {
-    final accessibility = widget.accessibility;
-    if (!focusNode.hasFocus ||
-        !(MediaQuery.maybeHighContrastOf(context) ?? false) ||
