-                      blockId: widget.blocks[index].id,
-                      measureToken: widget.extentCache.tokenFor(
-                        widget.blocks[index].id,
-                      ),
-                      onChanged: _handleExtentChanged,
-                      child: widget.itemBuilder(context, index),
