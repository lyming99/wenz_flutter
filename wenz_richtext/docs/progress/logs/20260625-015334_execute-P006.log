-  @override
-  void initState() {
-    super.initState();
-    _inputClient = EditorTextInputClient(widget.controller);
-    // The IME bridge asks the widget layer for the caret's global rect so the
-    // platform can position its candidate window (e.g. pinyin) at the caret.
