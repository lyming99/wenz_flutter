-  /// Starts or stops the blink timer to match [caretVisible]. Idempotent so it
-  /// is safe to call from build.
-  void _syncBlink(bool caretVisible) {
-    if (caretVisible && !_blinkActive) {
-      _startBlinkTimer();
-    } else if (!caretVisible && _blinkActive) {
-      _blinkActive = false;
-      _blinkTimer?.cancel();
-      _blinkTimer = null;
-      _blinkValue = 1.0;
-    }
-  }
