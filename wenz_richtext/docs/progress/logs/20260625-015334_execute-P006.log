-  final style =
-      decorate ? _compositionTextStyle(undecoratedStyle) : undecoratedStyle;
-  return switch (node) {
-    final TextRun textRun => TextSpan(text: textRun.text, style: style),
-    final InlineEmbed embed => _inlineEmbedSpanFor(
-        context,
-        embed,
-        baseStyle,
-        inlineEmbedRenderer,
-        decorate: decorate,
