-        forward: forward,
-        expandSelection: expandSelection,
-      );
-      return;
-    }
-    final caretRect = _registry.caretRectForPosition(selection.extent);
-    final renderBox = context.findRenderObject() as RenderBox?;
-    if (caretRect == null ||
