-  TableCellRange? _currentTableRange(
-    TableBlockNode tableBlock,
-    TableToolbarActionIntent intent,
-  ) {
-    final range = widget.controller.selection?.tableCellRange;
-    if (range == null ||
-        range.blockIndex != intent.blockIndex ||
