+    super.key,
+    required this.renderContext,
+    required this.child,
+  });
+
+  final BlockRenderContext renderContext;
+  final Widget child;
+
+  @override
+  Widget build(BuildContext context) {
+    return _withSelectableObjectBlock(
+      renderContext.block,
+      renderContext,
+      child,
+    );
+  }
