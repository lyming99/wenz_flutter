-        painter.preferredLineHeight;
-    final paint = Paint()
-      ..color = color.withValues(alpha: opacity.clamp(0.0, 1.0))
-      ..strokeWidth = _kCaretStrokeWidth;
-    canvas.drawLine(caretTop, caretTop.translate(0, height), paint);
-  }
