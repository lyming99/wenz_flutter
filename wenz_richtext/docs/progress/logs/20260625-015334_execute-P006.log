+class _CalloutVariantMenuState extends State<_CalloutVariantMenu> {
+  final GlobalKey _hitTestKey = GlobalKey();
+
+  @override
+  void initState() {
+    super.initState();
+    widget.registry.registerSelectionExclusion(_hitTestKey);
+  }
