-        }
-        return DocumentPosition.tableCell(
-          tableBlockId: block.id,
-          blockIndex: blockIndex,
-          tableRowIndex: rowIndex,
-          tableColumnIndex: columnIndex,
-          offset: 0,
-        );
-      }
-    }
-    return null;
-  }
