+                ? null
+                : (value) {
+                    if (value != null && value != widget.variant) {
+                      widget.onChanged!(value);
+                    }
+                  },
+            items: <DropdownMenuItem<String>>[
+              for (final option in CalloutBlockNode.supportedVariants)
+                DropdownMenuItem<String>(
