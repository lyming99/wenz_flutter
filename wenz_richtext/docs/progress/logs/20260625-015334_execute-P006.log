-        return true;
-      case 'moveParagraphForwardAndModifySelection:':
-      case 'moveToRightEndOfLineAndModifySelection:':
-        _verticalPreferX = null;
-        controller.moveCaretToBlockBoundary(
-          forward: true,
-          expandSelection: true,
