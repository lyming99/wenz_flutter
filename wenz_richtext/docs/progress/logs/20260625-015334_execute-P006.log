-  double offsetFor(List<BlockNode> blocks, int blockIndex, double spacing) {
-    var offset = 0.0;
-    final safeIndex = blockIndex.clamp(0, blocks.length).toInt();
-    for (var i = 0; i < safeIndex; i++) {
-      offset += extentFor(blocks[i]);
-      if (i < blocks.length - 1) {
-        offset += spacing;
-      }
-    }
-    return offset;
-  }
