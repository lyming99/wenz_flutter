-  /// Current blink phase: 1.0 = caret visible, 0.0 = caret hidden. Toggled by
-  /// [_blinkTimer]; defaults to visible so the caret shows immediately on focus.
-  double _blinkValue = 1.0;
-  bool _blinkActive = false;
