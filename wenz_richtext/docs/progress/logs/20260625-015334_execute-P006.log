-      selected: selected,
-      child: DecoratedBox(
-        key: _cellFrameKey,
-        decoration: BoxDecoration(
-          color: backgroundColor,
-        ),
-        child: Padding(
-          padding: const EdgeInsets.all(8),
-          child: Stack(
-            children: <Widget>[
-              if (widget.highlightWholeCell)
