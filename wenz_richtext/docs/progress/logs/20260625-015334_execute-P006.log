-    block,
-    _BlockObjectSelectionSurface(
-      blockId: block.id,
-      blockIndex: rc.blockIndex,
-      path: path,
-      selection: rc.selection,
-      registry: rc.registry,
-      showDebugOverlay: rc.showDebugOverlay,
-      child: child,
-    ),
-    selected: selected,
-  );
