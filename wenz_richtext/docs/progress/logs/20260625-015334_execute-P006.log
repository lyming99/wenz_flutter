-  _BlockLayoutMetrics layoutFor(List<BlockNode> blocks, double spacing) {
-    final offsets = <double>[];
-    var offset = 0.0;
-    for (var i = 0; i < blocks.length; i++) {
-      offsets.add(offset);
-      offset += extentFor(blocks[i]);
-      if (i < blocks.length - 1) {
-        offset += spacing;
-      }
