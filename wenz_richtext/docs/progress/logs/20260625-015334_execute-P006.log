-      return;
-    }
-    widget.controller.setTableColumnWidth(
-      blockIndex: blockIndex,
-      columnIndex: columnIndex,
-      width:
-          width.clamp(_kMinTableColumnWidth, _kMaxTableColumnWidth).toDouble(),
-    );
