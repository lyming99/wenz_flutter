-  ) {
-    for (var column = range.startColumn; column <= range.endColumn; column++) {
-      widget.controller.setTableColumnAlignment(
-        blockIndex: blockIndex,
-        columnIndex: column,
-        alignment: alignment,
-      );
-    }
-  }
