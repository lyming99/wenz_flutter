-                (row) => row
-                    .map(
-                      (cell) => TableCellNode(
-                        id: _nextBlockId(),
-                        blocks:
-                            cell.blocks.map(_copyBlockWithFreshIds).toList(),
-                        rowSpan: cell.rowSpan,
-                        columnSpan: cell.columnSpan,
-                        isHeader: cell.isHeader,
-                        backgroundColor: cell.backgroundColor,
-                        covered: cell.covered,
