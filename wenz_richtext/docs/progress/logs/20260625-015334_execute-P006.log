+  final FindReplaceMatch? currentFindMatch;
+
+  @override
+  Widget build(BuildContext context) {
+    final renderContext = BlockRenderContext(
+      block: block,
+      blockIndex: blockIndex,
+      selection: selection,
+      compositionState: compositionState,
+      registry: registry,
+      showCaret: showCaret,
+      textStyle: textStyle,
