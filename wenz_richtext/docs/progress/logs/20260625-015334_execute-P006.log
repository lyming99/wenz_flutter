-    FileUploadStatus.none => '',
-    FileUploadStatus.pending => 'Pending upload',
-    FileUploadStatus.uploading => 'Uploading',
-    FileUploadStatus.uploaded => 'Uploaded',
-    FileUploadStatus.failed => 'Upload failed',
