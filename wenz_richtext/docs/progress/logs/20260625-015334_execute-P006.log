+    return Padding(
+      padding: const EdgeInsets.only(top: 8),
+      child: Wrap(
+        spacing: 6,
+        runSpacing: 6,
+        children: <Widget>[
+          for (final entry in entries)
+            DecoratedBox(
+              decoration: BoxDecoration(
+                color: theme.colorScheme.surface,
