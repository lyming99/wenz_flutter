-    this.onCodeLanguageChanged,
-    this.onCodeCopied,
-    this.onCalloutVariantChanged,
-    this.onTableToolbarAction,
-    this.onTableColumnResize,
-    this.onTodoCheckedChanged,
-    this.onObjectBlockAction,
-    this.findMatches = const <FindReplaceMatch>[],
