-  Widget _buildEditorShell(
-    BuildContext context,
-    FocusNode focusNode,
-    Widget child,
-  ) {
-    return _SharedLayoutCacheScope(
-      cache: _layoutCache,
-      child: Focus(
-        focusNode: focusNode,
-        autofocus: widget.autofocus,
