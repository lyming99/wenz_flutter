-_LocalSelectionRange? _localCompositionRange(
-  CompositionState? state,
-  String blockId,
-  int blockIndex,
-  PositionPath path,
-) {
-  if (state == null ||
-      state.blockId != blockId ||
-      state.blockIndex != blockIndex ||
-      state.path != path ||
