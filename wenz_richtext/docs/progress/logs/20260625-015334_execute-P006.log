-      return;
-    }
-    final renderBox = context.findRenderObject() as RenderBox?;
-    if (renderBox == null || !renderBox.hasSize) {
-      return;
-    }
-    final position = _scrollController.position;
-    final viewportTop = renderBox.localToGlobal(Offset.zero).dy;
