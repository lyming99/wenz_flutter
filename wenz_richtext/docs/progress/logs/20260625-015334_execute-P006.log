+  @override
+  void initState() {
+    super.initState();
+    _dragWidth = widget.width;
+  }
+
+  @override
+  void didUpdateWidget(_TableColumnResizeHandle oldWidget) {
+    super.didUpdateWidget(oldWidget);
+    if (oldWidget.width != widget.width) {
+      _dragWidth = widget.width;
