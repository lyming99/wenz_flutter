+        blockIndex: i,
+        keepAlive: keepAliveIds.contains(blocks[i].id),
+        blockChanged: dirtyIds == null || dirtyIds.contains(blocks[i].id),
+        selection: widget.controller.selection,
+        compositionState: widget.controller.compositionState,
