+        oldWidget.blockId != widget.blockId ||
+        oldWidget.path != widget.path) {
+      oldWidget.registry.unregister(oldWidget.blockId, oldWidget.path);
+    }
+    if (oldWidget.registry != widget.registry ||
+        oldWidget.blockId != widget.blockId ||
+        oldWidget.blockIndex != widget.blockIndex ||
+        oldWidget.path != widget.path) {
+      _register();
+    }
+  }
