+      }
+    }
+
+    final last = rows.last;
+    return BlockReorderDropTarget(
+      blockId: last.entry.blockId,
+      blockIndex: last.entry.blockIndex,
+      placement: BlockReorderDropPlacement.after,
+      blockRect: last.rect,
+    );
