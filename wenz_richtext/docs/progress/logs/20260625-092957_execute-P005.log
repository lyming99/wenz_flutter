+
+  void _register() {
+    widget.registry.registerBlockRow(
+      BlockRowGeometryEntry(
+        blockId: widget.blockId,
+        blockIndex: widget.blockIndex,
+        key: _rowKey,
+      ),
+    );
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return RepaintBoundary(
+      key: _rowKey,
+      child: widget.child,
