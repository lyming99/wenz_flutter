25`t  @override
26`t  CommandResult execute(DocumentSession session) {
27`t    final document = session.document;
28`t    final blockCount = document.blocks.length;
29`t    if (fromIndex < 0 ||
30`t        fromIndex >= blockCount ||
31`t        toIndex < 0 ||
32`t        toIndex >= blockCount ||
33`t        fromIndex == toIndex) {
34`t      return const CommandResult(recordHistory: false);
35`t    }
36`t
37`t    final blocks = document.blocks.map((block) => block.copy()).toList();
38`t    final moved = blocks.removeAt(fromIndex);
39`t    blocks.insert(toIndex, moved);
40`t    final blockIndexes = <String, int>{
41`t      for (var index = 0; index < blocks.length; index++)
42`t        blocks[index].id: index,
43`t    };
44`t
45`t    session.document = RichTextDocument(
46`t      version: document.version,
47`t      blocks: blocks,
48`t      comments: _retargetCommentThreads(document.comments, blockIndexes),
49`t      revisions: _retargetRevisionChanges(document.revisions, blockIndexes),
50`t    );
51`t    return CommandResult(
52`t      selection: _selectionForMovedBlock(moved, toIndex),
53`t      metadata: <String, Object?>{
54`t        'fromIndex': fromIndex,
55`t        'toIndex': toIndex,
56`t        'blockId': moved.id,
57`t      },
58`t    );
59`t  }
