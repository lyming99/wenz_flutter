+      final box = entry.renderBox;
+      if (box == null || !box.hasSize) {
+        continue;
+      }
+      rows.add((
+        entry: entry,
+        rect: box.localToGlobal(Offset.zero) & box.size,
+      ));
+    }
+    if (rows.isEmpty) {
+      return null;
+    }
+    rows.sort((a, b) => a.entry.blockIndex.compareTo(b.entry.blockIndex));
