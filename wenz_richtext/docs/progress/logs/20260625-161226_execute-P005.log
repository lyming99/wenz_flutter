 608: CommandResult updateTableCell(
 609:   DocumentSession session,
 610:   int blockIndex,
 611:   int rowIndex,
 612:   int columnIndex,
 613:   TableCellNode Function(TableCellNode cell) update,
 614: ) {
 615:   final tableBlock = tableAt(session, blockIndex);
 616:   final cell = tableBlock?.table.cellAt(rowIndex, columnIndex);
 617:   if (tableBlock == null || cell == null) {
 618:     return const CommandResult(recordHistory: false);
 619:   }
 620:   final selection = session.selection;
 621:   final rows = tableBlock.table.rows.map(copyRow).toList();
 622:   rows[rowIndex][columnIndex] = update(cell);
 623:   final result = replaceTable(session, blockIndex, tableBlock, rows);
 624:   if (selection == null) {
 625:     return result;
 626:   }
 627:   return CommandResult(
 628:     selection: selection,
 629:     recordHistory: result.recordHistory,
 630:     metadata: result.metadata,
 631:   );
 632: }
