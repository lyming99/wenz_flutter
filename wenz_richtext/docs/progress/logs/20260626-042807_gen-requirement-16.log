 121:     required this.uniformBlockType,
 122:     required this.uniformListType,
 123:     required this.uniformHeadingLevel,
 124:     required this.codeLanguage,
 125:     required this.canUndo,
 126:     required this.canRedo,
 127:   });
 128: 
 129:   /// Whether any selection is active (collapsed caret counts).
 130:   final bool hasSelection;
 131: 
 132:   /// Whether inline text formatting (FormatTextCommand) can apply — requires
 133:   /// the selection to sit inside a [TextBlockNode] text path. A collapsed
 134:   /// caret still qualifies because it sets the typing attributes for the next
 135:   /// input.
 136:   final bool canFormatInline;
 137: 
 138:   /// Whether a boolean mark toggle (ToggleMarkCommand) can apply — same rule
