 763:         _scrollRealignDepth = 0;
 764:       }
 765:       // Drop the cached laid-out painter for blocks whose content changed so a
 766:       // stale painter is not reused on the next build. Selection-only /
 767:       // composition-only changes (empty set) do not invalidate anything.
 768:       //
 769:       // The block *extent* cache is intentionally NOT invalidated here. While a
 770:       // block's text is being edited (most acutely during IME composition such
 771:       // as pinyin input) its content mutates on every keystroke, but its height
 772:       // barely changes. Dropping the cached height mid-edit would fall back to
 773:       // the document-wide average height for one frame, repositioning every
 774:       // following block — a visible flicker of the content below the caret. The
 775:       // real (possibly unchanged) height is reconciled on the next frame by the
 776:       // measured-block widget, so leaving the stale value yields one frame of a
 777:       // near-correct height instead of one frame of a wrong average.
 778:       final dirty = widget.controller.lastChangedBlockIds;
 779:       if (dirty == null) {
 780:         _extentCache.clear();
 781:       } else if (dirty.isNotEmpty) {
 782:         for (final id in dirty) {
 783:           _layoutCache.removeBlock(id);
 784:         }
 785:       }
 786:       // Keep the platform IME candidate window anchored at the caret, and
 787:       // scroll a programmatically-moved caret back into view. Both run in a
 788:       // post-frame callback so the caret's render box reflects the latest
 789:       // selection (and any keep-alive mount) before we read its global rect.
 790:       WidgetsBinding.instance.addPostFrameCallback((_) {
 791:         if (!mounted) {
 792:           return;
 793:         }
 794:         if (_inputClient.isAttached) {
 795:           _inputClient.syncBuffer();
 796:         }
 797:         // Bring an off-screen caret into view — but only when it actually
 798:         // moved. IME composition updates fire notifyListeners without changing
 799:         // the caret's position; skipping the scroll check there avoids a
 800:         // layout + localToGlobal round-trip per composition keystroke.
 801:         final selection = widget.controller.selection;
 802:         if (selection?.isCollapsed == true) {
 803:           final skipCaretScroll = _skipNextCaretScrollIntoView;
 804:           _skipNextCaretScrollIntoView = false;
 805:           final caretKey = _CaretKey(
 806:             selection!.extent.blockIndex,
 807:             selection.extent.offset,
 808:           );
 809:           if (caretKey != _lastScrollCheckedCaret) {
 810:             _lastScrollCheckedCaret = caretKey;
 811:             if (!skipCaretScroll) {
 812:               _scrollCaretIntoView();
 813:             }
 814:           }
 815:         } else {
 816:           _skipNextCaretScrollIntoView = false;
 817:           _lastScrollCheckedCaret = null;
 818:         }
 819:       });
 820:       setState(() {});
 821:     }
 822:   }
