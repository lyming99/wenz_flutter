  67: 
  68:   List<WenzToolbarItem> get items {
  69:     final ordered = _items.values.toList()
  70:       ..sort((a, b) {
  71:         final byPriority = a.priority.compareTo(b.priority);
  72:         if (byPriority != 0) {
  73:           return byPriority;
  74:         }
  75:         return a.id.compareTo(b.id);
  76:       });
  77:     return List<WenzToolbarItem>.unmodifiable(ordered);
  78:   }
  79: 
  80:   void register(WenzToolbarItem item) {
  81:     _items[item.id] = item;
  82:   }
  83: 
  84:   void unregister(String id) {
  85:     _items.remove(id);
  86:   }
  87: 
  88:   bool has(String id) => _items.containsKey(id);
  89: 
  90:   WenzToolbarItem? operator [](String id) => _items[id];
  91: }
