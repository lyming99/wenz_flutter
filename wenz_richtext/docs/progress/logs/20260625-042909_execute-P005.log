class _ImageBlockContent extends StatelessWidget {
  const _ImageBlockContent({
    required this.block,
    required this.blockIndex,
    required this.selected,
    required this.canEdit,
    required this.child,
    this.onAction,
  });

  final ImageBlockNode block;
  final int blockIndex;
  final bool selected;
  final bool canEdit;
  final Widget child;
  final ObjectBlockActionHandler? onAction;

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    Widget media = child;
    if (block.showWidth != null || block.showHeight != null) {
      media = SizedBox(
        width: block.showWidth,
        height: block.showHeight,
        child: child,
      );
    }
    final captionStyle = theme.textTheme.bodySmall?.copyWith(
          color: theme.colorScheme.onSurfaceVariant,
        ) ??
        TextStyle(color: theme.colorScheme.onSurfaceVariant);
    return _ObjectBlockCard(
      icon: Icons.image_outlined,
      title: 'Image',
      subtitle: _assetLabel(block.assetId, block.file),
      blockIndex: blockIndex,
      selected: selected,
      canEdit: canEdit,
      imageActions: true,
      onAction: onAction,
      child: Column(
        mainAxisSize: MainAxisSize.min,
        crossAxisAlignment: CrossAxisAlignment.start,
        children: <Widget>[
          media,
          if (block.caption.isNotEmpty) ...<Widget>[
            const SizedBox(height: 6),
            Text(block.caption, style: captionStyle),
          ],
        ],
      ),
    );
  }
}

