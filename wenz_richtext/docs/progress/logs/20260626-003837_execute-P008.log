+  testWidgets('video block keeps placeholder chrome inside a narrow card',
+      (tester) async {
+    const source =
+        'https://cdn.example.test/videos/super-wide-launch-video.mp4';
+    const cover = 'assets/poster-with-a-very-long-file-name-for-video.jpg';
