+            coverUrl: cover,
+            title: 'Narrow video',
+            description: 'Long description that should stay inside the card.',
+            aspectRatio: 9 / 16,
+          ),
+        ],
+      ),
+    );
+
+    await tester.pumpWidget(
+      MaterialApp(
+        home: Scaffold(
+          body: SizedBox(
+            width: 180,
+            height: 280,
+            child: WenzRichTextEditor(
