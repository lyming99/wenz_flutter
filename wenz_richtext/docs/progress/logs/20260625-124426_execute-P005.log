  313:   final String tableBlockId;
  314:   final int blockIndex;
  315:   final int startRow;
  316:   final int endRow;
  317:   final int startColumn;
  318:   final int endColumn;
  319: 
  320:   bool get isSingleCell {
  321:     return startRow == endRow && startColumn == endColumn;
  322:   }
  323: 
  324:   bool containsCell(int row, int column) {
  325:     return row >= startRow &&
  326:         row <= endRow &&
  327:         column >= startColumn &&
  328:         column <= endColumn;
  329:   }
  330: 
  331:   @override
  332:   bool operator ==(Object other) {
  333:     return other is TableCellRange &&
  334:         other.tableBlockId == tableBlockId &&
  335:         other.blockIndex == blockIndex &&
  336:         other.startRow == startRow &&
