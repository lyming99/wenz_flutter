  340:           ),
  341:           blockId: block.id,
  342:           blockIndex: blockIndex,
  343:           path: PositionPath.blockCode(block.id),
  344:         ),
  345:       );
  346:     } else if (block is TableBlockNode) {
  347:       matches.addAll(_findInTable(block, blockIndex, query, options));
  348:     }
  349:   }
  350:   return matches;
  351: }
