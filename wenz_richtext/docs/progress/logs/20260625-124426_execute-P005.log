  311:   final matches = <FindReplaceMatch>[];
  312:   for (var blockIndex = 0; blockIndex < blocks.length; blockIndex++) {
  313:     final block = blocks[blockIndex];
  314:     if (block is TextBlockNode) {
  315:       matches.addAll(
  316:         _findInText(
  317:           text: _inlinePlainText(block.content),
  318:           query: query,
  319:           options: options,
  320:           positionBuilder: (offset) => DocumentPosition.text(
  321:             blockId: block.id,
  322:             blockIndex: blockIndex,
  323:             offset: offset,
  324:           ),
  325:           blockId: block.id,
  326:           blockIndex: blockIndex,
  327:           path: PositionPath.blockText(block.id),
  328:         ),
  329:       );
  330:     } else if (block is CodeBlockNode) {
  331:       matches.addAll(
  332:         _findInText(
  333:           text: block.code,
  334:           query: query,
  335:           options: options,
  336:           positionBuilder: (offset) => DocumentPosition.code(
  337:             blockId: block.id,
  338:             blockIndex: blockIndex,
