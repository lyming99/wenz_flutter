  672:   bool _shouldApplyMarkdownShortcut(
  673:     String text,
  674:     TextAttributes attributes,
  675:     bool enabled,
  676:     ChangeSet change,
  677:   ) {
  678:     if (!enabled || change.isNoop || !attributes.isEmpty || text.length != 1) {
  679:       return false;
  680:     }
  681:     return text == ' ' || text == '-' || text == '`';
  682:   }
  683: 
  684:   bool _shouldApplyAutoLinkUrls(
  685:     String text,
  686:     TextAttributes attributes,
  687:     bool enabled,
  688:     ChangeSet change,
  689:   ) {
  690:     if (!enabled || change.isNoop || attributes.url != null) {
  691:       return false;
  692:     }
  693:     if (_autoLinkCandidateRegex.hasMatch(text)) {
  694:       return true;
  695:     }
  696:     if (!_containsAutoLinkTrigger(text)) {
  697:       return false;
  698:     }
  699:     return _currentTextScopeHasAutoLinkCandidate();
  700:   }
  701: 
  702:   bool _containsAutoLinkTrigger(String text) {
  703:     for (final codePoint in text.runes) {
  704:       if (_autoLinkTriggerCharacters.contains(String.fromCharCode(codePoint))) {
  705:         return true;
  706:       }
  707:     }
  708:     return false;
  709:   }
  710: 
  711:   bool _currentTextScopeHasAutoLinkCandidate() {
  712:     final target = selection;
  713:     if (target == null ||
  714:         target.start.blockIndex != target.end.blockIndex ||
  715:         target.start.path != target.end.path) {
  716:       return false;
  717:     }
  718:     final position = target.extent;
  719:     if (position.blockIndex < 0 ||
  720:         position.blockIndex >= document.blocks.length) {
  721:       return false;
  722:     }
  723:     final block = document.blocks[position.blockIndex];
  724:     if (position.path.isBlockText && block is TextBlockNode) {
  725:       return _autoLinkCandidateRegex.hasMatch(block.plainText);
  726:     }
  727:     if (position.path.isTableCellText) {
  728:       final textBlock = tableCellTextBlockForPosition(document, position);
  729:       return textBlock != null &&
  730:           _autoLinkCandidateRegex.hasMatch(textBlock.plainText);
  731:     }
  732:     return false;
  733:   }
