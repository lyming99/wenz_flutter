  445: String _inlinePlainText(List<InlineNode> nodes) {
  446:   final buffer = StringBuffer();
  447:   for (final node in nodes) {
  448:     if (node is InlineEmbed) {
  449:       buffer.write(' ' * inlineLength(node));
  450:     } else {
  451:       buffer.write(node.plainText);
  452:     }
  453:   }
  454:   return buffer.toString();
  455: }
  456: 
  457: bool _isWholeWord(String text, int start, int end) {
  458:   final before = start == 0 ? null : text.codeUnitAt(start - 1);
  459:   final after = end >= text.length ? null : text.codeUnitAt(end);
  460:   return !_isWordCodeUnit(before) && !_isWordCodeUnit(after);
  461: }
  462: 
  463: bool _isWordCodeUnit(int? codeUnit) {
  464:   if (codeUnit == null) {
  465:     return false;
  466:   }
  467:   return (codeUnit >= 0x30 && codeUnit <= 0x39) ||
  468:       (codeUnit >= 0x41 && codeUnit <= 0x5A) ||
  469:       (codeUnit >= 0x61 && codeUnit <= 0x7A) ||
  470:       codeUnit == 0x5F;
  471: }

