 1103:   void _pasteClipboard(ClipboardPaste paste) {
 1104:     if (paste.isBlocks) {
 1105:       execute(PasteBlocksCommand(paste.blocks,
 1106:           newBlockId: 'paste-${_pasteBlockCounter()}'));
 1107:       return;
 1108:     }
 1109:     if (paste.isRich) {
 1110:       _pasteInline(paste.inlineRuns);
 1111:       notifyListeners();
 1112:       return;
 1113:     }
 1114:     final text = paste.text;
 1115:     if (text.isEmpty) {
 1116:       return;
 1117:     }
 1118:     _pastePlain(text);
 1119:     notifyListeners();
 1120:   }
 1121: 
 1122:   void _pasteInline(List<InlineNode> runs) {
 1123:     if (runs.isEmpty) {
 1124:       return;
 1125:     }
 1126:     // Insert each run at the current caret; InsertTextCommand handles attribute
 1127:     // preservation per run, and InsertInlineEmbedCommand re-inserts embeds
 1128:     // (formula/mention/image) so rich inline elements survive paste. Inserting
 1129:     // as separate commands lets them coalesce only when attributes match.
 1130:     for (final run in runs) {
 1131:       if (run is TextRun) {
 1132:         if (run.text.isEmpty) {
 1133:           continue;
 1134:         }
 1135:         insertText(
 1136:           run.text,
 1137:           attributes: run.attributes,
 1138:           applyMarkdownShortcuts: false,
 1139:         );
 1140:       } else if (run is InlineEmbed) {
 1141:         execute(
 1142:           InsertInlineEmbedCommand(
 1143:             embedType: run.embedType,
 1144:             data: run.data,
 1145:           ),
 1146:         );
 1147:       }
 1148:     }
 1149:   }
 1150: 
 1151:   void _pastePlain(String text) {
 1152:     final lines = text.split('\n');
 1153:     for (var i = 0; i < lines.length; i++) {
 1154:       if (i > 0) {
 1155:         // Split into a new block at the caret before inserting the next line.
 1156:         enter(newBlockId: 'paste-${_pasteBlockCounter()}');
 1157:       }
 1158:       if (lines[i].isNotEmpty) {
 1159:         insertText(lines[i], applyMarkdownShortcuts: false);
 1160:       }
 1161:     }
 1162:   }
