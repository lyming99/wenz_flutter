  303: class TableCellRange {
  304:   const TableCellRange({
  305:     required this.tableBlockId,
  306:     required this.blockIndex,
  307:     required this.startRow,
  308:     required this.endRow,
  309:     required this.startColumn,
  310:     required this.endColumn,
  311:   });
