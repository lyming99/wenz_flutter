  284:       blockIndex: base.blockIndex,
  285:       startRow: baseRow < extentRow ? baseRow : extentRow,
  286:       endRow: baseRow > extentRow ? baseRow : extentRow,
  287:       startColumn: baseColumn < extentColumn ? baseColumn : extentColumn,
  288:       endColumn: baseColumn > extentColumn ? baseColumn : extentColumn,
