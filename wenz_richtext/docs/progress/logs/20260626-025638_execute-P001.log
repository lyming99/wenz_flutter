8597:class _DashedRRectBorderPainter extends CustomPainter {
8598:  const _DashedRRectBorderPainter({
8599:    required this.color,
8600:    required this.radius,
8601:    this.strokeWidth = 1,
8602:    this.dashLength = 7,
8603:    this.gapLength = 4,
8604:  });
8605:
8606:  final Color color;
8607:  final double radius;
8608:  final double strokeWidth;
8609:  final double dashLength;
8610:  final double gapLength;
8611:
8612:  @override
8613:  void paint(Canvas canvas, Size size) {
8614:    final paint = Paint()
8615:      ..color = color
8616:      ..style = PaintingStyle.stroke
8617:      ..strokeWidth = strokeWidth;
8618:    final path = Path()
8619:      ..addRRect(
8620:        RRect.fromRectAndRadius(
8621:          Offset.zero & size,
8622:          Radius.circular(radius),
8623:        ).deflate(strokeWidth / 2),
8624:      );
8625:    for (final metric in path.computeMetrics()) {
8626:      var distance = 0.0;
8627:      while (distance < metric.length) {
8628:        final end = math.min(distance + dashLength, metric.length);
8629:        canvas.drawPath(metric.extractPath(distance, end), paint);
8630:        distance += dashLength + gapLength;
8631:      }
8632:    }
8633:  }
8634:
8635:  @override
8636:  bool shouldRepaint(covariant _DashedRRectBorderPainter oldDelegate) {
8637:    return oldDelegate.color != color ||
8638:        oldDelegate.radius != radius ||
8639:        oldDelegate.strokeWidth != strokeWidth ||
8640:        oldDelegate.dashLength != dashLength ||
8641:        oldDelegate.gapLength != gapLength;
8642:  }
8643:}
