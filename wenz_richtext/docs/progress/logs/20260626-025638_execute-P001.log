295:class _TableFloatingToolbarOverlayAnchorState
296:    extends State<TableFloatingToolbarOverlayAnchor>
297:    with WidgetsBindingObserver {
298:  final LayerLink _anchorLink = LayerLink();
299:  final Object _owner = Object();
300:  ScrollPosition? _scrollPosition;
301:  bool _syncScheduled = false;
302:
303:  @override
304:  void initState() {
305:    super.initState();
306:    WidgetsBinding.instance.addObserver(this);
307:    _scheduleSync();
308:  }
309:
310:  @override
311:  void didUpdateWidget(covariant TableFloatingToolbarOverlayAnchor oldWidget) {
312:    super.didUpdateWidget(oldWidget);
313:    if (oldWidget.controller != widget.controller ||
314:        oldWidget.tableBlockId != widget.tableBlockId) {
315:      oldWidget.controller?.unregisterAnchor(owner: _owner);
316:    }
317:    _scheduleSync();
318:  }
319:
320:  @override
321:  void didChangeDependencies() {
322:    super.didChangeDependencies();
323:    _syncScrollPosition(Scrollable.maybeOf(context)?.position);
324:    _scheduleSync();
325:  }
326:
327:  @override
328:  void didChangeMetrics() {
329:    _scheduleSync();
330:  }
331:
332:  @override
333:  void dispose() {
334:    WidgetsBinding.instance.removeObserver(this);
335:    _scrollPosition?.removeListener(_scheduleSync);
336:    widget.controller?.unregisterAnchor(owner: _owner);
337:    super.dispose();
338:  }
339:
340:  @override
341:  Widget build(BuildContext context) {
342:    _scheduleSync();
343:    return CompositedTransformTarget(
344:      link: _anchorLink,
345:      child: widget.child,
346:    );
347:  }
348:
349:  void _scheduleSync() {
350:    if (_syncScheduled) {
351:      return;
352:    }
353:    _syncScheduled = true;
354:    WidgetsBinding.instance.addPostFrameCallback((_) {
355:      _syncScheduled = false;
356:      _syncRequest();
357:    });
358:  }
359:
360:  void _syncScrollPosition(ScrollPosition? position) {
361:    if (identical(_scrollPosition, position)) {
362:      return;
363:    }
364:    _scrollPosition?.removeListener(_scheduleSync);
365:    _scrollPosition = position;
366:    _scrollPosition?.addListener(_scheduleSync);
367:  }
368:
369:  void _syncRequest() {
370:    if (!mounted) {
371:      return;
372:    }
373:    final controller = widget.controller;
374:    if (controller == null) {
375:      return;
376:    }
377:    final renderObject = context.findRenderObject();
378:    if (renderObject is! RenderBox ||
379:        !renderObject.attached ||
380:        !renderObject.hasSize) {
381:      controller.unregisterAnchor(owner: _owner);
382:      return;
383:    }
384:    final overlayBox = _overlayRenderBoxFor(context);
385:    final anchorTopLeft = renderObject.localToGlobal(
386:      Offset.zero,
387:      ancestor: overlayBox,
388:    );
389:    final anchorRect = anchorTopLeft & renderObject.size;
390:    final visibleTop = _visibleTopFor(context, overlayBox);
391:    controller.updateAnchor(
392:      TableFloatingToolbarAnchorSnapshot(
393:        owner: _owner,
394:        anchorLink: _anchorLink,
395:        anchorRect: anchorRect,
396:        visibleTop: visibleTop,
397:        tableBlockId: widget.tableBlockId,
398:        blockIndex: widget.blockIndex,
399:      ),
400:    );
401:    final requestBuilder = widget.requestBuilder;
402:    if (requestBuilder == null) {
403:      controller.hide(owner: _owner);
404:      return;
405:    }
406:    controller.show(
407:      requestBuilder(
408:        owner: _owner,
409:        anchorLink: _anchorLink,
410:        anchorRect: anchorRect,
411:        visibleTop: visibleTop,
412:      ),
413:      replaceDifferentRequest: false,
414:    );
415:  }
416:
417:  RenderBox? _overlayRenderBoxFor(BuildContext context) {
418:    final renderObject = Overlay.maybeOf(context)?.context.findRenderObject();
419:    if (renderObject is RenderBox &&
420:        renderObject.attached &&
421:        renderObject.hasSize) {
422:      return renderObject;
423:    }
424:    return null;
425:  }
426:
427:  double _visibleTopFor(BuildContext context, RenderBox? overlayBox) {
428:    final scrollable = Scrollable.maybeOf(context);
429:    final viewportObject = scrollable?.context.findRenderObject();
430:    if (viewportObject is RenderBox &&
431:        viewportObject.attached &&
432:        viewportObject.hasSize) {
433:      return viewportObject.localToGlobal(Offset.zero, ancestor: overlayBox).dy;
434:    }
435:    final paddingTop = MediaQuery.maybeOf(context)?.padding.top ?? 0;
436:    if (overlayBox == null) {
437:      return paddingTop;
438:    }
439:    return overlayBox.globalToLocal(Offset(0, paddingTop)).dy;
440:  }
441:}
