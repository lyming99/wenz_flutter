457:class _TableFloatingToolbarOverlayEntryState
458:    extends State<_TableFloatingToolbarOverlayEntry> {
459:  final GlobalKey _toolbarKey = GlobalKey();
460:  Size? _toolbarSize;
461:  bool _measureScheduled = false;
462:
463:  @override
464:  Widget build(BuildContext context) {
465:    _scheduleMeasure();
466:    final request = widget.request;
467:    final toolbarHeight = _toolbarSize?.height ?? request.fallbackHeight;
468:    final overlayWidth = math.max(0.0, widget.overlaySize.width);
469:    final maxWidth = overlayWidth;
470:    final minWidth = math.min(request.minWidth, maxWidth);
471:    final toolbarWidth = (_toolbarSize?.width ?? minWidth).clamp(
472:      0.0,
473:      maxWidth,
474:    );
475:    final maxLeft = math.max(0.0, overlayWidth - toolbarWidth);
476:    final left = (request.anchorRect.right - toolbarWidth)
477:        .clamp(0.0, maxLeft)
478:        .toDouble();
479:    final top = math.max(
480:      request.anchorRect.top - toolbarHeight - request.gap,
481:      request.visibleTop,
482:    );
483:
484:    return Positioned(
485:      left: left,
486:      top: top,
487:      child: ConstrainedBox(
488:        key: _toolbarKey,
489:        constraints: BoxConstraints(
490:          minWidth: minWidth,
491:          maxWidth: maxWidth,
492:        ),
493:        child: Listener(
494:          key: const ValueKey<String>(
495:            'table-floating-toolbar-hit-test-blocker',
496:          ),
497:          behavior: HitTestBehavior.opaque,
498:          child: request.toolbarBuilder(context),
499:        ),
500:      ),
501:    );
502:  }
503:
504:  void _scheduleMeasure() {
505:    if (_measureScheduled) {
506:      return;
507:    }
508:    _measureScheduled = true;
509:    WidgetsBinding.instance.addPostFrameCallback((_) {
510:      _measureScheduled = false;
511:      _syncToolbarHeight();
512:    });
513:  }
514:
515:  void _syncToolbarHeight() {
516:    if (!mounted) {
517:      return;
518:    }
