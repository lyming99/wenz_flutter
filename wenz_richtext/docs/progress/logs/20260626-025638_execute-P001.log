5513:                builder: (context, constraints) {
5514:                  final textDirection = Directionality.of(context);
5515:                  final availableWidth = constraints.maxWidth.isFinite
5516:                      ? constraints.maxWidth
5517:                      : MediaQuery.sizeOf(context).width;
5518:                  final contentWidth = math.max(
5519:                    availableWidth,
5520:                    _measureInlineSpanWidth(codeSpan, textDirection) + 1,
5521:                  );
5522:                  return SingleChildScrollView(
5523:                    key: ValueKey<String>(
5524:                      'wenz-richtext-code-scroll-${block.id}',
5525:                    ),
5526:                    scrollDirection: Axis.horizontal,
5527:                    child: SizedBox(
5528:                      width: contentWidth,
5529:                      child: _TextSelectionSurface(
5530:                        blockId: block.id,
5531:                        blockIndex: blockIndex,
5532:                        path: path,
5533:                        textLength: block.code.length,
5534:                        textSpan: codeSpan,
5535:                        offsetMapper: _InlineOffsetMapper.identity(
5536:                          block.code.length,
5537:                        ),
5538:                        textAlign: TextAlign.start,
5539:                        minHeight: (codeStyle.fontSize ?? _kCodeBlockFontSize) *
5540:                            _kBlockMinHeightFactor,
5541:                        selection: selection,
5542:                        showCaret: showCaret,
5543:                        registry: registry,
5544:                        showDebugOverlay: showDebugOverlay,
5545:                        findRanges: _findRangesForPath(
5546:                          findMatches,
5547:                          currentFindMatch,
5548:                          blockIndex,
5549:                          path,
5550:                          block.code.length,
5551:                        ),
5552:                      ),
5553:                    ),
5554:                  );
5555:                },
5556:              ),
5557:            ],
5558:          ),
5559:        ),
5560:      ),
5561:      selected: selected,
5562:    );
5563:  }
5564:}
5565:
5566:double _measureInlineSpanWidth(InlineSpan span, TextDirection textDirection) {
5567:  final painter = TextPainter(
5568:    text: span,
5569:    textDirection: textDirection,
5570:  )..layout(maxWidth: double.infinity);
5571:  final width = painter.width;
5572:  painter.dispose();
5573:  return width.isFinite ? width : 0;
5574:}
