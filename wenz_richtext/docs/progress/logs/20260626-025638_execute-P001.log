104:/// Editor-owned controller for the active table toolbar overlay request.
105:class TableFloatingToolbarOverlayController extends ChangeNotifier {
106:  TableFloatingToolbarOverlayRequest? _request;
107:  final Map<String, TableFloatingToolbarAnchorSnapshot> _anchors =
108:      <String, TableFloatingToolbarAnchorSnapshot>{};
109:
110:  TableFloatingToolbarOverlayRequest? get request => _request;
111:
112:  TableFloatingToolbarAnchorSnapshot? anchorFor(
113:    String tableBlockId, {
114:    int? blockIndex,
115:  }) {
116:    final anchor = _anchors[tableBlockId];
117:    if (anchor == null ||
118:        (blockIndex != null && anchor.blockIndex != blockIndex)) {
119:      return null;
120:    }
121:    return anchor;
122:  }
123:
124:  void updateAnchor(TableFloatingToolbarAnchorSnapshot anchor) {
125:    _anchors[anchor.tableBlockId] = anchor;
126:  }
127:
128:  void unregisterAnchor({required Object owner}) {
129:    _anchors.removeWhere((_, anchor) => identical(anchor.owner, owner));
130:    hide(owner: owner);
131:  }
132:
133:  void show(
134:    TableFloatingToolbarOverlayRequest request, {
135:    bool replaceDifferentRequest = true,
136:  }) {
137:    final current = _request;
138:    if (!replaceDifferentRequest &&
139:        current != null &&
140:        !_targetsSameActiveSelection(current, request)) {
141:      return;
142:    }
143:    _request = request;
144:    notifyListeners();
145:  }
146:
147:  bool _targetsSameActiveSelection(
148:    TableFloatingToolbarOverlayRequest current,
149:    TableFloatingToolbarOverlayRequest next,
150:  ) {
151:    return identical(current.owner, next.owner) ||
152:        (current.tableBlockId == next.tableBlockId &&
153:            current.blockIndex == next.blockIndex &&
154:            current.selectionRange == next.selectionRange);
155:  }
156:
157:  void hide({Object? owner}) {
158:    final current = _request;
159:    if (current == null) {
160:      return;
161:    }
162:    if (owner != null && !identical(current.owner, owner)) {
163:      return;
164:    }
165:    _request = null;
166:    notifyListeners();
167:  }
168:}
