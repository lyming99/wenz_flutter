5101:class _HeadingCollapseButtonState extends State<_HeadingCollapseButton> {
5102:  final GlobalKey _hitTestKey = GlobalKey();
5103:  final FocusNode _focusNode = FocusNode(
5104:    debugLabel: 'Wenz heading collapse button',
5105:  );
5106:
5107:  @override
5108:  void initState() {
5109:    super.initState();
5110:    widget.registry.registerSelectionExclusion(_hitTestKey);
5111:  }
5112:
5113:  @override
5114:  void didUpdateWidget(covariant _HeadingCollapseButton oldWidget) {
5115:    super.didUpdateWidget(oldWidget);
5116:    if (oldWidget.registry != widget.registry) {
5117:      oldWidget.registry.unregisterSelectionExclusion(_hitTestKey);
5118:      widget.registry.registerSelectionExclusion(_hitTestKey);
5119:    }
5120:  }
5121:
5122:  @override
5123:  void dispose() {
5124:    widget.registry.unregisterSelectionExclusion(_hitTestKey);
5125:    _focusNode.dispose();
5126:    super.dispose();
5127:  }
5128:
5129:  void _toggle() {
5130:    _focusNode.requestFocus();
5131:    widget.onToggled?.call(widget.blockId);
5132:    WidgetsBinding.instance.addPostFrameCallback((_) {
5133:      if (mounted && widget.state.canCollapse) {
5134:        _focusNode.requestFocus();
5135:      }
5136:    });
5137:  }
5138:
5139:  KeyEventResult _handleKeyEvent(FocusNode node, KeyEvent event) {
5140:    if (!widget.state.canCollapse ||
5141:        widget.onToggled == null ||
5142:        (event is! KeyDownEvent && event is! KeyRepeatEvent)) {
5143:      return KeyEventResult.ignored;
5144:    }
5145:    final key = event.logicalKey;
5146:    if (key == LogicalKeyboardKey.enter ||
5147:        key == LogicalKeyboardKey.numpadEnter ||
5148:        key == LogicalKeyboardKey.space) {
5149:      _toggle();
5150:      return KeyEventResult.handled;
5151:    }
5152:    return KeyEventResult.ignored;
5153:  }
5154:
5155:  @override
5156:  Widget build(BuildContext context) {
5157:    final theme = Theme.of(context);
5158:    final scheme = theme.colorScheme;
5159:    final enabled = widget.state.canCollapse && widget.onToggled != null;
5160:    final overlay = scheme.primary.withAlpha(22);
5161:    return MouseRegion(
5162:      cursor: enabled ? SystemMouseCursors.click : SystemMouseCursors.basic,
5163:      child: SizedBox(
5164:        key: _hitTestKey,
5165:        width: _kHeadingCollapseSlotWidth,
5166:        height: _kHeadingCollapseButtonSize,
5167:        child: Align(
5168:          alignment: AlignmentDirectional.topStart,
5169:          child: Focus(
5170:            canRequestFocus: false,
5171:            skipTraversal: true,
5172:            onKeyEvent: _handleKeyEvent,
5173:            child: IconButton(
5174:              key: ValueKey<String>(
5175:                'wenz-richtext-heading-collapse-${widget.blockId}',
5176:              ),
5177:              focusNode: _focusNode,
5178:              tooltip: _headingCollapseTooltip(widget.state),
5179:              onPressed: enabled ? _toggle : null,
5180:              iconSize: _kHeadingCollapseIconSize,
5181:              padding: EdgeInsets.zero,
5182:              constraints: const BoxConstraints.tightFor(
5183:                width: _kHeadingCollapseButtonSize,
5184:                height: _kHeadingCollapseButtonSize,
5185:              ),
5186:              visualDensity: VisualDensity.compact,
5187:              splashRadius: _kHeadingCollapseButtonSize / 2,
5188:              color: scheme.onSurfaceVariant,
5189:              disabledColor: scheme.outline.withAlpha(110),
5190:              focusColor: overlay,
5191:              hoverColor: overlay,
5192:              highlightColor: scheme.primary.withAlpha(34),
5193:              icon: _HeadingCollapseGlyph(
5194:                state: widget.state,
5195:                enabled: enabled,
5196:              ),
5197:            ),
5198:          ),
5199:        ),
5200:      ),
5201:    );
5202:  }
5203:}
