457:class _TableFloatingToolbarOverlayEntryState
458:    extends State<_TableFloatingToolbarOverlayEntry> {
459:  final GlobalKey _toolbarKey = GlobalKey();
460:  double? _toolbarHeight;
461:  bool _measureScheduled = false;
462:
463:  @override
464:  Widget build(BuildContext context) {
465:    _scheduleMeasure();
466:    final request = widget.request;
467:    final toolbarHeight = _toolbarHeight ?? request.fallbackHeight;
468:    final minWidth = math.max(request.minWidth, request.anchorRect.width);
469:    final maxLeft = math.max(0, widget.overlaySize.width - minWidth);
470:    final left = request.anchorRect.left.clamp(0.0, maxLeft).toDouble();
471:    final top = math.max(
472:      request.anchorRect.top - toolbarHeight - request.gap,
473:      request.visibleTop,
474:    );
475:
476:    return Positioned(
477:      left: left,
478:      top: top,
479:      child: ConstrainedBox(
480:        key: _toolbarKey,
481:        constraints: BoxConstraints(minWidth: minWidth),
482:        child: Listener(
483:          key: const ValueKey<String>(
484:            'table-floating-toolbar-hit-test-blocker',
485:          ),
486:          behavior: HitTestBehavior.opaque,
487:          child: request.toolbarBuilder(context),
488:        ),
489:      ),
490:    );
491:  }
492:
493:  void _scheduleMeasure() {
494:    if (_measureScheduled) {
495:      return;
496:    }
497:    _measureScheduled = true;
498:    WidgetsBinding.instance.addPostFrameCallback((_) {
499:      _measureScheduled = false;
500:      _syncToolbarHeight();
501:    });
502:  }
503:
504:  void _syncToolbarHeight() {
505:    if (!mounted) {
506:      return;
507:    }
508:    final renderObject = _toolbarKey.currentContext?.findRenderObject();
509:    if (renderObject is! RenderBox || !renderObject.hasSize) {
510:      return;
511:    }
512:    final nextHeight = renderObject.size.height;
513:    if (_toolbarHeight != null && (_toolbarHeight! - nextHeight).abs() < 0.5) {
514:      return;
515:    }
516:    setState(() {
517:      _toolbarHeight = nextHeight;
518:    });
519:  }
520:}

