258:    if (!mounted) {
259:      return;
260:    }
261:    final shouldShow = _request?.enabled == true;
262:    if (shouldShow) {
263:      if (!_portalController.isShowing) {
264:        _portalController.show();
265:      }
266:    } else if (_portalController.isShowing) {
267:      _portalController.hide();
268:    }
