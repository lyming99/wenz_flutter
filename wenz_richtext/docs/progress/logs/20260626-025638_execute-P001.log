5851:
5852:TableCellRange? _activeTableRange(
5853:  DocumentSelection? selection,
5854:  TableBlockNode tableBlock,
5855:  int blockIndex,
5856:) {
5857:  final range = selection?.tableCellRange;
5858:  if (range == null ||
5859:      range.tableBlockId != tableBlock.id ||
5860:      range.blockIndex != blockIndex) {
5861:    return null;
5862:  }
5863:  final rowCount = tableBlock.table.rowCount;
5864:  final columnCount = tableBlock.table.columnCount;
5865:  if (rowCount == 0 || columnCount == 0) {
5866:    return null;
5867:  }
5868:  return TableCellRange(
5869:    tableBlockId: tableBlock.id,
5870:    blockIndex: blockIndex,
5871:    startRow: range.startRow.clamp(0, rowCount - 1).toInt(),
5872:    endRow: range.endRow.clamp(0, rowCount - 1).toInt(),
5873:    startColumn: range.startColumn.clamp(0, columnCount - 1).toInt(),
5874:    endColumn: range.endColumn.clamp(0, columnCount - 1).toInt(),
5875:  );
5876:}
