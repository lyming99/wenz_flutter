238:  void _handleControllerChanged() {
239:    if (!mounted) {
240:      return;
241:    }
242:    setState(() {
243:      _request = widget.controller.request;
244:    });
245:    _syncPortalSafely();
246:  }
247:
248:  void _syncPortalSafely() {
249:    if (SchedulerBinding.instance.schedulerPhase ==
250:        SchedulerPhase.persistentCallbacks) {
251:      WidgetsBinding.instance.addPostFrameCallback((_) => _syncPortal());
252:      return;
253:    }
254:    _syncPortal();
255:  }
256:
