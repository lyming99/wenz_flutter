+class _BlockFloatingToolbarSurface extends StatelessWidget {
+  const _BlockFloatingToolbarSurface({
+    required this.child,
+    this.toolbar,
+    this.inset = _kBlockFloatingToolbarInset,
+    this.placeAbove = false,
+    this.estimatedToolbarHeight = _kObjectFloatingToolbarEstimatedHeight,
+  });
+
+  final Widget child;
+  final Widget? toolbar;
+  final double inset;
+  final bool placeAbove;
+  final double estimatedToolbarHeight;
+
+  @override
+  Widget build(BuildContext context) {
+    final toolbar = this.toolbar;
+    if (toolbar == null) {
+      return child;
+    }
+    return Stack(
+      clipBehavior: Clip.none,
+      children: <Widget>[
+        child,
+        PositionedDirectional(
+          top: placeAbove
+              ? -(estimatedToolbarHeight + _kBlockFloatingToolbarGap)
+              : inset,
+          end: inset,
+          child: toolbar,
+        ),
+      ],
+    );
+  }
+}
