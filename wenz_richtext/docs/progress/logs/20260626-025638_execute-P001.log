417:  RenderBox? _overlayRenderBoxFor(BuildContext context) {
418:    final renderObject = Overlay.maybeOf(context)?.context.findRenderObject();
419:    if (renderObject is RenderBox &&
420:        renderObject.attached &&
421:        renderObject.hasSize) {
422:      return renderObject;
423:    }
424:    return null;
425:  }
