  745:     selection,
  746:     tableBlock,
  747:     blockIndex,
  748:     rows,
  749:     mapRow: (rowIndex) => rowIndex > deletedRowIndex ? rowIndex - 1 : rowIndex,
  750:     mapColumn: (columnIndex) => columnIndex,
  751:   );
  752: }
  753: 
  754: DocumentSelection? _tableSelectionAfterColumnDeleted(
  755:   DocumentSelection? selection,
  756:   TableBlockNode tableBlock,
  757:   int blockIndex,
  758:   List<List<TableCellNode>> rows,
  759:   int deletedColumnIndex,
  760: ) {
  761:   return _mapTableSelection(
  762:     selection,
  763:     tableBlock,
  764:     blockIndex,
  765:     rows,
  766:     mapRow: (rowIndex) => rowIndex,
  767:     mapColumn: (columnIndex) =>
  768:         columnIndex > deletedColumnIndex ? columnIndex - 1 : columnIndex,
  769:   );
  770: }
  771: 
  772: DocumentSelection? _mapTableSelection(
  773:   DocumentSelection? selection,
  774:   TableBlockNode tableBlock,
  775:   int blockIndex,
  776:   List<List<TableCellNode>> rows, {
  777:   required int Function(int rowIndex) mapRow,
  778:   required int Function(int columnIndex) mapColumn,
  779: }) {
  780:   final range = selection?.tableCellRange;
  781:   if (selection == null ||
  782:       range == null ||
  783:       range.tableBlockId != tableBlock.id ||
  784:       range.blockIndex != blockIndex) {
  785:     return null;
  786:   }
  787:   final base = _mapTablePosition(
  788:     selection.base,
  789:     tableBlock,
  790:     blockIndex,
  791:     rows,
  792:     mapRow: mapRow,
  793:     mapColumn: mapColumn,
  794:   );
  795:   final extent = _mapTablePosition(
  796:     selection.extent,
  797:     tableBlock,
  798:     blockIndex,
  799:     rows,
  800:     mapRow: mapRow,
  801:     mapColumn: mapColumn,
  802:   );
  803:   if (base == null || extent == null) {
  804:     return null;
  805:   }
  806:   return DocumentSelection(base: base, extent: extent);
  807: }
  808: 
  809: DocumentPosition? _mapTablePosition(
  810:   DocumentPosition position,
  811:   TableBlockNode tableBlock,
  812:   int blockIndex,
  813:   List<List<TableCellNode>> rows, {
  814:   required int Function(int rowIndex) mapRow,
  815:   required int Function(int columnIndex) mapColumn,
  816: }) {
  817:   final sourceRowIndex = position.path.tableRowIndex;
  818:   final sourceColumnIndex = position.path.tableColumnIndex;
  819:   if (position.blockId != tableBlock.id ||
  820:       position.blockIndex != blockIndex ||
  821:       sourceRowIndex == null ||
  822:       sourceColumnIndex == null ||
  823:       rows.isEmpty) {
  824:     return null;
  825:   }
  826:   final rowIndex = mapRow(sourceRowIndex).clamp(0, rows.length - 1).toInt();
  827:   final row = rows[rowIndex];
  828:   if (row.isEmpty) {
  829:     return null;
  830:   }
  831:   final columnIndex =
  832:       mapColumn(sourceColumnIndex).clamp(0, row.length - 1).toInt();
  833:   final textLength = cellTextBlock(row[columnIndex]).plainText.length;
  834:   return DocumentPosition.tableCell(
  835:     tableBlockId: tableBlock.id,
  836:     blockIndex: blockIndex,
  837:     tableRowIndex: rowIndex,
  838:     tableColumnIndex: columnIndex,
  839:     offset: position.offset.clamp(0, textLength).toInt(),
  840:   );
  841: }
