 5237:   });
 5238: 
 5239:   final TableBlockNode block;
 5240:   final int blockIndex;
 5241:   final DocumentSelection? selection;
 5242:   final CompositionState? compositionState;
 5243:   final BlockGeometryRegistry registry;
 5244:   final bool showCaret;
 5245:   final TextStyle? textStyle;
 5246:   final bool showDebugOverlay;
 5247:   final InlineEmbedRenderer? inlineEmbedRenderer;
 5248:   final TableToolbarActionHandler? onToolbarAction;
 5249:   final TableFloatingToolbarOverlayController? toolbarOverlayController;
 5250:   final TableColumnResizeHandler? onColumnResize;
 5251:   final List<FindReplaceMatch> findMatches;
 5252:   final FindReplaceMatch? currentFindMatch;
 5253: 
 5254:   @override
 5255:   Widget build(BuildContext context) {
 5256:     final table = block.table;
 5257:     final columnCount = table.columnCount;
 5258:     if (table.rowCount == 0 || columnCount == 0) {
 5259:       return const SizedBox.shrink();
 5260:     }
 5261:     final theme = Theme.of(context);
 5262:     final effectiveStyle = textStyle ?? DefaultTextStyle.of(context).style;
 5263:     final tableTextStyle =
 5264:         effectiveStyle.copyWith(fontSize: _kTableCellFontSize);
 5265:     return _withBlockSemantics(
 5266:       block,
 5267:       LayoutBuilder(
 5268:         builder: (context, constraints) {
 5269:           final metrics = _TableGridMetrics.compute(
 5270:             table: table,
 5271:             maxWidth: _tableMaxWidth(constraints, columnCount),
 5272:             textStyle: tableTextStyle,
 5273:             textDirection: Directionality.of(context),
 5274:           );
 5275:           final activeRange =
 5276:               _activeTableRange(selection, block.id, blockIndex);
 5277:           final stackWidth = metrics.width;
 5278:           final resizeHeight = metrics.height;
 5279:           final tableSurface = SizedBox(
 5280:             width: stackWidth,
 5281:             height: metrics.height,
 5282:             child: Stack(
 5283:               clipBehavior: Clip.none,
 5284:               children: <Widget>[
 5285:                 Positioned.fill(
 5286:                   child: DecoratedBox(
 5287:                     decoration: BoxDecoration(
 5288:                       color: theme.colorScheme.surface,
 5289:                       borderRadius: BorderRadius.circular(_kTableSurfaceRadius),
 5290:                       boxShadow: _kSurfaceBoxShadow,
 5291:                     ),
 5292:                   ),
 5293:                 ),
 5294:                 ClipRRect(
 5295:                   borderRadius: BorderRadius.circular(_kTableSurfaceRadius),
 5296:                   child: SizedBox(
 5297:                     width: stackWidth,
 5298:                     height: metrics.height,
 5299:                     child: Stack(
 5300:                       clipBehavior: Clip.none,
 5301:                       children: <Widget>[
 5302:                         for (final cell in metrics.cells)
 5303:                           Positioned(
 5304:                             left: cell.left,
 5305:                             top: cell.top,
 5306:                             width: cell.width,
 5307:                             height: cell.height,
 5308:                             child: DecoratedBox(
 5309:                               key: ValueKey<String>(
 5310:                                 'table-cell-border-${block.id}-${cell.rowIndex}-${cell.columnIndex}',
 5311:                               ),
 5312:                               decoration: BoxDecoration(
 5313:                                 border: _tableCellBorder(
 5314:                                   cell: cell,
 5315:                                   rowCount: table.rowCount,
 5316:                                   columnCount: columnCount,
 5317:                                   color: _kTableBorderColor,
 5318:                                 ),
 5319:                               ),
 5320:                               child: _TableCellSurface(
 5321:                                 tableBlock: block,
 5322:                                 blockIndex: blockIndex,
 5323:                                 rowIndex: cell.rowIndex,
 5324:                                 columnIndex: cell.columnIndex,
 5325:                                 cell: cell.cell,
 5326:                                 textStyle: tableTextStyle,
 5327:                                 textAlign: _textAlign(
 5328:                                   table.columnAlignments[cell.columnIndex],
 5329:                                 ),
 5330:                                 selection: selection,
 5331:                                 compositionState: compositionState,
 5332:                                 registry: registry,
 5333:                                 showCaret: showCaret,
 5334:                                 highlightWholeCell: _shouldHighlightTableCell(
 5335:                                   selection,
 5336:                                   block.id,
 5337:                                   blockIndex,
 5338:                                   cell.rowIndex,
 5339:                                   cell.columnIndex,
 5340:                                 ),
 5341:                                 showDebugOverlay: showDebugOverlay,
 5342:                                 inlineEmbedRenderer: inlineEmbedRenderer,
 5343:                                 findMatches: findMatches,
 5344:                                 currentFindMatch: currentFindMatch,
 5345:                               ),
 5346:                             ),
 5347:                           ),
 5348:                       ],
 5349:                     ),
 5350:                   ),
 5351:                 ),
 5352:                 if (activeRange != null &&
 5353:                     onColumnResize != null &&
 5354:                     resizeHeight > 0)
 5355:                   for (var column = 0;
 5356:                       column < metrics.columnWidths.length;
 5357:                       column++)
 5358:                     Positioned(
 5359:                       left: metrics.columnLefts[column] +
 5360:                           metrics.columnWidths[column] -
 5361:                           (_kTableResizeHandleWidth / 2),
 5362:                       top: 0,
 5363:                       width: _kTableResizeHandleWidth,
 5364:                       height: resizeHeight,
 5365:                       child: _TableColumnResizeHandle(
 5366:                         key: ValueKey<String>(
 5367:                           'table-resize-${block.id}-$column',
 5368:                         ),
 5369:                         columnIndex: column,
 5370:                         width: metrics.columnWidths[column],
 5371:                         onResize: (width) {
 5372:                           onColumnResize!(
 5373:                             blockIndex: blockIndex,
 5374:                             columnIndex: column,
 5375:                             width: width,
 5376:                           );
 5377:                         },
 5378:                       ),
 5379:                     ),
 5380:               ],
 5381:             ),
 5382:           );
 5383:           return TableFloatingToolbarOverlayAnchor(
 5384:             controller: toolbarOverlayController,
 5385:             requestBuilder: activeRange != null && onToolbarAction != null
 5386:                 ? ({
 5387:                     required Object owner,
 5388:                     required LayerLink anchorLink,
 5389:                     required Rect anchorRect,
 5390:                     required double visibleTop,
 5391:                   }) =>
 5392:                     TableFloatingToolbarOverlayRequest(
 5393:                       owner: owner,
 5394:                       anchorLink: anchorLink,
 5395:                       anchorRect: anchorRect,
 5396:                       visibleTop: visibleTop,
 5397:                       tableBlockId: block.id,
 5398:                       blockIndex: blockIndex,
 5399:                       selectionRange: activeRange,
 5400:                       minWidth: _kTableToolbarMinWidth,
 5401:                       gap: _kTableFloatingToolbarGap,
 5402:                       fallbackHeight: _kTableFloatingToolbarEstimatedHeight,
 5403:                       toolbarBuilder: (context) => _TableFloatingToolbar(
 5404:                         block: block,
 5405:                         blockIndex: blockIndex,
 5406:                         range: activeRange,
 5407:                         onAction: onToolbarAction!,
 5408:                       ),
 5409:                     )
 5410:                 : null,
 5411:             child: tableSurface,
 5412:           );
 5413:         },
 5414:       ),
 5415:     );
 5416:   }
 5417: }
