Map<int, T> shiftColumnMapOnInsert<T>(Map<int, T> values, int insertIndex) {
  return <int, T>{
    for (final entry in values.entries)
      if (entry.key < insertIndex)
        entry.key: entry.value
      else
        entry.key + 1: entry.value,
  };
