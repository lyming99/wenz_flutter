 3214:     this.onTableColumnResize,
 3215:     this.onTodoCheckedChanged,
 3216:     this.onObjectBlockAction,
 3217:     this.findMatches = const <FindReplaceMatch>[],
 3218:     this.currentFindMatch,
 3219:   });
