  737: DocumentSelection? _tableSelectionAfterRowDeleted(
  738:   DocumentSelection? selection,
  739:   TableBlockNode tableBlock,
  740:   int blockIndex,
  741:   List<List<TableCellNode>> rows,
  742:   int deletedRowIndex,
