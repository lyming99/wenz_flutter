  451:         anchor.covered ||
  452:         (anchor.rowSpan == 1 && anchor.columnSpan == 1)) {
  453:       return const CommandResult(recordHistory: false);
  454:     }
  455:     final bottom = rowIndex + anchor.rowSpan - 1;
  456:     final right = columnIndex + anchor.columnSpan - 1;
  457:     if (bottom >= tableBlock.table.rowCount ||
  458:         right >= tableBlock.table.columnCount) {
  459:       return const CommandResult(recordHistory: false);
  460:     }
  461:     final rows = tableBlock.table.rows.map(copyRow).toList();
