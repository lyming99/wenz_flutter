 3254: class _KeepAliveBlockState extends State<_KeepAliveBlock>
 3255:     with AutomaticKeepAliveClientMixin {
 3256:   @override
 3257:   bool get wantKeepAlive => widget.keepAlive;
 3258: 
 3259:   /// Cached child from the last build that actually rendered. Reused when the
 3260:   /// block's content and selection-relevance are unchanged.
 3261:   Widget? _cachedChild;
 3262: 
 3263:   @override
 3264:   void didUpdateWidget(covariant _KeepAliveBlock oldWidget) {
 3265:     super.didUpdateWidget(oldWidget);
 3266:     if (oldWidget.keepAlive != widget.keepAlive) {
 3267:       updateKeepAlive();
 3268:     }
 3269:     // Invalidate the cache when something this block renders depends on
 3270:     // changed. Content change, selection/caret/composition touching this block,
 3271:     // or ambient style/debug toggles all force a fresh render.
 3272:     //
 3273:     // Selection requires care: a block that stays selected while the selection
 3274:     // extent moves within it (e.g. dragging to resize a range) does not flip
 3275:     // the boolean "touches" flag, but the rendered highlight/caret offset DID
 3276:     // change. So when this block is touched by the selection, a different
 3277:     // selection object must also invalidate the cache.
 3278:     final selectionTouchedChanged =
 3279:         _selectionTouchesBlock(oldWidget) != _selectionTouchesBlock(widget);
 3280:     final selectionShiftedWhileTouched = _selectionTouchesBlock(widget) &&
 3281:         oldWidget.selection != widget.selection;
 3282:     if (widget.blockChanged ||
 3283:         oldWidget.blockIndex != widget.blockIndex ||
 3284:         oldWidget.blockCount != widget.blockCount ||
 3285:         selectionTouchedChanged ||
 3286:         selectionShiftedWhileTouched ||
 3287:         oldWidget.showCaret != widget.showCaret ||
 3288:         oldWidget.showDebugOverlay != widget.showDebugOverlay ||
 3289:         oldWidget.listMarker != widget.listMarker ||
 3290:         oldWidget.canEdit != widget.canEdit ||
 3291:         oldWidget.textStyle != widget.textStyle ||
 3292:         oldWidget.inlineEmbedRenderer != widget.inlineEmbedRenderer ||
 3293:         oldWidget.headingCollapseState != widget.headingCollapseState ||
 3294:         oldWidget.onHeadingCollapseToggled != widget.onHeadingCollapseToggled ||
 3295:         oldWidget.onCodeLanguageChanged != widget.onCodeLanguageChanged ||
 3296:         oldWidget.onCodeCopied != widget.onCodeCopied ||
 3297:         oldWidget.onCalloutVariantChanged != widget.onCalloutVariantChanged ||
 3298:         oldWidget.onTableToolbarAction != widget.onTableToolbarAction ||
 3299:         oldWidget.tableToolbarOverlayController !=
 3300:             widget.tableToolbarOverlayController ||
 3301:         oldWidget.onTableColumnResize != widget.onTableColumnResize ||
 3302:         oldWidget.onTodoCheckedChanged != widget.onTodoCheckedChanged ||
 3303:         oldWidget.onObjectBlockAction != widget.onObjectBlockAction ||
 3304:         oldWidget.findMatches != widget.findMatches ||
 3305:         oldWidget.currentFindMatch != widget.currentFindMatch ||
 3306:         _compositionTouchesBlock(oldWidget) !=
 3307:             _compositionTouchesBlock(widget) ||
 3308:         oldWidget.blockRenderers != widget.blockRenderers) {
 3309:       _cachedChild = null;
 3310:     }
 3311:   }
 3312: 
 3313:   @override
 3314:   Widget build(BuildContext context) {
 3315:     super.build(context);
 3316:     final cached = _cachedChild;
 3317:     if (cached != null) {
 3318:       return cached;
 3319:     }
 3320:     final child = _BlockRenderer(
 3321:       block: widget.block,
 3322:       blockIndex: widget.blockIndex,
 3323:       blockCount: widget.blockCount,
 3324:       listMarker: widget.listMarker,
 3325:       selection: widget.selection,
 3326:       compositionState: widget.compositionState,
 3327:       registry: widget.registry,
 3328:       blockRenderers: widget.blockRenderers,
 3329:       showCaret: widget.showCaret,
 3330:       textStyle: widget.textStyle,
 3331:       showDebugOverlay: widget.showDebugOverlay,
 3332:       canEdit: widget.canEdit,
 3333:       mediaResolver: widget.mediaResolver,
 3334:       inlineEmbedRenderer: widget.inlineEmbedRenderer,
 3335:       headingCollapseState: widget.headingCollapseState,
 3336:       onHeadingCollapseToggled: widget.onHeadingCollapseToggled,
 3337:       onCodeLanguageChanged: widget.onCodeLanguageChanged,
 3338:       onCodeCopied: widget.onCodeCopied,
 3339:       onCalloutVariantChanged: widget.onCalloutVariantChanged,
 3340:       onTableToolbarAction: widget.onTableToolbarAction,
 3341:       tableToolbarOverlayController: widget.tableToolbarOverlayController,
 3342:       onTableColumnResize: widget.onTableColumnResize,
 3343:       onTodoCheckedChanged: widget.onTodoCheckedChanged,
 3344:       onObjectBlockAction: widget.onObjectBlockAction,
 3345:       findMatches: widget.findMatches,
 3346:       currentFindMatch: widget.currentFindMatch,
 3347:     );
 3348:     _cachedChild = child;
 3349:     return child;
 3350:   }
 3351: 
 3352:   /// Whether the current selection could affect this block's rendering: it is
 3353:   /// an endpoint, or it lies strictly between the selection's start and end
 3354:   /// (so it would be fully highlighted), or the selection is collapsed inside
 3355:   /// it (the caret).
 3356:   bool _selectionTouchesBlock(_KeepAliveBlock w) {
 3357:     final selection = w.selection;
 3358:     if (selection == null) {
 3359:       return false;
 3360:     }
 3361:     final index = w.blockIndex;
 3362:     final start = selection.start;
 3363:     final end = selection.end;
 3364:     if (start.blockIndex == index || end.blockIndex == index) {
 3365:       return true;
 3366:     }
 3367:     // Interior block of a multi-block range is fully highlighted.
 3368:     return index > start.blockIndex && index < end.blockIndex;
 3369:   }
 3370: 
 3371:   /// Whether an active IME composition affects this block (composition lives in
 3372:   /// the caret's block). Only that block needs to repaint the underline span.
 3373:   bool _compositionTouchesBlock(_KeepAliveBlock w) {
 3374:     final composition = w.compositionState;
 3375:     if (composition == null) {
 3376:       return false;
 3377:     }
 3378:     final selection = w.selection;
 3379:     return selection != null && selection.extent.blockIndex == w.blockIndex;
 3380:   }
 3381: }
