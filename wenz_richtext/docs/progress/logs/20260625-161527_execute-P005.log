+    top: side,
+    left: side,
+    right: cell.columnIndex + cell.columnSpan >= columnCount
+        ? side
+        : BorderSide.none,
+    bottom: cell.rowIndex + cell.rowSpan >= rowCount ? side : BorderSide.none,
+  );
