  702: DocumentSelection? _tableSelectionAfterRowInserted(
  703:   DocumentSelection? selection,
  704:   TableBlockNode tableBlock,
  705:   int blockIndex,
  706:   List<List<TableCellNode>> rows,
  707:   int insertIndex,
  708: ) {
  709:   return _mapTableSelection(
  710:     selection,
  711:     tableBlock,
  712:     blockIndex,
  713:     rows,
  714:     mapRow: (rowIndex) => rowIndex >= insertIndex ? rowIndex + 1 : rowIndex,
  715:     mapColumn: (columnIndex) => columnIndex,
  716:   );
  717: }
