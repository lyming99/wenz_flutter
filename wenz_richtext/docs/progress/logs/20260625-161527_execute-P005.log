  719: DocumentSelection? _tableSelectionAfterColumnInserted(
  720:   DocumentSelection? selection,
  721:   TableBlockNode tableBlock,
  722:   int blockIndex,
  723:   List<List<TableCellNode>> rows,
  724:   int insertIndex,
  725: ) {
  726:   return _mapTableSelection(
  727:     selection,
  728:     tableBlock,
  729:     blockIndex,
  730:     rows,
  731:     mapRow: (rowIndex) => rowIndex,
  732:     mapColumn: (columnIndex) =>
  733:         columnIndex >= insertIndex ? columnIndex + 1 : columnIndex,
  734:   );
  735: }
