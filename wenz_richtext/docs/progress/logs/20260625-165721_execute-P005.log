  423:     final toolbarHeight = _toolbarHeight ?? request.fallbackHeight;
  424:     final preferredTop = -(toolbarHeight + request.gap);
  425:     final visibleTop = request.visibleTop - request.anchorRect.top;
  426:     final top = math.max(preferredTop, visibleTop);
  427:     final minWidth = math.max(request.minWidth, request.anchorRect.width);
