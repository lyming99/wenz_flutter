 3408:   /// Whether the current selection could affect this block's rendering: it is
 3409:   /// an endpoint, or it lies strictly between the selection's start and end
 3410:   /// (so it would be fully highlighted), or the selection is collapsed inside
 3411:   /// it (the caret).
 3412:   bool _selectionTouchesBlock(_KeepAliveBlock w) {
 3413:     final selection = w.selection;
 3414:     if (selection == null) {
 3415:       return false;
 3416:     }
 3417:     final index = w.blockIndex;
 3418:     final start = selection.start;
 3419:     final end = selection.end;
 3420:     if (start.blockIndex == index || end.blockIndex == index) {
 3421:       return true;
 3422:     }
 3423:     // Interior block of a multi-block range is fully highlighted.
 3424:     return index > start.blockIndex && index < end.blockIndex;
 3425:   }
 3426: 
 3427:   /// Whether an active IME composition affects this block (composition lives in
 3428:   /// the caret's block). Only that block needs to repaint the underline span.
 3429:   bool _compositionTouchesBlock(_KeepAliveBlock w) {
 3430:     final composition = w.compositionState;
 3431:     if (composition == null) {
 3432:       return false;
 3433:     }
 3434:     final selection = w.selection;
 3435:     return selection != null && selection.extent.blockIndex == w.blockIndex;
 3436:   }
 3437: }
