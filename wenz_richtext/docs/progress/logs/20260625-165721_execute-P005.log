  413: class _TableFloatingToolbarOverlayEntryState
  414:     extends State<_TableFloatingToolbarOverlayEntry> {
  415:   final GlobalKey _toolbarKey = GlobalKey();
  416:   double? _toolbarHeight;
  417:   bool _measureScheduled = false;
