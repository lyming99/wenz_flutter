  274: class _TableFloatingToolbarOverlayAnchorState
  275:     extends State<TableFloatingToolbarOverlayAnchor>
  276:     with WidgetsBindingObserver {
  277:   final LayerLink _anchorLink = LayerLink();
  278:   final Object _owner = Object();
  279:   ScrollPosition? _scrollPosition;
  280:   bool _syncScheduled = false;
  281: 
  282:   @override
  283:   void initState() {
  284:     super.initState();
  285:     WidgetsBinding.instance.addObserver(this);
  286:     _scheduleSync();
  287:   }
  288: 
  289:   @override
  290:   void didUpdateWidget(covariant TableFloatingToolbarOverlayAnchor oldWidget) {
  291:     super.didUpdateWidget(oldWidget);
  292:     if (oldWidget.controller != widget.controller ||
  293:         oldWidget.tableBlockId != widget.tableBlockId) {
  294:       oldWidget.controller?.unregisterAnchor(owner: _owner);
  295:     }
  296:     _scheduleSync();
  297:   }
  298: 
  299:   @override
  300:   void didChangeDependencies() {
  301:     super.didChangeDependencies();
  302:     _syncScrollPosition(Scrollable.maybeOf(context)?.position);
  303:     _scheduleSync();
  304:   }
  305: 
  306:   @override
  307:   void didChangeMetrics() {
  308:     _scheduleSync();
  309:   }
  310: 
  311:   @override
  312:   void dispose() {
  313:     WidgetsBinding.instance.removeObserver(this);
  314:     _scrollPosition?.removeListener(_scheduleSync);
  315:     widget.controller?.unregisterAnchor(owner: _owner);
  316:     super.dispose();
  317:   }
  318: 
  319:   @override
  320:   Widget build(BuildContext context) {
  321:     _scheduleSync();
  322:     return CompositedTransformTarget(
  323:       link: _anchorLink,
  324:       child: widget.child,
  325:     );
  326:   }
  327: 
  328:   void _scheduleSync() {
  329:     if (_syncScheduled) {
  330:       return;
  331:     }
  332:     _syncScheduled = true;
  333:     WidgetsBinding.instance.addPostFrameCallback((_) {
  334:       _syncScheduled = false;
  335:       _syncRequest();
  336:     });
  337:   }
  338: 
  339:   void _syncScrollPosition(ScrollPosition? position) {
  340:     if (identical(_scrollPosition, position)) {
  341:       return;
  342:     }
  343:     _scrollPosition?.removeListener(_scheduleSync);
  344:     _scrollPosition = position;
  345:     _scrollPosition?.addListener(_scheduleSync);
  346:   }
  347: 
  348:   void _syncRequest() {
  349:     if (!mounted) {
  350:       return;
  351:     }
  352:     final controller = widget.controller;
  353:     if (controller == null) {
  354:       return;
  355:     }
  356:     final renderObject = context.findRenderObject();
  357:     if (renderObject is! RenderBox ||
  358:         !renderObject.attached ||
  359:         !renderObject.hasSize) {
  360:       controller.unregisterAnchor(owner: _owner);
  361:       return;
  362:     }
  363:     final anchorTopLeft = renderObject.localToGlobal(Offset.zero);
  364:     final anchorRect = anchorTopLeft & renderObject.size;
  365:     final visibleTop = _visibleTopFor(context);
  366:     controller.updateAnchor(
  367:       TableFloatingToolbarAnchorSnapshot(
  368:         owner: _owner,
  369:         anchorLink: _anchorLink,
  370:         anchorRect: anchorRect,
  371:         visibleTop: visibleTop,
  372:         tableBlockId: widget.tableBlockId,
  373:         blockIndex: widget.blockIndex,
  374:       ),
  375:     );
  376:     final requestBuilder = widget.requestBuilder;
  377:     if (requestBuilder == null) {
  378:       controller.hide(owner: _owner);
  379:       return;
  380:     }
  381:     controller.show(
  382:       requestBuilder(
  383:         owner: _owner,
  384:         anchorLink: _anchorLink,
  385:         anchorRect: anchorRect,
  386:         visibleTop: visibleTop,
  387:       ),
  388:     );
  389:   }
  390: 
  391:   double _visibleTopFor(BuildContext context) {
  392:     final scrollable = Scrollable.maybeOf(context);
  393:     final viewportObject = scrollable?.context.findRenderObject();
  394:     if (viewportObject is RenderBox &&
  395:         viewportObject.attached &&
  396:         viewportObject.hasSize) {
  397:       return viewportObject.localToGlobal(Offset.zero).dy;
  398:     }
  399:     return MediaQuery.maybeOf(context)?.padding.top ?? 0;
  400:   }
  401: }
