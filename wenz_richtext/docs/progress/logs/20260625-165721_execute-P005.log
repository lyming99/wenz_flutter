  403: class _TableFloatingToolbarOverlayEntry extends StatefulWidget {
  404:   const _TableFloatingToolbarOverlayEntry({required this.request});
  405: 
  406:   final TableFloatingToolbarOverlayRequest request;
  407: 
  408:   @override
  409:   State<_TableFloatingToolbarOverlayEntry> createState() =>
  410:       _TableFloatingToolbarOverlayEntryState();
  411: }
  412: 
  413: class _TableFloatingToolbarOverlayEntryState
  414:     extends State<_TableFloatingToolbarOverlayEntry> {
  415:   final GlobalKey _toolbarKey = GlobalKey();
  416:   double? _toolbarHeight;
  417:   bool _measureScheduled = false;
  418: 
  419:   @override
  420:   Widget build(BuildContext context) {
  421:     _scheduleMeasure();
  422:     final request = widget.request;
  423:     final toolbarHeight = _toolbarHeight ?? request.fallbackHeight;
  424:     final preferredTop = -(toolbarHeight + request.gap);
  425:     final visibleTop = request.visibleTop - request.anchorRect.top;
  426:     final top = math.max(preferredTop, visibleTop);
  427:     final minWidth = math.max(request.minWidth, request.anchorRect.width);
  428: 
  429:     return Positioned.fill(
  430:       child: CompositedTransformFollower(
  431:         link: request.anchorLink,
  432:         showWhenUnlinked: false,
  433:         targetAnchor: Alignment.topLeft,
  434:         followerAnchor: Alignment.topLeft,
  435:         offset: Offset(0, top),
  436:         child: Align(
  437:           alignment: AlignmentDirectional.topStart,
  438:           widthFactor: 1,
  439:           heightFactor: 1,
  440:           child: ConstrainedBox(
  441:             key: _toolbarKey,
  442:             constraints: BoxConstraints(minWidth: minWidth),
  443:             child: Listener(
  444:               key: const ValueKey<String>(
  445:                 'table-floating-toolbar-hit-test-blocker',
  446:               ),
  447:               behavior: HitTestBehavior.opaque,
  448:               child: request.toolbarBuilder(context),
  449:             ),
  450:           ),
  451:         ),
  452:       ),
  453:     );
  454:   }
  455: 
  456:   void _scheduleMeasure() {
  457:     if (_measureScheduled) {
  458:       return;
  459:     }
  460:     _measureScheduled = true;
  461:     WidgetsBinding.instance.addPostFrameCallback((_) {
  462:       _measureScheduled = false;
  463:       _syncToolbarHeight();
  464:     });
  465:   }
  466: 
  467:   void _syncToolbarHeight() {
  468:     if (!mounted) {
  469:       return;
  470:     }
  471:     final renderObject = _toolbarKey.currentContext?.findRenderObject();
  472:     if (renderObject is! RenderBox || !renderObject.hasSize) {
  473:       return;
  474:     }
  475:     final nextHeight = renderObject.size.height;
  476:     if (_toolbarHeight != null && (_toolbarHeight! - nextHeight).abs() < 0.5) {
  477:       return;
  478:     }
  479:     setState(() {
  480:       _toolbarHeight = nextHeight;
  481:     });
  482:   }
  483: }
