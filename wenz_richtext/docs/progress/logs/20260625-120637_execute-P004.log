  346: /// Builds a [Widget] for a single [BlockNode]. Registered per [BlockType] in a
  347: /// [BlockRendererRegistry]. Custom renderers receive the same
  348: /// [BlockRenderContext] the built-in ones do, so they can participate in
  349: /// selection/caret/debug behaviour.
  350: typedef BlockRendererBuilder = Widget Function(
  351:   BuildContext context,
  352:   BlockRenderContext renderContext,
  353: );
  354: 
  355: /// Maps [BlockType]s and custom [BlockEmbedNode.embedType]s to
  356: /// [BlockRendererBuilder]s. The editor consults this registry to paint each
  357: /// block; built-in types ship with default builders, and plugins override or
  358: /// extend them via [register] / [registerEmbed].
  359: ///
  360: /// The registry is an indirection point: it lets a consumer replace how a given
  361: /// block type renders (e.g. a custom image block with a real decoder) or how a
  362: /// business embed type renders without forking the editor widget.
  363: ///
  364: /// To start from the built-in defaults, construct the registry and then call
  365: /// [WenzRichTextEditor.installDefaultRenderers]; or use the editor's
  366: /// [WenzRichTextEditor.blockRenderers] parameter — when omitted the editor
  367: /// builds a private registry with the defaults already installed.
  368: class BlockRendererRegistry {
  369:   BlockRendererRegistry({
  370:     Map<BlockType, BlockRendererBuilder> builders =
  371:         const <BlockType, BlockRendererBuilder>{},
  372:     Map<String, BlockRendererBuilder> embedBuilders =
  373:         const <String, BlockRendererBuilder>{},
  374:   }) {
  375:     _builders.addAll(builders);
  376:     _embedBuilders.addAll(embedBuilders);
  377:   }
  378: 
  379:   final Map<BlockType, BlockRendererBuilder> _builders =
  380:       <BlockType, BlockRendererBuilder>{};
  381:   final Map<String, BlockRendererBuilder> _embedBuilders =
  382:       <String, BlockRendererBuilder>{};
  383: 
  384:   /// Registered block types in insertion order.
  385:   Iterable<BlockType> get blockTypes => _builders.keys;
  386: 
  387:   /// Registered custom block embed types in insertion order.
  388:   Iterable<String> get embedTypes => _embedBuilders.keys;
  389: 
  390:   /// Registers [builder] for [type], replacing any existing builder for that
  391:   /// type. Returning the previous builder (if any) lets callers chain or wrap
  392:   /// the default renderer.
  393:   BlockRendererBuilder? register(BlockType type, BlockRendererBuilder builder) {
  394:     final previous = _builders[type];
  395:     _builders[type] = builder;
  396:     return previous;
  397:   }
  398: 
  399:   /// Removes the builder for [type], if any. The editor falls back to its
  400:   /// plain-text default for that type.
  401:   void unregister(BlockType type) {
  402:     _builders.remove(type);
  403:   }
  404: 
  405:   /// Returns the builder for [type], falling back to [fallback] when none is
  406:   /// registered. The editor passes a plain-text fallback so unknown block types
  407:   /// always render *something*.
  408:   BlockRendererBuilder resolve(
  409:     BlockType type, {
  410:     required BlockRendererBuilder fallback,
  411:   }) {
  412:     return _builders[type] ?? fallback;
  413:   }
  414: 
  415:   /// Whether a builder is registered for [type].
  416:   bool has(BlockType type) => _builders.containsKey(type);
  417: 
  418:   /// Registers [builder] for a custom [BlockEmbedNode.embedType]. Returning the
  419:   /// previous builder lets callers chain or wrap an existing business renderer.
  420:   BlockRendererBuilder? registerEmbed(
  421:     String embedType,
  422:     BlockRendererBuilder builder,
  423:   ) {
  424:     final previous = _embedBuilders[embedType];
  425:     _embedBuilders[embedType] = builder;
  426:     return previous;
  427:   }
  428: 
  429:   /// Removes the builder for [embedType], if any. The editor then falls back to
  430:   /// the generic [BlockType.embed] renderer.

