 3212:   /// Whether the current selection could affect this block's rendering: it is
 3213:   /// an endpoint, or it lies strictly between the selection's start and end
 3214:   /// (so it would be fully highlighted), or the selection is collapsed inside
 3215:   /// it (the caret).
 3216:   bool _selectionTouchesBlock(_KeepAliveBlock w) {
 3217:     final selection = w.selection;
 3218:     if (selection == null) {
 3219:       return false;
 3220:     }
 3221:     final index = w.blockIndex;
 3222:     final start = selection.start;
 3223:     final end = selection.end;
 3224:     if (start.blockIndex == index || end.blockIndex == index) {
 3225:       return true;
 3226:     }
 3227:     // Interior block of a multi-block range is fully highlighted.
 3228:     return index > start.blockIndex && index < end.blockIndex;
 3229:   }
 3230: 
 3231:   /// Whether an active IME composition affects this block (composition lives in
 3232:   /// the caret's block). Only that block needs to repaint the underline span.
 3233:   bool _compositionTouchesBlock(_KeepAliveBlock w) {
 3234:     final composition = w.compositionState;
 3235:     if (composition == null) {
 3236:       return false;
 3237:     }
 3238:     final selection = w.selection;
 3239:     return selection != null && selection.extent.blockIndex == w.blockIndex;
 3240:   }
 3241: }
