+                count: state.hiddenBlockCount,
+              ),
+            ),
+        ],
+      ),
+    );
+  }
+}
+
+class _HeadingCollapseCountBadge extends StatelessWidget {
+  const _HeadingCollapseCountBadge({required this.count});
+
+  final int count;
