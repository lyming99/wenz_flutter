 3984: double _blockMarginBefore(BlockNode block, double fallback) {
 3985:   if (block is TextBlockNode && block.type == BlockType.heading) {
 3986:     return _kRichTextBodyFontSize * _kHeadingMarginTopEm;
 3987:   }
 3988:   return fallback;
 3989: }
