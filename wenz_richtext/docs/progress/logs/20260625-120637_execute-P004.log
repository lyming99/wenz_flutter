  101: /// Editor-owned interaction contract for the top-level block drag handle.
  102: ///
  103: /// The handle is row chrome: it belongs to the editor's top-level block shell,
  104: /// not to [BlockRendererBuilder] output. Keeping the contract here lets custom
  105: /// renderers rely on the same menu/reorder surface without wrapping their own
  106: /// handle, and keeps nested surfaces (table cells, inline embeds, object-block
  107: /// controls) out of row-sorting hit testing.
  108: abstract final class BlockDragHandleSpec {
  109:   /// Reserved leading gutter for the handle, outside the renderer's content box.
  110:   static const double railWidth = 32.0;
  111: 
  112:   /// Gap between the renderer content edge and the handle hit target.
  113:   static const double gapToContent = 4.0;
  114: 
  115:   /// Minimum pointer/focus hit target for mouse, touch, and keyboard traversal.
  116:   static const Size hitSize = Size.square(28.0);
  117: 
  118:   /// Visual glyph size inside [hitSize].
  119:   static const Size visualSize = Size.square(18.0);
