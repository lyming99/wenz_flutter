 3963: double _spacingBetweenBlocks(
 3964:   BlockNode previous,
 3965:   BlockNode next,
 3966:   double fallback,
 3967: ) {
 3968:   if ((fallback - _kDefaultBlockSpacing).abs() > 0.01) {
 3969:     return fallback;
 3970:   }
 3971:   if (_isListItemBlock(previous) && _isListItemBlock(next)) {
 3972:     final previousIndent = _blockIndentLevel(previous);
 3973:     final nextIndent = _blockIndentLevel(next);
 3974:     return previousIndent > 0 || nextIndent > 0
 3975:         ? _kNestedListItemSpacing
 3976:         : _kListItemSpacing;
 3977:   }
 3978:   return math.max(
 3979:     _blockMarginAfter(previous, fallback),
 3980:     _blockMarginBefore(next, fallback),
 3981:   );
 3982: }
