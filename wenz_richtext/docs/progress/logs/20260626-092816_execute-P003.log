427:  double _visibleTopFor(BuildContext context, RenderBox? overlayBox) {
428:    final scrollable = Scrollable.maybeOf(context);
429:    final viewportObject = scrollable?.context.findRenderObject();
430:    if (viewportObject is RenderBox &&
431:        viewportObject.attached &&
432:        viewportObject.hasSize) {
433:      return viewportObject.localToGlobal(Offset.zero, ancestor: overlayBox).dy;
434:    }
435:    final paddingTop = MediaQuery.maybeOf(context)?.padding.top ?? 0;
436:    if (overlayBox == null) {
437:      return paddingTop;
438:    }
439:    return overlayBox.globalToLocal(Offset(0, paddingTop)).dy;
440:  }
