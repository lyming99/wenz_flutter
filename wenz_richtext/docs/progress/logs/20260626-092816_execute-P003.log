4215:        target.insertionIndex.clamp(0, widget.blockCount).toInt();
4216:    final toIndex = insertionIndex > widget.blockIndex
4217:        ? insertionIndex - 1
4218:        : insertionIndex;
4219:    if (toIndex < 0 ||
4220:        toIndex >= widget.blockCount ||
4221:        toIndex == widget.blockIndex) {
4222:      return;
4223:    }
4224:    widget.onAction?.call(
4225:      ObjectBlockActionIntent(
4226:        action: toIndex < widget.blockIndex
4227:            ? ObjectBlockAction.moveUp
4228:            : ObjectBlockAction.moveDown,
4229:        blockIndex: widget.blockIndex,
4230:        value: toIndex,
4231:      ),
4232:    );
4233:  }
