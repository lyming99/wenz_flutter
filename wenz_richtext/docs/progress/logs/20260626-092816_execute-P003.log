+          : _kPopupMenuMaxHeight,
+    );
+    return Positioned(
+      left: offset.dx,
+      top: offset.dy,
+      child: WenzSlashMenuOverlay(
+        controller: controller,
+        maxWidth: math.min(_kPopupMenuMaxWidth, availableWidth),
+        maxHeight: math.min(_kPopupMenuMaxHeight, availableHeight),
+      ),
+    );
