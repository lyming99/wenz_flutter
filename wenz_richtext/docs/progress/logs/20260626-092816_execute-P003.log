199:        editorRect.left + editorPadding + BlockDragHandleSpec.railWidth;
200:    final rowEnd = editorRect.right - editorPadding;
201:    final shortQuoteRect = tester.getRect(backgroundFinder.at(0));
202:    final emptyQuoteRect = tester.getRect(backgroundFinder.at(1));
203:    final indentedQuoteRect = tester.getRect(backgroundFinder.at(2));
204:
205:    expect(shortQuoteRect.left, closeTo(rowStart, 0.001));
206:    expect(shortQuoteRect.right, closeTo(rowEnd, 0.001));
207:    expect(emptyQuoteRect.left, closeTo(rowStart, 0.001));
208:    expect(emptyQuoteRect.right, closeTo(rowEnd, 0.001));
209:    expect(
210:        indentedQuoteRect.left, closeTo(rowStart + indentedQuoteStart, 0.001));
211:    expect(indentedQuoteRect.right, closeTo(rowEnd, 0.001));
212:  });
