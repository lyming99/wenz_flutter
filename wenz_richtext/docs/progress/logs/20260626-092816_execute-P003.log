5966:TableCellRange? _activeTableRange(
5967:  DocumentSelection? selection,
5968:  TableBlockNode tableBlock,
5969:  int blockIndex,
5970:) {
5971:  final range = selection?.tableCellRange;
5972:  if (range == null ||
5973:      range.tableBlockId != tableBlock.id ||
5974:      range.blockIndex != blockIndex) {
5975:    return null;
5976:  }
5977:  final rowCount = tableBlock.table.rowCount;
5978:  final columnCount = tableBlock.table.columnCount;
5979:  if (rowCount == 0 || columnCount == 0) {
5980:    return null;
5981:  }
5982:  return TableCellRange(
5983:    tableBlockId: tableBlock.id,
5984:    blockIndex: blockIndex,
5985:    startRow: range.startRow.clamp(0, rowCount - 1).toInt(),
5986:    endRow: range.endRow.clamp(0, rowCount - 1).toInt(),
5987:    startColumn: range.startColumn.clamp(0, columnCount - 1).toInt(),
5988:    endColumn: range.endColumn.clamp(0, columnCount - 1).toInt(),
5989:  );
5990:}
