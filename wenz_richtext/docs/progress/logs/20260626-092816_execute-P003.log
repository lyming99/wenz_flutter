4264:  RelativeRect? _menuPosition() {
4265:    final button = _hitTestKey.currentContext?.findRenderObject() as RenderBox?;
4266:    final overlay =
4267:        Overlay.of(context).context.findRenderObject() as RenderBox?;
4268:    if (button == null ||
4269:        overlay == null ||
4270:        !button.hasSize ||
4271:        !overlay.hasSize) {
4272:      return null;
4273:    }
4274:    final buttonTopLeft = button.localToGlobal(Offset.zero, ancestor: overlay);
4275:    return RelativeRect.fromRect(
4276:      buttonTopLeft & button.size,
4277:      Offset.zero & overlay.size,
4278:    );
4279:  }
