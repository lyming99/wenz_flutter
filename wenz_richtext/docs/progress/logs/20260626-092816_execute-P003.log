864:      // Menu button is closer to the right edge, so grow to the left, aligned to the right edge.
865:      x = size.width - position.right - childSize.width;
866:    } else if (position.left < position.right) {
867:      // Menu button is closer to the left edge, so grow to the right, aligned to the left edge.
868:      x = position.left;
869:    } else {
870:      // Menu button is equidistant from both edges, so grow in reading direction.
871:      x = switch (textDirection) {
872:        TextDirection.rtl => size.width - position.right - childSize.width,
873:        TextDirection.ltr => position.left,
874:      };
875:    }
876:    final wantedPosition = Offset(x, y);
877:    final Offset originCenter = position.toRect(Offset.zero & size).center;
878:    final Iterable<Rect> subScreens = DisplayFeatureSubScreen.subScreensInBounds(
879:      Offset.zero & size,
880:      avoidBounds,
881:    );
882:    final Rect subScreen = _closestScreen(subScreens, originCenter);
883:    return _fitInsideScreen(subScreen, childSize, wantedPosition);
884:  }
885:
886:  Rect _closestScreen(Iterable<Rect> screens, Offset point) {
887:    Rect closest = screens.first;
888:    for (final screen in screens) {
889:      if ((screen.center - point).distance < (closest.center - point).distance) {
890:        closest = screen;
891:      }
892:    }
893:    return closest;
894:  }
895:
896:  Offset _fitInsideScreen(Rect screen, Size childSize, Offset wantedPosition) {
897:    double x = wantedPosition.dx;
898:    double y = wantedPosition.dy;
899:    // Avoid going outside an area defined as the rectangle 8.0 pixels from the
900:    // edge of the screen in every direction.
901:    if (x < screen.left + _kMenuScreenPadding + padding.left) {
902:      x = screen.left + _kMenuScreenPadding + padding.left;
903:    } else if (x + childSize.width > screen.right - _kMenuScreenPadding - padding.right) {
904:      x = screen.right - childSize.width - _kMenuScreenPadding - padding.right;
905:    }
906:    if (y < screen.top + _kMenuScreenPadding + padding.top) {
907:      y = _kMenuScreenPadding + padding.top;
908:    } else if (y + childSize.height > screen.bottom - _kMenuScreenPadding - padding.bottom) {
909:      y = screen.bottom - childSize.height - _kMenuScreenPadding - padding.bottom;
910:    }

