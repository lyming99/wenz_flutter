+  Widget _buildSlashMenuOverlay(SlashMenuController controller) {
+    final offset = _slashMenuOffset();
+    final overlayBox = _editorOverlayKey.currentContext?.findRenderObject();
+    final overlaySize = overlayBox is RenderBox && overlayBox.hasSize
+        ? overlayBox.size
+        : Size.zero;
+    final availableWidth = math.max(
+      0.0,
+      overlaySize.width - offset.dx - _kPopupViewportInset,
+    );
+    final availableHeight = math.max(
+      0.0,
+      overlaySize.height - offset.dy - _kPopupViewportInset,
+    );
+    return Positioned(
+      left: offset.dx,
+      top: offset.dy,
+      child: WenzSlashMenuOverlay(
+        controller: controller,
+        maxWidth: math.min(_kPopupMenuMaxWidth, availableWidth),
+        maxHeight: math.min(_kPopupMenuMaxHeight, availableHeight),
+      ),
+    );
+  }
