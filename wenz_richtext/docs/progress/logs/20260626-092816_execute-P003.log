1254:  Offset _slashMenuOffset() {
1255:    final fallback = widget.padding.resolve(TextDirection.ltr).topLeft;
1256:    final selection = widget.controller.selection;
1257:    final overlayContext = _editorOverlayKey.currentContext;
1258:    final overlayBox = overlayContext?.findRenderObject();
1259:    if (selection == null ||
1260:        !selection.isCollapsed ||
1261:        overlayBox is! RenderBox ||
1262:        !overlayBox.hasSize) {
1263:      return fallback;
1264:    }
1265:    final caret = _registry.caretRectForPosition(selection.extent);
1266:    if (caret == null) {
1267:      return fallback;
1268:    }
1269:    final local = overlayBox.globalToLocal(caret.bottomLeft);
1270:    final maxLeft = overlayBox.size.width - 280;
1271:    return Offset(
1272:      local.dx.clamp(0, maxLeft > 0 ? maxLeft : 0).toDouble(),
1273:      (local.dy + 6).clamp(0, overlayBox.size.height).toDouble(),
