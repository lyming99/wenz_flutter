 432:   /// Returns the word range covering [offset] in the block/path with [blockId],
 433:   /// for double-click selection. Returns null when no surface is registered.
 434:   TextRange? wordRangeAt(String blockId, int offset, {PositionPath? path}) {
 435:     final entry = _entry(blockId, path);
 436:     return entry?.wordRangeAt(offset);
 437:   }
