 242:   /// Average height of the currently-mounted block surfaces and the smallest
 243:   /// block index among them. Used by the editor to estimate a scroll offset
 244:   /// when a programmatic caret jump targets a virtualised (un-mounted) block:
 245:   /// the stride × index gives a rough pixel offset close enough for ListView
 246:   /// to build the target block, after which a follow-up frame pixel-aligns.
 247:   ///
 248:   /// Returns `null` when no surfaces are currently laid out.
 249:   ({double meanHeight, int firstBlockIndex})? averageMountedBlockHeight() {
 250:     var totalHeight = 0.0;
 251:     var counted = 0;
 252:     var firstIndex = -1;
 253:     for (final entry in _entries) {
 254:       final box = entry.hitTestBox;
 255:       if (box == null || !box.hasSize) {
 256:         continue;
 257:       }
 258:       if (firstIndex < 0) {
 259:         firstIndex = entry.blockIndex;
 260:       }
 261:       totalHeight += box.size.height;
 262:       counted += 1;
 263:     }
 264:     if (counted == 0 || firstIndex < 0) {
 265:       return null;
 266:     }
 267:     return (meanHeight: totalHeight / counted, firstBlockIndex: firstIndex);
 268:   }
 269: 
 270:   /// Resolves a global screen offset to a [DocumentPosition].
 271:   ///
 272:   /// If the point lands inside a registered block's hit-test box (the whole
 273:   /// cell frame for table cells, otherwise the text surface itself), the
 274:   /// position is computed from that block's *text-local* coordinates — the
 275:   /// hit-test local offset is first translated through the entry's
 276:   /// [BlockEntry.hitLocalToTextLocal] so padding/centring offsets are stripped.
 277:   /// Otherwise the nearest block is chosen by 2-D rect proximity and the caret
 278:   /// is clamped to that block's start or end — so a drag into the gap between
 279:   /// blocks (or beyond the last block) still extends the selection predictably.
 280:   DocumentPosition? positionFromGlobalOffset(Offset global) {
 281:     BlockEntry? hitEntry;
 282:     Offset? hitTextLocal;
 283:     var nearestHitDelta = double.infinity;
 284:     for (final entry in _entries) {
 285:       final box = entry.hitTestBox;
 286:       if (box == null) {
 287:         continue;
 288:       }
 289:       final local = box.globalToLocal(global);
 290:       if (local.dx >= 0 &&
 291:           local.dx <= box.size.width &&
 292:           local.dy >= 0 &&
 293:           local.dy <= box.size.height) {
 294:         final rect = box.localToGlobal(Offset.zero) & box.size;
 295:         final delta = (global - rect.center).distanceSquared;
 296:         if (delta < nearestHitDelta) {
 297:           nearestHitDelta = delta;
 298:           hitEntry = entry;
 299:           hitTextLocal = entry.hitLocalToTextLocal(local);
 300:         }
 301:       }
 302:     }
 303:     if (hitEntry != null && hitTextLocal != null) {
 304:       return DocumentPosition(
 305:         blockId: hitEntry.blockId,
 306:         blockIndex: hitEntry.blockIndex,
 307:         path: hitEntry.path,
 308:         offset: hitEntry.positionFromLocal(hitTextLocal),
 309:       );
 310:     }
 311:     // Missed every block: clamp to the nearest block's start/end.
 312:     return _clampToNearest(global);
 313:   }
 314: 
 315:   DocumentPosition? _clampToNearest(Offset global) {
 316:     if (_entries.isEmpty) {
 317:       return null;
 318:     }
 319:     BlockEntry? nearest;
 320:     var nearestDelta = double.infinity;
 321:     var clampToEnd = false;
 322:     for (final entry in _entries) {
 323:       final box = entry.hitTestBox;
 324:       if (box == null) {
 325:         continue;
 326:       }
 327:       final rect = box.localToGlobal(Offset.zero) & box.size;
 328:       // 2-D distance from the point to the rect (0 when inside). Using both
 329:       // axes — not just vertical proximity — keeps a tap in a table cell's
 330:       // padding from being mis-attributed to a neighbouring cell/column, and a
 331:       // tap above/below a short cell from jumping to an adjacent row.
 332:       final dx = global.dx < rect.left
 333:           ? rect.left - global.dx
 334:           : (global.dx > rect.right ? global.dx - rect.right : 0.0);
 335:       final dy = global.dy < rect.top
 336:           ? rect.top - global.dy
 337:           : (global.dy > rect.bottom ? global.dy - rect.bottom : 0.0);
 338:       final delta = dx * dx + dy * dy;
 339:       if (delta < nearestDelta) {
 340:         nearestDelta = delta;
 341:         nearest = entry;
 342:         // Clamp to the end when the point sits to the right of / below the
 343:         // rect, to the start otherwise. This generalises the old vertical-only
 344:         // rule and behaves identically for paragraph cross-block drags while
 345:         // also handling 2-D table geometries.
 346:         clampToEnd = global.dx > rect.right || global.dy > rect.bottom;
 347:       }
 348:     }
 349:     if (nearest == null) {
 350:       return null;
 351:     }
 352:     // Resolve the caret using the tap's horizontal column when it falls inside
 353:     // the block's width. Project the point onto the block's nearest edge so it
 354:     // lands on the block's first line (above) / last line (below), then let the
 355:     // block's own layout map the (x, line) to a character offset. This keeps a
 356:     // gap-tap on the 4th column landing at ~offset 4 instead of always 0/end.
 357:     // Only when the tap is horizontally outside the block do we fall back to the
 358:     // hard 0 / textLength edges.
 359:     final box = nearest.hitTestBox;
 360:     if (box != null) {
 361:       final origin = box.localToGlobal(Offset.zero);
 362:       if (global.dx >= origin.dx && global.dx <= origin.dx + box.size.width) {
 363:         final rect = origin & box.size;
 364:         final edgeY = clampToEnd ? rect.bottom - 1 : rect.top + 1;
 365:         final clamped = Offset(global.dx, edgeY.clamp(rect.top, rect.bottom));
 366:         final local = box.globalToLocal(clamped);
 367:         final textLocal = nearest.hitLocalToTextLocal(local);
 368:         return DocumentPosition(
 369:           blockId: nearest.blockId,
 370:           blockIndex: nearest.blockIndex,
 371:           path: nearest.path,
 372:           offset: nearest.positionFromLocal(textLocal),
 373:         );
 374:       }
 375:     }
 376:     final offset = clampToEnd ? nearest.textLength : 0;
 377:     return DocumentPosition(
 378:       blockId: nearest.blockId,
 379:       blockIndex: nearest.blockIndex,
 380:       path: nearest.path,
 381:       offset: offset,
 382:     );
 383:   }
 384: 
 385:   /// Returns the global [Rect] of the block whose hit-test box contains
 386:   /// [global], or the nearest block's rect if none contains it. Used by the
 387:   /// gesture overlay to drive auto-scroll near viewport edges.
 388:   Rect? blockRectFromGlobalOffset(Offset global) {
 389:     for (final entry in _entries) {
 390:       final box = entry.hitTestBox;
 391:       if (box == null) {
 392:         continue;
 393:       }
 394:       final local = box.globalToLocal(global);
 395:       if (local.dx >= 0 &&
 396:           local.dx <= box.size.width &&
 397:           local.dy >= 0 &&
 398:           local.dy <= box.size.height) {
 399:         final origin = box.localToGlobal(Offset.zero);
 400:         return origin & box.size;
 401:       }
 402:     }
 403:     // Fall back to the 2-D-nearest block's rect.
 404:     BlockEntry? nearest;
 405:     var nearestDelta = double.infinity;
 406:     for (final entry in _entries) {
 407:       final box = entry.hitTestBox;
 408:       if (box == null) {
 409:         continue;
 410:       }
 411:       final rect = box.localToGlobal(Offset.zero) & box.size;
 412:       final dx = global.dx < rect.left
 413:           ? rect.left - global.dx
 414:           : (global.dx > rect.right ? global.dx - rect.right : 0.0);
 415:       final dy = global.dy < rect.top
 416:           ? rect.top - global.dy
 417:           : (global.dy > rect.bottom ? global.dy - rect.bottom : 0.0);
 418:       final delta = dx * dx + dy * dy;
 419:       if (delta < nearestDelta) {
 420:         nearestDelta = delta;
 421:         nearest = entry;
 422:       }
 423:     }
 424:     if (nearest == null) {
 425:       return null;
 426:     }
 427:     final box = nearest.hitTestBox!;
 428:     final origin = box.localToGlobal(Offset.zero);
 429:     return origin & box.size;
 430:   }
