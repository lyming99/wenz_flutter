 937:   Offset _slashMenuOffset() {
 938:     final fallback = widget.padding.resolve(TextDirection.ltr).topLeft;
 939:     final selection = widget.controller.selection;
 940:     final overlayContext = _editorOverlayKey.currentContext;
 941:     final overlayBox = overlayContext?.findRenderObject();
 942:     if (selection == null ||
 943:         !selection.isCollapsed ||
 944:         overlayBox is! RenderBox ||
 945:         !overlayBox.hasSize) {
 946:       return fallback;
 947:     }
 948:     final caret = _registry.caretRectForPosition(selection.extent);
 949:     if (caret == null) {
 950:       return fallback;
 951:     }
 952:     final local = overlayBox.globalToLocal(caret.bottomLeft);
 953:     final maxLeft = overlayBox.size.width - 280;
 954:     return Offset(
 955:       local.dx.clamp(0, maxLeft > 0 ? maxLeft : 0).toDouble(),
 956:       (local.dy + 6).clamp(0, overlayBox.size.height).toDouble(),
 957:     );
 958:   }
