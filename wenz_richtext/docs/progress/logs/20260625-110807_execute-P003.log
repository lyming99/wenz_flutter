 544: class _OutlineItemDraft {
 545:   const _OutlineItemDraft({
 546:     required this.blockId,
 547:     required this.blockIndex,
 548:     required this.level,
 549:     required this.title,
 550:     required this.anchor,
 551:     required this.collapseRange,
 552:   });
 553: 
 554:   final String blockId;
 555:   final int blockIndex;
 556:   final int level;
 557:   final String title;
 558:   final String? anchor;
 559:   final OutlineCollapseRange collapseRange;
 560: 
 561:   OutlineItem toItem({required bool isCollapsed}) {
 562:     return OutlineItem(
 563:       blockId: blockId,
 564:       blockIndex: blockIndex,
 565:       level: level,
 566:       title: title,
 567:       anchor: anchor,
 568:       collapseRange: collapseRange,
 569:       isCollapsed: isCollapsed,
 570:     );
 571:   }
 572: }
 573: 
 574: OutlineCollapseRange _collapseRangeForHeading({
 575:   required List<BlockNode> blocks,
 576:   required int headingIndex,
 577:   required int headingLevel,
 578: }) {
 579:   final start = headingIndex + 1;
 580:   var end = start;
 581:   while (end < blocks.length) {
 582:     final block = blocks[end];
 583:     if (block is TextBlockNode && block.type == BlockType.heading) {
 584:       final level = (block.attributes.level ?? 1).clamp(1, 6).toInt();
 585:       if (level <= headingLevel) {
 586:         break;
 587:       }
 588:     }
 589:     end++;
 590:   }
 591:   return OutlineCollapseRange(
 592:     startBlockIndex: start,
 593:     endBlockIndexExclusive: end,
 594:     blockIds: List<String>.unmodifiable(
 595:       blocks.sublist(start, end).map((block) => block.id),
 596:     ),
 597:   );
 598: }
 599: 
 600: String _normalizeTitle(String title) {
 601:   return title.replaceAll(RegExp(r'\s+'), ' ').trim();
 602: }
 603: 
 604: String? _normalizeAnchor(String? anchor) {
 605:   final trimmed = anchor?.trim();
 606:   if (trimmed == null || trimmed.isEmpty) {
 607:     return null;
 608:   }
 609:   return trimmed;
 610: }
