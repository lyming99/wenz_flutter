 449:   /// Returns the caret's global [Rect] for [position], or `null` when the
 450:   /// owning block surface is not registered / not laid out. Used by the IME
 451:   /// bridge to anchor the platform candidate window at the caret.
 452:   Rect? caretRectForPosition(DocumentPosition position) {
 453:     final entry = _entry(position.blockId, position.path);
 454:     if (entry == null) {
 455:       return null;
 456:     }
 457:     return entry.caretRectAt(position.offset);
 458:   }
 459: 
 460:   /// Returns TextInput geometry for the editable surface that owns [position].
 461:   ///
 462:   /// The platform API mirrors [EditableText]: it expects the full editable
 463:   /// render box size + transform, with caret/composing rects expressed in that
 464:   /// render box's local coordinate space.
 465:   BlockTextInputGeometry? textInputGeometryForPosition(
 466:     DocumentPosition position, {
 467:     TextRange? composingRange,
 468:   }) {
 469:     final entry = _entry(position.blockId, position.path);
 470:     final box = entry?.renderBox;
 471:     if (entry == null || box == null || !box.hasSize) {
 472:       return null;
 473:     }
 474:     final caretRect = entry.localCaretRectAt(position.offset);
 475:     if (caretRect == null) {
 476:       return null;
 477:     }
 478:     Rect? composingRect;
 479:     final range = composingRange;
 480:     if (range != null &&
 481:         range.start >= 0 &&
 482:         range.end >= range.start &&
 483:         !range.isCollapsed) {
 484:       composingRect = entry.localComposingRectForRange(
 485:         range.start,
 486:         range.end,
 487:       );
 488:     }
 489:     return BlockTextInputGeometry(
 490:       editableSize: box.size,
 491:       transform: box.getTransformTo(null),
 492:       caretRect: caretRect,
 493:       composingRect: composingRect ?? caretRect,
 494:       globalCaretRect: box.localToGlobal(caretRect.topLeft) & caretRect.size,
 495:     );
 496:   }
 497: 
 498:   /// Resolves one visual-line vertical move from [position]. Returns the
 499:   /// target offset (in the same block) when a neighbouring line exists, or a
 500:   /// result with `targetOffset == null` when the caret is on the block's
 501:   /// first/last line (caller should cross blocks). [preferX] is the remembered
 502:   /// horizontal column (LOCAL coordinate space) for repeated moves; the caret's
 503:   /// current local x is returned via [VerticalMoveResult.caretX] so the caller
 504:   /// can seed it.
 505:   VerticalMoveResult? verticalMoveForPosition(
 506:     DocumentPosition position,
 507:     bool forward, {
 508:     double? preferX,
 509:   }) {
 510:     final entry = _entry(position.blockId, position.path);
 511:     if (entry == null) {
 512:       return null;
 513:     }
 514:     return entry.verticalMoveAt(position.offset, forward, preferX);
 515:   }
 516: 
 517:   BlockEntry? _entry(String blockId, PositionPath? path) {
 518:     if (path == null) {
 519:       // No path disambiguator: fall back to a linear scan (rare; used only by
 520:       // callers that don't distinguish same-block surfaces).
 521:       for (final entry in _entries) {
 522:         if (entry.blockId == blockId) {
 523:           return entry;
 524:         }
 525:       }
 526:       return null;
 527:     }
 528:     return _byKey[_key(blockId, path)];
 529:   }
 530: }
 531: 
 532: /// A registered editable block's geometry and layout access.
 533: ///
 534: /// Each entry tracks **two** render boxes:
 535: /// - [renderBox] (via [key]) is the *text surface* — the box the laid-out
 536: ///   [TextPainter] is painted into. It anchors caret/selection painting and
 537: ///   [caretRectAt] global positioning, so it must be the box whose local
 538: ///   coordinate space matches the painter's.
 539: /// - [hitTestBox] (via [hitTestKey]) is the *hit-test frame* — the box used for
 540: ///   [BlockGeometryRegistry.positionFromGlobalOffset] containment and
 541: ///   nearest-block clamping. For plain surfaces these are the same box; for
 542: ///   table cells the hit-test frame is the whole cell (padding + centred text)
 543: ///   while the text surface is only the centred text region. [hitLocalToTextLocal]
 544: ///   translates a hit-test-local offset back into the text surface's local
 545: ///   space so [positionFromLocal] receives the coordinate the painter expects.
 546: class BlockEntry {
 547:   BlockEntry({
 548:     required this.blockId,
 549:     required this.blockIndex,
 550:     required this.path,
 551:     required this.textLength,
 552:     required this.key,
 553:     required this.positionFromLocal,
 554:     required this.wordRangeAt,
 555:     required this.caretRectAt,
 556:     required this.localCaretRectAt,
 557:     required this.localComposingRectForRange,
 558:     required this.verticalMoveAt,
 559:     this.hitTestKey,
 560:     Offset Function(Offset)? hitLocalToTextLocal,
 561:   }) : _hitLocalToTextLocal = hitLocalToTextLocal;
 562: 
 563:   final String blockId;
 564:   final int blockIndex;
 565:   final PositionPath path;
 566:   final int textLength;
 567: 
 568:   /// GlobalKey on the text surface render box (painter's local space).
 569:   final GlobalKey key;
 570: 
 571:   /// GlobalKey on the hit-test frame render box. When `null`, [key] is used.
 572:   /// Set for table cells where the hit-test frame (whole cell) differs from
 573:   /// the text surface (centred text).
 574:   final GlobalKey? hitTestKey;
 575: 
 576:   bool matches(String otherBlockId, PositionPath otherPath) {
 577:     return blockId == otherBlockId && path == otherPath;
 578:   }
 579: 
 580:   /// Converts a local offset in the text surface's coordinate space to a
 581:   /// character offset within the block's text.
 582:   final int Function(Offset local) positionFromLocal;
 583: 
 584:   /// Returns the word range covering [offset] using this block's text layout.
 585:   final TextRange Function(int offset) wordRangeAt;
 586: 
 587:   /// Returns the caret's global [Rect] (top-left + height) for the given
 588:   /// character [offset] in this block, or `null` when unavailable. Used by the
 589:   /// IME bridge to position the platform candidate window at the caret.
 590:   final Rect? Function(int offset) caretRectAt;
 591: 
 592:   /// Returns the caret rect in the text surface's local coordinate space.
 593:   final Rect? Function(int offset) localCaretRectAt;
 594: 
 595:   /// Returns the composing text rect in the text surface's local coordinate
 596:   /// space for [start, end), or `null` when the layout cannot resolve it.
 597:   final Rect? Function(int start, int end) localComposingRectForRange;
 598: 
 599:   /// Moves [offset] one visual line down ([forward]=true) or up within this
 600:   /// block, keeping the horizontal column at [preferX] (in the block's LOCAL
 601:   /// coordinate space) when provided (for repeated vertical moves). Returns
 602:   /// the target offset (or `null` at a block boundary) plus the caret's local
 603:   /// x so the caller can remember the column.
 604:   final VerticalMoveResult Function(int offset, bool forward, double? preferX)
 605:       verticalMoveAt;
 606: 
 607:   /// Translates an offset in the hit-test frame's local space into the text
 608:   /// surface's local space. Defaults to identity when [hitTestKey] == [key]
 609:   /// (plain paragraph/code surfaces). For table cells it strips the cell
 610:   /// padding and re-centres the point onto the laid-out text region.
 611:   final Offset Function(Offset)? _hitLocalToTextLocal;
 612: 
 613:   /// The text surface render box (painter's local space). Null until laid out.
 614:   RenderBox? get renderBox {
 615:     final context = key.currentContext;
 616:     final object = context?.findRenderObject();
 617:     return object is RenderBox ? object : null;
 618:   }
 619: 
 620:   /// The hit-test frame render box. Falls back to [renderBox] when no separate
 621:   /// [hitTestKey] is registered (the common case).
 622:   RenderBox? get hitTestBox {
 623:     final hitKey = hitTestKey;
 624:     if (hitKey == null) {
 625:       return renderBox;
 626:     }
 627:     final context = hitKey.currentContext;
 628:     final object = context?.findRenderObject();
 629:     return object is RenderBox ? object : null;
 630:   }
 631: 
 632:   /// Translates a hit-test-local offset to a text-local offset, applying the
 633:   /// registered transform or identity when none was provided.
 634:   Offset hitLocalToTextLocal(Offset local) =>
 635:       (_hitLocalToTextLocal ?? _identity)(local);
 636: 
 637:   static Offset _identity(Offset local) => local;
 638: }
