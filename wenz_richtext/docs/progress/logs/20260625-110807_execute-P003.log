 421:   bool selectByBlockId(
 422:     String blockId, {
 423:     bool requestFocus = true,
 424:   }) {
 425:     final index = _host.document.blocks.indexWhere(
 426:       (block) => block.id == blockId,
 427:     );
 428:     if (index < 0) {
 429:       return false;
 430:     }
 431:     final block = _host.document.blocks[index];
 432:     if (block is! TextBlockNode || block.type != BlockType.heading) {
 433:       return false;
 434:     }
 435:     final position = DocumentPosition.text(
 436:       blockId: block.id,
 437:       blockIndex: index,
 438:       offset: 0,
 439:     );
 440:     _host.setSelection(DocumentSelection(base: position, extent: position));
 441:     if (requestFocus) {
 442:       _host.requestFocus();
 443:     }
 444:     return true;
 445:   }
 446: 
 447:   bool selectByAnchor(
 448:     String anchor, {
 449:     bool requestFocus = true,
 450:   }) {
 451:     final item = itemForAnchor(anchor);
 452:     if (item == null) {
 453:       return false;
 454:     }
 455:     return select(item, requestFocus: requestFocus);
 456:   }
 457: 
 458:   @override
 459:   void dispose() {
 460:     _host.removeListener(_handleHostChanged);
 461:     super.dispose();
 462:   }
 463: 
 464:   void _handleHostChanged() {
 465:     _recompute();
 466:   }
 467: 
 468:   void _recompute() {
 469:     final drafts = <_OutlineItemDraft>[];
 470:     final collapsibleIds = <String>{};
 471:     final blocks = _host.document.blocks;
 472:     for (var i = 0; i < blocks.length; i++) {
 473:       final block = blocks[i];
 474:       if (block is! TextBlockNode || block.type != BlockType.heading) {
 475:         continue;
 476:       }
 477:       final title = _normalizeTitle(block.plainText);
 478:       if (title.isEmpty) {
 479:         continue;
 480:       }
 481:       final rawLevel = block.attributes.level ?? 1;
 482:       final level = rawLevel.clamp(1, 6).toInt();
 483:       final collapseRange = _collapseRangeForHeading(
 484:         blocks: blocks,
 485:         headingIndex: i,
 486:         headingLevel: level,
 487:       );
 488:       if (collapseRange.isNotEmpty) {
 489:         collapsibleIds.add(block.id);
 490:       }
 491:       drafts.add(
 492:         _OutlineItemDraft(
 493:           blockId: block.id,
 494:           blockIndex: i,
 495:           level: level,
 496:           title: title,
 497:           anchor: _normalizeAnchor(block.attributes.anchor),
 498:           collapseRange: collapseRange,
 499:         ),
 500:       );
 501:     }
 502: 
 503:     final nextCollapsedBlockIds = Set<String>.unmodifiable(
 504:       _collapsedBlockIds.where(collapsibleIds.contains),
 505:     );
 506:     final next = List<OutlineItem>.unmodifiable(
 507:       drafts.map(
 508:         (draft) => draft.toItem(
 509:           isCollapsed: nextCollapsedBlockIds.contains(draft.blockId),
 510:         ),
 511:       ),
 512:     );
 513: 
 514:     final itemsChanged = !listEquals(_items, next);
 515:     final collapseStateChanged =
 516:         !setEquals(_collapsedBlockIds, nextCollapsedBlockIds);
 517:     if (!itemsChanged && !collapseStateChanged) {
 518:       return;
 519:     }
 520:     _items = next;
 521:     _collapsedBlockIds = nextCollapsedBlockIds;
 522:     notifyListeners();
 523:   }
 524: 
 525:   bool _setCollapsed({
 526:     required String blockId,
 527:     required bool collapsed,
 528:   }) {
 529:     final item = itemForBlockId(blockId);
 530:     if (item == null || !item.canCollapse) {
 531:       return false;
 532:     }
 533:     final next = Set<String>.of(_collapsedBlockIds);
 534:     final changed = collapsed ? next.add(blockId) : next.remove(blockId);
 535:     if (!changed) {
 536:       return false;
 537:     }
 538:     _collapsedBlockIds = Set<String>.unmodifiable(next);
 539:     _recompute();
 540:     return true;
 541:   }
 542: }
