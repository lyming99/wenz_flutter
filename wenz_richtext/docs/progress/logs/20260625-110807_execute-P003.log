 222:   /// The bottom edge of the document content in global coordinates, taken from
 223:   /// the lowest mounted block surface. Used by the editor to tell whether a
 224:   /// page-jump target overshoots the document (a short doc paged past its end)
 225:   /// so the caret can jump to the document boundary instead of relying on the
 226:   /// ambiguous nearest-block clamp. Returns `null` when no surface is laid out.
 227:   double? contentExtent() {
 228:     double? bottom;
 229:     for (final entry in _entries) {
 230:       final box = entry.hitTestBox;
 231:       if (box == null || !box.hasSize) {
 232:         continue;
 233:       }
 234:       final rect = box.localToGlobal(Offset.zero) & box.size;
 235:       if (bottom == null || rect.bottom > bottom) {
 236:         bottom = rect.bottom;
 237:       }
 238:     }
 239:     return bottom;
 240:   }
