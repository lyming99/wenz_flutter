 439:   /// Returns the full editable range of the block/path with [blockId], for
 440:   /// triple-click (select-paragraph) selection.
 441:   TextRange? paragraphRange(String blockId, {PositionPath? path}) {
 442:     final entry = _entry(blockId, path);
 443:     if (entry == null) {
 444:       return null;
 445:     }
 446:     return TextRange(start: 0, end: entry.textLength);
 447:   }
