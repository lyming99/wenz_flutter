 239:   int? nearestVisibleIndexForBlockIndex(int blockIndex) {
 240:     if (visibleBlockIndexes.isEmpty) {
 241:       return null;
 242:     }
 243:     var nearest = 0;
 244:     for (var index = 0; index < visibleBlockIndexes.length; index++) {
 245:       final documentIndex = visibleBlockIndexes[index];
 246:       if (documentIndex == blockIndex) {
 247:         return index;
 248:       }
 249:       if (documentIndex > blockIndex) {
 250:         return index == 0 ? 0 : nearest;
 251:       }
 252:       nearest = index;
 253:     }
 254:     return nearest;
 255:   }
