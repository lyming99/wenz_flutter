 328:       // 2-D distance from the point to the rect (0 when inside). Using both
 329:       // axes — not just vertical proximity — keeps a tap in a table cell's
 330:       // padding from being mis-attributed to a neighbouring cell/column, and a
 331:       // tap above/below a short cell from jumping to an adjacent row.
 332:       final dx = global.dx < rect.left
 333:           ? rect.left - global.dx
 334:           : (global.dx > rect.right ? global.dx - rect.right : 0.0);
 335:       final dy = global.dy < rect.top
 336:           ? rect.top - global.dy
 337:           : (global.dy > rect.bottom ? global.dy - rect.bottom : 0.0);
 338:       final delta = dx * dx + dy * dy;
 339:       if (delta < nearestDelta) {
 340:         nearestDelta = delta;
 341:         nearest = entry;
