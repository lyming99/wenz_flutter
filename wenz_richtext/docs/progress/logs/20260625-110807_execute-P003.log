 706:         if (!mounted) {
 707:           return;
 708:         }
 709:         if (_inputClient.isAttached) {
 710:           _inputClient.syncBuffer();
 711:         }
 712:         // Bring an off-screen caret into view — but only when it actually
 713:         // moved. IME composition updates fire notifyListeners without changing
 714:         // the caret's position; skipping the scroll check there avoids a
 715:         // layout + localToGlobal round-trip per composition keystroke.
 716:         final selection = widget.controller.selection;
 717:         if (selection?.isCollapsed == true) {
