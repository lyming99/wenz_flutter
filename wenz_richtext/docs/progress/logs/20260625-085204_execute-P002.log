-  int insertedLength,
-) {
-  if (removedLength == 0) {
-    return offset < changeStart ? offset : offset + insertedLength;
-  }
-  if (offset <= changeStart) {
-    return offset;
-  }
-  final changeEnd = changeStart + removedLength;
-  if (offset <= changeEnd) {
-    return changeStart + insertedLength;
-  }
-  return offset + insertedLength - removedLength;
-}
