 404: List<int> _codeLineStartsForRange(String code, int start, int end) {
 405:   if (code.isEmpty) {
 406:     return const <int>[0];
 407:   }
 408:   final effectiveEnd =
 409:       start == end || end == 0 || code.codeUnitAt(end - 1) != 0x0A
 410:           ? end
 411:           : end - 1;
 412:   final firstLineStart = _codeLineStart(code, start);
 413:   final lastLineStart = _codeLineStart(code, effectiveEnd);
 414:   final starts = <int>[];
 415:   var current = firstLineStart;
 416:   while (current <= lastLineStart && current <= code.length) {
 417:     starts.add(current);
 418:     final nextBreak = code.indexOf('\n', current);
 419:     if (nextBreak < 0) {
 420:       break;
 421:     }
 422:     current = nextBreak + 1;
 423:   }
 424:   return starts;
 425: }
 426: 
 427: int _codeLineStart(String code, int offset) {
 428:   if (code.isEmpty) {
 429:     return 0;
 430:   }
 431:   final clamped = offset.clamp(0, code.length).toInt();
 432:   if (clamped == 0) {
 433:     return 0;
 434:   }
 435:   final newline = code.lastIndexOf('\n', clamped - 1);
 436:   return newline < 0 ? 0 : newline + 1;
 437: }
 438: 
 439: int _codeOutdentLength(String code, int lineStart, String indent) {
 440:   if (lineStart >= code.length) {
 441:     return 0;
 442:   }
 443:   if (code.startsWith(indent, lineStart)) {
 444:     return indent.length;
 445:   }
 446:   if (code.codeUnitAt(lineStart) == 0x09) {
 447:     return 1;
 448:   }
 449:   var spaces = 0;
 450:   while (spaces < indent.length &&
 451:       lineStart + spaces < code.length &&
 452:       code.codeUnitAt(lineStart + spaces) == 0x20) {
 453:     spaces += 1;
 454:   }
 455:   return spaces;
 456: }
 457: 
 458: int _transformCodeOffset(
 459:   int offset,
 460:   int changeStart,
 461:   int removedLength,
 462:   int insertedLength,
 463: ) {
 464:   if (removedLength == 0) {
 465:     return offset < changeStart ? offset : offset + insertedLength;
 466:   }
 467:   if (offset <= changeStart) {
 468:     return offset;
 469:   }
 470:   final changeEnd = changeStart + removedLength;
 471:   if (offset <= changeEnd) {
 472:     return changeStart + insertedLength;
 473:   }
 474:   return offset + insertedLength - removedLength;
 475: }
