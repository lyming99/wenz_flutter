 721:             if (!skipCaretScroll) {
 722:               _scrollCaretIntoView();
 723:             }
 724:           }
 725:         } else {
 726:           _skipNextCaretScrollIntoView = false;
 727:           _lastScrollCheckedCaret = null;
 728:         }
 729:       });
 730:       setState(() {});
 731:     }
