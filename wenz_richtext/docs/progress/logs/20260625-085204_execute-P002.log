 691:       } else if (dirty.isNotEmpty) {
 692:         for (final id in dirty) {
 693:           _layoutCache.removeBlock(id);
 694:         }
 695:       }
 696:       // Keep the platform IME candidate window anchored at the caret, and
 697:       // scroll a programmatically-moved caret back into view. Both run in a
