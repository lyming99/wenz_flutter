  13: 
  14:   final int delta;
  15:   final DocumentSelection? selection;
  16: 
  17:   @override
  18:   String get description => delta > 0 ? 'indent' : 'outdent';
  19: 
  20:   @override
  21:   CommandResult execute(DocumentSession session) {
  22:     final target = selection ?? session.selection;
  23:     if (target == null || delta == 0) {
  24:       return const CommandResult(recordHistory: false);
  25:     }
  26:     final blocks = session.document.blocks.map((b) => b.copy()).toList();
  27:     var changed = false;
  28:     for (var i = target.start.blockIndex; i <= target.end.blockIndex; i++) {
  29:       if (i < 0 || i >= blocks.length) {
  30:         continue;
  31:       }
  32:       final block = blocks[i];
  33:       if (block is! TextBlockNode) {
  34:         continue;
  35:       }
  36:       final current = block.attributes.indent ?? 0;
  37:       final next = (current + delta).clamp(0, 8).toInt();
