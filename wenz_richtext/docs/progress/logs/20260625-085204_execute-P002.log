 699:       // selection (and any keep-alive mount) before we read its global rect.
 700:       WidgetsBinding.instance.addPostFrameCallback((_) {
 701:         if (!mounted) {
 702:           return;
 703:         }
 704:         if (_inputClient.isAttached) {
 705:           _inputClient.syncBuffer();
 706:         }
 707:         // Bring an off-screen caret into view — but only when it actually
 708:         // moved. IME composition updates fire notifyListeners without changing
 709:         // the caret's position; skipping the scroll check there avoids a
 710:         // layout + localToGlobal round-trip per composition keystroke.
 711:         final selection = widget.controller.selection;
 712:         if (selection?.isCollapsed == true) {
 713:           final skipCaretScroll = _skipNextCaretScrollIntoView;
