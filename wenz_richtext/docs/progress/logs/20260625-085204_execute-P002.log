+      }
+      nextCode = nextCode.replaceRange(
+        lineStart,
+        lineStart + removedLength,
+        inserted,
+      );
+      baseOffset = _transformCodeOffset(
+        baseOffset,
+        lineStart,
+        removedLength,
+        inserted.length,
+      );
+      extentOffset = _transformCodeOffset(
