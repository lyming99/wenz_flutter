1768:   /// Diffs [before] against [after] and returns the set of block ids whose
1769:   /// rendering must refresh: every block id present in [after] whose
1770:   /// lightweight fingerprint changed or that is newly added. Removed block ids
1771:   /// are not included (there is nothing left to rebuild for them). Returns an
1772:   /// empty set when the two documents are content-identical.
1773:   ///
1774:   /// The fingerprint is intentionally cheap (`type` + `plainText` + attributes
1775:   /// JSON) — it catches text, structure, and attribute edits without a full
1776:   /// deep compare or [BlockNode.toJson] on every block. It may produce a false
1777:   /// positive (rebuild a block that did not visually change) but never a false
1778:   /// negative, so correctness is preserved.
1779:   Set<String> _changedBlockIds(
1780:       RichTextDocument before, RichTextDocument after) {
1781:     final beforeFingerprints = <String, String>{
1782:       for (final block in before.blocks) block.id: _blockFingerprint(block),
1783:     };
1784:     final changed = <String>{};
1785:     for (final block in after.blocks) {
1786:       final previous = beforeFingerprints[block.id];
1787:       if (previous == null || previous != _blockFingerprint(block)) {
1788:         changed.add(block.id);
1789:       }
1790:     }
1791:     return changed;
1792:   }
1793: 
1794:   String _blockFingerprint(BlockNode block) {
1795:     // The full JSON shape (including inline content + run attributes, table
1796:     // cells, code language, media metadata) is the fingerprint. A coarser
1797:     // fingerprint based only on type + plainText would miss inline attribute
1798:     // changes (e.g. formatText toggling bold) and fail to mark the block dirty
1799:     // for incremental rebuild, leaving stale spans rendered.
1800:     return jsonEncode(block.toJson());
1801:   }
1802: }
