-int _codeLineStart(String code, int offset) {
-  if (code.isEmpty) {
-    return 0;
-  }
-  final clamped = offset.clamp(0, code.length).toInt();
-  if (clamped == 0) {
-    return 0;
-  }
-  final newline = code.lastIndexOf('\n', clamped - 1);
-  return newline < 0 ? 0 : newline + 1;
-}
