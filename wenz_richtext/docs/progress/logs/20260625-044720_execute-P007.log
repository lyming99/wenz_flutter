4050: }
4051: 
4052: class _ViewportAwareTableToolbarState
4053:     extends State<_ViewportAwareTableToolbar> {
4054:   double? _top;
4055: 
4056:   double get _effectiveTop => _top ?? widget.preferredTop;
4057: 
4058:   @override
4059:   Widget build(BuildContext context) {
4060:     WidgetsBinding.instance.addPostFrameCallback((_) => _syncTopWithViewport());
4061:     return PositionedDirectional(
4062:       top: _effectiveTop,
4063:       start: 0,
4064:       child: widget.child,
4065:     );
4066:   }
4067: 
4068:   void _syncTopWithViewport() {
4069:     if (!mounted) {
4070:       return;
4071:     }
4072:     final renderObject = context.findRenderObject();
4073:     final scrollable = Scrollable.maybeOf(context);
4074:     final viewportObject = scrollable?.context.findRenderObject();
4075:     if (renderObject is! RenderBox ||
4076:         !renderObject.hasSize ||
4077:         viewportObject is! RenderBox ||
4078:         !viewportObject.hasSize) {
4079:       _setTopIfNeeded(widget.preferredTop);
4080:       return;
4081:     }
4082:     final toolbarTop = renderObject.localToGlobal(Offset.zero).dy;
4083:     final stackTop = toolbarTop - _effectiveTop;
4084:     final viewportTop = viewportObject.localToGlobal(Offset.zero).dy;
4085:     if (stackTop < viewportTop) {
4086:       final visibleTop = viewportTop - stackTop;
4087:       _setTopIfNeeded(math.max(widget.preferredTop, visibleTop));
4088:       return;
4089:     }
4090:     _setTopIfNeeded(widget.preferredTop);
4091:   }
4092: 
4093:   void _setTopIfNeeded(double nextTop) {
4094:     if ((_effectiveTop - nextTop).abs() < 0.5) {
4095:       return;
4096:     }
4097:     setState(() {
4098:       _top = nextTop;
4099:     });
4100:   }
4101: }
