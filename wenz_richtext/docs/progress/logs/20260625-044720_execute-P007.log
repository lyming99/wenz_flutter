5374: double _richTextFirstLineCenterY(WidgetTester tester, Finder finder) {
5375:   final richText = tester.widget<RichText>(finder);
5376:   final painter = _richTextPainter(tester, finder, richText);
5377:   final firstLine = painter.computeLineMetrics().first;
5378:   return tester.getTopLeft(finder).dy +
5379:       firstLine.baseline -
5380:       firstLine.ascent +
5381:       firstLine.height / 2;
