  381: /// Rich text editor surface backed by a [WenzRichTextController].
  382: ///
  383: /// Heading collapse is a view concern of this surface: built-in collapse
  384: /// affordances belong only to top-level heading blocks, can be toggled in
  385: /// read-only mode, and must not call document-mutating commands or enqueue
  386: /// undo/redo entries.
  387: class WenzRichTextEditor extends StatefulWidget {
  388:   const WenzRichTextEditor({
  389:     super.key,
  390:     required this.controller,
  391:     this.padding = const EdgeInsets.all(16),
  392:     this.blockSpacing = _kDefaultBlockSpacing,
  393:     this.textStyle,
  394:     this.physics,
  395:     this.focusNode,
  396:     this.autofocus = false,
  397:     this.readOnly = false,
  398:     this.showDebugOverlay = false,
  399:     this.enableIme = true,
  400:     this.blockRenderers,
  401:     this.mediaResolver,
  402:     this.inlineEmbedRenderer,
  403:     this.findController,
  404:     this.onFindRequested,
  405:     this.onReplaceRequested,
  406:     this.slashMenuController,
  407:     this.outlineController,
  408:     this.accessibility = const WenzRichTextEditorAccessibility(),
  409:   });
  410: 
  411:   final WenzRichTextController controller;
  412:   final EdgeInsetsGeometry padding;
  413:   final double blockSpacing;
  414:   final TextStyle? textStyle;
  415:   final ScrollPhysics? physics;
  416:   final FocusNode? focusNode;
  417:   final bool autofocus;
  418:   final bool readOnly;
  419: 
  420:   /// When true, overlays the active block's id, index, path, and caret offset
  421:   /// for debugging selection behaviour. Does not affect layout or offsets.
  422:   final bool showDebugOverlay;
  423: 
  424:   /// When true (default), attaches a [TextInput] connection on focus so the
  425:   /// platform IME drives character entry via composition deltas. Set false to
  426:   /// fall back to direct key-event character insertion (used by headless
  427:   /// widget tests that inject characters via [sendKeyEvent]).
  428:   final bool enableIme;
  429: 
  430:   /// Optional [BlockRendererRegistry]. When `null`, the editor builds a fresh
  431:   /// registry with the built-in default renderers. Pass your own to override
  432:   /// how specific [BlockType]s render (e.g. a real image decoder for image
  433:   /// blocks) or to register business [BlockEmbedNode.embedType] renderers. Use
  434:   /// [installDefaultRenderers] to seed a custom registry with the built-ins
  435:   /// before overriding individual types.
  436:   final BlockRendererRegistry? blockRenderers;
  437: 
  438:   /// Optional [MediaResolver] that takes over rendering for image/video/file
  439:   /// blocks. The built-in media renderers ask the resolver first and fall back
  440:   /// to the placeholder when it returns `null` (or when no resolver is set).
  441:   /// This is the quick path for real media rendering; for finer control
  442:   /// (e.g. swapping the whole block widget) use [blockRenderers] instead.
  443:   /// Throwing from the resolver is tolerated — the editor falls back to the
  444:   /// placeholder rather than crashing.
  445:   final MediaResolver? mediaResolver;
  446: 
  447:   /// Optional renderer for inline embeds such as formula / mention. The
  448:   /// built-in text renderers ask this first and use their compact fallback
  449:   /// labels when it returns `null`.
  450:   final InlineEmbedRenderer? inlineEmbedRenderer;
  451: 
  452:   /// Optional find/replace controller. When provided, the editor paints all
  453:   /// current matches and enables Ctrl/Cmd+F/H shortcut dispatch.
  454:   final WenzFindReplaceController? findController;
  455: 
  456:   /// Called for Ctrl/Cmd+F when a find surface is available.
  457:   final VoidCallback? onFindRequested;
  458: 
  459:   /// Called for Ctrl/Cmd+H when a replace surface is available.
  460:   final VoidCallback? onReplaceRequested;
  461: 
  462:   /// Optional slash-menu controller. When provided, the editor shows the
  463:   /// built-in slash overlay and routes ArrowUp/ArrowDown/Enter/Escape to it
  464:   /// while the menu is open.
  465:   final SlashMenuController? slashMenuController;
  466: 
  467:   /// Optional outline controller whose collapsed-heading state projects the
  468:   /// rendered top-level block list without mutating the source document.
  469:   final WenzOutlineController? outlineController;
  470: 
  471:   /// Accessibility labels, hints, and high-contrast focus styling.
  472:   final WenzRichTextEditorAccessibility accessibility;
  473: 
  474:   /// Seeds [registry] with the built-in block renderers for every [BlockType].
  475:   /// Call this on a freshly constructed [BlockRendererRegistry] when you want
  476:   /// to override only a few types while keeping the defaults for the rest:
  477:   ///
  478:   /// ```dart
  479:   /// final registry = BlockRendererRegistry();
  480:   /// WenzRichTextEditor.installDefaultRenderers(registry);
  481:   /// registry.register(BlockType.image, myImageRenderer);
  482:   /// ```
  483:   static void installDefaultRenderers(BlockRendererRegistry registry) {
  484:     registry
  485:       ..register(BlockType.paragraph, _defaultTextBlockRenderer)
  486:       ..register(BlockType.heading, _defaultTextBlockRenderer)
  487:       ..register(BlockType.quote, _defaultTextBlockRenderer)
  488:       ..register(BlockType.listItem, _defaultTextBlockRenderer)
  489:       ..register(BlockType.code, _defaultCodeBlockRenderer)
  490:       ..register(BlockType.image, _defaultImageBlockRenderer)
  491:       ..register(BlockType.table, _defaultTableBlockRenderer)
  492:       ..register(BlockType.divider, _defaultDividerBlockRenderer)
  493:       ..register(BlockType.video, _defaultVideoBlockRenderer)
  494:       ..register(BlockType.embed, _defaultBlockEmbedRenderer)
  495:       ..register(BlockType.callout, _defaultCalloutBlockRenderer)
  496:       ..register(BlockType.file, _defaultFileBlockRenderer);
  497:   }
  498: 
  499:   @override
  500:   State<WenzRichTextEditor> createState() => _WenzRichTextEditorState();
  501: }
