 5191: double _measureInlineSpanWidth(InlineSpan span, TextDirection textDirection) {
 5192:   final painter = TextPainter(
 5193:     text: span,
 5194:     textDirection: textDirection,
 5195:   )..layout(maxWidth: double.infinity);
 5196:   final width = painter.width;
 5197:   painter.dispose();
 5198:   return width.isFinite ? width : 0;
 5199: }
