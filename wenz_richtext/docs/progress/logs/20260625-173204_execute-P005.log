 5476: TableCellRange? _activeTableRange(
 5477:   DocumentSelection? selection,
 5478:   TableBlockNode tableBlock,
 5479:   int blockIndex,
 5480: ) {
 5481:   final range = selection?.tableCellRange;
 5482:   if (range == null ||
 5483:       range.tableBlockId != tableBlock.id ||
 5484:       range.blockIndex != blockIndex) {
 5485:     return null;
 5486:   }
 5487:   final rowCount = tableBlock.table.rowCount;
 5488:   final columnCount = tableBlock.table.columnCount;
 5489:   if (rowCount == 0 || columnCount == 0) {
 5490:     return null;
 5491:   }
 5492:   return TableCellRange(
 5493:     tableBlockId: tableBlock.id,
 5494:     blockIndex: blockIndex,
 5495:     startRow: range.startRow.clamp(0, rowCount - 1).toInt(),
 5496:     endRow: range.endRow.clamp(0, rowCount - 1).toInt(),
 5497:     startColumn: range.startColumn.clamp(0, columnCount - 1).toInt(),
 5498:     endColumn: range.endColumn.clamp(0, columnCount - 1).toInt(),
 5499:   );
 5500: }
