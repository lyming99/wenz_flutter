 5135: double _measureInlineSpanWidth(InlineSpan span, TextDirection textDirection) {
 5136:   final painter = TextPainter(
 5137:     text: span,
 5138:     textDirection: textDirection,
 5139:   )..layout(maxWidth: double.infinity);
 5140:   final width = painter.width;
 5141:   painter.dispose();
 5142:   return width.isFinite ? width : 0;
 5143: }
