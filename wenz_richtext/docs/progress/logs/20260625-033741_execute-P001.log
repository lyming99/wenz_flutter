 1760:   /// Handles PageUp/PageDown: scrolls the content by exactly one viewport (a
 1761:   /// "page") and moves the caret by the same amount through the document, so
 1762:   /// repeated paging advances one page each press and the caret keeps both its
 1763:   /// horizontal column and its relative screen position.
 1764:   ///
 1765:   /// `forward` = true → PageDown, false → PageUp. When [expandSelection] is
 1766:   /// true the anchor stays put and only the extent moves. Falls back to
 1767:   /// block-boundary motion when no viewport / caret geometry is available
 1768:   /// (e.g. headless tests).
 1769:   ///
 1770:   /// The caret target is measured in the document's content (scroll) space —
 1771:   /// caret Y ± one viewport — and is *not* clamped to the current viewport.
 1772:   /// Clamping there was the old bug: it pinned the caret at the viewport edge
 1773:   /// and then jumped to the document end on the next press.
 1774:   ///
 1775:   /// Resolution is split in two:
 1776:   /// 1. When the target lands inside the currently-mounted content (the common
 1777:   ///    case — a short doc, or a page that stays within the built range) the
 1778:   ///    caret is placed synchronously right after the one-page scroll jump.
 1779:   /// 2. When the target overshoots the mounted range (a tall, virtualised
 1780:   ///    document) the one-page scroll is applied first and the caret is placed
 1781:   ///    on the next frame, once the target block is built. Only an actual
 1782:   ///    scroll change schedules that frame, so there is always a frame to run
 1783:   ///    the deferred place.
 1784:   void _handlePageKey({required bool forward, required bool expandSelection}) {
 1785:     final controller = widget.controller;
 1786:     final selection = controller.selection;
 1787:     if (selection == null) {
 1788:       controller.moveCaretToBlockBoundary(
 1789:         forward: forward,
 1790:         expandSelection: expandSelection,
 1791:       );
 1792:       return;
 1793:     }
 1794:     final caretRect = _registry.caretRectForPosition(selection.extent);
 1795:     final renderBox = context.findRenderObject() as RenderBox?;
 1796:     if (caretRect == null ||
 1797:         renderBox == null ||
 1798:         !renderBox.hasSize ||
 1799:         !_scrollController.hasClients) {
 1800:       // No layout/viewport available: fall back to block-boundary motion so
 1801:       // the key still does something predictable (matches prior behaviour).
 1802:       controller.moveCaretToBlockBoundary(
 1803:         forward: forward,
 1804:         expandSelection: expandSelection,
 1805:       );
 1806:       return;
 1807:     }
 1808:     final scrollPosition = _scrollController.position;
 1809:     final viewportTop = renderBox.localToGlobal(Offset.zero).dy;
 1810:     final viewportHeight = renderBox.size.height;
 1811:     // Preserve the caret's horizontal column across the page jump so repeated
 1812:     // PageUp/PageDown keep the same x position.
 1813:     final caretX = caretRect.left;
 1814:     // Caret Y in the document's content (scroll) coordinate space: pixels from
 1815:     // the top of the full scrollable content.
 1816:     final caretContentY = caretRect.top - viewportTop + scrollPosition.pixels;
 1817:     // Move exactly one viewport ("page") through the content in the travel
 1818:     // direction. Measured in content space, so it is independent of where the
 1819:     // viewport currently sits.
 1820:     final targetContentY = forward
 1821:         ? caretContentY + viewportHeight
 1822:         : caretContentY - viewportHeight;
 1823: 
 1824:     // The document's content extent in content space: the bottom of the last
 1825:     // mounted block. When a page jump overshoots this the caret should go to
 1826:     // the document end rather than the (ambiguous) nearest block.
 1827:     final globalBottom = _registry.contentExtent();
 1828:     final contentExtent = globalBottom == null
 1829:         ? null
 1830:         : globalBottom - viewportTop + scrollPosition.pixels;
 1831:     final beyondDocument = contentExtent == null ||
 1832:         (forward && targetContentY >= contentExtent) ||
 1833:         (!forward && targetContentY <= 0);
