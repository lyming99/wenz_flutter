 208: /// Maps [BlockType]s and custom [BlockEmbedNode.embedType]s to
 209: /// [BlockRendererBuilder]s. The editor consults this registry to paint each
 210: /// block; built-in types ship with default builders, and plugins override or
 211: /// extend them via [register] / [registerEmbed].
 212: ///
 213: /// The registry is an indirection point: it lets a consumer replace how a given
 214: /// block type renders (e.g. a custom image block with a real decoder) or how a
 215: /// business embed type renders without forking the editor widget.
 216: ///
 217: /// To start from the built-in defaults, construct the registry and then call
 218: /// [WenzRichTextEditor.installDefaultRenderers]; or use the editor's
 219: /// [WenzRichTextEditor.blockRenderers] parameter — when omitted the editor
 220: /// builds a private registry with the defaults already installed.
 221: class BlockRendererRegistry {
 222:   BlockRendererRegistry({
 223:     Map<BlockType, BlockRendererBuilder> builders =
 224:         const <BlockType, BlockRendererBuilder>{},
 225:     Map<String, BlockRendererBuilder> embedBuilders =
 226:         const <String, BlockRendererBuilder>{},
 227:   }) {
 228:     _builders.addAll(builders);
 229:     _embedBuilders.addAll(embedBuilders);
 230:   }
 231: 
 232:   final Map<BlockType, BlockRendererBuilder> _builders =
 233:       <BlockType, BlockRendererBuilder>{};
 234:   final Map<String, BlockRendererBuilder> _embedBuilders =
 235:       <String, BlockRendererBuilder>{};
 236: 
 237:   /// Registered block types in insertion order.
 238:   Iterable<BlockType> get blockTypes => _builders.keys;
 239: 
 240:   /// Registered custom block embed types in insertion order.
 241:   Iterable<String> get embedTypes => _embedBuilders.keys;
 242: 
 243:   /// Registers [builder] for [type], replacing any existing builder for that
 244:   /// type. Returning the previous builder (if any) lets callers chain or wrap
 245:   /// the default renderer.
 246:   BlockRendererBuilder? register(BlockType type, BlockRendererBuilder builder) {
 247:     final previous = _builders[type];
 248:     _builders[type] = builder;
 249:     return previous;
 250:   }
 251: 
 252:   /// Removes the builder for [type], if any. The editor falls back to its
 253:   /// plain-text default for that type.
 254:   void unregister(BlockType type) {
 255:     _builders.remove(type);
 256:   }
 257: 
 258:   /// Returns the builder for [type], falling back to [fallback] when none is
 259:   /// registered. The editor passes a plain-text fallback so unknown block types
 260:   /// always render *something*.
 261:   BlockRendererBuilder resolve(
 262:     BlockType type, {
 263:     required BlockRendererBuilder fallback,
 264:   }) {
