 1846:       // page yields a collapsed caret (moveCaretToDocumentBoundary would keep
 1847:       // the pre-move range end as the anchor, producing a selection range).
 1848:       final boundaryContentY =
 1849:           forward ? (contentExtent ?? targetContentY) : 0.0;
 1850:       final boundaryGlobalY =
 1851:           boundaryContentY - scrollPosition.pixels + viewportTop;
 1852:       final boundary = _registry.positionFromGlobalOffset(
