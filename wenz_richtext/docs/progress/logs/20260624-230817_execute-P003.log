455`t  void _scheduleAutoScrollSelectionExtend() {
456`t    if (_autoScrollExtendPending) {
457`t      return;
458`t    }
459`t    _autoScrollExtendPending = true;
460`t    WidgetsBinding.instance.addPostFrameCallback((_) {
461`t      _autoScrollExtendPending = false;
462`t      if (!mounted || !_isDragging) {
463`t        return;
464`t      }
465`t      final pointer = _lastDragPosition;
466`t      if (pointer != null) {
467`t        _extendSelection(pointer);
