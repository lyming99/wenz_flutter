431`t  void _onAutoScrollTick(Duration elapsed) {
432`t    final scrollable = widget.scrollController;
433`t    if (!scrollable.hasClients) {
434`t      _stopAutoScroll();
435`t      return;
436`t    }
437`t    // Advance the scroll offset by one frame's worth of velocity and clamp to
438`t    // the scroll bounds. When we reach a bound there is nothing more to scroll,
439`t    // so stop the ticker to avoid burning frames.
440`t    final maxExtent = scrollable.position.maxScrollExtent;
441`t    final current = scrollable.offset;
442`t    final next = (current + _autoScrollVelocity).clamp(0.0, maxExtent);
443`t    if ((next - current).abs() < 0.1) {
444`t      // Already at the scroll bound in the requested direction.
445`t      _stopAutoScroll();
446`t      return;
447`t    }
448`t    scrollable.position.jumpTo(next);
449`t    // As content scrolls under a stationary mouse/stylus pointer, keep resolving
450`t    // the extent at that same global coordinate so the visible highlight grows
451`t    // with the scroll instead of jumping only on pointer-up.
452`t    _scheduleAutoScrollSelectionExtend();
453`t  }
