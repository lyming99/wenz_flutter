384`t  /// that holding the pointer still near an edge keeps scrolling and extending
385`t  /// the selection. Touch is left out: a touch drag's continuous motion already
386`t  /// drives [_syncScrollToEdge] per move, and touch selection past the viewport
387`t  /// uses dedicated handles (C9).
388`t  void _maybeStartAutoScroll(PointerDeviceKind kind, Offset global) {
389`t    if (kind != PointerDeviceKind.mouse && kind != PointerDeviceKind.stylus) {
390`t      _stopAutoScroll();
391`t      return;
392`t    }
393`t    final scrollable = widget.scrollController;
394`t    if (!scrollable.hasClients) {
395`t      return;
396`t    }
397`t    final renderBox = context.findRenderObject() as RenderBox?;
398`t    if (renderBox == null || !renderBox.hasSize) {
399`t      return;
400`t    }
401`t    final viewportOrigin = renderBox.localToGlobal(Offset.zero);
402`t    final viewportHeight = renderBox.size.height;
403`t    final localY = global.dy - viewportOrigin.dy;
404`t
405`t    // Compute the signed pixels-per-frame velocity. The closer the pointer is
406`t    // to an edge, the faster we scroll (linear ramp up to the cap).
407`t    double velocity = 0;
408`t    if (localY < _autoScrollEdge) {
409`t      final proximity = (_autoScrollEdge - localY) / _autoScrollEdge;
410`t      velocity = -(_maxAutoScrollPerFrame * proximity);
411`t    } else if (localY > viewportHeight - _autoScrollEdge) {
412`t      final proximity =
413`t          (localY - (viewportHeight - _autoScrollEdge)) / _autoScrollEdge;
414`t      velocity = _maxAutoScrollPerFrame * proximity;
415`t    }
416`t
417`t    if (velocity.abs() < 0.5) {
418`t      // Pointer left the edge band: stop continuous auto-scroll. The synchronous
419`t      // edge scroll above still handled this move.
420`t      _stopAutoScroll();
421`t      return;
422`t    }
423`t    _autoScrollVelocity = velocity;
424`t    _autoScrollTicker ??= Ticker(_onAutoScrollTick);
425`t    if (!_autoScrollActive) {
426`t      _autoScrollActive = true;
427`t      _autoScrollTicker!.start();
428`t    }
