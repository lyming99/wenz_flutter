-  int get hashCode => Object.hash(blockId, blockIndex, level, title, anchor);
+  int get hashCode => Object.hash(
+        startBlockIndex,
+        endBlockIndexExclusive,
+        Object.hashAll(blockIds),
+      );
 }
 
