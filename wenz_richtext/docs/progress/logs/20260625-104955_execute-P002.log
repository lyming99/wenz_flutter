+  final String blockId;
+  final int blockIndex;
+  final int level;
+  final String title;
+  final String? anchor;
+  final OutlineCollapseRange collapseRange;
+
+  OutlineItem toItem({required bool isCollapsed}) {
+    return OutlineItem(
+      blockId: blockId,
+      blockIndex: blockIndex,
+      level: level,
+      title: title,
+      anchor: anchor,
+      collapseRange: collapseRange,
