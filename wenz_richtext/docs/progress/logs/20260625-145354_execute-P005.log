  887:   bool _isAtBlockBoundary(
  888:     DocumentPosition position, {
  889:     required bool forward,
  890:   }) {
  891:     final blocks = widget.controller.document.blocks;
  892:     if (position.blockIndex < 0 || position.blockIndex >= blocks.length) {
  893:       return false;
  894:     }
  895:     final block = blocks[position.blockIndex];
  896:     if (position.path.isBlockText && block is TextBlockNode) {
  897:       final length = inlineNodesLength(block.content);
  898:       final offset = position.offset.clamp(0, length).toInt();
  899:       return forward ? offset >= length : offset <= 0;
  900:     }
  901:     if (position.path.isBlockCode && block is CodeBlockNode) {
  902:       final offset = position.offset.clamp(0, block.code.length).toInt();
  903:       return forward ? offset >= block.code.length : offset <= 0;
  904:     }
  905:     return position.path.isBlockObject;
  906:   }
