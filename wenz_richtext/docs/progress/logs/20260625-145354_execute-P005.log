 6757:     final safeStart = start.clamp(0, widget.textLength).toInt();
 6758:     final safeEnd = end.clamp(safeStart, widget.textLength).toInt();
 6759:     if (safeStart == safeEnd) {
 6760:       return _localCaretRectAt(safeStart);
 6761:     }
 6762:     final renderStart = widget.offsetMapper.renderOffsetForLogicalOffset(
 6763:       safeStart,
