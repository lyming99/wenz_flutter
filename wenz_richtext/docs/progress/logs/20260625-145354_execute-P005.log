 6632:   /// Maps a tap offset in the registered hit-test frame's local space into
 6633:   /// this surface's text-local space. Only used when a separate [hitTestKey]
 6634:   /// was provided (table cells); otherwise the registry treats the text
 6635:   /// surface itself as the hit-test box and this is never called.
 6636:   ///
 6637:   /// Resolves both render boxes at hit-test time and adds the global delta
 6638:   /// between them — robust to padding and to the vertical centring gap that
 6639:   /// `TableCellVerticalAlignment.middle` introduces for short cells.
 6640:   Offset _hitLocalToTextLocal(Offset hitLocal) {
 6641:     final hitKey = widget.hitTestKey;
 6642:     if (hitKey == null) {
 6643:       return hitLocal;
 6644:     }
 6645:     final cellBox = hitKey.currentContext?.findRenderObject();
 6646:     final textBox = _surfaceKey.currentContext?.findRenderObject();
 6647:     if (cellBox is! RenderBox || textBox is! RenderBox) {
 6648:       // Layout not ready: fall back to stripping the known 8px cell padding.
 6649:       // There is no centring correction here, but this path is only hit
 6650:       // before first layout and is strictly better than the raw offset.
 6651:       return hitLocal - const Offset(8, 8);
 6652:     }
 6653:     final cellOrigin = cellBox.localToGlobal(Offset.zero);
 6654:     final textOrigin = textBox.localToGlobal(Offset.zero);
 6655:     // hitLocal is cell-relative; convert to text-surface-relative. Since both
 6656:     // boxes share global space: textLocal = hitLocal + (cellOrigin - textOrigin).
 6657:     // (cellOrigin < textOrigin because the text sits inside the padding, so this
 6658:     // subtracts the padding/centring offset, landing the tap on the text.)
 6659:     final textLocal = hitLocal +
 6660:         Offset(cellOrigin.dx - textOrigin.dx, cellOrigin.dy - textOrigin.dy);
 6661:     // Clamp into the text surface so an off-text tap (e.g. a bottom gutter
 6662:     // below a centred short cell) maps to the nearest caret edge rather than a
 6663:     // point outside the painter's line metrics.
 6664:     return Offset(
 6665:       textLocal.dx.clamp(0, textBox.size.width),
 6666:       textLocal.dy.clamp(0, textBox.size.height),
 6667:     );
 6668:   }
