5959`t      fixedWidth += explicit;
5960`t    } else {
5961`t      flexCount += 1;
5962`t    }
5963`t  }
5964`t  if (flexCount == 0) {
5965`t    return widths;
5966`t  }
5967`t  final remaining = maxWidth - fixedWidth;
5968`t  final flexWidth = remaining > 0 ? remaining / flexCount : 80.0;
5969`t  for (var i = 0; i < columnCount; i++) {
5970`t    if (widths[i] == 0) {
