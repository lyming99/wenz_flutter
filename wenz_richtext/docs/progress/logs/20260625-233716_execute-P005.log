5826`t
5827`tclass _TableGridMetrics {
5828`t  const _TableGridMetrics({
5829`t    required this.width,
5830`t    required this.height,
5831`t    required this.columnWidths,
5832`t    required this.columnLefts,
5833`t    required this.cells,
5834`t  });
5835`t
5836`t  final double width;
5837`t  final double height;
5838`t  final List<double> columnWidths;
5839`t  final List<double> columnLefts;
5840`t  final List<_TableGridCell> cells;
5841`t
5842`t  static _TableGridMetrics compute({
5843`t    required TableModel table,
5844`t    required double maxWidth,
5845`t    required TextStyle textStyle,
5846`t    required TextDirection textDirection,
5847`t  }) {
5848`t    final columnCount = table.columnCount;
5849`t    final rowCount = table.rowCount;
5850`t    final columnWidths = _resolveTableColumnWidths(table, maxWidth);
5851`t    final rowHeights = List<double>.filled(
5852`t      rowCount,
5853`t      _minimumTableCellHeight(textStyle),
5854`t    );
5855`t
5856`t    for (var row = 0; row < rowCount; row++) {
5857`t      for (var column = 0; column < columnCount; column++) {
5858`t        final cell = table.cellAt(row, column);
5859`t        if (cell == null || cell.covered) {
5860`t          continue;
5861`t        }
5862`t        final columnSpan = _clampedTableSpan(
5863`t          cell.columnSpan,
5864`t          column,
5865`t          columnCount,
5866`t        );
5867`t        final rowSpan = _clampedTableSpan(cell.rowSpan, row, rowCount);
5868`t        final cellWidth = _sumTableRange(columnWidths, column, columnSpan);
5869`t        final desiredHeight = _measureTableCellHeight(
5870`t          cell,
5871`t          textStyle,
5872`t          textDirection,
5873`t          cellWidth,
5874`t        );
5875`t        final currentHeight = _sumTableRange(rowHeights, row, rowSpan);
5876`t        if (desiredHeight > currentHeight) {
5877`t          final extra = (desiredHeight - currentHeight) / rowSpan;
5878`t          for (var i = 0; i < rowSpan; i++) {
5879`t            rowHeights[row + i] += extra;
5880`t          }
5881`t        }
5882`t      }
5883`t    }
5884`t
5885`t    final lefts = _tableOffsets(columnWidths);
5886`t    final tops = _tableOffsets(rowHeights);
5887`t    final cells = <_TableGridCell>[];
5888`t    for (var row = 0; row < rowCount; row++) {
5889`t      for (var column = 0; column < columnCount; column++) {
5890`t        final cell = table.cellAt(row, column);
5891`t        if (cell == null || cell.covered) {
5892`t          continue;
5893`t        }
5894`t        final columnSpan = _clampedTableSpan(
5895`t          cell.columnSpan,
5896`t          column,
5897`t          columnCount,
5898`t        );
5899`t        final rowSpan = _clampedTableSpan(cell.rowSpan, row, rowCount);
5900`t        cells.add(
5901`t          _TableGridCell(
5902`t            rowIndex: row,
5903`t            columnIndex: column,
5904`t            rowSpan: rowSpan,
5905`t            columnSpan: columnSpan,
5906`t            cell: cell,
5907`t            left: lefts[column],
5908`t            top: tops[row],
5909`t            width: _sumTableRange(columnWidths, column, columnSpan),
5910`t            height: _sumTableRange(rowHeights, row, rowSpan),
5911`t          ),
5912`t        );
5913`t      }
5914`t    }
5915`t
5916`t    return _TableGridMetrics(
5917`t      width: _sumTableRange(columnWidths, 0, columnWidths.length),
5918`t      height: _sumTableRange(rowHeights, 0, rowHeights.length),
5919`t      columnWidths: columnWidths,
5920`t      columnLefts: lefts,
5921`t      cells: cells,
5922`t    );
5923`t  }
5924`t}
5925`t
5926`tclass _TableGridCell {
5927`t  const _TableGridCell({
5928`t    required this.rowIndex,
5929`t    required this.columnIndex,
5930`t    required this.rowSpan,
5931`t    required this.columnSpan,
5932`t    required this.cell,
5933`t    required this.left,
5934`t    required this.top,
5935`t    required this.width,
5936`t    required this.height,
5937`t  });
5938`t
5939`t  final int rowIndex;
5940`t  final int columnIndex;
5941`t  final int rowSpan;
5942`t  final int columnSpan;
5943`t  final TableCellNode cell;
5944`t  final double left;
5945`t  final double top;
5946`t  final double width;
5947`t  final double height;
5948`t}
5949`t
5950`tList<double> _resolveTableColumnWidths(TableModel table, double maxWidth) {
5951`t  final columnCount = table.columnCount;
5952`t  final widths = List<double>.filled(columnCount, 0);
5953`t  var fixedWidth = 0.0;
5954`t  var flexCount = 0;
5955`t  for (var i = 0; i < columnCount; i++) {
5956`t    final explicit = table.columnWidths[i];
5957`t    if (explicit != null && explicit > 0) {
5958`t      widths[i] = explicit;
5959`t      fixedWidth += explicit;
5960`t    } else {
5961`t      flexCount += 1;
5962`t    }
5963`t  }
5964`t  if (flexCount == 0) {
5965`t    return widths;
5966`t  }
5967`t  final remaining = maxWidth - fixedWidth;
5968`t  final flexWidth = remaining > 0 ? remaining / flexCount : 80.0;
5969`t  for (var i = 0; i < columnCount; i++) {
5970`t    if (widths[i] == 0) {
5971`t      widths[i] = flexWidth;
5972`t    }
5973`t  }
5974`t  return widths;
5975`t}
5976`t
5977`tdouble _measureTableCellHeight(
5978`t  TableCellNode cell,
5979`t  TextStyle textStyle,
5980`t  TextDirection textDirection,
5981`t  double cellWidth,
5982`t) {
5983`t  final effectiveTextStyle = cell.isHeader
5984`t      ? textStyle.copyWith(fontWeight: FontWeight.w700)
5985`t      : textStyle;
5986`t  final text = _tableCellDisplayText(cell);
5987`t  final displayText = text.isEmpty ? ' ' : text;
5988`t  final innerWidth = cellWidth - _kTableCellPadding.horizontal;
5989`t  final painter = TextPainter(
5990`t    text: TextSpan(text: displayText, style: effectiveTextStyle),
5991`t    textAlign: TextAlign.start,
5992`t    textDirection: textDirection,
5993`t  )..layout(maxWidth: innerWidth > 0 ? innerWidth : 0);
5994`t  final height = painter.height + _kTableCellPadding.vertical;
5995`t  painter.dispose();
5996`t  final minimum = _minimumTableCellHeight(textStyle);
5997`t  return height > minimum ? height : minimum;
5998`t}
5999`t
6000`tList<InlineNode> _tableCellInlineContent(TableCellNode? cell) {
6001`t  if (cell == null) {
6002`t    return const <InlineNode>[];
6003`t  }
6004`t  for (final block in cell.blocks) {
6005`t    if (block is TextBlockNode) {
6006`t      return block.content;
6007`t    }
6008`t  }
6009`t  return <InlineNode>[TextRun(text: cell.plainText)];
6010`t}
6011`t
6012`tString _tableCellDisplayText(TableCellNode cell) {
6013`t  final inline = _tableCellInlineContent(cell);
6014`t  if (inline.isEmpty) {
6015`t    return cell.plainText;
6016`t  }
6017`t  return inline.map(_inlineDisplayText).join();
6018`t}
6019`t
6020`tdouble _minimumTableCellHeight(TextStyle textStyle) {
6021`t  return ((textStyle.fontSize ?? _kTableCellFontSize) *
6022`t          _kBlockMinHeightFactor) +
6023`t      _kTableCellPadding.vertical;
6024`t}
6025`t
6026`tColor? _tableCellBackgroundColor({
6027`t  required ThemeData theme,
6028`t  required TableCellNode? cell,
6029`t  required int rowIndex,
6030`t}) {
6031`t  if (cell == null) {
6032`t    return null;
6033`t  }
6034`t  if (cell.backgroundColor != null) {
6035`t    return Color(cell.backgroundColor!);
6036`t  }
6037`t  if (cell.isHeader) {
6038`t    return theme.colorScheme.surfaceContainer;
6039`t  }
6040`t  if (rowIndex.isOdd) {
6041`t    return _kTableEvenRowBackgroundColor;
6042`t  }
6043`t  return null;
6044`t}
6045`t
6046`tint _clampedTableSpan(int span, int start, int count) {
6047`t  final normalized = span < 1 ? 1 : span;
6048`t  final available = count - start;
6049`t  if (available <= 0) {
6050`t    return 1;
6051`t  }
6052`t  return normalized > available ? available : normalized;
6053`t}
