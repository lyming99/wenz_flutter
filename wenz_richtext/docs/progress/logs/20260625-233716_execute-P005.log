6074`tbool _shouldHighlightTableCell(
6075`t  DocumentSelection? selection,
6076`t  String tableBlockId,
6077`t  int blockIndex,
6078`t  int rowIndex,
6079`t  int columnIndex,
6080`t) {
6081`t  if (selection == null || selection.isCollapsed) {
6082`t    return false;
6083`t  }
6084`t  // Intra-table cell range (drag within the table): highlight cells inside the
6085`t  // range via the structured TableCellRange.
6086`t  final range = selection.tableCellRange;
6087`t  if (range != null) {
6088`t    if (range.isSingleCell) {
6089`t      return false;
6090`t    }
6091`t    return range.tableBlockId == tableBlockId &&
6092`t        range.blockIndex == blockIndex &&
6093`t        range.containsCell(rowIndex, columnIndex);
6094`t  }
6095`t  // Cross-block selection that spans this table block (e.g. select-all across
6096`t  // a paragraph + table): when the table block sits strictly between the
6097`t  // selection endpoints, every cell is part of the selection and highlights.
6098`t  final start = selection.start;
6099`t  final end = selection.end;
6100`t  final tableCovered =
6101`t      start.blockIndex < blockIndex && end.blockIndex > blockIndex;
6102`t  if (tableCovered) {
6103`t    return true;
6104`t  }
6105`t  final cellPath = PositionPath.tableCellText(
6106`t    tableBlockId,
6107`t    rowIndex,
6108`t    columnIndex,
6109`t  );
6110`t  if (start.blockIndex == blockIndex &&
6111`t      start.path.isTableCellText &&
6112`t      end.blockIndex > blockIndex) {
6113`t    return start.blockId == tableBlockId && cellPath.compare(start.path) > 0;
6114`t  }
6115`t  if (end.blockIndex == blockIndex &&
6116`t      end.path.isTableCellText &&
6117`t      start.blockIndex < blockIndex) {
6118`t    return end.blockId == tableBlockId && cellPath.compare(end.path) < 0;
6119`t  }
6120`t  return false;
6121`t}
