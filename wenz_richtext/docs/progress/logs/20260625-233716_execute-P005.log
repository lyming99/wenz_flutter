5485`tTableCellRange? _activeTableRange(
5486`t  DocumentSelection? selection,
5487`t  TableBlockNode tableBlock,
5488`t  int blockIndex,
5489`t) {
5490`t  final range = selection?.tableCellRange;
5491`t  if (range == null ||
5492`t      range.tableBlockId != tableBlock.id ||
5493`t      range.blockIndex != blockIndex) {
5494`t    return null;
5495`t  }
5496`t  final rowCount = tableBlock.table.rowCount;
5497`t  final columnCount = tableBlock.table.columnCount;
5498`t  if (rowCount == 0 || columnCount == 0) {
5499`t    return null;
5500`t  }
5501`t  return TableCellRange(
5502`t    tableBlockId: tableBlock.id,
5503`t    blockIndex: blockIndex,
5504`t    startRow: range.startRow.clamp(0, rowCount - 1).toInt(),
5505`t    endRow: range.endRow.clamp(0, rowCount - 1).toInt(),
5506`t    startColumn: range.startColumn.clamp(0, columnCount - 1).toInt(),
5507`t    endColumn: range.endColumn.clamp(0, columnCount - 1).toInt(),
5508`t  );
5509`t}
