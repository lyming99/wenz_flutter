5803`tdouble _tableMaxWidth(BoxConstraints constraints, int columnCount) {
5804`t  if (constraints.maxWidth.isFinite && constraints.maxWidth > 0) {
5805`t    return constraints.maxWidth;
5806`t  }
5807`t  return columnCount * 120;
5808`t}
