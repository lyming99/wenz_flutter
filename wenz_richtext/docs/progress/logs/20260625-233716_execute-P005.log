5810`tBorder _tableCellBorder({
5811`t  required _TableGridCell cell,
5812`t  required int rowCount,
5813`t  required int columnCount,
5814`t  required Color color,
5815`t}) {
5816`t  final side = BorderSide(color: color);
5817`t  return Border(
5818`t    top: side,
5819`t    left: side,
5820`t    right: cell.columnIndex + cell.columnSpan >= columnCount
5821`t        ? side
5822`t        : BorderSide.none,
