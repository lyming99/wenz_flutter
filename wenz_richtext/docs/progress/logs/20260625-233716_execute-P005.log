5784`t      'Heading block level ${block.attributes.level}',
5785`t    TextBlockNode(type: BlockType.quote) => 'Quote block',
5786`t    TextBlockNode(type: BlockType.listItem) => 'List item block',
5787`t    TextBlockNode() => 'Paragraph block',
5788`t    CodeBlockNode() => 'Code block',
5789`t    TableBlockNode() =>
5790`t      'Table block, ${block.table.rowCount} rows, ${block.table.columnCount} columns',
5791`t    ImageBlockNode() => 'Image block ${_imageAccessibleLabel(block)}',
5792`t    VideoBlockNode() => 'Video block ${_assetLabel(block.assetId, block.file)}',
5793`t    BlockEmbedNode() =>
