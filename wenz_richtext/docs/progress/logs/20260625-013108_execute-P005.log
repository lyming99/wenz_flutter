4575: Offset _globalTextOffset(WidgetTester tester, String text, int offset) {
4576:   final finder = _richText(text);
4577:   final richText = tester.widget<RichText>(finder);
4578:   final size = tester.getSize(finder);
4579:   final painter = TextPainter(
4580:     text: richText.text,
4581:     textAlign: richText.textAlign,
4582:     textDirection: TextDirection.ltr,
4583:   )..layout(maxWidth: size.width);
4584:   final local = painter.getOffsetForCaret(
4585:     TextPosition(offset: offset),
4586:     Rect.zero,
4587:   );
4588:   return tester.getTopLeft(finder) +
4589:       local +
4590:       Offset(1, painter.preferredLineHeight / 2);
4591: }
