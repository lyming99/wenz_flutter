+String _editablePlainText(BlockNode block) {
+  if (block is TextBlockNode) {
+    return block.plainText;
+  }
+  if (block is CalloutBlockNode) {
+    return block.content.map((node) => node.plainText).join();
+  }
+  return block.plainText;
+}
