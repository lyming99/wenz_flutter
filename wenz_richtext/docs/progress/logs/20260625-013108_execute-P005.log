4593: Offset _globalTextRangePoint(
4594:   WidgetTester tester,
4595:   String text,
4596:   int startOffset,
4597:   int endOffset,
4598:   double fraction,
4599: ) {
4600:   final finder = _richText(text);
4601:   final richText = tester.widget<RichText>(finder);
4602:   final size = tester.getSize(finder);
4603:   final painter = TextPainter(
4604:     text: richText.text,
4605:     textAlign: richText.textAlign,
4606:     textDirection: TextDirection.ltr,
4607:   )..layout(maxWidth: size.width);
4608:   final boxes = painter.getBoxesForSelection(
4609:     TextSelection(baseOffset: startOffset, extentOffset: endOffset),
4610:   );
4611:   if (boxes.isEmpty) {
4612:     final start = _globalTextOffset(tester, text, startOffset);
4613:     final end = _globalTextOffset(tester, text, endOffset);
4614:     return start + (end - start) * fraction;
4615:   }
4616:   final firstBox = boxes.first.toRect();
4617:   final rangeRect = boxes.skip(1).fold<Rect>(
4618:         firstBox,
4619:         (current, box) => current.expandToInclude(box.toRect()),
4620:       );
4621:   return tester.getTopLeft(finder) +
4622:       Offset(
4623:         rangeRect.left + rangeRect.width * fraction,
4624:         rangeRect.top + rangeRect.height / 2,
4625:       );
4626: }
