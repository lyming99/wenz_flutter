+int _editableLength(BlockNode block) {
+  if (block is TextBlockNode) {
+    return inlineNodesLength(block.content);
+  }
+  if (block is CalloutBlockNode) {
+    return inlineNodesLength(block.content);
+  }
+  if (block is CodeBlockNode) {
+    return block.code.length;
+  }
+  return 0;
