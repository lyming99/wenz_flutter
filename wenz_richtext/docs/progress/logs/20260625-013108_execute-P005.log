+    return switch (block) {
+      TextBlockNode() => TextBlockNode(
+          id: block.id,
+          type: block.type,
+          attributes: block.attributes,
+          content: content,
+        ),
+      CalloutBlockNode() => block.copyWith(content: content),
+      _ => block.copy(),
+    };
+  }
+
+  String _plainTextForBoundary(BlockNode block, DocumentPosition position) {
+    if (block is CalloutBlockNode && position.path.isBlockText) {
+      return block.content.map((node) => node.plainText).join();
+    }
+    return block.plainText;
+  }
