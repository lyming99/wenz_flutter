 681:   List<String> _splitOnUnescapedPipe(String text) {
 682:     final cells = <String>[];
 683:     final buffer = StringBuffer();
 684:     var i = 0;
 685:     while (i < text.length) {
 686:       if (text[i] == '\\' && i + 1 < text.length && text[i + 1] == '|') {
 687:         buffer.write('\\|');
 688:         i += 2;
 689:         continue;
 690:       }
 691:       if (text[i] == '|') {
 692:         cells.add(buffer.toString());
 693:         buffer.clear();
 694:         i++;
 695:         continue;
 696:       }
 697:       buffer.write(text[i]);
 698:       i++;
 699:     }
 700:     cells.add(buffer.toString());
 701:     return cells;
 702:   }
