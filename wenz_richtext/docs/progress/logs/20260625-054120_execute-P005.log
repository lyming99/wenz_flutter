 777: // Regexes are anchored at match positions via `matchAsPrefix` / `firstMatch`
 778: // rather than searching globally, so the inline scanner walks left-to-right and
 779: // each construct is matched exactly where the cursor sits.
 780: 
 781: final RegExp _fenceRegex = RegExp(r'^(`{3,}|~{3,})(.*)$');
 782: final RegExp _headingRegex = RegExp(r'^(#{1,6})\s+(.*)$');
 783: final RegExp _thematicBreakRegex =
 784:     RegExp(r'^(-\s?){3,}$|^(\*\s?){3,}$|^(_\s?){3,}$');
 785: final RegExp _listItemRegex =
 786:     RegExp(r'^(\s*)(-|\*|\+|\d+\.)\s+(\[[ xX]\]\s+)?(.*)$');
 787: 
 788: // Inline patterns — each is matched at the current cursor position.
 789: final RegExp _inlineImageRegex =
 790:     RegExp(r'!\[([^\]]*)\]\(([^)\s]+)(?:\s+"((?:\\"|[^"])*)")?\)');
 791: final RegExp _inlineLinkRegex = RegExp(r'\[([^\]]*)\]\(([^)]+)\)');
 792: final RegExp _boldRegex = RegExp(r'\*\*([^*]+)\*\*');
 793: final RegExp _italicRegex = RegExp(r'\*([^*]+)\*');
 794: final RegExp _strikeRegex = RegExp(r'~~([^~]+)~~');
 795: final RegExp _underlineRegex = RegExp(r'<u>([^<]*)</u>');
 796: 
 797: // Matches a paragraph that is a single image token (whitespace trimmed).
 798: final RegExp _imageOnlyRegex =
 799:     RegExp(r'^!\[([^\]]*)\]\(([^)\s]+)(?:\s+"((?:\\"|[^"])*)")?\)$');

