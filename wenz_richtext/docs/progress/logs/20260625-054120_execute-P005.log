 385:   // ---------------------------------------------------------------------------
 386:   // Import: HTML fragment -> document (via package:html)
 387:   // ---------------------------------------------------------------------------
 388: 
 389:   /// Decodes [source] HTML into a [RichTextDocument]. HTML5's leniency means
 390:   /// any unrecognised / malformed content becomes paragraphs; [decode] does
 391:   /// not throw for content.
 392:   RichTextDocument decode(String source) {
 393:     final fragment = parser.parseFragment(source);
 394:     final blocks = <BlockNode>[];
 395:     var blockSeq = 0;
 396: 
 397:     String newId(String prefix) => 'html-${blockSeq++}-$prefix';
 398: 
 399:     for (final node in fragment.nodes) {
 400:       _decodeNode(node, blocks, newId);
 401:     }
 402: 
 403:     // A fragment with no recognised blocks (e.g. plain text or empty) still
 404:     // yields at least one paragraph so the document is never empty.
 405:     if (blocks.isEmpty) {
 406:       blocks.add(TextBlockNode(
 407:         id: newId('p'),
 408:         type: BlockType.paragraph,
 409:         content: const <InlineNode>[],
 410:       ));
 411:     }
 412:     return RichTextDocument(blocks: blocks);
 413:   }
 414: 
 415:   /// Decodes a single DOM [node] into zero or more blocks appended to
 416:   /// [blocks].
 417:   void _decodeNode(
 418:     dom.Node node,
 419:     List<BlockNode> blocks,
 420:     String Function(String) newId,
 421:   ) {
 422:     if (node is dom.Element) {
 423:       if (_isCalloutElement(node)) {
 424:         blocks.add(_decodeCallout(node, newId));
 425:         return;
 426:       }
 427:       if (_isFileBlockElement(node)) {
 428:         blocks.add(_decodeFileBlock(node, newId));
 429:         return;
 430:       }
 431:       if (_isBlockEmbedElement(node)) {
 432:         blocks.add(_decodeBlockEmbed(node, newId));
 433:         return;
 434:       }
 435:       final tag = node.localName!.toLowerCase();
 436:       switch (tag) {
 437:         case 'h1':
 438:         case 'h2':
 439:         case 'h3':
 440:         case 'h4':
 441:         case 'h5':
 442:         case 'h6':
 443:           final level = int.parse(tag.substring(1));
 444:           blocks.add(TextBlockNode(
 445:             id: newId('h'),
 446:             type: BlockType.heading,
 447:             attributes: BlockAttributes(level: level),
 448:             content: _parseInline(node),
 449:           ));
 450:           return;
 451:         case 'p':
 452:           final inline = _parseInline(node);
 453:           blocks.add(TextBlockNode(
 454:             id: newId('p'),
 455:             type: BlockType.paragraph,
 456:             content: inline,
 457:           ));
 458:           return;
 459:         case 'blockquote':
 460:           // Flatten blockquote children into a single quote block.
 461:           blocks.add(TextBlockNode(
 462:             id: newId('quote'),
 463:             type: BlockType.quote,
 464:             content: _parseInline(node),
 465:           ));
 466:           return;
 467:         case 'ul':
 468:         case 'ol':
 469:           final listType = tag == 'ol' ? 'ordered' : null;
 470:           for (final child in node.children) {
 471:             if (child.localName?.toLowerCase() == 'li') {
 472:               blocks.add(_decodeListItem(child, listType, newId));
 473:             }
 474:           }
 475:           return;
 476:         case 'pre':
 477:           blocks.add(_decodePre(node, newId));
 478:           return;
 479:         case 'table':
 480:           blocks.add(_decodeTable(node, newId('table')));
 481:           return;
 482:         case 'hr':
 483:           blocks.add(DividerBlockNode(id: newId('hr')));
 484:           return;
 485:         case 'figure':
 486:           final img = node.querySelector('img');
 487:           if (img != null) {
 488:             _decodeImageElement(
 489:               img,
 490:               blocks,
 491:               newId,
 492:               caption: node.querySelector('figcaption')?.text.trim() ?? '',
 493:             );
 494:             return;
 495:           }
 496:           for (final child in node.nodes) {
 497:             _decodeNode(child, blocks, newId);
 498:           }
 499:           return;
 500:         case 'img':
 501:           _decodeImageElement(node, blocks, newId);
 502:           return;
 503:         case 'video':
 504:           _decodeVideoElement(node, blocks, newId);
 505:           return;
 506:         case 'br':
 507:           return;
 508:         default:
 509:           // Unknown container (div/span/section/…): recurse into children so a
 510:           // `<div><p>…</p></div>` still yields its paragraph.
 511:           if (node.nodes.isNotEmpty) {
 512:             for (final child in node.nodes) {
 513:               _decodeNode(child, blocks, newId);
 514:             }
 515:           } else if (node.text.trim().isNotEmpty) {
 516:             blocks.add(TextBlockNode(
 517:               id: newId('p'),
 518:               type: BlockType.paragraph,
 519:               content: _parseInline(node),
 520:             ));
 521:           }
 522:           return;
 523:       }
 524:     } else if (node is dom.Text) {
 525:       final text = node.text;
 526:       if (text.trim().isNotEmpty) {
 527:         blocks.add(TextBlockNode(
 528:           id: newId('p'),
 529:           type: BlockType.paragraph,
 530:           content: _parseInlineText(text),
 531:         ));
 532:       }
 533:     }
 534:   }
 535: 
 536:   void _decodeImageElement(
 537:     dom.Element node,
 538:     List<BlockNode> blocks,
 539:     String Function(String) newId, {
 540:     String caption = '',
 541:   }) {
 542:     final src = node.attributes['src'] ?? '';
 543:     if (src.isEmpty) {
 544:       return;
 545:     }
 546:     final alt = node.attributes['alt'] ?? '';
 547:     final resolvedCaption = caption.isNotEmpty
 548:         ? caption
 549:         : (node.attributes['data-caption'] ?? node.attributes['title'] ?? '')
 550:             .trim();
 551:     final naturalWidth = _parseIntAttribute(node.attributes['data-width']);
 552:     final naturalHeight = _parseIntAttribute(node.attributes['data-height']);
 553:     blocks.add(ImageBlockNode(
 554:       id: newId('image'),
 555:       assetId: src,
 556:       file: alt,
 557:       width: naturalWidth,
 558:       height: naturalHeight,
 559:       showWidth: _parseDoubleAttribute(node.attributes['width']),
 560:       showHeight: _parseDoubleAttribute(node.attributes['height']),

===== html:560-900 =====
 560:       showHeight: _parseDoubleAttribute(node.attributes['height']),
 561:       caption: resolvedCaption,
 562:       altText: alt,
 563:     ));
 564:   }
