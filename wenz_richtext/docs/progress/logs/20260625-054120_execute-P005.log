 620:   Map<String, Object?> _decodeEmbedData(String? source) {
 621:     if (source == null || source.trim().isEmpty) {
 622:       return const <String, Object?>{};
 623:     }
 624:     try {
 625:       final decoded = jsonDecode(source);
 626:       if (decoded is Map) {
 627:         return Map<String, Object?>.from(decoded);
 628:       }
 629:     } on Object {
 630:       return const <String, Object?>{};
 631:     }
 632:     return const <String, Object?>{};
 633:   }
