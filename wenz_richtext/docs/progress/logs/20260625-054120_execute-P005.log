 248:   String _emojiDisplayText(InlineEmbed embed) {
 249:     final raw = embed.data['emoji'] ??
 250:         embed.data['text'] ??
 251:         embed.data['value'] ??
 252:         embed.data['shortName'] ??
 253:         embed.data['label'];
 254:     final text = raw?.toString() ?? '';
 255:     return text.isEmpty ? '[emoji]' : text;
 256:   }
 257: 
 258:   String _encodeImageBlock(ImageBlockNode image) {
 259:     final alt = _escapeHtml(_imageAlt(image));
 260:     final src = _escapeHtml(
 261:       image.assetId.isNotEmpty ? image.assetId : image.file,
 262:     );
 263:     final sizeAttrs = StringBuffer();
 264:     final width = image.showWidth ?? (image.width > 0 ? image.width : null);
 265:     final height = image.showHeight ?? (image.height > 0 ? image.height : null);
 266:     if (width != null) {
 267:       sizeAttrs.write(' width="${_formatDimension(width)}"');
 268:     }
 269:     if (height != null) {
 270:       sizeAttrs.write(' height="${_formatDimension(height)}"');
 271:     }
 272:     if (image.width > 0) {
 273:       sizeAttrs.write(' data-width="${image.width}"');
 274:     }
 275:     if (image.height > 0) {
 276:       sizeAttrs.write(' data-height="${image.height}"');
 277:     }
 278:     final img = '<img src="$src" alt="$alt"$sizeAttrs>';
 279:     if (image.caption.isEmpty) {
 280:       return img;
 281:     }
 282:     return '<figure>$img<figcaption>${_escapeHtml(image.caption)}</figcaption></figure>';
 283:   }
 284: 
 285:   String _encodeFileBlock(FileBlockNode file) {
 286:     final href = _escapeHtml(file.effectiveDownloadUrl);
 287:     final name = _escapeHtml(file.displayName);
 288:     final attrs = StringBuffer(' href="$href" data-wenz-block="file"');
 289:     if (file.assetId.isNotEmpty) {
 290:       attrs.write(' data-asset-id="${_escapeHtml(file.assetId)}"');
 291:     }
 292:     if (file.size > 0) {
 293:       attrs.write(' data-size="${file.size}"');
 294:     }
 295:     if (file.mimeType.isNotEmpty) {
 296:       attrs.write(' data-mime-type="${_escapeHtml(file.mimeType)}"');
 297:     }
 298:     if (file.file.isNotEmpty) {
 299:       attrs.write(' data-file="${_escapeHtml(file.file)}"');
 300:     }
 301:     if (file.uploadStatus != FileUploadStatus.none) {
 302:       attrs.write(' data-upload-status="${file.uploadStatus.name}"');
 303:     }
 304:     if (file.uploadError.isNotEmpty) {
 305:       attrs.write(' data-upload-error="${_escapeHtml(file.uploadError)}"');
 306:     }
 307:     return '<a$attrs>$name</a>';
 308:   }
 309: 
 310:   String _encodeVideoBlock(VideoBlockNode video) {
 311:     final src = _escapeHtml(video.file.isNotEmpty ? video.file : video.assetId);
 312:     final attrs = StringBuffer(' src="$src"');
 313:     if (video.assetId.isNotEmpty) {
 314:       attrs.write(' data-asset-id="${_escapeHtml(video.assetId)}"');
 315:     }
 316:     if (video.file.isNotEmpty) {
 317:       attrs.write(' data-file="${_escapeHtml(video.file)}"');
 318:     }
 319:     return '<video$attrs></video>';
 320:   }
 321: 
 322:   String _encodeBlockEmbed(BlockEmbedNode embed) {
 323:     final attrs = StringBuffer(
 324:       ' data-wenz-block="embed"'
 325:       ' data-embed-type="${_escapeHtml(embed.normalizedEmbedType)}"',
 326:     );
 327:     final encodedData = _tryEncodeEmbedData(embed.data);
 328:     if (encodedData != null) {
 329:       attrs.write(' data-embed-data="${_escapeHtml(encodedData)}"');
 330:     }
 331:     return '<div$attrs>${_escapeHtml(embed.displayText)}</div>';
 332:   }
 333: 
 334:   String? _tryEncodeEmbedData(Map<String, Object?> data) {
 335:     if (data.isEmpty) {
 336:       return null;
 337:     }
 338:     try {
 339:       return jsonEncode(data);
 340:     } on Object {
 341:       return null;
 342:     }
 343:   }
 344: 
 345:   String _encodeCalloutBlock(CalloutBlockNode callout) {
 346:     final variant = callout.normalizedVariant;
 347:     final icon = callout.effectiveIcon;
 348:     final title = callout.effectiveTitle;
 349:     return '<aside class="wenz-callout" data-wenz-block="callout" '
 350:         'data-callout-variant="${_escapeHtml(variant)}" '
 351:         'data-callout-icon="${_escapeHtml(icon)}">'
 352:         '<div data-callout-title>${_escapeHtml(title)}</div>'
 353:         '<div data-callout-body>${_encodeInline(callout.content)}</div>'
 354:         '</aside>';
 355:   }
 356: 
 357:   String _imageAlt(ImageBlockNode image) {
 358:     if (image.altText.isNotEmpty) {
 359:       return image.altText;
 360:     }
 361:     if (image.file.isNotEmpty) {
 362:       return image.file;
 363:     }
 364:     if (image.caption.isNotEmpty) {
 365:       return image.caption;
 366:     }
 367:     return 'image';
 368:   }
 369: 
 370:   String _formatDimension(num value) {
 371:     final asDouble = value.toDouble();
 372:     return asDouble == asDouble.roundToDouble()
 373:         ? value.toInt().toString()
 374:         : value.toString();
 375:   }
 376: 
 377:   String _escapeHtml(String text) {
 378:     return text
 379:         .replaceAll('&', '&amp;')
 380:         .replaceAll('<', '&lt;')
 381:         .replaceAll('>', '&gt;')
 382:         .replaceAll('"', '&quot;');
 383:   }
 384: 
 385:   // ---------------------------------------------------------------------------
 386:   // Import: HTML fragment -> document (via package:html)
 387:   // ---------------------------------------------------------------------------
 388: 
 389:   /// Decodes [source] HTML into a [RichTextDocument]. HTML5's leniency means
 390:   /// any unrecognised / malformed content becomes paragraphs; [decode] does
 391:   /// not throw for content.
 392:   RichTextDocument decode(String source) {
 393:     final fragment = parser.parseFragment(source);
 394:     final blocks = <BlockNode>[];
 395:     var blockSeq = 0;
 396: 
 397:     String newId(String prefix) => 'html-${blockSeq++}-$prefix';
 398: 
 399:     for (final node in fragment.nodes) {
 400:       _decodeNode(node, blocks, newId);
 401:     }
 402: 
 403:     // A fragment with no recognised blocks (e.g. plain text or empty) still
 404:     // yields at least one paragraph so the document is never empty.
 405:     if (blocks.isEmpty) {
 406:       blocks.add(TextBlockNode(
 407:         id: newId('p'),
 408:         type: BlockType.paragraph,
 409:         content: const <InlineNode>[],
 410:       ));
 411:     }
 412:     return RichTextDocument(blocks: blocks);
 413:   }
 414: 
 415:   /// Decodes a single DOM [node] into zero or more blocks appended to
 416:   /// [blocks].
 417:   void _decodeNode(
 418:     dom.Node node,
 419:     List<BlockNode> blocks,
 420:     String Function(String) newId,
 421:   ) {
 422:     if (node is dom.Element) {
 423:       if (_isCalloutElement(node)) {
 424:         blocks.add(_decodeCallout(node, newId));
 425:         return;
 426:       }
 427:       if (_isFileBlockElement(node)) {
 428:         blocks.add(_decodeFileBlock(node, newId));
 429:         return;
 430:       }
 431:       if (_isBlockEmbedElement(node)) {
 432:         blocks.add(_decodeBlockEmbed(node, newId));
 433:         return;
 434:       }
 435:       final tag = node.localName!.toLowerCase();
 436:       switch (tag) {
 437:         case 'h1':
 438:         case 'h2':
 439:         case 'h3':
 440:         case 'h4':
 441:         case 'h5':
 442:         case 'h6':
 443:           final level = int.parse(tag.substring(1));
 444:           blocks.add(TextBlockNode(
 445:             id: newId('h'),
 446:             type: BlockType.heading,
 447:             attributes: BlockAttributes(level: level),
 448:             content: _parseInline(node),
 449:           ));
 450:           return;
 451:         case 'p':
 452:           final inline = _parseInline(node);
 453:           blocks.add(TextBlockNode(
 454:             id: newId('p'),
 455:             type: BlockType.paragraph,
 456:             content: inline,
 457:           ));
 458:           return;
 459:         case 'blockquote':
 460:           // Flatten blockquote children into a single quote block.
 461:           blocks.add(TextBlockNode(
 462:             id: newId('quote'),
 463:             type: BlockType.quote,
 464:             content: _parseInline(node),
 465:           ));
 466:           return;
 467:         case 'ul':
 468:         case 'ol':
 469:           final listType = tag == 'ol' ? 'ordered' : null;
 470:           for (final child in node.children) {
 471:             if (child.localName?.toLowerCase() == 'li') {
 472:               blocks.add(_decodeListItem(child, listType, newId));
 473:             }
 474:           }
 475:           return;
 476:         case 'pre':
 477:           blocks.add(_decodePre(node, newId));
 478:           return;
 479:         case 'table':
 480:           blocks.add(_decodeTable(node, newId('table')));
 481:           return;
 482:         case 'hr':
 483:           blocks.add(DividerBlockNode(id: newId('hr')));
 484:           return;
 485:         case 'figure':
 486:           final img = node.querySelector('img');
 487:           if (img != null) {
 488:             _decodeImageElement(
 489:               img,
 490:               blocks,
 491:               newId,
 492:               caption: node.querySelector('figcaption')?.text.trim() ?? '',
 493:             );
 494:             return;
 495:           }
 496:           for (final child in node.nodes) {
 497:             _decodeNode(child, blocks, newId);
 498:           }
 499:           return;
 500:         case 'img':
 501:           _decodeImageElement(node, blocks, newId);
 502:           return;
 503:         case 'video':
 504:           _decodeVideoElement(node, blocks, newId);
 505:           return;
 506:         case 'br':
 507:           return;
 508:         default:
 509:           // Unknown container (div/span/section/…): recurse into children so a
 510:           // `<div><p>…</p></div>` still yields its paragraph.
 511:           if (node.nodes.isNotEmpty) {
 512:             for (final child in node.nodes) {
 513:               _decodeNode(child, blocks, newId);
 514:             }
 515:           } else if (node.text.trim().isNotEmpty) {
 516:             blocks.add(TextBlockNode(
 517:               id: newId('p'),
 518:               type: BlockType.paragraph,
 519:               content: _parseInline(node),
 520:             ));
 521:           }
 522:           return;
 523:       }
 524:     } else if (node is dom.Text) {
 525:       final text = node.text;
 526:       if (text.trim().isNotEmpty) {
 527:         blocks.add(TextBlockNode(
 528:           id: newId('p'),
 529:           type: BlockType.paragraph,
 530:           content: _parseInlineText(text),
 531:         ));
 532:       }
 533:     }
 534:   }
 535: 
 536:   void _decodeImageElement(
 537:     dom.Element node,
 538:     List<BlockNode> blocks,
 539:     String Function(String) newId, {
 540:     String caption = '',
 541:   }) {
 542:     final src = node.attributes['src'] ?? '';
 543:     if (src.isEmpty) {
 544:       return;
 545:     }
 546:     final alt = node.attributes['alt'] ?? '';
 547:     final resolvedCaption = caption.isNotEmpty
 548:         ? caption
 549:         : (node.attributes['data-caption'] ?? node.attributes['title'] ?? '')
 550:             .trim();
 551:     final naturalWidth = _parseIntAttribute(node.attributes['data-width']);
 552:     final naturalHeight = _parseIntAttribute(node.attributes['data-height']);
 553:     blocks.add(ImageBlockNode(
 554:       id: newId('image'),
 555:       assetId: src,
 556:       file: alt,
 557:       width: naturalWidth,
 558:       height: naturalHeight,
 559:       showWidth: _parseDoubleAttribute(node.attributes['width']),
 560:       showHeight: _parseDoubleAttribute(node.attributes['height']),
 561:       caption: resolvedCaption,
 562:       altText: alt,
 563:     ));
 564:   }
 565: 
 566:   void _decodeVideoElement(
 567:     dom.Element node,
 568:     List<BlockNode> blocks,
 569:     String Function(String) newId,
 570:   ) {
 571:     final sourceElement = node.querySelector('source[src]');
 572:     final src =
 573:         (node.attributes['src'] ?? sourceElement?.attributes['src'] ?? '')
 574:             .trim();
 575:     final rawAssetId = (node.attributes['data-asset-id'] ??
 576:             sourceElement?.attributes['data-asset-id'] ??
 577:             '')
 578:         .trim();
 579:     final rawFile = (node.attributes['data-file'] ??
 580:             sourceElement?.attributes['data-file'] ??
 581:             '')
 582:         .trim();
 583:     if (src.isEmpty && rawAssetId.isEmpty && rawFile.isEmpty) {
 584:       return;
 585:     }
 586:     final assetId = rawAssetId.isNotEmpty ? rawAssetId : src;
 587:     final file = rawFile.isNotEmpty
 588:         ? rawFile
 589:         : rawAssetId.isNotEmpty && src.isNotEmpty && src != rawAssetId
 590:             ? src
 591:             : '';
 592:     blocks.add(VideoBlockNode(
 593:       id: newId('video'),
 594:       assetId: assetId,
 595:       file: file,
 596:     ));
 597:   }
 598: 
 599:   bool _isFileBlockElement(dom.Element node) {
 600:     return node.attributes['data-wenz-block'] == 'file';
 601:   }
 602: 
 603:   bool _isBlockEmbedElement(dom.Element node) {
 604:     return node.attributes['data-wenz-block'] == 'embed';
 605:   }
 606: 
 607:   BlockEmbedNode _decodeBlockEmbed(
 608:     dom.Element node,
 609:     String Function(String) newId,
 610:   ) {
 611:     final embedType = (node.attributes['data-embed-type'] ?? '').trim();
 612:     return BlockEmbedNode(
 613:       id: newId('embed'),
 614:       embedType: embedType.isEmpty ? 'custom' : embedType,
 615:       data: _decodeEmbedData(node.attributes['data-embed-data']),
 616:       fallbackText: node.text.trim(),
 617:     );
 618:   }
 619: 
 620:   Map<String, Object?> _decodeEmbedData(String? source) {
 621:     if (source == null || source.trim().isEmpty) {
 622:       return const <String, Object?>{};
 623:     }
 624:     try {
 625:       final decoded = jsonDecode(source);
 626:       if (decoded is Map) {
 627:         return Map<String, Object?>.from(decoded);
 628:       }
 629:     } on Object {
 630:       return const <String, Object?>{};
 631:     }
 632:     return const <String, Object?>{};
 633:   }
 634: 
 635:   FileBlockNode _decodeFileBlock(
 636:     dom.Element node,
 637:     String Function(String) newId,
 638:   ) {
 639:     final href = (node.attributes['href'] ?? '').trim();
 640:     final assetId = (node.attributes['data-asset-id'] ?? '').trim();
 641:     final file = (node.attributes['data-file'] ?? '').trim();
 642:     final explicitDownloadUrl =
 643:         (node.attributes['data-download-url'] ?? '').trim();
 644:     final downloadUrl = explicitDownloadUrl.isNotEmpty
 645:         ? explicitDownloadUrl
 646:         : href.isNotEmpty && href != assetId && href != file
 647:             ? href
 648:             : '';
 649:     final name = (node.attributes['data-name'] ?? node.text).trim();
 650:     return FileBlockNode(
 651:       id: newId('file'),
 652:       assetId: assetId,
 653:       name: name,
 654:       size: _parseIntAttribute(node.attributes['data-size']),
 655:       mimeType: (node.attributes['data-mime-type'] ?? '').trim(),
 656:       file: file,
 657:       downloadUrl: downloadUrl,
 658:       uploadStatus:
 659:           FileUploadStatus.parse(node.attributes['data-upload-status']),
 660:       uploadError: (node.attributes['data-upload-error'] ?? '').trim(),
 661:     );
 662:   }
 663: 
 664:   bool _isCalloutElement(dom.Element node) {
 665:     final blockType = node.attributes['data-wenz-block'];
 666:     if (blockType == 'callout') {
 667:       return true;
 668:     }
 669:     final classNames = node.attributes['class'] ?? '';
 670:     return classNames.split(RegExp(r'\s+')).contains('wenz-callout') &&
 671:         node.attributes.containsKey('data-callout-variant');
 672:   }
 673: 
 674:   CalloutBlockNode _decodeCallout(
 675:     dom.Element node,
 676:     String Function(String) newId,
 677:   ) {
 678:     final variant = CalloutBlockNode.normalizeVariant(
 679:       node.attributes['data-callout-variant'],
 680:     );
 681:     final titleElement = node.querySelector('[data-callout-title]');
 682:     var title = titleElement?.text.trim() ?? '';
 683:     if (title == CalloutBlockNode.defaultTitleFor(variant)) {
 684:       title = '';
 685:     }
 686:     var icon = (node.attributes['data-callout-icon'] ?? '').trim();
 687:     if (icon == CalloutBlockNode.defaultIconFor(variant)) {
 688:       icon = '';
 689:     }
 690:     final bodyElement = node.querySelector('[data-callout-body]');
 691:     final content = bodyElement == null
 692:         ? _parseCalloutInlineWithoutTitle(node, titleElement)
 693:         : _parseInline(bodyElement);
 694:     return CalloutBlockNode(
 695:       id: newId('callout'),
 696:       variant: variant,
 697:       title: title,
 698:       icon: icon,
 699:       content: content,
 700:     );
 701:   }
 702: 
 703:   List<InlineNode> _parseCalloutInlineWithoutTitle(
 704:     dom.Element node,
 705:     dom.Element? titleElement,
 706:   ) {
 707:     final runs = <InlineNode>[];
 708:     for (final child in node.nodes) {
 709:       if (titleElement != null && identical(child, titleElement)) {
 710:         continue;
 711:       }
 712:       runs.addAll(_parseInlineNode(child, const TextAttributes()));
 713:     }
 714:     return _coalesce(runs);
 715:   }
 716: 
 717:   int _parseIntAttribute(String? value) {
 718:     if (value == null) {
 719:       return 0;
 720:     }
 721:     return int.tryParse(value) ?? double.tryParse(value)?.round() ?? 0;
 722:   }
 723: 
 724:   double? _parseDoubleAttribute(String? value) {
 725:     if (value == null || value.isEmpty) {
 726:       return null;
 727:     }
 728:     return double.tryParse(value);
 729:   }
 730: 
 731:   TextBlockNode _decodeListItem(
 732:     dom.Element li,
 733:     String? listType,
 734:     String Function(String) newId,
 735:   ) {
 736:     // Detect a leading checkbox input for task list items.
 737:     var checked = false;
 738:     var isTask = false;
 739:     dom.Element? checkboxInput;
 740:     for (final child in li.children) {
 741:       if (child.localName?.toLowerCase() == 'input') {
 742:         final type = child.attributes['type'];
 743:         if (type == 'checkbox') {
 744:           isTask = true;
 745:           checked = child.attributes.containsKey('checked');
 746:           checkboxInput = child;
 747:           break;
 748:         }
 749:       }
 750:     }
 751: 
 752:     // Build the inline content, dropping the checkbox input node.
 753:     final inline = <InlineNode>[];
 754:     for (final child in li.nodes) {
 755:       if (child == checkboxInput) {
 756:         continue;
 757:       }
 758:       inline.addAll(_parseInline(child));
 759:     }
 760: 
 761:     final effectiveListType = isTask ? 'task' : listType;
 762:     return TextBlockNode(
 763:       id: newId(isTask ? 'task' : (listType == 'ordered' ? 'oli' : 'li')),
 764:       type: BlockType.listItem,
 765:       attributes: BlockAttributes(
 766:         listType: effectiveListType,
 767:         checked: isTask ? checked : null,
 768:       ),
 769:       content: inline,
 770:     );
 771:   }
 772: 
 773:   BlockNode _decodePre(dom.Element pre, String Function(String) newId) {
 774:     // `<pre><code class="language-dart">…</code></pre>` — language from class.
 775:     var language = '';
 776:     var codeText = pre.text;
 777:     final codeChild = pre.querySelector('code');
 778:     if (codeChild != null) {
 779:       final cls = codeChild.attributes['class'] ?? '';
 780:       final langMatch = RegExp(r'language-(\S+)').firstMatch(cls);
 781:       if (langMatch != null) {
 782:         language = langMatch.group(1)!;
 783:       }
 784:       codeText = codeChild.text;
 785:     }
 786:     // `package:html` decodes entities in `.text`, so the code is already
 787:     // unescaped — emit it verbatim.
 788:     return CodeBlockNode(
 789:       id: newId('code'),
 790:       code: codeText,
 791:       language: language,
 792:     );
 793:   }
 794: 
 795:   BlockNode _decodeTable(dom.Element table, String tableId) {
 796:     final rows = <List<TableCellNode>>[];
 797:     final trList = table.querySelectorAll('tr');
 798:     final activeRowSpans = <int, int>{};
 799:     // If a <thead> exists, its rows are headers.
 800:     final thead = table.querySelector('thead');
 801:     for (var r = 0; r < trList.length; r++) {
 802:       final tr = trList[r];
 803:       final isHeaderRow = thead != null && thead.contains(tr);
 804:       final cells = <TableCellNode>[];
 805:       final cellElements =
 806:           tr.children.where((e) => e.localName == 'th' || e.localName == 'td');
 807:       var c = 0;
 808:       void consumeCoveredCell() {
 809:         cells.add(TableCellNode(id: '$tableId-r$r-c$c', covered: true));
 810:         final remaining = activeRowSpans[c]! - 1;
 811:         if (remaining > 0) {
 812:           activeRowSpans[c] = remaining;
 813:         } else {
 814:           activeRowSpans.remove(c);
 815:         }
 816:         c++;
 817:       }
 818: 
 819:       for (final cell in cellElements) {
 820:         while ((activeRowSpans[c] ?? 0) > 0) {
 821:           consumeCoveredCell();
 822:         }
 823:         final isHeader = isHeaderRow || cell.localName == 'th';
 824:         final rowSpan = _parseTableSpan(cell.attributes['rowspan']);
 825:         final columnSpan = _parseTableSpan(cell.attributes['colspan']);
 826:         cells.add(TableCellNode(
 827:           id: '$tableId-r$r-c$c',
 828:           isHeader: isHeader,
 829:           rowSpan: rowSpan,
 830:           columnSpan: columnSpan,
 831:           blocks: <BlockNode>[
 832:             TextBlockNode(
 833:               id: '$tableId-r$r-c$c-p',
 834:               type: BlockType.paragraph,
 835:               content: _parseInline(cell),
 836:             ),
 837:           ],
 838:         ));
 839:         if (rowSpan > 1) {
 840:           for (var offset = 0; offset < columnSpan; offset++) {
 841:             activeRowSpans[c + offset] = rowSpan - 1;
 842:           }
 843:         }
 844:         for (var offset = 1; offset < columnSpan; offset++) {
 845:           cells.add(TableCellNode(
 846:             id: '$tableId-r$r-c${c + offset}',
 847:             covered: true,
 848:           ));
 849:         }
 850:         c += columnSpan;
 851:       }
 852:       while ((activeRowSpans[c] ?? 0) > 0) {
 853:         consumeCoveredCell();
 854:       }
 855:       rows.add(cells);
 856:     }
 857:     return TableBlockNode(
 858:       id: tableId,
 859:       table: TableModel(rows: rows),
 860:     );
 861:   }
 862: 
 863:   int _parseTableSpan(String? value) {
 864:     final parsed = _parseIntAttribute(value);
 865:     return parsed > 1 ? parsed : 1;
 866:   }
 867: 
 868:   /// Parses the inline content of [node] into a list of [InlineNode]s,
 869:   /// recursing into child elements and merging nested emphasis attributes.
 870:   List<InlineNode> _parseInline(dom.Node node) {
 871:     final runs = <InlineNode>[];
 872:     for (final child in node.nodes) {
 873:       runs.addAll(_parseInlineNode(child, const TextAttributes()));
 874:     }
 875:     return _coalesce(runs);
 876:   }
 877: 
 878:   /// Parses a single DOM node as inline content, carrying inherited
 879:   /// [attributes] for nested emphasis.
 880:   List<InlineNode> _parseInlineNode(
 881:     dom.Node node,
 882:     TextAttributes attributes,
 883:   ) {
 884:     if (node is dom.Text) {
 885:       final text = node.text;
 886:       if (text.isEmpty) {
 887:         return const <InlineNode>[];
 888:       }
 889:       return <InlineNode>[TextRun(text: text, attributes: attributes)];
 890:     }
