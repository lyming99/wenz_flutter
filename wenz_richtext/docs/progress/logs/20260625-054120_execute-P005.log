  12: /// Exports and imports a [RichTextDocument] as an HTML fragment.
  13: ///
  14: /// **Export** (`encode`) maps each block to its HTML element and each inline
  15: /// run to `<strong>` / `<em>` / `<s>` / `<u>` / `<a>` tags, joining blocks with
  16: /// newlines.
  17: ///
  18: /// **Import** (`decode`) uses `package:html` (a pure-Dart HTML5 parser) to turn
  19: /// an HTML fragment into a document. Recognised block tags (`<p>`, `<h1>`–
  20: /// `<h6>`, `<ul>`/`<ol>`/`<li>`, `<blockquote>`, Wenz callout `<aside>`,
  21: /// `<pre>`, `<table>`, `<hr>`, `<img>`) map to their block counterparts;
  22: /// inline tags (`<strong>`/`<b>`, `<em>`/`<i>`, `<s>`/`<del>`/`<strike>`,
  23: /// `<u>`, `<a>`, `<img>`) map to
  24: /// [TextAttributes] with nesting merged. Unrecognised content falls back to a
  25: /// paragraph (HTML5 leniency — `decode` does not throw for content).
  26: ///
  27: /// This is the package's first third-party runtime dependency (`package:html`).
  28: /// See `docs/architecture.md`.
  29: class HtmlCodec {
  30:   const HtmlCodec();
  31: 
  32:   // ---------------------------------------------------------------------------
  33:   // Export: document -> HTML fragment
  34:   // ---------------------------------------------------------------------------
  35: 
  36:   /// Encodes [document] to an HTML fragment string. Each block becomes its
  37:   /// HTML element; inline runs are wrapped in emphasis/anchor tags.
  38:   String encode(RichTextDocument document) {
  39:     final buffer = StringBuffer();
  40:     for (var i = 0; i < document.blocks.length; i++) {
  41:       if (i > 0) {
  42:         buffer.write('\n');
  43:       }
  44:       final rendered = _encodeBlock(document.blocks[i]);
  45:       if (rendered != null) {
  46:         buffer.write(rendered);
  47:       }
  48:     }
  49:     return buffer.toString();
  50:   }
  51: 
  52:   String? _encodeBlock(BlockNode block) {
  53:     switch (block.type) {
  54:       case BlockType.heading:
  55:         final text = block as TextBlockNode;
  56:         final level = (text.attributes.level ?? 1).clamp(1, 6);
  57:         return '<h$level>${_encodeInline(text.content)}</h$level>';
  58:       case BlockType.paragraph:
  59:         final text = block as TextBlockNode;
  60:         if (text.content.isEmpty) {
  61:           return '<p></p>';
  62:         }
  63:         return '<p>${_encodeInline(text.content)}</p>';
  64:       case BlockType.quote:
  65:         final text = block as TextBlockNode;
  66:         return '<blockquote>${_encodeInline(text.content)}</blockquote>';
  67:       case BlockType.listItem:
  68:         return _encodeListItem(block as TextBlockNode);
  69:       case BlockType.code:
  70:         final code = block as CodeBlockNode;
  71:         final langClass = code.language.isNotEmpty
  72:             ? ' class="language-${code.language}"'
  73:             : '';
  74:         final escaped = _escapeHtml(code.code);
  75:         return '<pre><code$langClass>$escaped</code></pre>';
  76:       case BlockType.table:
  77:         return _encodeTable(block as TableBlockNode);
  78:       case BlockType.image:
  79:         final image = block as ImageBlockNode;
  80:         return _encodeImageBlock(image);
  81:       case BlockType.video:
  82:         final video = block as VideoBlockNode;
  83:         return _encodeVideoBlock(video);
  84:       case BlockType.embed:
  85:         final embed = block as BlockEmbedNode;
  86:         return _encodeBlockEmbed(embed);
  87:       case BlockType.file:
  88:         final file = block as FileBlockNode;
  89:         return _encodeFileBlock(file);
  90:       case BlockType.divider:
  91:         return '<hr>';
  92:       case BlockType.callout:
  93:         final callout = block as CalloutBlockNode;
  94:         return _encodeCalloutBlock(callout);
  95:     }
  96:   }
  97: 
  98:   String _encodeListItem(TextBlockNode block) {
  99:     final attrs = block.attributes;
 100:     final body = _encodeInline(block.content);
 101:     if (attrs.listType == 'task') {
 102:       final checked = attrs.checked == true ? ' checked' : '';
 103:       return '<ul><li><input type="checkbox"$checked disabled> $body</li></ul>';
 104:     }
 105:     if (attrs.listType == 'ordered') {
 106:       return '<ol><li>$body</li></ol>';
 107:     }
 108:     return '<ul><li>$body</li></ul>';
 109:   }
 110: 
 111:   String _encodeTable(TableBlockNode block) {
 112:     final table = block.table;
 113:     if (table.rows.isEmpty) {
 114:       return '<table></table>';
 115:     }
 116:     final buffer = StringBuffer('<table>');
 117:     for (var r = 0; r < table.rows.length; r++) {
 118:       final row = table.rows[r];
 119:       buffer.write('<tr>');
 120:       for (final cell in row) {
 121:         if (cell.covered) {
 122:           continue;
 123:         }
 124:         final tag = cell.isHeader ? 'th' : 'td';
 125:         final spanAttrs = StringBuffer();
 126:         if (cell.rowSpan > 1) {
 127:           spanAttrs.write(' rowspan="${cell.rowSpan}"');
 128:         }
 129:         if (cell.columnSpan > 1) {
 130:           spanAttrs.write(' colspan="${cell.columnSpan}"');
 131:         }
 132:         buffer.write('<$tag$spanAttrs>');
 133:         for (final innerBlock in cell.blocks) {
 134:           if (innerBlock is TextBlockNode) {
 135:             buffer.write(_encodeInline(innerBlock.content));
 136:           } else {
 137:             buffer.write(_escapeHtml(innerBlock.plainText));
 138:           }
 139:         }
 140:         buffer.write('</$tag>');
 141:       }
 142:       buffer.write('</tr>');
 143:     }
 144:     buffer.write('</table>');
 145:     return buffer.toString();
 146:   }
