  80:         return _encodeImageBlock(image);
  81:       case BlockType.video:
  82:         final video = block as VideoBlockNode;
  83:         return _encodeVideoBlock(video);
  84:       case BlockType.embed:
  85:         final embed = block as BlockEmbedNode;
  86:         return _encodeBlockEmbed(embed);
  87:       case BlockType.file:
  88:         final file = block as FileBlockNode;
  89:         return _encodeFileBlock(file);
  90:       case BlockType.divider:
  91:         return '<hr>';
  92:       case BlockType.callout:
  93:         final callout = block as CalloutBlockNode;
  94:         return _encodeCalloutBlock(callout);
  95:     }
  96:   }
