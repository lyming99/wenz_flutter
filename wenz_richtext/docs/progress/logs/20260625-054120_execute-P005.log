  98:   String _encodeListItem(TextBlockNode block) {
  99:     final attrs = block.attributes;
 100:     final body = _encodeInline(block.content);
 101:     if (attrs.listType == 'task') {
 102:       final checked = attrs.checked == true ? ' checked' : '';
 103:       return '<ul><li><input type="checkbox"$checked disabled> $body</li></ul>';
 104:     }
 105:     if (attrs.listType == 'ordered') {
 106:       return '<ol><li>$body</li></ol>';
 107:     }
 108:     return '<ul><li>$body</li></ul>';
 109:   }
