 209:   num? _embedDimension(Object? value) {
 210:     if (value is num && value > 0) {
 211:       return value;
 212:     }
 213:     if (value is String) {
 214:       final parsed = double.tryParse(value);
 215:       if (parsed != null && parsed > 0) {
 216:         return parsed;
 217:       }
 218:     }
 219:     return null;
 220:   }
