  18:   }
  19: 
  20:   /// Decodes [source] into a [RichTextDocument].
  21:   ///
  22:   /// Always throws a [DocumentDecodeException] on failure (malformed JSON,
  23:   /// wrong root type, a gap in the migration chain, or an invalid block
  24:   /// shape); the originating error is preserved on [DocumentDecodeException.raw].
  25:   /// Use `WenzRichTextController.tryLoadJson` for a no-throw entry point.
  26:   RichTextDocument decode(String source) {
  27:     Object? decoded;
  28:     try {
  29:       decoded = jsonDecode(source);
  30:     } on FormatException catch (error) {
  31:       throw DocumentDecodeException(
  32:         'Source is not valid JSON.',
  33:         raw: error,
  34:       );
  35:     }
  36:     if (decoded is! Map) {
  37:       throw const DocumentDecodeException(
  38:         'Rich text JSON must be an object.',
  39:       );
  40:     }
  41:     var json = Map<String, Object?>.from(decoded);
  42:     final registry = migrations;
  43:     if (registry != null) {
  44:       try {
  45:         json = registry.migrateToCurrent(json);
  46:       } on Object catch (error) {
  47:         throw DocumentDecodeException(
  48:           'Schema migration failed: $error',
  49:           raw: error,
  50:         );
  51:       }
  52:     }
  53:     try {
  54:       return RichTextDocument.fromJson(json);
  55:     } on DocumentDecodeException {
  56:       rethrow;
  57:     } on Object catch (error) {
  58:       throw DocumentDecodeException(
  59:         'Failed to inflate document from JSON.',
  60:         raw: error,
  61:       );
  62:     }
  63:   }
