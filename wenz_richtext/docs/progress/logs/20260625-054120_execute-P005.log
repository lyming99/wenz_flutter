 489:   /// Parses inline markup (`**bold**`, `*italic*`, `~~strike~~`, `<u>u</u>`,
 490:   /// `[text](url)`, `![alt](url)`) into a list of [InlineNode]s. Un-escapes
 491:   /// backslash-escaped punctuation. Anything unmatched is plain text.
 492:   List<InlineNode> _parseInline(String text) {
 493:     if (text.isEmpty) {
 494:       return const <InlineNode>[];
 495:     }
 496:     final runs = <InlineNode>[];
 497:     final buffer = StringBuffer();
 498: 
 499:     void flush({TextAttributes? attrs}) {
 500:       if (buffer.isNotEmpty) {
 501:         runs.add(TextRun(
 502:           text: buffer.toString(),
 503:           attributes: attrs ?? const TextAttributes(),
 504:         ));
 505:         buffer.clear();
 506:       }
 507:     }
 508: 
 509:     var pos = 0;
 510:     while (pos < text.length) {
 511:       // Escaped character: `\x` → literal `x`.
 512:       if (text[pos] == '\\' && pos + 1 < text.length) {
 513:         buffer.write(text[pos + 1]);
 514:         pos += 2;
 515:         continue;
 516:       }
 517: 
 518:       // Image: ![alt](url)
 519:       final imageMatch = _inlineImageRegex.matchAsPrefix(text, pos);
 520:       if (imageMatch != null) {
 521:         final alt = _unescapeImageToken(imageMatch.group(1) ?? '');
 522:         final caption = _unescapeImageToken(imageMatch.group(3) ?? '');
 523:         flush();
 524:         runs.add(InlineEmbed(
 525:           embedType: 'image',
 526:           data: <String, Object?>{
 527:             'assetId': imageMatch.group(2),
 528:             'text': alt,
 529:             'altText': alt,
 530:             if (caption.isNotEmpty) 'caption': caption,
 531:           },
 532:         ));
 533:         pos = imageMatch.end;
 534:         continue;
 535:       }
 536: 
 537:       // Link: [text](url)
 538:       final linkMatch = _inlineLinkRegex.matchAsPrefix(text, pos);
 539:       if (linkMatch != null) {
 540:         final label = linkMatch.group(1) ?? '';
 541:         final url = linkMatch.group(2) ?? '';
 542:         // Recurse to parse nested emphasis inside the label.
 543:         final inner = _parseInline(label);
 544:         if (inner.isEmpty) {
 545:           buffer.write(label);
 546:         } else {
 547:           flush();
 548:           for (final node in inner) {
 549:             if (node is TextRun) {
 550:               runs.add(TextRun(
 551:                 text: node.text,
 552:                 attributes: node.attributes.copyWith(url: url),
 553:               ));
 554:             } else {
 555:               runs.add(node);
 556:             }
 557:           }
 558:         }
 559:         pos = linkMatch.end;
 560:         continue;
 561:       }
 562: 
 563:       // Bold: **text**
 564:       final boldMatch = _boldRegex.matchAsPrefix(text, pos);
 565:       if (boldMatch != null) {
 566:         flush();
 567:         final inner = _parseInline(boldMatch.group(1)!);
 568:         for (final node in inner) {
 569:           if (node is TextRun) {
 570:             runs.add(TextRun(
 571:               text: node.text,
 572:               attributes: node.attributes.copyWith(bold: true),
 573:             ));
 574:           } else {
 575:             runs.add(node);
 576:           }
 577:         }
 578:         pos = boldMatch.end;
 579:         continue;
 580:       }
 581: 
 582:       // Italic: *text*
 583:       final italicMatch = _italicRegex.matchAsPrefix(text, pos);
 584:       if (italicMatch != null) {
 585:         flush();
 586:         final inner = _parseInline(italicMatch.group(1)!);
 587:         for (final node in inner) {
 588:           if (node is TextRun) {
 589:             runs.add(TextRun(
 590:               text: node.text,
 591:               attributes: node.attributes.copyWith(italic: true),
 592:             ));
 593:           } else {
 594:             runs.add(node);
 595:           }
 596:         }
 597:         pos = italicMatch.end;
 598:         continue;
 599:       }
 600: 
 601:       // Strikethrough: ~~text~~
 602:       final strikeMatch = _strikeRegex.matchAsPrefix(text, pos);
 603:       if (strikeMatch != null) {
 604:         flush();
 605:         final inner = _parseInline(strikeMatch.group(1)!);
 606:         for (final node in inner) {
 607:           if (node is TextRun) {
 608:             runs.add(TextRun(
 609:               text: node.text,
 610:               attributes: node.attributes.copyWith(lineThrough: true),
 611:             ));
 612:           } else {
 613:             runs.add(node);
 614:           }
 615:         }
 616:         pos = strikeMatch.end;
 617:         continue;
 618:       }
 619: 
 620:       // Underline: <u>text</u>
 621:       final underlineMatch = _underlineRegex.matchAsPrefix(text, pos);
 622:       if (underlineMatch != null) {
 623:         flush();
 624:         final inner = _parseInline(underlineMatch.group(1)!);
 625:         for (final node in inner) {
 626:           if (node is TextRun) {
 627:             runs.add(TextRun(
 628:               text: node.text,
 629:               attributes: node.attributes.copyWith(underline: true),
 630:             ));
 631:           } else {
 632:             runs.add(node);
 633:           }
 634:         }
 635:         pos = underlineMatch.end;
 636:         continue;
 637:       }
 638: 
 639:       buffer.write(text[pos]);
 640:       pos++;
 641:     }
 642:     flush();
 643:     return runs;
 644:   }
