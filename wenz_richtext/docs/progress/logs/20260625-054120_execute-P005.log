 646:   bool _looksLikeTableRow(String line) {
 647:     final trimmed = line.trim();
 648:     if (trimmed.isEmpty) {
 649:       return false;
 650:     }
 651:     return trimmed.contains('|') && !trimmed.startsWith('#');
 652:   }
 653: 
 654:   bool _looksLikeTableSeparator(String line) {
 655:     final trimmed = line.trim();
 656:     if (trimmed.isEmpty) {
 657:       return false;
 658:     }
 659:     // A separator row is made of `|`, `-`, `:`, and spaces only, and must
 660:     // contain at least one dash.
 661:     if (!trimmed.contains('-')) {
 662:       return false;
 663:     }
 664:     return RegExp(r'^[\s\|\:\-]+$').hasMatch(trimmed);
 665:   }
