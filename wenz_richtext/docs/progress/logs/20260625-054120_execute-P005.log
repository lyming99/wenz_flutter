 566:   void _decodeVideoElement(
 567:     dom.Element node,
 568:     List<BlockNode> blocks,
 569:     String Function(String) newId,
 570:   ) {
 571:     final sourceElement = node.querySelector('source[src]');
 572:     final src =
 573:         (node.attributes['src'] ?? sourceElement?.attributes['src'] ?? '')
 574:             .trim();
 575:     final rawAssetId = (node.attributes['data-asset-id'] ??
 576:             sourceElement?.attributes['data-asset-id'] ??
 577:             '')
 578:         .trim();
 579:     final rawFile = (node.attributes['data-file'] ??
 580:             sourceElement?.attributes['data-file'] ??
 581:             '')
 582:         .trim();
 583:     if (src.isEmpty && rawAssetId.isEmpty && rawFile.isEmpty) {
 584:       return;
 585:     }
 586:     final assetId = rawAssetId.isNotEmpty ? rawAssetId : src;
 587:     final file = rawFile.isNotEmpty
 588:         ? rawFile
 589:         : rawAssetId.isNotEmpty && src.isNotEmpty && src != rawAssetId
 590:             ? src
 591:             : '';
 592:     blocks.add(VideoBlockNode(
 593:       id: newId('video'),
 594:       assetId: assetId,
 595:       file: file,
 596:     ));
 597:   }
