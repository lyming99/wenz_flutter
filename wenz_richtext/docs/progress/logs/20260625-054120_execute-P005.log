+  List<String> _splitEscaped(String text, String separator) {
+    final parts = <String>[];
+    final buffer = StringBuffer();
+    var escaped = false;
+    for (var i = 0; i < text.length; i++) {
+      final char = text[i];
+      if (escaped) {
+        buffer.write('\\');
+        buffer.write(char);
+        escaped = false;
+        continue;
+      }
+      if (char == '\\') {
+        escaped = true;
+        continue;
+      }
+      if (char == separator) {
+        parts.add(buffer.toString());
+        buffer.clear();
+        continue;
+      }
+      buffer.write(char);
+    }
+    if (escaped) {
+      buffer.write('\\');
+    }
+    parts.add(buffer.toString());
+    return parts;
+  }
