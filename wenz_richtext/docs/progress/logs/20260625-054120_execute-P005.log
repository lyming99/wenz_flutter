 102:   String _imageLabel(ImageBlockNode image) {
 103:     if (image.caption.isNotEmpty) {
 104:       return image.caption;
 105:     }
 106:     if (image.altText.isNotEmpty) {
 107:       return image.altText;
 108:     }
 109:     if (image.file.isNotEmpty) {
 110:       return image.file;
 111:     }
 112:     return image.assetId;
 113:   }
 114: }

