 607:   BlockEmbedNode _decodeBlockEmbed(
 608:     dom.Element node,
 609:     String Function(String) newId,
 610:   ) {
 611:     final embedType = (node.attributes['data-embed-type'] ?? '').trim();
 612:     return BlockEmbedNode(
 613:       id: newId('embed'),
 614:       embedType: embedType.isEmpty ? 'custom' : embedType,
 615:       data: _decodeEmbedData(node.attributes['data-embed-data']),
 616:       fallbackText: node.text.trim(),
 617:     );
