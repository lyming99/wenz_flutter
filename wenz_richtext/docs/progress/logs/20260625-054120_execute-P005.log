 667:   List<String> _splitTableRow(String line) {
 668:     var trimmed = line.trim();
 669:     // Strip a single leading/trailing pipe if present.
 670:     if (trimmed.startsWith('|')) {
 671:       trimmed = trimmed.substring(1);
 672:     }
 673:     if (trimmed.endsWith('|')) {
 674:       trimmed = trimmed.substring(0, trimmed.length - 1);
 675:     }
 676:     return _splitOnUnescapedPipe(trimmed)
 677:         .map((cell) => cell.trim().replaceAll('\\|', '|'))
 678:         .toList();
 679:   }
