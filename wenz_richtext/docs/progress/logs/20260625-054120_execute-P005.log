 111:   String _encodeTable(TableBlockNode block) {
 112:     final table = block.table;
 113:     if (table.rows.isEmpty) {
 114:       return '<table></table>';
 115:     }
 116:     final buffer = StringBuffer('<table>');
 117:     for (var r = 0; r < table.rows.length; r++) {
 118:       final row = table.rows[r];
 119:       buffer.write('<tr>');
 120:       for (final cell in row) {
 121:         if (cell.covered) {
 122:           continue;
 123:         }
 124:         final tag = cell.isHeader ? 'th' : 'td';
 125:         final spanAttrs = StringBuffer();
 126:         if (cell.rowSpan > 1) {
 127:           spanAttrs.write(' rowspan="${cell.rowSpan}"');
 128:         }
 129:         if (cell.columnSpan > 1) {
 130:           spanAttrs.write(' colspan="${cell.columnSpan}"');
 131:         }
 132:         buffer.write('<$tag$spanAttrs>');
 133:         for (final innerBlock in cell.blocks) {
 134:           if (innerBlock is TextBlockNode) {
 135:             buffer.write(_encodeInline(innerBlock.content));
 136:           } else {
 137:             buffer.write(_escapeHtml(innerBlock.plainText));
 138:           }
 139:         }
 140:         buffer.write('</$tag>');
 141:       }
 142:       buffer.write('</tr>');
 143:     }
 144:     buffer.write('</table>');
 145:     return buffer.toString();
 146:   }
