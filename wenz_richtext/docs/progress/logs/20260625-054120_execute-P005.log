  12: class LegacyWenJsonCodec {
  13:   const LegacyWenJsonCodec();
  14: 
  15:   /// Decodes legacy `wenz_editor` JSON (a block list, or `{"blocks": [...]}`)
  16:   /// into a [RichTextDocument].
  17:   ///
  18:   /// Always throws a [DocumentDecodeException] on failure; the originating
  19:   /// error is preserved on [DocumentDecodeException.raw]. Non-`Map` entries
  20:   /// inside the block list are skipped (with a debug-mode warning) rather
  21:   /// than aborting the whole decode.
  22:   RichTextDocument decode(String source) {
  23:     Object? decoded;
  24:     try {
  25:       decoded = jsonDecode(source);
  26:     } on FormatException catch (error) {
  27:       throw DocumentDecodeException(
  28:         'Source is not valid JSON.',
  29:         raw: error,
  30:       );
  31:     }
  32:     try {
  33:       if (decoded is List) {
  34:         return RichTextDocument(blocks: _decodeBlocks(decoded));
  35:       }
  36:       if (decoded is Map && decoded['blocks'] is List) {
  37:         return RichTextDocument(
  38:           blocks: _decodeBlocks(decoded['blocks'] as List),
  39:         );
  40:       }
  41:       throw const DocumentDecodeException(
  42:         'Legacy Wen JSON must be a block list.',
  43:       );
  44:     } on DocumentDecodeException {
  45:       rethrow;
  46:     } on Object catch (error) {
  47:       throw DocumentDecodeException(
  48:         'Failed to inflate legacy document.',
  49:         raw: error,
  50:       );
  51:     }
  52:   }
  53: 
  54:   List<BlockNode> _decodeBlocks(List<Object?> values) {
  55:     final blocks = <BlockNode>[];
  56:     for (var i = 0; i < values.length; i++) {
  57:       final entry = values[i];
  58:       if (entry is Map) {
  59:         blocks.add(_decodeElement(Map<String, Object?>.from(entry), 'legacy-$i'));
  60:       } else if (kDebugMode) {
  61:         debugPrint(
  62:           'LegacyWenJsonCodec: skipping non-object block at index $i '
  63:           '(${entry.runtimeType}).',
  64:         );
  65:       }
  66:     }
  67:     return blocks;
  68:   }
  69: 
  70:   BlockNode _decodeElement(Map<String, Object?> json, String id) {
  71:     final legacyType = json['type'] as String? ?? 'text';
  72:     switch (legacyType) {
  73:       case 'title':
  74:         return TextBlockNode(
  75:           id: id,
  76:           type: BlockType.heading,
  77:           attributes: _blockAttributes(json, fallbackLevel: 1),
  78:           content: _textContent(json),
  79:         );
  80:       case 'quote':
  81:         return TextBlockNode(
  82:           id: id,
  83:           type: BlockType.quote,
  84:           attributes: _blockAttributes(json),
  85:           content: _textContent(json),
  86:         );
  87:       case 'text':
  88:         final attrs = _blockAttributes(json);
  89:         return TextBlockNode(
  90:           id: id,
  91:           type:
  92:               attrs.listType == null ? BlockType.paragraph : BlockType.listItem,
  93:           attributes: attrs,
  94:           content: _textContent(json),
  95:         );
  96:       case 'code':
  97:         return CodeBlockNode(
  98:           id: id,
  99:           code: json['code'] as String? ?? '',
 100:           language: json['language'] as String? ?? '',
 101:           attributes: _blockAttributes(json),
 102:         );
 103:       case 'image':
 104:         return ImageBlockNode(
 105:           id: id,
 106:           assetId: json['id'] as String? ?? '',
 107:           file: json['file'] as String? ?? '',
 108:           width: _asInt(json['width']),
 109:           height: _asInt(json['height']),
 110:           showWidth: _asDouble(json['showWidth']),
 111:           showHeight: _asDouble(json['showHeight']),
 112:           attributes: _blockAttributes(json),
 113:         );
 114:       case 'table':
 115:         return TableBlockNode(
 116:           id: id,
 117:           table: _tableModel(json, id),
 118:           attributes: _blockAttributes(json),
 119:         );
 120:       case 'line':
 121:         return DividerBlockNode(id: id, attributes: _blockAttributes(json));
 122:       case 'video':
 123:         return VideoBlockNode(
 124:           id: id,
 125:           assetId: json['id'] as String? ?? '',
 126:           file: json['file'] as String? ?? '',
 127:           attributes: _blockAttributes(json),
 128:         );
 129:       default:
 130:         return TextBlockNode(
 131:           id: id,
 132:           type: BlockType.paragraph,
 133:           attributes: _blockAttributes(json),
 134:           content: _textContent(json),
 135:         );
 136:     }
 137:   }
 138: 
 139:   BlockAttributes _blockAttributes(
 140:     Map<String, Object?> json, {
 141:     int? fallbackLevel,
 142:   }) {
 143:     final itemType = json['itemType'] as String?;
 144:     return BlockAttributes(
 145:       level: _asNullableInt(json['level']) ?? fallbackLevel,
 146:       indent: _asNullableInt(json['indent']),
 147:       alignment: json['alignment'] as String?,
 148:       listType: _isListType(itemType) ? itemType : null,
 149:       checked: json['checked'] as bool?,
 150:       childNote: json['childNote'] as String?,
 151:     );
 152:   }
 153: 
 154:   List<InlineNode> _textContent(Map<String, Object?> json) {
 155:     final parentAttrs = _textAttributes(json);
 156:     final result = <InlineNode>[];
 157:     final text = json['text'] as String?;
 158:     if (text != null && text.isNotEmpty) {
 159:       result.add(TextRun(text: text, attributes: parentAttrs));
 160:     }
 161: 
 162:     final children = json['children'];
 163:     if (children is List) {
 164:       for (final child in children.whereType<Map>()) {
 165:         result.add(_inlineNode(Map<String, Object?>.from(child), parentAttrs));
 166:       }
 167:     }
 168: 
 169:     return result;
 170:   }
 171: 
 172:   InlineNode _inlineNode(
 173:     Map<String, Object?> json,
 174:     TextAttributes parentAttrs,
 175:   ) {
 176:     final attrs = _textAttributes(json).inheritFrom(parentAttrs);
 177:     final itemType = json['itemType'] as String?;
 178:     if (itemType == 'formula') {
 179:       return InlineEmbed(
 180:         embedType: 'formula',
 181:         data: <String, Object?>{'text': json['text'] as String? ?? ''},
 182:         attributes: attrs,
 183:       );
 184:     }
 185:     if (itemType == 'image') {
 186:       return InlineEmbed(
 187:         embedType: 'image',
 188:         data: <String, Object?>{'id': json['id'], 'text': json['text']},
 189:         attributes: attrs,
 190:       );
 191:     }
 192:     return TextRun(text: json['text'] as String? ?? '', attributes: attrs);
 193:   }
 194: 
 195:   TextAttributes _textAttributes(Map<String, Object?> json) {
 196:     return TextAttributes(
 197:       color: _asNullableInt(json['color']),
 198:       background: _asNullableInt(json['background']),
 199:       bold: json['bold'] as bool?,
 200:       italic: json['italic'] as bool?,
 201:       fontSize: _asDouble(json['fontSize']),
 202:       underline: json['underline'] as bool?,
 203:       lineThrough: json['lineThrough'] as bool?,
 204:       remark: json['remark'] as bool?,
 205:       url: json['url'] as String?,
 206:     );
 207:   }
 208: 
 209:   TableModel _tableModel(Map<String, Object?> json, String id) {
 210:     final alignments = json['alignments'];
 211:     final rows = json['rows'];
 212:     return TableModel(
 213:       columnAlignments: alignments is Map
 214:           ? <int, String>{
 215:               for (final entry in alignments.entries)
 216:                 if (_asNullableInt(entry.key) != null)
 217:                   _asNullableInt(entry.key)!: entry.value as String,
 218:             }
 219:           : const <int, String>{},
 220:       rows: rows is List
 221:           ? <List<TableCellNode>>[
 222:               for (var rowIndex = 0; rowIndex < rows.length; rowIndex++)
 223:                 if (rows[rowIndex] is List)
 224:                   <TableCellNode>[
 225:                     for (var colIndex = 0;
 226:                         colIndex < (rows[rowIndex] as List).length;
 227:                         colIndex++)
 228:                       if ((rows[rowIndex] as List)[colIndex] is Map)
 229:                         _tableCell(
 230:                           Map<String, Object?>.from(
 231:                             (rows[rowIndex] as List)[colIndex] as Map,
 232:                           ),
 233:                           '$id-r$rowIndex-c$colIndex',
 234:                         ),
 235:                   ],
 236:             ]
 237:           : const <List<TableCellNode>>[],
 238:     );
 239:   }
 240: 
 241:   TableCellNode _tableCell(Map<String, Object?> json, String id) {
 242:     return TableCellNode(id: id, blocks: <BlockNode>[_decodeElement(json, id)]);
 243:   }
 244: 
 245:   bool _isListType(String? itemType) {
 246:     return itemType == 'li' || itemType == 'oli' || itemType == 'check';
 247:   }
 248: }
 249: 
 250: int _asInt(Object? value) {
 251:   if (value is int) {
 252:     return value;
 253:   }
 254:   if (value is num) {
 255:     return value.toInt();
 256:   }
 257:   return 0;
 258: }
 259: 
 260: int? _asNullableInt(Object? value) {
 261:   if (value is int) {
 262:     return value;
 263:   }
 264:   if (value is num) {
 265:     return value.toInt();
 266:   }
 267:   if (value is String) {
 268:     return int.tryParse(value);
 269:   }
 270:   return null;
 271: }
 272: 
 273: double? _asDouble(Object? value) {
 274:   if (value is double) {
 275:     return value;
 276:   }
 277:   if (value is num) {
 278:     return value.toDouble();
 279:   }
 280:   return null;
 281: }

===== lib/src/codecs/markdown_codec.dart =====
   1: import '../core/model/attributes.dart';
   2: import '../core/model/block_node.dart';
   3: import '../core/model/inline_node.dart';
   4: import '../core/model/rich_text_document.dart';
   5: import '../core/model/table_model.dart';
   6: 
   7: /// Exports and imports a [RichTextDocument] as GitHub-Flavored Markdown.
   8: ///
   9: /// **Export** (`encode`) maps every block to its Markdown representation and
  10: /// every inline run to `**bold**` / `*italic*` / `~~strike~~` / `<u>underline</u>`
  11: /// / `[text](url)` syntax, joining blocks with blank lines.
  12: ///
  13: /// **Import** (`decode`) runs a line-oriented state machine that recognises:
  14: /// ATX headings (`#{1,6}`), unordered (`- `/`* `), ordered (`1. `), and task
  15: /// (`- [x] `/`- [ ]`) lists, blockquotes (`> `), fenced code blocks
  16: /// (``` ``` ```), GFM pipe tables, thematic breaks (`---`/`***`), images
  17: /// (`![alt](url)`), Wenz video placeholders (`![video](url)`), and inline
  18: /// `**bold**`/`*italic*`/`~~strike~~`/`<u>u</u>`/`[text](url)`. Anything
  19: /// unrecognised falls back to a paragraph (Markdown's usual leniency —
  20: /// [decode] never throws for content).
  21: ///
  22: /// Coverage is aligned with the `gpt_markdown` syntax matrix for the block/
  23: /// inline kinds this package models; LaTeX / radio buttons have no model
  24: /// counterpart and are left as plain text. Underline uses `<u>` because GFM
  25: /// has no native underline syntax.
  26: class MarkdownCodec {
  27:   const MarkdownCodec();
  28: 
  29:   // ---------------------------------------------------------------------------
  30:   // Export: document -> Markdown
  31:   // ---------------------------------------------------------------------------
  32: 
  33:   /// Encodes [document] to a Markdown string. Blocks are separated by a blank
  34:   /// line; media blocks without a Markdown form emit a best-effort placeholder.
  35:   String encode(RichTextDocument document) {
  36:     final sections = <String>[];
  37:     for (final block in document.blocks) {
  38:       final rendered = _encodeBlock(block);
  39:       if (rendered != null) {
  40:         sections.add(rendered);
  41:       }
  42:     }
  43:     return sections.join('\n\n');
  44:   }
  45: 
  46:   String? _encodeBlock(BlockNode block) {
  47:     switch (block.type) {
  48:       case BlockType.heading:
  49:         final text = block as TextBlockNode;
  50:         final level = text.attributes.level ?? 1;
  51:         final hashes = '#' * level.clamp(1, 6);
  52:         return '$hashes ${_encodeInline(text.content)}';
  53:       case BlockType.paragraph:
  54:         final text = block as TextBlockNode;
  55:         if (text.content.isEmpty) {
  56:           return null;
  57:         }
  58:         return _encodeInline(text.content);
  59:       case BlockType.quote:
  60:         final text = block as TextBlockNode;
  61:         final body = _encodeInline(text.content);
  62:         // Prefix every line with `> ` so multi-line quotes stay valid.
  63:         return body.split('\n').map((line) => '> $line').join('\n');
  64:       case BlockType.listItem:
  65:         return _encodeListItem(block as TextBlockNode);
  66:       case BlockType.code:
  67:         final code = block as CodeBlockNode;
  68:         final fence = '```${code.language}';
  69:         return '$fence\n${code.code}\n```';
  70:       case BlockType.table:
  71:         return _encodeTable(block as TableBlockNode);
  72:       case BlockType.image:
  73:         final image = block as ImageBlockNode;
  74:         final alt = _imageAlt(image);
  75:         final src = image.assetId.isNotEmpty ? image.assetId : image.file;
  76:         final title = image.caption.isEmpty
  77:             ? ''
  78:             : ' "${_escapeImageTitle(image.caption)}"';
  79:         return '![${_escapeImageAlt(alt)}]($src$title)';
  80:       case BlockType.video:
  81:         final video = block as VideoBlockNode;
  82:         final src = video.file.isNotEmpty ? video.file : video.assetId;
  83:         return '![video]($src)';
  84:       case BlockType.embed:
  85:         final embed = block as BlockEmbedNode;
  86:         return '[${_escapeInline(embed.normalizedEmbedType)} embed: '
  87:             '${_escapeInline(embed.displayText)}]';
  88:       case BlockType.file:
  89:         final file = block as FileBlockNode;
  90:         return '[${file.displayName}](${file.effectiveDownloadUrl})';
  91:       case BlockType.divider:
  92:         return '---';
  93:       case BlockType.callout:
  94:         // Callouts degrade to blockquotes in plain Markdown. The visible icon,
  95:         // title and body are preserved, but the structured variant is not.
  96:         final callout = block as CalloutBlockNode;
  97:         final title = '${callout.effectiveIcon} ${callout.effectiveTitle}';
  98:         final lines = <String>['**${_escapeInline(title)}**'];
  99:         final body = _encodeInline(callout.content);
 100:         if (body.isNotEmpty) {
 101:           lines.addAll(body.split('\n'));
 102:         }
 103:         return lines.map((line) => '> $line').join('\n');
 104:     }
 105:   }
 106: 
 107:   String _encodeListItem(TextBlockNode block) {
 108:     final indent = block.attributes.indent ?? 0;
 109:     final pad = '  ' * indent;
 110:     final attrs = block.attributes;
 111:     final body = _encodeInline(block.content);
 112:     if (attrs.listType == 'ordered') {
 113:       return '${pad}1. $body';
 114:     }
 115:     if (attrs.listType == 'task') {
 116:       final box = attrs.checked == true ? '[x]' : '[ ]';
 117:       return '$pad- $box $body';
 118:     }
 119:     return '$pad- $body';
 120:   }
 121: 
 122:   String _encodeTable(TableBlockNode block) {
 123:     final table = block.table;
 124:     if (table.rows.isEmpty) {
 125:       return '';
 126:     }
 127:     final columnCount = table.columnCount;
 128:     final lines = <String>[];
 129: 
 130:     String cellText(TableCellNode cell) {
 131:       final text = cell.plainText;
 132:       // Cells are inline-only in GFM; escape pipes so they don't break columns.
 133:       return text.replaceAll('|', '\\|');
 134:     }
 135: 
 136:     String alignmentMarker(int column) {
 137:       final align = table.columnAlignments[column];
 138:       if (align == 'center') {
 139:         return ':---:';
 140:       }
 141:       if (align == 'right') {
 142:         return '---:';
 143:       }
 144:       if (align == 'left') {
 145:         return ':---';
 146:       }
 147:       return '---';
 148:     }
 149: 
 150:     // Header row (first row) + separator.
 151:     final header = table.rows.first;
 152:     lines.add(List.generate(columnCount, (c) {
 153:       final cell = c < header.length ? header[c] : null;
 154:       return cell == null || cell.covered ? '' : cellText(cell);
 155:     }).join(' | '));
 156:     lines.add(List.generate(columnCount, alignmentMarker).join(' | '));
 157: 
 158:     // Body rows (skip the first).
 159:     for (var r = 1; r < table.rows.length; r++) {
 160:       final row = table.rows[r];
 161:       lines.add(List.generate(columnCount, (c) {
 162:         final cell = c < row.length ? row[c] : null;
 163:         return cell == null || cell.covered ? '' : cellText(cell);
 164:       }).join(' | '));
 165:     }
 166:     return lines.join('\n');
 167:   }
 168: 
 169:   /// Encodes a list of inline nodes to a Markdown string, applying each run's
 170:   /// attributes as inline markup.
 171:   String _encodeInline(List<InlineNode> nodes) {
 172:     final buffer = StringBuffer();
 173:     for (final node in nodes) {
 174:       if (node is TextRun) {
 175:         buffer.write(_encodeTextRun(node));
 176:       } else if (node is InlineEmbed) {
 177:         buffer.write(_encodeEmbed(node));
 178:       }
 179:     }
 180:     return buffer.toString();
 181:   }
 182: 
 183:   String _encodeTextRun(TextRun run) {
 184:     var text = _escapeInline(run.text);
 185:     final attrs = run.attributes;
 186:     if (attrs.lineThrough == true) {
 187:       text = '~~$text~~';
 188:     }
 189:     if (attrs.bold == true) {
 190:       text = '**$text**';
 191:     }
 192:     if (attrs.italic == true) {
 193:       text = '*$text*';
 194:     }
 195:     if (attrs.underline == true) {
 196:       text = '<u>$text</u>';
 197:     }
 198:     if (attrs.url != null && attrs.url!.isNotEmpty) {
 199:       text = '[$text](${attrs.url})';
 200:     }
 201:     return text;
 202:   }
 203: 
 204:   String _encodeEmbed(InlineEmbed embed) {
 205:     if (embed.embedType == 'image') {
 206:       final url = embed.data['assetId'] ?? embed.data['id'] ?? '';
 207:       final alt =
 208:           (embed.data['altText'] ?? embed.data['text']) as String? ?? '';
 209:       final caption = embed.data['caption'] as String? ?? '';
 210:       final title = caption.isEmpty ? '' : ' "${_escapeImageTitle(caption)}"';
 211:       return '![${_escapeImageAlt(alt)}]($url$title)';
 212:     }
 213:     // formula / mention / emoji: no standard Markdown — render the visible
 214:     // fallback so export at least preserves readable characters.
 215:     return _escapeInline(_embedDisplayText(embed));
 216:   }
 217: 
 218:   String _embedDisplayText(InlineEmbed embed) {
 219:     return switch (embed.embedType) {
 220:       'mention' => _mentionDisplayText(embed),
 221:       'formula' => _formulaDisplayText(embed),
 222:       'emoji' => _emojiDisplayText(embed),
 223:       _ => embed.plainText.trim(),
 224:     };
 225:   }
 226: 
 227:   String _mentionDisplayText(InlineEmbed embed) {
 228:     final raw = embed.data['label'] ?? embed.data['id'];
 229:     final label = raw?.toString() ?? '';
 230:     return label.isEmpty ? '@mention' : '@$label';
 231:   }
 232: 
 233:   String _formulaDisplayText(InlineEmbed embed) {
 234:     final raw =
 235:         embed.data['text'] ?? embed.data['latex'] ?? embed.data['value'];
 236:     final text = raw?.toString() ?? '';
 237:     return text.isEmpty ? '[formula]' : text;
 238:   }
 239: 
 240:   String _emojiDisplayText(InlineEmbed embed) {
 241:     final raw = embed.data['emoji'] ??
 242:         embed.data['text'] ??
 243:         embed.data['value'] ??
 244:         embed.data['shortName'] ??
 245:         embed.data['label'];
 246:     final text = raw?.toString() ?? '';
 247:     return text.isEmpty ? '[emoji]' : text;
 248:   }
 249: 
 250:   /// Escapes characters that would otherwise start inline/block Markdown
 251:   /// syntax when they appear at a run boundary. Kept minimal so output stays
 252:   /// readable; only the chars that change parsing are escaped.
 253:   String _escapeInline(String text) {
 254:     // Avoid double-escaping: only escape when the char could start a construct.
 255:     return text.replaceAllMapped(RegExp(r'([\\`*\_\[\]])'), (m) => '\\${m[1]}');
 256:   }
 257: 
 258:   String _imageAlt(ImageBlockNode image) {
 259:     if (image.altText.isNotEmpty) {
 260:       return image.altText;
 261:     }
 262:     if (image.file.isNotEmpty) {
 263:       return image.file;
 264:     }
 265:     if (image.caption.isNotEmpty) {
 266:       return image.caption;
 267:     }
 268:     return 'image';
 269:   }
 270: 
 271:   String _escapeImageAlt(String text) {
 272:     return text.replaceAll('\\', r'\\').replaceAll(']', r'\]');
 273:   }
 274: 
 275:   String _escapeImageTitle(String text) {
 276:     return text.replaceAll('\\', r'\\').replaceAll('"', r'\"');
 277:   }
 278: 
 279:   // ---------------------------------------------------------------------------
 280:   // Import: Markdown -> document
 281:   // ---------------------------------------------------------------------------
 282: 
 283:   /// Decodes [source] Markdown into a [RichTextDocument]. Markdown's leniency
 284:   /// means any unrecognised line becomes a paragraph; [decode] does not throw
 285:   /// for content. (A non-String / null source is impossible at the type level.)
 286:   RichTextDocument decode(String source) {
 287:     final lines = source.split('\n');
 288:     final blocks = <BlockNode>[];
 289:     var blockSeq = 0;
 290:     var i = 0;
 291: 
 292:     String newId(String prefix) => 'md-${blockSeq++}-$prefix';
 293: 
 294:     while (i < lines.length) {
 295:       final line = lines[i];
 296: 
 297:       // Blank line: block separator, skip.
 298:       if (line.trim().isEmpty) {
 299:         i++;
 300:         continue;
 301:       }
 302: 
 303:       // Fenced code block.
 304:       final fenceMatch = _fenceRegex.firstMatch(line.trimLeft());
 305:       if (fenceMatch != null) {
 306:         final language = fenceMatch.group(2) ?? '';
 307:         final codeLines = <String>[];
 308:         i++;
 309:         while (i < lines.length) {
 310:           final codeLine = lines[i];
 311:           if (_fenceRegex.hasMatch(codeLine.trimLeft())) {
 312:             i++;
 313:             break;
 314:           }
 315:           codeLines.add(codeLine);
 316:           i++;
 317:         }
 318:         blocks.add(CodeBlockNode(
 319:           id: newId('code'),
 320:           code: codeLines.join('\n'),
 321:           language: language,
 322:         ));
 323:         continue;
 324:       }
 325: 
 326:       // Heading (ATX).
 327:       final headingMatch = _headingRegex.firstMatch(line.trimLeft());
 328:       if (headingMatch != null) {
 329:         final level = headingMatch.group(1)!.length;
 330:         final text = headingMatch.group(2)!.trim();
 331:         blocks.add(TextBlockNode(
 332:           id: newId('h'),
 333:           type: BlockType.heading,
 334:           attributes: BlockAttributes(level: level),
 335:           content: _parseInline(text),
 336:         ));
 337:         i++;
 338:         continue;
 339:       }
 340: 
 341:       // Thematic break.
 342:       if (_thematicBreakRegex.hasMatch(line.trim())) {
 343:         blocks.add(DividerBlockNode(id: newId('hr')));
 344:         i++;
 345:         continue;
 346:       }
 347: 
 348:       // Blockquote (consecutive `>` lines aggregated).
 349:       if (line.trimLeft().startsWith('>')) {
 350:         final quoteLines = <String>[];
 351:         while (i < lines.length && lines[i].trimLeft().startsWith('>')) {
 352:           quoteLines
 353:               .add(lines[i].trimLeft().replaceFirst(RegExp(r'^>\s?'), ''));
 354:           i++;
 355:         }
 356:         blocks.add(TextBlockNode(
 357:           id: newId('quote'),
 358:           type: BlockType.quote,
 359:           content: _parseInline(quoteLines.join(' ')),
 360:         ));
 361:         continue;
 362:       }
 363: 
 364:       // List item (unordered / ordered / task).
 365:       final listMatch = _listItemRegex.firstMatch(line);
 366:       if (listMatch != null) {
 367:         final indent = (listMatch.group(1) ?? '').length ~/ 2;
 368:         final marker = listMatch.group(2)!;
 369:         final taskBox = listMatch.group(3); // `[x] ` / `[ ] ` or null.
 370:         final body = (listMatch.group(4) ?? '').trim();
 371: 
 372:         if (marker.startsWith(RegExp(r'\d'))) {
 373:           // Ordered list.
 374:           blocks.add(TextBlockNode(
 375:             id: newId('oli'),
 376:             type: BlockType.listItem,
 377:             attributes: BlockAttributes(
 378:               indent: indent,
 379:               listType: 'ordered',
 380:             ),
 381:             content: _parseInline(body),
 382:           ));
 383:         } else if (taskBox != null) {
 384:           // Task list item: the box was captured by the list regex.
 385:           final checked = taskBox.toLowerCase().contains('x');
 386:           blocks.add(TextBlockNode(
 387:             id: newId('task'),
 388:             type: BlockType.listItem,
 389:             attributes: BlockAttributes(
 390:               indent: indent,
 391:               listType: 'task',
 392:               checked: checked,
 393:             ),
 394:             content: _parseInline(body),
 395:           ));
 396:         } else {
 397:           blocks.add(TextBlockNode(
 398:             id: newId('li'),
 399:             type: BlockType.listItem,
 400:             attributes: BlockAttributes(indent: indent),
 401:             content: _parseInline(body),
 402:           ));
 403:         }
 404:         i++;
 405:         continue;
 406:       }
 407: 
 408:       // GFM table: a pipe row followed by a separator row.
 409:       if (_looksLikeTableRow(line) &&
 410:           i + 1 < lines.length &&
 411:           _looksLikeTableSeparator(lines[i + 1])) {
 412:         final tableRows = <List<String>>[_splitTableRow(line)];
 413:         final alignments = _parseTableAlignments(lines[i + 1]);
 414:         i += 2;
 415:         while (i < lines.length && _looksLikeTableRow(lines[i])) {
 416:           tableRows.add(_splitTableRow(lines[i]));
 417:           i++;
 418:         }
 419:         blocks.add(_buildTable(tableRows, alignments, newId('table')));
 420:         continue;
 421:       }
 422: 
 423:       // Paragraph: gather consecutive non-blank, non-structural lines.
 424:       final paraLines = <String>[line];
 425:       i++;
 426:       while (i < lines.length &&
 427:           lines[i].trim().isNotEmpty &&
 428:           !_startsBlock(lines[i])) {
 429:         paraLines.add(lines[i]);
 430:         i++;
 431:       }
 432:       final paraText = paraLines.join(' ');
 433:       // An image-only paragraph becomes an image block; Wenz video export uses
 434:       // the `![video](src)` readable placeholder and can be restored as video.
 435:       final imageOnly = _imageOnlyRegex.firstMatch(paraText.trim());
 436:       if (imageOnly != null) {
 437:         final alt = _unescapeImageToken(imageOnly.group(1) ?? '');
 438:         final caption = _unescapeImageToken(imageOnly.group(3) ?? '');
 439:         final source = imageOnly.group(2)!;
 440:         if (_isVideoPlaceholderAlt(alt) && caption.isEmpty) {
 441:           blocks.add(VideoBlockNode(id: newId('video'), assetId: source));
 442:         } else {
 443:           blocks.add(ImageBlockNode(
 444:             id: newId('image'),
 445:             assetId: source,
 446:             file: alt,
 447:             caption: caption,
 448:             altText: alt,
 449:           ));
 450:         }
 451:       } else {
 452:         blocks.add(TextBlockNode(
 453:           id: newId('p'),
 454:           type: BlockType.paragraph,
 455:           content: _parseInline(paraText),
 456:         ));
 457:       }
 458:     }
 459: 
 460:     return RichTextDocument(blocks: blocks);
 461:   }
