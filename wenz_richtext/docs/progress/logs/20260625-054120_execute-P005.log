+        buffer.write(char);
+        escaped = false;
+        continue;
+      }
+      if (char == '\\') {
+        escaped = true;
+        continue;
+      }
+      buffer.write(char);
+    }
+    if (escaped) {
+      buffer.write('\\');
+    }
+    return buffer.toString();
+  }
+
+  String _videoTitleFromAlt(String alt) {
+    final trimmed = alt.trim();
+    final match = RegExp(r'^video\s*:\s*(.+)$', caseSensitive: false)
+        .firstMatch(trimmed);
+    return match?.group(1)?.trim() ?? '';
+  }
+
+  double? _positiveDouble(Object? value) {
