 148:   /// Encodes a list of inline nodes to an HTML string, wrapping each run in
 149:   /// tags for its active attributes.
 150:   String _encodeInline(List<InlineNode> nodes) {
 151:     final buffer = StringBuffer();
 152:     for (final node in nodes) {
 153:       if (node is TextRun) {
 154:         buffer.write(_encodeTextRun(node));
 155:       } else if (node is InlineEmbed) {
 156:         buffer.write(_encodeEmbed(node));
 157:       }
 158:     }
 159:     return buffer.toString();
 160:   }
 161: 
 162:   String _encodeTextRun(TextRun run) {
 163:     var text = _escapeHtml(run.text);
 164:     final attrs = run.attributes;
 165:     if (attrs.bold == true) {
 166:       text = '<strong>$text</strong>';
 167:     }
 168:     if (attrs.italic == true) {
 169:       text = '<em>$text</em>';
 170:     }
 171:     if (attrs.lineThrough == true) {
 172:       text = '<s>$text</s>';
 173:     }
 174:     if (attrs.underline == true) {
 175:       text = '<u>$text</u>';
 176:     }
 177:     if (attrs.url != null && attrs.url!.isNotEmpty) {
 178:       final href = _escapeHtml(attrs.url!);
 179:       text = '<a href="$href">$text</a>';
 180:     }
 181:     return text;
 182:   }
