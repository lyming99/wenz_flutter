   4: /// Exports a [RichTextDocument] as plain text.
   5: ///
   6: /// Each block contributes one paragraph (its [BlockNode.plainText]); blocks
   7: /// are separated by a blank line so the output reads as paragraphs rather
   8: /// than a single run-on line. Non-text blocks (divider/image/video/file) that
   9: /// carry no plain text are rendered as a short sentinel so the reader can see
  10: /// where they sat in the flow; pass [omitEmptyBlocks] = true to drop them
  11: /// entirely.
  12: ///
  13: /// This is a one-way export — there is no plain-text *import* (parsing
  14: /// unstructured text back into block structure is the job of the Markdown /
  15: /// HTML codecs, stage 6). Use it for "copy document as text", search
  16: /// indexing, and export-to-`.txt` workflows.
  17: class PlainTextCodec {
  18:   const PlainTextCodec({this.omitEmptyBlocks = false});
  19: 
  20:   /// When true, blocks whose [BlockNode.plainText] is empty are skipped
  21:   /// instead of emitting a sentinel line. Default is `false` so the export
  22:   /// always reflects document structure.
  23:   final bool omitEmptyBlocks;
  24: 
  25:   String encode(RichTextDocument document) {
  26:     final lines = <String>[];
  27:     for (final block in document.blocks) {
  28:       if (omitEmptyBlocks && _isStructural(block)) {
  29:         // Media / divider blocks are structural — skip them when the caller
  30:         // wants only textual content.
  31:         continue;
  32:       }
  33:       final rendered = _renderBlock(block);
  34:       if (rendered == null || rendered.isEmpty) {
  35:         if (omitEmptyBlocks) {
  36:           continue;
  37:         }
  38:         lines.add('');
  39:         continue;
  40:       }
  41:       lines.add(rendered);
  42:     }
  43:     return lines.join('\n\n');
  44:   }
  45: 
  46:   /// Whether [block] is a structural (non-textual) block whose presence is
  47:   /// optional in a plain-text export.
  48:   bool _isStructural(BlockNode block) {
  49:     switch (block.type) {
  50:       case BlockType.image:
  51:       case BlockType.video:
  52:       case BlockType.embed:
  53:       case BlockType.file:
  54:       case BlockType.divider:
  55:         return true;
  56:       case BlockType.paragraph:
  57:       case BlockType.heading:
  58:       case BlockType.quote:
  59:       case BlockType.listItem:
  60:       case BlockType.code:
  61:       case BlockType.table:
  62:       case BlockType.callout:
  63:         return false;
  64:     }
  65:   }
  66: 
  67:   /// Returns the plain-text rendering for [block], or `null` when the block
  68:   /// has no textual representation at all (an empty paragraph / callout).
  69:   /// Media blocks always go through their sentinel so file names / asset ids
  70:   /// are not mistaken for body text.
  71:   String? _renderBlock(BlockNode block) {
  72:     switch (block.type) {
  73:       case BlockType.paragraph:
  74:       case BlockType.heading:
  75:       case BlockType.quote:
  76:       case BlockType.listItem:
  77:       case BlockType.callout:
  78:         return block.plainText;
  79:       case BlockType.code:
  80:         // Code is emitted verbatim (keeps internal newlines).
  81:         return block.plainText;
  82:       case BlockType.table:
  83:         final text = block.plainText;
  84:         return text.isEmpty ? '[table]' : text;
  85:       case BlockType.image:
  86:         final image = block as ImageBlockNode;
  87:         return '[image: ${_imageLabel(image)}]';
  88:       case BlockType.video:
  89:         final video = block as VideoBlockNode;
  90:         return '[video: ${video.assetId}]';
  91:       case BlockType.embed:
  92:         final embed = block as BlockEmbedNode;
  93:         return '[embed:${embed.normalizedEmbedType}: ${embed.displayText}]';
  94:       case BlockType.file:
  95:         final file = block as FileBlockNode;
  96:         return '[file: ${file.displayName}]';
  97:       case BlockType.divider:
  98:         return '---';
  99:     }
 100:   }
