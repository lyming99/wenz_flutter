 972:   /// Merges adjacent [TextRun]s with identical attributes so the output run
 973:   /// list is compact.
 974:   List<InlineNode> _coalesce(List<InlineNode> nodes) {
 975:     if (nodes.isEmpty) {
 976:       return nodes;
 977:     }
 978:     final result = <InlineNode>[nodes.first.copy()];
 979:     for (var i = 1; i < nodes.length; i++) {
 980:       final node = nodes[i];
 981:       final last = result.last;
 982:       if (node is TextRun &&
 983:           last is TextRun &&
 984:           node.attributes == last.attributes) {
 985:         result[result.length - 1] = TextRun(
 986:           text: last.text + node.text,
 987:           attributes: last.attributes,
 988:         );
 989:       } else {
 990:         result.add(node.copy());
 991:       }
 992:     }
 993:     return result;
 994:   }
