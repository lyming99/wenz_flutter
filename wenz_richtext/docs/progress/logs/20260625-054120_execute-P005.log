 463:   /// Whether [line] would start a new block construct (used to bound paragraph
 464:   /// aggregation). Code fences, headings, thematic breaks, blockquotes, and
 465:   /// list items all count.
 466:   bool _startsBlock(String line) {
 467:     final trimmed = line.trimLeft();
 468:     if (_fenceRegex.hasMatch(trimmed)) {
 469:       return true;
 470:     }
 471:     if (_headingRegex.hasMatch(trimmed)) {
 472:       return true;
 473:     }
 474:     if (_thematicBreakRegex.hasMatch(line.trim())) {
 475:       return true;
 476:     }
 477:     if (trimmed.startsWith('>')) {
 478:       return true;
 479:     }
 480:     if (_listItemRegex.hasMatch(line)) {
 481:       return true;
 482:     }
 483:     if (_looksLikeTableRow(line)) {
 484:       return true;
 485:     }
 486:     return false;
 487:   }
