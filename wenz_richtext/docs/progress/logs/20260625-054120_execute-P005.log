 228:       'mention' => _mentionDisplayText(embed),
 229:       'formula' => _formulaDisplayText(embed),
 230:       'emoji' => _emojiDisplayText(embed),
 231:       _ => embed.plainText.trim(),
 232:     };
 233:   }
