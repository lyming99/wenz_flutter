 646:   bool _looksLikeTableRow(String line) {
 647:     final trimmed = line.trim();
 648:     if (trimmed.isEmpty) {
 649:       return false;
 650:     }
 651:     return trimmed.contains('|') && !trimmed.startsWith('#');
 652:   }
 653: 
 654:   bool _looksLikeTableSeparator(String line) {
 655:     final trimmed = line.trim();
 656:     if (trimmed.isEmpty) {
 657:       return false;
 658:     }
 659:     // A separator row is made of `|`, `-`, `:`, and spaces only, and must
 660:     // contain at least one dash.
 661:     if (!trimmed.contains('-')) {
 662:       return false;
 663:     }
 664:     return RegExp(r'^[\s\|\:\-]+$').hasMatch(trimmed);
 665:   }
 666: 
 667:   List<String> _splitTableRow(String line) {
 668:     var trimmed = line.trim();
 669:     // Strip a single leading/trailing pipe if present.
 670:     if (trimmed.startsWith('|')) {
 671:       trimmed = trimmed.substring(1);
 672:     }
 673:     if (trimmed.endsWith('|')) {
 674:       trimmed = trimmed.substring(0, trimmed.length - 1);
 675:     }
 676:     return _splitOnUnescapedPipe(trimmed)
 677:         .map((cell) => cell.trim().replaceAll('\\|', '|'))
 678:         .toList();
 679:   }
 680: 
 681:   List<String> _splitOnUnescapedPipe(String text) {
 682:     final cells = <String>[];
 683:     final buffer = StringBuffer();
 684:     var i = 0;
 685:     while (i < text.length) {
 686:       if (text[i] == '\\' && i + 1 < text.length && text[i + 1] == '|') {
 687:         buffer.write('\\|');
 688:         i += 2;
 689:         continue;
 690:       }
 691:       if (text[i] == '|') {
 692:         cells.add(buffer.toString());
 693:         buffer.clear();
 694:         i++;
 695:         continue;
 696:       }
 697:       buffer.write(text[i]);
 698:       i++;
 699:     }
 700:     cells.add(buffer.toString());
 701:     return cells;
 702:   }
 703: 
 704:   Map<int, String> _parseTableAlignments(String separator) {
 705:     final cells = _splitTableRow(separator);
 706:     final alignments = <int, String>{};
 707:     for (var c = 0; c < cells.length; c++) {
 708:       final cell = cells[c].trim();
 709:       final leftColon = cell.startsWith(':');
 710:       final rightColon = cell.endsWith(':');
 711:       if (leftColon && rightColon) {
 712:         alignments[c] = 'center';
 713:       } else if (rightColon) {
 714:         alignments[c] = 'right';
 715:       } else if (leftColon) {
 716:         alignments[c] = 'left';
 717:       }
 718:     }
 719:     return alignments;
 720:   }
 721: 
 722:   BlockNode _buildTable(
 723:     List<List<String>> rows,
 724:     Map<int, String> alignments,
 725:     String id,
 726:   ) {
 727:     final tableRows = <List<TableCellNode>>[];
 728:     for (var r = 0; r < rows.length; r++) {
 729:       final row = rows[r];
 730:       final cells = <TableCellNode>[];
 731:       for (var c = 0; c < row.length; c++) {
 732:         final isHeader = r == 0;
 733:         cells.add(TableCellNode(
 734:           id: '$id-r$r-c$c',
 735:           isHeader: isHeader,
 736:           blocks: <BlockNode>[
 737:             TextBlockNode(
 738:               id: '$id-r$r-c$c-p',
 739:               type: BlockType.paragraph,
 740:               content: _parseInline(row[c]),
 741:             ),
 742:           ],
 743:         ));
 744:       }
 745:       tableRows.add(cells);
 746:     }
 747:     return TableBlockNode(
 748:       id: id,
 749:       table: TableModel(
 750:         rows: tableRows,
 751:         columnAlignments: alignments,
 752:       ),
 753:     );
 754:   }
 755: 
 756:   String _unescapeImageToken(String text) {
 757:     if (!text.contains('\\')) {
 758:       return text;
 759:     }
 760:     final buffer = StringBuffer();
 761:     for (var i = 0; i < text.length; i++) {
 762:       if (text[i] == '\\' && i + 1 < text.length) {
 763:         buffer.write(text[i + 1]);
 764:         i++;
 765:       } else {
 766:         buffer.write(text[i]);
 767:       }
 768:     }
 769:     return buffer.toString();
 770:   }
