 635:   FileBlockNode _decodeFileBlock(
 636:     dom.Element node,
 637:     String Function(String) newId,
 638:   ) {
 639:     final href = (node.attributes['href'] ?? '').trim();
 640:     final assetId = (node.attributes['data-asset-id'] ?? '').trim();
 641:     final file = (node.attributes['data-file'] ?? '').trim();
 642:     final explicitDownloadUrl =
 643:         (node.attributes['data-download-url'] ?? '').trim();
 644:     final downloadUrl = explicitDownloadUrl.isNotEmpty
 645:         ? explicitDownloadUrl
 646:         : href.isNotEmpty && href != assetId && href != file
 647:             ? href
 648:             : '';
 649:     final name = (node.attributes['data-name'] ?? node.text).trim();
 650:     return FileBlockNode(
 651:       id: newId('file'),
 652:       assetId: assetId,
 653:       name: name,
 654:       size: _parseIntAttribute(node.attributes['data-size']),
 655:       mimeType: (node.attributes['data-mime-type'] ?? '').trim(),
 656:       file: file,
 657:       downloadUrl: downloadUrl,
 658:       uploadStatus:
 659:           FileUploadStatus.parse(node.attributes['data-upload-status']),
 660:       uploadError: (node.attributes['data-upload-error'] ?? '').trim(),
 661:     );
 662:   }
