 184:   String _encodeEmbed(InlineEmbed embed) {
 185:     if (embed.embedType == 'image') {
 186:       final url =
 187:           _escapeHtml('${embed.data['assetId'] ?? embed.data['id'] ?? ''}');
 188:       final alt =
 189:           _escapeHtml('${embed.data['altText'] ?? embed.data['text'] ?? ''}');
 190:       final attrs = StringBuffer(' src="$url" alt="$alt"');
 191:       final width = _embedDimension(embed.data['width']);
 192:       final height = _embedDimension(embed.data['height']);
 193:       if (width != null) {
 194:         attrs.write(' width="${_formatDimension(width)}"');
 195:       }
 196:       if (height != null) {
 197:         attrs.write(' height="${_formatDimension(height)}"');
 198:       }
 199:       final caption = _embedString(embed.data['caption']);
 200:       if (caption.isNotEmpty) {
 201:         final escapedCaption = _escapeHtml(caption);
 202:         attrs.write(' title="$escapedCaption" data-caption="$escapedCaption"');
 203:       }
 204:       return '<img$attrs>';
 205:     }
 206:     return _escapeHtml(_embedDisplayText(embed));
 207:   }
