 895:         case 'b':
 896:           return _parseChildren(node, attributes.copyWith(bold: true));
 897:         case 'em':
 898:         case 'i':
 899:           return _parseChildren(node, attributes.copyWith(italic: true));
 900:         case 's':
 901:         case 'del':
 902:         case 'strike':
 903:           return _parseChildren(node, attributes.copyWith(lineThrough: true));
 904:         case 'u':
 905:           return _parseChildren(node, attributes.copyWith(underline: true));
 906:         case 'a':
 907:           final href = node.attributes['href'] ?? '';
 908:           return _parseChildren(
 909:               node, attributes.copyWith(url: href.isEmpty ? null : href));
 910:         case 'br':
 911:           return const <InlineNode>[TextRun(text: '\n')];
 912:         case 'img':
 913:           final src = node.attributes['src'] ?? '';
 914:           final alt = node.attributes['alt'] ?? '';
 915:           if (src.isEmpty) {
 916:             return <InlineNode>[TextRun(text: alt, attributes: attributes)];
 917:           }
 918:           final caption = (node.attributes['data-caption'] ??
 919:                   node.attributes['title'] ??
 920:                   '')
 921:               .trim();
 922:           final width = _parseDoubleAttribute(node.attributes['width']) ??
 923:               _parseDoubleAttribute(node.attributes['data-width']);
 924:           final height = _parseDoubleAttribute(node.attributes['height']) ??
 925:               _parseDoubleAttribute(node.attributes['data-height']);
 926:           return <InlineNode>[
 927:             InlineEmbed(
 928:               embedType: 'image',
 929:               data: <String, Object?>{
 930:                 'assetId': src,
 931:                 'text': alt,
 932:                 'altText': alt,
 933:                 if (caption.isNotEmpty) 'caption': caption,
 934:                 if (width != null) 'width': width,
 935:                 if (height != null) 'height': height,
 936:               },
 937:               attributes: attributes,
 938:             ),
 939:           ];
