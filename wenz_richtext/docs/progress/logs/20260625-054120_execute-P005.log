 664:   bool _isCalloutElement(dom.Element node) {
 665:     final blockType = node.attributes['data-wenz-block'];
 666:     if (blockType == 'callout') {
 667:       return true;
 668:     }
 669:     final classNames = node.attributes['class'] ?? '';
 670:     return classNames.split(RegExp(r'\s+')).contains('wenz-callout') &&
 671:         node.attributes.containsKey('data-callout-variant');
 672:   }
