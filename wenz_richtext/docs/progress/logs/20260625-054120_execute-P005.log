 674:   CalloutBlockNode _decodeCallout(
 675:     dom.Element node,
 676:     String Function(String) newId,
 677:   ) {
 678:     final variant = CalloutBlockNode.normalizeVariant(
 679:       node.attributes['data-callout-variant'],
 680:     );
 681:     final titleElement = node.querySelector('[data-callout-title]');
 682:     var title = titleElement?.text.trim() ?? '';
 683:     if (title == CalloutBlockNode.defaultTitleFor(variant)) {
 684:       title = '';
 685:     }
 686:     var icon = (node.attributes['data-callout-icon'] ?? '').trim();
 687:     if (icon == CalloutBlockNode.defaultIconFor(variant)) {
 688:       icon = '';
 689:     }
 690:     final bodyElement = node.querySelector('[data-callout-body]');
 691:     final content = bodyElement == null
 692:         ? _parseCalloutInlineWithoutTitle(node, titleElement)
 693:         : _parseInline(bodyElement);
 694:     return CalloutBlockNode(
 695:       id: newId('callout'),
 696:       variant: variant,
 697:       title: title,
 698:       icon: icon,
 699:       content: content,
 700:     );
 701:   }
 702: 
 703:   List<InlineNode> _parseCalloutInlineWithoutTitle(
 704:     dom.Element node,
 705:     dom.Element? titleElement,
 706:   ) {
 707:     final runs = <InlineNode>[];
 708:     for (final child in node.nodes) {
 709:       if (titleElement != null && identical(child, titleElement)) {
 710:         continue;
 711:       }
 712:       runs.addAll(_parseInlineNode(child, const TextAttributes()));
 713:     }
 714:     return _coalesce(runs);
 715:   }
