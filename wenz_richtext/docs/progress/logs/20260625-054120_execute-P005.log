 953:   List<InlineNode> _parseChildren(
 954:     dom.Element element,
 955:     TextAttributes attributes,
 956:   ) {
 957:     final runs = <InlineNode>[];
 958:     for (final child in element.nodes) {
 959:       runs.addAll(_parseInlineNode(child, attributes));
 960:     }
 961:     return runs;
 962:   }
