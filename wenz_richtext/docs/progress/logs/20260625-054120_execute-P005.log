+    var escaped = false;
+    for (var i = 0; i < text.length; i++) {
+      final char = text[i];
+      if (escaped) {
+        buffer.write('\\');
+        buffer.write(char);
+        escaped = false;
+        continue;
+      }
+      if (char == '\\') {
