 377:   String _escapeHtml(String text) {
 378:     return text
 379:         .replaceAll('&', '&amp;')
 380:         .replaceAll('<', '&lt;')
 381:         .replaceAll('>', '&gt;')
 382:         .replaceAll('"', '&quot;');
