 3731:   Future<void> _showMenu() async {
 3732:     if (!_enabled || _dragging || _menuOpen || !mounted) {
 3733:       return;
 3734:     }
 3735:     final button = _hitTestKey.currentContext?.findRenderObject() as RenderBox?;
 3736:     final overlay =
 3737:         Overlay.of(context).context.findRenderObject() as RenderBox?;
 3738:     if (button == null ||
 3739:         overlay == null ||
 3740:         !button.hasSize ||
 3741:         !overlay.hasSize) {
 3742:       return;
 3743:     }
 3744:     final buttonTopLeft = button.localToGlobal(Offset.zero, ancestor: overlay);
 3745:     final position = RelativeRect.fromRect(
 3746:       buttonTopLeft & button.size,
 3747:       Offset.zero & overlay.size,
 3748:     );

