+        blockIndex: 1,
+        tableRowIndex: 0,
+        tableColumnIndex: 0,
+        offset: 0,
+      );
+      expect(
+        session.selection,
+        DocumentSelection(base: tablePosition, extent: tablePosition),
+      );
+      expect(session.canUndo, isTrue);
