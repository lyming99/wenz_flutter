+    final controller = WenzRichTextController(
+      document: RichTextDocument(
+        blocks: List<BlockNode>.generate(
+          30,
+          (index) => TextBlockNode(
+            id: 'p$index',
+            type: BlockType.paragraph,
+            content: <InlineNode>[TextRun(text: 'long-block-$index')],
+          ),
+        ),
+      ),
