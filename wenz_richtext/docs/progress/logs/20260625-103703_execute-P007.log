 3706:   void _submitBlockReorder(BlockReorderDropTarget? target) {
 3707:     if (!_canDragSort || target == null) {
 3708:       return;
 3709:     }
 3710:     final insertionIndex =
 3711:         target.insertionIndex.clamp(0, widget.blockCount).toInt();
 3712:     final toIndex = insertionIndex > widget.blockIndex
 3713:         ? insertionIndex - 1
 3714:         : insertionIndex;
 3715:     if (toIndex < 0 ||
 3716:         toIndex >= widget.blockCount ||
 3717:         toIndex == widget.blockIndex) {
 3718:       return;
 3719:     }
 3720:     widget.onAction?.call(
 3721:       ObjectBlockActionIntent(
 3722:         action: toIndex < widget.blockIndex
 3723:             ? ObjectBlockAction.moveUp
 3724:             : ObjectBlockAction.moveDown,
 3725:         blockIndex: widget.blockIndex,
 3726:         value: toIndex,
 3727:       ),
 3728:     );
 3729:   }
