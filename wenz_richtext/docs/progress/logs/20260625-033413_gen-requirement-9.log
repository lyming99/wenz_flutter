        widget.controller.updateFileBlock(
          blockIndex: intent.blockIndex,
          uploadStatus: FileUploadStatus.failed,
          uploadError:
              block.uploadError.isEmpty ? 'Upload failed' : block.uploadError,
        );
        return;
