  482:   final DocumentSelection? selection;
  483: 
  484:   @override
  485:   String get description => 'toggleQuote';
  486: 
  487:   @override
  488:   CommandResult execute(DocumentSession session) {
  489:     final target = selection ?? session.selection;
  490:     if (target == null) {
  491:       return const CommandResult(recordHistory: false);
  492:     }
  493:     final blocks = session.document.blocks.map((b) => b.copy()).toList();
  494:     var changed = false;
  495:     for (var i = target.start.blockIndex; i <= target.end.blockIndex; i++) {
  496:       if (i < 0 || i >= blocks.length) {
  497:         continue;
  498:       }
  499:       final block = blocks[i];
  500:       if (block is! TextBlockNode) {
  501:         continue;
  502:       }
  503:       blocks[i] = block.type == BlockType.quote
  504:           ? _convert(block, BlockType.paragraph)
  505:           : _convert(block, BlockType.quote);
  506:       changed = true;
  507:     }
  508:     if (!changed) {
  509:       return const CommandResult(recordHistory: false);
  510:     }
  511:     session.document = RichTextDocument(
  512:       version: session.document.version,
  513:       blocks: blocks,
  514:     );
  515:     return CommandResult(selection: target);
  516:   }
