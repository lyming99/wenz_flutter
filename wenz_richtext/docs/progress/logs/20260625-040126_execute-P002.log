 7502: _LocalSelectionRange? _selectionRangeForPath(
 7503:   DocumentSelection? selection,
 7504:   int blockIndex,
 7505:   PositionPath path,
 7506:   int textLength,
 7507: ) {
 7508:   if (selection == null || selection.isCollapsed) {
 7509:     return null;
 7510:   }
 7511:   final start = selection.start;
 7512:   final end = selection.end;
 7513:   int? localStart;
 7514:   int? localEnd;
 7515: 
 7516:   if (start.blockIndex == blockIndex) {
 7517:     final pathCompare = path.compare(start.path);
 7518:     if (pathCompare == 0) {
 7519:       localStart = start.offset;
 7520:     } else if (pathCompare > 0) {
 7521:       localStart = 0;
 7522:     }
 7523:   } else if (blockIndex > start.blockIndex) {
 7524:     localStart = 0;
 7525:   }
 7526: 
 7527:   if (end.blockIndex == blockIndex) {
 7528:     final pathCompare = path.compare(end.path);
 7529:     if (pathCompare == 0) {
 7530:       localEnd = end.offset;
 7531:     } else if (pathCompare < 0) {
 7532:       localEnd = textLength;
 7533:     }
 7534:   } else if (blockIndex < end.blockIndex) {
 7535:     localEnd = textLength;
 7536:   }
 7537: 
 7538:   if (localStart == null || localEnd == null) {
 7539:     return null;
 7540:   }
 7541:   final safeStart = localStart.clamp(0, textLength).toInt();
 7542:   final safeEnd = localEnd.clamp(0, textLength).toInt();
 7543:   if (safeStart == safeEnd) {
 7544:     return null;
 7545:   }
 7546:   return _LocalSelectionRange(
 7547:     start: safeStart < safeEnd ? safeStart : safeEnd,
 7548:     end: safeStart < safeEnd ? safeEnd : safeStart,
 7549:   );
 7550: }
