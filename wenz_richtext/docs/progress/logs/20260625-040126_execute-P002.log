   33:     final result = command.execute(session);
   34:     if (result.selection != null) {
   35:       session.selection = result.selection;
   36:     }
   37:     // Enforce the document schema after every command so outputs are always
   38:     // well-formed (non-empty, cells non-empty, attrs consistent with type).
   39:     session.document = session.schema.normalize(session.document);
   40:     final change = ChangeSet(
   41:       before: before,
   42:       after: session.document.copy(),
   43:       selectionBefore: selectionBefore,
   44:       selectionAfter: session.selection,
   45:       description: command.description,
   46:       metadata: result.metadata,
