 1665:   /// Diffs [before] against [after] and returns the set of block ids whose
 1666:   /// rendering must refresh: every block id present in [after] whose
 1667:   /// lightweight fingerprint changed or that is newly added. Removed block ids
 1668:   /// are not included (there is nothing left to rebuild for them). Returns an
 1669:   /// empty set when the two documents are content-identical.
 1670:   ///
 1671:   /// The fingerprint is intentionally cheap (`type` + `plainText` + attributes
 1672:   /// JSON) — it catches text, structure, and attribute edits without a full
 1673:   /// deep compare or [BlockNode.toJson] on every block. It may produce a false
 1674:   /// positive (rebuild a block that did not visually change) but never a false
 1675:   /// negative, so correctness is preserved.
 1676:   Set<String> _changedBlockIds(
 1677:       RichTextDocument before, RichTextDocument after) {
 1678:     final beforeFingerprints = <String, String>{
 1679:       for (final block in before.blocks) block.id: _blockFingerprint(block),
 1680:     };
 1681:     final changed = <String>{};
 1682:     for (final block in after.blocks) {
 1683:       final previous = beforeFingerprints[block.id];
 1684:       if (previous == null || previous != _blockFingerprint(block)) {
 1685:         changed.add(block.id);
 1686:       }
 1687:     }
 1688:     return changed;
 1689:   }
 1690: 
 1691:   String _blockFingerprint(BlockNode block) {
 1692:     // The full JSON shape (including inline content + run attributes, table
 1693:     // cells, code language, media metadata) is the fingerprint. A coarser
 1694:     // fingerprint based only on type + plainText would miss inline attribute
 1695:     // changes (e.g. formatText toggling bold) and fail to mark the block dirty
 1696:     // for incremental rebuild, leaving stale spans rendered.
 1697:     return jsonEncode(block.toJson());
 1698:   }
 1699: }
