  172:           local.dx <= box.size.width &&
  173:           local.dy >= 0 &&
  174:           local.dy <= box.size.height) {
  175:         final rect = box.localToGlobal(Offset.zero) & box.size;
  176:         final delta = (global - rect.center).distanceSquared;
  177:         if (delta < nearestHitDelta) {
  178:           nearestHitDelta = delta;
  179:           hitEntry = entry;
  180:           hitTextLocal = entry.hitLocalToTextLocal(local);
  181:         }
  182:       }
