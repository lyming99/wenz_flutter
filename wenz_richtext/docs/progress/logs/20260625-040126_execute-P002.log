   78:   /// Whether the new command's [selectionBefore] (the caret state when the
   79:   /// command started) matches where the previous merged command left the caret.
   80:   /// Non-contiguous edits never coalesce even if [canMergeWith] is true.
   81:   bool _isContiguous(DocumentSelection? selectionBefore) {
   82:     final last = _lastSelectionAfter;
   83:     if (last == null) {
   84:       return false;
   85:     }
   86:     // The new command must start with a collapsed caret at the exact position
   87:     // the previous command ended. A non-collapsed selection (e.g. after a
   88:     // select-drag) breaks the run.
   89:     if (selectionBefore == null || !selectionBefore.isCollapsed) {
   90:       return false;
   91:     }
   92:     return selectionBefore.extent == last.extent;
   93:   }
