   17:   ChangeSet execute(EditorCommand command) {
   18:     // before-hooks may short-circuit the command by returning a change.
   19:     for (final middleware in middlewares) {
   20:       final override = middleware.before(command, session);
   21:       if (override != null) {
   22:         session.document = override.after;
   23:         session.selection = override.selectionAfter;
   24:         _runAfterHooks(override);
   25:         _lastCommand = null;
   26:         _lastSelectionAfter = null;
   27:         return override;
   28:       }
   29:     }
