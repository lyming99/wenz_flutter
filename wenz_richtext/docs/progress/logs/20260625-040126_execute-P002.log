   58:     // Commands that move the caret (even without recording history) must break
   59:     // an in-progress coalesce run, otherwise typing after moving the caret
   60:     // would merge with text typed before the move.
   61:     if (command.breaksMergeRun) {
   62:       _lastCommand = null;
   63:       _lastSelectionAfter = null;
   64:     } else {
