 7592: String? _prefixFor(TextBlockNode block) {
 7593:   return switch (block.type) {
 7594:     BlockType.quote => '|',
 7595:     BlockType.listItem => switch (block.attributes.listType) {
 7596:         'ordered' => '1.',
 7597:         'task' => block.attributes.checked == true ? '[x]' : '[ ]',
 7598:         _ => '-',
 7599:       },
 7600:     _ => null,
 7601:   };
 7602: }
