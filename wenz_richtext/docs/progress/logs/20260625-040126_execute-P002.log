  477: /// Toggles the quote type of the block at the caret: a non-quote becomes a
  478: /// quote, a quote becomes a paragraph. Quote nesting depth uses indent.
  479: class ToggleQuoteCommand extends EditorCommand {
  480:   const ToggleQuoteCommand({this.selection});
