  634: Map<int, T> shiftColumnMapOnInsert<T>(Map<int, T> values, int insertIndex) {
  635:   return <int, T>{
  636:     for (final entry in values.entries)
  637:       if (entry.key < insertIndex)
  638:         entry.key: entry.value
  639:       else
  640:         entry.key + 1: entry.value,
  641:   };
  642: }
  643: 
  644: Map<int, T> shiftColumnMapOnDelete<T>(Map<int, T> values, int deleteIndex) {
  645:   return <int, T>{
  646:     for (final entry in values.entries)
  647:       if (entry.key < deleteIndex)
  648:         entry.key: entry.value
  649:       else if (entry.key > deleteIndex)
  650:         entry.key - 1: entry.value,
  651:   };
  652: }
