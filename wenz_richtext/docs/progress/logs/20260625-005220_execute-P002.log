    await tester.pump();
    final tailEnd = _globalTextOffset(tester, renderedText, 10, first: true);
    for (final fraction in <double>[0.1, 0.5, 0.9]) {
      final start = _globalTextRangePoint(tester, renderedText, 1, 5, fraction, first: true);
      await tester.dragFrom(start, tailEnd - start);
      await tester.pump();
      print('p "'$fraction: ${controller.selection?.base.offset}->${controller.selection?.extent.offset}'"');
    }
    final tailEnd2 = _globalTextOffset(tester, renderedText, 10, first: false);
    for (final fraction in <double>[0.1, 0.5, 0.9]) {
      final start = _globalTextRangePoint(tester, renderedText, 1, 5, fraction, first: false);
      await tester.dragFrom(start, tailEnd2 - start);
      await tester.pump();
      print('t "'$fraction: ${controller.selection?.base.offset}->${controller.selection?.extent.offset}, path=${controller.selection?.base.path}'"');
    }
  });
}

Finder _richText(String text, {required bool first}) {
  final finder = find.byWidgetPredicate((widget) => widget is RichText && widget.text.toPlainText() == text);
  return first ? finder.first : finder.last;
}

Offset _globalTextOffset(WidgetTester tester, String text, int offset, {required bool first}) {
  final finder = _richText(text, first: first);
  final richText = tester.widget<RichText>(finder);
  final size = tester.getSize(finder);
  final painter = TextPainter(text: richText.text, textAlign: richText.textAlign, textDirection: TextDirection.ltr)..layout(maxWidth: size.width);
  final local = painter.getOffsetForCaret(TextPosition(offset: offset), Rect.zero);
  return tester.getTopLeft(finder) + local + Offset(1, painter.preferredLineHeight / 2);
}

Offset _globalTextRangePoint(WidgetTester tester, String text, int startOffset, int endOffset, double fraction, {required bool first}) {
  final finder = _richText(text, first: first);
  final richText = tester.widget<RichText>(finder);
  final size = tester.getSize(finder);
  final painter = TextPainter(text: richText.text, textAlign: richText.textAlign, textDirection: TextDirection.ltr)..layout(maxWidth: size.width);
  final boxes = painter.getBoxesForSelection(TextSelection(baseOffset: startOffset, extentOffset: endOffset));
  final firstBox = boxes.first.toRect();
  final rangeRect = boxes.skip(1).fold<Rect>(firstBox, (current, box) => current.expandToInclude(box.toRect()));
  return tester.getTopLeft(finder) + Offset(rangeRect.left + rangeRect.width * fraction, rangeRect.top + rangeRect.height / 2);
}
