  testWidgets('tmp mention tail paragraph and table', (tester) async {
    const renderedText = 'A@bobCtail';
    final controller = WenzRichTextController(
      document: const RichTextDocument(
        blocks: <BlockNode>[
          TextBlockNode(
            id: 'p',
            type: BlockType.paragraph,
            content: <InlineNode>[
              TextRun(text: 'A'),
              InlineEmbed(embedType: 'mention', data: <String, Object?>{'label': 'bob'}),
              TextRun(text: 'Ctail'),
            ],
          ),
          TableBlockNode(id: 't', table: TableModel(rows: <List<TableCellNode>>[
            <TableCellNode>[TableCellNode(id: 'c', blocks: <BlockNode>[
              TextBlockNode(id: 'ct', type: BlockType.paragraph, content: <InlineNode>[
                TextRun(text: 'A'),
                InlineEmbed(embedType: 'mention', data: <String, Object?>{'label': 'bob'}),
                TextRun(text: 'Ctail'),
              ]),
            ])],
          ])),
        ],
      ),
    );
