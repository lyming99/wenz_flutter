 4211: class _TableGridMetrics {
 4212:   const _TableGridMetrics({
 4213:     required this.width,
 4214:     required this.height,
 4215:     required this.columnWidths,
 4216:     required this.columnLefts,
 4217:     required this.cells,
 4218:   });
 4219: 
 4220:   final double width;
 4221:   final double height;
 4222:   final List<double> columnWidths;
 4223:   final List<double> columnLefts;
 4224:   final List<_TableGridCell> cells;
 4225: 
 4226:   static _TableGridMetrics compute({
 4227:     required TableModel table,
 4228:     required double maxWidth,
 4229:     required TextStyle textStyle,
 4230:     required TextDirection textDirection,
 4231:   }) {
 4232:     final columnCount = table.columnCount;
 4233:     final rowCount = table.rowCount;
 4234:     final columnWidths = _resolveTableColumnWidths(table, maxWidth);
 4235:     final rowHeights = List<double>.filled(
 4236:       rowCount,
 4237:       _minimumTableCellHeight(textStyle),
 4238:     );
 4239: 
 4240:     for (var row = 0; row < rowCount; row++) {
 4241:       for (var column = 0; column < columnCount; column++) {
 4242:         final cell = table.cellAt(row, column);
 4243:         if (cell == null || cell.covered) {
 4244:           continue;
 4245:         }
 4246:         final columnSpan = _clampedTableSpan(
 4247:           cell.columnSpan,
 4248:           column,
 4249:           columnCount,
 4250:         );
 4251:         final rowSpan = _clampedTableSpan(cell.rowSpan, row, rowCount);
 4252:         final cellWidth = _sumTableRange(columnWidths, column, columnSpan);
 4253:         final desiredHeight = _measureTableCellHeight(
 4254:           cell,
 4255:           textStyle,
 4256:           textDirection,
 4257:           cellWidth,
 4258:         );
 4259:         final currentHeight = _sumTableRange(rowHeights, row, rowSpan);
 4260:         if (desiredHeight > currentHeight) {
 4261:           final extra = (desiredHeight - currentHeight) / rowSpan;
 4262:           for (var i = 0; i < rowSpan; i++) {
 4263:             rowHeights[row + i] += extra;
 4264:           }
 4265:         }
 4266:       }
 4267:     }
 4268: 
 4269:     final lefts = _tableOffsets(columnWidths);
 4270:     final tops = _tableOffsets(rowHeights);
 4271:     final cells = <_TableGridCell>[];
 4272:     for (var row = 0; row < rowCount; row++) {
 4273:       for (var column = 0; column < columnCount; column++) {
 4274:         final cell = table.cellAt(row, column);
 4275:         if (cell == null || cell.covered) {
 4276:           continue;
 4277:         }
 4278:         final columnSpan = _clampedTableSpan(
 4279:           cell.columnSpan,
 4280:           column,
 4281:           columnCount,
 4282:         );
 4283:         final rowSpan = _clampedTableSpan(cell.rowSpan, row, rowCount);
 4284:         cells.add(
 4285:           _TableGridCell(
 4286:             rowIndex: row,
 4287:             columnIndex: column,
 4288:             cell: cell,
 4289:             left: lefts[column],
 4290:             top: tops[row],
 4291:             width: _sumTableRange(columnWidths, column, columnSpan),
 4292:             height: _sumTableRange(rowHeights, row, rowSpan),
 4293:           ),
 4294:         );
 4295:       }
 4296:     }
 4297: 
 4298:     return _TableGridMetrics(
 4299:       width: _sumTableRange(columnWidths, 0, columnWidths.length),
 4300:       height: _sumTableRange(rowHeights, 0, rowHeights.length),
 4301:       columnWidths: columnWidths,
 4302:       columnLefts: lefts,
 4303:       cells: cells,
 4304:     );
 4305:   }
 4306: }
