 4308: class _TableGridCell {
 4309:   const _TableGridCell({
 4310:     required this.rowIndex,
 4311:     required this.columnIndex,
 4312:     required this.cell,
 4313:     required this.left,
 4314:     required this.top,
 4315:     required this.width,
 4316:     required this.height,
 4317:   });
 4318: 
 4319:   final int rowIndex;
 4320:   final int columnIndex;
 4321:   final TableCellNode cell;
 4322:   final double left;
 4323:   final double top;
 4324:   final double width;
 4325:   final double height;
 4326: }
 4327: 
 4328: List<double> _resolveTableColumnWidths(TableModel table, double maxWidth) {
 4329:   final columnCount = table.columnCount;
 4330:   final widths = List<double>.filled(columnCount, 0);
 4331:   var fixedWidth = 0.0;
 4332:   var flexCount = 0;
 4333:   for (var i = 0; i < columnCount; i++) {
 4334:     final explicit = table.columnWidths[i];
 4335:     if (explicit != null && explicit > 0) {
 4336:       widths[i] = explicit;
 4337:       fixedWidth += explicit;
 4338:     } else {
 4339:       flexCount += 1;
 4340:     }
 4341:   }
 4342:   if (flexCount == 0) {
 4343:     return widths;
 4344:   }
 4345:   final remaining = maxWidth - fixedWidth;
 4346:   final flexWidth = remaining > 0 ? remaining / flexCount : 80.0;
 4347:   for (var i = 0; i < columnCount; i++) {
 4348:     if (widths[i] == 0) {
 4349:       widths[i] = flexWidth;
 4350:     }
 4351:   }
 4352:   return widths;
 4353: }
 4354: 
 4355: double _measureTableCellHeight(
 4356:   TableCellNode cell,
 4357:   TextStyle textStyle,
 4358:   TextDirection textDirection,
 4359:   double cellWidth,
 4360: ) {
 4361:   final effectiveTextStyle = cell.isHeader
 4362:       ? textStyle.copyWith(fontWeight: FontWeight.w600)
 4363:       : textStyle;
 4364:   final text = _tableCellDisplayText(cell);
 4365:   final displayText = text.isEmpty ? ' ' : text;
 4366:   final innerWidth = cellWidth - 16;
 4367:   final painter = TextPainter(
 4368:     text: TextSpan(text: displayText, style: effectiveTextStyle),
 4369:     textAlign: TextAlign.start,
 4370:     textDirection: textDirection,
 4371:   )..layout(maxWidth: innerWidth > 0 ? innerWidth : 0);
 4372:   final height = painter.height + 16;
 4373:   painter.dispose();
 4374:   final minimum = _minimumTableCellHeight(textStyle);
 4375:   return height > minimum ? height : minimum;
 4376: }
 4377: 
 4378: List<InlineNode> _tableCellInlineContent(TableCellNode? cell) {
 4379:   if (cell == null) {
 4380:     return const <InlineNode>[];
 4381:   }
 4382:   for (final block in cell.blocks) {
 4383:     if (block is TextBlockNode) {
 4384:       return block.content;
 4385:     }
 4386:   }
 4387:   return <InlineNode>[TextRun(text: cell.plainText)];
 4388: }
 4389: 
 4390: String _tableCellDisplayText(TableCellNode cell) {
 4391:   final inline = _tableCellInlineContent(cell);
 4392:   if (inline.isEmpty) {
 4393:     return cell.plainText;
 4394:   }
 4395:   return inline.map(_inlineDisplayText).join();
 4396: }
 4397: 
 4398: double _minimumTableCellHeight(TextStyle textStyle) {
 4399:   return ((textStyle.fontSize ?? 14) * _kBlockMinHeightFactor) + 16;
 4400: }
 4401: 
 4402: int _clampedTableSpan(int span, int start, int count) {
 4403:   final normalized = span < 1 ? 1 : span;
 4404:   final available = count - start;
 4405:   if (available <= 0) {
 4406:     return 1;
 4407:   }
 4408:   return normalized > available ? available : normalized;
 4409: }
 4410: 
 4411: List<double> _tableOffsets(List<double> sizes) {
 4412:   var offset = 0.0;
 4413:   final offsets = <double>[];
 4414:   for (final size in sizes) {
 4415:     offsets.add(offset);
 4416:     offset += size;
 4417:   }
 4418:   return offsets;
 4419: }
 4420: 
 4421: double _sumTableRange(List<double> values, int start, int count) {
 4422:   var result = 0.0;
 4423:   final end = start + count;
 4424:   for (var i = start; i < end && i < values.length; i++) {
 4425:     result += values[i];
 4426:   }
 4427:   return result;
 4428: }
 4429: 
 4430: bool _shouldHighlightTableCell(
 4431:   DocumentSelection? selection,
 4432:   String tableBlockId,
 4433:   int blockIndex,
 4434:   int rowIndex,
 4435:   int columnIndex,
 4436: ) {
 4437:   if (selection == null || selection.isCollapsed) {
 4438:     return false;
 4439:   }
 4440:   // Intra-table cell range (drag within the table): highlight cells inside the
 4441:   // range via the structured TableCellRange.
 4442:   final range = selection.tableCellRange;
 4443:   if (range != null) {
 4444:     if (range.isSingleCell) {
 4445:       return false;
 4446:     }
 4447:     return range.tableBlockId == tableBlockId &&
 4448:         range.blockIndex == blockIndex &&
 4449:         range.containsCell(rowIndex, columnIndex);
 4450:   }
 4451:   // Cross-block selection that spans this table block (e.g. select-all across
 4452:   // a paragraph + table): when the table block sits strictly between the
 4453:   // selection endpoints, every cell is part of the selection and highlights.
 4454:   final start = selection.start;
 4455:   final end = selection.end;
 4456:   final tableCovered =
 4457:       start.blockIndex < blockIndex && end.blockIndex > blockIndex;
 4458:   if (tableCovered) {
 4459:     return true;
 4460:   }
 4461:   final cellPath = PositionPath.tableCellText(
 4462:     tableBlockId,
 4463:     rowIndex,
 4464:     columnIndex,
 4465:   );
 4466:   if (start.blockIndex == blockIndex &&
 4467:       start.path.isTableCellText &&
 4468:       end.blockIndex > blockIndex) {
 4469:     return start.blockId == tableBlockId && cellPath.compare(start.path) > 0;
 4470:   }
 4471:   if (end.blockIndex == blockIndex &&
 4472:       end.path.isTableCellText &&
 4473:       start.blockIndex < blockIndex) {
 4474:     return end.blockId == tableBlockId && cellPath.compare(end.path) < 0;
 4475:   }
 4476:   return false;
 4477: }
