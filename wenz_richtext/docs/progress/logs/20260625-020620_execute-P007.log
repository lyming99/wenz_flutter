 3844: class _ViewportAwareTableToolbarState
 3845:     extends State<_ViewportAwareTableToolbar> {
 3846:   double? _top;
 3847: 
 3848:   double get _effectiveTop => _top ?? widget.preferredTop;
 3849: 
 3850:   @override
 3851:   Widget build(BuildContext context) {
 3852:     WidgetsBinding.instance.addPostFrameCallback((_) => _syncTopWithViewport());
 3853:     return PositionedDirectional(
 3854:       top: _effectiveTop,
 3855:       start: 0,
 3856:       child: widget.child,
 3857:     );
 3858:   }
 3859: 
 3860:   void _syncTopWithViewport() {
 3861:     if (!mounted) {
 3862:       return;
 3863:     }
 3864:     final renderObject = context.findRenderObject();
 3865:     final scrollable = Scrollable.maybeOf(context);
 3866:     final viewportObject = scrollable?.context.findRenderObject();
 3867:     if (renderObject is! RenderBox ||
 3868:         !renderObject.hasSize ||
 3869:         viewportObject is! RenderBox ||
 3870:         !viewportObject.hasSize) {
 3871:       _setTopIfNeeded(widget.preferredTop);
 3872:       return;
 3873:     }
 3874:     final toolbarTop = renderObject.localToGlobal(Offset.zero).dy;
 3875:     final stackTop = toolbarTop - _effectiveTop;
 3876:     final viewportTop = viewportObject.localToGlobal(Offset.zero).dy;
 3877:     if (stackTop < viewportTop) {
 3878:       final visibleTop = viewportTop - stackTop;
 3879:       _setTopIfNeeded(math.max(widget.preferredTop, visibleTop));
 3880:       return;
 3881:     }
 3882:     _setTopIfNeeded(widget.preferredTop);
 3883:   }
 3884: 
 3885:   void _setTopIfNeeded(double nextTop) {
 3886:     if ((_effectiveTop - nextTop).abs() < 0.5) {
 3887:       return;
 3888:     }
 3889:     setState(() {
 3890:       _top = nextTop;
 3891:     });
 3892:   }
 3893: }
