      final rect = box.localToGlobal(Offset.zero) & box.size;
      final dx = global.dx < rect.left
          ? rect.left - global.dx
          : (global.dx > rect.right ? global.dx - rect.right : 0.0);
      final dy = global.dy < rect.top
          ? rect.top - global.dy
          : (global.dy > rect.bottom ? global.dy - rect.bottom : 0.0);
