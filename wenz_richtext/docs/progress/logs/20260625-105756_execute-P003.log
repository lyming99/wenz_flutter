    final offset = clampToEnd ? nearest.textLength : 0;
    return DocumentPosition(
      blockId: nearest.blockId,
      blockIndex: nearest.blockIndex,
      path: nearest.path,
      offset: offset,
    );
  }

  /// Returns the global [Rect] of the block whose hit-test box contains
