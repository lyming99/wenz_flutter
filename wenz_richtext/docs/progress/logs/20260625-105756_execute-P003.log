  466:   /// registry.register(BlockType.image, myImageRenderer);
  467:   /// ```
  468:   static void installDefaultRenderers(BlockRendererRegistry registry) {
  469:     registry
  470:       ..register(BlockType.paragraph, _defaultTextBlockRenderer)
  471:       ..register(BlockType.heading, _defaultTextBlockRenderer)
  472:       ..register(BlockType.quote, _defaultTextBlockRenderer)
  473:       ..register(BlockType.listItem, _defaultTextBlockRenderer)
  474:       ..register(BlockType.code, _defaultCodeBlockRenderer)
  475:       ..register(BlockType.image, _defaultImageBlockRenderer)
  476:       ..register(BlockType.table, _defaultTableBlockRenderer)
  477:       ..register(BlockType.divider, _defaultDividerBlockRenderer)
  478:       ..register(BlockType.video, _defaultVideoBlockRenderer)
  479:       ..register(BlockType.embed, _defaultBlockEmbedRenderer)
  480:       ..register(BlockType.callout, _defaultCalloutBlockRenderer)
  481:       ..register(BlockType.file, _defaultFileBlockRenderer);
  482:   }
