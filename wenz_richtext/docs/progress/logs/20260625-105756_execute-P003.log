   3: import '../core/position/document_position.dart';
   4: 
   5: /// Resolves a global screen coordinate to a [DocumentPosition] across all
   6: /// registered editable blocks.
   7: ///
   8: /// Each [_TextSelectionSurface] registers itself (via [register]) with its
   9: /// block id, path, text length, a [GlobalKey] on its render object, and a
  10: /// callback that converts a *local* offset to a character offset using its
  11: /// own [TextLayoutService]. The document-level gesture overlay queries the
  12: /// registry during a drag to map the pointer position to a document position,
  13: /// which may live in a different block than where the drag started — enabling
  14: /// cross-block drag selection.
  15: class BlockGeometryRegistry {
  16:   BlockGeometryRegistry();
  17: 
  18:   /// Entries in block-index order, for ordered traversal (hit-testing,
  19:   /// nearest-block clamping, average height).
  20:   final List<BlockEntry> _entries = <BlockEntry>[];
  21: 
  22:   /// O(1) lookup by (blockId, path). Kept in sync with [_entries] on
  23:   /// register/unregister so hot paths (caret rect, word range, vertical move —
  24:   /// hit on every IME keystroke and every drag move) avoid a linear scan.
  25:   final Map<String, BlockEntry> _byKey = <String, BlockEntry>{};
  26: 
  27:   /// Top-level block row boxes, keyed by block id. These are wider than the
  28:   /// editable text/object selection surfaces and therefore suit row-level drag
  29:   /// sorting, including custom renderers that do not register text geometry.
  30:   final List<BlockRowGeometryEntry> _rowEntries = <BlockRowGeometryEntry>[];
  31:   final Map<String, BlockRowGeometryEntry> _rowByBlockId =
  32:       <String, BlockRowGeometryEntry>{};
  33: 
  34:   final Set<GlobalKey> _selectionExclusionKeys = <GlobalKey>{};
  35: 
  36:   /// Registers a block/path surface. Replaces any prior entry with the same
  37:   /// [blockId] and [BlockEntry.path].
  38:   void register(BlockEntry entry) {
  39:     final key = _key(entry.blockId, entry.path);
  40:     final existing = _byKey[key];
  41:     if (existing != null) {
  42:       final index = _entries.indexOf(existing);
  43:       _entries[index] = entry;
  44:     } else {
  45:       _entries.add(entry);
  46:       _entries.sort((a, b) {
  47:         final blockOrder = a.blockIndex.compareTo(b.blockIndex);
  48:         if (blockOrder != 0) {
  49:           return blockOrder;
  50:         }
  51:         return a.path.compare(b.path);
  52:       });
  53:     }
  54:     _byKey[key] = entry;
  55:   }
  56: 
  57:   /// Removes the entry for [blockId] and [path], if present. When [path] is not
  58:   /// provided, removes every surface for [blockId]. If [ownerKey] is provided,
  59:   /// the entry is removed only when it is still owned by that surface.
  60:   void unregister(String blockId, [PositionPath? path, GlobalKey? ownerKey]) {
  61:     if (path != null) {
  62:       final key = _key(blockId, path);
  63:       final entry = _byKey[key];
  64:       if (ownerKey != null && entry?.key != ownerKey) {
  65:         return;
  66:       }
  67:       _byKey.remove(key);
  68:       if (entry != null) {
  69:         _entries.remove(entry);
  70:       }
  71:       return;
  72:     }
  73:     _entries.removeWhere((e) {
  74:       if (e.blockId != blockId) {
  75:         return false;
  76:       }
  77:       if (ownerKey != null && e.key != ownerKey) {
  78:         return false;
  79:       }
  80:       _byKey.remove(_key(e.blockId, e.path));
  81:       return true;
  82:     });
  83:   }
  84: 
  85:   /// Registers a top-level block row surface for drag-reorder hit testing.
  86:   void registerBlockRow(BlockRowGeometryEntry entry) {
  87:     final existing = _rowByBlockId[entry.blockId];
  88:     if (existing != null) {
  89:       final index = _rowEntries.indexOf(existing);
  90:       if (index >= 0) {
  91:         _rowEntries[index] = entry;
  92:       }
  93:     } else {
  94:       _rowEntries.add(entry);
  95:     }
  96:     _rowByBlockId[entry.blockId] = entry;
  97:     _rowEntries.sort((a, b) => a.blockIndex.compareTo(b.blockIndex));
  98:   }
  99: 
 100:   /// Removes a top-level block row surface when the owning widget unmounts.
 101:   void unregisterBlockRow(String blockId, GlobalKey ownerKey) {
 102:     final entry = _rowByBlockId[blockId];
 103:     if (entry == null || entry.key != ownerKey) {
 104:       return;
 105:     }
 106:     _rowByBlockId.remove(blockId);
 107:     _rowEntries.remove(entry);
 108:   }
 109: 
 110:   /// Registers an interactive control that should not start document selection.
 111:   void registerSelectionExclusion(GlobalKey key) {
 112:     _selectionExclusionKeys.add(key);
 113:   }
 114: 
 115:   void unregisterSelectionExclusion(GlobalKey key) {
 116:     _selectionExclusionKeys.remove(key);
 117:   }
 118: 
 119:   bool isSelectionExcluded(Offset global) {
 120:     for (final key in _selectionExclusionKeys) {
 121:       final renderObject = key.currentContext?.findRenderObject();
 122:       if (renderObject is! RenderBox || !renderObject.hasSize) {
 123:         continue;
 124:       }
 125:       final local = renderObject.globalToLocal(global);
 126:       if (local.dx >= 0 &&
 127:           local.dx <= renderObject.size.width &&
 128:           local.dy >= 0 &&
 129:           local.dy <= renderObject.size.height) {
 130:         return true;
 131:       }
 132:     }
 133:     return false;
 134:   }
 135: 
 136:   static String _key(String blockId, PositionPath path) =>
 137:       '$blockId@${path.hashCode}';
 138: 
 139:   /// All registered entries in block-index order.
 140:   @visibleForTesting
 141:   List<BlockEntry> get entries => List<BlockEntry>.unmodifiable(_entries);
 142: 
 143:   @visibleForTesting
 144:   List<BlockRowGeometryEntry> get rowEntries =>
 145:       List<BlockRowGeometryEntry>.unmodifiable(_rowEntries);
 146: 
 147:   /// Resolves a global pointer offset to the legal row insertion boundary used
 148:   /// by top-level block drag sorting. Misses are clamped to the first/last
 149:   /// mounted row so dragging slightly outside the viewport still lands on a
 150:   /// valid insertion point.
 151:   BlockReorderDropTarget? blockReorderDropTargetFromGlobalOffset(
 152:     Offset global,
 153:   ) {
 154:     final rows = <({BlockRowGeometryEntry entry, Rect rect})>[];
 155:     for (final entry in _rowEntries) {
 156:       final box = entry.renderBox;
 157:       if (box == null || !box.hasSize) {
 158:         continue;
 159:       }
 160:       rows.add((
 161:         entry: entry,
 162:         rect: box.localToGlobal(Offset.zero) & box.size,
 163:       ));
 164:     }
 165:     if (rows.isEmpty) {
 166:       return null;
 167:     }
 168:     rows.sort((a, b) => a.entry.blockIndex.compareTo(b.entry.blockIndex));
 169: 
 170:     final first = rows.first;
 171:     if (global.dy <= first.rect.top) {
 172:       return BlockReorderDropTarget(
 173:         blockId: first.entry.blockId,
 174:         blockIndex: first.entry.blockIndex,
 175:         placement: BlockReorderDropPlacement.before,
 176:         blockRect: first.rect,
 177:       );
 178:     }
 179: 
 180:     for (var index = 0; index < rows.length; index++) {
 181:       final current = rows[index];
 182:       final rect = current.rect;
 183:       if (global.dy < rect.top) {
 184:         final previous = rows[index - 1];
 185:         final gapMidY = (previous.rect.bottom + rect.top) / 2;
 186:         if (global.dy < gapMidY) {
 187:           return BlockReorderDropTarget(
 188:             blockId: previous.entry.blockId,
 189:             blockIndex: previous.entry.blockIndex,
 190:             placement: BlockReorderDropPlacement.after,
 191:             blockRect: previous.rect,
 192:           );
 193:         }
 194:         return BlockReorderDropTarget(
 195:           blockId: current.entry.blockId,
 196:           blockIndex: current.entry.blockIndex,
 197:           placement: BlockReorderDropPlacement.before,
 198:           blockRect: rect,
 199:         );
 200:       }
 201:       if (global.dy <= rect.bottom) {
 202:         return BlockReorderDropTarget(
 203:           blockId: current.entry.blockId,
 204:           blockIndex: current.entry.blockIndex,
 205:           placement: global.dy < rect.center.dy
 206:               ? BlockReorderDropPlacement.before
 207:               : BlockReorderDropPlacement.after,
 208:           blockRect: rect,
 209:         );
 210:       }
 211:     }
 212: 
 213:     final last = rows.last;
 214:     return BlockReorderDropTarget(
 215:       blockId: last.entry.blockId,
 216:       blockIndex: last.entry.blockIndex,
 217:       placement: BlockReorderDropPlacement.after,
 218:       blockRect: last.rect,
 219:     );
 220:   }
