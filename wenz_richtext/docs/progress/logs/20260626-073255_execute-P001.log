                    scrollDirection: Axis.horizontal,
                    child: SizedBox(
                      width: contentWidth,
                      child: _TextSelectionSurface(
                        blockId: block.id,
                        blockIndex: blockIndex,
                        path: path,
                        textLength: block.code.length,
                        textSpan: codeSpan,
                        offsetMapper: _InlineOffsetMapper.identity(
