+  'true',
+  'try',
+  'typedef',
+  'var',
+  'void',
+  'when',
+  'while',
+  'with',
+  'yield',
+};
+
+const Set<String> _dartTypes = <String>{
+  'BigInt',
+  'bool',
+  'DateTime',
+  'double',
+  'Duration',
+  'dynamic',
+  'Future',
+  'int',
+  'Iterable',
+  'List',
+  'Map',
+  'Never',
+  'num',
+  'Object',
+  'Pattern',
