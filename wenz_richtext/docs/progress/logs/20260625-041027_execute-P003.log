+
+bool _isIdentifierStart(int char) {
+  return (char >= _lowerACodeUnit && char <= _lowerZCodeUnit) ||
+      (char >= _upperACodeUnit && char <= _upperZCodeUnit) ||
+      char == _underscoreCodeUnit ||
+      char == _dollarCodeUnit;
