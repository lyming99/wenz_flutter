+          char == _plusCodeUnit ||
+          char == _asteriskCodeUnit) &&
+      start + 1 < lineEnd &&
+      _isWhitespace(code.codeUnitAt(start + 1))) {
+    return start + 1;
+  }
+  if (!_isDigit(char)) {
