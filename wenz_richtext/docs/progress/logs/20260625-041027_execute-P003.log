+    final start = token.start.clamp(0, codeLength).toInt();
+    final end = token.end.clamp(start, codeLength).toInt();
+    if (end <= cursor) {
+      continue;
+    }
+    normalized.add(_CodeSyntaxToken(
+      start < cursor ? cursor : start,
+      end,
+      token.kind,
+    ));
+    cursor = end;
+  }
