+        if (urlEnd > labelEnd) {
+          tokens.add(_CodeSyntaxToken(
+            index,
+            index + 1,
+            _CodeSyntaxTokenKind.marker,
+          ));
+          tokens.add(_CodeSyntaxToken(
+            labelEnd,
+            labelEnd + 2,
+            _CodeSyntaxTokenKind.marker,
+          ));
+          tokens.add(_CodeSyntaxToken(
+            labelEnd + 2,
+            urlEnd,
+            _CodeSyntaxTokenKind.string,
+          ));
+          tokens.add(_CodeSyntaxToken(
+            urlEnd,
+            urlEnd + 1,
+            _CodeSyntaxTokenKind.marker,
