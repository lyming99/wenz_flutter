 5286:     // always drawn with a sensible height even when getFullHeightForCaret
 5287:     // returns null (e.g. at empty/whitespace runs).
 5288:     final height = layoutService.caretHeight(painter, safeOffset) ??
 5289:         painter.preferredLineHeight;
