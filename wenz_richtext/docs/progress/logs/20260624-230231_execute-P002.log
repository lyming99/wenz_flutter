  989: /// Whether [position] sits on a non-editable leaf that is the document's last
  990: /// block, so forward caret motion should escape it by appending a paragraph.
  991: ///
  992: /// Two cases:
  993: /// - An object block (image/divider/video/file) that is the final block. The
  994: ///   caret cannot live "inside" it, so Down/Right off it would otherwise stall.
  995: /// - A table cell on the table's last row *and* last column when the table is
  996: ///   the final block.
  997: ///
  998: /// Editable blocks (paragraph/code) are excluded on purpose: Enter or typing
  999: /// already adds content there, and we must not auto-append a paragraph just
 1000: /// because the user arrowed off the end of a normal text block.
 1001: bool _isAtTrailingLeaf(RichTextDocument document, DocumentPosition position) {
 1002:   final block = _blockAt(document, position.blockIndex);
 1003:   if (block == null) {
 1004:     return false;
 1005:   }
 1006:   final isLastBlock = position.blockIndex == document.blocks.length - 1;
 1007:   if (position.path.isBlockObject) {
 1008:     return isLastBlock;
 1009:   }
 1010:   if (position.path.isTableCellText && block is TableBlockNode) {
 1011:     final rowIndex = position.path.tableRowIndex;
 1012:     final columnIndex = position.path.tableColumnIndex;
 1013:     if (rowIndex == null || columnIndex == null) {
 1014:       return false;
 1015:     }
 1016:     return isLastBlock &&
 1017:         rowIndex == block.table.rowCount - 1 &&
 1018:         columnIndex == block.table.columnCount - 1;
 1019:   }
 1020:   return false;
 1021: }
 1022: 
 1023: /// Appends an empty paragraph after [afterBlockIndex] and returns a collapsed
 1024: /// selection inside it. Used as the escape hatch when forward caret motion runs
 1025: /// off the end of a trailing object/table block (mirrors the
 1026: /// `_insertRowAfterLastCell` pattern for Tab on the last table cell). Returns
 1027: /// `null` when there is no block to append after.
 1028: DocumentSelection? _appendParagraphAfter(
 1029:   DocumentSession session,
 1030:   int afterBlockIndex,
 1031: ) {
 1032:   if (afterBlockIndex < 0 ||
 1033:       afterBlockIndex >= session.document.blocks.length) {
 1034:     return null;
 1035:   }
 1036:   final afterBlock = session.document.blocks[afterBlockIndex];
 1037:   final nextBlockId = '${afterBlock.id}-next';
 1038:   final nextBlockIndex = afterBlockIndex + 1;
 1039:   final nextPosition = DocumentPosition.text(
 1040:     blockId: nextBlockId,
 1041:     blockIndex: nextBlockIndex,
 1042:     offset: 0,
 1043:   );
 1044:   InsertBlocksCommand(
 1045:     index: nextBlockIndex,
 1046:     blocks: <BlockNode>[
 1047:       TextBlockNode(
 1048:         id: nextBlockId,
 1049:         type: BlockType.paragraph,
 1050:         content: const <InlineNode>[],
 1051:       ),
 1052:     ],
 1053:     selection: DocumentSelection(base: nextPosition, extent: nextPosition),
 1054:   ).execute(session);
 1055:   // InsertBlocksCommand does not set session.selection itself (only the
 1056:   // executor does), so set it here so the caller's returned selection is real.
 1057:   session.selection =
 1058:       DocumentSelection(base: nextPosition, extent: nextPosition);
 1059:   return session.selection;
 1060: }
 1061: 
 1062: int _editableLength(BlockNode block) {
 1063:   if (block is TextBlockNode) {
 1064:     return inlineNodesLength(block.content);
 1065:   }
 1066:   if (block is CodeBlockNode) {
 1067:     return block.code.length;
 1068:   }
 1069:   return 0;
 1070: }

