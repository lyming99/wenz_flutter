 421:       for (var column = left; column <= right; column++) {
 422:         final cell = tableBlock.table.cellAt(row, column);
 423:         if (cell == null ||
 424:             cell.covered ||
 425:             cell.rowSpan != 1 ||
 426:             cell.columnSpan != 1) {
 427:           return const CommandResult(recordHistory: false);
