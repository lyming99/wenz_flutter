 436:           id: cell.id,
 437:           blocks: cell.blocks.map((block) => block.copy()).toList(),
 438:           rowSpan: row == top && column == left ? bottom - top + 1 : 1,
 439:           columnSpan: row == top && column == left ? right - left + 1 : 1,
 440:           isHeader: cell.isHeader,
