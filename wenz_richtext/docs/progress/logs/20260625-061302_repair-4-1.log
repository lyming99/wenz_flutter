+  final uri = Uri.tryParse(trimmed);
+  final segments =
+      uri?.pathSegments.where((segment) => segment.trim().isNotEmpty).toList();
+  final fileName = segments?.isNotEmpty == true ? segments!.last : trimmed;
+  return 'Cover: $fileName';
