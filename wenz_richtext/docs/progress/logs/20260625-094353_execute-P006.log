388`t  /// the generic [BlockType.embed] renderer.
389`t  void unregisterEmbed(String embedType) {
390`t    _embedBuilders.remove(embedType);
391`t  }
392`t
393`t  /// Whether a builder is registered for [embedType].
394`t  bool hasEmbed(String embedType) => _embedBuilders.containsKey(embedType);
395`t
396`t  /// Resolves the best builder for [block]. Custom [BlockEmbedNode.embedType]
397`t  /// builders win over the generic [BlockType.embed] builder; all other blocks
398`t  /// use their [BlockType] mapping.
399`t  BlockRendererBuilder resolveForBlock(
400`t    BlockNode block, {
