7583`tclass _DashedRRectBorderPainter extends CustomPainter {
7584`t  const _DashedRRectBorderPainter({
7585`t    required this.color,
7586`t    required this.radius,
7587`t    this.strokeWidth = 1,
7588`t    this.dashLength = 7,
7589`t    this.gapLength = 4,
7590`t  });
7591`t
7592`t  final Color color;
7593`t  final double radius;
7594`t  final double strokeWidth;
7595`t  final double dashLength;
7596`t  final double gapLength;
7597`t
7598`t  @override
7599`t  void paint(Canvas canvas, Size size) {
7600`t    final paint = Paint()
7601`t      ..color = color
7602`t      ..style = PaintingStyle.stroke
7603`t      ..strokeWidth = strokeWidth;
7604`t    final path = Path()
7605`t      ..addRRect(
7606`t        RRect.fromRectAndRadius(
7607`t          Offset.zero & size,
7608`t          Radius.circular(radius),
7609`t        ).deflate(strokeWidth / 2),
7610`t      );
7611`t    for (final metric in path.computeMetrics()) {
7612`t      var distance = 0.0;
7613`t      while (distance < metric.length) {
7614`t        final end = math.min(distance + dashLength, metric.length);
7615`t        canvas.drawPath(metric.extractPath(distance, end), paint);
7616`t        distance += dashLength + gapLength;
7617`t      }
7618`t    }
7619`t  }
7620`t
7621`t  @override
7622`t  bool shouldRepaint(covariant _DashedRRectBorderPainter oldDelegate) {
7623`t    return oldDelegate.color != color ||
7624`t        oldDelegate.radius != radius ||
7625`t        oldDelegate.strokeWidth != strokeWidth ||
7626`t        oldDelegate.dashLength != dashLength ||
7627`t        oldDelegate.gapLength != gapLength;
7628`t  }
7629`t}
