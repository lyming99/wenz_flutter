377`t  /// previous builder lets callers chain or wrap an existing business renderer.
378`t  BlockRendererBuilder? registerEmbed(
379`t    String embedType,
380`t    BlockRendererBuilder builder,
381`t  ) {
382`t    final previous = _embedBuilders[embedType];
383`t    _embedBuilders[embedType] = builder;
384`t    return previous;
385`t  }
386`t
