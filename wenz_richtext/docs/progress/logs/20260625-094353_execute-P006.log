337`t  final Map<BlockType, BlockRendererBuilder> _builders =
338`t      <BlockType, BlockRendererBuilder>{};
339`t  final Map<String, BlockRendererBuilder> _embedBuilders =
340`t      <String, BlockRendererBuilder>{};
341`t
342`t  /// Registered block types in insertion order.
343`t  Iterable<BlockType> get blockTypes => _builders.keys;
344`t
345`t  /// Registered custom block embed types in insertion order.
346`t  Iterable<String> get embedTypes => _embedBuilders.keys;
347`t
348`t  /// Registers [builder] for [type], replacing any existing builder for that
349`t  /// type. Returning the previous builder (if any) lets callers chain or wrap
350`t  /// the default renderer.
351`t  BlockRendererBuilder? register(BlockType type, BlockRendererBuilder builder) {
352`t    final previous = _builders[type];
353`t    _builders[type] = builder;
354`t    return previous;
355`t  }
356`t
357`t  /// Removes the builder for [type], if any. The editor falls back to its
358`t  /// plain-text default for that type.
359`t  void unregister(BlockType type) {
360`t    _builders.remove(type);
361`t  }
362`t
363`t  /// Returns the builder for [type], falling back to [fallback] when none is
364`t  /// registered. The editor passes a plain-text fallback so unknown block types
365`t  /// always render *something*.
366`t  BlockRendererBuilder resolve(
367`t    BlockType type, {
368`t    required BlockRendererBuilder fallback,
369`t  }) {
370`t    return _builders[type] ?? fallback;
371`t  }
372`t
373`t  /// Whether a builder is registered for [type].
374`t  bool has(BlockType type) => _builders.containsKey(type);
375`t
