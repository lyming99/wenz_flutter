324`t/// [WenzRichTextEditor.blockRenderers] parameter — when omitted the editor
325`t/// builds a private registry with the defaults already installed.
326`tclass BlockRendererRegistry {
327`t  BlockRendererRegistry({
328`t    Map<BlockType, BlockRendererBuilder> builders =
329`t        const <BlockType, BlockRendererBuilder>{},
330`t    Map<String, BlockRendererBuilder> embedBuilders =
331`t        const <String, BlockRendererBuilder>{},
332`t  }) {
333`t    _builders.addAll(builders);
334`t    _embedBuilders.addAll(embedBuilders);
335`t  }
