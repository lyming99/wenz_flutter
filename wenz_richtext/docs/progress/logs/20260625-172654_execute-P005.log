 1437:       return null;
 1438:     }
 1439:     return TableCellRange(
 1440:       tableBlockId: tableBlock.id,
 1441:       blockIndex: range.blockIndex,
 1442:       startRow: range.startRow.clamp(0, rowCount - 1).toInt(),
 1443:       endRow: range.endRow.clamp(0, rowCount - 1).toInt(),
 1444:       startColumn: range.startColumn.clamp(0, columnCount - 1).toInt(),
 1445:       endColumn: range.endColumn.clamp(0, columnCount - 1).toInt(),
 1446:     );
