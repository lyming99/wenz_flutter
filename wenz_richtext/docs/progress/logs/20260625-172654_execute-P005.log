  385: class MergeTableCellsCommand extends EditorCommand {
  386:   const MergeTableCellsCommand({
  387:     required this.blockIndex,
  388:     required this.startRow,
  389:     required this.startColumn,
  390:     required this.endRow,
  391:     required this.endColumn,
  392:   });
  393: 
  394:   final int blockIndex;
  395:   final int startRow;
  396:   final int startColumn;
  397:   final int endRow;
  398:   final int endColumn;
  399: 
  400:   @override
  401:   String get description => 'mergeTableCells';
  402: 
  403:   @override
  404:   CommandResult execute(DocumentSession session) {
  405:     final tableBlock = tableAt(session, blockIndex);
  406:     if (tableBlock == null) {
  407:       return const CommandResult(recordHistory: false);
  408:     }
  409:     final top = startRow <= endRow ? startRow : endRow;
  410:     final bottom = startRow <= endRow ? endRow : startRow;
  411:     final left = startColumn <= endColumn ? startColumn : endColumn;
  412:     final right = startColumn <= endColumn ? endColumn : startColumn;
  413:     if (top < 0 ||
  414:         left < 0 ||
  415:         bottom >= tableBlock.table.rowCount ||
  416:         right >= tableBlock.table.columnCount ||
  417:         (top == bottom && left == right)) {
  418:       return const CommandResult(recordHistory: false);
  419:     }
  420:     for (var row = top; row <= bottom; row++) {
  421:       for (var column = left; column <= right; column++) {
  422:         final cell = tableBlock.table.cellAt(row, column);
  423:         if (cell == null ||
  424:             cell.covered ||
  425:             cell.rowSpan != 1 ||
  426:             cell.columnSpan != 1) {
  427:           return const CommandResult(recordHistory: false);
  428:         }
  429:       }
  430:     }
  431:     final rows = tableBlock.table.rows.map(copyRow).toList();
  432:     for (var row = top; row <= bottom; row++) {
  433:       for (var column = left; column <= right; column++) {
  434:         final cell = rows[row][column];
  435:         rows[row][column] = TableCellNode(
  436:           id: cell.id,
  437:           blocks: cell.blocks.map((block) => block.copy()).toList(),
  438:           rowSpan: row == top && column == left ? bottom - top + 1 : 1,
  439:           columnSpan: row == top && column == left ? right - left + 1 : 1,
  440:           isHeader: cell.isHeader,
  441:           backgroundColor: cell.backgroundColor,
  442:           covered: !(row == top && column == left),
  443:         );
  444:       }
  445:     }
  446:     return _replaceTableWithSelection(
  447:       session,
  448:       blockIndex,
  449:       tableBlock,
  450:       rows,
  451:       selection: cellSelection(tableBlock.id, blockIndex, top, left, 0),
  452:       columnAlignments: tableBlock.table.columnAlignments,
  453:       columnWidths: tableBlock.table.columnWidths,
  454:     );
  455:   }
  456: }
