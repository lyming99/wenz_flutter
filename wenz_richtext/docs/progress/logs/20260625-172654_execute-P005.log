 1430:   TableCellRange? _normalizeTableRange(
 1431:     TableBlockNode tableBlock,
 1432:     TableCellRange range,
 1433:   ) {
 1434:     final rowCount = tableBlock.table.rowCount;
 1435:     final columnCount = tableBlock.table.columnCount;
