 3956: Offset _globalTextOffset(WidgetTester tester, String text, int offset) {
 3957:   final finder = _richText(text);
 3958:   final richText = tester.widget<RichText>(finder);
 3959:   final size = tester.getSize(finder);
 3960:   final painter = TextPainter(
 3961:     text: richText.text,
 3962:     textAlign: richText.textAlign,
 3963:     textDirection: TextDirection.ltr,
 3964:   )..layout(maxWidth: size.width);
 3965:   final local = painter.getOffsetForCaret(
 3966:     TextPosition(offset: offset),
 3967:     Rect.zero,
 3968:   );
 3969:   return tester.getTopLeft(finder) +
 3970:       local +
 3971:       Offset(1, painter.preferredLineHeight / 2);
 3972: }
