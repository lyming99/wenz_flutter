 3922: List<String> _underlinedTexts(InlineSpan span) {
 3923:   final result = <String>[];
 3924: 
 3925:   void visit(InlineSpan current, TextStyle? inheritedStyle) {
 3926:     if (current is! TextSpan) {
 3927:       return;
 3928:     }
 3929:     final style = current.style ?? inheritedStyle;
 3930:     final text = current.text;
 3931:     if (text != null &&
 3932:         text.isNotEmpty &&
 3933:         style?.decoration?.contains(TextDecoration.underline) == true) {
 3934:       result.add(text);
 3935:     }
 3936:     final children = current.children;
 3937:     if (children != null) {
 3938:       for (final child in children) {
 3939:         visit(child, style);
 3940:       }
 3941:     }
 3942:   }
 3943: 
 3944:   visit(span, null);
 3945:   return result;
 3946: }
