diff --git a/wenz_richtext/test/p001_inline_embed_repro_tmp_test.dart b/wenz_richtext/test/p001_inline_embed_repro_tmp_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..74201ee34205d8ece25ce64879287f5c88751ce4
--- /dev/null
+++ b/wenz_richtext/test/p001_inline_embed_repro_tmp_test.dart
@@ -0,0 +1,212 @@
+import 'package:flutter/material.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:wenz_richtext/wenz_richtext.dart';
+
+void main() {
+  testWidgets('P001 paragraph inline embed selection diagnostics',
+      (tester) async {
+    final controller = WenzRichTextController(
+      document: _inlineDocument(table: false),
+      selection: _collapsedText('p1', 0, 0),
+    );
+    await _pumpEditor(tester, controller);
+
+    const displayText = 'A\u{1F604}B@bobC';
+    print('P001 paragraph displayLength=${displayText.length} docLength=5');
+
+    await tester.tapAt(_globalTextOffset(tester, displayText, 6));
+    await tester.pump();
+    print('P001 paragraph tap mention center -> ${_describe(controller)}');
+
+    await _dragBetween(tester, displayText, 1, 3);
+    print('P001 paragraph drag emoji visual[1,3] -> ${_describe(controller)}');
+
+    await _dragBetween(tester, displayText, 4, 8);
+    print('P001 paragraph drag mention visual[4,8] -> ${_describe(controller)}');
+
+    controller.setSelection(_collapsedText('p1', 0, 3));
+    await tester.pump();
+    await tester.sendKeyDownEvent(LogicalKeyboardKey.shiftLeft);
+    await tester.sendKeyEvent(LogicalKeyboardKey.arrowRight);
+    await tester.sendKeyUpEvent(LogicalKeyboardKey.shiftLeft);
+    await tester.pump();
+    print('P001 paragraph Shift+Right before mention -> ${_describe(controller)}');
+
+    controller.setSelection(_collapsedText('p1', 0, 0));
+    await tester.pump();
+    await _sendCtrlA(tester);
+    await tester.pump();
+    print(
+      'P001 paragraph Ctrl+A -> ${_describe(controller)} '
+      'visualCoverageIfPainterUsesDocOffsets="${displayText.substring(0, 5)}"',
+    );
+  });
+
+  testWidgets('P001 table-cell inline embed selection diagnostics',
+      (tester) async {
+    final controller = WenzRichTextController(
+      document: _inlineDocument(table: true),
+      selection: _collapsedCell(0),
+    );
+    await _pumpEditor(tester, controller);
+
+    const displayText = 'A\u{1F604}B@bobC';
+    print('P001 table displayLength=${displayText.length} docLength=5');
+
+    await tester.tapAt(_globalTextOffset(tester, displayText, 6));
+    await tester.pump();
+    print('P001 table tap mention center -> ${_describe(controller)}');
+
+    await _dragBetween(tester, displayText, 1, 3);
+    print('P001 table drag emoji visual[1,3] -> ${_describe(controller)}');
+
+    await _dragBetween(tester, displayText, 4, 8);
+    print('P001 table drag mention visual[4,8] -> ${_describe(controller)}');
+
+    controller.setSelection(_collapsedCell(3));
+    await tester.pump();
+    await tester.sendKeyDownEvent(LogicalKeyboardKey.shiftLeft);
+    await tester.sendKeyEvent(LogicalKeyboardKey.arrowRight);
+    await tester.sendKeyUpEvent(LogicalKeyboardKey.shiftLeft);
+    await tester.pump();
+    print('P001 table Shift+Right before mention -> ${_describe(controller)}');
+
+    controller.setSelection(_collapsedCell(0));
+    await tester.pump();
+    await _sendCtrlA(tester);
+    await tester.pump();
+    print(
+      'P001 table Ctrl+A -> ${_describe(controller)} '
+      'visualCoverageIfPainterUsesDocOffsets="${displayText.substring(0, 5)}"',
+    );
+  });
+}
+
+RichTextDocument _inlineDocument({required bool table}) {
+  const content = <InlineNode>[
+    TextRun(text: 'A'),
+    InlineEmbed(embedType: 'emoji', data: <String, Object?>{'emoji': '\u{1F604}'}),
+    TextRun(text: 'B'),
+    InlineEmbed(embedType: 'mention', data: <String, Object?>{'label': 'bob'}),
+    TextRun(text: 'C'),
+  ];
+  if (!table) {
+    return const RichTextDocument(
+      blocks: <BlockNode>[
+        TextBlockNode(id: 'p1', type: BlockType.paragraph, content: content),
+      ],
+    );
+  }
+  return const RichTextDocument(
+    blocks: <BlockNode>[
+      TableBlockNode(
+        id: 'table1',
+        table: TableModel(
+          rows: <List<TableCellNode>>[
+            <TableCellNode>[
+              TableCellNode(
+                id: 'cell-a',
+                blocks: <BlockNode>[
+                  TextBlockNode(
+                    id: 'cell-p',
+                    type: BlockType.paragraph,
+                    content: content,
+                  ),
+                ],
+              ),
+            ],
+          ],
+        ),
+      ),
+    ],
+  );
+}
+
+Future<void> _pumpEditor(
+  WidgetTester tester,
+  WenzRichTextController controller,
+) async {
+  await tester.pumpWidget(
+    MaterialApp(
+      home: Scaffold(
+        body: WenzRichTextEditor(
+          controller: controller,
+          autofocus: true,
+          enableIme: false,
+        ),
+      ),
+    ),
+  );
+  await tester.pump();
+}
+
+Future<void> _dragBetween(
+  WidgetTester tester,
+  String text,
+  int startOffset,
+  int endOffset,
+) async {
+  final start = _globalTextOffset(tester, text, startOffset);
+  final end = _globalTextOffset(tester, text, endOffset);
+  await tester.dragFrom(start, end - start);
+  await tester.pump();
+}
+
+Offset _globalTextOffset(WidgetTester tester, String text, int offset) {
+  final finder = find.byWidgetPredicate(
+    (widget) => widget is RichText && widget.text.toPlainText() == text,
+  );
+  final richText = tester.widget<RichText>(finder);
+  final size = tester.getSize(finder);
+  final painter = TextPainter(
+    text: richText.text,
+    textAlign: richText.textAlign,
+    textDirection: TextDirection.ltr,
+  )..layout(maxWidth: size.width);
+  final local = painter.getOffsetForCaret(TextPosition(offset: offset), Rect.zero);
+  return tester.getTopLeft(finder) + local + Offset(1, painter.preferredLineHeight / 2);
+}
+
+DocumentSelection _collapsedText(String blockId, int blockIndex, int offset) {
+  final position = DocumentPosition.text(
+    blockId: blockId,
+    blockIndex: blockIndex,
+    offset: offset,
+  );
+  return DocumentSelection(base: position, extent: position);
+}
+
+DocumentSelection _collapsedCell(int offset) {
+  final position = DocumentPosition.tableCell(
+    tableBlockId: 'table1',
+    blockIndex: 0,
+    tableRowIndex: 0,
+    tableColumnIndex: 0,
+    offset: offset,
+  );
+  return DocumentSelection(base: position, extent: position);
+}
+
+Future<void> _sendCtrlA(WidgetTester tester) async {
+  await tester.sendKeyDownEvent(LogicalKeyboardKey.controlLeft);
+  await tester.sendKeyEvent(LogicalKeyboardKey.keyA);
+  await tester.sendKeyUpEvent(LogicalKeyboardKey.controlLeft);
+}
+
+String _describe(WenzRichTextController controller) {
+  final selection = controller.selection;
+  if (selection == null) {
+    return 'selection=null';
+  }
+  return 'base=${_position(selection.base)} extent=${_position(selection.extent)} '
+      'start=${_position(selection.start)} end=${_position(selection.end)} '
+      'collapsed=${selection.isCollapsed}';
+}
+
+String _position(DocumentPosition position) {
+  final cell = position.path.isTableCellText
+      ? ' r${position.path.tableRowIndex}c${position.path.tableColumnIndex}'
+      : '';
+  return '${position.blockId}${cell}@${position.offset}';
+}

