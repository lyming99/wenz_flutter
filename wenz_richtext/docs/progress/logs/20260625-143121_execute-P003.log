 347:     return Positioned.fill(
 348:       child: CompositedTransformFollower(
 349:         link: request.anchorLink,
 350:         showWhenUnlinked: false,
 351:         targetAnchor: Alignment.topLeft,
 352:         followerAnchor: Alignment.topLeft,
 353:         offset: Offset(0, top),
 354:         child: Align(
 355:           alignment: AlignmentDirectional.topStart,
 356:           widthFactor: 1,
 357:           heightFactor: 1,
 358:           child: ConstrainedBox(
 359:             key: _toolbarKey,
 360:             constraints: BoxConstraints(minWidth: minWidth),
 361:             child: request.toolbarBuilder(context),
 362:           ),
 363:         ),
 364:       ),
 365:     );
 366:   }
 367: 
 368:   void _scheduleMeasure() {
 369:     if (_measureScheduled) {
 370:       return;
 371:     }
 372:     _measureScheduled = true;
 373:     WidgetsBinding.instance.addPostFrameCallback((_) {
 374:       _measureScheduled = false;
 375:       _syncToolbarHeight();
 376:     });
 377:   }
 378: 
 379:   void _syncToolbarHeight() {
 380:     if (!mounted) {
 381:       return;
 382:     }
 383:     final renderObject = _toolbarKey.currentContext?.findRenderObject();
 384:     if (renderObject is! RenderBox || !renderObject.hasSize) {
 385:       return;
 386:     }
 387:     final nextHeight = renderObject.size.height;
 388:     if (_toolbarHeight != null && (_toolbarHeight! - nextHeight).abs() < 0.5) {
 389:       return;
 390:     }
 391:     setState(() {
 392:       _toolbarHeight = nextHeight;
 393:     });
 394:   }
 395: }

