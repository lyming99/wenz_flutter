 280:   void _syncRequest() {
 281:     if (!mounted) {
 282:       return;
 283:     }
 284:     final controller = widget.controller;
 285:     final requestBuilder = widget.requestBuilder;
 286:     if (controller == null || requestBuilder == null) {
 287:       controller?.hide(owner: _owner);
 288:       return;
 289:     }
 290:     final renderObject = context.findRenderObject();
 291:     if (renderObject is! RenderBox ||
 292:         !renderObject.attached ||
 293:         !renderObject.hasSize) {
 294:       controller.hide(owner: _owner);
 295:       return;
 296:     }
 297:     final anchorTopLeft = renderObject.localToGlobal(Offset.zero);
 298:     final anchorRect = anchorTopLeft & renderObject.size;
 299:     controller.show(
 300:       requestBuilder(
 301:         owner: _owner,
 302:         anchorLink: _anchorLink,
 303:         anchorRect: anchorRect,
 304:         visibleTop: _visibleTopFor(context),
 305:       ),
 306:     );
 307:   }
