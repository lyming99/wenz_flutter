+    if (value != null) {
+      return value;
+    }
+  }
+  return null;
+}
+
+double? _positiveDouble(Object? value) {
+  final number = _asDouble(value);
+  if (number == null || number <= 0 || !number.isFinite) {
+    return null;
+  }
+  return number;
+}
