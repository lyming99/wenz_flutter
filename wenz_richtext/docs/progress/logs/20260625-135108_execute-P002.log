 5456: TableCellRange? _activeTableRange(
 5457:   DocumentSelection? selection,
 5458:   String tableBlockId,
 5459:   int blockIndex,
 5460: ) {
 5461:   final range = selection?.tableCellRange;
 5462:   if (range == null ||
 5463:       range.tableBlockId != tableBlockId ||
 5464:       range.blockIndex != blockIndex) {
 5465:     return null;
 5466:   }
 5467:   return range;
 5468: }
