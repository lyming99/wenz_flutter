 5369: class _ViewportAwareTableToolbar extends StatefulWidget {
 5370:   const _ViewportAwareTableToolbar({
 5371:     required this.fallbackHeight,
 5372:     required this.gap,
 5373:     required this.child,
 5374:   });
 5375: 
 5376:   final double fallbackHeight;
 5377:   final double gap;
 5378:   final Widget child;
 5379: 
 5380:   @override
 5381:   State<_ViewportAwareTableToolbar> createState() =>
 5382:       _ViewportAwareTableToolbarState();
 5383: }
 5384: 
 5385: class _ViewportAwareTableToolbarState
 5386:     extends State<_ViewportAwareTableToolbar> {
 5387:   double? _top;
 5388:   double? _toolbarHeight;
 5389: 
 5390:   double get _preferredTop =>
 5391:       -((_toolbarHeight ?? widget.fallbackHeight) + widget.gap);
 5392:   double get _effectiveTop => _top ?? _preferredTop;
 5393: 
 5394:   @override
 5395:   Widget build(BuildContext context) {
 5396:     WidgetsBinding.instance.addPostFrameCallback((_) => _syncTopWithViewport());
 5397:     return PositionedDirectional(
 5398:       top: _effectiveTop,
 5399:       start: 0,
 5400:       child: widget.child,
 5401:     );
 5402:   }
 5403: 
 5404:   void _syncTopWithViewport() {
 5405:     if (!mounted) {
 5406:       return;
 5407:     }
 5408:     final renderObject = context.findRenderObject();
 5409:     final scrollable = Scrollable.maybeOf(context);
 5410:     final viewportObject = scrollable?.context.findRenderObject();
 5411:     if (renderObject is! RenderBox ||
 5412:         !renderObject.hasSize ||
 5413:         viewportObject is! RenderBox ||
 5414:         !viewportObject.hasSize) {
 5415:       _setTopIfNeeded(_preferredTop);
 5416:       return;
 5417:     }
 5418:     final toolbarHeight = renderObject.size.height;
 5419:     final preferredTop = -(toolbarHeight + widget.gap);
 5420:     final toolbarTop = renderObject.localToGlobal(Offset.zero).dy;
 5421:     final stackTop = toolbarTop - _effectiveTop;
 5422:     final viewportTop = viewportObject.localToGlobal(Offset.zero).dy;
 5423:     final visibleTop = viewportTop - stackTop;
 5424:     _setToolbarGeometryIfNeeded(
 5425:       toolbarHeight: toolbarHeight,
 5426:       top: math.max(preferredTop, visibleTop),
 5427:     );
 5428:   }
 5429: 
 5430:   void _setTopIfNeeded(double nextTop) {
 5431:     if ((_effectiveTop - nextTop).abs() < 0.5) {
 5432:       return;
 5433:     }
 5434:     setState(() {
 5435:       _top = nextTop;
 5436:     });
 5437:   }
 5438: 
 5439:   void _setToolbarGeometryIfNeeded({
 5440:     required double toolbarHeight,
 5441:     required double top,
 5442:   }) {
 5443:     final heightChanged = _toolbarHeight == null ||
 5444:         (_toolbarHeight! - toolbarHeight).abs() >= 0.5;
 5445:     final topChanged = (_effectiveTop - top).abs() >= 0.5;
 5446:     if (!heightChanged && !topChanged) {
 5447:       return;
 5448:     }
 5449:     setState(() {
 5450:       _toolbarHeight = toolbarHeight;
 5451:       _top = top;
 5452:     });
 5453:   }
 5454: }
