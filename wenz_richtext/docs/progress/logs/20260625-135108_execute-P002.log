 1179:           endRow: intent.targetEndRowIndex,
 1180:           startColumn: intent.columnIndex,
 1181:           endColumn: intent.targetEndColumnIndex,
 1182:         );
 1183: 
 1184:     switch (intent.action) {
 1185:       case TableToolbarAction.insertRowAbove:
 1186:         widget.controller.insertTableRow(
 1187:           blockIndex: intent.blockIndex,
 1188:           rowIndex: range.startRow,
 1189:         );
 1190:         return;
 1191:       case TableToolbarAction.insertRowBelow:
 1192:         widget.controller.insertTableRow(
 1193:           blockIndex: intent.blockIndex,
 1194:           rowIndex: range.endRow + 1,
 1195:         );
 1196:         return;
 1197:       case TableToolbarAction.deleteRow:
 1198:         for (var row = range.endRow; row >= range.startRow; row--) {
 1199:           final current = _tableBlockAt(intent.blockIndex);
 1200:           if (current == null || current.table.rowCount <= 1) {
 1201:             break;
 1202:           }
 1203:           widget.controller.deleteTableRow(
 1204:             blockIndex: intent.blockIndex,
 1205:             rowIndex: row,
 1206:           );
 1207:         }
 1208:         return;
 1209:       case TableToolbarAction.insertColumnBefore:
 1210:         widget.controller.insertTableColumn(
 1211:           blockIndex: intent.blockIndex,
 1212:           columnIndex: range.startColumn,
 1213:         );
 1214:         return;
 1215:       case TableToolbarAction.insertColumnAfter:
 1216:         widget.controller.insertTableColumn(
 1217:           blockIndex: intent.blockIndex,
 1218:           columnIndex: range.endColumn + 1,
 1219:         );
 1220:         return;
 1221:       case TableToolbarAction.deleteColumn:
 1222:         for (var column = range.endColumn;
 1223:             column >= range.startColumn;
 1224:             column--) {
 1225:           final current = _tableBlockAt(intent.blockIndex);
 1226:           if (current == null || current.table.columnCount <= 1) {
 1227:             break;
 1228:           }
 1229:           widget.controller.deleteTableColumn(
 1230:             blockIndex: intent.blockIndex,
 1231:             columnIndex: column,
 1232:           );
 1233:         }
 1234:         return;
 1235:       case TableToolbarAction.toggleHeader:
 1236:         final anchor = _firstVisibleTableCell(tableBlock, range);
 1237:         if (anchor == null) {
 1238:           return;
 1239:         }
 1240:         final nextHeader = !anchor.isHeader;
 1241:         _forEachVisibleTableCell(tableBlock, range, (row, column) {
 1242:           widget.controller.setTableCellHeader(
 1243:             blockIndex: intent.blockIndex,
 1244:             rowIndex: row,
 1245:             columnIndex: column,
 1246:             isHeader: nextHeader,
 1247:           );
 1248:         });
 1249:         return;
 1250:       case TableToolbarAction.setBackgroundColor:
 1251:         _forEachVisibleTableCell(tableBlock, range, (row, column) {
 1252:           widget.controller.setTableCellBackground(
 1253:             blockIndex: intent.blockIndex,
 1254:             rowIndex: row,
 1255:             columnIndex: column,
 1256:             backgroundColor: intent.backgroundColor,
 1257:           );
 1258:         });
 1259:         return;
 1260:       case TableToolbarAction.clearBackgroundColor:
 1261:         _forEachVisibleTableCell(tableBlock, range, (row, column) {
 1262:           widget.controller.setTableCellBackground(
 1263:             blockIndex: intent.blockIndex,
 1264:             rowIndex: row,
 1265:             columnIndex: column,
 1266:             backgroundColor: null,
 1267:           );
 1268:         });
 1269:         return;
 1270:       case TableToolbarAction.alignLeft:
 1271:         _setTableColumnAlignment(intent.blockIndex, range, 'left');
 1272:         return;
 1273:       case TableToolbarAction.alignCenter:
 1274:         _setTableColumnAlignment(intent.blockIndex, range, 'center');
 1275:         return;
 1276:       case TableToolbarAction.alignRight:
 1277:         _setTableColumnAlignment(intent.blockIndex, range, 'right');
 1278:         return;
 1279:       case TableToolbarAction.clearAlignment:
 1280:         _setTableColumnAlignment(intent.blockIndex, range, null);
 1281:         return;
 1282:       case TableToolbarAction.mergeCells:
 1283:         if (!range.isSingleCell) {
 1284:           widget.controller.mergeTableCells(
 1285:             blockIndex: intent.blockIndex,
 1286:             startRow: range.startRow,
 1287:             startColumn: range.startColumn,
 1288:             endRow: range.endRow,
 1289:             endColumn: range.endColumn,
 1290:           );
 1291:         }
 1292:         return;
 1293:       case TableToolbarAction.splitCell:
