 3241:     // or ambient style/debug toggles all force a fresh render.
 3242:     //
 3243:     // Selection requires care: a block that stays selected while the selection
 3244:     // extent moves within it (e.g. dragging to resize a range) does not flip
 3245:     // the boolean "touches" flag, but the rendered highlight/caret offset DID
 3246:     // change. So when this block is touched by the selection, a different
 3247:     // selection object must also invalidate the cache.
 3248:     final selectionTouchedChanged =
 3249:         _selectionTouchesBlock(oldWidget) != _selectionTouchesBlock(widget);
 3250:     final selectionShiftedWhileTouched = _selectionTouchesBlock(widget) &&
 3251:         oldWidget.selection != widget.selection;
 3252:     if (widget.blockChanged ||
 3253:         oldWidget.blockIndex != widget.blockIndex ||
 3254:         oldWidget.blockCount != widget.blockCount ||
 3255:         selectionTouchedChanged ||
 3256:         selectionShiftedWhileTouched ||
 3257:         oldWidget.showCaret != widget.showCaret ||
 3258:         oldWidget.showDebugOverlay != widget.showDebugOverlay ||
 3259:         oldWidget.listMarker != widget.listMarker ||
 3260:         oldWidget.canEdit != widget.canEdit ||
 3261:         oldWidget.textStyle != widget.textStyle ||
 3262:         oldWidget.inlineEmbedRenderer != widget.inlineEmbedRenderer ||
 3263:         oldWidget.headingCollapseState != widget.headingCollapseState ||
 3264:         oldWidget.onHeadingCollapseToggled != widget.onHeadingCollapseToggled ||
 3265:         oldWidget.onCodeLanguageChanged != widget.onCodeLanguageChanged ||
 3266:         oldWidget.onCodeCopied != widget.onCodeCopied ||
 3267:         oldWidget.onCalloutVariantChanged != widget.onCalloutVariantChanged ||
 3268:         oldWidget.onTableToolbarAction != widget.onTableToolbarAction ||
 3269:         oldWidget.onTableColumnResize != widget.onTableColumnResize ||
 3270:         oldWidget.onTodoCheckedChanged != widget.onTodoCheckedChanged ||
 3271:         oldWidget.onObjectBlockAction != widget.onObjectBlockAction ||
 3272:         oldWidget.findMatches != widget.findMatches ||
 3273:         oldWidget.currentFindMatch != widget.currentFindMatch ||
 3274:         _compositionTouchesBlock(oldWidget) !=
 3275:             _compositionTouchesBlock(widget) ||
 3276:         oldWidget.blockRenderers != widget.blockRenderers) {
 3277:       _cachedChild = null;
 3278:     }
 3279:   }
 3280: 
 3281:   @override
 3282:   Widget build(BuildContext context) {
 3283:     super.build(context);
 3284:     final cached = _cachedChild;
 3285:     if (cached != null) {
 3286:       return cached;
 3287:     }
 3288:     final child = _BlockRenderer(
 3289:       block: widget.block,
 3290:       blockIndex: widget.blockIndex,
 3291:       blockCount: widget.blockCount,
 3292:       listMarker: widget.listMarker,
 3293:       selection: widget.selection,
 3294:       compositionState: widget.compositionState,
 3295:       registry: widget.registry,
 3296:       blockRenderers: widget.blockRenderers,
 3297:       showCaret: widget.showCaret,
 3298:       textStyle: widget.textStyle,
 3299:       showDebugOverlay: widget.showDebugOverlay,
 3300:       canEdit: widget.canEdit,
 3301:       mediaResolver: widget.mediaResolver,
 3302:       inlineEmbedRenderer: widget.inlineEmbedRenderer,
 3303:       headingCollapseState: widget.headingCollapseState,
 3304:       onHeadingCollapseToggled: widget.onHeadingCollapseToggled,
 3305:       onCodeLanguageChanged: widget.onCodeLanguageChanged,
 3306:       onCodeCopied: widget.onCodeCopied,
 3307:       onCalloutVariantChanged: widget.onCalloutVariantChanged,
 3308:       onTableToolbarAction: widget.onTableToolbarAction,
 3309:       onTableColumnResize: widget.onTableColumnResize,
 3310:       onTodoCheckedChanged: widget.onTodoCheckedChanged,
 3311:       onObjectBlockAction: widget.onObjectBlockAction,
 3312:       findMatches: widget.findMatches,
 3313:       currentFindMatch: widget.currentFindMatch,
 3314:     );
 3315:     _cachedChild = child;
 3316:     return child;
 3317:   }
 3318: 
 3319:   /// Whether the current selection could affect this block's rendering: it is
 3320:   /// an endpoint, or it lies strictly between the selection's start and end
 3321:   /// (so it would be fully highlighted), or the selection is collapsed inside
 3322:   /// it (the caret).
 3323:   bool _selectionTouchesBlock(_KeepAliveBlock w) {
 3324:     final selection = w.selection;
 3325:     if (selection == null) {
 3326:       return false;
 3327:     }
 3328:     final index = w.blockIndex;
 3329:     final start = selection.start;
 3330:     final end = selection.end;
 3331:     if (start.blockIndex == index || end.blockIndex == index) {
 3332:       return true;
 3333:     }
 3334:     // Interior block of a multi-block range is fully highlighted.
 3335:     return index > start.blockIndex && index < end.blockIndex;
 3336:   }
 3337: 
 3338:   /// Whether an active IME composition affects this block (composition lives in
 3339:   /// the caret's block). Only that block needs to repaint the underline span.
 3340:   bool _compositionTouchesBlock(_KeepAliveBlock w) {
 3341:     final composition = w.compositionState;
 3342:     if (composition == null) {
 3343:       return false;
 3344:     }
 3345:     final selection = w.selection;
 3346:     return selection != null && selection.extent.blockIndex == w.blockIndex;
 3347:   }
 3348: }
