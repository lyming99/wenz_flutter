+    var changed = false;
+    for (var i = target.start.blockIndex; i <= target.end.blockIndex; i++) {
+      if (i < 0 || i >= blocks.length) {
+        continue;
+      }
+      final block = blocks[i];
+      if (block is! TextBlockNode) {
