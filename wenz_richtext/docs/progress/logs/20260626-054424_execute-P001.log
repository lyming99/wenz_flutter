 213:         }
 214:       }
 215:       rows.add(nextRow);
 216:     }
 217:     if (!changed) {
 218:       return block;
 219:     }
 220:     return TableBlockNode(
 221:       id: block.id,
 222:       attributes: block.attributes,
 223:       table: TableModel(
 224:         rows: rows,
