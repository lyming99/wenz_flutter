   7: /// Document schema rules and the [normalize] pass that enforces them.
   8: ///
   9: /// The editor has no schema enforcement at construction time (a
  10: /// [RichTextDocument] can legally be empty, a [TableCellNode] can contain zero
  11: /// blocks, and a [TextBlockNode]'s [BlockAttributes] can be inconsistent with
  12: /// its [BlockType]). [normalize] is the single place that fixes all of these
  13: /// so every command output, loaded JSON, and session default is well-formed.
  14: ///
  15: /// Canonical `listType` values (after normalize): `'ordered'`, `'task'`, or
  16: /// `null` (unordered). Legacy values `li`/`oli`/`check` are mapped on decode.
  17: class DocumentSchema {
  18:   const DocumentSchema({this.maxIndent = 8});
  19: 
  20:   /// Maximum indent depth a block may carry.
  21:   final int maxIndent;
  22: 
  23:   /// Returns a well-formed copy of [document]. Idempotent: normalising an
  24:   /// already-normal document returns an equivalent one.
  25:   RichTextDocument normalize(RichTextDocument document) {
  26:     var blocks = document.blocks;
  27:     if (blocks.isEmpty) {
  28:       return RichTextDocument(
  29:         version: document.version,
  30:         blocks: <BlockNode>[
  31:           TextBlockNode(
  32:             id: _freshId(),
  33:             type: BlockType.paragraph,
  34:             content: const <InlineNode>[],
  35:           ),
  36:         ],
  37:         comments: document.comments,
  38:         revisions: document.revisions,
  39:       );
  40:     }
  41:     var changed = false;
  42:     final next = <BlockNode>[];
  43:     for (final block in blocks) {
  44:       final normalized = _normalizeBlock(block);
  45:       if (!identical(normalized, block)) {
  46:         changed = true;
  47:       }
  48:       next.add(normalized);
  49:     }
  50:     if (!changed) {
  51:       return document;
  52:     }
  53:     return RichTextDocument(
  54:       version: document.version,
  55:       blocks: next,
  56:       comments: document.comments,
  57:       revisions: document.revisions,
  58:     );
  59:   }
  60: 
  61:   BlockNode _normalizeBlock(BlockNode block) {
  62:     switch (block) {
  63:       case final TextBlockNode text:
  64:         return _normalizeTextBlock(text);
  65:       case final CalloutBlockNode callout:
  66:         return _normalizeCalloutBlock(callout);
  67:       case final BlockEmbedNode embed:
  68:         return _normalizeBlockEmbed(embed);
  69:       case final TableBlockNode table:
  70:         return _normalizeTableBlock(table);
  71:       case final VideoBlockNode video:
  72:         return _normalizeVideoBlock(video);
  73:       case final CodeBlockNode _:
  74:       case final ImageBlockNode _:
  75:       case final DividerBlockNode _:
  76:       case final FileBlockNode _:
  77:         return block;
  78:       default:
  79:         return block;
  80:     }
  81:   }
  82: 
  83:   BlockNode _normalizeVideoBlock(VideoBlockNode block) {
  84:     final attrs = _normalizeAttributes(block.type, block.attributes);
  85:     final assetId = block.assetId.trim();
  86:     final playbackUrl = block.playbackUrl.trim();
  87:     final file = block.file.trim();
  88:     final coverUrl = block.coverUrl.trim();
  89:     final title = block.title.trim();
  90:     final description = block.description.trim();
  91:     final uploadError = block.uploadError.trim();
  92:     final aspectRatio = _normalizeAspectRatio(block.aspectRatio);
  93: 
  94:     final normalized = VideoBlockNode(
  95:       id: block.id,
  96:       assetId: assetId,
  97:       playbackUrl: playbackUrl,
  98:       file: file,
  99:       coverUrl: coverUrl,
 100:       title: title,
 101:       description: description,
 102:       aspectRatio: aspectRatio,
 103:       uploadStatus: block.uploadStatus,
 104:       uploadError: uploadError,
 105:       attributes: attrs,
 106:     );
 107: 
 108:     if (!normalized.hasSource) {
 109:       return BlockEmbedNode(
 110:         id: block.id,
 111:         embedType: 'video',
 112:         data: _videoEmbedData(normalized),
 113:         fallbackText: normalized.displayText.isEmpty
 114:             ? 'Unsupported video'
 115:             : normalized.displayText,
 116:         attributes: attrs,
 117:       );
 118:     }
 119: 
 120:     if (attrs == block.attributes &&
 121:         assetId == block.assetId &&
 122:         playbackUrl == block.playbackUrl &&
 123:         file == block.file &&
 124:         coverUrl == block.coverUrl &&
 125:         title == block.title &&
 126:         description == block.description &&
 127:         aspectRatio == block.aspectRatio &&
 128:         uploadError == block.uploadError) {
 129:       return block;
 130:     }
 131:     return normalized;
 132:   }
