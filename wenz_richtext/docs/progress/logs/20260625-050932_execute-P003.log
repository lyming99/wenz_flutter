+            _dragWidth = (_dragWidth + details.delta.dx)
+                .clamp(_kMinTableColumnWidth, _kMaxTableColumnWidth)
+                .toDouble();
+            widget.onResize(_dragWidth);
+          },
+          child: Center(
+            child: SizedBox(
+              width: 2,
