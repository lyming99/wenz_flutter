-        : attrs.url != null
-            ? Colors.blue
-            : null,
-    backgroundColor: attrs.background != null ? Color(attrs.background!) : null,
-    fontWeight: attrs.bold == true ? FontWeight.w700 : null,
-    fontStyle: attrs.italic == true ? FontStyle.italic : null,
-    fontSize: attrs.fontSize,
