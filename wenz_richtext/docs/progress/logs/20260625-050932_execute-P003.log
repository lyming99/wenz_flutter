-    // below a centred short cell) maps to the nearest caret edge rather than a
-    // point outside the painter's line metrics.
-    return Offset(
-      textLocal.dx.clamp(0, textBox.size.width),
-      textLocal.dy.clamp(0, textBox.size.height),
-    );
-  }
