+      block,
+      fallback: _defaultBlockFallback,
+    );
+    return Padding(
+      padding: EdgeInsetsDirectional.only(
+        start: (block.attributes.indent ?? 0) * _kIndentPixelsPerLevel,
+      ),
+      child: builder(context, renderContext),
+    );
+  }
+}
