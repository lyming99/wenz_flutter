-  final int blockIndex;
-  final int offset;
-
-  @override
-  bool operator ==(Object other) =>
-      identical(this, other) ||
-      (other is _CaretKey &&
-          other.blockIndex == blockIndex &&
-          other.offset == offset);
-
-  @override
-  int get hashCode => Object.hash(blockIndex, offset);
