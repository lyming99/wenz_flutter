-      span: textSpan,
-      textAlign: textAlign,
-      textDirection: textDirection,
-      maxWidth: maxWidth,
-    );
-    for (final range in ranges) {
-      if (range.start == range.end) {
-        continue;
-      }
-      final paint = Paint()..color = range.active ? activeColor : color;
-      final boxes = layoutService.selectionBoxes(
-        painter,
-        range.start,
-        range.end,
