7907:   final safeEnd = localEnd.clamp(0, textLength).toInt();
7908:   if (safeStart == safeEnd) {
7909:     return null;
7910:   }
7911:   return _LocalSelectionRange(
7912:     start: safeStart < safeEnd ? safeStart : safeEnd,
7913:     end: safeStart < safeEnd ? safeEnd : safeStart,
7914:   );
7915: }
