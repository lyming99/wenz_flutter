-    if (box is! RenderBox || !box.hasSize) {
-      return null;
-    }
-    final safeOffset = offset.clamp(0, _kAtomicBlockSelectionLength).toInt();
-    final x = safeOffset == 0 ? 0.0 : box.size.width;
-    return Rect.fromLTWH(
-      x,
-      0,
-      _kCaretStrokeWidth,
-      box.size.height,
-    );
-  }
