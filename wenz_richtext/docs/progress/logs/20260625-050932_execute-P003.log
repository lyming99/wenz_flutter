-  if (cell != null) {
-    final rowSpan = _clampedTableSpan(
-      cell.rowSpan,
-      rowIndex,
-      tableBlock.table.rowCount,
-    );
-    final columnSpan = _clampedTableSpan(
-      cell.columnSpan,
-      columnIndex,
-      tableBlock.table.columnCount,
-    );
