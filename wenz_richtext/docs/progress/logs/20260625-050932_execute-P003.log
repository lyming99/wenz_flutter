-        return true;
-      case 'scrollToBeginningOfDocument:':
-        _scrollToDocumentBoundary(forward: false);
-        return false;
-      case 'scrollToEndOfDocument:':
-        _scrollToDocumentBoundary(forward: true);
-        return false;
-      case 'scrollPageUp:':
