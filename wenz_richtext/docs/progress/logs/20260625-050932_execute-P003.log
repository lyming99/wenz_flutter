8003: String _videoCoverLabel(String coverUrl) {
8004:   final trimmed = coverUrl.trim();
8005:   if (trimmed.isEmpty) {
8006:     return 'Cover';
8007:   }
8008:   final uri = Uri.tryParse(trimmed);
8009:   final segments =
8010:       uri?.pathSegments.where((segment) => segment.trim().isNotEmpty).toList();
8011:   final fileName = segments?.isNotEmpty == true ? segments!.last : trimmed;
8012:   return 'Cover: $fileName';
8013: }
8014: 
8015: String _videoAccessibleLabel(VideoBlockNode video) {
8016:   final parts = <String>[_videoCardTitle(video)];
8017:   final source = _videoSourceLabel(video);
8018:   if (source != 'unknown') {
8019:     parts.add(source);
8020:   }
8021:   final description = video.description.trim();
8022:   if (description.isNotEmpty) {
8023:     parts.add(description);
8024:   }
8025:   if (video.uploadStatus == FileUploadStatus.failed &&
8026:       video.uploadError.isNotEmpty) {
8027:     parts.add(video.uploadError);
8028:   }
8029:   return parts.join(', ');
8030: }
