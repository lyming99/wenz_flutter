-int? _debugOffsetForPath(
-  DocumentSelection? selection,
-  String blockId,
-  PositionPath path,
-  int textLength,
-) {
-  if (selection == null) {
-    return null;
-  }
-  final position = selection.extent;
-  if (position.blockId != blockId || position.path != path) {
-    return null;
