7867: _LocalSelectionRange? _selectionRangeForPath(
7868:   DocumentSelection? selection,
7869:   int blockIndex,
7870:   PositionPath path,
7871:   int textLength,
7872: ) {
7873:   if (selection == null || selection.isCollapsed) {
7874:     return null;
7875:   }
7876:   final start = selection.start;
7877:   final end = selection.end;
7878:   int? localStart;
7879:   int? localEnd;
7880: 
7881:   if (start.blockIndex == blockIndex) {
7882:     final pathCompare = path.compare(start.path);
7883:     if (pathCompare == 0) {
7884:       localStart = start.offset;
7885:     } else if (pathCompare > 0) {
7886:       localStart = 0;
7887:     }
7888:   } else if (blockIndex > start.blockIndex) {
7889:     localStart = 0;
7890:   }
7891: 
7892:   if (end.blockIndex == blockIndex) {
7893:     final pathCompare = path.compare(end.path);
7894:     if (pathCompare == 0) {
7895:       localEnd = end.offset;
7896:     } else if (pathCompare < 0) {
7897:       localEnd = textLength;
7898:     }
7899:   } else if (blockIndex < end.blockIndex) {
7900:     localEnd = textLength;
7901:   }
7902: 
7903:   if (localStart == null || localEnd == null) {
7904:     return null;
7905:   }
