-  String _objectBlockReference(BlockNode block) {
-    if (block is ImageBlockNode) {
-      return _assetLabel(block.assetId, block.file);
-    }
-    if (block is VideoBlockNode) {
-      return _assetLabel(block.assetId, block.file);
