-  ];
-  final metadata = _fileMetadata(file);
-  if (metadata.isNotEmpty) {
-    parts.add(metadata);
-  }
-  if (file.uploadStatus == FileUploadStatus.failed &&
-      file.uploadError.isNotEmpty) {
-    parts.add(file.uploadError);
