-        }
-        return true;
-      case 'deleteForward:':
-        if (!_deleteActiveSelectionIfAny()) {
-          controller.deleteForward();
-        }
-        return true;
-      case 'deleteWordBackward:':
-        _deleteByWord(forward: false);
-        return true;
-      case 'deleteWordForward:':
-        _deleteByWord(forward: true);
