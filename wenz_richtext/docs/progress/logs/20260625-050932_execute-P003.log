+    // Show a caret only in editable mode. Read-only mode still allows
+    // selection (see _handleSelectionChanged) but has no editing caret.
+    final showCaret = !widget.readOnly &&
+        focusNode.hasFocus &&
+        widget.controller.selection?.isCollapsed == true;
