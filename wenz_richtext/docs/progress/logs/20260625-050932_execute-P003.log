-        return;
-      case ObjectBlockAction.markFileUploading:
-        if (widget.readOnly || block is! FileBlockNode) {
-          return;
-        }
-        widget.controller.updateFileBlock(
-          blockIndex: intent.blockIndex,
-          uploadStatus: FileUploadStatus.uploading,
-          uploadError: '',
