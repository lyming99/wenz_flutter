 8870: Finder _richText(String text) {
 8871:   return find.byWidgetPredicate(
 8872:     (widget) => widget is RichText && widget.text.toPlainText() == text,
 8873:     description: 'RichText with plain text "$text"',
 8874:   );
 8875: }
