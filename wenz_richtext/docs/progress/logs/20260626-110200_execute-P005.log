 8877: TextSpan _richTextSpan(WidgetTester tester, String text) {
 8878:   return tester.widget<RichText>(_richText(text)).text as TextSpan;
 8879: }
 8880: 
 8881: TextSpan? _leafSpan(TextSpan span, String text) {
 8882:   final children = span.children;
 8883:   if ((children == null || children.isEmpty) && span.text == text) {
 8884:     return span;
 8885:   }
 8886:   for (final child in children ?? const <InlineSpan>[]) {
 8887:     if (child is TextSpan) {
 8888:       final match = _leafSpan(child, text);
 8889:       if (match != null) {
 8890:         return match;
 8891:       }
 8892:     }
 8893:   }
 8894:   return null;
 8895: }
 8896: 
 8897: Finder _richTextIgnoringCaret(String text) {
 8898:   return find.byWidgetPredicate(
 8899:     (widget) =>
 8900:         widget is RichText &&
 8901:         widget.text.toPlainText().replaceAll('\uFFFC', '') == text,
 8902:     description: 'RichText with plain text "$text" ignoring caret',
 8903:   );
 8904: }
