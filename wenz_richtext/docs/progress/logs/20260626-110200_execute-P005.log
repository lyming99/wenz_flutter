 8936: int _caretRenderOffsetForLogicalOffset(
 8937:   WidgetTester tester,
 8938:   int logicalOffset,
 8939: ) {
 8940:   final editor = tester.widget<WenzRichTextEditor>(
 8941:     find.byType(WenzRichTextEditor),
 8942:   );
 8943:   final position = editor.controller.selection!.extent;
 8944:   final block = editor.controller.document.blocks[position.blockIndex];
 8945:   final nodes = position.path.isTableCellText
 8946:       ? ((block as TableBlockNode)
 8947:               .table
 8948:               .cellAt(
 8949:                 position.path.tableRowIndex!,
 8950:                 position.path.tableColumnIndex!,
 8951:               )!
 8952:               .blocks
 8953:               .whereType<TextBlockNode>()
 8954:               .first)
 8955:           .content
 8956:       : (block as TextBlockNode).content;
 8957:   return _renderOffsetForLogicalOffset(nodes, logicalOffset);
 8958: }
 8959: 
 8960: int _renderOffsetForLogicalOffset(
 8961:   List<InlineNode> nodes,
 8962:   int logicalOffset,
 8963: ) {
 8964:   var logicalCursor = 0;
 8965:   var renderCursor = 0;
 8966:   for (final node in nodes) {
 8967:     final logicalLength = inlineLength(node);
 8968:     final renderText = _inlineRenderText(node);
 8969:     final nextLogicalCursor = logicalCursor + logicalLength;
 8970:     final nextRenderCursor = renderCursor + renderText.length;
 8971:     if (logicalOffset <= nextLogicalCursor) {
 8972:       if (node is TextRun) {
 8973:         return renderCursor + logicalOffset - logicalCursor;
 8974:       }
 8975:       return logicalOffset <= logicalCursor ? renderCursor : nextRenderCursor;
 8976:     }
 8977:     logicalCursor = nextLogicalCursor;
 8978:     renderCursor = nextRenderCursor;
 8979:   }
 8980:   return renderCursor;
 8981: }
 8982: 
 8983: String _inlineRenderText(InlineNode node) {
 8984:   if (node is TextRun) {
 8985:     return node.text;
 8986:   }
 8987:   if (node is InlineEmbed) {
 8988:     return switch (node.embedType.trim()) {
 8989:       'mention' => _mentionRenderText(node),
 8990:       'image' => '[img]',
 8991:       'formula' => _formulaRenderText(node),
 8992:       'emoji' => _emojiRenderText(node),
 8993:       _ => '[${node.embedType}]',
 8994:     };
 8995:   }
 8996:   return node.plainText;
 8997: }
 8998: 
 8999: String _mentionRenderText(InlineEmbed embed) {
 9000:   final raw = embed.data['label'] ?? embed.data['id'];
 9001:   final label = raw?.toString() ?? '';
 9002:   return label.isEmpty ? '@mention' : '@$label';
 9003: }
 9004: 
 9005: String _formulaRenderText(InlineEmbed embed) {
 9006:   for (final key in const <String>['text', 'latex', 'value', 'formula']) {
 9007:     final value = embed.data[key]?.toString().trim();
 9008:     if (value != null && value.isNotEmpty) {
 9009:       return value;
 9010:     }
 9011:   }
 9012:   return '[formula]';
 9013: }
 9014: 
 9015: String _emojiRenderText(InlineEmbed embed) {
 9016:   final raw = embed.data['emoji'] ??
 9017:       embed.data['text'] ??
 9018:       embed.data['value'] ??
 9019:       embed.data['shortName'] ??
 9020:       embed.data['label'];
 9021:   final text = raw?.toString() ?? '';
 9022:   return text.isEmpty ? '[emoji]' : text;
 9023: }
