 8906: double _richTextFirstLineCenterY(WidgetTester tester, Finder finder) {
 8907:   final firstLine = _richTextLineMetrics(tester, finder).first;
 8908:   return tester.getTopLeft(finder).dy +
 8909:       firstLine.baseline -
 8910:       firstLine.ascent +
 8911:       firstLine.height / 2;
 8912: }
