  237:   bool activate(SlashMenuItem item) {
  238:     final activeTrigger = _detectTrigger(_editor);
  239:     if (activeTrigger == null) {
  240:       _trigger = null;
  241:       _items = const <SlashMenuItem>[];
  242:       _highlightedIndex = 0;
