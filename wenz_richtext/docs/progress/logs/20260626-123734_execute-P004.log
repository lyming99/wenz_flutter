 1144:   void _pasteInline(List<InlineNode> runs) {
 1145:     if (runs.isEmpty) {
 1146:       return;
 1147:     }
 1148:     // Insert each run at the current caret; InsertTextCommand handles attribute
 1149:     // preservation per run, and InsertInlineEmbedCommand re-inserts embeds
 1150:     // (formula/mention/image) so rich inline elements survive paste. Inserting
 1151:     // as separate commands lets them coalesce only when attributes match.
 1152:     for (final run in runs) {
 1153:       if (run is TextRun) {
 1154:         if (run.text.isEmpty) {
 1155:           continue;
 1156:         }
 1157:         insertText(
 1158:           run.text,
 1159:           attributes: run.attributes,
 1160:           applyMarkdownShortcuts: false,
 1161:         );
 1162:       } else if (run is InlineEmbed) {
 1163:         execute(
 1164:           InsertInlineEmbedCommand(
 1165:             embedType: run.embedType,
 1166:             data: run.data,
 1167:           ),
 1168:         );
 1169:       }
 1170:     }
