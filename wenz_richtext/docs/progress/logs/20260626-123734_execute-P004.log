 142: /// Adjusts the [BlockAttributes.indent] of every text block covered by the
 143: /// current selection by [delta] (clamped to >= 0 and the schema max). Stage 3
 144: /// uses indent for both paragraph indentation and quote nesting depth.
 145: class IndentCommand extends EditorCommand {
 146:   const IndentCommand(this.delta, {this.selection});
 147: 
 148:   final int delta;
 149:   final DocumentSelection? selection;
 150: 
 151:   @override
 152:   String get description => delta > 0 ? 'indent' : 'outdent';
 153: 
 154:   @override
 155:   CommandResult execute(DocumentSession session) {
 156:     final target = selection ?? session.selection;
 157:     if (target == null || delta == 0) {
 158:       return const CommandResult(recordHistory: false);
 159:     }
 160:     final blocks = session.document.blocks.map((b) => b.copy()).toList();
 161:     var changed = false;
 162:     for (var i = target.start.blockIndex; i <= target.end.blockIndex; i++) {
 163:       if (i < 0 || i >= blocks.length) {
 164:         continue;
 165:       }
 166:       final block = blocks[i];
 167:       if (block is! TextBlockNode) {
 168:         continue;
 169:       }
 170:       final current = block.attributes.indent ?? 0;
 171:       final next = (current + delta).clamp(0, 8).toInt();
 172:       if (next == current) {
 173:         continue;
 174:       }
 175:       blocks[i] = TextBlockNode(
 176:         id: block.id,
 177:         type: block.type,
 178:         attributes: BlockAttributes(
 179:           level: block.attributes.level,
 180:           indent: next,
 181:           alignment: block.attributes.alignment,
 182:           listType: block.attributes.listType,
 183:           checked: block.attributes.checked,
 184:           childNote: block.attributes.childNote,
 185:           anchor: block.attributes.anchor,
 186:         ),
 187:         content: block.content,
 188:       );
 189:       changed = true;
 190:     }
 191:     if (!changed) {
 192:       return const CommandResult(recordHistory: false);
 193:     }
 194:     session.document = RichTextDocument(
 195:       version: session.document.version,
 196:       blocks: blocks,
 197:     );
 198:     return CommandResult(selection: target);
 199:   }
 200: }
