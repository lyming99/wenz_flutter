  249:       _editor,
  250:       SlashMenuContext(
  251:         trigger: activeTrigger,
  252:         generatedId: _nextGeneratedId,
  253:       ),
  254:     );
  255:     _trigger = null;
  256:     _items = const <SlashMenuItem>[];
  257:     _highlightedIndex = 0;
  258:     notifyListeners();
  259:     return true;
  260:   }
