  424: 
  425:     final blocks = session.document.blocks.map((b) => b.copy()).toList();
  426:     blocks[index] = block.copyWith(
  427:       variant: nextVariant,
  428:       title: nextTitle,
  429:       icon: nextIcon,
  430:     );
  431:     session.document = RichTextDocument(
  432:       version: session.document.version,
  433:       blocks: blocks,
  434:     );
  435:     return const CommandResult();
  436:   }
