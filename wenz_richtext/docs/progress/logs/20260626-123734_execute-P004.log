  439: /// Indents or outdents every code line touched by the current code selection.
  440: class IndentCodeBlockCommand extends EditorCommand {
  441:   const IndentCodeBlockCommand({
  442:     this.selection,
  443:     this.indent = '  ',
  444:     this.outdent = false,
  445:   });
  446: 
  447:   final DocumentSelection? selection;
  448:   final String indent;
  449:   final bool outdent;
  450: 
  451:   @override
  452:   String get description => outdent ? 'outdentCodeBlock' : 'indentCodeBlock';
  453: 
  454:   @override
  455:   CommandResult execute(DocumentSession session) {
  456:     final target = selection ?? session.selection;
  457:     if (target == null || indent.isEmpty) {
  458:       return const CommandResult(recordHistory: false);
  459:     }
  460:     final start = target.start;
  461:     final end = target.end;
  462:     if (start.blockIndex != end.blockIndex ||
  463:         start.path != end.path ||
  464:         !start.path.isBlockCode) {
  465:       return const CommandResult(recordHistory: false);
  466:     }
  467:     final index = start.blockIndex;
  468:     if (index < 0 || index >= session.document.blocks.length) {
  469:       return const CommandResult(recordHistory: false);
  470:     }
  471:     final block = session.document.blocks[index];
  472:     if (block is! CodeBlockNode) {
  473:       return const CommandResult(recordHistory: false);
  474:     }
  475: 
  476:     final code = block.code;
  477:     final rangeStart = start.offset.clamp(0, code.length).toInt();
  478:     final rangeEnd = end.offset.clamp(rangeStart, code.length).toInt();
  479:     final lineStarts = _codeLineStartsForRange(code, rangeStart, rangeEnd);
  480:     if (lineStarts.isEmpty) {
  481:       return const CommandResult(recordHistory: false);
  482:     }
  483: 
  484:     var nextCode = code;
  485:     var baseOffset = target.base.offset.clamp(0, code.length).toInt();
  486:     var extentOffset = target.extent.offset.clamp(0, code.length).toInt();
  487:     var changed = false;
  488: 
  489:     for (final lineStart in lineStarts.reversed) {
  490:       final removedLength =
  491:           outdent ? _codeOutdentLength(nextCode, lineStart, indent) : 0;
  492:       final inserted = outdent ? '' : indent;
  493:       if (outdent && removedLength == 0) {
  494:         continue;
  495:       }
  496:       nextCode = nextCode.replaceRange(
  497:         lineStart,
  498:         lineStart + removedLength,
  499:         inserted,
  500:       );
  501:       baseOffset = _transformCodeOffset(
  502:         baseOffset,
  503:         lineStart,
  504:         removedLength,
  505:         inserted.length,
  506:       );
  507:       extentOffset = _transformCodeOffset(
  508:         extentOffset,
  509:         lineStart,
  510:         removedLength,
  511:         inserted.length,
  512:       );
  513:       changed = true;
  514:     }
  515: 
  516:     if (!changed || nextCode == code) {
  517:       return const CommandResult(recordHistory: false);
  518:     }
  519: 
  520:     final blocks = session.document.blocks.map((b) => b.copy()).toList();
