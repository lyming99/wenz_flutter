  202: /// Toggles the checked state of a task list item at the caret. If the block is
  203: /// not a task list item, converts it to one first.
  204: class ToggleTodoCommand extends EditorCommand {
  205:   const ToggleTodoCommand({this.selection});
  206: 
  207:   final DocumentSelection? selection;
  208: 
  209:   @override
  210:   String get description => 'toggleTodo';
  211: 
  212:   @override
  213:   CommandResult execute(DocumentSession session) {
  214:     final target = selection ?? session.selection;
  215:     if (target == null) {
  216:       return const CommandResult(recordHistory: false);
  217:     }
  218:     final blocks = session.document.blocks.map((b) => b.copy()).toList();
  219:     var changed = false;
  220:     for (var i = target.start.blockIndex; i <= target.end.blockIndex; i++) {
  221:       if (i < 0 || i >= blocks.length) {
  222:         continue;
  223:       }
  224:       final block = blocks[i];
  225:       if (block is! TextBlockNode) {
  226:         continue;
  227:       }
  228:       final isTask = block.type == BlockType.listItem &&
  229:           block.attributes.listType == 'task';
  230:       if (isTask) {
  231:         blocks[i] = _textBlockWithChecked(
