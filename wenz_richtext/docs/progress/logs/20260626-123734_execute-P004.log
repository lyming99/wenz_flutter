   10: const int _atomicBlockSelectionLength = 1;
   11: 
   12: /// Moves a top-level block from [fromIndex] to [toIndex].
   13: ///
   14: /// [toIndex] is the moved block's final index after removal/insertion. Invalid
   15: /// indexes and same-index moves are no-op and do not record history.
   16: class MoveBlockCommand extends EditorCommand {
   17:   const MoveBlockCommand({required this.fromIndex, required this.toIndex});
   18: 
   19:   final int fromIndex;
   20:   final int toIndex;
   21: 
   22:   @override
   23:   String get description => 'moveBlock';
   24: 
   25:   @override
   26:   CommandResult execute(DocumentSession session) {
   27:     final document = session.document;
   28:     final blockCount = document.blocks.length;
   29:     if (fromIndex < 0 ||
   30:         fromIndex >= blockCount ||
   31:         toIndex < 0 ||
   32:         toIndex >= blockCount ||
   33:         fromIndex == toIndex) {
   34:       return const CommandResult(recordHistory: false);
   35:     }
   36: 
   37:     final blocks = document.blocks.map((block) => block.copy()).toList();
   38:     final moved = blocks.removeAt(fromIndex);
   39:     blocks.insert(toIndex, moved);
   40:     final blockIndexes = <String, int>{
   41:       for (var index = 0; index < blocks.length; index++)
   42:         blocks[index].id: index,
   43:     };
   44: 
   45:     session.document = RichTextDocument(
   46:       version: document.version,
   47:       blocks: blocks,
   48:       comments: _retargetCommentThreads(document.comments, blockIndexes),
   49:       revisions: _retargetRevisionChanges(document.revisions, blockIndexes),
   50:     );
   51:     return CommandResult(
   52:       selection: _selectionForMovedBlock(moved, toIndex),
   53:       metadata: <String, Object?>{
   54:         'fromIndex': fromIndex,
   55:         'toIndex': toIndex,
   56:         'blockId': moved.id,
   57:       },
   58:     );
   59:   }
   60: }
   61: 
   62: List<CommentThread> _retargetCommentThreads(
   63:   List<CommentThread> comments,
   64:   Map<String, int> blockIndexes,
   65: ) {
   66:   return comments.map((thread) {
   67:     final nextIndex = blockIndexes[thread.anchor.blockId];
   68:     if (nextIndex == null || nextIndex == thread.anchor.blockIndex) {
   69:       return thread.copy();
   70:     }
   71:     return thread.copyWith(
   72:       anchor: thread.anchor.copyWith(blockIndex: nextIndex),
   73:       messages: thread.messages.map((message) => message.copy()).toList(),
   74:     );
   75:   }).toList();
   76: }
   77: 
   78: List<RevisionChange> _retargetRevisionChanges(
   79:   List<RevisionChange> revisions,
   80:   Map<String, int> blockIndexes,
   81: ) {
   82:   return revisions.map((revision) {
   83:     final nextIndex = blockIndexes[revision.range.blockId];
   84:     if (nextIndex == null || nextIndex == revision.range.blockIndex) {
   85:       return revision.copy();
   86:     }
   87:     return revision.copyWith(
   88:       range: revision.range.copyWith(blockIndex: nextIndex),
   89:       metadata: Map<String, Object?>.from(revision.metadata),
   90:     );
   91:   }).toList();
   92: }
