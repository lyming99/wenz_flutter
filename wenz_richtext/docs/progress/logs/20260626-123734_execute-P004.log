 1125:   void _pasteClipboard(ClipboardPaste paste) {
 1126:     if (paste.isBlocks) {
 1127:       execute(PasteBlocksCommand(paste.blocks,
 1128:           newBlockId: 'paste-${_pasteBlockCounter()}'));
 1129:       return;
 1130:     }
 1131:     if (paste.isRich) {
 1132:       _pasteInline(paste.inlineRuns);
 1133:       notifyListeners();
 1134:       return;
 1135:     }
 1136:     final text = paste.text;
 1137:     if (text.isEmpty) {
 1138:       return;
 1139:     }
 1140:     _pastePlain(text);
 1141:     notifyListeners();
 1142:   }
