  438: void _replaceCurrentBlock(
  439:   WenzRichTextController editor,
  440:   SlashMenuContext context,
  441:   BlockNode Function(TextBlockNode block) buildBlock,
  442:   DocumentSelection Function(BlockNode block) buildSelection,
  443: ) {
  444:   final index = context.blockIndex;
  445:   if (index < 0 || index >= editor.document.blocks.length) {
  446:     return;
  447:   }
  448:   final block = editor.document.blocks[index];
  449:   if (block is! TextBlockNode) {
  450:     return;
  451:   }
  452:   final nextBlock = buildBlock(block);
  453:   editor.replaceBlocks(
  454:     index: index,
  455:     deleteCount: 1,
  456:     blocks: <BlockNode>[nextBlock],
  457:     selection: buildSelection(nextBlock),
  458:   );
  459: }
