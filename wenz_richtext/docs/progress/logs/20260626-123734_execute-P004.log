  241:             alignment: block.attributes.alignment,
  242:             listType: 'task',
  243:             checked: false,
  244:             childNote: block.attributes.childNote,
  245:             anchor: block.attributes.anchor,
  246:           ),
  247:           content: block.content,
  248:         );
  249:       }
  250:       changed = true;
  251:     }
  252:     if (!changed) {
  253:       return const CommandResult(recordHistory: false);
  254:     }
  255:     session.document = RichTextDocument(
  256:       version: session.document.version,
  257:       blocks: blocks,
  258:     );
  259:     return CommandResult(selection: target);
  260:   }
  261: }
