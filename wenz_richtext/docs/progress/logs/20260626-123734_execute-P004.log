  119: DocumentPosition? _firstTableCellPosition(
  120:   TableBlockNode block,
  121:   int blockIndex,
  122: ) {
  123:   for (var rowIndex = 0; rowIndex < block.table.rows.length; rowIndex++) {
  124:     final row = block.table.rows[rowIndex];
  125:     for (var columnIndex = 0; columnIndex < row.length; columnIndex++) {
  126:       final cell = row[columnIndex];
  127:       if (cell.covered) {
  128:         continue;
  129:       }
  130:       return DocumentPosition.tableCell(
  131:         tableBlockId: block.id,
  132:         blockIndex: blockIndex,
  133:         tableRowIndex: rowIndex,
  134:         tableColumnIndex: columnIndex,
  135:         offset: 0,
  136:       );
  137:     }
  138:   }
  139:   return null;
  140: }
