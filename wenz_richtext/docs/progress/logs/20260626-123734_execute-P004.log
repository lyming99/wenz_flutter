   94: DocumentSelection _selectionForMovedBlock(BlockNode block, int blockIndex) {
   95:   final position = switch (block) {
   96:     TextBlockNode() => DocumentPosition.text(
   97:         blockId: block.id,
   98:         blockIndex: blockIndex,
   99:         offset: block.plainText.length,
  100:       ),
  101:     CodeBlockNode() => DocumentPosition.code(
  102:         blockId: block.id,
  103:         blockIndex: blockIndex,
  104:         offset: block.code.length,
  105:       ),
  106:     TableBlockNode() => _firstTableCellPosition(block, blockIndex) ??
  107:         DocumentPosition.object(blockId: block.id, blockIndex: blockIndex),
  108:     _ => DocumentPosition.object(blockId: block.id, blockIndex: blockIndex),
  109:   };
  110:   if (position.path.isBlockObject) {
  111:     return DocumentSelection(
  112:       base: position,
  113:       extent: position.copyWith(offset: _atomicBlockSelectionLength),
  114:     );
  115:   }
  116:   return DocumentSelection(base: position, extent: position);
  117: }
