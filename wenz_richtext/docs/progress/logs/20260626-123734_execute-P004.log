  396:   final String? variant;
  397:   final String? title;
  398:   final String? icon;
  399: 
  400:   @override
  401:   String get description => 'updateCalloutBlock';
  402: 
  403:   @override
  404:   CommandResult execute(DocumentSession session) {
  405:     final index = blockIndex ?? session.selection?.extent.blockIndex ?? -1;
  406:     if (index < 0 || index >= session.document.blocks.length) {
  407:       return const CommandResult(recordHistory: false);
  408:     }
  409:     final block = session.document.blocks[index];
  410:     if (block is! CalloutBlockNode) {
  411:       return const CommandResult(recordHistory: false);
  412:     }
  413: 
  414:     final nextVariant = variant == null
  415:         ? CalloutBlockNode.normalizeVariant(block.variant)
  416:         : CalloutBlockNode.normalizeVariant(variant);
  417:     final nextTitle = title == null ? block.title : title!.trim();
  418:     final nextIcon = icon == null ? block.icon : icon!.trim();
