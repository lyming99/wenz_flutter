   98:         columnIndex.clamp(0, tableBlock.table.columnCount).toInt();
   99:     final rows = <List<TableCellNode>>[
  100:       for (var rowIndex = 0; rowIndex < tableBlock.table.rowCount; rowIndex++)
  101:         <TableCellNode>[
  102:           for (var col = 0; col < insertIndex; col++)
  103:             copyCell(tableBlock.table.rows[rowIndex][col]),
  104:           _emptyCell(
  105:             _cellId(tableBlock.id, rowIndex, insertIndex, cellIdBuilder),
  106:           ),
  107:           for (var col = insertIndex;
  108:               col < tableBlock.table.rows[rowIndex].length;
  109:               col++)
  110:             copyCell(tableBlock.table.rows[rowIndex][col]),
  111:         ],
  112:     ];
  113:     // Reindex alignments so columns that were at/after the insertion point
  114:     // keep their alignment on the shifted column index. Mirrors the reverse
  115:     // shift done by DeleteTableColumnCommand.
  116:     final alignments = shiftColumnMapOnInsert(
  117:       tableBlock.table.columnAlignments,
  118:       insertIndex,
  119:     );
  120:     final widths = shiftColumnMapOnInsert(
  121:       tableBlock.table.columnWidths,
  122:       insertIndex,
  123:     );
  124:     return _replaceTableWithSelection(
  125:       session,
  126:       blockIndex,
  127:       tableBlock,
  128:       rows,
  129:       selection: _tableSelectionAfterColumnInserted(
  130:         session.selection,
  131:         tableBlock,
  132:         blockIndex,
  133:         rows,
  134:         insertIndex,
  135:       ),
  136:       columnAlignments: alignments,
  137:       columnWidths: widths,
  138:     );
  139:   }
  140: }
  141: 
  142: class DeleteTableRowCommand extends EditorCommand {
  143:   const DeleteTableRowCommand({
  144:     required this.blockIndex,
  145:     required this.rowIndex,
  146:   });
  147: 
  148:   final int blockIndex;
  149:   final int rowIndex;
  150: 
  151:   @override
  152:   String get description => 'deleteTableRow';
  153: 
  154:   @override
  155:   CommandResult execute(DocumentSession session) {
  156:     final tableBlock = tableAt(session, blockIndex);
  157:     if (tableBlock == null ||
  158:         tableBlock.table.rowCount <= 1 ||
  159:         rowIndex < 0 ||
  160:         rowIndex >= tableBlock.table.rowCount) {
  161:       return const CommandResult(recordHistory: false);
  162:     }
  163:     final rows = <List<TableCellNode>>[
  164:       for (var i = 0; i < tableBlock.table.rowCount; i++)
  165:         if (i != rowIndex) copyRow(tableBlock.table.rows[i]),
  166:     ];
  167:     return _replaceTableWithSelection(
  168:       session,
  169:       blockIndex,
  170:       tableBlock,
  171:       rows,
  172:       selection: _tableSelectionAfterRowDeleted(
  173:         session.selection,
  174:         tableBlock,
  175:         blockIndex,
  176:         rows,
  177:         rowIndex,
  178:       ),
  179:     );
  180:   }
