+
+int _currentBlockInsertionIndex(
+  WenzRichTextController editor,
+  SlashMenuContext context,
+) {
+  final selection = editor.selection;
+  final index = context.blockIndex;
+  if (selection == null ||
+      !selection.isCollapsed ||
+      index < 0 ||
+      index >= editor.document.blocks.length) {
+    return index;
+  }
+  final position = selection.extent;
+  if (position.blockIndex != index || !position.path.isBlockText) {
+    return index;
+  }
+  final block = editor.document.blocks[index];
+  if (block is! TextBlockNode) {
+    return index;
+  }
+  final caret = position.offset.clamp(0, block.plainText.length).toInt();
+  final beforeCaret = block.plainText.substring(0, caret);
+  return beforeCaret.isEmpty ? index : index + 1;
+}
