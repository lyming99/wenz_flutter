+              _RowBlockFormat.paragraph,
+            ),
+            content: _plainTextInlineContent(block.code),
+          );
+          widget.controller.replaceBlocks(
+            index: blockIndex,
+            deleteCount: 1,
+            blocks: <BlockNode>[nextBlock],
