3515:   /// Whether the current selection could affect this block's rendering: it is
3516:   /// an endpoint, or it lies strictly between the selection's start and end
3517:   /// (so it would be fully highlighted), or the selection is collapsed inside
3518:   /// it (the caret).
3519:   bool _selectionTouchesBlock(_KeepAliveBlock w) {
3520:     final selection = w.selection;
3521:     if (selection == null) {
3522:       return false;
3523:     }
3524:     final index = w.blockIndex;
3525:     final start = selection.start;
3526:     final end = selection.end;
3527:     if (start.blockIndex == index || end.blockIndex == index) {
3528:       return true;
3529:     }
3530:     // Interior block of a multi-block range is fully highlighted.
3531:     return index > start.blockIndex && index < end.blockIndex;
3532:   }
3533: 
3534:   /// Whether an active IME composition affects this block (composition lives in
3535:   /// the caret's block). Only that block needs to repaint the underline span.
3536:   bool _compositionTouchesBlock(_KeepAliveBlock w) {
3537:     final composition = w.compositionState;
3538:     if (composition == null) {
3539:       return false;
3540:     }
3541:     final selection = w.selection;
3542:     return selection != null && selection.extent.blockIndex == w.blockIndex;
3543:   }
3544: }
