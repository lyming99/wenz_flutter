+_RowBlockFormat? _rowBlockFormatFor(BlockNode block) {
+  return switch (block) {
+    CodeBlockNode() => _RowBlockFormat.code,
+    TextBlockNode(type: BlockType.heading) => _RowBlockFormat.heading,
+    TextBlockNode() => _RowBlockFormat.paragraph,
+    _ => null,
+  };
