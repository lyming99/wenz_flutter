3077`t    return LayoutBuilder(
3078`t      builder: (context, constraints) {
3079`t        final contentWidth = constraints.maxWidth.isFinite
3080`t            ? (constraints.maxWidth - padding.horizontal)
3081`t                .clamp(0.0, double.infinity)
3082`t                .toDouble()
3083`t            : null;
3084`t        widget.extentCache.updateContentWidth(contentWidth);
3085`t        final metrics = widget.extentCache.layoutFor(
3086`t          widget.blocks,
3087`t          widget.blockSpacing,
3088`t        );
3089`t        final viewportHeight =
3090`t            constraints.maxHeight.isFinite ? constraints.maxHeight : 0.0;
3091`t        final scrollOffset =
3092`t            widget.controller.hasClients ? widget.controller.offset : 0.0;
3093`t        final contentTop = (scrollOffset - padding.top - _kVirtualListOverscan)
3094`t            .clamp(0.0, double.infinity)
3095`t            .toDouble();
3096`t        final contentBottom =
3097`t            scrollOffset - padding.top + viewportHeight + _kVirtualListOverscan;
3098`t        final visible = metrics.visibleIndices(contentTop, contentBottom);
3099`t        final indices = <int>{...visible};
3100`t        for (var i = 0; i < widget.blocks.length; i++) {
3101`t          if (widget.keepAliveIds.contains(widget.blocks[i].id)) {
3102`t            indices.add(i);
3103`t          }
3104`t        }
3105`t        final sortedIndices = indices.toList()..sort();
3106`t        final height = padding.vertical + metrics.totalExtent;
