3065`t      setState(() {});
3066`t      // A real height change may unlock a caret-into-view that the content
3067`t      // mutation frame could not perform (it ran with the pre-edit height).
3068`t      // Notify the editor so it can retry the scroll against the now-accurate
3069`t      // layout.
