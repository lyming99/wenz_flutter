9009`t          maxWidth: _kFileActionMenuMaxWidth,
9010`t        ),
9011`t        items: _moreItems(),
9012`t      );
9013`t      if (selected != null) {
9014`t        _dispatch(selected);
9015`t      }
9016`t      return;
9017`t    }
9018`t    _dispatch(selection);
