538: List<int> _codeLineStartsForRange(String code, int start, int end) {
539:   if (code.isEmpty) {
540:     return const <int>[0];
541:   }
542:   final effectiveEnd =
543:       start == end || end == 0 || code.codeUnitAt(end - 1) != 0x0A
544:           ? end
545:           : end - 1;
546:   final firstLineStart = _codeLineStart(code, start);
547:   final lastLineStart = _codeLineStart(code, effectiveEnd);
548:   final starts = <int>[];
549:   var current = firstLineStart;
550:   while (current <= lastLineStart && current <= code.length) {
551:     starts.add(current);
552:     final nextBreak = code.indexOf('\n', current);
553:     if (nextBreak < 0) {
554:       break;
555:     }
556:     current = nextBreak + 1;
557:   }
558:   return starts;
559: }
