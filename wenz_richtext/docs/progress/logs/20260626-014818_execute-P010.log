3415:   /// Whether the current selection could affect this block's rendering: it is
3416:   /// an endpoint, or it lies strictly between the selection's start and end
3417:   /// (so it would be fully highlighted), or the selection is collapsed inside
3418:   /// it (the caret).
3419:   bool _selectionTouchesBlock(_KeepAliveBlock w) {
3420:     final selection = w.selection;
3421:     if (selection == null) {
3422:       return false;
3423:     }
3424:     final index = w.blockIndex;
3425:     final start = selection.start;
3426:     final end = selection.end;
3427:     if (start.blockIndex == index || end.blockIndex == index) {
3428:       return true;
3429:     }
3430:     // Interior block of a multi-block range is fully highlighted.
3431:     return index > start.blockIndex && index < end.blockIndex;
3432:   }
3433: 
3434:   /// Whether an active IME composition affects this block (composition lives in
3435:   /// the caret's block). Only that block needs to repaint the underline span.
3436:   bool _compositionTouchesBlock(_KeepAliveBlock w) {
3437:     final composition = w.compositionState;
3438:     if (composition == null) {
3439:       return false;
3440:     }
3441:     final selection = w.selection;
3442:     return selection != null && selection.extent.blockIndex == w.blockIndex;
3443:   }
3444: }
