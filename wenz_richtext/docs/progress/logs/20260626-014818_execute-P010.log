8689: Future<void> _sendShiftArrowRight(WidgetTester tester) async {
8690:   await tester.sendKeyDownEvent(LogicalKeyboardKey.shiftLeft);
8691:   await tester.sendKeyEvent(LogicalKeyboardKey.arrowRight);
8692:   await tester.sendKeyUpEvent(LogicalKeyboardKey.shiftLeft);
8693:   await tester.pump();
8694: }
8695: 
8696: Finder _richText(String text) {
8697:   return find.byWidgetPredicate(
8698:     (widget) => widget is RichText && widget.text.toPlainText() == text,
8699:     description: 'RichText with plain text "$text"',
8700:   );
8701: }
8702: 
8703: TextSpan _richTextSpan(WidgetTester tester, String text) {
8704:   return tester.widget<RichText>(_richText(text)).text as TextSpan;
8705: }
8706: 
8707: TextSpan? _leafSpan(TextSpan span, String text) {
8708:   final children = span.children;
8709:   if ((children == null || children.isEmpty) && span.text == text) {
8710:     return span;
8711:   }
8712:   for (final child in children ?? const <InlineSpan>[]) {
8713:     if (child is TextSpan) {
8714:       final match = _leafSpan(child, text);
8715:       if (match != null) {
8716:         return match;
8717:       }
8718:     }
8719:   }
8720:   return null;
8721: }
8722: 
8723: Finder _richTextIgnoringCaret(String text) {
8724:   return find.byWidgetPredicate(
8725:     (widget) =>
8726:         widget is RichText &&
8727:         widget.text.toPlainText().replaceAll('\uFFFC', '') == text,
8728:     description: 'RichText with plain text "$text" ignoring caret',
8729:   );
8730: }

