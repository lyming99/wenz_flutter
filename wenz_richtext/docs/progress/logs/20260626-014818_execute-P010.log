9021`t  RelativeRect _fileMenuPosition(BuildContext context) {
9022`t    final overlay =
9023`t        Overlay.of(context).context.findRenderObject() as RenderBox?;
9024`t    final box = context.findRenderObject() as RenderBox?;
9025`t    if (overlay == null || box == null || !overlay.hasSize || !box.hasSize) {
9026`t      return RelativeRect.fill;
9027`t    }
9028`t    final topLeft = box.localToGlobal(Offset.zero, ancestor: overlay);
9029`t    return RelativeRect.fromRect(
9030`t        topLeft & box.size, Offset.zero & overlay.size);
9031`t  }
