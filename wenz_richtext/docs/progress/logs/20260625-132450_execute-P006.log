+      "type": "heading",
+      "attrs": {"level": 1, "collapsed": true},
+      "content": [{"text": "Section"}]
+    },
+    {
+      "id": "p1",
+      "type": "paragraph",
+      "attrs": {"hiddenByHeading": "h1"},
+      "content": [{"text": "Body stays in the document"}]
+    }
+  ]
+}
