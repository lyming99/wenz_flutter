 2817:   /// Whether the current selection could affect this block's rendering: it is
 2818:   /// an endpoint, or it lies strictly between the selection's start and end
 2819:   /// (so it would be fully highlighted), or the selection is collapsed inside
 2820:   /// it (the caret).
 2821:   bool _selectionTouchesBlock(_KeepAliveBlock w) {
 2822:     final selection = w.selection;
 2823:     if (selection == null) {
 2824:       return false;
 2825:     }
 2826:     final index = w.blockIndex;
 2827:     final start = selection.start;
 2828:     final end = selection.end;
 2829:     if (start.blockIndex == index || end.blockIndex == index) {
 2830:       return true;
 2831:     }
 2832:     // Interior block of a multi-block range is fully highlighted.
 2833:     return index > start.blockIndex && index < end.blockIndex;
 2834:   }
 2835: 
 2836:   /// Whether an active IME composition affects this block (composition lives in
 2837:   /// the caret's block). Only that block needs to repaint the underline span.
 2838:   bool _compositionTouchesBlock(_KeepAliveBlock w) {
 2839:     final composition = w.compositionState;
 2840:     if (composition == null) {
 2841:       return false;
 2842:     }
 2843:     final selection = w.selection;
 2844:     return selection != null && selection.extent.blockIndex == w.blockIndex;
 2845:   }
