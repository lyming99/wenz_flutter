 6478: TextStyle _defaultInlineEmbedStyle(
 6479:   BuildContext context,
 6480:   InlineEmbed embed,
 6481:   TextStyle style,
 6482: ) {
 6483:   final scheme = Theme.of(context).colorScheme;
