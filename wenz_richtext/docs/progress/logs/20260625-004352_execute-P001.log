 6459: TextSpan _inlineEmbedSpanFor(
 6460:   BuildContext context,
 6461:   InlineEmbed embed,
 6462:   TextStyle baseStyle,
 6463:   InlineEmbedRenderer? inlineEmbedRenderer, {
