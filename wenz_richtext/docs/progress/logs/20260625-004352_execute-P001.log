 6486:         color: scheme.primary,
 6487:         fontWeight: FontWeight.w600,
 6488:         backgroundColor: scheme.primaryContainer.withAlpha(80),
 6489:       ),
 6490:     'formula' => style.copyWith(
 6491:         color: scheme.onSecondaryContainer,
 6492:         backgroundColor: scheme.secondaryContainer.withAlpha(90),
 6493:         fontFamily: 'monospace',
 6494:       ),
 6495:     'emoji' => style,
 6496:     _ => style.copyWith(
 6497:         color: scheme.onSurfaceVariant,
 6498:         fontStyle: FontStyle.italic,
