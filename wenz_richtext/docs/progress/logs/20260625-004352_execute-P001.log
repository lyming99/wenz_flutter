 6299: /// Builds the inline spans for a text block, overlaying the IME composition
 6300: /// decoration (underline) on the runs that fall inside [compositionRange].
 6301: _InlineTextLayout _inlineTextLayoutFor(
 6302:   BuildContext context,
 6303:   List<InlineNode> nodes,
 6304:   TextStyle baseStyle,
 6305:   _LocalSelectionRange? compositionRange,
 6306:   InlineEmbedRenderer? inlineEmbedRenderer,
 6307: ) {
 6308:   final spans = <InlineSpan>[];
 6309:   final segments = <_InlineOffsetSegment>[];
 6310:   var logicalCursor = 0;
 6311:   var renderCursor = 0;
 6312:   for (final node in nodes) {
 6313:     final logicalLength = inlineLength(node);
 6314:     final nodeStart = logicalCursor;
 6315:     final nodeEnd = logicalCursor + logicalLength;
 6316:     final overlapStart = compositionRange == null
 6317:         ? nodeStart
 6318:         : (nodeStart < compositionRange.start
 6319:             ? compositionRange.start
 6320:             : nodeStart);
 6321:     final overlapEnd = compositionRange == null
 6322:         ? nodeStart
 6323:         : (nodeEnd > compositionRange.end ? compositionRange.end : nodeEnd);
 6324:     final nodeSpans = compositionRange != null && overlapStart < overlapEnd
 6325:         ? _inlineSpansForNodeWithComposition(
 6326:             context,
 6327:             node,
 6328:             baseStyle,
 6329:             inlineEmbedRenderer,
 6330:             start: overlapStart - nodeStart,
 6331:             end: overlapEnd - nodeStart,
 6332:           )
 6333:         : <InlineSpan>[
 6334:             _inlineSpanFor(
 6335:               context,
 6336:               node,
 6337:               baseStyle,
 6338:               inlineEmbedRenderer,
 6339:               decorate: false,
 6340:             )
 6341:           ];
 6342:     final renderLength = _inlineSpanTextLength(nodeSpans);
 6343:     spans.addAll(nodeSpans);
 6344:     if (logicalLength > 0 || renderLength > 0) {
 6345:       segments.add(
 6346:         _InlineOffsetSegment(
 6347:           logicalStart: logicalCursor,
 6348:           logicalEnd: logicalCursor + logicalLength,
 6349:           renderStart: renderCursor,
 6350:           renderEnd: renderCursor + renderLength,
 6351:           atomic: node is InlineEmbed,
 6352:         ),
 6353:       );
 6354:     }
 6355:     logicalCursor += logicalLength;
 6356:     renderCursor += renderLength;
 6357:   }
 6358:   return _InlineTextLayout(
 6359:     spans: spans,
 6360:     offsetMapper: _InlineOffsetMapper(
 6361:       segments: segments,
 6362:       logicalLength: logicalCursor,
 6363:       renderLength: renderCursor,
 6364:     ),
 6365:   );
 6366: }
 6367: 
 6368: int _inlineSpanTextLength(List<InlineSpan> spans) {
 6369:   var length = 0;
 6370:   for (final span in spans) {
 6371:     length += span.toPlainText().length;
 6372:   }
 6373:   return length;
 6374: }
 6375: 
 6376: List<InlineSpan> _inlineSpansForNodeWithComposition(
 6377:   BuildContext context,
 6378:   InlineNode node,
 6379:   TextStyle baseStyle,
 6380:   InlineEmbedRenderer? inlineEmbedRenderer, {
 6381:   required int start,
 6382:   required int end,
 6383: }) {
 6384:   if (node is TextRun) {
 6385:     final text = node.text;
 6386:     final safeStart = start.clamp(0, text.length).toInt();
 6387:     final safeEnd = end.clamp(safeStart, text.length).toInt();
 6388:     final style = _textStyleForAttributes(baseStyle, node.attributes);
 6389:     return <InlineSpan>[
 6390:       if (safeStart > 0)
 6391:         TextSpan(text: text.substring(0, safeStart), style: style),
 6392:       if (safeStart < safeEnd)
 6393:         TextSpan(
 6394:           text: text.substring(safeStart, safeEnd),
 6395:           style: _compositionTextStyle(style),
 6396:         ),
 6397:       if (safeEnd < text.length)
 6398:         TextSpan(text: text.substring(safeEnd), style: style),
 6399:     ];
 6400:   }
 6401: 
 6402:   if (node is InlineEmbed) {
 6403:     return <InlineSpan>[
 6404:       _inlineEmbedSpanFor(
 6405:         context,
 6406:         node,
 6407:         baseStyle,
 6408:         inlineEmbedRenderer,
 6409:         decorate: true,
 6410:       ),
 6411:     ];
 6412:   }
 6413: 
 6414:   final text = node.plainText;
 6415:   final safeStart = start.clamp(0, text.length).toInt();
 6416:   final safeEnd = end.clamp(safeStart, text.length).toInt();
 6417:   return <InlineSpan>[
 6418:     if (safeStart > 0)
 6419:       TextSpan(text: text.substring(0, safeStart), style: baseStyle),
 6420:     if (safeStart < safeEnd)
 6421:       TextSpan(
 6422:         text: text.substring(safeStart, safeEnd),
 6423:         style: _compositionTextStyle(baseStyle),
 6424:       ),
 6425:     if (safeEnd < text.length)
 6426:       TextSpan(text: text.substring(safeEnd), style: baseStyle),
 6427:   ];
 6428: }
 6429: 
 6430: TextSpan _inlineSpanFor(
 6431:   BuildContext context,
 6432:   InlineNode node,
 6433:   TextStyle baseStyle,
 6434:   InlineEmbedRenderer? inlineEmbedRenderer, {
 6435:   bool decorate = false,
 6436: }) {
 6437:   final undecoratedStyle = switch (node) {
 6438:     final TextRun textRun =>
 6439:       _textStyleForAttributes(baseStyle, textRun.attributes),
 6440:     final InlineEmbed embed =>
 6441:       _textStyleForAttributes(baseStyle, embed.attributes),
 6442:     _ => baseStyle,
 6443:   };
 6444:   final style =
 6445:       decorate ? _compositionTextStyle(undecoratedStyle) : undecoratedStyle;
 6446:   return switch (node) {
 6447:     final TextRun textRun => TextSpan(text: textRun.text, style: style),
 6448:     final InlineEmbed embed => _inlineEmbedSpanFor(
 6449:         context,
 6450:         embed,
 6451:         baseStyle,
 6452:         inlineEmbedRenderer,
 6453:         decorate: decorate,
 6454:       ),
 6455:     _ => TextSpan(text: node.plainText, style: style),
 6456:   };
 6457: }
