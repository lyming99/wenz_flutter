 4246:     final text = current.text;
 4247:     if (text != null &&
 4248:         text.isNotEmpty &&
 4249:         style?.decoration?.contains(TextDecoration.underline) == true) {
 4250:       result.add(text);
 4251:     }
 4252:     final children = current.children;
 4253:     if (children != null) {
 4254:       for (final child in children) {
 4255:         visit(child, style);
 4256:       }
 4257:     }
 4258:   }
 4259: 
 4260:   visit(span, null);
 4261:   return result;
 4262: }
