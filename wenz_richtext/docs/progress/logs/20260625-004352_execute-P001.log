 6503: TextStyle _compositionTextStyle(TextStyle style) {
 6504:   final decoration = style.decoration;
 6505:   return style.copyWith(
 6506:     decoration: decoration == null
 6507:         ? TextDecoration.underline
 6508:         : TextDecoration.combine(<TextDecoration>[
 6509:             decoration,
 6510:             TextDecoration.underline,
 6511:           ]),
 6512:   );
