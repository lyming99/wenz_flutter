  524: /// A callout block: emphasised text in a tinted box, optionally carrying a
  525: /// variant (e.g. `'info'`, `'warning'`) for styling.
  526: class CalloutBlockNode extends BlockNode {
  527:   const CalloutBlockNode({
  528:     required super.id,
  529:     required this.content,
  530:     this.variant = 'info',
  531:     this.title = '',
  532:     this.icon = '',
  533:     super.attributes,
  534:   }) : super(type: BlockType.callout);
  535: 
  536:   static const String infoVariant = 'info';
  537:   static const String successVariant = 'success';
  538:   static const String warningVariant = 'warning';
  539:   static const String dangerVariant = 'danger';
  540: 
  541:   static const List<String> supportedVariants = <String>[
  542:     infoVariant,
  543:     successVariant,
  544:     warningVariant,
  545:     dangerVariant,
  546:   ];
  547: 
  548:   final List<InlineNode> content;
  549:   final String variant;
  550:   final String title;
  551:   final String icon;
  552: 
  553:   static String normalizeVariant(Object? value) {
  554:     final text = value?.toString().trim().toLowerCase() ?? '';
  555:     if (supportedVariants.contains(text)) {
  556:       return text;
  557:     }
  558:     return infoVariant;
  559:   }
  560: 
  561:   static String defaultTitleFor(String variant) {
  562:     switch (normalizeVariant(variant)) {
  563:       case successVariant:
  564:         return 'Success';
  565:       case warningVariant:
  566:         return 'Warning';
  567:       case dangerVariant:
  568:         return 'Danger';
  569:       case infoVariant:
  570:       default:
  571:         return 'Info';
  572:     }
  573:   }
  574: 
  575:   static String defaultIconFor(String variant) {
  576:     switch (normalizeVariant(variant)) {
  577:       case successVariant:
  578:         return '✅';
  579:       case warningVariant:
  580:         return '⚠️';
  581:       case dangerVariant:
  582:         return '⛔';
  583:       case infoVariant:
  584:       default:
  585:         return 'ℹ️';
  586:     }
  587:   }
  588: 
  589:   String get normalizedVariant => normalizeVariant(variant);
  590: 
  591:   String get effectiveTitle {
  592:     final trimmed = title.trim();
  593:     return trimmed.isEmpty ? defaultTitleFor(normalizedVariant) : trimmed;
  594:   }
  595: 
  596:   String get effectiveIcon {
  597:     final trimmed = icon.trim();
  598:     return trimmed.isEmpty ? defaultIconFor(normalizedVariant) : trimmed;
  599:   }
  600: 
  601:   @override
  602:   String get plainText {
  603:     final body = content.map((node) => node.plainText).join();
  604:     final heading = title.trim();
  605:     if (heading.isEmpty) {
  606:       return body;
  607:     }
  608:     if (body.isEmpty) {
  609:       return heading;
  610:     }
  611:     return '$heading\n$body';
  612:   }
  613: 
  614:   @override
  615:   CalloutBlockNode copy() {
  616:     return CalloutBlockNode(
  617:       id: id,
  618:       content: content.map((node) => node.copy()).toList(),
  619:       variant: variant,
  620:       title: title,
  621:       icon: icon,
  622:       attributes: attributes,
  623:     );
  624:   }
  625: 
  626:   CalloutBlockNode copyWith({
  627:     String? id,
  628:     List<InlineNode>? content,
  629:     String? variant,
  630:     String? title,
  631:     String? icon,
  632:     BlockAttributes? attributes,
  633:   }) {
  634:     return CalloutBlockNode(
  635:       id: id ?? this.id,
  636:       content: content ?? this.content,
  637:       variant: variant ?? this.variant,
  638:       title: title ?? this.title,
  639:       icon: icon ?? this.icon,
  640:       attributes: attributes ?? this.attributes,
  641:     );
  642:   }
  643: 
  644:   @override
  645:   Map<String, Object?> toJson() {
  646:     return baseJson()
  647:       ..addAll(<String, Object?>{
  648:         'content': content.map((node) => node.toJson()).toList(),
  649:         if (normalizedVariant != infoVariant) 'variant': normalizedVariant,
  650:         if (title.trim().isNotEmpty) 'title': title.trim(),
  651:         if (icon.trim().isNotEmpty) 'icon': icon.trim(),
  652:       });
  653:   }
  654: 
  655:   factory CalloutBlockNode.fromJson(Map<String, Object?> json) {
  656:     final rawContent = json['content'];
  657:     return CalloutBlockNode(
  658:       id: json['id'] as String? ?? '',
  659:       variant: normalizeVariant(json['variant']),
  660:       title: (json['title'] as String? ?? '').trim(),
  661:       icon: (json['icon'] as String? ?? '').trim(),
  662:       content: rawContent is List
  663:           ? rawContent
  664:               .whereType<Map>()
  665:               .map((node) =>
  666:                   InlineNode.fromJson(Map<String, Object?>.from(node)))
  667:               .toList()
  668:           : const <InlineNode>[],
  669:       attributes: BlockNode.attrsFromJson(json),
  670:     );
  671:   }
  672: }
