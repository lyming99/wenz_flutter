  691:     _tableToolbarOverlayController.dispose();
  692:     _scrollController.dispose();
  693:     // BlockGeometryRegistry holds no native resources; clearing its maps is
  694:     // unnecessary once the editor is gone.
  695:     _layoutCache.dispose();
  696:     _internalFocusNode?.dispose();
  697:     super.dispose();
