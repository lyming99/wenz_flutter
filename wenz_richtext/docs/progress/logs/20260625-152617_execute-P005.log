  863:   bool _expandHiddenContentAdjacentToSelection({required bool forward}) {
  864:     if (_revealCurrentSelectionIfHidden()) {
  865:       return true;
  866:     }
  867:     final outline = widget.outlineController;
  868:     final selection = widget.controller.selection;
  869:     if (outline == null ||
  870:         selection == null ||
  871:         !selection.isCollapsed ||
  872:         !identical(outline.editor, widget.controller)) {
  873:       return false;
  874:     }
  875:     final position = selection.extent;
  876:     if (!_isAtBlockBoundary(position, forward: forward)) {
  877:       return false;
  878:     }
  879:     final blocks = widget.controller.document.blocks;
  880:     final adjacentIndex = position.blockIndex + (forward ? 1 : -1);
  881:     if (adjacentIndex < 0 || adjacentIndex >= blocks.length) {
  882:       return false;
  883:     }
  884:     return outline.expandToRevealBlockId(blocks[adjacentIndex].id);
  885:   }
  886: 
  887:   bool _isAtBlockBoundary(
  888:     DocumentPosition position, {
  889:     required bool forward,
  890:   }) {
  891:     final blocks = widget.controller.document.blocks;
  892:     if (position.blockIndex < 0 || position.blockIndex >= blocks.length) {
  893:       return false;
  894:     }
  895:     final block = blocks[position.blockIndex];
  896:     if (position.path.isBlockText && block is TextBlockNode) {
  897:       final length = inlineNodesLength(block.content);
  898:       final offset = position.offset.clamp(0, length).toInt();
  899:       return forward ? offset >= length : offset <= 0;
  900:     }
  901:     if (position.path.isBlockCode && block is CodeBlockNode) {
  902:       final offset = position.offset.clamp(0, block.code.length).toInt();
  903:       return forward ? offset >= block.code.length : offset <= 0;
  904:     }
  905:     return position.path.isBlockObject;
  906:   }
