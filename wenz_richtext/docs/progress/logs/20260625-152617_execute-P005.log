  208: /// Anchor installed by table renderers. It publishes or withdraws requests while
  209: /// leaving overlay ownership with [TableFloatingToolbarOverlayHost].
  210: class TableFloatingToolbarOverlayAnchor extends StatefulWidget {
  211:   const TableFloatingToolbarOverlayAnchor({
  212:     super.key,
  213:     required this.controller,
  214:     required this.requestBuilder,
  215:     required this.child,
  216:   });
  217: 
  218:   final TableFloatingToolbarOverlayController? controller;
  219:   final TableFloatingToolbarOverlayRequestBuilder? requestBuilder;
  220:   final Widget child;
  221: 
  222:   @override
  223:   State<TableFloatingToolbarOverlayAnchor> createState() =>
  224:       _TableFloatingToolbarOverlayAnchorState();
  225: }
  226: 
  227: class _TableFloatingToolbarOverlayAnchorState
  228:     extends State<TableFloatingToolbarOverlayAnchor>
  229:     with WidgetsBindingObserver {
  230:   final LayerLink _anchorLink = LayerLink();
  231:   final Object _owner = Object();
  232:   ScrollPosition? _scrollPosition;
  233:   bool _syncScheduled = false;
  234: 
  235:   @override
  236:   void initState() {
  237:     super.initState();
  238:     WidgetsBinding.instance.addObserver(this);
  239:     _scheduleSync();
  240:   }
  241: 
  242:   @override
  243:   void didUpdateWidget(covariant TableFloatingToolbarOverlayAnchor oldWidget) {
  244:     super.didUpdateWidget(oldWidget);
  245:     if (oldWidget.controller != widget.controller) {
  246:       oldWidget.controller?.hide(owner: _owner);
  247:     }
  248:     _scheduleSync();
  249:   }
  250: 
  251:   @override
  252:   void didChangeDependencies() {
  253:     super.didChangeDependencies();
  254:     _syncScrollPosition(Scrollable.maybeOf(context)?.position);
  255:     _scheduleSync();
  256:   }
  257: 
  258:   @override
  259:   void didChangeMetrics() {
  260:     _scheduleSync();
  261:   }
  262: 
  263:   @override
  264:   void dispose() {
  265:     WidgetsBinding.instance.removeObserver(this);
  266:     _scrollPosition?.removeListener(_scheduleSync);
  267:     widget.controller?.hide(owner: _owner);
  268:     super.dispose();
  269:   }
  270: 
  271:   @override
  272:   Widget build(BuildContext context) {
  273:     _scheduleSync();
  274:     return CompositedTransformTarget(
  275:       link: _anchorLink,
  276:       child: widget.child,
  277:     );
  278:   }
  279: 
  280:   void _scheduleSync() {
  281:     if (_syncScheduled) {
  282:       return;
  283:     }
  284:     _syncScheduled = true;
  285:     WidgetsBinding.instance.addPostFrameCallback((_) {
  286:       _syncScheduled = false;
  287:       _syncRequest();
  288:     });
  289:   }
  290: 
  291:   void _syncScrollPosition(ScrollPosition? position) {
  292:     if (identical(_scrollPosition, position)) {
  293:       return;
  294:     }
  295:     _scrollPosition?.removeListener(_scheduleSync);
  296:     _scrollPosition = position;
  297:     _scrollPosition?.addListener(_scheduleSync);
  298:   }
  299: 
  300:   void _syncRequest() {
  301:     if (!mounted) {
  302:       return;
  303:     }
  304:     final controller = widget.controller;
  305:     final requestBuilder = widget.requestBuilder;
  306:     if (controller == null || requestBuilder == null) {
  307:       controller?.hide(owner: _owner);
  308:       return;
  309:     }
  310:     final renderObject = context.findRenderObject();
  311:     if (renderObject is! RenderBox ||
  312:         !renderObject.attached ||
  313:         !renderObject.hasSize) {
  314:       controller.hide(owner: _owner);
  315:       return;
  316:     }
  317:     final anchorTopLeft = renderObject.localToGlobal(Offset.zero);
  318:     final anchorRect = anchorTopLeft & renderObject.size;
  319:     controller.show(
  320:       requestBuilder(
  321:         owner: _owner,
  322:         anchorLink: _anchorLink,
  323:         anchorRect: anchorRect,
  324:         visibleTop: _visibleTopFor(context),
  325:       ),
  326:     );
  327:   }
  328: 
  329:   double _visibleTopFor(BuildContext context) {
  330:     final scrollable = Scrollable.maybeOf(context);
  331:     final viewportObject = scrollable?.context.findRenderObject();
  332:     if (viewportObject is RenderBox &&
  333:         viewportObject.attached &&
  334:         viewportObject.hasSize) {
  335:       return viewportObject.localToGlobal(Offset.zero).dy;
  336:     }
  337:     return MediaQuery.maybeOf(context)?.padding.top ?? 0;
  338:   }
  339: }
