1291	          if (current == null || current.table.columnCount <= 1) {
1292	            break;
1293	          }
1294	          widget.controller.deleteTableColumn(
1295	            blockIndex: intent.blockIndex,
1296	            columnIndex: column,
1297	          );
1298	        }
1299	        return;
1300	      case TableToolbarAction.toggleHeader:
1301	        final anchor = _firstVisibleTableCell(tableBlock, range);
1302	        if (anchor == null) {
