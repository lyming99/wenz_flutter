632	      copyRow(tableBlock.table.rows[i]),
633	  ];
634	  return _replaceTableWithSelection(
635	    session,
636	    blockIndex,
637	    tableBlock,
638	    rows,
639	    selection: _tableSelectionAfterRowInserted(
