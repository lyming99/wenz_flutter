772	DocumentSelection? _mapTableSelection(
773	  DocumentSelection? selection,
774	  TableBlockNode tableBlock,
775	  int blockIndex,
776	  List<List<TableCellNode>> rows, {
777	  required int Function(int rowIndex) mapRow,
778	  required int Function(int columnIndex) mapColumn,
779	}) {
780	  final range = selection?.tableCellRange;
781	  if (selection == null ||
782	      range == null ||
783	      range.tableBlockId != tableBlock.id ||
784	      range.blockIndex != blockIndex) {
785	    return null;
786	  }
787	  final base = _mapTablePosition(
788	    selection.base,
789	    tableBlock,
790	    blockIndex,
791	    rows,
792	    mapRow: mapRow,
793	    mapColumn: mapColumn,
794	  );
795	  final extent = _mapTablePosition(
796	    selection.extent,
797	    tableBlock,
798	    blockIndex,
799	    rows,
800	    mapRow: mapRow,
801	    mapColumn: mapColumn,
802	  );
803	  if (base == null || extent == null) {
804	    return null;
805	  }
806	  return DocumentSelection(base: base, extent: extent);
807	}
