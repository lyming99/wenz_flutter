1449	  void _forEachVisibleTableCell(
1450	    TableBlockNode tableBlock,
1451	    TableCellRange range,
1452	    void Function(int row, int column) visit,
1453	  ) {
1454	    for (var row = range.startRow; row <= range.endRow; row++) {
1455	      for (var column = range.startColumn;
1456	          column <= range.endColumn;
1457	          column++) {
