348	  void _syncRequest() {
349	    if (!mounted) {
350	      return;
351	    }
352	    final controller = widget.controller;
353	    if (controller == null) {
354	      return;
355	    }
356	    final renderObject = context.findRenderObject();
357	    if (renderObject is! RenderBox ||
358	        !renderObject.attached ||
359	        !renderObject.hasSize) {
360	      controller.unregisterAnchor(owner: _owner);
361	      return;
362	    }
363	    final anchorTopLeft = renderObject.localToGlobal(Offset.zero);
364	    final anchorRect = anchorTopLeft & renderObject.size;
365	    final visibleTop = _visibleTopFor(context);
366	    controller.updateAnchor(
367	      TableFloatingToolbarAnchorSnapshot(
368	        owner: _owner,
369	        anchorLink: _anchorLink,
370	        anchorRect: anchorRect,
371	        visibleTop: visibleTop,
372	        tableBlockId: widget.tableBlockId,
373	        blockIndex: widget.blockIndex,
374	      ),
375	    );
376	    final requestBuilder = widget.requestBuilder;
377	    if (requestBuilder == null) {
378	      controller.hide(owner: _owner);
379	      return;
380	    }
381	    controller.show(
382	      requestBuilder(
383	        owner: _owner,
384	        anchorLink: _anchorLink,
385	        anchorRect: anchorRect,
386	        visibleTop: visibleTop,
387	      ),
388	    );
389	  }
390	
391	  double _visibleTopFor(BuildContext context) {
392	    final scrollable = Scrollable.maybeOf(context);
393	    final viewportObject = scrollable?.context.findRenderObject();
394	    if (viewportObject is RenderBox &&
395	        viewportObject.attached &&
396	        viewportObject.hasSize) {
397	      return viewportObject.localToGlobal(Offset.zero).dy;
398	    }
399	    return MediaQuery.maybeOf(context)?.padding.top ?? 0;
400	  }
