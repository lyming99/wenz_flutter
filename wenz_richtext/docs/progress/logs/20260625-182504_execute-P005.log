803	  TableFloatingToolbarOverlayRequest?
804	      _tableToolbarRequestForCurrentSelection() {
805	    if (widget.readOnly) {
806	      return null;
807	    }
808	    final tableRange = widget.controller.selection?.tableCellRange;
809	    if (tableRange == null) {
810	      return null;
811	    }
812	    final tableBlock = _tableBlockAt(tableRange.blockIndex);
813	    final normalizedRange =
814	        tableBlock != null && tableBlock.id == tableRange.tableBlockId
815	            ? _normalizeTableRange(tableBlock, tableRange)
816	            : null;
817	    if (tableBlock == null ||
818	        normalizedRange == null ||
819	        tableBlock.id != tableRange.tableBlockId) {
820	      return null;
821	    }
822	    final anchor = _tableToolbarOverlayController.anchorFor(
823	      tableBlock.id,
824	      blockIndex: tableRange.blockIndex,
825	    );
826	    if (anchor == null) {
827	      return null;
828	    }
829	    return TableFloatingToolbarOverlayRequest(
830	      owner: anchor.owner,
831	      anchorLink: anchor.anchorLink,
832	      anchorRect: anchor.anchorRect,
833	      visibleTop: anchor.visibleTop,
834	      tableBlockId: tableBlock.id,
835	      blockIndex: tableRange.blockIndex,
836	      selectionRange: normalizedRange,
837	      minWidth: _kTableToolbarMinWidth,
838	      gap: _kTableFloatingToolbarGap,
839	      fallbackHeight: _kTableFloatingToolbarEstimatedHeight,
840	      toolbarBuilder: (context) => _TableFloatingToolbar(
841	        block: tableBlock,
