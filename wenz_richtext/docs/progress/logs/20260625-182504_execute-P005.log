328	  void _scheduleSync() {
329	    if (_syncScheduled) {
330	      return;
331	    }
332	    _syncScheduled = true;
333	    WidgetsBinding.instance.addPostFrameCallback((_) {
334	      _syncScheduled = false;
335	      _syncRequest();
336	    });
337	  }
