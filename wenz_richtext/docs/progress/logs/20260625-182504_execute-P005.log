612	CommandResult insertTableRowAt(
613	  DocumentSession session,
614	  int blockIndex,
615	  int rowIndex, {
616	  TableCellIdBuilder? cellIdBuilder,
617	}) {
618	  final tableBlock = tableAt(session, blockIndex);
619	  if (tableBlock == null) {
620	    return const CommandResult(recordHistory: false);
621	  }
622	  final insertIndex = rowIndex.clamp(0, tableBlock.table.rowCount).toInt();
