  854: /// Vertical (ArrowUp/ArrowDown) motion within a table. Moves to the same
  855: /// column one row up/down, preserving the caret offset clamped to the target
  856: /// cell's length. When the target cell is `covered` (hidden behind a merged
  857: /// anchor), walks further until a visible cell is found; if none exists before
  858: /// the table edge, returns `null` (caret stays put).
  859: DocumentPosition? _verticalTableCellPosition(
  860:   RichTextDocument document,
  861:   DocumentPosition position,
  862:   CaretMovementDirection direction,
  863: ) {
  864:   final block = _blockAt(document, position.blockIndex);
  865:   final rowIndex = position.path.tableRowIndex;
  866:   final columnIndex = position.path.tableColumnIndex;
  867:   if (block is! TableBlockNode || rowIndex == null || columnIndex == null) {
  868:     return null;
  869:   }
  870:   final step = direction == CaretMovementDirection.forward ? 1 : -1;
  871:   var nextRow = rowIndex + step;
  872:   while (nextRow >= 0 && nextRow < block.table.rowCount) {
  873:     final cell = block.table.cellAt(nextRow, columnIndex);
  874:     if (cell != null && !cell.covered) {
  875:       final length = _tableCellLengthAt(block, nextRow, columnIndex);
  876:       final offset = position.offset.clamp(0, length).toInt();
  877:       return DocumentPosition.tableCell(
  878:         tableBlockId: block.id,
  879:         blockIndex: position.blockIndex,
  880:         tableRowIndex: nextRow,
  881:         tableColumnIndex: columnIndex,
  882:         offset: offset,
  883:       );
  884:     }
  885:     nextRow += step;
  886:   }
  887:   return null;
  888: }
