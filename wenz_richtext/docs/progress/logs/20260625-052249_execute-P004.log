  329:     for (var i = start.blockIndex; i <= end.blockIndex; i++) {
  330:       final block = _blockAt(document, i);
  331:       if (block == null) {
  332:         continue;
  333:       }
  334:       final content = _blockTextContent(block);
  335:       if (i == start.blockIndex && content != null) {
  336:         lines.add(
  337:           _plainTextForInlineNodes(
