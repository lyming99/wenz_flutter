  391:   String _plainTextForBoundary(BlockNode block, DocumentPosition position) {
  392:     if (block is CalloutBlockNode && position.path.isBlockText) {
  393:       return _plainTextForInlineNodes(block.content);
  394:     }
  395:     if (block is TextBlockNode && position.path.isBlockText) {
  396:       return _plainTextForInlineNodes(block.content);
  397:     }
  398:     return block.plainText;
  399:   }
