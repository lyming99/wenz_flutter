+    return '[video: ${_videoPlainTextLabel(block)}]';
+  }
+  return block.plainText;
+}
+
+String _videoPlainTextLabel(VideoBlockNode video) {
+  final label = video.displayText.trim();
+  return label.isEmpty ? 'video' : label;
+}
