  368:   BlockNode _copyTextLikeBlockWithContent(
  369:       BlockNode block, List<InlineNode> content,
  370:       {required bool preserveCalloutMetadata}) {
  371:     return switch (block) {
  372:       TextBlockNode() => TextBlockNode(
  373:           id: block.id,
  374:           type: block.type,
  375:           attributes: block.attributes,
  376:           content: content,
  377:         ),
  378:       CalloutBlockNode() => preserveCalloutMetadata
  379:           ? block.copyWith(content: content)
  380:           : CalloutBlockNode(
  381:               id: block.id,
  382:               content: content,
  383:               variant: block.variant,
  384:               icon: block.icon,
  385:               attributes: block.attributes,
  386:             ),
  387:       _ => block.copy(),
  388:     };
  389:   }
