  563: /// Character classes used by word motion. CJK ideographs each form their own
  564: /// word (matching platform segmentation), ASCII word chars move as a run, and
  565: /// everything else is a separator.
  566: enum _CharClass { word, cjk, separator }
  567: 
  568: _CharClass _charClass(int codeUnit) {
  569:   // ASCII letter / digit / underscore.
  570:   final isLower = codeUnit >= 0x61 && codeUnit <= 0x7A;
  571:   final isUpper = codeUnit >= 0x41 && codeUnit <= 0x5A;
  572:   final isDigit = codeUnit >= 0x30 && codeUnit <= 0x39;
  573:   if (isLower || isUpper || isDigit || codeUnit == 0x5F) {
  574:     return _CharClass.word;
  575:   }
  576:   // Common CJK Unified Ideographs (+ extensions A/B/C/D/E/F), Hiragana,
  577:   // Katakana, Hangul, and CJK punctuation. Each CJK glyph is its own word.
  578:   if (_isCjkCodeUnit(codeUnit)) {
  579:     return _CharClass.cjk;
  580:   }
  581:   return _CharClass.separator;
  582: }
  583: 
  584: bool _isCjkCodeUnit(int codeUnit) {
  585:   // CJK Unified Ideographs and adjacent blocks. Code units here are UTF-16;
  586:   // surrogate pairs (supplementary planes) are rare in everyday CJK text and
  587:   // are left to fall through as separators — matching TextPainter behaviour
  588:   // closely enough for word motion.
  589:   return (codeUnit >= 0x3400 && codeUnit <= 0x9FFF) || // CJK + Ext A
  590:       (codeUnit >= 0xA000 && codeUnit <= 0xD7AF) || // Hangul Syllables
  591:       (codeUnit >= 0xF900 && codeUnit <= 0xFAFF) || // CJK Compat Ideographs
  592:       (codeUnit >= 0xFF00 && codeUnit <= 0xFFEF) || // Halfwidth/Fullwidth
  593:       (codeUnit >= 0x3040 && codeUnit <= 0x30FF) || // Hiragana + Katakana
  594:       (codeUnit >= 0xAC00 && codeUnit <= 0xD7A3); // Hangul Syllables
  595: }
