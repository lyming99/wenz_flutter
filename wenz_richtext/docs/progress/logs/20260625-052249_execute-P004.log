  520: /// Extracts the inline nodes covering [start, end) within [nodes], splitting
  521: /// runs at the boundaries (mirrors [formatInline] semantics without applying
  522: /// any attribute change).
  523: List<InlineNode> _sliceInline(List<InlineNode> nodes, int start, int end) {
  524:   if (end <= start) {
  525:     return const <InlineNode>[];
  526:   }
  527:   final result = <InlineNode>[];
  528:   var cursor = 0;
  529:   for (final node in nodes) {
  530:     final nodeStart = cursor;
  531:     final nodeEnd = cursor + inlineLength(node);
  532:     cursor = nodeEnd;
