  507: DocumentPosition? _moveWordFrom(
  508:   RichTextDocument document,
  509:   DocumentPosition position,
  510:   CaretMovementDirection direction,
  511: ) {
  512:   final block = _blockAt(document, position.blockIndex);
  513:   if (block == null || !_isEditable(block)) {
  514:     return direction == CaretMovementDirection.backward
  515:         ? _previousEditablePosition(document, position.blockIndex)
  516:         : _nextEditablePosition(document, position.blockIndex);
  517:   }
  518:   final text = _editablePlainText(block);
  519:   final length = text.length;
  520:   var offset = position.offset.clamp(0, length).toInt();
  521:   if (direction == CaretMovementDirection.forward) {
  522:     // Move past the current run, then past any trailing separators. CJK chars
  523:     // each form their own one-character run, so this stops on every CJK glyph.
  524:     final startClass = offset < length
  525:         ? _charClass(text.codeUnitAt(offset))
  526:         : _CharClass.separator;
  527:     while (offset < length &&
  528:         _charClass(text.codeUnitAt(offset)) == startClass &&
  529:         startClass != _CharClass.separator) {
  530:       offset += 1;
  531:     }
  532:     while (offset < length &&
  533:         _charClass(text.codeUnitAt(offset)) == _CharClass.separator) {
  534:       offset += 1;
  535:     }
  536:   } else {
  537:     // Move back over separators, then back over the preceding run.
  538:     while (offset > 0 &&
  539:         _charClass(text.codeUnitAt(offset - 1)) == _CharClass.separator) {
  540:       offset -= 1;
  541:     }
  542:     if (offset > 0) {
  543:       final runClass = _charClass(text.codeUnitAt(offset - 1));
  544:       // CJK: stop after one character. ASCII word run: consume the whole run.
  545:       while (
  546:           offset > 0 && _charClass(text.codeUnitAt(offset - 1)) == runClass) {
  547:         offset -= 1;
  548:         if (runClass == _CharClass.cjk) {
  549:           break;
  550:         }
  551:       }
  552:     }
  553:   }
  554:   if (offset == position.offset.clamp(0, length).toInt()) {
  555:     // Did not move within the block: jump to the neighbouring editable block.
  556:     return direction == CaretMovementDirection.backward
  557:         ? _previousEditablePosition(document, position.blockIndex)
  558:         : _nextEditablePosition(document, position.blockIndex);
  559:   }
  560:   return position.copyWith(offset: offset);
  561: }
