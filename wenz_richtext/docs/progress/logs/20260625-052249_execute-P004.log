  339:           ),
  340:         );
  341:       } else if (i == end.blockIndex && content != null) {
  342:         lines.add(
  343:           _plainTextForInlineNodes(_sliceInline(content, 0, end.offset)),
  344:         );
  345:       } else if (i == start.blockIndex) {
  346:         final text = _plainTextForBoundary(block, start);
  347:         lines.add(text.substring(start.offset.clamp(0, text.length)));
