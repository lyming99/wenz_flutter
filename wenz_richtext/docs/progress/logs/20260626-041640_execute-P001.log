+    Set<EditorShortcutPlatform> platforms = const <EditorShortcutPlatform>{
+      EditorShortcutPlatform.all,
+    },
+    bool expandSelection = false,
+    String? character,
+  }) : this._(
+          key: key,
+          disposition: EditorShortcutDisposition.handled,
+          intent: intent,
+          modifiers: modifiers,
+          platforms: platforms,
+          expandSelection: expandSelection,
+          character: character,
+        );
+
+  const EditorShortcutBinding.ignored({
+    required LogicalKeyboardKey key,
+    Set<EditorShortcutModifier> modifiers = const <EditorShortcutModifier>{},
+    Set<EditorShortcutPlatform> platforms = const <EditorShortcutPlatform>{
+      EditorShortcutPlatform.all,
+    },
+  }) : this._(
+          key: key,
+          disposition: EditorShortcutDisposition.ignored,
+          modifiers: modifiers,
+          platforms: platforms,
+        );
+
+  const EditorShortcutBinding.passThrough({
+    required LogicalKeyboardKey key,
+    Set<EditorShortcutModifier> modifiers = const <EditorShortcutModifier>{},
+    Set<EditorShortcutPlatform> platforms = const <EditorShortcutPlatform>{
+      EditorShortcutPlatform.all,
+    },
+  }) : this._(
+          key: key,
+          disposition: EditorShortcutDisposition.passThrough,
+          modifiers: modifiers,
+          platforms: platforms,
+        );
+
+  const EditorShortcutBinding._({
+    required this.key,
+    required this.disposition,
+    this.intent,
+    this.modifiers = const <EditorShortcutModifier>{},
+    this.platforms = const <EditorShortcutPlatform>{EditorShortcutPlatform.all},
+    this.expandSelection = false,
+    this.character,
+  });
