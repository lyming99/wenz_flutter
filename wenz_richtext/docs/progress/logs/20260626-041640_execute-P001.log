+/// Declarative shortcut configuration contract.
+///
+/// The manager keeps the built-in keymap when no configuration is supplied.
+/// Future configuration-aware resolution must apply built-ins first, then
+/// plugin-provided fragments, then the editor-level configuration, so caller
+/// bindings can add new combinations or override defaults predictably.
+///
+/// Conflict contract:
+///
+/// - The normalized key combination is `[platforms] + [modifiers] + [key]`.
+/// - Multiple bindings with the same combination are resolved by the later
+///   binding winning.
+/// - Multiple bindings for the same intent are allowed and act as aliases.
+/// - [disabledIntents] turns matching handled resolutions into `ignored`; use a
+///   pass-through binding when the host app should receive the combination.
+/// - Read-only mode still blocks write intents after resolution.
+/// - IME composing/text-input attachment still suppresses plain character
+///   insertion, but command shortcuts may continue to resolve.
+/// - [EditorShortcutIntent.insertCharacter] bindings must provide exactly one
+///   non-control [EditorShortcutBinding.character]; invalid character bindings
+///   are ignored by validation rather than treated as text input.
+class EditorShortcutConfiguration {
+  const EditorShortcutConfiguration({
+    this.bindings = const <EditorShortcutBinding>[],
+    this.disabledIntents = const <EditorShortcutIntent>{},
+  });
+
+  /// Additional or overriding bindings evaluated after the default keymap.
+  final List<EditorShortcutBinding> bindings;
+
+  /// Intents that should not be executed by the editor.
+  final Set<EditorShortcutIntent> disabledIntents;
+}
+
+/// Maps one normalized key combination to a shortcut resolution.
+class EditorShortcutBinding {
+  const EditorShortcutBinding.handled({
+    required LogicalKeyboardKey key,
+    required EditorShortcutIntent intent,
