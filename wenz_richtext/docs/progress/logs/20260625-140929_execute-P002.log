  202: /// Bundles everything a block renderer needs to paint a block. Passed to every
  203: /// [BlockRendererBuilder] so custom renderers get the same surface as the
  204: /// built-in ones (selection, caret, geometry, IME composition, debug overlay).
  205: ///
  206: /// Fields are intentionally the union of what each built-in renderer consumes;
  207: /// a renderer is free to ignore the ones it does not need.
  208: ///
  209: /// Row-level chrome such as the [BlockDragHandleSpec] surface is deliberately
  210: /// editor-owned and sits outside renderer output. Renderers paint block content
  211: /// only, which keeps default drag handles available to custom renderers and
  212: /// prevents nested table-cell text or inline/object controls from becoming
  213: /// sortable rows.
  214: class BlockRenderContext {
  215:   const BlockRenderContext({
  216:     required this.block,
  217:     required this.blockIndex,
  218:     this.blockCount = 1,
  219:     required this.selection,
  220:     required this.compositionState,
  221:     required this.registry,
  222:     required this.showCaret,
  223:     this.textStyle,
  224:     this.showDebugOverlay = false,
  225:     this.canEdit = true,
  226:     this.mediaResolver,
  227:     this.inlineEmbedRenderer,
  228:     this.listMarker,
  229:     this.onCodeLanguageChanged,
  230:     this.onCodeCopied,
  231:     this.onCalloutVariantChanged,
  232:     this.onTableToolbarAction,
  233:     this.tableToolbarOverlayController,
  234:     this.onTableColumnResize,
  235:     this.onTodoCheckedChanged,
  236:     this.onObjectBlockAction,
  237:     this.headingCollapseState,
  238:     this.onHeadingCollapseToggled,
  239:     this.findMatches = const <FindReplaceMatch>[],
  240:     this.currentFindMatch,
  241:   });
  242: 
  243:   final BlockNode block;
  244:   final int blockIndex;
  245: 
  246:   /// Number of top-level blocks in the host editor. Defaults to one for
  247:   /// hand-built contexts so boundary-sensitive actions stay disabled unless the
  248:   /// host supplies the actual count.
  249:   final int blockCount;
  250:   final DocumentSelection? selection;
  251:   final CompositionState? compositionState;
  252:   final BlockGeometryRegistry registry;
  253:   final bool showCaret;
  254:   final TextStyle? textStyle;
  255:   final bool showDebugOverlay;
  256: 
  257:   /// Whether renderers should expose mutating controls. Read-only editors can
  258:   /// still offer copy-style object actions through [onObjectBlockAction].
  259:   final bool canEdit;
  260: 
  261:   /// Optional [MediaResolver] injected via the editor. The built-in
  262:   /// image/video/file renderers consult it before falling back to the
  263:   /// placeholder. `null` when no resolver is injected. Custom renderers may
  264:   /// read it too if they want to share the same resolution logic.
  265:   final MediaResolver? mediaResolver;
  266: 
  267:   /// Optional inline embed renderer injected via the editor. The built-in text
  268:   /// renderers consult it for [InlineEmbed]s before falling back to their
  269:   /// default formula / mention / image labels.
  270:   final InlineEmbedRenderer? inlineEmbedRenderer;
  271: 
  272:   /// Optional list marker precomputed by the host editor for list item blocks.
  273:   /// Ordered markers depend on sibling blocks, so the editor supplies them here
  274:   /// instead of making renderers inspect the whole document.
  275:   final String? listMarker;
  276: 
  277:   /// Optional callback used by code block renderers to change the block's
  278:   /// language through the host controller.
  279:   final ValueChanged<String>? onCodeLanguageChanged;
  280: 
  281:   /// Optional callback used by code block renderers to copy the code text.
  282:   final Future<void> Function(String code)? onCodeCopied;
  283: 
  284:   /// Optional callback used by callout renderers to change the block variant
  285:   /// through the host controller.
  286:   final ValueChanged<String>? onCalloutVariantChanged;
  287: 
  288:   /// Optional callback used by table renderers to route floating-toolbar table
  289:   /// actions through the host controller.
  290:   final TableToolbarActionHandler? onTableToolbarAction;
  291: 
  292:   /// Editor-owned overlay controller used by table renderers to publish toolbar
  293:   /// requests without owning [OverlayEntry] / [OverlayPortal] lifecycle.
  294:   final TableFloatingToolbarOverlayController? tableToolbarOverlayController;
  295: 
  296:   /// Optional callback used by table renderers to persist drag-resized column
  297:   /// widths through the host controller.
  298:   final TableColumnResizeHandler? onTableColumnResize;
  299: 
  300:   /// Optional callback used by task-list renderers to persist checkbox changes.
  301:   final TodoCheckedChangeHandler? onTodoCheckedChanged;
  302: 
  303:   /// Optional callback used by object-block renderers (image/video/file/embed
  304:   /// and divider) to route quick actions through the host editor/controller.
  305:   final ObjectBlockActionHandler? onObjectBlockAction;
  306: 
  307:   /// Optional view-state for a top-level heading's collapse affordance. `null`
  308:   /// means the host editor is not exposing heading collapse for this block.
  309:   final HeadingCollapseState? headingCollapseState;
  310: 
  311:   /// Optional callback used by heading renderers to toggle collapse view-state.
  312:   final ValueChanged<String>? onHeadingCollapseToggled;
  313: 
  314:   /// Find/replace matches currently visible for this block renderer. Built-in
  315:   /// text renderers paint them as non-destructive highlights; custom renderers
  316:   /// can opt in by mapping these ranges onto their own text surfaces.
  317:   final List<FindReplaceMatch> findMatches;
  318: 
  319:   /// The active find match, if any. It is also present in [findMatches].
  320:   final FindReplaceMatch? currentFindMatch;
  321: 
  322:   /// Whether the active (collapsed) selection sits inside [block], i.e. this
  323:   /// block owns the caret. Convenience for caret-aware renderers.
  324:   bool get ownsCaret {
  325:     final sel = selection;
  326:     if (sel == null || !sel.isCollapsed) {
  327:       return false;
  328:     }
  329:     return sel.extent.blockIndex == blockIndex &&
  330:         sel.extent.blockId == block.id;
  331:   }
  332: }
