 1111:   Offset _slashMenuOffset() {
 1112:     final fallback = widget.padding.resolve(TextDirection.ltr).topLeft;
 1113:     final selection = widget.controller.selection;
 1114:     final overlayContext = _editorOverlayKey.currentContext;
 1115:     final overlayBox = overlayContext?.findRenderObject();
 1116:     if (selection == null ||
 1117:         !selection.isCollapsed ||
 1118:         overlayBox is! RenderBox ||
 1119:         !overlayBox.hasSize) {
 1120:       return fallback;
 1121:     }
 1122:     final caret = _registry.caretRectForPosition(selection.extent);
 1123:     if (caret == null) {
 1124:       return fallback;
 1125:     }
 1126:     final local = overlayBox.globalToLocal(caret.bottomLeft);
 1127:     final maxLeft = overlayBox.size.width - 280;
 1128:     return Offset(
 1129:       local.dx.clamp(0, maxLeft > 0 ? maxLeft : 0).toDouble(),
 1130:       (local.dy + 6).clamp(0, overlayBox.size.height).toDouble(),
 1131:     );
 1132:   }
