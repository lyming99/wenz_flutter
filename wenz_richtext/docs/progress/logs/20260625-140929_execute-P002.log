 1185: 
 1186:     final range = _currentTableRange(tableBlock, intent) ??
 1187:         TableCellRange(
 1188:           tableBlockId: tableBlock.id,
 1189:           blockIndex: intent.blockIndex,
 1190:           startRow: intent.rowIndex,
 1191:           endRow: intent.targetEndRowIndex,
 1192:           startColumn: intent.columnIndex,
 1193:           endColumn: intent.targetEndColumnIndex,
 1194:         );
 1195: 
 1196:     switch (intent.action) {
 1197:       case TableToolbarAction.insertRowAbove:
 1198:         widget.controller.insertTableRow(
 1199:           blockIndex: intent.blockIndex,
 1200:           rowIndex: range.startRow,
 1201:         );
 1202:         return;
 1203:       case TableToolbarAction.insertRowBelow:
 1204:         widget.controller.insertTableRow(
 1205:           blockIndex: intent.blockIndex,
 1206:           rowIndex: range.endRow + 1,
 1207:         );
 1208:         return;
 1209:       case TableToolbarAction.deleteRow:
 1210:         for (var row = range.endRow; row >= range.startRow; row--) {
 1211:           final current = _tableBlockAt(intent.blockIndex);
 1212:           if (current == null || current.table.rowCount <= 1) {
 1213:             break;
 1214:           }
 1215:           widget.controller.deleteTableRow(
 1216:             blockIndex: intent.blockIndex,
 1217:             rowIndex: row,
 1218:           );
 1219:         }
 1220:         return;
 1221:       case TableToolbarAction.insertColumnBefore:
 1222:         widget.controller.insertTableColumn(
 1223:           blockIndex: intent.blockIndex,
 1224:           columnIndex: range.startColumn,
 1225:         );
 1226:         return;
 1227:       case TableToolbarAction.insertColumnAfter:
 1228:         widget.controller.insertTableColumn(
 1229:           blockIndex: intent.blockIndex,
 1230:           columnIndex: range.endColumn + 1,
