  208: /// Anchor installed by table renderers. It publishes or withdraws requests while
  209: /// leaving overlay ownership with [TableFloatingToolbarOverlayHost].
  210: class TableFloatingToolbarOverlayAnchor extends StatefulWidget {
  211:   const TableFloatingToolbarOverlayAnchor({
  212:     super.key,
  213:     required this.controller,
  214:     required this.requestBuilder,
  215:     required this.child,
  216:   });
  217: 
  218:   final TableFloatingToolbarOverlayController? controller;
  219:   final TableFloatingToolbarOverlayRequestBuilder? requestBuilder;
  220:   final Widget child;
  221: 
  222:   @override
  223:   State<TableFloatingToolbarOverlayAnchor> createState() =>
  224:       _TableFloatingToolbarOverlayAnchorState();
  225: }
  226: 
  227: class _TableFloatingToolbarOverlayAnchorState
  228:     extends State<TableFloatingToolbarOverlayAnchor> {
  229:   final LayerLink _anchorLink = LayerLink();
  230:   final Object _owner = Object();
  231:   bool _syncScheduled = false;
  232: 
  233:   @override
  234:   void initState() {
  235:     super.initState();
  236:     _scheduleSync();
  237:   }
  238: 
  239:   @override
  240:   void didUpdateWidget(covariant TableFloatingToolbarOverlayAnchor oldWidget) {
  241:     super.didUpdateWidget(oldWidget);
  242:     if (oldWidget.controller != widget.controller) {
  243:       oldWidget.controller?.hide(owner: _owner);
  244:     }
  245:     _scheduleSync();
  246:   }
  247: 
  248:   @override
  249:   void didChangeDependencies() {
  250:     super.didChangeDependencies();
  251:     _scheduleSync();
  252:   }
  253: 
  254:   @override
  255:   void dispose() {
  256:     widget.controller?.hide(owner: _owner);
  257:     super.dispose();
  258:   }
  259: 
  260:   @override
  261:   Widget build(BuildContext context) {
  262:     _scheduleSync();
  263:     return CompositedTransformTarget(
  264:       link: _anchorLink,
  265:       child: widget.child,
  266:     );
  267:   }
  268: 
  269:   void _scheduleSync() {
  270:     if (_syncScheduled) {
  271:       return;
  272:     }
  273:     _syncScheduled = true;
  274:     WidgetsBinding.instance.addPostFrameCallback((_) {
  275:       _syncScheduled = false;
  276:       _syncRequest();
  277:     });
  278:   }
  279: 
  280:   void _syncRequest() {
  281:     if (!mounted) {
  282:       return;
  283:     }
  284:     final controller = widget.controller;
  285:     final requestBuilder = widget.requestBuilder;
  286:     if (controller == null || requestBuilder == null) {
  287:       controller?.hide(owner: _owner);
  288:       return;
  289:     }
  290:     final renderObject = context.findRenderObject();
  291:     if (renderObject is! RenderBox ||
  292:         !renderObject.attached ||
  293:         !renderObject.hasSize) {
  294:       controller.hide(owner: _owner);
  295:       return;
  296:     }
  297:     final anchorTopLeft = renderObject.localToGlobal(Offset.zero);
  298:     final anchorRect = anchorTopLeft & renderObject.size;
  299:     controller.show(
  300:       requestBuilder(
  301:         owner: _owner,
  302:         anchorLink: _anchorLink,
  303:         anchorRect: anchorRect,
  304:         visibleTop: _visibleTopFor(context),
  305:       ),
  306:     );
  307:   }
  308: 
  309:   double _visibleTopFor(BuildContext context) {
  310:     final scrollable = Scrollable.maybeOf(context);
  311:     final viewportObject = scrollable?.context.findRenderObject();
  312:     if (viewportObject is RenderBox &&
  313:         viewportObject.attached &&
  314:         viewportObject.hasSize) {
  315:       return viewportObject.localToGlobal(Offset.zero).dy;
  316:     }
  317:     return MediaQuery.maybeOf(context)?.padding.top ?? 0;
  318:   }
  319: }
