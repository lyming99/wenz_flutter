 1134:   void _handleSelectionChanged(DocumentSelection selection) {
 1135:     _skipNextCaretScrollIntoView = true;
 1136:     widget.controller.setSelection(selection);
 1137:     // A selection change from the gesture overlay repositions the caret, so
 1138:     // refresh the IME buffer so the platform input follows the new location.
 1139:     _inputClient.syncBuffer();
 1140:   }
 1141: 
 1142:   bool _handleTapBeyondContent(Offset _) {
 1143:     if (widget.readOnly) {
 1144:       return false;
 1145:     }
 1146:     final blocks = widget.controller.document.blocks;
 1147:     if (blocks.isEmpty) {
 1148:       return false;
 1149:     }
 1150:     final last = blocks.last;
 1151:     if (last is TextBlockNode || last is CodeBlockNode) {
 1152:       return false;
 1153:     }
 1154: 
 1155:     final nextBlockId = _nextBlockId();
 1156:     final nextBlockIndex = blocks.length;
 1157:     final nextPosition = DocumentPosition.text(
 1158:       blockId: nextBlockId,
 1159:       blockIndex: nextBlockIndex,
 1160:       offset: 0,
 1161:     );
 1162:     final nextSelection =
 1163:         DocumentSelection(base: nextPosition, extent: nextPosition);
 1164:     _skipNextCaretScrollIntoView = true;
 1165:     widget.controller.insertBlocks(
 1166:       index: nextBlockIndex,
 1167:       blocks: <BlockNode>[
 1168:         TextBlockNode(
 1169:           id: nextBlockId,
 1170:           type: BlockType.paragraph,
 1171:           content: const <InlineNode>[],
 1172:         ),
 1173:       ],
 1174:       selection: nextSelection,
 1175:     );
 1176:     _inputClient.syncBuffer();
 1177:     return true;
 1178:   }
