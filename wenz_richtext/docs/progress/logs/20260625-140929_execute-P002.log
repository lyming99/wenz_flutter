  110: /// Editor-owned interaction contract for the top-level block drag handle.
  111: ///
  112: /// The handle is row chrome: it belongs to the editor's top-level block shell,
  113: /// not to [BlockRendererBuilder] output. Keeping the contract here lets custom
  114: /// renderers rely on the same menu/reorder surface without wrapping their own
  115: /// handle, and keeps nested surfaces (table cells, inline embeds, object-block
  116: /// controls) out of row-sorting hit testing.
  117: abstract final class BlockDragHandleSpec {
  118:   /// Reserved leading gutter for the handle, outside the renderer's content box.
  119:   static const double railWidth = 32.0;
  120: 
  121:   /// Gap between the renderer content edge and the handle hit target.
  122:   static const double gapToContent = 4.0;
  123: 
  124:   /// Minimum pointer/focus hit target for mouse, touch, and keyboard traversal.
  125:   static const Size hitSize = Size.square(28.0);
  126: 
  127:   /// Visual glyph size inside [hitSize].
  128:   static const Size visualSize = Size.square(18.0);
  129: 
  130:   /// Top inset from the block row to the handle hit target. Renderers with tall
  131:   /// content still anchor the handle near the first visual line/control row.
  132:   static const double topInset = 2.0;
  133: 
  134:   /// Pointer movement that turns a handle press into a reorder drag. Releasing
  135:   /// before this distance is treated as a menu click/tap.
  136:   static const double dragStartSlop = 6.0;
  137: 
  138:   /// Opacity when the row is not hovered/focused and no menu/drag is active.
  139:   static const double idleOpacity = 0.0;
  140: 
  141:   /// Opacity while the row or handle rail is hovered.
  142:   static const double hoverOpacity = 0.72;
  143: 
  144:   /// Opacity while the handle has keyboard focus, its menu is open, or it drags.
  145:   static const double activeOpacity = 1.0;
  146: 
  147:   /// Opacity for read-only/no-edit states. Disabled handles are not focusable.
  148:   static const double disabledOpacity = 0.0;
  149: 
  150:   /// Whether a top-level block row may expose the handle/menu surface.
  151:   static bool canShow({
  152:     required bool canEdit,
  153:     required int blockIndex,
  154:     required int blockCount,
  155:   }) {
  156:     return canEdit && blockIndex >= 0 && blockIndex < blockCount;
  157:   }
  158: 
  159:   /// Whether the row can enter drag-reorder mode.
  160:   static bool canDragSort({
  161:     required bool canEdit,
  162:     required int blockIndex,
  163:     required int blockCount,
  164:   }) {
  165:     return canShow(
  166:           canEdit: canEdit,
  167:           blockIndex: blockIndex,
  168:           blockCount: blockCount,
  169:         ) &&
  170:         blockCount > 1;
  171:   }
  172: 
  173:   /// Whether a menu/keyboard move-up action is legal for the row.
  174:   static bool canMoveUp({
  175:     required bool canEdit,
  176:     required int blockIndex,
  177:     required int blockCount,
  178:   }) {
  179:     return canDragSort(
  180:           canEdit: canEdit,
  181:           blockIndex: blockIndex,
  182:           blockCount: blockCount,
  183:         ) &&
  184:         blockIndex > 0;
  185:   }
  186: 
  187:   /// Whether a menu/keyboard move-down action is legal for the row.
  188:   static bool canMoveDown({
  189:     required bool canEdit,
  190:     required int blockIndex,
  191:     required int blockCount,
  192:   }) {
  193:     return canDragSort(
  194:           canEdit: canEdit,
  195:           blockIndex: blockIndex,
  196:           blockCount: blockCount,
  197:         ) &&
  198:         blockIndex < blockCount - 1;
  199:   }
  200: }
