 6397:   // B2: auto-scroll-on-drag. A mouse drag held near a viewport edge drives a
 6398:   // per-frame ticker that keeps scrolling and re-extends the selection, so the
 6399:   // user can drag-select past the visible area without moving the pointer.
 6400:   group('auto-scroll on drag', () {
 6401:     // A tall document: many short paragraphs whose combined height exceeds the
 6402:     // 150px viewport, so the bottom edge sits mid-document and there is room
 6403:     // to scroll down.
 6404:     RichTextDocument tallDocument({int count = 30}) => RichTextDocument(
 6405:           blocks: List<BlockNode>.generate(
 6406:             count,
 6407:             (i) => TextBlockNode(
 6408:               id: 'p$i',
 6409:               type: BlockType.paragraph,
 6410:               content: <InlineNode>[TextRun(text: 'block-$i-content')],
 6411:             ),
 6412:           ),
 6413:         );
 6414: 
 6415:     testWidgets('dragging the scrollbar gutter does not start a selection', (
 6416:       tester,
 6417:     ) async {
 6418:       final controller = WenzRichTextController(document: tallDocument());
 6419: 
 6420:       await tester.pumpWidget(
 6421:         MaterialApp(
 6422:           home: Scaffold(
 6423:             body: SizedBox(
 6424:               height: 150,
 6425:               child:
 6426:                   WenzRichTextEditor(controller: controller, enableIme: false),
 6427:             ),
 6428:           ),
 6429:         ),
 6430:       );
 6431:       await tester.pumpAndSettle();
 6432: 
 6433:       // Place an initial collapsed caret in the content so we can detect any
 6434:       // spurious change.
 6435:       final contentPoint = _globalTextOffset(tester, 'block-0-content', 2);
 6436:       await tester.tapAt(contentPoint);
 6437:       await tester.pump();
 6438:       expect(controller.selection, isNotNull);
 6439:       final selectionBefore = controller.selection;
 6440: 
 6441:       // Drag vertically inside the trailing scrollbar gutter (rightmost 16px).
 6442:       // The gutter is within _kScrollbarGutterWidth of the editor's right edge.
 6443:       final editorBox = tester.getRect(find.byType(WenzRichTextEditor));
 6444:       final gutterX = editorBox.right - 8;
 6445:       final gesture = await tester.startGesture(
 6446:         Offset(gutterX, editorBox.top + 30),
 6447:         kind: PointerDeviceKind.mouse,
 6448:       );
 6449:       await gesture.moveTo(Offset(gutterX, editorBox.top + 90));
 6450:       await gesture.up();
 6451:       await tester.pump();
 6452: 
 6453:       // The selection must be unchanged — scrolling the thumb is not a content
 6454:       // selection drag.
 6455:       expect(controller.selection, selectionBefore);
 6456:     });
