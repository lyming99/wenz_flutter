  147:   /// Resolves a global pointer offset to the legal row insertion boundary used
  148:   /// by top-level block drag sorting. Misses are clamped to the first/last
  149:   /// mounted row so dragging slightly outside the viewport still lands on a
  150:   /// valid insertion point.
  151:   BlockReorderDropTarget? blockReorderDropTargetFromGlobalOffset(
  152:     Offset global,
  153:   ) {
  154:     final rows = <({BlockRowGeometryEntry entry, Rect rect})>[];
  155:     for (final entry in _rowEntries) {
  156:       final box = entry.renderBox;
  157:       if (box == null || !box.hasSize) {
  158:         continue;
  159:       }
  160:       rows.add((
  161:         entry: entry,
  162:         rect: box.localToGlobal(Offset.zero) & box.size,
  163:       ));
  164:     }
  165:     if (rows.isEmpty) {
  166:       return null;
  167:     }
  168:     rows.sort((a, b) => a.entry.blockIndex.compareTo(b.entry.blockIndex));
  169: 
  170:     final first = rows.first;
  171:     if (global.dy <= first.rect.top) {
  172:       return BlockReorderDropTarget(
  173:         blockId: first.entry.blockId,
  174:         blockIndex: first.entry.blockIndex,
  175:         placement: BlockReorderDropPlacement.before,
  176:         blockRect: first.rect,
  177:       );
  178:     }
  179: 
  180:     for (var index = 0; index < rows.length; index++) {
  181:       final current = rows[index];
  182:       final rect = current.rect;
  183:       if (global.dy < rect.top) {
  184:         final previous = rows[index - 1];
  185:         final gapMidY = (previous.rect.bottom + rect.top) / 2;
  186:         if (global.dy < gapMidY) {
  187:           return BlockReorderDropTarget(
  188:             blockId: previous.entry.blockId,
  189:             blockIndex: previous.entry.blockIndex,
  190:             placement: BlockReorderDropPlacement.after,
  191:             blockRect: previous.rect,
  192:           );
  193:         }
  194:         return BlockReorderDropTarget(
  195:           blockId: current.entry.blockId,
  196:           blockIndex: current.entry.blockIndex,
  197:           placement: BlockReorderDropPlacement.before,
  198:           blockRect: rect,
  199:         );
  200:       }
  201:       if (global.dy <= rect.bottom) {
  202:         return BlockReorderDropTarget(
  203:           blockId: current.entry.blockId,
  204:           blockIndex: current.entry.blockIndex,
  205:           placement: global.dy < rect.center.dy
  206:               ? BlockReorderDropPlacement.before
  207:               : BlockReorderDropPlacement.after,
  208:           blockRect: rect,
  209:         );
  210:       }
  211:     }
  212: 
  213:     final last = rows.last;
  214:     return BlockReorderDropTarget(
  215:       blockId: last.entry.blockId,
  216:       blockIndex: last.entry.blockIndex,
  217:       placement: BlockReorderDropPlacement.after,
  218:       blockRect: last.rect,
  219:     );
