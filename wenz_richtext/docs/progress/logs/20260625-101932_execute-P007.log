  400:             height: size.height,
  401:             child: Padding(
  402:               padding: const EdgeInsets.all(16),
  403:               child: WenzRichTextEditor(
  404:                 controller: controller,
  405:                 enableIme: false,
  406:               ),
  407:             ),
  408:           ),
  409:         ),
  410:       ),
  411:     ),
  412:   );
  413:   await tester.pump();
  414: }
