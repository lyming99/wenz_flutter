 6471:               ),
 6472:             ),
 6473:           ),
 6474:         ),
 6475:       );
 6476:       await tester.pumpAndSettle();
 6477: 
 6478:       // Find the editor's render box to derive a point inside the bottom edge
 6479:       // band (within _autoScrollEdge = 48px of the viewport bottom).
 6480:       final editorBox = tester.getRect(find.byType(WenzRichTextEditor));
 6481:       // Start the drag near the top so the drag base is in an early block.
 6482:       final dragStart = Offset(editorBox.left + 80, editorBox.top + 20);
 6483:       // Hold the pointer just inside the bottom edge.
 6484:       final edgePoint = Offset(editorBox.left + 80, editorBox.bottom - 10);
 6485: 
 6486:       final gesture = await tester.startGesture(
 6487:         dragStart,
 6488:         kind: PointerDeviceKind.mouse,
 6489:       );
 6490:       // Move into the bottom edge band to arm the auto-scroll ticker.
 6491:       await gesture.moveTo(edgePoint);
 6492:       await tester.pump();
 6493: 
 6494:       final scrollBefore = _scrollOffset(tester);
 6495:       final extentBefore = controller.selection!.extent.blockIndex;
 6496: 
 6497:       // Hold still and advance frames — the ticker should keep scrolling down
 6498:       // even though the pointer is not moving.
 6499:       for (var i = 0; i < 20; i++) {
 6500:         await tester.pump(const Duration(milliseconds: 16));
 6501:       }
 6502: 
 6503:       final scrollAfter = _scrollOffset(tester);
 6504:       final extentAfter = controller.selection!.extent.blockIndex;
 6505:       expect(scrollAfter, greaterThan(scrollBefore));
 6506:       expect(extentAfter, greaterThan(extentBefore));
 6507: 
 6508:       await gesture.up();
 6509:     });
