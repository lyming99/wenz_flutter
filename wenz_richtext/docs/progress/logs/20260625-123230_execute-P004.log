 4581:   KeyEventResult _handleKeyEvent(FocusNode node, KeyEvent event) {
 4582:     if (!widget.state.canCollapse ||
 4583:         widget.onToggled == null ||
 4584:         (event is! KeyDownEvent && event is! KeyRepeatEvent)) {
 4585:       return KeyEventResult.ignored;
 4586:     }
 4587:     final key = event.logicalKey;
 4588:     if (key == LogicalKeyboardKey.enter ||
 4589:         key == LogicalKeyboardKey.numpadEnter ||
 4590:         key == LogicalKeyboardKey.space) {
 4591:       _toggle();
 4592:       return KeyEventResult.handled;
 4593:     }
 4594:     return KeyEventResult.ignored;
