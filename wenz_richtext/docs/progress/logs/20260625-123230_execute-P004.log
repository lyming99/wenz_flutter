 1028:   Offset _slashMenuOffset() {
 1029:     final fallback = widget.padding.resolve(TextDirection.ltr).topLeft;
 1030:     final selection = widget.controller.selection;
 1031:     final overlayContext = _editorOverlayKey.currentContext;
 1032:     final overlayBox = overlayContext?.findRenderObject();
 1033:     if (selection == null ||
 1034:         !selection.isCollapsed ||
 1035:         overlayBox is! RenderBox ||
 1036:         !overlayBox.hasSize) {
 1037:       return fallback;
 1038:     }
 1039:     final caret = _registry.caretRectForPosition(selection.extent);
 1040:     if (caret == null) {
 1041:       return fallback;
 1042:     }
 1043:     final local = overlayBox.globalToLocal(caret.bottomLeft);
 1044:     final maxLeft = overlayBox.size.width - 280;
 1045:     return Offset(
 1046:       local.dx.clamp(0, maxLeft > 0 ? maxLeft : 0).toDouble(),
 1047:       (local.dy + 6).clamp(0, overlayBox.size.height).toDouble(),
 1048:     );
 1049:   }
 1050: 
 1051:   void _handleSelectionChanged(DocumentSelection selection) {
 1052:     _skipNextCaretScrollIntoView = true;
 1053:     widget.controller.setSelection(selection);
 1054:     // A selection change from the gesture overlay repositions the caret, so
 1055:     // refresh the IME buffer so the platform input follows the new location.
 1056:     _inputClient.syncBuffer();
 1057:   }
 1058: 
 1059:   bool _handleTapBeyondContent(Offset _) {
 1060:     if (widget.readOnly) {
 1061:       return false;
 1062:     }
 1063:     final blocks = widget.controller.document.blocks;
 1064:     if (blocks.isEmpty) {
 1065:       return false;
 1066:     }
 1067:     final last = blocks.last;
 1068:     if (last is TextBlockNode || last is CodeBlockNode) {
 1069:       return false;
 1070:     }
 1071: 
 1072:     final nextBlockId = _nextBlockId();
 1073:     final nextBlockIndex = blocks.length;
 1074:     final nextPosition = DocumentPosition.text(
 1075:       blockId: nextBlockId,
 1076:       blockIndex: nextBlockIndex,
 1077:       offset: 0,
 1078:     );
 1079:     final nextSelection =
 1080:         DocumentSelection(base: nextPosition, extent: nextPosition);
 1081:     _skipNextCaretScrollIntoView = true;
 1082:     widget.controller.insertBlocks(
 1083:       index: nextBlockIndex,
 1084:       blocks: <BlockNode>[
 1085:         TextBlockNode(
 1086:           id: nextBlockId,
 1087:           type: BlockType.paragraph,
 1088:           content: const <InlineNode>[],
 1089:         ),
 1090:       ],
 1091:       selection: nextSelection,
 1092:     );
 1093:     _inputClient.syncBuffer();
 1094:     return true;
 1095:   }
