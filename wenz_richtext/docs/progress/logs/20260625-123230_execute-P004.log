  918:                     language,
  919:                     blockIndex: blockIndex,
  920:                   );
  921:                 },
  922:           onCodeCopied: _copyTextToClipboard,
  923:           onCalloutVariantChanged: widget.readOnly
  924:               ? null
  925:               : (variant) {
  926:                   widget.controller.setCalloutVariant(
  927:                     variant,
  928:                     blockIndex: blockIndex,
  929:                   );
  930:                 },
  931:           onTableToolbarAction:
  932:               widget.readOnly ? null : _handleTableToolbarAction,
  933:           onTableColumnResize:
  934:               widget.readOnly ? null : _handleTableColumnResize,
  935:           onTodoCheckedChanged:
  936:               widget.readOnly ? null : _handleTodoCheckedChanged,
  937:           onObjectBlockAction: _handleObjectBlockAction,
