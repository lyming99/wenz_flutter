 1003:   Widget _withHighContrastFocusHighlight(
 1004:     BuildContext context,
 1005:     FocusNode focusNode,
 1006:     Widget child,
 1007:   ) {
 1008:     final accessibility = widget.accessibility;
 1009:     if (!focusNode.hasFocus ||
 1010:         !(MediaQuery.maybeHighContrastOf(context) ?? false) ||
 1011:         accessibility.highContrastFocusWidth == 0) {
 1012:       return child;
 1013:     }
 1014:     return DecoratedBox(
 1015:       key: _accessibilityFocusHighlightKey,
 1016:       position: DecorationPosition.foreground,
 1017:       decoration: BoxDecoration(
 1018:         border: Border.all(
 1019:           color: accessibility.highContrastFocusColor ??
 1020:               Theme.of(context).colorScheme.primary,
 1021:           width: accessibility.highContrastFocusWidth,
 1022:         ),
 1023:       ),
 1024:       child: child,
 1025:     );
 1026:   }
