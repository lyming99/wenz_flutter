  837:   @override
  838:   Widget build(BuildContext context) {
  839:     final focusNode = _effectiveFocusNode;
  840:     _syncFocusListener(focusNode);
  841:     final sourceBlocks = widget.controller.document.blocks;
  842:     final projection = _visibleBlockProjectionFor(sourceBlocks);
  843:     final blocks = projection.visibleBlocks;
  844:     final blockIndexes = projection.visibleBlockIndexes;
  845:     _registry.retainBlocks(projection.visibleBlockIds);
  846:     // Heading collapse should project this original block list for rendering
  847:     // only. The source document order, block ids/indexes, codecs, and edit
  848:     // history remain unchanged while read-only and editable editors may toggle
  849:     // the view state.
  850:     if (blocks.isEmpty) {
  851:       return _buildEditorShell(
  852:         context,
  853:         focusNode,
  854:         const SizedBox.shrink(),
  855:       );
  856:     }
  857: 
  858:     // Show a caret only in editable mode. Read-only mode still allows
  859:     // selection (see _handleSelectionChanged) but has no editing caret.
  860:     final showCaret = !widget.readOnly &&
  861:         focusNode.hasFocus &&
  862:         widget.controller.selection?.isCollapsed == true;
  863:     // Blocks that must stay mounted even when scrolled out of view: the caret
  864:     // (collapsed selection) and the selection endpoints. Keeping these alive
  865:     // means the caret and selection highlight always paint and the geometry
  866:     // registry always knows their box, so cross-block selection / caret do not
  867:     // break under virtualisation. Usually resolves to 1-2 ids.
  868:     final keepAliveIds = _keepAliveBlockIds(widget.controller.selection)
  869:         .intersection(projection.visibleBlockIds);
  870:     // Block ids whose content changed in the most recent controller mutation.
  871:     // null = treat every block as changed (full rebuild), e.g. after a document
  872:     // replace where no diff was available. Used by _KeepAliveBlock to skip
  873:     // re-rendering blocks whose content + selection-relevance did not change.
  874:     final dirtyIds = widget.controller.lastChangedBlockIds;
  875:     final findMatches =
  876:         widget.findController?.matches ?? const <FindReplaceMatch>[];
  877:     final currentFindMatch = widget.findController?.currentMatch;
  878:     final listMarkers = _listMarkersFor(sourceBlocks);
  879: 
  880:     _extentCache.retainBlocks(sourceBlocks);
  881: 
  882:     final editor = _MeasuredVirtualBlockList(
  883:       controller: _scrollController,
  884:       padding: widget.padding,
  885:       physics: widget.physics,
  886:       blocks: blocks,
  887:       blockIndexes: blockIndexes,
  888:       blockSpacing: widget.blockSpacing,
  889:       extentCache: _extentCache,
  890:       keepAliveIds: keepAliveIds,
  891:       onExtentUpdated: _scrollCaretIntoViewIfNeeded,
  892:       itemBuilder: (context, blockIndex) {
  893:         final block = sourceBlocks[blockIndex];
  894:         return _KeepAliveBlock(
  895:           key: ValueKey<String>(block.id),
  896:           block: block,
  897:           blockIndex: blockIndex,
  898:           blockCount: sourceBlocks.length,
  899:           listMarker: listMarkers[blockIndex],
  900:           keepAlive: keepAliveIds.contains(block.id),
  901:           blockChanged: dirtyIds == null || dirtyIds.contains(block.id),
  902:           selection: widget.controller.selection,
  903:           compositionState: widget.controller.compositionState,
  904:           registry: _registry,
  905:           blockRenderers: _blockRenderers,
  906:           showCaret: showCaret,
  907:           textStyle: widget.textStyle,
  908:           showDebugOverlay: widget.showDebugOverlay,
  909:           canEdit: !widget.readOnly,
  910:           mediaResolver: widget.mediaResolver,
  911:           inlineEmbedRenderer: widget.inlineEmbedRenderer,
  912:           headingCollapseState: _headingCollapseStateFor(block),
  913:           onHeadingCollapseToggled: _handleHeadingCollapseToggled,
  914:           onCodeLanguageChanged: widget.readOnly
  915:               ? null
  916:               : (language) {
