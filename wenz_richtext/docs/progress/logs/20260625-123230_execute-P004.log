 1097:   void _handleTableToolbarAction(TableToolbarActionIntent intent) {
 1098:     final tableBlock = _tableBlockAt(intent.blockIndex);
 1099:     if (tableBlock == null) {
 1100:       return;
 1101:     }
 1102: 
 1103:     final range = _currentTableRange(tableBlock, intent) ??
 1104:         TableCellRange(
 1105:           tableBlockId: tableBlock.id,
 1106:           blockIndex: intent.blockIndex,
 1107:           startRow: intent.rowIndex,
 1108:           endRow: intent.targetEndRowIndex,
 1109:           startColumn: intent.columnIndex,
 1110:           endColumn: intent.targetEndColumnIndex,
 1111:         );
 1112: 
 1113:     switch (intent.action) {
 1114:       case TableToolbarAction.insertRowAbove:
 1115:         widget.controller.insertTableRow(
 1116:           blockIndex: intent.blockIndex,
 1117:           rowIndex: range.startRow,
 1118:         );
 1119:         return;
 1120:       case TableToolbarAction.insertRowBelow:
 1121:         widget.controller.insertTableRow(
 1122:           blockIndex: intent.blockIndex,
 1123:           rowIndex: range.endRow + 1,
 1124:         );
 1125:         return;
 1126:       case TableToolbarAction.deleteRow:
 1127:         for (var row = range.endRow; row >= range.startRow; row--) {
 1128:           final current = _tableBlockAt(intent.blockIndex);
 1129:           if (current == null || current.table.rowCount <= 1) {
 1130:             break;
 1131:           }
 1132:           widget.controller.deleteTableRow(
 1133:             blockIndex: intent.blockIndex,
 1134:             rowIndex: row,
 1135:           );
 1136:         }
 1137:         return;
 1138:       case TableToolbarAction.insertColumnBefore:
 1139:         widget.controller.insertTableColumn(
 1140:           blockIndex: intent.blockIndex,
 1141:           columnIndex: range.startColumn,
 1142:         );
 1143:         return;
 1144:       case TableToolbarAction.insertColumnAfter:
 1145:         widget.controller.insertTableColumn(
 1146:           blockIndex: intent.blockIndex,
 1147:           columnIndex: range.endColumn + 1,
 1148:         );
 1149:         return;
 1150:       case TableToolbarAction.deleteColumn:
 1151:         for (var column = range.endColumn;
 1152:             column >= range.startColumn;
 1153:             column--) {
 1154:           final current = _tableBlockAt(intent.blockIndex);
 1155:           if (current == null || current.table.columnCount <= 1) {
 1156:             break;
