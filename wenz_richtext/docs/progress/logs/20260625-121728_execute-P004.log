1831:     if (key == LogicalKeyboardKey.enter ||
1832:         key == LogicalKeyboardKey.numpadEnter) {
1833:       slashMenu.activateHighlighted();
1834:       return true;
1835:     }
1836:     if (key == LogicalKeyboardKey.escape) {
1837:       slashMenu.close();
