1814:   bool _handleSlashMenuKeyEvent(KeyEvent event) {
1815:     final slashMenu = widget.slashMenuController;
1816:     if (slashMenu == null || !slashMenu.isOpen) {
1817:       return false;
1818:     }
1819:     if (event is! KeyDownEvent && event is! KeyRepeatEvent) {
1820:       return false;
1821:     }
1822:     final key = event.logicalKey;
1823:     if (key == LogicalKeyboardKey.arrowDown) {
1824:       slashMenu.moveHighlight(1);
1825:       return true;
1826:     }
1827:     if (key == LogicalKeyboardKey.arrowUp) {
1828:       slashMenu.moveHighlight(-1);
1829:       return true;
1830:     }
1831:     if (key == LogicalKeyboardKey.enter ||
1832:         key == LogicalKeyboardKey.numpadEnter) {
1833:       slashMenu.activateHighlighted();
1834:       return true;
1835:     }
1836:     if (key == LogicalKeyboardKey.escape) {
1837:       slashMenu.close();
1838:       return true;
1839:     }
1840:     return false;
1841:   }
