  441:   ChangeSet _permissionDeniedChange(EditorCommand command) {
  442:     final before = session.document.copy();
  443:     final requiredPermission = command.requiredPermission;
  444:     return ChangeSet(
  445:       before: before,
  446:       after: before.copy(),
  447:       selectionBefore: session.selection,
  448:       selectionAfter: session.selection,
  449:       description: 'permission:blocked:${command.description}',
  450:       metadata: <String, Object?>{
  451:         'blocked': true,
  452:         'reason': 'permissionDenied',
  453:         'permission': _permission.name,
  454:         'requiredPermission': requiredPermission.name,
  455:         'command': command.description,
  456:       },
  457:     );
  458:   }
