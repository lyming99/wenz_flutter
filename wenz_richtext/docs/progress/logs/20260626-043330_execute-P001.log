  546:       return execute(
  547:         InsertRevisionTextCommand(
  548:           text,
  549:           revisionId: revisionId ?? '',
  550:           attributes: attributes,
  551:           selection: selection,
  552:           authorId: authorId ?? _revisionAuthorId,
  553:           authorName: authorName ?? _revisionAuthorName,
  554:           createdAt: createdAt,
  555:         ),
  556:       );
  557:     }
  558:     final target = selection ?? this.selection;
  559:     ChangeSet? deletionChange;
  560:     if (target != null && !target.isCollapsed) {
  561:       deletionChange = markDeletionRevision(
  562:         selection: target,
  563:         authorId: authorId,
  564:         authorName: authorName,
  565:         createdAt: createdAt,
  566:       );
  567:       if (deletionChange.isNoop) {
  568:         return deletionChange;
  569:       }
  570:     }
  571:     final insertionSelection =
  572:         target != null && target.isCollapsed ? target : null;
  573:     final insertionChange = execute(
  574:       InsertRevisionTextCommand(
  575:         text,
  576:         revisionId: revisionId ?? _nextRevisionId(RevisionChangeType.insert),
  577:         attributes: attributes,
  578:         selection: insertionSelection,
  579:         authorId: authorId ?? _revisionAuthorId,
  580:         authorName: authorName ?? _revisionAuthorName,
  581:         createdAt: createdAt,
  582:       ),
  583:     );
  584:     if (insertionChange.isNoop && deletionChange != null) {
  585:       return deletionChange;
  586:     }
  587:     return insertionChange;
  588:   }
