  636:   ChangeSet insertText(
  637:     String text, {
  638:     TextAttributes attributes = const TextAttributes(),
  639:     bool applyMarkdownShortcuts = true,
  640:     bool applyAutoLinkUrls = true,
  641:   }) {
  642:     if (_revisionModeEnabled) {
  643:       return insertRevisionText(text, attributes: attributes);
  644:     }
  645:     final change = execute(InsertTextCommand(text, attributes: attributes));
  646:     var latestChange = change;
  647:     if (_shouldApplyMarkdownShortcut(
  648:       text,
  649:       attributes,
  650:       applyMarkdownShortcuts,
  651:       change,
  652:     )) {
  653:       final shortcutChange = execute(const ApplyMarkdownShortcutCommand());
  654:       if (!shortcutChange.isNoop) {
  655:         latestChange = shortcutChange;
  656:       }
  657:     }
  658:     if (_shouldApplyAutoLinkUrls(
  659:       text,
  660:       attributes,
  661:       applyAutoLinkUrls,
  662:       latestChange,
  663:     )) {
  664:       final autoLinkChange = autoLinkUrls();
