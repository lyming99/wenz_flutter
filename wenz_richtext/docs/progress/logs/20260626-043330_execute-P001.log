   45: /// Read-only variant of [tableCellTargetFromPosition] for callers that hold a
   46: /// [RichTextDocument] but no [DocumentSession] (e.g. [ToolbarController]). It
   47: /// returns the cell's first text block without building a full edit target.
   48: TextBlockNode? tableCellTextBlockForPosition(
   49:   RichTextDocument document,
   50:   DocumentPosition position,
   51: ) {
   52:   final path = position.path;
   53:   if (!path.isTableCellText) {
   54:     return null;
   55:   }
   56:   final rowIndex = path.tableRowIndex;
   57:   final columnIndex = path.tableColumnIndex;
   58:   if (rowIndex == null || columnIndex == null) {
   59:     return null;
   60:   }
   61:   if (position.blockIndex < 0 ||
   62:       position.blockIndex >= document.blocks.length) {
   63:     return null;
   64:   }
   65:   final block = document.blocks[position.blockIndex];
   66:   if (block is! TableBlockNode) {
   67:     return null;
   68:   }
   69:   final cell = block.table.cellAt(rowIndex, columnIndex);
   70:   if (cell == null) {
   71:     return null;
   72:   }
   73:   return cellTextBlock(cell);
   74: }
