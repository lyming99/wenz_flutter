   10: class FormatTextCommand extends EditorCommand {
   11:   const FormatTextCommand({required this.attributes, this.selection});
   12: 
   13:   final TextAttributes attributes;
   14:   final DocumentSelection? selection;
   15: 
   16:   @override
   17:   String get description => 'formatText';
   18: 
   19:   @override
   20:   CommandResult execute(DocumentSession session) {
   21:     final target = selection ?? session.selection;
   22:     if (target == null || target.isCollapsed || attributes.isEmpty) {
   23:       return const CommandResult(recordHistory: false);
   24:     }
   25: 
   26:     final start = target.start;
   27:     final end = target.end;
   28:     // Table cell selection: route to the cell-aware formatter, which edits the
   29:     // cell's first text block via replaceCellTextBlock (the loop below only
   30:     // handles top-level TextBlockNode blocks and would skip the table block).
   31:     if (start.path.isTableCellText &&
   32:         start.blockIndex == end.blockIndex &&
   33:         start.path == end.path) {
   34:       final rowIndex = start.path.tableRowIndex;
   35:       final columnIndex = start.path.tableColumnIndex;
   36:       if (rowIndex == null || columnIndex == null) {
   37:         return const CommandResult(recordHistory: false);
   38:       }
   39:       return formatTableCellInlineRange(
   40:         session,
   41:         start.blockIndex,
   42:         rowIndex,
   43:         columnIndex,
   44:         start.offset,
   45:         end.offset,
   46:         attributes,
   47:       );
   48:     }
   49: 
   50:     final blocks =
   51:         session.document.blocks.map((block) => block.copy()).toList();
   52:     var changed = false;
   53: 
   54:     for (var i = start.blockIndex; i <= end.blockIndex; i++) {
   55:       if (i < 0 || i >= blocks.length) {
   56:         continue;
   57:       }
   58:       final block = blocks[i];
   59:       if (block is! TextBlockNode) {
   60:         continue;
   61:       }
   62:       final rangeStart = i == start.blockIndex ? start.offset : 0;
   63:       final rangeEnd =
   64:           i == end.blockIndex ? end.offset : inlineNodesLength(block.content);
   65:       blocks[i] = TextBlockNode(
   66:         id: block.id,
   67:         type: block.type,
   68:         attributes: block.attributes,
   69:         content: formatInline(block.content, rangeStart, rangeEnd, attributes),
   70:       );
   71:       changed = true;
   72:     }
   73: 
   74:     if (!changed) {
   75:       return const CommandResult(recordHistory: false);
   76:     }
   77:     session.document = RichTextDocument(
   78:       version: session.document.version,
   79:       blocks: blocks,
   80:     );
   81:     return CommandResult(selection: target);
   82:   }
   83: }
