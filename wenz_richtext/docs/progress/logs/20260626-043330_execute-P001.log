  155: List<InlineNode> clearInlineFormatting(
  156:   List<InlineNode> nodes,
  157:   int start,
  158:   int end,
  159: ) {
  160:   if (end <= start) {
  161:     return nodes.map((node) => node.copy()).toList();
  162:   }
  163: 
  164:   final result = <InlineNode>[];
  165:   var cursor = 0;
  166:   for (final node in nodes) {
  167:     final nodeStart = cursor;
  168:     final nodeEnd = cursor + inlineLength(node);
  169:     cursor = nodeEnd;
  170: 
  171:     if (nodeEnd <= start || nodeStart >= end) {
  172:       result.add(node.copy());
  173:       continue;
  174:     }
  175: 
  176:     if (node is TextRun) {
  177:       final localStart = start > nodeStart ? start - nodeStart : 0;
  178:       final localEnd = end < nodeEnd ? end - nodeStart : node.text.length;
  179:       final before = node.text.substring(0, localStart);
  180:       final middle = node.text.substring(localStart, localEnd);
  181:       final after = node.text.substring(localEnd);
  182:       if (before.isNotEmpty) {
  183:         result.add(TextRun(text: before, attributes: node.attributes));
  184:       }
  185:       if (middle.isNotEmpty) {
  186:         result.add(TextRun(text: middle, attributes: const TextAttributes()));
  187:       }
  188:       if (after.isNotEmpty) {
  189:         result.add(TextRun(text: after, attributes: node.attributes));
  190:       }
  191:     } else if (node is InlineEmbed) {
  192:       result.add(
  193:         InlineEmbed(
  194:           embedType: node.embedType,
  195:           data: node.data,
  196:           attributes: const TextAttributes(),
  197:         ),
  198:       );
  199:     }
  200:   }
  201: 
  202:   return mergeTextRuns(result);
  203: }
