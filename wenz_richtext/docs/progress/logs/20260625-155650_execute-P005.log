  367: 
  368:   final int blockIndex;
  369:   final int startRow;
  370:   final int startColumn;
  371:   final int endRow;
  372:   final int endColumn;
  373: 
  374:   @override
  375:   String get description => 'mergeTableCells';
  376: 
  377:   @override
  378:   CommandResult execute(DocumentSession session) {
  379:     final tableBlock = tableAt(session, blockIndex);
  380:     if (tableBlock == null) {
  381:       return const CommandResult(recordHistory: false);
  382:     }
  383:     final top = startRow <= endRow ? startRow : endRow;
  384:     final bottom = startRow <= endRow ? endRow : startRow;
  385:     final left = startColumn <= endColumn ? startColumn : endColumn;
  386:     final right = startColumn <= endColumn ? endColumn : startColumn;
  387:     if (top < 0 ||
  388:         left < 0 ||
  389:         bottom >= tableBlock.table.rowCount ||
  390:         right >= tableBlock.table.columnCount ||
  391:         (top == bottom && left == right)) {
  392:       return const CommandResult(recordHistory: false);
  393:     }
  394:     for (var row = top; row <= bottom; row++) {
  395:       for (var column = left; column <= right; column++) {
  396:         final cell = tableBlock.table.cellAt(row, column);
  397:         if (cell == null ||
  398:             cell.covered ||
  399:             cell.rowSpan != 1 ||
  400:             cell.columnSpan != 1) {
  401:           return const CommandResult(recordHistory: false);
  402:         }
  403:       }
  404:     }
  405:     final rows = tableBlock.table.rows.map(copyRow).toList();
  406:     for (var row = top; row <= bottom; row++) {
  407:       for (var column = left; column <= right; column++) {
  408:         final cell = rows[row][column];
  409:         rows[row][column] = TableCellNode(
  410:           id: cell.id,
  411:           blocks: cell.blocks.map((block) => block.copy()).toList(),
  412:           rowSpan: row == top && column == left ? bottom - top + 1 : 1,
  413:           columnSpan: row == top && column == left ? right - left + 1 : 1,
  414:           isHeader: cell.isHeader,
  415:           backgroundColor: cell.backgroundColor,
  416:           covered: !(row == top && column == left),
  417:         );
  418:       }
  419:     }
  420:     return replaceTable(
  421:       session,
  422:       blockIndex,
  423:       tableBlock,
  424:       rows,
  425:       columnAlignments: tableBlock.table.columnAlignments,
  426:       columnWidths: tableBlock.table.columnWidths,
  427:     );
  428:   }
  429: }
