  143: 
  144:   @override
  145:   String get description => 'deleteTableRow';
  146: 
  147:   @override
  148:   CommandResult execute(DocumentSession session) {
  149:     final tableBlock = tableAt(session, blockIndex);
  150:     if (tableBlock == null ||
  151:         tableBlock.table.rowCount <= 1 ||
  152:         rowIndex < 0 ||
  153:         rowIndex >= tableBlock.table.rowCount) {
  154:       return const CommandResult(recordHistory: false);
  155:     }
  156:     final rows = <List<TableCellNode>>[
  157:       for (var i = 0; i < tableBlock.table.rowCount; i++)
  158:         if (i != rowIndex) copyRow(tableBlock.table.rows[i]),
  159:     ];
  160:     return replaceTable(session, blockIndex, tableBlock, rows);
  161:   }
  162: }
