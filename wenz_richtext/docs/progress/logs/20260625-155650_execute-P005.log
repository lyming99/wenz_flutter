  657:       );
  658:       widget.outlineController?.addListener(_handleOutlineControllerChanged);
  659:       _syncFindControllerOutline();
  660:       _handleOutlineControllerChanged();
  661:     } else if (oldWidget.findController != widget.findController) {
  662:       _syncFindControllerOutline();
  663:     }
  664:     // The effective focus node may change when the caller swaps focusNode or
  665:     // controller; re-inject so controller.requestFocus() targets the right node.
  666:     final focusNode = _effectiveFocusNode;
  667:     if (focusNode != _controllerAttachedFocusNode) {
  668:       widget.controller.attachFocusNode(focusNode);
