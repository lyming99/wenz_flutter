  643:     if (oldWidget.findController != widget.findController) {
  644:       oldWidget.findController?.removeListener(_handleFindControllerChanged);
  645:       widget.findController?.addListener(_handleFindControllerChanged);
  646:     }
  647:     if (oldWidget.slashMenuController != widget.slashMenuController) {
  648:       oldWidget.slashMenuController?.removeListener(_handleSlashMenuChanged);
  649:       widget.slashMenuController?.attachEditor(widget.controller);
  650:       widget.slashMenuController?.addListener(_handleSlashMenuChanged);
  651:     } else if (oldWidget.controller != widget.controller) {
