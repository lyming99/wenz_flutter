 3180:   /// Whether the current selection could affect this block's rendering: it is
 3181:   /// an endpoint, or it lies strictly between the selection's start and end
 3182:   /// (so it would be fully highlighted), or the selection is collapsed inside
 3183:   /// it (the caret).
 3184:   bool _selectionTouchesBlock(_KeepAliveBlock w) {
 3185:     final selection = w.selection;
 3186:     if (selection == null) {
 3187:       return false;
 3188:     }
 3189:     final index = w.blockIndex;
 3190:     final start = selection.start;
 3191:     final end = selection.end;
 3192:     if (start.blockIndex == index || end.blockIndex == index) {
 3193:       return true;
 3194:     }
 3195:     // Interior block of a multi-block range is fully highlighted.
 3196:     return index > start.blockIndex && index < end.blockIndex;
 3197:   }
 3198: 
 3199:   /// Whether an active IME composition affects this block (composition lives in
 3200:   /// the caret's block). Only that block needs to repaint the underline span.
 3201:   bool _compositionTouchesBlock(_KeepAliveBlock w) {
 3202:     final composition = w.compositionState;
 3203:     if (composition == null) {
 3204:       return false;
 3205:     }
 3206:     final selection = w.selection;
 3207:     return selection != null && selection.extent.blockIndex == w.blockIndex;
 3208:   }
 3209: }
