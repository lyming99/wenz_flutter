    await dragUp.up();
    await tester.pumpAndSettle();

    expect(
      controller.document.blocks.map((block) => block.id),
      <String>['p2', 'p0', 'p1'],
    );
    expect(controller.selection?.extent.blockId, 'p2');
    expect(controller.selection?.extent.blockIndex, 0);
  });

