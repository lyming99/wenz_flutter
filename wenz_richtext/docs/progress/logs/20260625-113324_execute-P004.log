 3413:   @override
 3414:   void didUpdateWidget(covariant _BlockReorderRowGeometry oldWidget) {
 3415:     super.didUpdateWidget(oldWidget);
 3416:     if (oldWidget.registry != widget.registry ||
 3417:         oldWidget.blockId != widget.blockId) {
 3418:       oldWidget.registry.unregisterBlockRow(oldWidget.blockId, _rowKey);
