+  List<EditorShortcutConfigurationIssue> validate() {
+    final issues = <EditorShortcutConfigurationIssue>[];
+    for (var i = 0; i < bindings.length; i++) {
+      final binding = bindings[i];
+      if (binding.shortcut.platforms.isEmpty) {
+        issues.add(
