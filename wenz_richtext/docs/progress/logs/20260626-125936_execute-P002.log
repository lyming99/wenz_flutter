+bool _isValidShortcutCharacter(String? character) {
+  return character != null &&
+      character.length == 1 &&
+      !_isControlCharacter(character);
+}
+
+bool _setEquals<T>(Set<T> left, Set<T> right) {
+  return left.length == right.length && left.containsAll(right);
+}
