    required int tableRowIndex,
    required int tableColumnIndex,
    required int offset,
  }) {
    return DocumentPosition(
      blockId: tableBlockId,
      blockIndex: blockIndex,
      path: PositionPath.tableCellText(
        tableBlockId,
        tableRowIndex,
        tableColumnIndex,
