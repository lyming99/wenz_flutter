6515:    final pathCompare = path.compare(start.path);
6516:    if (pathCompare == 0) {
6517:      localStart = start.offset;
6518:    } else if (pathCompare > 0) {
6519:      localStart = 0;
6520:    }
6521:  } else if (blockIndex > start.blockIndex) {
6522:    localStart = 0;
6523:  }
6524:
6525:  if (end.blockIndex == blockIndex) {
6526:    final pathCompare = path.compare(end.path);
6527:    if (pathCompare == 0) {
6528:      localEnd = end.offset;
6529:    } else if (pathCompare < 0) {
6530:      localEnd = textLength;
6531:    }
6532:  } else if (blockIndex < end.blockIndex) {
