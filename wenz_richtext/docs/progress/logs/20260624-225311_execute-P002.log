6537:    return null;
6538:  }
6539:  final safeStart = localStart.clamp(0, textLength).toInt();
6540:  final safeEnd = localEnd.clamp(0, textLength).toInt();
6541:  if (safeStart == safeEnd) {
6542:    return null;
6543:  }
6544:  return _LocalSelectionRange(
6545:    start: safeStart < safeEnd ? safeStart : safeEnd,
6546:    end: safeStart < safeEnd ? safeEnd : safeStart,
6547:  );
