4068:List<double> _resolveTableColumnWidths(TableModel table, double maxWidth) {
4069:  final columnCount = table.columnCount;
4070:  final widths = List<double>.filled(columnCount, 0);
4071:  var fixedWidth = 0.0;
4072:  var flexCount = 0;
4073:  for (var i = 0; i < columnCount; i++) {
4074:    final explicit = table.columnWidths[i];
4075:    if (explicit != null && explicit > 0) {
4076:      widths[i] = explicit;
4077:      fixedWidth += explicit;
4078:    } else {
4079:      flexCount += 1;
4080:    }
4081:  }
4082:  if (flexCount == 0) {
4083:    return widths;
4084:  }
4085:  final remaining = maxWidth - fixedWidth;
4086:  final flexWidth = remaining > 0 ? remaining / flexCount : 80.0;
4087:  for (var i = 0; i < columnCount; i++) {
4088:    if (widths[i] == 0) {
4089:      widths[i] = flexWidth;
4090:    }
4091:  }
4092:  return widths;
4093:}
