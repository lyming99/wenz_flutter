 470:   bool canExecuteCommand(String name, Map<String, Object?> args) {
 471:     try {
 472:       return canExecute(registry.build(name, args));
 473:     } on UnknownCommandException {
 474:       return false;
 475:     } on DocumentDecodeException {
 476:       return false;
 477:     }
 478:   }
 479: 
 480:   /// No-throw variant of [executeCommand]. Returns `true` when the command
 481:   /// was built and executed, `false` when [name] is unknown or argument
 482:   /// decoding failed — in which case the document, selection, and change
 483:   /// callbacks are untouched. Prefer [executeCommand] when you want unknown
 484:   /// names to surface as an exception.
 485:   bool tryExecuteCommand(String name, Map<String, Object?> args) {
 486:     try {
 487:       final command = registry.build(name, args);
 488:       if (!canExecute(command)) {
 489:         return false;
 490:       }
 491:       execute(command);
 492:       return true;
 493:     } on UnknownCommandException {
 494:       return false;
 495:     } on DocumentDecodeException {
 496:       return false;
 497:     }
 498:   }
