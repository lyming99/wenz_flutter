 400: List<FindReplaceMatch> _findInText({
 401:   required String text,
 402:   required String query,
 403:   required FindReplaceOptions options,
 404:   required DocumentPosition Function(int offset) positionBuilder,
 405:   required String blockId,
 406:   required int blockIndex,
 407:   required PositionPath path,
 408: }) {
 409:   if (text.isEmpty || query.isEmpty) {
 410:     return const <FindReplaceMatch>[];
 411:   }
 412:   final haystack = options.caseSensitive ? text : text.toLowerCase();
 413:   final needle = options.caseSensitive ? query : query.toLowerCase();
 414:   final matches = <FindReplaceMatch>[];
 415:   var index = 0;
 416:   while (index <= haystack.length - needle.length) {
 417:     final found = haystack.indexOf(needle, index);
 418:     if (found == -1) {
 419:       break;
 420:     }
 421:     final end = found + needle.length;
 422:     if (!options.wholeWord || _isWholeWord(haystack, found, end)) {
 423:       final startPosition = positionBuilder(found);
 424:       final endPosition = positionBuilder(end);
 425:       matches.add(
 426:         FindReplaceMatch(
 427:           selection: DocumentSelection(
 428:             base: startPosition,
 429:             extent: endPosition,
 430:           ),
 431:           text: text.substring(found, end),
 432:           blockId: blockId,
 433:           blockIndex: blockIndex,
 434:           path: path,
 435:           start: found,
 436:           end: end,
 437:         ),
 438:       );
 439:     }
 440:     index = found + needle.length;
 441:   }
 442:   return matches;
 443: }
