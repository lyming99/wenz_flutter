 415:   ChangeSet execute(EditorCommand command) {
 416:     if (!canExecute(command)) {
 417:       return _permissionDeniedChange(command);
 418:     }
 419:     final before = session.document;
 420:     final change = _executor.execute(command);
 421:     final docChanged = !change.isNoop;
 422:     final selectionChanged = change.selectionBefore != change.selectionAfter;
 423:     if (docChanged || selectionChanged) {
 424:       _lastChangedBlockIds = _changedBlockIds(before, change.after);
 425:       if (docChanged) {
 426:         onChanged?.call(change.after);
 427:       }
 428:       if (selectionChanged) {
 429:         onSelectionChanged?.call(change.selectionAfter);
 430:       }
 431:       onCommandExecuted?.call(command, change);
 432:       notifyListeners();
 433:     }
 434:     return change;
 435:   }
