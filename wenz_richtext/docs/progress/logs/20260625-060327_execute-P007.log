 5625:   return find.byKey(ValueKey<String>('wenz-richtext-video-block-$blockId'));
 5626: }
 5627: 
 5628: DocumentSelection objectBlockSelection(String blockId, int blockIndex) {
 5629:   final start = DocumentPosition(
 5630:     blockId: blockId,
 5631:     blockIndex: blockIndex,
 5632:     path: PositionPath.blockObject(blockId),
 5633:     offset: 0,
 5634:   );
 5635:   return DocumentSelection(
 5636:     base: start,
 5637:     extent: start.copyWith(offset: 1),
 5638:   );
