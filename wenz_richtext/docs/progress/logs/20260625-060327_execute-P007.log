  388: 
  389: /// Records the blocks it was asked to resolve and returns a deterministic
  390: /// `Text('resolved:<assetId>')` for image/video/file blocks; declines
  391: /// anything else.
  392: class _RecordingResolver implements MediaResolver {
  393:   final List<String> seenImageAssetIds = <String>[];
  394:   final List<ImageBlockNode> seenImages = <ImageBlockNode>[];
  395:   final List<VideoBlockNode> seenVideos = <VideoBlockNode>[];
  396: 
  397:   @override
  398:   Widget? resolve(BuildContext context, BlockNode block) {
  399:     if (block is ImageBlockNode) {
  400:       seenImageAssetIds.add(block.assetId);
  401:       seenImages.add(block);
  402:       return Text('resolved:${block.assetId}');
  403:     }
  404:     if (block is VideoBlockNode) {
  405:       seenVideos.add(block);
  406:       return Text('resolved:${block.assetId}');
  407:     }
  408:     if (block is FileBlockNode) {
  409:       return Text('resolved:${block.assetId}');
  410:     }
  411:     return null;
  412:   }
  413: }
  414: 
  415: class _NullResolver implements MediaResolver {
  416:   @override
  417:   Widget? resolve(BuildContext context, BlockNode block) => null;
  418: }
  419: 
  420: class _ThrowingResolver implements MediaResolver {
  421:   @override
  422:   Widget? resolve(BuildContext context, BlockNode block) {
  423:     throw StateError('resolver blew up');
  424:   }
  425: }
