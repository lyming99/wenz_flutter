+
+      controller.loadJson(jsonExport);
+      await tester.pumpAndSettle();
+      _expectDuplicatedVideos(controller);
+
+      controller.loadMarkdown(markdownExport);
+      await tester.pumpAndSettle();
+      _expectDuplicatedVideos(controller);
