969:  @override
970:  Widget build(BuildContext context) {
971:    final focusNode = _effectiveFocusNode;
972:    _syncFocusListener(focusNode);
973:    final sourceBlocks = widget.controller.document.blocks;
974:    final projection = _visibleBlockProjectionFor(sourceBlocks);
975:    final blocks = projection.visibleBlocks;
976:    final blockIndexes = projection.visibleBlockIndexes;
977:    _registry.retainBlocks(projection.visibleBlockIds);
978:    // Heading collapse should project this original block list for rendering
979:    // only. The source document order, block ids/indexes, codecs, and edit
980:    // history remain unchanged while read-only and editable editors may toggle
981:    // the view state.
982:    if (blocks.isEmpty) {
983:      return _buildEditorShell(
984:        context,
985:        focusNode,
986:        const SizedBox.shrink(),
987:      );
988:    }
989:
990:    // Show a caret only in editable mode. Read-only mode still allows
991:    // selection (see _handleSelectionChanged) but has no editing caret.
992:    final showCaret = !widget.readOnly &&
993:        focusNode.hasFocus &&
994:        widget.controller.selection?.isCollapsed == true;
995:    // Blocks that must stay mounted even when scrolled out of view: the caret
996:    // (collapsed selection) and the selection endpoints. Keeping these alive
997:    // means the caret and selection highlight always paint and the geometry
998:    // registry always knows their box, so cross-block selection / caret do not
999:    // break under virtualisation. Usually resolves to 1-2 ids.
1000:    final keepAliveIds = _keepAliveBlockIds(widget.controller.selection)
1001:        .intersection(projection.visibleBlockIds);
1002:    // Block ids whose content changed in the most recent controller mutation.
1003:    // null = treat every block as changed (full rebuild), e.g. after a document
1004:    // replace where no diff was available. Used by _KeepAliveBlock to skip
1005:    // re-rendering blocks whose content + selection-relevance did not change.
1006:    final dirtyIds = widget.controller.lastChangedBlockIds;
1007:    final findMatches =
1008:        widget.findController?.matches ?? const <FindReplaceMatch>[];
1009:    final currentFindMatch = widget.findController?.currentMatch;
1010:    final listMarkers = _listMarkersFor(sourceBlocks);
1011:
1012:    _extentCache.retainBlocks(sourceBlocks);
1013:
1014:    final editor = _MeasuredVirtualBlockList(
1015:      controller: _scrollController,
1016:      padding: widget.padding,
1017:      physics: widget.physics,
1018:      blocks: blocks,
1019:      blockIndexes: blockIndexes,
1020:      blockSpacing: widget.blockSpacing,
1021:      extentCache: _extentCache,
1022:      keepAliveIds: keepAliveIds,
1023:      onExtentUpdated: _scrollCaretIntoViewIfNeeded,
1024:      itemBuilder: (context, blockIndex) {
1025:        final block = sourceBlocks[blockIndex];
1026:        return _KeepAliveBlock(
1027:          key: ValueKey<String>(block.id),
1028:          block: block,
1029:          blockIndex: blockIndex,
1030:          blockCount: sourceBlocks.length,
1031:          listMarker: listMarkers[blockIndex],
1032:          keepAlive: keepAliveIds.contains(block.id),
1033:          blockChanged: dirtyIds == null || dirtyIds.contains(block.id),
1034:          selection: widget.controller.selection,
1035:          compositionState: widget.controller.compositionState,
1036:          registry: _registry,
1037:          blockRenderers: _blockRenderers,
1038:          showCaret: showCaret,
1039:          textStyle: widget.textStyle,
1040:          showDebugOverlay: widget.showDebugOverlay,
1041:          canEdit: !widget.readOnly,
1042:          mediaResolver: widget.mediaResolver,
1043:          inlineEmbedRenderer: widget.inlineEmbedRenderer,
1044:          headingCollapseState: _headingCollapseStateFor(block),
1045:          onHeadingCollapseToggled: _handleHeadingCollapseToggled,
1046:          onCodeLanguageChanged: widget.readOnly
1047:              ? null
1048:              : (language) {
1049:                  widget.controller.setCodeLanguage(
1050:                    language,
1051:                    blockIndex: blockIndex,
1052:                  );
1053:                },
1054:          onCodeCopied: _copyTextToClipboard,
1055:          onCalloutVariantChanged: widget.readOnly
1056:              ? null
1057:              : (variant) {
1058:                  widget.controller.setCalloutVariant(
1059:                    variant,
1060:                    blockIndex: blockIndex,
1061:                  );
1062:                },
1063:          onTableToolbarAction:
1064:              widget.readOnly ? null : _handleTableToolbarAction,
1065:          tableToolbarOverlayController: _tableToolbarOverlayController,
1066:          onTableColumnResize:
1067:              widget.readOnly ? null : _handleTableColumnResize,
1068:          onTodoCheckedChanged:
1069:              widget.readOnly ? null : _handleTodoCheckedChanged,
1070:          onObjectBlockAction: _handleObjectBlockAction,
1071:          findMatches: findMatches,
1072:          currentFindMatch: currentFindMatch,
1073:        );
1074:      },
1075:    );
1076:    return _buildEditorShell(
1077:      context,
1078:      focusNode,
1079:      Stack(
1080:        key: _editorOverlayKey,
1081:        fit: StackFit.expand,
1082:        clipBehavior: Clip.none,
1083:        children: <Widget>[
1084:          SelectionGestureOverlay(
1085:            registry: _registry,
1086:            scrollController: _scrollController,
1087:            focusNode: focusNode,
1088:            readOnly: widget.readOnly,
1089:            onSelectionChanged: _handleSelectionChanged,
1090:            onTapBeyondContent: _handleTapBeyondContent,
1091:            child: editor,
1092:          ),
1093:          if (widget.slashMenuController?.isOpen == true)
1094:            Positioned(
1095:              left: _slashMenuOffset().dx,
1096:              top: _slashMenuOffset().dy,
1097:              child: WenzSlashMenuOverlay(
1098:                controller: widget.slashMenuController!,
1099:              ),
1100:            ),
1101:        ],
1102:      ),
1103:    );
1104:  }
