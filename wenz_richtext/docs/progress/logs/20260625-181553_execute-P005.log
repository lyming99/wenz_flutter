5279:    required this.block,
5280:    required this.blockIndex,
5281:    required this.selection,
5282:    required this.compositionState,
5283:    required this.registry,
5284:    required this.showCaret,
5285:    this.textStyle,
5286:    this.showDebugOverlay = false,
5287:    this.inlineEmbedRenderer,
5288:    this.onToolbarAction,
