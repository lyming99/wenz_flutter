216:
217:  void _handleControllerChanged() {
218:    if (!mounted) {
219:      return;
220:    }
221:    setState(() {
222:      _request = widget.controller.request;
223:    });
224:    _syncPortalSafely();
225:  }
226:
227:  void _syncPortalSafely() {
228:    if (SchedulerBinding.instance.schedulerPhase ==
229:        SchedulerPhase.persistentCallbacks) {
230:      WidgetsBinding.instance.addPostFrameCallback((_) => _syncPortal());
231:      return;
232:    }
233:    _syncPortal();
234:  }
235:
236:  void _syncPortal() {
237:    if (!mounted) {
238:      return;
239:    }
240:    final shouldShow = _request?.enabled == true;
241:    if (shouldShow) {
242:      if (!_portalController.isShowing) {
243:        _portalController.show();
244:      }
245:    } else if (_portalController.isShowing) {
246:      _portalController.hide();
247:    }
248:  }
