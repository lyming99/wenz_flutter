195:    widget.controller.removeListener(_handleControllerChanged);
196:    if (_portalController.isShowing) {
197:      _portalController.hide();
198:    }
199:    super.dispose();
200:  }
201:
202:  @override
203:  Widget build(BuildContext context) {
204:    return OverlayPortal(
205:      controller: _portalController,
206:      overlayChildBuilder: (context) {
207:        final request = _request;
208:        if (request == null || !request.enabled) {
209:          return const SizedBox.shrink();
210:        }
211:        return _TableFloatingToolbarOverlayEntry(request: request);
212:      },
213:      child: widget.child,
