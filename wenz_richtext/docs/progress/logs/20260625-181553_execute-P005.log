5340:                Positioned.fill(
5341:                  child: DecoratedBox(
5342:                    decoration: BoxDecoration(
5343:                      color: theme.colorScheme.surface,
5344:                      borderRadius: BorderRadius.circular(_kTableSurfaceRadius),
5345:                      boxShadow: _kSurfaceBoxShadow,
5346:                    ),
5347:                  ),
5348:                ),
5349:                ClipRRect(
5350:                  borderRadius: BorderRadius.circular(_kTableSurfaceRadius),
5351:                  child: SizedBox(
5352:                    width: stackWidth,
5353:                    height: metrics.height,
5354:                    child: Stack(
5355:                      clipBehavior: Clip.none,
5356:                      children: <Widget>[
5357:                        for (final cell in metrics.cells)
5358:                          Positioned(
5359:                            left: cell.left,
5360:                            top: cell.top,
5361:                            width: cell.width,
5362:                            height: cell.height,
5363:                            child: DecoratedBox(
5364:                              key: ValueKey<String>(
5365:                                'table-cell-border-${block.id}-${cell.rowIndex}-${cell.columnIndex}',
5366:                              ),
5367:                              decoration: BoxDecoration(
5368:                                border: _tableCellBorder(
5369:                                  cell: cell,
5370:                                  rowCount: table.rowCount,
5371:                                  columnCount: columnCount,
5372:                                  color: _kTableBorderColor,
5373:                                ),
5374:                              ),
5375:                              child: _TableCellSurface(
5376:                                tableBlock: block,
5377:                                blockIndex: blockIndex,
5378:                                rowIndex: cell.rowIndex,
5379:                                columnIndex: cell.columnIndex,
5380:                                cell: cell.cell,
5381:                                textStyle: tableTextStyle,
5382:                                textAlign: _textAlign(
5383:                                  table.columnAlignments[cell.columnIndex],
5384:                                ),
5385:                                selection: selection,
5386:                                compositionState: compositionState,
5387:                                registry: registry,
5388:                                showCaret: showCaret,
5389:                                highlightWholeCell: _shouldHighlightTableCell(
5390:                                  selection,
5391:                                  block.id,
5392:                                  blockIndex,
5393:                                  cell.rowIndex,
5394:                                  cell.columnIndex,
5395:                                ),
5396:                                showDebugOverlay: showDebugOverlay,
5397:                                inlineEmbedRenderer: inlineEmbedRenderer,
5398:                                findMatches: findMatches,
5399:                                currentFindMatch: currentFindMatch,
5400:                              ),
5401:                            ),
5402:                          ),
5403:                      ],
5404:                    ),
5405:                  ),
5406:                ),
5407:                if (activeRange != null &&
5408:                    onColumnResize != null &&
5409:                    resizeHeight > 0)
5410:                  for (var column = 0;
5411:                      column < metrics.columnWidths.length;
5412:                      column++)
5413:                    Positioned(
5414:                      left: metrics.columnLefts[column] +
5415:                          metrics.columnWidths[column] -
5416:                          (_kTableResizeHandleWidth / 2),
5417:                      top: 0,
5418:                      width: _kTableResizeHandleWidth,
5419:                      height: resizeHeight,
5420:                      child: _TableColumnResizeHandle(
5421:                        key: ValueKey<String>(
5422:                          'table-resize-${block.id}-$column',
5423:                        ),
5424:                        columnIndex: column,
5425:                        width: metrics.columnWidths[column],
5426:                        onResize: (width) {
5427:                          onColumnResize!(
5428:                            blockIndex: blockIndex,
5429:                            columnIndex: column,
5430:                            width: width,
5431:                          );
5432:                        },
5433:                      ),
5434:                    ),
5435:              ],
5436:            ),
5437:          );
5438:          return TableFloatingToolbarOverlayAnchor(
5439:            controller: toolbarOverlayController,
5440:            requestBuilder: activeRange != null && onToolbarAction != null
5441:                ? ({
5442:                    required Object owner,
5443:                    required LayerLink anchorLink,
5444:                    required Rect anchorRect,
5445:                    required double visibleTop,
5446:                  }) =>
5447:                    TableFloatingToolbarOverlayRequest(
5448:                      owner: owner,
5449:                      anchorLink: anchorLink,
5450:                      anchorRect: anchorRect,
5451:                      visibleTop: visibleTop,
5452:                      tableBlockId: block.id,
5453:                      blockIndex: blockIndex,
5454:                      selectionRange: activeRange,
5455:                      minWidth: _kTableToolbarMinWidth,
5456:                      gap: _kTableFloatingToolbarGap,
5457:                      fallbackHeight: _kTableFloatingToolbarEstimatedHeight,
5458:                      toolbarBuilder: (context) => _TableFloatingToolbar(
5459:                        block: block,
5460:                        blockIndex: blockIndex,
5461:                        range: activeRange,
5462:                        onAction: onToolbarAction!,
5463:                      ),
5464:                    )
5465:                : null,
5466:            tableBlockId: block.id,
5467:            blockIndex: blockIndex,
5468:            child: tableSurface,
5469:          );
5470:        },
5471:      ),
5472:    );
5473:  }
5474:}
