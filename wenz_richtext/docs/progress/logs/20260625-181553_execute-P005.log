870:    final context = this.context;
871:    return View.maybeOf(context)?.viewId;
872:  }
873:
874:  OutlineBlockProjection _visibleBlockProjectionFor(List<BlockNode> blocks) {
875:    final outline = widget.outlineController;
876:    if (outline == null) {
877:      return OutlineBlockProjection.all(blocks);
878:    }
879:    assert(
880:      identical(outline.editor, widget.controller),
881:      'outlineController must be created with the same WenzRichTextController.',
882:    );
883:    if (!identical(outline.editor, widget.controller)) {
884:      return OutlineBlockProjection.all(blocks);
885:    }
886:    return outline.visibleBlockProjection();
887:  }
888:
889:  void _syncFindControllerOutline() {
890:    widget.findController?.attachOutlineController(widget.outlineController);
891:  }
892:
893:  bool _revealCurrentSelectionIfHidden() {
894:    final outline = widget.outlineController;
895:    final selection = widget.controller.selection;
896:    if (outline == null ||
897:        selection == null ||
898:        !identical(outline.editor, widget.controller)) {
899:      return false;
900:    }
901:    return outline.expandToRevealSelection(selection);
902:  }
903:
904:  bool _expandHiddenContentAdjacentToSelection({required bool forward}) {
905:    if (_revealCurrentSelectionIfHidden()) {
906:      return true;
907:    }
908:    final outline = widget.outlineController;
909:    final selection = widget.controller.selection;
910:    if (outline == null ||
911:        selection == null ||
912:        !selection.isCollapsed ||
913:        !identical(outline.editor, widget.controller)) {
914:      return false;
915:    }
916:    final position = selection.extent;
917:    if (!_isAtBlockBoundary(position, forward: forward)) {
918:      return false;
919:    }
920:    final blocks = widget.controller.document.blocks;
921:    final adjacentIndex = position.blockIndex + (forward ? 1 : -1);
922:    if (adjacentIndex < 0 || adjacentIndex >= blocks.length) {
923:      return false;
924:    }
925:    return outline.expandToRevealBlockId(blocks[adjacentIndex].id);
926:  }
927:
928:  bool _isAtBlockBoundary(
929:    DocumentPosition position, {
930:    required bool forward,
931:  }) {
932:    final blocks = widget.controller.document.blocks;
933:    if (position.blockIndex < 0 || position.blockIndex >= blocks.length) {
934:      return false;
935:    }
936:    final block = blocks[position.blockIndex];
937:    if (position.path.isBlockText && block is TextBlockNode) {
938:      final length = inlineNodesLength(block.content);
939:      final offset = position.offset.clamp(0, length).toInt();
940:      return forward ? offset >= length : offset <= 0;
941:    }
942:    if (position.path.isBlockCode && block is CodeBlockNode) {
943:      final offset = position.offset.clamp(0, block.code.length).toInt();
944:      return forward ? offset >= block.code.length : offset <= 0;
945:    }
946:    return position.path.isBlockObject;
947:  }
948:
949:  HeadingCollapseState? _headingCollapseStateFor(BlockNode block) {
950:    final outline = widget.outlineController;
951:    if (outline == null || !identical(outline.editor, widget.controller)) {
952:      return null;
953:    }
954:    if (block is! TextBlockNode || block.type != BlockType.heading) {
955:      return null;
956:    }
957:    final item = outline.itemForBlockId(block.id);
958:    return HeadingCollapseState(
959:      canCollapse: item?.canCollapse ?? false,
960:      isCollapsed: item?.isCollapsed ?? false,
961:      hiddenBlockCount: item?.coveredBlockIds.length ?? 0,
962:    );
963:  }
964:
965:  void _handleHeadingCollapseToggled(String blockId) {
966:    widget.outlineController?.toggleByBlockId(blockId);
967:  }
