5294:
5295:  final TableBlockNode block;
5296:  final int blockIndex;
5297:  final DocumentSelection? selection;
5298:  final CompositionState? compositionState;
5299:  final BlockGeometryRegistry registry;
5300:  final bool showCaret;
5301:  final TextStyle? textStyle;
5302:  final bool showDebugOverlay;
5303:  final InlineEmbedRenderer? inlineEmbedRenderer;
5304:  final TableToolbarActionHandler? onToolbarAction;
5305:  final TableFloatingToolbarOverlayController? toolbarOverlayController;
5306:  final TableColumnResizeHandler? onColumnResize;
5307:  final List<FindReplaceMatch> findMatches;
5308:  final FindReplaceMatch? currentFindMatch;
5309:
5310:  @override
5311:  Widget build(BuildContext context) {
5312:    final table = block.table;
5313:    final columnCount = table.columnCount;
5314:    if (table.rowCount == 0 || columnCount == 0) {
5315:      return const SizedBox.shrink();
5316:    }
5317:    final theme = Theme.of(context);
5318:    final effectiveStyle = textStyle ?? DefaultTextStyle.of(context).style;
5319:    final tableTextStyle =
5320:        effectiveStyle.copyWith(fontSize: _kTableCellFontSize);
5321:    return _withBlockSemantics(
5322:      block,
5323:      LayoutBuilder(
5324:        builder: (context, constraints) {
5325:          final metrics = _TableGridMetrics.compute(
5326:            table: table,
5327:            maxWidth: _tableMaxWidth(constraints, columnCount),
5328:            textStyle: tableTextStyle,
5329:            textDirection: Directionality.of(context),
5330:          );
5331:          final activeRange = _activeTableRange(selection, block, blockIndex);
5332:          final stackWidth = metrics.width;
5333:          final resizeHeight = metrics.height;
5334:          final tableSurface = SizedBox(
5335:            width: stackWidth,
5336:            height: metrics.height,
5337:            child: Stack(
5338:              clipBehavior: Clip.none,
