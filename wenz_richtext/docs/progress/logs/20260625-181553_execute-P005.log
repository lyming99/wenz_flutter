178:    WidgetsBinding.instance.addPostFrameCallback((_) => _syncPortal());
179:  }
180:
181:  @override
182:  void didUpdateWidget(covariant TableFloatingToolbarOverlayHost oldWidget) {
183:    super.didUpdateWidget(oldWidget);
184:    if (oldWidget.controller == widget.controller) {
185:      return;
186:    }
187:    oldWidget.controller.removeListener(_handleControllerChanged);
188:    _request = widget.controller.request;
189:    widget.controller.addListener(_handleControllerChanged);
190:    WidgetsBinding.instance.addPostFrameCallback((_) => _syncPortal());
191:  }
