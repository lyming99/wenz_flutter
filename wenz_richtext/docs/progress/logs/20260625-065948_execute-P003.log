    while (low < high) {
      final mid = low + ((high - low) >> 1);
      if (bottomFor(mid) < y) {
        low = mid + 1;
      } else {
        high = mid;
      }
    }
    return low;
  }

  int _firstIndexWithTopAfter(double y) {
    var low = 0;
    var high = offsets.length;
    while (low < high) {
      final mid = low + ((high - low) >> 1);
      if (offsets[mid] <= y) {
        low = mid + 1;
      } else {
        high = mid;
      }
    }
    return low;
  }
}

