+
+double _spacingBetweenBlocks(
+  BlockNode previous,
+  BlockNode next,
+  double fallback,
+) {
+  if ((fallback - _kDefaultBlockSpacing).abs() > 0.01) {
+    return fallback;
+  }
+  return math.max(
+    _blockMarginAfter(previous, fallback),
+    _blockMarginBefore(next, fallback),
+  );
+}
+
