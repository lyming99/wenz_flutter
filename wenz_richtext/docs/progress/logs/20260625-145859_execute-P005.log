  341: class _TableFloatingToolbarOverlayEntry extends StatefulWidget {
  342:   const _TableFloatingToolbarOverlayEntry({required this.request});
  343: 
  344:   final TableFloatingToolbarOverlayRequest request;
  345: 
  346:   @override
  347:   State<_TableFloatingToolbarOverlayEntry> createState() =>
  348:       _TableFloatingToolbarOverlayEntryState();
  349: }
  350: 
  351: class _TableFloatingToolbarOverlayEntryState
  352:     extends State<_TableFloatingToolbarOverlayEntry> {
  353:   final GlobalKey _toolbarKey = GlobalKey();
  354:   double? _toolbarHeight;
  355:   bool _measureScheduled = false;
  356: 
  357:   @override
  358:   Widget build(BuildContext context) {
  359:     _scheduleMeasure();
  360:     final request = widget.request;
  361:     final toolbarHeight = _toolbarHeight ?? request.fallbackHeight;
  362:     final preferredTop = -(toolbarHeight + request.gap);
  363:     final visibleTop = request.visibleTop - request.anchorRect.top;
  364:     final top = math.max(preferredTop, visibleTop);
  365:     final minWidth = math.max(request.minWidth, request.anchorRect.width);
  366: 
  367:     return Positioned.fill(
  368:       child: CompositedTransformFollower(
  369:         link: request.anchorLink,
  370:         showWhenUnlinked: false,
  371:         targetAnchor: Alignment.topLeft,
  372:         followerAnchor: Alignment.topLeft,
  373:         offset: Offset(0, top),
  374:         child: Align(
  375:           alignment: AlignmentDirectional.topStart,
  376:           widthFactor: 1,
  377:           heightFactor: 1,
  378:           child: ConstrainedBox(
  379:             key: _toolbarKey,
  380:             constraints: BoxConstraints(minWidth: minWidth),
  381:             child: Listener(
  382:               key: const ValueKey<String>(
  383:                 'table-floating-toolbar-hit-test-blocker',
  384:               ),
  385:               behavior: HitTestBehavior.opaque,
  386:               child: request.toolbarBuilder(context),
  387:             ),
  388:           ),
  389:         ),
  390:       ),
  391:     );
  392:   }
  393: 
  394:   void _scheduleMeasure() {
  395:     if (_measureScheduled) {
  396:       return;
  397:     }
  398:     _measureScheduled = true;
  399:     WidgetsBinding.instance.addPostFrameCallback((_) {
  400:       _measureScheduled = false;
  401:       _syncToolbarHeight();
  402:     });
  403:   }
  404: 
  405:   void _syncToolbarHeight() {
  406:     if (!mounted) {
  407:       return;
  408:     }
  409:     final renderObject = _toolbarKey.currentContext?.findRenderObject();
  410:     if (renderObject is! RenderBox || !renderObject.hasSize) {
  411:       return;
  412:     }
  413:     final nextHeight = renderObject.size.height;
  414:     if (_toolbarHeight != null && (_toolbarHeight! - nextHeight).abs() < 0.5) {
  415:       return;
  416:     }
  417:     setState(() {
  418:       _toolbarHeight = nextHeight;
  419:     });
  420:   }
  421: }
