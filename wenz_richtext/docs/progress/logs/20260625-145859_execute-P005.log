   85: /// Editor-owned controller for the active table toolbar overlay request.
   86: class TableFloatingToolbarOverlayController extends ChangeNotifier {
   87:   TableFloatingToolbarOverlayRequest? _request;
   88: 
   89:   TableFloatingToolbarOverlayRequest? get request => _request;
   90: 
   91:   void show(TableFloatingToolbarOverlayRequest request) {
   92:     _request = request;
   93:     notifyListeners();
   94:   }
   95: 
   96:   void hide({Object? owner}) {
   97:     final current = _request;
   98:     if (current == null) {
   99:       return;
  100:     }
  101:     if (owner != null && !identical(current.owner, owner)) {
  102:       return;
  103:     }
  104:     _request = null;
  105:     notifyListeners();
  106:   }
  107: }
