 937: /// command) re-adds an empty paragraph when the removed block was the only one.
 938: CommandResult _deleteObjectBlock(DocumentSession session, int index) {
 939:   final blocks = session.document.blocks;
 940:   if (index < 0 || index >= blocks.length) {
 941:     return const CommandResult(recordHistory: false);
 942:   }
 943:   final removedBlockId = blocks[index].id;
 944:   // Snapshot the previous editable block BEFORE removal so we can prefer it
 945:   // (Backspace semantics: caret lands where the deleted block was, in the
 946:   // preceding text).
 947:   BlockNode? previousEditable;
 948:   var previousIndex = -1;
 949:   for (var i = index - 1; i >= 0; i--) {
 950:     if (blocks[i] is TextBlockNode || blocks[i] is CodeBlockNode) {
 951:       previousEditable = blocks[i];
 952:       previousIndex = i;
 953:       break;
 954:     }
 955:   }
 956: 
 957:   _replaceBlocks(session, index, 1, const <BlockNode>[]);
 958:   if (session.document.blocks.isEmpty) {
 959:     final paragraph = _emptyParagraphAfterDelete(removedBlockId);
 960:     final position = DocumentPosition.text(
 961:       blockId: paragraph.id,
 962:       blockIndex: 0,
 963:       offset: 0,
 964:     );
 965:     session.document = RichTextDocument(
 966:       version: session.document.version,
 967:       blocks: <BlockNode>[paragraph],
 968:     );
 969:     return CommandResult(
 970:       selection: DocumentSelection(base: position, extent: position),
 971:     );
 972:   }
 973: 
 974:   if (previousEditable != null) {
