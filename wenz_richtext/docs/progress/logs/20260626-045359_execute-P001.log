 665:   static String normalizeVariant(Object? value) {
 666:     final text = value?.toString().trim().toLowerCase() ?? '';
 667:     if (supportedVariants.contains(text)) {
 668:       return text;
 669:     }
 670:     return infoVariant;
 671:   }
