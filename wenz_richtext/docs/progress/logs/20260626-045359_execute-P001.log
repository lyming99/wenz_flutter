 673:   static String defaultTitleFor(String variant) {
 674:     switch (normalizeVariant(variant)) {
 675:       case successVariant:
 676:         return 'Success';
 677:       case warningVariant:
 678:         return 'Warning';
 679:       case dangerVariant:
 680:         return 'Danger';
 681:       case infoVariant:
 682:       default:
 683:         return 'Info';
 684:     }
 685:   }
