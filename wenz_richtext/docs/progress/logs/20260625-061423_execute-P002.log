 7544: Size _inlineFormulaPlaceholderSize(String formula, TextStyle style) {
 7545:   final fontSize = style.fontSize ?? 14;
 7546:   final runeCount = formula.trim().isEmpty ? 7 : formula.runes.length;
 7547:   final width = math.max(
 7548:     fontSize * 2.2,
 7549:     math.min(fontSize * 28, runeCount * fontSize * 0.62 + 12),
 7550:   );
 7551:   return Size(width, fontSize * 1.65);
 7552: }
