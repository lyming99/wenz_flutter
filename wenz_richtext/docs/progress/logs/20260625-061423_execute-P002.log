    1: import 'package:flutter/widgets.dart';
    2: 
    3: import '../core/model/inline_node.dart';
    4: 
    5: /// Builds an inline span for an [InlineEmbed].
    6: ///
    7: /// The editor still treats every embed as one logical character for selection
    8: /// and caret movement. Custom renderers should therefore return compact spans;
    9: /// use a block renderer when an embed needs a large interactive widget.
   10: typedef InlineEmbedSpanBuilder = InlineSpan? Function(
   11:   BuildContext context,
   12:   InlineEmbed embed,
   13:   TextStyle textStyle,
   14: );
   15: 
   16: /// Optional extension point for formula / mention / emoji / custom inline embeds.
   17: abstract class InlineEmbedRenderer {
   18:   const InlineEmbedRenderer();
   19: 
   20:   /// Returns an [InlineSpan] for [embed], or `null` to use the built-in fallback.
   21:   InlineSpan? buildTextSpan(
   22:     BuildContext context,
   23:     InlineEmbed embed,
   24:     TextStyle textStyle,
   25:   );
   26: }
   27: 
   28: /// Convenience adapter for function-based inline embed rendering.
   29: class InlineEmbedRendererCallback extends InlineEmbedRenderer {
   30:   const InlineEmbedRendererCallback(this.builder);
   31: 
   32:   final InlineEmbedSpanBuilder builder;
   33: 
   34:   @override
   35:   InlineSpan? buildTextSpan(
   36:     BuildContext context,
   37:     InlineEmbed embed,
   38:     TextStyle textStyle,
   39:   ) {
   40:     return builder(context, embed, textStyle);
   41:   }
   42: }
   43: 
   44: /// Ordered registry for inline embed span builders keyed by
   45: /// [InlineEmbed.embedType].
   46: ///
   47: /// This is the plugin-friendly variant of [InlineEmbedRendererCallback]: a host
   48: /// can pass one registry to [WenzRichTextEditor.inlineEmbedRenderer] and let
   49: /// multiple plugins contribute compact renderers without wrapping each other.
   50: class InlineEmbedRendererRegistry extends InlineEmbedRenderer {
   51:   InlineEmbedRendererRegistry({
   52:     Map<String, InlineEmbedSpanBuilder> builders =
   53:         const <String, InlineEmbedSpanBuilder>{},
   54:     this.fallback,
   55:   }) {
   56:     _builders.addAll(builders);
   57:   }
   58: 
   59:   final Map<String, InlineEmbedSpanBuilder> _builders =
   60:       <String, InlineEmbedSpanBuilder>{};
   61: 
   62:   /// Optional renderer used when no builder is registered for the embed type.
   63:   final InlineEmbedRenderer? fallback;
   64: 
   65:   /// Registered embed types in insertion order.
   66:   Iterable<String> get embedTypes => _builders.keys;
   67: 
