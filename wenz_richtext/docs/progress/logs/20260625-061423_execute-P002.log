+  }
+  final description = video.description.trim();
+  if (description.isNotEmpty) {
+    parts.add(description);
+  }
+  if (video.uploadStatus == FileUploadStatus.failed &&
+      video.uploadError.isNotEmpty) {
+    parts.add(video.uploadError);
+  }
+  return parts.join(', ');
+}
