-
-    testWidgets('releasing the pointer stops the auto-scroll ticker', (
-      tester,
-    ) async {
-      final controller = WenzRichTextController(document: tallDocument());
-
-      await tester.pumpWidget(
-        MaterialApp(
-          home: Scaffold(
