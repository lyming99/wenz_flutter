+    testWidgets('updates scroll metrics from measured block extent cache', (
+      tester,
+    ) async {
+      final controller = WenzRichTextController(
+        document: measuredDocument(tallBlock: true),
+      );
+
+      await tester.pumpWidget(
+        MaterialApp(
+          home: Scaffold(
+            body: SizedBox(
+              height: 300,
