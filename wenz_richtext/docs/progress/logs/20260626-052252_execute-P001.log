+    await _tapTextOffset(tester, 'Ship core', 2);
+    await tester.pump();
+
+    _expectBlockTextSelection(
+      controller.selection,
+      blockId: 'task1',
+      blockIndex: 0,
+      baseOffset: 2,
+      extentOffset: 2,
