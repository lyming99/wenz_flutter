+    'code block syntax highlights supported languages and leaves unsupported plain',
+    (tester) async {
+      const dartCode = 'final value = 42; // done\nString name = "Ada";';
+      const jsCode = 'const answer = 42; // ok';
+      const jsonCode = '{"ok": true, "n": 3}';
