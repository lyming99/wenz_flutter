+
+    Future<void> expectConvertedTextSelectable() async {
+      await _tapTextOffset(tester, convertedText, 0);
+      await tester.pump();
+      _expectBlockTextSelection(
+        controller.selection,
+        blockId: 'p-convert',
+        blockIndex: 0,
+        baseOffset: 0,
+        extentOffset: 0,
