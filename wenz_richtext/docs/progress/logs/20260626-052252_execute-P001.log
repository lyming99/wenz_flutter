+      controller.selection,
+      blockId: 'p-inline',
+      blockIndex: 0,
+      baseOffset: 4,
+      extentOffset: 4,
+    );
+
+    await tester.dragFrom(emojiLeft, mentionRight - emojiLeft);
+    await tester.pump();
+    _expectBlockTextSelection(
+      controller.selection,
+      blockId: 'p-inline',
+      blockIndex: 0,
+      baseOffset: controller.selection!.base.offset,
+      extentOffset: 4,
+    );
