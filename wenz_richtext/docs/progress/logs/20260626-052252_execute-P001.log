-    blockId: blockId,
-    blockIndex: blockIndex,
-    path: PositionPath.blockObject(blockId),
-    offset: 0,
-  );
-  return DocumentSelection(
-    base: start,
-    extent: start.copyWith(offset: 1),
-  );
