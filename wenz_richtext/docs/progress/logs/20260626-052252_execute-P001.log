+      MaterialApp(
+        home: Scaffold(
+          body: WenzRichTextEditor(
+            controller: controller,
+            enableIme: false,
+          ),
+        ),
+      ),
+    );
+
+    expect(find.text('dart'), findsOneWidget);
+    expect(find.byTooltip('复制代码'), findsOneWidget);
+
+    await tester.tap(find.byTooltip('复制代码'));
+    await tester.pump();
