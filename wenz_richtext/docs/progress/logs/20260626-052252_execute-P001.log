+DocumentSelection _tableCellSelection() {
+  final position = DocumentPosition.tableCell(
+    tableBlockId: 'table1',
+    blockIndex: 0,
+    tableRowIndex: 0,
+    tableColumnIndex: 0,
+    offset: 0,
+  );
