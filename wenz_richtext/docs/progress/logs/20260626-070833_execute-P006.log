 791:   List<InlineNode> _parseCalloutInlineWithoutTitle(
 792:     dom.Element node,
 793:     dom.Element? titleElement,
 794:   ) {
 795:     final runs = <InlineNode>[];
 796:     for (final child in node.nodes) {
 797:       if (titleElement != null && identical(child, titleElement)) {
 798:         continue;
 799:       }
 800:       runs.addAll(_parseInlineNode(child, const TextAttributes()));
 801:     }
 802:     return _coalesce(runs);
