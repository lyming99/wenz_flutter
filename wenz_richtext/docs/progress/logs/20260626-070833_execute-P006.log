 202: /// Bundles everything a block renderer needs to paint a block. Passed to every
 203: /// [BlockRendererBuilder] so custom renderers get the same surface as the
 204: /// built-in ones (selection, caret, geometry, IME composition, debug overlay).
 205: ///
 206: /// Fields are intentionally the union of what each built-in renderer consumes;
 207: /// a renderer is free to ignore the ones it does not need.
 208: ///
 209: /// Row-level chrome such as the [BlockDragHandleSpec] surface is deliberately
 210: /// editor-owned and sits outside renderer output. Renderers paint block content
 211: /// only, which keeps default drag handles available to custom renderers and
 212: /// prevents nested table-cell text or inline/object controls from becoming
 213: /// sortable rows.
 214: class BlockRenderContext {
 215:   const BlockRenderContext({
 216:     required this.block,
 217:     required this.blockIndex,
 218:     this.blockCount = 1,
 219:     required this.selection,
 220:     required this.compositionState,
 221:     required this.registry,
 222:     required this.showCaret,
 223:     this.textStyle,
 224:     this.showDebugOverlay = false,
 225:     this.canEdit = true,
 226:     this.mediaResolver,
 227:     this.inlineEmbedRenderer,
 228:     this.listMarker,
 229:     this.onCodeLanguageChanged,
 230:     this.onCodeCopied,
 231:     this.onCalloutVariantChanged,
 232:     this.onTableToolbarAction,
 233:     this.tableToolbarOverlayController,
 234:     this.onTableColumnResize,
 235:     this.onTodoCheckedChanged,
 236:     this.onObjectBlockAction,
 237:     this.headingCollapseState,
 238:     this.onHeadingCollapseToggled,
 239:     this.findMatches = const <FindReplaceMatch>[],
 240:     this.currentFindMatch,
 241:   });
 242: 
 243:   final BlockNode block;
 244:   final int blockIndex;
 245: 
 246:   /// Number of top-level blocks in the host editor. Defaults to one for
 247:   /// hand-built contexts so boundary-sensitive actions stay disabled unless the
 248:   /// host supplies the actual count.
 249:   final int blockCount;
 250:   final DocumentSelection? selection;
 251:   final CompositionState? compositionState;
 252:   final BlockGeometryRegistry registry;
 253:   final bool showCaret;
 254:   final TextStyle? textStyle;
 255:   final bool showDebugOverlay;
 256: 
 257:   /// Whether renderers should expose mutating controls. Read-only editors can
 258:   /// still offer copy-style object actions through [onObjectBlockAction].
 259:   final bool canEdit;
