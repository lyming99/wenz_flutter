 824:   TextBlockNode _decodeListItem(
 825:     dom.Element li,
 826:     String? listType,
 827:     String Function(String) newId,
 828:   ) {
 829:     // Detect a leading checkbox input for task list items.
 830:     var checked = false;
 831:     var isTask = false;
 832:     dom.Element? checkboxInput;
 833:     for (final child in li.children) {
 834:       if (child.localName?.toLowerCase() == 'input') {
 835:         final type = child.attributes['type'];
 836:         if (type == 'checkbox') {
 837:           isTask = true;
 838:           checked = child.attributes.containsKey('checked');
 839:           checkboxInput = child;
 840:           break;
 841:         }
 842:       }
 843:     }
 844: 
 845:     // Build the inline content, dropping the checkbox input node.
 846:     final inline = <InlineNode>[];
 847:     for (final child in li.nodes) {
 848:       if (child == checkboxInput) {
 849:         continue;
 850:       }
 851:       inline.addAll(_parseInline(child));
 852:     }
 853: 
 854:     final effectiveListType = isTask ? 'task' : listType;
 855:     return TextBlockNode(
 856:       id: newId(isTask ? 'task' : (listType == 'ordered' ? 'oli' : 'li')),
 857:       type: BlockType.listItem,
 858:       attributes: BlockAttributes(
 859:         listType: effectiveListType,
 860:         checked: isTask ? checked : null,
 861:       ),
 862:       content: inline,
 863:     );
 864:   }
