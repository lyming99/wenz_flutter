 509:   /// Resolves the table block + cell coordinates under the current caret, or
 510:   /// null when the caret is not inside a table cell.
 511:   _TableContext? _currentTableContext() {
 512:     final selection = _controller.selection;
 513:     final path = selection?.extent.path;
 514:     if (path == null || !path.isTableCellText) {
 515:       return null;
 516:     }
 517:     final blockIndex = selection!.extent.blockIndex;
 518:     if (blockIndex < 0 || blockIndex >= _controller.document.blocks.length) {
 519:       return null;
 520:     }
 630:     if (position.path.isTableCellText) {
 631:       return (index + 1).clamp(0, blockCount).toInt();
 632:     }
 633:     if (position.path.isBlockObject && position.offset > 0) {
 634:       return (index + 1).clamp(0, blockCount).toInt();
 635:     }
 636:     return index;
 637:   }
 638: }
