+      index: index ?? _currentBlockInsertionIndex(),
+      blockId: blockId,
+      assetId: assetId,
+      playbackUrl: playbackUrl,
+      file: file,
+      coverUrl: coverUrl,
+      title: title,
+      description: description,
+      aspectRatio: aspectRatio,
+      uploadStatus: uploadStatus,
+      uploadError: uploadError,
+      selection: selection,
+    );
