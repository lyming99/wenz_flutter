  24:         }
  25:         final items = controller.items;
  26:         final theme = Theme.of(context);
  27:         return Material(
  28:           key: const ValueKey<String>('wenz-slash-menu-overlay'),
  29:           color: theme.colorScheme.surface,
  30:           elevation: 6,
  31:           borderRadius: BorderRadius.circular(8),
  32:           clipBehavior: Clip.antiAlias,
  33:           child: ConstrainedBox(
  34:             constraints: BoxConstraints(
  35:               maxWidth: maxWidth,
  36:               maxHeight: maxHeight,
  37:             ),
  38:             child: ListView.builder(
  39:               padding: const EdgeInsets.symmetric(vertical: 4),
  40:               shrinkWrap: true,
