  12: /// Example [MediaResolver] (acceptance task B6): renders image blocks whose
  13: /// `assetId` is an http(s) URL via [Image.network], with an `errorBuilder`
  14: /// fallback so a failed load shows a message instead of crashing. Video/file
  15: /// blocks are left to the built-in placeholder.
  16: class _NetworkImageResolver implements MediaResolver {
  17:   @override
  18:   Widget? resolve(BuildContext context, BlockNode block) {
  19:     if (block is! ImageBlockNode) {
  20:       return null;
  21:     }
  22:     final url = block.assetId;
  23:     if (!url.startsWith('http')) {
  24:       // Not a network URL — let the placeholder render.
  25:       return null;
  26:     }
  27:     return ClipRRect(
  28:       borderRadius: BorderRadius.circular(6),
  29:       child: Image.network(
  30:         url,
  31:         fit: BoxFit.contain,
  32:         loadingBuilder: (context, child, progress) {
  33:           if (progress == null) {
  34:             return child;
  35:           }
  36:           return SizedBox(
  37:             height: 120,
  38:             child: Center(
  39:               child: CircularProgressIndicator(
  40:                 value:
  41:                     progress.cumulativeBytesLoaded /
  42:                     (progress.expectedTotalBytes ?? 1),
  43:               ),
  44:             ),
  45:           );
  46:         },
  47:         errorBuilder: (context, error, stackTrace) => const SizedBox(
  48:           height: 80,
  49:           child: Center(child: Text('⚠ image load failed')),
  50:         ),
  51:       ),
  52:     );
  53:   }
  54: }
