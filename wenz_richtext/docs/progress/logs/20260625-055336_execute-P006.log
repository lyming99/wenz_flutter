 389: /// Drives a toolbar UI from a [WenzRichTextController].
 390: ///
 391: /// Listens to the host controller (a [ChangeNotifier]) and exposes a
 392: /// [ToolbarState] snapshot that tracks the active selection's inline marks,
 393: /// link URL, block type, and the enable/disable state of every command the
 394: /// toolbar surfaces. Mutating helpers ([toggleBold], [setHeading], …) forward
 395: /// to the host controller's typed command methods so the toolbar and the
 396: /// editor share one execution path.
 397: ///
 398: /// The controller is a [ChangeNotifier] itself: rebuilds in a widget tree
 399: /// should subscribe via [addListener] and read [state]. Remember to [dispose]
 400: /// to detach from the host.
 401: class ToolbarController extends ChangeNotifier {
 402:   ToolbarController(this._host) {
 403:     _host.addListener(_handleHostChanged);
 404:     _recompute();
 405:   }
 406: 
 407:   final WenzRichTextController _host;
 408: 
 409:   ToolbarState _state = ToolbarState.empty;
 410:   ToolbarState get state => _state;
 411: 
