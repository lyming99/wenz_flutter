 667:       final length = inlineLength(node);
 668:       final nodeEnd = cursor + length;
 669:       if (node is TextRun && cursor <= offset) {
 670:         last = node.attributes;
 671:       }
 672:       if (nodeEnd >= offset) {
 673:         break;
 674:       }
 675:       cursor = nodeEnd;
 676:     }
 677:     return last ?? const TextAttributes();
 678:   }
