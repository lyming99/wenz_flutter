  612: CommandResult insertTableRowAt(
  613:   DocumentSession session,
  614:   int blockIndex,
  615:   int rowIndex, {
  616:   TableCellIdBuilder? cellIdBuilder,
  617: }) {
  618:   final tableBlock = tableAt(session, blockIndex);
  619:   if (tableBlock == null) {
  620:     return const CommandResult(recordHistory: false);
  621:   }
  622:   final insertIndex = rowIndex.clamp(0, tableBlock.table.rowCount).toInt();
  623:   final rows = <List<TableCellNode>>[
  624:     for (var i = 0; i < insertIndex; i++) copyRow(tableBlock.table.rows[i]),
  625:     _createRow(
  626:       tableBlock.id,
  627:       insertIndex,
  628:       tableBlock.table.columnCount,
  629:       cellIdBuilder,
  630:     ),
  631:     for (var i = insertIndex; i < tableBlock.table.rowCount; i++)
  632:       copyRow(tableBlock.table.rows[i]),
  633:   ];
  634:   return _replaceTableWithSelection(
  635:     session,
  636:     blockIndex,
  637:     tableBlock,
  638:     rows,
  639:     selection: _tableSelectionAfterRowInserted(
  640:       session.selection,
  641:       tableBlock,
  642:       blockIndex,
  643:       rows,
  644:       insertIndex,
  645:     ),
  646:   );
  647: }
  648: 
  649: CommandResult updateTableCell(
  650:   DocumentSession session,
  651:   int blockIndex,
  652:   int rowIndex,
  653:   int columnIndex,
  654:   TableCellNode Function(TableCellNode cell) update,
  655: ) {
  656:   final tableBlock = tableAt(session, blockIndex);
  657:   final cell = tableBlock?.table.cellAt(rowIndex, columnIndex);
  658:   if (tableBlock == null || cell == null) {
  659:     return const CommandResult(recordHistory: false);
  660:   }
  661:   final selection = session.selection;
  662:   final rows = tableBlock.table.rows.map(copyRow).toList();
  663:   rows[rowIndex][columnIndex] = update(cell);
  664:   final result = replaceTable(session, blockIndex, tableBlock, rows);
  665:   if (selection == null) {
  666:     return result;
  667:   }
  668:   return CommandResult(
  669:     selection: selection,
  670:     recordHistory: result.recordHistory,
  671:     metadata: result.metadata,
  672:   );
  673: }
  674: 
  675: CommandResult _replaceTableWithSelection(
  676:   DocumentSession session,
  677:   int blockIndex,
  678:   TableBlockNode tableBlock,
  679:   List<List<TableCellNode>> rows, {
  680:   DocumentSelection? selection,
  681:   Map<int, String>? columnAlignments,
  682:   Map<int, double>? columnWidths,
  683: }) {
  684:   final result = replaceTable(
  685:     session,
  686:     blockIndex,
  687:     tableBlock,
  688:     rows,
  689:     columnAlignments: columnAlignments,
  690:     columnWidths: columnWidths,
  691:   );
  692:   if (selection == null) {
  693:     return result;
  694:   }
  695:   return CommandResult(
  696:     selection: selection,
  697:     recordHistory: result.recordHistory,
  698:     metadata: result.metadata,
  699:   );
  700: }
