  913:         !identical(outline.editor, widget.controller)) {
  914:       return false;
  915:     }
  916:     final position = selection.extent;
  917:     if (!_isAtBlockBoundary(position, forward: forward)) {
  918:       return false;
  919:     }
  920:     final blocks = widget.controller.document.blocks;
  921:     final adjacentIndex = position.blockIndex + (forward ? 1 : -1);
  922:     if (adjacentIndex < 0 || adjacentIndex >= blocks.length) {
  923:       return false;
  924:     }
  925:     return outline.expandToRevealBlockId(blocks[adjacentIndex].id);
  926:   }
  927: 
  928:   bool _isAtBlockBoundary(
  929:     DocumentPosition position, {
  930:     required bool forward,
  931:   }) {
  932:     final blocks = widget.controller.document.blocks;
  933:     if (position.blockIndex < 0 || position.blockIndex >= blocks.length) {
  934:       return false;
  935:     }
  936:     final block = blocks[position.blockIndex];
  937:     if (position.path.isBlockText && block is TextBlockNode) {
  938:       final length = inlineNodesLength(block.content);
  939:       final offset = position.offset.clamp(0, length).toInt();
  940:       return forward ? offset >= length : offset <= 0;
  941:     }
  942:     if (position.path.isBlockCode && block is CodeBlockNode) {
  943:       final offset = position.offset.clamp(0, block.code.length).toInt();
  944:       return forward ? offset >= block.code.length : offset <= 0;
  945:     }
  946:     return position.path.isBlockObject;
  947:   }
