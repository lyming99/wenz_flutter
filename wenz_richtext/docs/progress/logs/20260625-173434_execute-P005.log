  458: class SplitTableCellCommand extends EditorCommand {
  459:   const SplitTableCellCommand({
  460:     required this.blockIndex,
  461:     required this.rowIndex,
  462:     required this.columnIndex,
  463:   });
  464: 
  465:   final int blockIndex;
  466:   final int rowIndex;
  467:   final int columnIndex;
  468: 
  469:   @override
  470:   String get description => 'splitTableCell';
  471: 
  472:   @override
  473:   CommandResult execute(DocumentSession session) {
  474:     final tableBlock = tableAt(session, blockIndex);
  475:     final anchor = tableBlock?.table.cellAt(rowIndex, columnIndex);
  476:     if (tableBlock == null ||
  477:         anchor == null ||
  478:         anchor.covered ||
  479:         (anchor.rowSpan == 1 && anchor.columnSpan == 1)) {
  480:       return const CommandResult(recordHistory: false);
  481:     }
  482:     final bottom = rowIndex + anchor.rowSpan - 1;
  483:     final right = columnIndex + anchor.columnSpan - 1;
  484:     if (bottom >= tableBlock.table.rowCount ||
  485:         right >= tableBlock.table.columnCount) {
  486:       return const CommandResult(recordHistory: false);
  487:     }
  488:     final rows = tableBlock.table.rows.map(copyRow).toList();
  489:     for (var row = rowIndex; row <= bottom; row++) {
  490:       for (var column = columnIndex; column <= right; column++) {
  491:         final cell = rows[row][column];
  492:         rows[row][column] = TableCellNode(
  493:           id: cell.id,
  494:           blocks: cell.blocks.map((block) => block.copy()).toList(),
  495:           isHeader: cell.isHeader,
  496:           backgroundColor: cell.backgroundColor,
  497:         );
  498:       }
  499:     }
  500:     return _replaceTableWithSelection(
  501:       session,
  502:       blockIndex,
  503:       tableBlock,
  504:       rows,
  505:       selection:
  506:           cellSelection(tableBlock.id, blockIndex, rowIndex, columnIndex, 0),
  507:       columnAlignments: tableBlock.table.columnAlignments,
  508:       columnWidths: tableBlock.table.columnWidths,
  509:     );
  510:   }
  511: }
