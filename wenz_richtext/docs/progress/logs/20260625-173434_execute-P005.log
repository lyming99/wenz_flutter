  152: /// Editor-level host that renders table toolbar requests into the system overlay.
  153: class TableFloatingToolbarOverlayHost extends StatefulWidget {
  154:   const TableFloatingToolbarOverlayHost({
  155:     super.key,
  156:     required this.controller,
  157:     required this.child,
  158:   });
  159: 
  160:   final TableFloatingToolbarOverlayController controller;
  161:   final Widget child;
  162: 
  163:   @override
  164:   State<TableFloatingToolbarOverlayHost> createState() =>
  165:       _TableFloatingToolbarOverlayHostState();
  166: }
  167: 
  168: class _TableFloatingToolbarOverlayHostState
  169:     extends State<TableFloatingToolbarOverlayHost> {
  170:   final OverlayPortalController _portalController = OverlayPortalController();
  171:   TableFloatingToolbarOverlayRequest? _request;
  172: 
  173:   @override
  174:   void initState() {
  175:     super.initState();
  176:     _request = widget.controller.request;
  177:     widget.controller.addListener(_handleControllerChanged);
  178:     WidgetsBinding.instance.addPostFrameCallback((_) => _syncPortal());
  179:   }
  180: 
  181:   @override
  182:   void didUpdateWidget(covariant TableFloatingToolbarOverlayHost oldWidget) {
  183:     super.didUpdateWidget(oldWidget);
  184:     if (oldWidget.controller == widget.controller) {
  185:       return;
  186:     }
  187:     oldWidget.controller.removeListener(_handleControllerChanged);
  188:     _request = widget.controller.request;
  189:     widget.controller.addListener(_handleControllerChanged);
  190:     WidgetsBinding.instance.addPostFrameCallback((_) => _syncPortal());
  191:   }
  192: 
  193:   @override
  194:   void dispose() {
  195:     widget.controller.removeListener(_handleControllerChanged);
  196:     if (_portalController.isShowing) {
  197:       _portalController.hide();
  198:     }
  199:     super.dispose();
  200:   }
  201: 
  202:   @override
  203:   Widget build(BuildContext context) {
  204:     return OverlayPortal(
  205:       controller: _portalController,
  206:       overlayChildBuilder: (context) {
  207:         final request = _request;
  208:         if (request == null || !request.enabled) {
  209:           return const SizedBox.shrink();
  210:         }
  211:         return _TableFloatingToolbarOverlayEntry(request: request);
  212:       },
  213:       child: widget.child,
  214:     );
  215:   }
  216: 
  217:   void _handleControllerChanged() {
  218:     if (!mounted) {
  219:       return;
  220:     }
  221:     setState(() {
  222:       _request = widget.controller.request;
  223:     });
  224:     _syncPortalSafely();
  225:   }
  226: 
  227:   void _syncPortalSafely() {
  228:     if (SchedulerBinding.instance.schedulerPhase ==
  229:         SchedulerPhase.persistentCallbacks) {
  230:       WidgetsBinding.instance.addPostFrameCallback((_) => _syncPortal());
  231:       return;
  232:     }
  233:     _syncPortal();
  234:   }
  235: 
  236:   void _syncPortal() {
  237:     if (!mounted) {
  238:       return;
  239:     }
  240:     final shouldShow = _request?.enabled == true;
  241:     if (shouldShow) {
  242:       if (!_portalController.isShowing) {
  243:         _portalController.show();
  244:       }
  245:     } else if (_portalController.isShowing) {
  246:       _portalController.hide();
  247:     }
  248:   }
  249: }
