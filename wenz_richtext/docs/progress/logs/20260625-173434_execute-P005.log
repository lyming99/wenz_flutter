  105: /// Editor-owned controller for the active table toolbar overlay request.
  106: class TableFloatingToolbarOverlayController extends ChangeNotifier {
  107:   TableFloatingToolbarOverlayRequest? _request;
  108:   final Map<String, TableFloatingToolbarAnchorSnapshot> _anchors =
  109:       <String, TableFloatingToolbarAnchorSnapshot>{};
  110: 
  111:   TableFloatingToolbarOverlayRequest? get request => _request;
  112: 
  113:   TableFloatingToolbarAnchorSnapshot? anchorFor(
  114:     String tableBlockId, {
  115:     int? blockIndex,
  116:   }) {
  117:     final anchor = _anchors[tableBlockId];
  118:     if (anchor == null ||
  119:         (blockIndex != null && anchor.blockIndex != blockIndex)) {
  120:       return null;
  121:     }
  122:     return anchor;
  123:   }
  124: 
  125:   void updateAnchor(TableFloatingToolbarAnchorSnapshot anchor) {
  126:     _anchors[anchor.tableBlockId] = anchor;
  127:   }
  128: 
  129:   void unregisterAnchor({required Object owner}) {
  130:     _anchors.removeWhere((_, anchor) => identical(anchor.owner, owner));
  131:     hide(owner: owner);
  132:   }
  133: 
  134:   void show(TableFloatingToolbarOverlayRequest request) {
  135:     _request = request;
  136:     notifyListeners();
  137:   }
  138: 
  139:   void hide({Object? owner}) {
  140:     final current = _request;
  141:     if (current == null) {
  142:       return;
  143:     }
  144:     if (owner != null && !identical(current.owner, owner)) {
  145:       return;
  146:     }
  147:     _request = null;
  148:     notifyListeners();
  149:   }
  150: }
