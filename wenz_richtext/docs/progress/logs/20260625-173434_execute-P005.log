   12: 
   13: /// Creates a request after the table anchor owns a [LayerLink] and global rect.
   14: typedef TableFloatingToolbarOverlayRequestBuilder
   15:     = TableFloatingToolbarOverlayRequest Function({
   16:   required Object owner,
   17:   required LayerLink anchorLink,
   18:   required Rect anchorRect,
   19:   required double visibleTop,
   20: });
   21: 
   22: /// Immutable payload sent from a table renderer to the editor-owned overlay host.
   23: ///
   24: /// The table renderer owns only the anchor and the current toolbar payload. The
   25: /// editor owns [TableFloatingToolbarOverlayHost], which renders this payload with
   26: /// Flutter's system [OverlayPortal] plus [CompositedTransformFollower]. This
   27: /// keeps the toolbar outside the table block's internal [Stack], so it can cross
   28: /// parent bounds and participate in overlay hit testing without making renderers
   29: /// manage overlay entries directly.
   30: @immutable
   31: class TableFloatingToolbarOverlayRequest {
   32:   const TableFloatingToolbarOverlayRequest({
   33:     required this.owner,
   34:     required this.anchorLink,
   35:     required this.anchorRect,
   36:     required this.visibleTop,
   37:     required this.tableBlockId,
   38:     required this.blockIndex,
   39:     required this.selectionRange,
   40:     required this.toolbarBuilder,
   41:     this.enabled = true,
   42:     this.minWidth = 0,
   43:     this.gap = 4,
   44:     this.fallbackHeight = 40,
   45:   });
   46: 
   47:   /// Opaque identity of the renderer anchor that published this request.
   48:   final Object owner;
   49: 
   50:   /// Link followed by the system overlay entry.
   51:   final LayerLink anchorLink;
   52: 
   53:   /// Current global rect of the table block anchor.
   54:   final Rect anchorRect;
   55: 
   56:   /// Top edge of the visible editor viewport in global coordinates.
   57:   final double visibleTop;
   58: 
   59:   /// Active table identity used by hosts/tests to reason about request staleness.
   60:   final String tableBlockId;
   61: 
   62:   /// Active table block index in the source document.
   63:   final int blockIndex;
   64: 
   65:   /// Current table-cell selection range that the toolbar actions target.
   66:   final TableCellRange selectionRange;
   67: 
   68:   /// Builds toolbar chrome. The renderer captures the table action callback here
   69:   /// so the overlay host never calls back into renderer state directly.
   70:   final TableFloatingToolbarOverlayBuilder toolbarBuilder;
   71: 
   72:   /// Whether this request may be shown. Hosts hide disabled requests.
   73:   final bool enabled;
   74: 
   75:   /// Minimum toolbar width, independent from the table block's layout width.
   76:   final double minWidth;
   77: 
   78:   /// Gap between the toolbar bottom and the table anchor top.
   79:   final double gap;
   80: 
   81:   /// Height used until the overlay measures its real toolbar child.
   82:   final double fallbackHeight;
   83: }
