8809: class _FileBlockActionMenu extends StatelessWidget {
8810:   const _FileBlockActionMenu({
8811:     required this.blockIndex,
8812:     required this.blockCount,
8813:     required this.canEdit,
8814:     this.onAction,
8815:   });
8816: 
8817:   final int blockIndex;
8818:   final int blockCount;
8819:   final bool canEdit;
8820:   final ObjectBlockActionHandler? onAction;
8821: 
8822:   @override
8823:   Widget build(BuildContext context) {
8824:     return PopupMenuButton<_ObjectMenuSelection>(
8825:       tooltip: '附件操作',
8826:       icon: const Icon(Icons.more_horiz),
8827:       iconSize: 18,
8828:       padding: EdgeInsets.zero,
8829:       constraints: const BoxConstraints.tightFor(width: 32, height: 32),
8830:       enabled: onAction != null,
8831:       onSelected: (selection) {
8832:         unawaited(_handleSelected(context, selection));
8833:       },
8834:       itemBuilder: (context) => <PopupMenuEntry<_ObjectMenuSelection>>[
8835:         const PopupMenuItem<_ObjectMenuSelection>(
8836:           value: _ObjectMenuSelection.action(ObjectBlockAction.copyReference),
8837:           child: Text('复制块引用'),
8838:         ),
8839:         if (canEdit) ...<PopupMenuEntry<_ObjectMenuSelection>>[
8840:           const PopupMenuDivider(),
8841:           const PopupMenuItem<_ObjectMenuSelection>(
8842:             value: _ObjectMenuSelection.action(ObjectBlockAction.duplicate),
8843:             child: Text('创建块副本'),
8844:           ),
8845:           const PopupMenuItem<_ObjectMenuSelection>(
8846:             value: _ObjectMenuSelection.more(),
8847:             child: Text('更多块操作'),
8848:           ),
8849:           const PopupMenuDivider(),
8850:           const PopupMenuItem<_ObjectMenuSelection>(
8851:             value: _ObjectMenuSelection.action(ObjectBlockAction.delete),
8852:             child: Text('删除块'),
8853:           ),
8854:         ],
8855:       ],
8856:     );
8857:   }
8858: 
8859:   Future<void> _handleSelected(
8860:     BuildContext context,
8861:     _ObjectMenuSelection selection,
8862:   ) async {
8863:     if (selection.more) {
8864:       final selected = await showMenu<_ObjectMenuSelection>(
8865:         context: context,
8866:         position: _fileMenuPosition(context),
8867:         semanticLabel: '更多块操作',
8868:         items: _moreItems(),
8869:       );
8870:       if (selected != null) {
8871:         _dispatch(selected);
8872:       }
8873:       return;
8874:     }
8875:     _dispatch(selection);
8876:   }
8877: 
8878:   RelativeRect _fileMenuPosition(BuildContext context) {
8879:     final overlay =
8880:         Overlay.of(context).context.findRenderObject() as RenderBox?;
8881:     final box = context.findRenderObject() as RenderBox?;
8882:     if (overlay == null || box == null || !overlay.hasSize || !box.hasSize) {
8883:       return RelativeRect.fill;
8884:     }
8885:     final topLeft = box.localToGlobal(Offset.zero, ancestor: overlay);
8886:     return RelativeRect.fromRect(
8887:         topLeft & box.size, Offset.zero & overlay.size);
8888:   }
8889: 
8890:   List<PopupMenuEntry<_ObjectMenuSelection>> _moreItems() {
8891:     return <PopupMenuEntry<_ObjectMenuSelection>>[
8892:       PopupMenuItem<_ObjectMenuSelection>(
8893:         value: const _ObjectMenuSelection.action(ObjectBlockAction.moveUp),
8894:         enabled: BlockDragHandleSpec.canMoveUp(
8895:           canEdit: canEdit && onAction != null,
8896:           blockIndex: blockIndex,
8897:           blockCount: blockCount,
8898:         ),
8899:         child: const Text('上移块'),
8900:       ),
8901:       PopupMenuItem<_ObjectMenuSelection>(
8902:         value: const _ObjectMenuSelection.action(ObjectBlockAction.moveDown),
8903:         enabled: BlockDragHandleSpec.canMoveDown(
8904:           canEdit: canEdit && onAction != null,
8905:           blockIndex: blockIndex,
8906:           blockCount: blockCount,
8907:         ),
8908:         child: const Text('下移块'),
8909:       ),
8910:       const PopupMenuDivider(),
8911:       const PopupMenuItem<_ObjectMenuSelection>(
8912:         value: _ObjectMenuSelection.action(ObjectBlockAction.markFileUploading),
8913:         child: Text('标记为上传中'),
8914:       ),
8915:       const PopupMenuItem<_ObjectMenuSelection>(
8916:         value: _ObjectMenuSelection.action(ObjectBlockAction.markFileUploaded),
8917:         child: Text('标记为已上传'),
8918:       ),
8919:       const PopupMenuItem<_ObjectMenuSelection>(
8920:         value: _ObjectMenuSelection.action(ObjectBlockAction.markFileFailed),
8921:         child: Text('标记为失败'),
8922:       ),
8923:     ];
8924:   }
8925: 
8926:   void _dispatch(_ObjectMenuSelection selection) {
8927:     final action = selection.action;
8928:     if (action == null) {
8929:       return;
8930:     }
8931:     onAction?.call(
8932:       ObjectBlockActionIntent(
8933:         action: action,
8934:         blockIndex: blockIndex,
8935:         value: selection.value,
8936:       ),
8937:     );
8938:   }
