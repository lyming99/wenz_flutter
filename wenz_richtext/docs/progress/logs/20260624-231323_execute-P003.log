385`t/// A registered editable block's geometry and layout access.
386`t///
387`t/// Each entry tracks **two** render boxes:
388`t/// - [renderBox] (via [key]) is the *text surface* — the box the laid-out
389`t///   [TextPainter] is painted into. It anchors caret/selection painting and
390`t///   [caretRectAt] global positioning, so it must be the box whose local
391`t///   coordinate space matches the painter's.
392`t/// - [hitTestBox] (via [hitTestKey]) is the *hit-test frame* — the box used for
393`t///   [BlockGeometryRegistry.positionFromGlobalOffset] containment and
394`t///   nearest-block clamping. For plain surfaces these are the same box; for
395`t///   table cells the hit-test frame is the whole cell (padding + centred text)
396`t///   while the text surface is only the centred text region. [hitLocalToTextLocal]
397`t///   translates a hit-test-local offset back into the text surface's local
398`t///   space so [positionFromLocal] receives the coordinate the painter expects.
399`tclass BlockEntry {
400`t  BlockEntry({
401`t    required this.blockId,
402`t    required this.blockIndex,
403`t    required this.path,
404`t    required this.textLength,
405`t    required this.key,
406`t    required this.positionFromLocal,
407`t    required this.wordRangeAt,
408`t    required this.caretRectAt,
409`t    required this.localCaretRectAt,
410`t    required this.localComposingRectForRange,
411`t    required this.verticalMoveAt,
412`t    this.hitTestKey,
413`t    Offset Function(Offset)? hitLocalToTextLocal,
414`t  }) : _hitLocalToTextLocal = hitLocalToTextLocal;
415`t
416`t  final String blockId;
417`t  final int blockIndex;
418`t  final PositionPath path;
419`t  final int textLength;
420`t
421`t  /// GlobalKey on the text surface render box (painter's local space).
422`t  final GlobalKey key;
423`t
424`t  /// GlobalKey on the hit-test frame render box. When `null`, [key] is used.
425`t  /// Set for table cells where the hit-test frame (whole cell) differs from
426`t  /// the text surface (centred text).
427`t  final GlobalKey? hitTestKey;
428`t
429`t  bool matches(String otherBlockId, PositionPath otherPath) {
430`t    return blockId == otherBlockId && path == otherPath;
431`t  }
432`t
433`t  /// Converts a local offset in the text surface's coordinate space to a
434`t  /// character offset within the block's text.
435`t  final int Function(Offset local) positionFromLocal;
436`t
437`t  /// Returns the word range covering [offset] using this block's text layout.
438`t  final TextRange Function(int offset) wordRangeAt;
