123`t  /// Resolves a global screen offset to a [DocumentPosition].
124`t  ///
125`t  /// If the point lands inside a registered block's hit-test box (the whole
126`t  /// cell frame for table cells, otherwise the text surface itself), the
127`t  /// position is computed from that block's *text-local* coordinates — the
128`t  /// hit-test local offset is first translated through the entry's
129`t  /// [BlockEntry.hitLocalToTextLocal] so padding/centring offsets are stripped.
130`t  /// Otherwise the nearest block is chosen by 2-D rect proximity and the caret
131`t  /// is clamped to that block's start or end — so a drag into the gap between
132`t  /// blocks (or beyond the last block) still extends the selection predictably.
133`t  DocumentPosition? positionFromGlobalOffset(Offset global) {
134`t    BlockEntry? hitEntry;
135`t    Offset? hitTextLocal;
136`t    var nearestHitDelta = double.infinity;
137`t    for (final entry in _entries) {
138`t      final box = entry.hitTestBox;
139`t      if (box == null) {
140`t        continue;
141`t      }
142`t      final local = box.globalToLocal(global);
143`t      if (local.dx >= 0 &&
144`t          local.dx <= box.size.width &&
145`t          local.dy >= 0 &&
146`t          local.dy <= box.size.height) {
147`t        final rect = box.localToGlobal(Offset.zero) & box.size;
148`t        final delta = (global - rect.center).distanceSquared;
149`t        if (delta < nearestHitDelta) {
150`t          nearestHitDelta = delta;
151`t          hitEntry = entry;
152`t          hitTextLocal = entry.hitLocalToTextLocal(local);
153`t        }
154`t      }
155`t    }
156`t    if (hitEntry != null && hitTextLocal != null) {
157`t      return DocumentPosition(
158`t        blockId: hitEntry.blockId,
159`t        blockIndex: hitEntry.blockIndex,
160`t        path: hitEntry.path,
161`t        offset: hitEntry.positionFromLocal(hitTextLocal),
162`t      );
163`t    }
164`t    // Missed every block: clamp to the nearest block's start/end.
165`t    return _clampToNearest(global);
166`t  }
167`t
168`t  DocumentPosition? _clampToNearest(Offset global) {
169`t    if (_entries.isEmpty) {
170`t      return null;
171`t    }
172`t    BlockEntry? nearest;
173`t    var nearestDelta = double.infinity;
174`t    var clampToEnd = false;
175`t    for (final entry in _entries) {
176`t      final box = entry.hitTestBox;
177`t      if (box == null) {
178`t        continue;
179`t      }
180`t      final rect = box.localToGlobal(Offset.zero) & box.size;
181`t      // 2-D distance from the point to the rect (0 when inside). Using both
182`t      // axes — not just vertical proximity — keeps a tap in a table cell's
183`t      // padding from being mis-attributed to a neighbouring cell/column, and a
184`t      // tap above/below a short cell from jumping to an adjacent row.
185`t      final dx = global.dx < rect.left
186`t          ? rect.left - global.dx
187`t          : (global.dx > rect.right ? global.dx - rect.right : 0.0);
188`t      final dy = global.dy < rect.top
189`t          ? rect.top - global.dy
190`t          : (global.dy > rect.bottom ? global.dy - rect.bottom : 0.0);
191`t      final delta = dx * dx + dy * dy;
192`t      if (delta < nearestDelta) {
193`t        nearestDelta = delta;
194`t        nearest = entry;
195`t        // Clamp to the end when the point sits to the right of / below the
196`t        // rect, to the start otherwise. This generalises the old vertical-only
197`t        // rule and behaves identically for paragraph cross-block drags while
198`t        // also handling 2-D table geometries.
199`t        clampToEnd = global.dx > rect.right || global.dy > rect.bottom;
200`t      }
201`t    }
202`t    if (nearest == null) {
203`t      return null;
204`t    }
205`t    // Resolve the caret using the tap's horizontal column when it falls inside
206`t    // the block's width. Project the point onto the block's nearest edge so it
207`t    // lands on the block's first line (above) / last line (below), then let the
208`t    // block's own layout map the (x, line) to a character offset. This keeps a
209`t    // gap-tap on the 4th column landing at ~offset 4 instead of always 0/end.
210`t    // Only when the tap is horizontally outside the block do we fall back to the
211`t    // hard 0 / textLength edges.
212`t    final box = nearest.hitTestBox;
213`t    if (box != null) {
214`t      final origin = box.localToGlobal(Offset.zero);
215`t      if (global.dx >= origin.dx && global.dx <= origin.dx + box.size.width) {
216`t        final rect = origin & box.size;
217`t        final edgeY = clampToEnd ? rect.bottom - 1 : rect.top + 1;
218`t        final clamped = Offset(global.dx, edgeY.clamp(rect.top, rect.bottom));
219`t        final local = box.globalToLocal(clamped);
220`t        final textLocal = nearest.hitLocalToTextLocal(local);
221`t        return DocumentPosition(
222`t          blockId: nearest.blockId,
223`t          blockIndex: nearest.blockIndex,
224`t          path: nearest.path,
225`t          offset: nearest.positionFromLocal(textLocal),
226`t        );
227`t      }
228`t    }
229`t    final offset = clampToEnd ? nearest.textLength : 0;
230`t    return DocumentPosition(
231`t      blockId: nearest.blockId,
232`t      blockIndex: nearest.blockIndex,
233`t      path: nearest.path,
234`t      offset: offset,
235`t    );
236`t  }
