238`t  /// Returns the global [Rect] of the block whose hit-test box contains
239`t  /// [global], or the nearest block's rect if none contains it. Used by the
240`t  /// gesture overlay to drive auto-scroll near viewport edges.
241`t  Rect? blockRectFromGlobalOffset(Offset global) {
242`t    for (final entry in _entries) {
243`t      final box = entry.hitTestBox;
244`t      if (box == null) {
245`t        continue;
246`t      }
247`t      final local = box.globalToLocal(global);
248`t      if (local.dx >= 0 &&
249`t          local.dx <= box.size.width &&
250`t          local.dy >= 0 &&
251`t          local.dy <= box.size.height) {
252`t        final origin = box.localToGlobal(Offset.zero);
253`t        return origin & box.size;
254`t      }
255`t    }
256`t    // Fall back to the 2-D-nearest block's rect.
257`t    BlockEntry? nearest;
258`t    var nearestDelta = double.infinity;
259`t    for (final entry in _entries) {
260`t      final box = entry.hitTestBox;
261`t      if (box == null) {
262`t        continue;
263`t      }
264`t      final rect = box.localToGlobal(Offset.zero) & box.size;
265`t      final dx = global.dx < rect.left
266`t          ? rect.left - global.dx
267`t          : (global.dx > rect.right ? global.dx - rect.right : 0.0);
268`t      final dy = global.dy < rect.top
269`t          ? rect.top - global.dy
270`t          : (global.dy > rect.bottom ? global.dy - rect.bottom : 0.0);
271`t      final delta = dx * dx + dy * dy;
272`t      if (delta < nearestDelta) {
273`t        nearestDelta = delta;
274`t        nearest = entry;
275`t      }
276`t    }
277`t    if (nearest == null) {
278`t      return null;
279`t    }
280`t    final box = nearest.hitTestBox!;
281`t    final origin = box.localToGlobal(Offset.zero);
282`t    return origin & box.size;
283`t  }
