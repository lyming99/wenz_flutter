370`t  BlockEntry? _entry(String blockId, PositionPath? path) {
371`t    if (path == null) {
372`t      // No path disambiguator: fall back to a linear scan (rare; used only by
373`t      // callers that don't distinguish same-block surfaces).
374`t      for (final entry in _entries) {
