48`t  /// Removes the entry for [blockId] and [path], if present. When [path] is not
49`t  /// provided, removes every surface for [blockId].
50`t  void unregister(String blockId, [PositionPath? path]) {
51`t    if (path != null) {
52`t      final key = _key(blockId, path);
53`t      final entry = _byKey.remove(key);
54`t      if (entry != null) {
55`t        _entries.remove(entry);
56`t      }
57`t      return;
58`t    }
59`t    _entries.removeWhere((e) {
60`t      if (e.blockId != blockId) {
61`t        return false;
62`t      }
63`t      _byKey.remove(_key(e.blockId, e.path));
64`t      return true;
65`t    });
66`t  }
