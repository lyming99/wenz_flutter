75`t  /// The bottom edge of the document content in global coordinates, taken from
76`t  /// the lowest mounted block surface. Used by the editor to tell whether a
77`t  /// page-jump target overshoots the document (a short doc paged past its end)
78`t  /// so the caret can jump to the document boundary instead of relying on the
79`t  /// ambiguous nearest-block clamp. Returns `null` when no surface is laid out.
80`t  double? contentExtent() {
81`t    double? bottom;
82`t    for (final entry in _entries) {
83`t      final box = entry.hitTestBox;
84`t      if (box == null || !box.hasSize) {
85`t        continue;
86`t      }
87`t      final rect = box.localToGlobal(Offset.zero) & box.size;
88`t      if (bottom == null || rect.bottom > bottom) {
89`t        bottom = rect.bottom;
90`t      }
91`t    }
92`t    return bottom;
93`t  }
94`t
95`t  /// Average height of the currently-mounted block surfaces and the smallest
96`t  /// block index among them. Used by the editor to estimate a scroll offset
97`t  /// when a programmatic caret jump targets a virtualised (un-mounted) block:
98`t  /// the stride × index gives a rough pixel offset close enough for ListView
99`t  /// to build the target block, after which a follow-up frame pixel-aligns.
100`t  ///
101`t  /// Returns `null` when no surfaces are currently laid out.
102`t  ({double meanHeight, int firstBlockIndex})? averageMountedBlockHeight() {
103`t    var totalHeight = 0.0;
104`t    var counted = 0;
105`t    var firstIndex = -1;
106`t    for (final entry in _entries) {
107`t      final box = entry.hitTestBox;
108`t      if (box == null || !box.hasSize) {
109`t        continue;
110`t      }
111`t      if (firstIndex < 0) {
112`t        firstIndex = entry.blockIndex;
113`t      }
114`t      totalHeight += box.size.height;
115`t      counted += 1;
116`t    }
117`t    if (counted == 0 || firstIndex < 0) {
118`t      return null;
119`t    }
120`t    return (meanHeight: totalHeight / counted, firstBlockIndex: firstIndex);
121`t  }
