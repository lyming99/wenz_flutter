587:   void _handleControllerChanged() {
588:     if (mounted) {
589:       // Drop the cached laid-out painter for blocks whose content changed so a
590:       // stale painter is not reused on the next build. Selection-only /
591:       // composition-only changes (empty set) do not invalidate anything.
592:       //
593:       // The block *extent* cache is intentionally NOT invalidated here. While a
594:       // block's text is being edited (most acutely during IME composition such
595:       // as pinyin input) its content mutates on every keystroke, but its height
596:       // barely changes. Dropping the cached height mid-edit would fall back to
597:       // the document-wide average height for one frame, repositioning every
598:       // following block — a visible flicker of the content below the caret. The
599:       // real (possibly unchanged) height is reconciled on the next frame by the
600:       // measured-block widget, so leaving the stale value yields one frame of a
601:       // near-correct height instead of one frame of a wrong average.
602:       final dirty = widget.controller.lastChangedBlockIds;
603:       if (dirty == null) {
604:         _extentCache.clear();
