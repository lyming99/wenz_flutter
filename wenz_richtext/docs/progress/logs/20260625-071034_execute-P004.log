+    final controller = WenzRichTextController(
+      document: const RichTextDocument(
+        blocks: <BlockNode>[
+          TextBlockNode(
+            id: 'p-inline',
+            type: BlockType.paragraph,
+            content: <InlineNode>[
+              TextRun(text: 'A'),
+              InlineEmbed(
+                embedType: 'emoji',
+                data: <String, Object?>{'emoji': '😄'},
+              ),
+              TextRun(text: 'B'),
+              InlineEmbed(
+                embedType: 'mention',
+                data: <String, Object?>{'label': 'bob'},
+              ),
