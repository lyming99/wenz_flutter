-              controller: controller,
-              autofocus: true,
-            ),
-          ),
-        ),
-      ),
-    );
-    controller.requestFocus();
-    await tester.pump();
-    await tester.pump();
-
-    expect(tester.testTextInput.hasAnyClients, isTrue);
-    tester.testTextInput.log.clear();
