+        home: Scaffold(
+          body: WenzRichTextEditor(
+            controller: controller,
+            enableIme: false,
+            inlineEmbedRenderer: renderer,
+          ),
+        ),
+      ),
+    );
+
+    expect(_richText('Solve formula(x^2) 😀 with @Ada'), findsOneWidget);
+  });
