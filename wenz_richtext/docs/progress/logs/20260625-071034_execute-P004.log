191:/// Bundles everything a block renderer needs to paint a block. Passed to every
192:/// [BlockRendererBuilder] so custom renderers get the same surface as the
193:/// built-in ones (selection, caret, geometry, IME composition, debug overlay).
194:///
195:/// Fields are intentionally the union of what each built-in renderer consumes;
196:/// a renderer is free to ignore the ones it does not need.
197:///
198:/// Row-level chrome such as the [BlockDragHandleSpec] surface is deliberately
199:/// editor-owned and sits outside renderer output. Renderers paint block content
200:/// only, which keeps default drag handles available to custom renderers and
201:/// prevents nested table-cell text or inline/object controls from becoming
202:/// sortable rows.
203:class BlockRenderContext {
204:  const BlockRenderContext({
205:    required this.block,
206:    required this.blockIndex,
207:    required this.selection,
208:    required this.compositionState,
209:    required this.registry,
210:    required this.showCaret,
211:    this.textStyle,
212:    this.showDebugOverlay = false,
213:    this.canEdit = true,
214:    this.mediaResolver,
215:    this.inlineEmbedRenderer,
216:    this.onCodeLanguageChanged,
217:    this.onCodeCopied,
218:    this.onCalloutVariantChanged,
219:    this.onTableToolbarAction,
220:    this.onTableColumnResize,
221:    this.onTodoCheckedChanged,
222:    this.onObjectBlockAction,
223:    this.findMatches = const <FindReplaceMatch>[],
224:    this.currentFindMatch,
225:  });
226:
227:  final BlockNode block;
228:  final int blockIndex;
229:  final DocumentSelection? selection;
230:  final CompositionState? compositionState;
231:  final BlockGeometryRegistry registry;
232:  final bool showCaret;
233:  final TextStyle? textStyle;
234:  final bool showDebugOverlay;
235:
236:  /// Whether renderers should expose mutating controls. Read-only editors can
237:  /// still offer copy-style object actions through [onObjectBlockAction].
238:  final bool canEdit;
239:
240:  /// Optional [MediaResolver] injected via the editor. The built-in
241:  /// image/video/file renderers consult it before falling back to the
242:  /// placeholder. `null` when no resolver is injected. Custom renderers may
243:  /// read it too if they want to share the same resolution logic.
244:  final MediaResolver? mediaResolver;
245:
246:  /// Optional inline embed renderer injected via the editor. The built-in text
247:  /// renderers consult it for [InlineEmbed]s before falling back to their
248:  /// default formula / mention / image labels.
249:  final InlineEmbedRenderer? inlineEmbedRenderer;
250:
251:  /// Optional callback used by code block renderers to change the block's
252:  /// language through the host controller.
253:  final ValueChanged<String>? onCodeLanguageChanged;
254:
255:  /// Optional callback used by code block renderers to copy the code text.
256:  final Future<void> Function(String code)? onCodeCopied;
257:
258:  /// Optional callback used by callout renderers to change the block variant
259:  /// through the host controller.
260:  final ValueChanged<String>? onCalloutVariantChanged;
261:
262:  /// Optional callback used by table renderers to route floating-toolbar table
263:  /// actions through the host controller.
264:  final TableToolbarActionHandler? onTableToolbarAction;
265:
266:  /// Optional callback used by table renderers to persist drag-resized column
267:  /// widths through the host controller.
268:  final TableColumnResizeHandler? onTableColumnResize;
269:
270:  /// Optional callback used by task-list renderers to persist checkbox changes.
271:  final TodoCheckedChangeHandler? onTodoCheckedChanged;
272:
273:  /// Optional callback used by object-block renderers (image/video/file/embed
274:  /// and divider) to route quick actions through the host editor/controller.
275:  final ObjectBlockActionHandler? onObjectBlockAction;
276:
277:  /// Find/replace matches currently visible for this block renderer. Built-in
278:  /// text renderers paint them as non-destructive highlights; custom renderers
279:  /// can opt in by mapping these ranges onto their own text surfaces.
280:  final List<FindReplaceMatch> findMatches;
281:
282:  /// The active find match, if any. It is also present in [findMatches].
283:  final FindReplaceMatch? currentFindMatch;
284:
285:  /// Whether the active (collapsed) selection sits inside [block], i.e. this
286:  /// block owns the caret. Convenience for caret-aware renderers.
287:  bool get ownsCaret {
288:    final sel = selection;
289:    if (sel == null || !sel.isCollapsed) {
290:      return false;
291:    }
292:    return sel.extent.blockIndex == blockIndex &&
293:        sel.extent.blockId == block.id;
294:  }
295:}
