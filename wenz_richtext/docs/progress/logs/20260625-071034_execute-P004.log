+          TextBlockNode(
+            id: 'q-direct',
+            type: BlockType.quote,
+            content: <InlineNode>[TextRun(text: directQuoteText)],
+          ),
+        ],
+      ),
+      selection: collapsedTextSelection('p-convert', 0, 0),
+    );
+
+    await tester.pumpWidget(
+      MaterialApp(
+        home: Scaffold(
+          body: WenzRichTextEditor(
