+
+    testWidgets('programmatic caret jump moves the scroll offset forward', (
+      tester,
+    ) async {
+      final controller = WenzRichTextController(
+        document: bigDocument(),
+        selection: collapsedTextSelection('p0', 0, 0),
+      );
+
+      await tester.pumpWidget(
