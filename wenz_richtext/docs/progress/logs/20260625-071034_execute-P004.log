+        WenzRichTextDesignBaseline.stateTokens, contains('inline.highlight'));
+    expect(WenzRichTextDesignBaseline.stateTokens, contains('callout.warning'));
+
+    Widget fallbackBuilder(BuildContext context, BlockRenderContext rc) {
