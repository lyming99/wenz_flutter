+      ? matchedWidget
+      : tester.widget<IconButton>(
+          find.ancestor(
+            of: tooltipFinder,
+            matching: find.byType(IconButton),
+          ),
+        );
+  expect(button.onPressed, isNotNull);
+  button.onPressed!();
+}
