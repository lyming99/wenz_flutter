+          tallFormulaRect.height, greaterThan(normalFormulaRect.height + 12));
+      expect(tallFormulaRect.height, lessThan(48));
+      expect(
+          tallFormulaTextRect.height, greaterThan(tallFormulaRect.height - 1));
