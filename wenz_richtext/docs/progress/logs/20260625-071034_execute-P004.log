+double _richTextFirstLineCenterY(WidgetTester tester, Finder finder) {
+  final firstLine = _richTextLineMetrics(tester, finder).first;
+  return tester.getTopLeft(finder).dy +
+      firstLine.baseline -
+      firstLine.ascent +
+      firstLine.height / 2;
