+      expect(
+        singleCheckboxRect.center.dy - singleFirstLineCenter,
+        moreOrLessEquals(0, epsilon: 0.75),
+      );
+      expect(
+        wrappedCheckboxRect.center.dy - wrappedFirstLineCenter,
+        moreOrLessEquals(0, epsilon: 0.75),
