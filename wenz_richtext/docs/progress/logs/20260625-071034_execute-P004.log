+
+      await tester.pumpWidget(
+        MaterialApp(
+          home: Scaffold(
+            body: WenzRichTextEditor(controller: controller),
+          ),
+        ),
+      );
+      await tester.pumpAndSettle();
+      expect(_richText('block-2-content'), findsOneWidget);
+
+      await tester.drag(
+        find.byType(WenzRichTextEditor),
+        const Offset(0, -800),
