+      await tester.pumpAndSettle();
+
+      // p2 (an endpoint) stays mounted even though it scrolled off-screen.
+      expect(_richText('block-2-content'), findsOneWidget);
+    });
+
+    testWidgets('programmatic caret jump scrolls the caret into view', (
+      tester,
+    ) async {
