+Finder _richTextIgnoringCaret(String text) {
+  return find.byWidgetPredicate(
+    (widget) =>
+        widget is RichText &&
+        widget.text.toPlainText().replaceAll('\uFFFC', '') == text,
+    description: 'RichText with plain text "$text" ignoring caret',
+  );
