3006:  /// Whether the current selection could affect this block's rendering: it is
3007:  /// an endpoint, or it lies strictly between the selection's start and end
3008:  /// (so it would be fully highlighted), or the selection is collapsed inside
3009:  /// it (the caret).
3010:  bool _selectionTouchesBlock(_KeepAliveBlock w) {
3011:    final selection = w.selection;
3012:    if (selection == null) {
3013:      return false;
3014:    }
3015:    final index = w.blockIndex;
3016:    final start = selection.start;
3017:    final end = selection.end;
3018:    if (start.blockIndex == index || end.blockIndex == index) {
3019:      return true;
3020:    }
3021:    // Interior block of a multi-block range is fully highlighted.
3022:    return index > start.blockIndex && index < end.blockIndex;
3023:  }
3024:
3025:  /// Whether an active IME composition affects this block (composition lives in
3026:  /// the caret's block). Only that block needs to repaint the underline span.
3027:  bool _compositionTouchesBlock(_KeepAliveBlock w) {
3028:    final composition = w.compositionState;
3029:    if (composition == null) {
3030:      return false;
3031:    }
3032:    final selection = w.selection;
3033:    return selection != null && selection.extent.blockIndex == w.blockIndex;
3034:  }
3035:}
