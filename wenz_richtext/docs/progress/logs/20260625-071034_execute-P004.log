+      blockId: 'p-inline',
+      blockIndex: 0,
+      baseOffset: controller.selection!.base.offset,
+      extentOffset: 5,
+    );
+
+    await _waitPastMultiClickWindow(tester);
+    await tester.dragFrom(mentionRight, followingEnd - mentionRight);
