+
+void pressIconButtonByTooltip(WidgetTester tester, String tooltip) {
+  final tooltipFinder = find.byTooltip(tooltip);
+  expect(tooltipFinder, findsOneWidget);
+  final matchedWidget = tooltipFinder.evaluate().single.widget;
