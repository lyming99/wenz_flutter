99:/// Editor-owned interaction contract for the top-level block drag handle.
100:///
101:/// The handle is row chrome: it belongs to the editor's top-level block shell,
102:/// not to [BlockRendererBuilder] output. Keeping the contract here lets custom
103:/// renderers rely on the same menu/reorder surface without wrapping their own
104:/// handle, and keeps nested surfaces (table cells, inline embeds, object-block
105:/// controls) out of row-sorting hit testing.
106:abstract final class BlockDragHandleSpec {
107:  /// Reserved leading gutter for the handle, outside the renderer's content box.
108:  static const double railWidth = 32.0;
109:
110:  /// Gap between the renderer content edge and the handle hit target.
111:  static const double gapToContent = 4.0;
112:
113:  /// Minimum pointer/focus hit target for mouse, touch, and keyboard traversal.
114:  static const Size hitSize = Size.square(28.0);
115:
116:  /// Visual glyph size inside [hitSize].
117:  static const Size visualSize = Size.square(18.0);
118:
119:  /// Top inset from the block row to the handle hit target. Renderers with tall
120:  /// content still anchor the handle near the first visual line/control row.
121:  static const double topInset = 2.0;
122:
123:  /// Pointer movement that turns a handle press into a reorder drag. Releasing
124:  /// before this distance is treated as a menu click/tap.
125:  static const double dragStartSlop = 6.0;
126:
127:  /// Opacity when the row is not hovered/focused and no menu/drag is active.
128:  static const double idleOpacity = 0.0;
129:
130:  /// Opacity while the row or handle rail is hovered.
131:  static const double hoverOpacity = 0.72;
132:
133:  /// Opacity while the handle has keyboard focus, its menu is open, or it drags.
134:  static const double activeOpacity = 1.0;
135:
136:  /// Opacity for read-only/no-edit states. Disabled handles are not focusable.
137:  static const double disabledOpacity = 0.0;
138:
139:  /// Whether a top-level block row may expose the handle/menu surface.
140:  static bool canShow({
141:    required bool canEdit,
142:    required int blockIndex,
143:    required int blockCount,
144:  }) {
145:    return canEdit && blockIndex >= 0 && blockIndex < blockCount;
146:  }
147:
148:  /// Whether the row can enter drag-reorder mode.
149:  static bool canDragSort({
150:    required bool canEdit,
151:    required int blockIndex,
152:    required int blockCount,
153:  }) {
154:    return canShow(
155:          canEdit: canEdit,
156:          blockIndex: blockIndex,
157:          blockCount: blockCount,
158:        ) &&
159:        blockCount > 1;
160:  }
161:
162:  /// Whether a menu/keyboard move-up action is legal for the row.
163:  static bool canMoveUp({
164:    required bool canEdit,
165:    required int blockIndex,
166:    required int blockCount,
167:  }) {
168:    return canDragSort(
169:          canEdit: canEdit,
170:          blockIndex: blockIndex,
171:          blockCount: blockCount,
172:        ) &&
173:        blockIndex > 0;
174:  }
175:
176:  /// Whether a menu/keyboard move-down action is legal for the row.
177:  static bool canMoveDown({
178:    required bool canEdit,
179:    required int blockIndex,
180:    required int blockCount,
181:  }) {
182:    return canDragSort(
183:          canEdit: canEdit,
184:          blockIndex: blockIndex,
185:          blockCount: blockCount,
186:        ) &&
187:        blockIndex < blockCount - 1;
188:  }
189:}
