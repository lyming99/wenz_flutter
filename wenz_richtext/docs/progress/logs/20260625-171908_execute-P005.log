  183: class DeleteTableColumnCommand extends EditorCommand {
  184:   const DeleteTableColumnCommand({
  185:     required this.blockIndex,
  186:     required this.columnIndex,
  187:   });
  188: 
  189:   final int blockIndex;
  190:   final int columnIndex;
  191: 
  192:   @override
  193:   String get description => 'deleteTableColumn';
  194: 
  195:   @override
  196:   CommandResult execute(DocumentSession session) {
  197:     final tableBlock = tableAt(session, blockIndex);
  198:     if (tableBlock == null ||
  199:         tableBlock.table.columnCount <= 1 ||
  200:         columnIndex < 0 ||
  201:         columnIndex >= tableBlock.table.columnCount) {
  202:       return const CommandResult(recordHistory: false);
  203:     }
  204:     final rows = <List<TableCellNode>>[
  205:       for (final row in tableBlock.table.rows)
  206:         <TableCellNode>[
  207:           for (var i = 0; i < row.length; i++)
  208:             if (i != columnIndex) copyCell(row[i]),
  209:         ],
  210:     ];
  211:     final alignments = shiftColumnMapOnDelete(
  212:       tableBlock.table.columnAlignments,
  213:       columnIndex,
  214:     );
  215:     final widths = shiftColumnMapOnDelete(
  216:       tableBlock.table.columnWidths,
  217:       columnIndex,
  218:     );
  219:     return _replaceTableWithSelection(
  220:       session,
  221:       blockIndex,
  222:       tableBlock,
  223:       rows,
  224:       selection: _tableSelectionAfterColumnDeleted(
  225:         session.selection,
  226:         tableBlock,
  227:         blockIndex,
  228:         rows,
  229:         columnIndex,
  230:       ),
  231:       columnAlignments: alignments,
  232:       columnWidths: widths,
  233:     );
  234:   }
  235: }
