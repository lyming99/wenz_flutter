 8123: double _richTextFirstLineCenterY(WidgetTester tester, Finder finder) {
 8124:   final firstLine = _richTextLineMetrics(tester, finder).first;
 8125:   return tester.getTopLeft(finder).dy +
 8126:       firstLine.baseline -
 8127:       firstLine.ascent +
 8128:       firstLine.height / 2;
 8129: }
 8130: 
 8131: double _richTextFirstLineHeight(WidgetTester tester, Finder finder) {
 8132:   return _richTextLineMetrics(tester, finder).first.height;
 8133: }
 8134: 
 8135: List<LineMetrics> _richTextLineMetrics(WidgetTester tester, Finder finder) {
 8136:   final richText = tester.widget<RichText>(finder);
 8137:   return _richTextPainter(tester, finder, richText).computeLineMetrics();
 8138: }
 8139: 
 8140: TextPainter _richTextPainter(
 8141:   WidgetTester tester,
 8142:   Finder finder,
 8143:   RichText richText,
 8144: ) {
 8145:   final size = tester.getSize(finder);
 8146:   return TextPainter(
 8147:     text: richText.text,
 8148:     textAlign: richText.textAlign,
 8149:     textDirection: TextDirection.ltr,
 8150:   )..layout(maxWidth: size.width);
 8151: }
