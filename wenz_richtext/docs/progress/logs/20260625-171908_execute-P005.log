 8167: DocumentSelection objectBlockSelection(String blockId, int blockIndex) {
 8168:   final start = DocumentPosition(
 8169:     blockId: blockId,
 8170:     blockIndex: blockIndex,
 8171:     path: PositionPath.blockObject(blockId),
 8172:     offset: 0,
 8173:   );
 8174:   return DocumentSelection(
 8175:     base: start,
 8176:     extent: start.copyWith(offset: 1),
 8177:   );
 8178: }
 8179: 
 8180: DocumentSelection _collapsedTableCellTextSelection({
 8181:   required String tableBlockId,
 8182:   required int blockIndex,
 8183:   required int tableRowIndex,
 8184:   required int tableColumnIndex,
 8185:   required int offset,
 8186: }) {
 8187:   final position = DocumentPosition.tableCell(
 8188:     tableBlockId: tableBlockId,
 8189:     blockIndex: blockIndex,
 8190:     tableRowIndex: tableRowIndex,
 8191:     tableColumnIndex: tableColumnIndex,
 8192:     offset: offset,
 8193:   );
 8194:   return DocumentSelection(base: position, extent: position);
 8195: }
 8196: 
 8197: void _expectBlockTextSelection(
 8198:   DocumentSelection? selection, {
 8199:   required String blockId,
 8200:   required int blockIndex,
 8201:   required int baseOffset,
 8202:   required int extentOffset,
 8203: }) {
 8204:   expect(selection, isNotNull);
 8205:   expect(selection!.base.blockId, blockId);
 8206:   expect(selection.base.blockIndex, blockIndex);
 8207:   expect(selection.base.path, PositionPath.blockText(blockId));
 8208:   expect(selection.base.offset, baseOffset);
 8209:   expect(selection.extent.blockId, blockId);
 8210:   expect(selection.extent.blockIndex, blockIndex);
 8211:   expect(selection.extent.path, PositionPath.blockText(blockId));
 8212:   expect(selection.extent.offset, extentOffset);
 8213: }
 8214: 
 8215: void _expectTableCellTextSelection(
 8216:   DocumentSelection? selection, {
 8217:   required String tableBlockId,
 8218:   required int blockIndex,
 8219:   required int tableRowIndex,
 8220:   required int tableColumnIndex,
 8221:   required int baseOffset,
 8222:   required int extentOffset,
 8223: }) {
 8224:   expect(selection, isNotNull);
 8225:   final expectedPath = PositionPath.tableCellText(
 8226:     tableBlockId,
 8227:     tableRowIndex,
 8228:     tableColumnIndex,
 8229:   );
 8230:   expect(selection!.base.blockId, tableBlockId);
 8231:   expect(selection.base.blockIndex, blockIndex);
 8232:   expect(selection.base.path, expectedPath);
 8233:   expect(selection.base.offset, baseOffset);
 8234:   expect(selection.extent.blockId, tableBlockId);
 8235:   expect(selection.extent.blockIndex, blockIndex);
 8236:   expect(selection.extent.path, expectedPath);
 8237:   expect(selection.extent.offset, extentOffset);
 8238: }
