 8249: 
 8250: Future<void> pressIconButtonByTooltip(
 8251:   WidgetTester tester,
 8252:   String tooltip,
 8253: ) async {
 8254:   final tooltipFinder = find.byTooltip(tooltip);
 8255:   expect(tooltipFinder, findsOneWidget);
 8256:   final matchedWidget = tooltipFinder.evaluate().single.widget;
 8257:   final button = matchedWidget is IconButton
 8258:       ? matchedWidget
 8259:       : tester.widget<IconButton>(
 8260:           find.ancestor(
 8261:             of: tooltipFinder,
 8262:             matching: find.byType(IconButton),
 8263:           ),
 8264:         );
 8265:   expect(button.onPressed, isNotNull);
 8266:   button.onPressed!();
 8267:   await _pumpTableToolbarOverlay(tester);
 8268: }
