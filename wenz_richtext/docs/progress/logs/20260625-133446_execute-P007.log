7647: TextSpan? _leafSpan(TextSpan span, String text) {
7648:   final children = span.children;
7649:   if ((children == null || children.isEmpty) && span.text == text) {
7650:     return span;
7651:   }
7652:   for (final child in children ?? const <InlineSpan>[]) {
7653:     if (child is TextSpan) {
7654:       final match = _leafSpan(child, text);
7655:       if (match != null) {
7656:         return match;
7657:       }
7658:     }
7659:   }
7660:   return null;
7661: }
