8030: List<String> _underlinedTexts(InlineSpan span) {
8031:   final result = <String>[];
8032: 
8033:   void visit(InlineSpan current, TextStyle? inheritedStyle) {
8034:     if (current is! TextSpan) {
8035:       return;
8036:     }
8037:     final style = current.style ?? inheritedStyle;
8038:     final text = current.text;
8039:     if (text != null &&
8040:         text.isNotEmpty &&
8041:         style?.decoration?.contains(TextDecoration.underline) == true) {
8042:       result.add(text);
8043:     }
8044:     final children = current.children;
8045:     if (children != null) {
8046:       for (final child in children) {
8047:         visit(child, style);
8048:       }
8049:     }
8050:   }
8051: 
8052:   visit(span, null);
8053:   return result;
8054: }
