  testWidgets(
      'table floating toolbar pointer currently penetrates selection layer',
      (tester) async {
    final controller = WenzRichTextController(
      document: _toolbarTableDocument(),
      selection: _collapsedTableCellTextSelection(
        tableBlockId: 'table1',
        blockIndex: 0,
        tableRowIndex: 1,
        tableColumnIndex: 1,
        offset: 0,
      ),
    );

    await tester.pumpWidget(
      MaterialApp(
        home: Scaffold(
          body: SizedBox(
            width: 960,
            height: 360,
            child: WenzRichTextEditor(
              controller: controller,
              padding: const EdgeInsets.only(
                left: 16,
                top: 72,
                right: 16,
                bottom: 16,
              ),
              enableIme: false,
            ),
          ),
        ),
      ),
    );
    await tester.pump();

    final toolbarFinder =
        find.byKey(const ValueKey<String>('table-floating-toolbar'));
    final toolbarRenderObject = tester.renderObject(toolbarFinder);
    final toolbarRect = tester.getRect(toolbarFinder);
    final firstCellRect = tester.getRect(
      find.byKey(const ValueKey<String>('table-cell-border-table1-0-0')),
    );
    final buttonPoint = tester.getRect(find.byTooltip('在下方插入行')).center;

    expect(toolbarRect.bottom, lessThanOrEqualTo(firstCellRect.top));
    expect(firstCellRect.top - toolbarRect.bottom,
        moreOrLessEquals(4, epsilon: 0.1));

    final hitTargets = tester
        .hitTestOnBinding(buttonPoint)
        .path
        .map((entry) => entry.target)
        .toList();
    final hitTargetTypes =
        hitTargets.map((target) => target.runtimeType.toString()).toList();

    expect(
      hitTargets,
      isNot(contains(toolbarRenderObject)),
      reason: 'The visual toolbar is painted above the table Stack by a '
          'negative Positioned offset, outside its parent hit-test bounds.',
    );
    expect(
      hitTargetTypes,
      contains('RenderPointerListener'),
      reason: 'The editor-level SelectionGestureOverlay Listener remains in '
          'the hit-test chain for the same pointer.',
    );

    await tester.tapAt(buttonPoint);
    await tester.pump();

    final table = controller.document.blocks.single as TableBlockNode;
    expect(table.table.rowCount, 2);
    expect(controller.selection?.extent.path.tableRowIndex, 0);
    expect(controller.selection?.extent.path.tableColumnIndex, 0);
  });

