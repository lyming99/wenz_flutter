  testWidgets('sizes normal and tall inline formulas', (tester) async {
    final controller = WenzRichTextController(
      document: const RichTextDocument(
        blocks: <BlockNode>[
          TextBlockNode(
            id: 'formula-baseline',
            type: BlockType.paragraph,
            content: <InlineNode>[
              TextRun(text: 'Before '),
              InlineEmbed(
