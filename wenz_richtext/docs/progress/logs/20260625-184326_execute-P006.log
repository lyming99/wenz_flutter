 3408:   test('table floating toolbar ignores stale inactive anchor refresh', () {
 3409:     final controller = TableFloatingToolbarOverlayController();
 3410:     const activeRange = TableCellRange(
 3411:       tableBlockId: 'table2',
 3412:       blockIndex: 2,
 3413:       startRow: 0,
