 3415:       startColumn: 0,
 3416:       endColumn: 0,
 3417:     );
 3418: 
 3419:     TableFloatingToolbarOverlayRequest request({
 3420:       required Object owner,
 3421:       required String tableBlockId,
 3422:       required int blockIndex,
 3423:       required TableCellRange range,
 3424:       required Rect anchorRect,
 3425:     }) {
 3426:       return TableFloatingToolbarOverlayRequest(
 3427:         owner: owner,
 3428:         anchorLink: LayerLink(),
 3429:         anchorRect: anchorRect,
 3430:         visibleTop: 0,
 3431:         tableBlockId: tableBlockId,
 3432:         blockIndex: blockIndex,
 3433:         selectionRange: range,
 3434:         toolbarBuilder: (_) => const SizedBox.shrink(),
 3435:       );
 3436:     }
 3437: 
 3438:     final activeRequest = request(
 3439:       owner: Object(),
 3440:       tableBlockId: 'table2',
 3441:       blockIndex: 2,
 3442:       range: activeRange,
 3443:       anchorRect: const Rect.fromLTWH(20, 120, 100, 40),
 3444:     );
 3445:     controller.show(activeRequest);
 3446: 
 3447:     controller.show(
 3448:       request(
 3449:         owner: Object(),
 3450:         tableBlockId: 'table1',
 3451:         blockIndex: 0,
 3452:         range: const TableCellRange(
 3453:           tableBlockId: 'table1',
 3454:           blockIndex: 0,
 3455:           startRow: 0,
 3456:           endRow: 0,
 3457:           startColumn: 0,
 3458:           endColumn: 0,
 3459:         ),
 3460:         anchorRect: const Rect.fromLTWH(20, 20, 100, 40),
 3461:       ),
 3462:       replaceDifferentRequest: false,
 3463:     );
 3464:     expect(controller.request, same(activeRequest));
 3465: 
 3466:     final refreshedActiveRequest = request(
 3467:       owner: Object(),
