+RichTextDocument _scrollingToolbarTableDocument() {
+  return RichTextDocument(
+    blocks: <BlockNode>[
+      for (var i = 0; i < 4; i++)
+        TextBlockNode(
+          id: 'before-table-$i',
+          type: BlockType.paragraph,
+          content: <InlineNode>[TextRun(text: 'Before table $i')],
