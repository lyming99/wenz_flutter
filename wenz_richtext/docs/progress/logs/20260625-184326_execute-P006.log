 8352: Finder _richTextIgnoringCaret(String text) {
 8353:   return find.byWidgetPredicate(
 8354:     (widget) =>
 8355:         widget is RichText &&
 8356:         widget.text.toPlainText().replaceAll('\uFFFC', '') == text,
 8357:     description: 'RichText with plain text "$text" ignoring caret',
 8358:   );
 8359: }
 8360: 
 8361: double _richTextFirstLineCenterY(WidgetTester tester, Finder finder) {
 8362:   final firstLine = _richTextLineMetrics(tester, finder).first;
 8363:   return tester.getTopLeft(finder).dy +
 8364:       firstLine.baseline -
 8365:       firstLine.ascent +
 8366:       firstLine.height / 2;
 8367: }
 8368: 
 8369: double _richTextFirstLineHeight(WidgetTester tester, Finder finder) {
 8370:   return _richTextLineMetrics(tester, finder).first.height;
 8371: }
 8372: 
 8373: List<LineMetrics> _richTextLineMetrics(WidgetTester tester, Finder finder) {
 8374:   final richText = tester.widget<RichText>(finder);
 8375:   return _richTextPainter(tester, finder, richText).computeLineMetrics();
 8376: }
 8377: 
 8378: TextPainter _richTextPainter(
 8379:   WidgetTester tester,
 8380:   Finder finder,
 8381:   RichText richText,
 8382: ) {
 8383:   final size = tester.getSize(finder);
 8384:   return TextPainter(
 8385:     text: richText.text,
 8386:     textAlign: richText.textAlign,
 8387:     textDirection: TextDirection.ltr,
 8388:   )..layout(maxWidth: size.width);
 8389: }
