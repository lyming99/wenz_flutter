 5968: int _clampedTableSpan(int span, int start, int count) {
 5969:   final normalized = span < 1 ? 1 : span;
 5970:   final available = count - start;
 5971:   if (available <= 0) {
 5972:     return 1;
 5973:   }
 5974:   return normalized > available ? available : normalized;
 5975: }
 5976: 
 5977: List<double> _tableOffsets(List<double> sizes) {
 5978:   var offset = 0.0;
 5979:   final offsets = <double>[];
 5980:   for (final size in sizes) {
 5981:     offsets.add(offset);
 5982:     offset += size;
 5983:   }
 5984:   return offsets;
 5985: }
 5986: 
 5987: double _sumTableRange(List<double> values, int start, int count) {
 5988:   var result = 0.0;
 5989:   final end = start + count;
 5990:   for (var i = start; i < end && i < values.length; i++) {
 5991:     result += values[i];
 5992:   }
 5993:   return result;
 5994: }
