  627:   @override
  628:   void didUpdateWidget(covariant WenzRichTextEditor oldWidget) {
  629:     super.didUpdateWidget(oldWidget);
  630:     if (oldWidget.controller != widget.controller) {
  631:       oldWidget.controller.removeListener(_handleControllerChanged);
  632:       oldWidget.controller.attachFocusNode(null);
  633:       widget.controller.addListener(_handleControllerChanged);
  634:       _extentCache.clear();
  635:     } else if (oldWidget.textStyle != widget.textStyle ||
  636:         oldWidget.blockRenderers != widget.blockRenderers ||
  637:         oldWidget.mediaResolver != widget.mediaResolver ||
  638:         oldWidget.inlineEmbedRenderer != widget.inlineEmbedRenderer ||
  639:         oldWidget.findController != widget.findController ||
  640:         oldWidget.slashMenuController != widget.slashMenuController) {
  641:       _extentCache.clear();
  642:     }
  643:     if (oldWidget.findController != widget.findController) {
  644:       oldWidget.findController?.removeListener(_handleFindControllerChanged);
  645:       widget.findController?.addListener(_handleFindControllerChanged);
  646:     }
  647:     if (oldWidget.slashMenuController != widget.slashMenuController) {
  648:       oldWidget.slashMenuController?.removeListener(_handleSlashMenuChanged);
  649:       widget.slashMenuController?.attachEditor(widget.controller);
  650:       widget.slashMenuController?.addListener(_handleSlashMenuChanged);
  651:     } else if (oldWidget.controller != widget.controller) {
  652:       widget.slashMenuController?.attachEditor(widget.controller);
  653:     }
  654:     if (oldWidget.outlineController != widget.outlineController) {
  655:       oldWidget.outlineController?.removeListener(
  656:         _handleOutlineControllerChanged,
  657:       );
  658:       widget.outlineController?.addListener(_handleOutlineControllerChanged);
  659:       _syncFindControllerOutline();
  660:       _handleOutlineControllerChanged();
  661:     } else if (oldWidget.findController != widget.findController) {
  662:       _syncFindControllerOutline();
  663:     }
  664:     // The effective focus node may change when the caller swaps focusNode or
  665:     // controller; re-inject so controller.requestFocus() targets the right node.
  666:     final focusNode = _effectiveFocusNode;
  667:     if (focusNode != _controllerAttachedFocusNode) {
  668:       widget.controller.attachFocusNode(focusNode);
  669:       _controllerAttachedFocusNode = focusNode;
  670:     }
  671:     _hideStaleTableToolbarOverlay();
  672:   }
  673: 
  674:   @override
  675:   void dispose() {
  676:     widget.controller.removeListener(_handleControllerChanged);
  677:     widget.findController?.removeListener(_handleFindControllerChanged);
  678:     widget.slashMenuController?.removeListener(_handleSlashMenuChanged);
  679:     widget.outlineController?.removeListener(_handleOutlineControllerChanged);
  680:     // Release the focus node from the controller so a later requestFocus() on
  681:     // a disposed editor is a safe no-op. Only clear when this widget was the
  682:     // one that injected it.
  683:     if (_controllerAttachedFocusNode != null) {
  684:       widget.controller.attachFocusNode(null);
  685:     }
  686:     _controllerAttachedFocusNode = null;
  687:     _listenedFocusNode?.removeListener(_handleFocusChanged);
  688:     _inputClient.performSelectorHandler = null;
  689:     _inputClient.detach();
  690:     _tableToolbarOverlayController.hide();
  691:     _tableToolbarOverlayController.dispose();
  692:     _scrollController.dispose();
  693:     // BlockGeometryRegistry holds no native resources; clearing its maps is
  694:     // unnecessary once the editor is gone.
  695:     _layoutCache.dispose();
  696:     _internalFocusNode?.dispose();
  697:     super.dispose();
  698:   }
