  713:   void _handleOutlineControllerChanged() {
  714:     if (!mounted) {
  715:       return;
  716:     }
  717:     _revealCurrentSelectionIfHidden();
  718:     _lastScrollCheckedCaret = null;
  719:     _scrollRealignDepth = 0;
