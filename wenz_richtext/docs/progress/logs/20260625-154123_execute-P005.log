 6210: String _tableCellSemanticsLabel({
 6211:   required TableBlockNode tableBlock,
 6212:   required TableCellNode? cell,
 6213:   required int rowIndex,
 6214:   required int columnIndex,
 6215:   required bool selected,
 6216: }) {
 6217:   final parts = <String>[
 6218:     'Table cell row ${rowIndex + 1} column ${columnIndex + 1}',
 6219:   ];
 6220:   if (cell?.isHeader ?? false) {
 6221:     parts.add('header');
 6222:   }
 6223:   if (cell != null) {
 6224:     final rowSpan = _clampedTableSpan(
 6225:       cell.rowSpan,
 6226:       rowIndex,
 6227:       tableBlock.table.rowCount,
 6228:     );
 6229:     final columnSpan = _clampedTableSpan(
 6230:       cell.columnSpan,
 6231:       columnIndex,
 6232:       tableBlock.table.columnCount,
 6233:     );
 6234:     if (rowSpan > 1) {
 6235:       parts.add('spans $rowSpan rows');
 6236:     }
 6237:     if (columnSpan > 1) {
 6238:       parts.add('spans $columnSpan columns');
 6239:     }
 6240:   }
 6241:   if (selected) {
 6242:     parts.add('selected');
 6243:   }
 6244:   return parts.join(', ');
 6245: }
