  558:   @override
  559:   void initState() {
  560:     super.initState();
  561:     _inputClient = EditorTextInputClient(widget.controller);
  562:     // The IME bridge asks the widget layer for the caret's global rect so the
  563:     // platform can position its candidate window (e.g. pinyin) at the caret.
  564:     _inputClient.caretRectProvider = () {
  565:       final selection = widget.controller.selection;
  566:       if (selection == null || !selection.isCollapsed) {
  567:         return null;
  568:       }
  569:       return _registry.caretRectForPosition(selection.extent);
  570:     };
  571:     _inputClient.textInputGeometryProvider = () {
  572:       final selection = widget.controller.selection;
  573:       if (selection == null || !selection.isCollapsed) {
  574:         return null;
  575:       }
  576:       final position = selection.extent;
  577:       final composition = widget.controller.compositionState;
  578:       final composingRange = composition != null &&
  579:               composition.blockId == position.blockId &&
  580:               composition.blockIndex == position.blockIndex &&
  581:               composition.path == position.path &&
  582:               !composition.isEmpty
  583:           ? TextRange(
  584:               start: composition.startOffset,
  585:               end: composition.endOffset,
  586:             )
  587:           : null;
  588:       final geometry = _registry.textInputGeometryForPosition(
  589:         position,
  590:         composingRange: composingRange,
  591:       );
  592:       if (geometry == null) {
  593:         return null;
  594:       }
  595:       return EditorTextInputGeometry(
  596:         editableSize: geometry.editableSize,
  597:         transform: geometry.transform,
  598:         caretRect: geometry.caretRect,
  599:         composingRect: geometry.composingRect,
  600:         globalCaretRect: geometry.globalCaretRect,
  601:       );
  602:     };
  603:     // The platform text-input engine rejects a client whose configuration has
  604:     // no viewId (Android throws "view ID is null"). We resolve the current view
  605:     // lazily via the mounted BuildContext so the id stays correct across view
  606:     // reparenting / multi-window.
  607:     _inputClient.viewIdProvider = _resolveViewId;
  608:     _inputClient.performSelectorHandler = _handlePlatformSelector;
  609:     widget.controller.addListener(_handleControllerChanged);
  610:     widget.findController?.addListener(_handleFindControllerChanged);
  611:     widget.slashMenuController?.attachEditor(widget.controller);
  612:     widget.slashMenuController?.addListener(_handleSlashMenuChanged);
  613:     widget.outlineController?.addListener(_handleOutlineControllerChanged);
  614:     _syncFindControllerOutline();
  615:     _revealCurrentSelectionIfHidden();
  616:     // Expose the focus node to the controller so controller.requestFocus() can
  617:     // drive focus. Updated in _syncFocusListener (which runs each build and on
  618:     // controller/focusNode change).
  619:     final focusNode = _effectiveFocusNode;
  620:     widget.controller.attachFocusNode(focusNode);
  621:     _controllerAttachedFocusNode = focusNode;
  622:     // Ensure owned defaults are installed eagerly when no external registry is
  623:     // provided, mirroring the lazy getter above.
  624:     _blockRenderers;
  625:   }
