 5996: bool _shouldHighlightTableCell(
 5997:   DocumentSelection? selection,
 5998:   String tableBlockId,
 5999:   int blockIndex,
 6000:   int rowIndex,
 6001:   int columnIndex,
 6002: ) {
 6003:   if (selection == null || selection.isCollapsed) {
 6004:     return false;
 6005:   }
 6006:   // Intra-table cell range (drag within the table): highlight cells inside the
 6007:   // range via the structured TableCellRange.
 6008:   final range = selection.tableCellRange;
 6009:   if (range != null) {
 6010:     if (range.isSingleCell) {
 6011:       return false;
 6012:     }
 6013:     return range.tableBlockId == tableBlockId &&
 6014:         range.blockIndex == blockIndex &&
 6015:         range.containsCell(rowIndex, columnIndex);
 6016:   }
 6017:   // Cross-block selection that spans this table block (e.g. select-all across
 6018:   // a paragraph + table): when the table block sits strictly between the
 6019:   // selection endpoints, every cell is part of the selection and highlights.
 6020:   final start = selection.start;
 6021:   final end = selection.end;
 6022:   final tableCovered =
 6023:       start.blockIndex < blockIndex && end.blockIndex > blockIndex;
 6024:   if (tableCovered) {
 6025:     return true;
 6026:   }
 6027:   final cellPath = PositionPath.tableCellText(
 6028:     tableBlockId,
 6029:     rowIndex,
 6030:     columnIndex,
 6031:   );
 6032:   if (start.blockIndex == blockIndex &&
 6033:       start.path.isTableCellText &&
 6034:       end.blockIndex > blockIndex) {
 6035:     return start.blockId == tableBlockId && cellPath.compare(start.path) > 0;
 6036:   }
 6037:   if (end.blockIndex == blockIndex &&
 6038:       end.path.isTableCellText &&
 6039:       start.blockIndex < blockIndex) {
 6040:     return end.blockId == tableBlockId && cellPath.compare(end.path) < 0;
 6041:   }
 6042:   return false;
 6043: }
