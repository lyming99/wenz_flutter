  728:   void _handleControllerChanged() {
  729:     if (mounted) {
  730:       _hideStaleTableToolbarOverlay();
  731:       if (_revealCurrentSelectionIfHidden()) {
  732:         _lastScrollCheckedCaret = null;
  733:         _scrollRealignDepth = 0;
  734:       }
  735:       // Drop the cached laid-out painter for blocks whose content changed so a
  736:       // stale painter is not reused on the next build. Selection-only /
  737:       // composition-only changes (empty set) do not invalidate anything.
  738:       //
  739:       // The block *extent* cache is intentionally NOT invalidated here. While a
  740:       // block's text is being edited (most acutely during IME composition such
  741:       // as pinyin input) its content mutates on every keystroke, but its height
  742:       // barely changes. Dropping the cached height mid-edit would fall back to
  743:       // the document-wide average height for one frame, repositioning every
  744:       // following block — a visible flicker of the content below the caret. The
  745:       // real (possibly unchanged) height is reconciled on the next frame by the
  746:       // measured-block widget, so leaving the stale value yields one frame of a
  747:       // near-correct height instead of one frame of a wrong average.
  748:       final dirty = widget.controller.lastChangedBlockIds;
  749:       if (dirty == null) {
  750:         _extentCache.clear();
  751:       } else if (dirty.isNotEmpty) {
  752:         for (final id in dirty) {
  753:           _layoutCache.removeBlock(id);
  754:         }
  755:       }
  756:       // Keep the platform IME candidate window anchored at the caret, and
  757:       // scroll a programmatically-moved caret back into view. Both run in a
  758:       // post-frame callback so the caret's render box reflects the latest
  759:       // selection (and any keep-alive mount) before we read its global rect.
  760:       WidgetsBinding.instance.addPostFrameCallback((_) {
