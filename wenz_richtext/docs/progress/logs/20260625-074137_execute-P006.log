6791: class _ObjectBlockToolbar extends StatelessWidget {
6792:   const _ObjectBlockToolbar({
6793:     required this.blockIndex,
6794:     required this.canEdit,
6795:     required this.imageActions,
6796:     required this.fileActions,
6797:     this.onAction,
6798:   });
6799: 
6800:   final int blockIndex;
6801:   final bool canEdit;
6802:   final bool imageActions;
6803:   final bool fileActions;
6804:   final ObjectBlockActionHandler? onAction;
6805: 
6806:   @override
6807:   Widget build(BuildContext context) {
6808:     return Wrap(
6809:       spacing: 2,
6810:       crossAxisAlignment: WrapCrossAlignment.center,
6811:       children: <Widget>[
6812:         _ObjectActionButton(
6813:           icon: Icons.copy,
6814:           tooltip: '复制块引用',
6815:           onPressed: () => _dispatch(ObjectBlockAction.copyReference),
6816:         ),
6817:         if (canEdit) ...<Widget>[
6818:           _ObjectActionButton(
6819:             icon: Icons.content_copy,
6820:             tooltip: '创建块副本',
6821:             onPressed: () => _dispatch(ObjectBlockAction.duplicate),
6822:           ),
6823:           _ObjectActionButton(
6824:             icon: Icons.keyboard_arrow_up,
6825:             tooltip: '上移块',
6826:             onPressed: () => _dispatch(ObjectBlockAction.moveUp),
6827:           ),
6828:           _ObjectActionButton(
6829:             icon: Icons.keyboard_arrow_down,
6830:             tooltip: '下移块',
6831:             onPressed: () => _dispatch(ObjectBlockAction.moveDown),
6832:           ),
6833:           if (imageActions) _ImageSizeMenu(onSelected: _setImageWidth),
6834:           if (imageActions)
6835:             _ObjectActionButton(
6836:               icon: Icons.aspect_ratio,
6837:               tooltip: '重置图片尺寸',
6838:               onPressed: () => _dispatch(ObjectBlockAction.resetImageSize),
6839:             ),
6840:           if (fileActions) _FileStatusMenu(onSelected: _setFileStatus),
6841:           _ObjectActionButton(
6842:             icon: Icons.delete_outline,
6843:             tooltip: '删除块',
6844:             onPressed: () => _dispatch(ObjectBlockAction.delete),
6845:           ),
6846:         ],
6847:       ],
6848:     );
6849:   }
6850: 
6851:   void _dispatch(ObjectBlockAction action, [Object? value]) {
6852:     onAction?.call(
6853:       ObjectBlockActionIntent(
6854:         action: action,
6855:         blockIndex: blockIndex,
6856:         value: value,
6857:       ),
6858:     );
6859:   }
6860: 
6861:   void _setImageWidth(double width) {
6862:     _dispatch(ObjectBlockAction.setImageDisplayWidth, width);
6863:   }
6864: 
6865:   void _setFileStatus(FileUploadStatus status) {
6866:     final action = switch (status) {
6867:       FileUploadStatus.uploading => ObjectBlockAction.markFileUploading,
6868:       FileUploadStatus.uploaded => ObjectBlockAction.markFileUploaded,
6869:       FileUploadStatus.failed => ObjectBlockAction.markFileFailed,
6870:       FileUploadStatus.none ||
6871:       FileUploadStatus.pending =>
6872:         ObjectBlockAction.markFileUploading,
6873:     };
6874:     _dispatch(action);
6875:   }
6876: }
