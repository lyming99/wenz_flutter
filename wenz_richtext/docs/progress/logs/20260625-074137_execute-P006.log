+String _fileSubtitle(FileBlockNode file) {
+  final parts = <String>[];
+  final mimeType = file.mimeType.trim();
+  if (mimeType.isNotEmpty) {
+    parts.add(mimeType);
+  }
+  return parts.join(' · ');
+}
