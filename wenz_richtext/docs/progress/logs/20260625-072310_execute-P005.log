+}) {
+  final fallback = fallbackText.trim();
+  if (fallback.isNotEmpty) {
+    return fallback;
+  }
+  for (final key in const <String>['text', 'latex', 'value', 'formula']) {
+    final value = data[key];
+    if (value != null && value.toString().trim().isNotEmpty) {
+      return value.toString().trim();
+    }
+  }
+  return '';
+}
