8067:/// Maps a [CompositionState] to a local offset range when it targets the given
8068:/// block/path, otherwise returns null.
8069:_LocalSelectionRange? _localCompositionRange(
8070:  CompositionState? state,
8071:  String blockId,
8072:  int blockIndex,
8073:  PositionPath path,
8074:) {
8075:  if (state == null ||
8076:      state.blockId != blockId ||
8077:      state.blockIndex != blockIndex ||
8078:      state.path != path ||
8079:      state.isEmpty) {
8080:    return null;
8081:  }
8082:  return _LocalSelectionRange(
8083:    start: state.startOffset,
8084:    end: state.endOffset,
8085:  );

