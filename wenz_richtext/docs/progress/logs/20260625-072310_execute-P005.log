312:/// Maps [BlockType]s and custom [BlockEmbedNode.embedType]s to
313:/// [BlockRendererBuilder]s. The editor consults this registry to paint each
314:/// block; built-in types ship with default builders, and plugins override or
315:/// extend them via [register] / [registerEmbed].
316:///
317:/// The registry is an indirection point: it lets a consumer replace how a given
318:/// block type renders (e.g. a custom image block with a real decoder) or how a
319:/// business embed type renders without forking the editor widget.
320:///
321:/// To start from the built-in defaults, construct the registry and then call
322:/// [WenzRichTextEditor.installDefaultRenderers]; or use the editor's
323:/// [WenzRichTextEditor.blockRenderers] parameter — when omitted the editor
324:/// builds a private registry with the defaults already installed.
325:class BlockRendererRegistry {
326:  BlockRendererRegistry({
327:    Map<BlockType, BlockRendererBuilder> builders =
328:        const <BlockType, BlockRendererBuilder>{},
329:    Map<String, BlockRendererBuilder> embedBuilders =
330:        const <String, BlockRendererBuilder>{},
331:  }) {
332:    _builders.addAll(builders);
333:    _embedBuilders.addAll(embedBuilders);
334:  }
335:
336:  final Map<BlockType, BlockRendererBuilder> _builders =
337:      <BlockType, BlockRendererBuilder>{};
338:  final Map<String, BlockRendererBuilder> _embedBuilders =
339:      <String, BlockRendererBuilder>{};
340:
341:  /// Registered block types in insertion order.
342:  Iterable<BlockType> get blockTypes => _builders.keys;
343:
344:  /// Registered custom block embed types in insertion order.
345:  Iterable<String> get embedTypes => _embedBuilders.keys;
346:
347:  /// Registers [builder] for [type], replacing any existing builder for that
348:  /// type. Returning the previous builder (if any) lets callers chain or wrap
349:  /// the default renderer.
350:  BlockRendererBuilder? register(BlockType type, BlockRendererBuilder builder) {
351:    final previous = _builders[type];
352:    _builders[type] = builder;
353:    return previous;
354:  }
355:
356:  /// Removes the builder for [type], if any. The editor falls back to its
357:  /// plain-text default for that type.
358:  void unregister(BlockType type) {
359:    _builders.remove(type);
360:  }
361:
362:  /// Returns the builder for [type], falling back to [fallback] when none is
363:  /// registered. The editor passes a plain-text fallback so unknown block types
364:  /// always render *something*.
365:  BlockRendererBuilder resolve(
366:    BlockType type, {
367:    required BlockRendererBuilder fallback,
368:  }) {
369:    return _builders[type] ?? fallback;
370:  }
371:
372:  /// Whether a builder is registered for [type].
373:  bool has(BlockType type) => _builders.containsKey(type);
374:
375:  /// Registers [builder] for a custom [BlockEmbedNode.embedType]. Returning the
376:  /// previous builder lets callers chain or wrap an existing business renderer.
377:  BlockRendererBuilder? registerEmbed(
378:    String embedType,
379:    BlockRendererBuilder builder,
380:  ) {
381:    final previous = _embedBuilders[embedType];
382:    _embedBuilders[embedType] = builder;
383:    return previous;
384:  }
385:
386:  /// Removes the builder for [embedType], if any. The editor then falls back to
387:  /// the generic [BlockType.embed] renderer.
388:  void unregisterEmbed(String embedType) {
389:    _embedBuilders.remove(embedType);
390:  }

