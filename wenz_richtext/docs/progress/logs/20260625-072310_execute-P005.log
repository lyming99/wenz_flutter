7281:Color _calloutTint(ThemeData theme, String variant) {
7282:  final scheme = theme.colorScheme;
7283:  switch (CalloutBlockNode.normalizeVariant(variant)) {
7284:    case CalloutBlockNode.successVariant:
7285:      return scheme.tertiaryContainer.withAlpha(90);
7286:    case 'warning':
7287:      return Colors.amber
7288:          .withAlpha(theme.brightness == Brightness.dark ? 64 : 48);
7289:    case CalloutBlockNode.dangerVariant:
7290:      return scheme.errorContainer.withAlpha(90);
7291:    case CalloutBlockNode.infoVariant:
7292:    default:
7293:      return scheme.surfaceContainerHighest;
7294:  }
7295:}
7296:
7297:Color _calloutForeground(ThemeData theme, String variant) {
7298:  final scheme = theme.colorScheme;
7299:  switch (CalloutBlockNode.normalizeVariant(variant)) {
7300:    case CalloutBlockNode.successVariant:
7301:      return scheme.onTertiaryContainer;
7302:    case CalloutBlockNode.warningVariant:
7303:      return theme.brightness == Brightness.dark
7304:          ? Colors.amber.shade200
7305:          : Colors.amber.shade900;
7306:    case CalloutBlockNode.dangerVariant:
7307:      return scheme.onErrorContainer;
7308:    case CalloutBlockNode.infoVariant:
7309:    default:
7310:      return scheme.onSurfaceVariant;
7311:  }
7312:}
7313:
7314:Color _calloutBorder(ThemeData theme, String variant) {
7315:  return _calloutForeground(theme, variant).withAlpha(80);
7316:}
