6692:  void _dispatch(ObjectBlockAction action, [Object? value]) {
6693:    onAction?.call(
6694:      ObjectBlockActionIntent(
6695:        action: action,
6696:        blockIndex: blockIndex,
6697:        value: value,
6698:      ),
6699:    );
6700:  }
6701:
6702:  void _setImageWidth(double width) {
6703:    _dispatch(ObjectBlockAction.setImageDisplayWidth, width);
6704:  }
6705:
6706:  void _setFileStatus(FileUploadStatus status) {
6707:    final action = switch (status) {
6708:      FileUploadStatus.uploading => ObjectBlockAction.markFileUploading,
6709:      FileUploadStatus.uploaded => ObjectBlockAction.markFileUploaded,
6710:      FileUploadStatus.failed => ObjectBlockAction.markFileFailed,
6711:      FileUploadStatus.none ||
6712:      FileUploadStatus.pending =>
6713:        ObjectBlockAction.markFileUploading,
6714:    };
6715:    _dispatch(action);
6716:  }
6717:}
