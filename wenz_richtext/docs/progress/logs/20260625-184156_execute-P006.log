            content: <InlineNode>[
              TextRun(text: 'plain'),
              TextRun(text: ' '),
              TextRun(
                text: 'bold',
                attributes: TextAttributes(bold: true),
              ),
              TextRun(text: ' '),
              TextRun(
                text: 'italic',
                attributes: TextAttributes(italic: true),
              ),
