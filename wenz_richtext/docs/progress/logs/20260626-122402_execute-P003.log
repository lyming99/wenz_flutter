 3193: class _BlockExtentCache {
 3194:   final Map<String, double> _extents = <String, double>{};
 3195:   final Map<String, int> _blockVersions = <String, int>{};
 3196:   Set<String> _knownBlockIds = <String>{};
 3197:   int _epoch = 0;
 3198:   double? _contentWidth;
 3199: 
 3200:   void clear() {
 3201:     _epoch += 1;
 3202:     _extents.clear();
 3203:   }
 3204: 
 3205:   void updateContentWidth(double? width) {
 3206:     if (width == null || !width.isFinite || width < 0) {
 3207:       return;
 3208:     }
 3209:     final previous = _contentWidth;
 3210:     if (previous != null && (previous - width).abs() <= 0.5) {
 3211:       return;
 3212:     }
 3213:     _contentWidth = width;
 3214:     clear();
 3215:   }
 3216: 
 3217:   void removeBlock(String blockId) {
 3218:     _extents.remove(blockId);
 3219:     _blockVersions[blockId] = (_blockVersions[blockId] ?? 0) + 1;
 3220:   }
 3221: 
 3222:   void retainBlocks(List<BlockNode> blocks) {
 3223:     final ids = blocks.map((block) => block.id).toSet();
 3224:     for (final id in _knownBlockIds.difference(ids)) {
 3225:       removeBlock(id);
 3226:     }
 3227:     _knownBlockIds = ids;
 3228:     _extents.removeWhere((id, _) => !ids.contains(id));
 3229:   }
 3230: 
 3231:   int tokenFor(String blockId) {
 3232:     return Object.hash(_epoch, _blockVersions[blockId] ?? 0);
 3233:   }
 3234: 
 3235:   bool record(String blockId, int token, double extent) {
 3236:     if (token != tokenFor(blockId)) {
 3237:       return false;
 3238:     }
 3239:     if (!extent.isFinite || extent <= 0) {
 3240:       return false;
 3241:     }
 3242:     final previous = _extents[blockId];
 3243:     if (previous != null && (previous - extent).abs() <= 0.5) {
 3244:       return false;
 3245:     }
 3246:     _extents[blockId] = extent;
 3247:     return true;
 3248:   }
 3249: 
 3250:   double get averageExtent {
 3251:     if (_extents.isEmpty) {
 3252:       return _kDefaultBlockExtent;
 3253:     }
 3254:     final total = _extents.values.fold<double>(0, (sum, h) => sum + h);
 3255:     return total / _extents.length;
 3256:   }
 3257: 
 3258:   double extentFor(BlockNode block) {
 3259:     return _extents[block.id] ?? averageExtent;
 3260:   }

