 1447:   Offset _slashMenuOffset() {
 1448:     final fallback = widget.padding.resolve(TextDirection.ltr).topLeft;
 1449:     final selection = widget.controller.selection;
 1450:     final overlayContext = _editorOverlayKey.currentContext;
 1451:     final overlayBox = overlayContext?.findRenderObject();
 1452:     if (selection == null ||
 1453:         !selection.isCollapsed ||
 1454:         overlayBox is! RenderBox ||
 1455:         !overlayBox.hasSize) {
 1456:       return fallback;
 1457:     }
 1458:     final caret = _registry.caretRectForPosition(selection.extent);
 1459:     if (caret == null) {
 1460:       return fallback;
 1461:     }
 1462:     final local = overlayBox.globalToLocal(caret.bottomLeft);
 1463:     final maxLeft =
 1464:         overlayBox.size.width - _kPopupMenuMinWidth - _kPopupViewportInset;
 1465:     final maxTop = overlayBox.size.height - _kPopupViewportInset;
 1466:     return Offset(
 1467:       local.dx.clamp(0, maxLeft > 0 ? maxLeft : 0).toDouble(),
 1468:       (local.dy + _kSlashMenuGap).clamp(0, maxTop > 0 ? maxTop : 0).toDouble(),
 1469:     );
 1470:   }
