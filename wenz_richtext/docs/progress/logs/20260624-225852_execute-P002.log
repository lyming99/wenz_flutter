4`t/// Single-block text layout cache.
5`t///
6`t/// Wraps a [TextPainter] and caches the laid-out instance keyed by
7`t/// `(span, textAlign, direction, maxWidth)`. Consumers within a single
8`t/// `_TextSelectionSurface` call [layout] repeatedly (caret placement, hit
9`t/// testing, selection boxes, painting) for the same content each frame;
10`t/// caching avoids re-creating and re-laying-out the painter on every call.
11`t///
12`t/// Scope (stage 0): single block only. Cross-block selection layout is a
13`t/// stage 2 concern. This class is internal — it is not exported from the
14`t/// public package API until the layout layer stabilises.
15`t@internal
16`tclass TextLayoutService {
17`t  TextLayoutData? _cache;
18`t
19`t  /// Returns a laid-out [TextPainter] for the given inputs, reusing a cached
20`t  /// instance when all inputs match.
21`t  TextPainter layout({
22`t    required InlineSpan span,
23`t    required TextAlign textAlign,
24`t    required TextDirection textDirection,
25`t    required double maxWidth,
26`t  }) {
27`t    final cache = _cache;
28`t    if (cache != null &&
29`t        cache.span == span &&
30`t        cache.textAlign == textAlign &&
31`t        cache.textDirection == textDirection &&
32`t        cache.maxWidth == maxWidth) {
33`t      return cache.painter;
34`t    }
35`t    final painter = TextPainter(
36`t      text: span,
37`t      textAlign: textAlign,
38`t      textDirection: textDirection,
39`t    )..layout(maxWidth: maxWidth);
40`t    _cache = TextLayoutData(
41`t      span: span,
42`t      textAlign: textAlign,
43`t      textDirection: textDirection,
44`t      maxWidth: maxWidth,
45`t      painter: painter,
46`t    );
47`t    return painter;
48`t  }
