127	  /// position is computed from that block's *text-local* coordinates — the
128	  /// hit-test local offset is first translated through the entry's
129	  /// [BlockEntry.hitLocalToTextLocal] so padding/centring offsets are stripped.
130	  /// Otherwise the nearest block is chosen by 2-D rect proximity and the caret
131	  /// is clamped to that block's start or end — so a drag into the gap between
132	  /// blocks (or beyond the last block) still extends the selection predictably.
133	  DocumentPosition? positionFromGlobalOffset(Offset global) {
134	    BlockEntry? hitEntry;
135	    Offset? hitTextLocal;
136	    var nearestHitDelta = double.infinity;
137	    for (final entry in _entries) {
138	      final box = entry.hitTestBox;
139	      if (box == null) {
140	        continue;
141	      }
142	      final local = box.globalToLocal(global);
143	      if (local.dx >= 0 &&
144	          local.dx <= box.size.width &&
145	          local.dy >= 0 &&
146	          local.dy <= box.size.height) {
147	        final rect = box.localToGlobal(Offset.zero) & box.size;
148	        final delta = (global - rect.center).distanceSquared;
149	        if (delta < nearestHitDelta) {
