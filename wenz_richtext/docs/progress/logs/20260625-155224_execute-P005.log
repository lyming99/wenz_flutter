 1196:   void _handleTableToolbarAction(TableToolbarActionIntent intent) {
 1197:     final tableBlock = _tableBlockAt(intent.blockIndex);
 1198:     if (tableBlock == null) {
 1199:       return;
 1200:     }
 1201: 
 1202:     final range = _currentTableRange(tableBlock, intent) ??
 1203:         TableCellRange(
 1204:           tableBlockId: tableBlock.id,
 1205:           blockIndex: intent.blockIndex,
 1206:           startRow: intent.rowIndex,
 1207:           endRow: intent.targetEndRowIndex,
 1208:           startColumn: intent.columnIndex,
 1209:           endColumn: intent.targetEndColumnIndex,
 1210:         );
 1211: 
 1212:     switch (intent.action) {
 1213:       case TableToolbarAction.insertRowAbove:
 1214:         widget.controller.insertTableRow(
 1215:           blockIndex: intent.blockIndex,
 1216:           rowIndex: range.startRow,
 1217:         );
 1218:         return;
 1219:       case TableToolbarAction.insertRowBelow:
 1220:         widget.controller.insertTableRow(
 1221:           blockIndex: intent.blockIndex,
 1222:           rowIndex: range.endRow + 1,
 1223:         );
 1224:         return;
 1225:       case TableToolbarAction.deleteRow:
 1226:         for (var row = range.endRow; row >= range.startRow; row--) {
 1227:           final current = _tableBlockAt(intent.blockIndex);
 1228:           if (current == null || current.table.rowCount <= 1) {
 1229:             break;
 1230:           }
 1231:           widget.controller.deleteTableRow(
 1232:             blockIndex: intent.blockIndex,
 1233:             rowIndex: row,
 1234:           );
 1235:         }
 1236:         return;
 1237:       case TableToolbarAction.insertColumnBefore:
 1238:         widget.controller.insertTableColumn(
 1239:           blockIndex: intent.blockIndex,
 1240:           columnIndex: range.startColumn,
 1241:         );
 1242:         return;
 1243:       case TableToolbarAction.insertColumnAfter:
 1244:         widget.controller.insertTableColumn(
 1245:           blockIndex: intent.blockIndex,
 1246:           columnIndex: range.endColumn + 1,
 1247:         );
 1248:         return;
 1249:       case TableToolbarAction.deleteColumn:
 1250:         for (var column = range.endColumn;
 1251:             column >= range.startColumn;
 1252:             column--) {
 1253:           final current = _tableBlockAt(intent.blockIndex);
 1254:           if (current == null || current.table.columnCount <= 1) {
 1255:             break;
 1256:           }
 1257:           widget.controller.deleteTableColumn(
 1258:             blockIndex: intent.blockIndex,
 1259:             columnIndex: column,
 1260:           );
 1261:         }
 1262:         return;
 1263:       case TableToolbarAction.toggleHeader:
 1264:         final anchor = _firstVisibleTableCell(tableBlock, range);
 1265:         if (anchor == null) {
 1266:           return;
 1267:         }
 1268:         final nextHeader = !anchor.isHeader;
 1269:         _forEachVisibleTableCell(tableBlock, range, (row, column) {
 1270:           widget.controller.setTableCellHeader(
 1271:             blockIndex: intent.blockIndex,
 1272:             rowIndex: row,
 1273:             columnIndex: column,
 1274:             isHeader: nextHeader,
 1275:           );
 1276:         });
 1277:         return;
 1278:       case TableToolbarAction.setBackgroundColor:
 1279:         _forEachVisibleTableCell(tableBlock, range, (row, column) {
 1280:           widget.controller.setTableCellBackground(
 1281:             blockIndex: intent.blockIndex,
 1282:             rowIndex: row,
 1283:             columnIndex: column,
 1284:             backgroundColor: intent.backgroundColor,
 1285:           );
 1286:         });
 1287:         return;
 1288:       case TableToolbarAction.clearBackgroundColor:
 1289:         _forEachVisibleTableCell(tableBlock, range, (row, column) {
 1290:           widget.controller.setTableCellBackground(
 1291:             blockIndex: intent.blockIndex,
 1292:             rowIndex: row,
 1293:             columnIndex: column,
 1294:             backgroundColor: null,
 1295:           );
 1296:         });
 1297:         return;
 1298:       case TableToolbarAction.alignLeft:
 1299:         _setTableColumnAlignment(intent.blockIndex, range, 'left');
 1300:         return;
 1301:       case TableToolbarAction.alignCenter:
 1302:         _setTableColumnAlignment(intent.blockIndex, range, 'center');
 1303:         return;
 1304:       case TableToolbarAction.alignRight:
 1305:         _setTableColumnAlignment(intent.blockIndex, range, 'right');
 1306:         return;
 1307:       case TableToolbarAction.clearAlignment:
 1308:         _setTableColumnAlignment(intent.blockIndex, range, null);
 1309:         return;
 1310:       case TableToolbarAction.mergeCells:
 1311:         if (!range.isSingleCell) {
