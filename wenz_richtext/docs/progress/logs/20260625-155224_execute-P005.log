 1158:   bool _handleTapBeyondContent(Offset _) {
 1159:     if (widget.readOnly) {
 1160:       return false;
 1161:     }
 1162:     final blocks = widget.controller.document.blocks;
 1163:     if (blocks.isEmpty) {
 1164:       return false;
 1165:     }
 1166:     final last = blocks.last;
 1167:     if (last is TextBlockNode || last is CodeBlockNode) {
 1168:       return false;
 1169:     }
 1170: 
 1171:     final nextBlockId = _nextBlockId();
 1172:     final nextBlockIndex = blocks.length;
 1173:     final nextPosition = DocumentPosition.text(
 1174:       blockId: nextBlockId,
 1175:       blockIndex: nextBlockIndex,
 1176:       offset: 0,
 1177:     );
 1178:     final nextSelection =
 1179:         DocumentSelection(base: nextPosition, extent: nextPosition);
 1180:     _skipNextCaretScrollIntoView = true;
 1181:     widget.controller.insertBlocks(
 1182:       index: nextBlockIndex,
 1183:       blocks: <BlockNode>[
 1184:         TextBlockNode(
 1185:           id: nextBlockId,
 1186:           type: BlockType.paragraph,
 1187:           content: const <InlineNode>[],
 1188:         ),
 1189:       ],
 1190:       selection: nextSelection,
 1191:     );
 1192:     _inputClient.syncBuffer();
 1193:     return true;
 1194:   }
