  109: /// Editor-level host that renders table toolbar requests into the system overlay.
  110: class TableFloatingToolbarOverlayHost extends StatefulWidget {
  111:   const TableFloatingToolbarOverlayHost({
  112:     super.key,
  113:     required this.controller,
  114:     required this.child,
  115:   });
  116: 
  117:   final TableFloatingToolbarOverlayController controller;
  118:   final Widget child;
  119: 
  120:   @override
  121:   State<TableFloatingToolbarOverlayHost> createState() =>
  122:       _TableFloatingToolbarOverlayHostState();
  123: }
  124: 
  125: class _TableFloatingToolbarOverlayHostState
  126:     extends State<TableFloatingToolbarOverlayHost> {
  127:   final OverlayPortalController _portalController = OverlayPortalController();
  128:   TableFloatingToolbarOverlayRequest? _request;
  129: 
  130:   @override
  131:   void initState() {
  132:     super.initState();
  133:     _request = widget.controller.request;
  134:     widget.controller.addListener(_handleControllerChanged);
  135:     WidgetsBinding.instance.addPostFrameCallback((_) => _syncPortal());
  136:   }
  137: 
  138:   @override
  139:   void didUpdateWidget(covariant TableFloatingToolbarOverlayHost oldWidget) {
  140:     super.didUpdateWidget(oldWidget);
  141:     if (oldWidget.controller == widget.controller) {
  142:       return;
  143:     }
  144:     oldWidget.controller.removeListener(_handleControllerChanged);
  145:     _request = widget.controller.request;
  146:     widget.controller.addListener(_handleControllerChanged);
  147:     WidgetsBinding.instance.addPostFrameCallback((_) => _syncPortal());
  148:   }
  149: 
  150:   @override
  151:   void dispose() {
  152:     widget.controller.removeListener(_handleControllerChanged);
  153:     if (_portalController.isShowing) {
  154:       _portalController.hide();
  155:     }
  156:     super.dispose();
  157:   }
  158: 
  159:   @override
  160:   Widget build(BuildContext context) {
  161:     return OverlayPortal(
  162:       controller: _portalController,
  163:       overlayChildBuilder: (context) {
  164:         final request = _request;
  165:         if (request == null || !request.enabled) {
  166:           return const SizedBox.shrink();
  167:         }
  168:         return _TableFloatingToolbarOverlayEntry(request: request);
  169:       },
  170:       child: widget.child,
  171:     );
  172:   }
  173: 
  174:   void _handleControllerChanged() {
  175:     if (!mounted) {
  176:       return;
  177:     }
  178:     setState(() {
  179:       _request = widget.controller.request;
  180:     });
  181:     _syncPortalSafely();
  182:   }
  183: 
  184:   void _syncPortalSafely() {
  185:     if (SchedulerBinding.instance.schedulerPhase ==
  186:         SchedulerPhase.persistentCallbacks) {
  187:       WidgetsBinding.instance.addPostFrameCallback((_) => _syncPortal());
  188:       return;
  189:     }
  190:     _syncPortal();
  191:   }
  192: 
  193:   void _syncPortal() {
  194:     if (!mounted) {
  195:       return;
  196:     }
  197:     final shouldShow = _request?.enabled == true;
  198:     if (shouldShow) {
  199:       if (!_portalController.isShowing) {
  200:         _portalController.show();
  201:       }
  202:     } else if (_portalController.isShowing) {
  203:       _portalController.hide();
  204:     }
  205:   }
  206: }
