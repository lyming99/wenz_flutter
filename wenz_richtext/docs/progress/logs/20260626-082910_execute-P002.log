 9329:   RelativeRect _fileMenuPosition(BuildContext context) {
 9330:     final overlay =
 9331:         Overlay.of(context).context.findRenderObject() as RenderBox?;
 9332:     final box = context.findRenderObject() as RenderBox?;
 9333:     if (overlay == null || box == null || !overlay.hasSize || !box.hasSize) {
 9334:       return RelativeRect.fill;
 9335:     }
 9336:     final topLeft = box.localToGlobal(Offset.zero, ancestor: overlay);
 9337:     return RelativeRect.fromRect(
 9338:         topLeft & box.size, Offset.zero & overlay.size);
 9339:   }
