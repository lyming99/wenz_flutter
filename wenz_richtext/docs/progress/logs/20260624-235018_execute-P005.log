2879-  // B2: auto-scroll-on-drag. A mouse drag held near a viewport edge drives a
2880-  // per-frame ticker that keeps scrolling and re-extends the selection, so the
2881-  // user can drag-select past the visible area without moving the pointer.
2882-  group('auto-scroll on drag', () {
2883-    // A tall document: many short paragraphs whose combined height exceeds the
2884-    // 150px viewport, so the bottom edge sits mid-document and there is room
2885-    // to scroll down.
2886-    RichTextDocument tallDocument({int count = 30}) => RichTextDocument(
2887-          blocks: List<BlockNode>.generate(
2888-            count,
2889-            (i) => TextBlockNode(
2890-              id: 'p$i',
2891-              type: BlockType.paragraph,
2892-              content: <InlineNode>[TextRun(text: 'block-$i-content')],
2893-            ),
2894-          ),
2895-        );
