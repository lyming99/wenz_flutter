+Offset _globalTextRangePoint(
+  WidgetTester tester,
+  String text,
+  int startOffset,
+  int endOffset,
+  double fraction,
+) {
+  final start = _globalTextOffset(tester, text, startOffset);
+  final end = _globalTextOffset(tester, text, endOffset);
+  return start + (end - start) * fraction;
+}
