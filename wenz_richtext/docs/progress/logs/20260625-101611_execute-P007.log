 7727: List<String> _underlinedTexts(InlineSpan span) {
 7728:   final result = <String>[];
 7729: 
 7730:   void visit(InlineSpan current, TextStyle? inheritedStyle) {
 7731:     if (current is! TextSpan) {
 7732:       return;
 7733:     }
 7734:     final style = current.style ?? inheritedStyle;
 7735:     final text = current.text;
 7736:     if (text != null &&
 7737:         text.isNotEmpty &&
 7738:         style?.decoration?.contains(TextDecoration.underline) == true) {
 7739:       result.add(text);
 7740:     }
 7741:     final children = current.children;
 7742:     if (children != null) {
 7743:       for (final child in children) {
 7744:         visit(child, style);
 7745:       }
 7746:     }
 7747:   }
 7748: 
 7749:   visit(span, null);
 7750:   return result;
 7751: }
