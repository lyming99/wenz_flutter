 7775: Offset _globalTextOffset(WidgetTester tester, String text, int offset) {
 7776:   final finder = _richText(text);
 7777:   final richText = tester.widget<RichText>(finder);
 7778:   final size = tester.getSize(finder);
 7779:   final painter = TextPainter(
 7780:     text: richText.text,
 7781:     textAlign: richText.textAlign,
 7782:     textDirection: TextDirection.ltr,
 7783:   )..layout(maxWidth: size.width);
 7784:   final local = painter.getOffsetForCaret(
 7785:     TextPosition(offset: offset),
 7786:     Rect.zero,
 7787:   );
 7788:   return tester.getTopLeft(finder) +
 7789:       local +
 7790:       Offset(1, painter.preferredLineHeight / 2);
 7791: }
 7792: 
 7793: Offset _globalTextRangePoint(
 7794:   WidgetTester tester,
 7795:   String text,
 7796:   int startOffset,
 7797:   int endOffset,
 7798:   double fraction,
 7799: ) {
 7800:   final finder = _richText(text);
 7801:   final richText = tester.widget<RichText>(finder);
 7802:   final size = tester.getSize(finder);
 7803:   final painter = TextPainter(
 7804:     text: richText.text,
 7805:     textAlign: richText.textAlign,
 7806:     textDirection: TextDirection.ltr,
 7807:   )..layout(maxWidth: size.width);
 7808:   final boxes = painter.getBoxesForSelection(
 7809:     TextSelection(baseOffset: startOffset, extentOffset: endOffset),
 7810:   );
 7811:   if (boxes.isEmpty) {
 7812:     final start = _globalTextOffset(tester, text, startOffset);
 7813:     final end = _globalTextOffset(tester, text, endOffset);
 7814:     return start + (end - start) * fraction;
 7815:   }
 7816:   final firstBox = boxes.first.toRect();
 7817:   final rangeRect = boxes.skip(1).fold<Rect>(
 7818:         firstBox,
 7819:         (current, box) => current.expandToInclude(box.toRect()),
 7820:       );
 7821:   return tester.getTopLeft(finder) +
 7822:       Offset(
 7823:         rangeRect.left + rangeRect.width * fraction,
 7824:         rangeRect.top + rangeRect.height / 2,
 7825:       );
 7826: }
