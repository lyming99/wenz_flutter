+class _TodoCheckbox extends StatefulWidget {
+  const _TodoCheckbox({
+    required this.blockId,
+    required this.registry,
+    required this.checked,
+    required this.onChanged,
+  });
+
+  final String blockId;
+  final BlockGeometryRegistry registry;
