+    return '';
+  }
+  return _normalizeFileTypeLabel(cleanName.substring(dot + 1));
+}
+
+String _normalizeFileTypeLabel(String value) {
+  final cleaned = value.replaceAll(RegExp(r'[^A-Za-z0-9]'), '').trim();
