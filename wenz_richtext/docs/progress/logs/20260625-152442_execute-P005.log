 3352:   /// Whether the current selection could affect this block's rendering: it is
 3353:   /// an endpoint, or it lies strictly between the selection's start and end
 3354:   /// (so it would be fully highlighted), or the selection is collapsed inside
 3355:   /// it (the caret).
 3356:   bool _selectionTouchesBlock(_KeepAliveBlock w) {
 3357:     final selection = w.selection;
 3358:     if (selection == null) {
 3359:       return false;
 3360:     }
 3361:     final index = w.blockIndex;
 3362:     final start = selection.start;
 3363:     final end = selection.end;
 3364:     if (start.blockIndex == index || end.blockIndex == index) {
 3365:       return true;
 3366:     }
 3367:     // Interior block of a multi-block range is fully highlighted.
 3368:     return index > start.blockIndex && index < end.blockIndex;
 3369:   }
 3370: 
 3371:   /// Whether an active IME composition affects this block (composition lives in
 3372:   /// the caret's block). Only that block needs to repaint the underline span.
 3373:   bool _compositionTouchesBlock(_KeepAliveBlock w) {
 3374:     final composition = w.compositionState;
 3375:     if (composition == null) {
 3376:       return false;
 3377:     }
 3378:     final selection = w.selection;
 3379:     return selection != null && selection.extent.blockIndex == w.blockIndex;
 3380:   }
 3381: }
