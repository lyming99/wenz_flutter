9053-String _inlineRenderText(InlineNode node) {
9054-  if (node is TextRun) {
9055-    return node.text;
9056-  }
9057-  if (node is InlineEmbed) {
9058-    return switch (node.embedType.trim()) {
9059-      'mention' => _mentionRenderText(node),
9060-      'image' => '[img]',
9061-      'formula' => _formulaRenderText(node),
9062-      'emoji' => _emojiRenderText(node),
9063-      _ => '[${node.embedType}]',
9064-    };
9065-  }
9066-  return node.plainText;
9067-}
9068-
9069-String _mentionRenderText(InlineEmbed embed) {
9070-  final raw = embed.data['label'] ?? embed.data['id'];
9071-  final label = raw?.toString() ?? '';
9072-  return label.isEmpty ? '@mention' : '@$label';
9073-}
9074-
9075-String _formulaRenderText(InlineEmbed embed) {
9076-  for (final key in const <String>['text', 'latex', 'value', 'formula']) {
9077-    final value = embed.data[key]?.toString().trim();
9078-    if (value != null && value.isNotEmpty) {
9079-      return value;
9080-    }
9081-  }
9082-  return '[formula]';
9083-}
9084-
9085-String _emojiRenderText(InlineEmbed embed) {
9086-  final raw = embed.data['emoji'] ??
9087-      embed.data['text'] ??
9088-      embed.data['value'] ??
9089-      embed.data['shortName'] ??
9090-      embed.data['label'];
9091-  final text = raw?.toString() ?? '';
9092-  return text.isEmpty ? '[emoji]' : text;
