8951: TextSpan? _leafSpan(TextSpan span, String text) {
8952:   final children = span.children;
8953:   if ((children == null || children.isEmpty) && span.text == text) {
8954:     return span;
8955:   }
8956:   for (final child in children ?? const <InlineSpan>[]) {
8957:     if (child is TextSpan) {
8958:       final match = _leafSpan(child, text);
8959:       if (match != null) {
8960:         return match;
8961:       }
8962:     }
8963:   }
8964:   return null;
8965: }
