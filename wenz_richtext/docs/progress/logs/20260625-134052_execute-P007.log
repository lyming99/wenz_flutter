        MaterialApp(
          home: Scaffold(
            body: SizedBox(
              width: 720,
              height: 520,
              child: WenzRichTextEditor(
                controller: controller,
                padding: const EdgeInsets.only(
                  left: 16,
                  top: 72,
                  right: 16,
                  bottom: 16,
                ),
                enableIme: false,
              ),
            ),
          ),
        ),
