+  test('block drag handle spec gates read-only and row boundaries', () {
+    expect(
+      BlockDragHandleSpec.canShow(
+        canEdit: false,
+        blockIndex: 0,
+        blockCount: 3,
+      ),
+      isFalse,
+    );
+    expect(
+      BlockDragHandleSpec.canShow(
+        canEdit: true,
+        blockIndex: 0,
+        blockCount: 3,
+      ),
+      isTrue,
+    );
+    expect(
+      BlockDragHandleSpec.canDragSort(
+        canEdit: true,
+        blockIndex: 0,
+        blockCount: 1,
+      ),
+      isFalse,
+    );
+    expect(
+      BlockDragHandleSpec.canMoveUp(
+        canEdit: true,
+        blockIndex: 0,
+        blockCount: 3,
