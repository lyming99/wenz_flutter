+      expect(outline.items[0].title, 'Intro');
+      expect(outline.items[0].anchor, 'intro');
+      expect(outline.items[0].target, 'intro');
+      expect(outline.items[1].blockId, 'h2');
+      expect(outline.items[1].level, 2);
