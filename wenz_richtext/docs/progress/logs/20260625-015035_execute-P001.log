 6530: Color _calloutTint(ThemeData theme, String variant) {
 6531:   final scheme = theme.colorScheme;
 6532:   switch (CalloutBlockNode.normalizeVariant(variant)) {
 6533:     case CalloutBlockNode.successVariant:
 6534:       return scheme.tertiaryContainer.withAlpha(90);
 6535:     case 'warning':
 6536:       return Colors.amber
 6537:           .withAlpha(theme.brightness == Brightness.dark ? 64 : 48);
 6538:     case CalloutBlockNode.dangerVariant:
 6539:       return scheme.errorContainer.withAlpha(90);
 6540:     case CalloutBlockNode.infoVariant:
 6541:     default:
 6542:       return scheme.surfaceContainerHighest;
 6543:   }
 6544: }
 6545: 
 6546: Color _calloutForeground(ThemeData theme, String variant) {
 6547:   final scheme = theme.colorScheme;
 6548:   switch (CalloutBlockNode.normalizeVariant(variant)) {
 6549:     case CalloutBlockNode.successVariant:
 6550:       return scheme.onTertiaryContainer;
 6551:     case CalloutBlockNode.warningVariant:
 6552:       return theme.brightness == Brightness.dark
 6553:           ? Colors.amber.shade200
 6554:           : Colors.amber.shade900;
 6555:     case CalloutBlockNode.dangerVariant:
 6556:       return scheme.onErrorContainer;
 6557:     case CalloutBlockNode.infoVariant:
 6558:     default:
 6559:       return scheme.onSurfaceVariant;
 6560:   }
 6561: }
 6562: 
 6563: Color _calloutBorder(ThemeData theme, String variant) {
 6564:   return _calloutForeground(theme, variant).withAlpha(80);
 6565: }
 6566: 
 6567: String _calloutVariantLabel(String variant) {
 6568:   return CalloutBlockNode.defaultTitleFor(variant);
 6569: }
