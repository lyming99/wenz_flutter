    6: 
    7: /// Collapsed selection at [offset] inside the inline text of a text block.
    8: DocumentSelection collapsedTextSelection(
    9:   String blockId,
   10:   int blockIndex,
   11:   int offset,
   12: ) {
   13:   final position = DocumentPosition(
   14:     blockId: blockId,
   15:     blockIndex: blockIndex,
   16:     path: PositionPath.blockText(blockId),
   17:     offset: offset,
   18:   );
   19:   return DocumentSelection(base: position, extent: position);
   20: }
   21: 
   22: /// Collapsed selection at [offset] inside the code of a code block.
   23: DocumentSelection collapsedCodeSelection(
   24:   String blockId,
   25:   int blockIndex,
   26:   int offset,
   27: ) {
   28:   final position = DocumentPosition(
   29:     blockId: blockId,
   30:     blockIndex: blockIndex,
   31:     path: PositionPath.blockCode(blockId),
   32:     offset: offset,
   33:   );
   34:   return DocumentSelection(base: position, extent: position);
   35: }
   36: 
   37: /// Text-block selection spanning [startOffset, endOffset). [base] is the
   38: /// anchor (grows from the start by default); pass [reversed] to anchor at the
   39: /// end instead.
   40: DocumentSelection textSelection(
   41:   String blockId,
   42:   int blockIndex,
   43:   int startOffset,
   44:   int endOffset, {
   45:   bool reversed = false,
   46: }) {
   47:   final path = PositionPath.blockText(blockId);
   48:   final a = DocumentPosition(
   49:     blockId: blockId,
   50:     blockIndex: blockIndex,
   51:     path: path,
   52:     offset: startOffset,
   53:   );
   54:   final b = DocumentPosition(
   55:     blockId: blockId,
   56:     blockIndex: blockIndex,
   57:     path: path,
   58:     offset: endOffset,
   59:   );
   60:   return DocumentSelection(base: reversed ? b : a, extent: reversed ? a : b);
   61: }
