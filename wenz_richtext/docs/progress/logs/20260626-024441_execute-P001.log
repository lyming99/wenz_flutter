  546:         continue;
  547:       }
  548:       final title = _normalizeTitle(block.plainText);
  549:       if (title.isEmpty) {
  550:         continue;
  551:       }
  552:       final rawLevel = block.attributes.level ?? 1;
  553:       final level = rawLevel.clamp(1, 6).toInt();
  554:       final collapseRange = _collapseRangeForHeading(
  555:         blocks: blocks,
  556:         headingIndex: i,
  557:         headingLevel: level,
  558:       );
  559:       if (collapseRange.isNotEmpty) {
  560:         collapsibleIds.add(block.id);
  561:       }
  562:       drafts.add(
  563:         _OutlineItemDraft(
  564:           blockId: block.id,
  565:           blockIndex: i,
  566:           level: level,
  567:           title: title,
  568:           anchor: _normalizeAnchor(block.attributes.anchor),
  569:           collapseRange: collapseRange,
  570:         ),
  571:       );
  572:     }
  573: 
  574:     final nextCollapsedBlockIds = Set<String>.unmodifiable(
  575:       _collapsedBlockIds.where(collapsibleIds.contains),
  576:     );
  577:     final next = List<OutlineItem>.unmodifiable(
  578:       drafts.map(
  579:         (draft) => draft.toItem(
  580:           isCollapsed: nextCollapsedBlockIds.contains(draft.blockId),
  581:         ),
  582:       ),
  583:     );
  584: 
  585:     final itemsChanged = !listEquals(_items, next);
  586:     final collapseStateChanged =
  587:         !setEquals(_collapsedBlockIds, nextCollapsedBlockIds);
  588:     if (!itemsChanged && !collapseStateChanged) {
  589:       return;
  590:     }
  591:     _items = next;
  592:     _collapsedBlockIds = nextCollapsedBlockIds;
  593:     notifyListeners();
  594:   }
  595: 
  596:   bool _setCollapsed({
  597:     required String blockId,
  598:     required bool collapsed,
  599:   }) {
  600:     final item = itemForBlockId(blockId);
  601:     if (item == null || !item.canCollapse) {
  602:       return false;
  603:     }
  604:     final next = Set<String>.of(_collapsedBlockIds);
  605:     final changed = collapsed ? next.add(blockId) : next.remove(blockId);
  606:     if (!changed) {
  607:       return false;
  608:     }
  609:     if (collapsed) {
  610:       _moveSelectionToHeadingIfCovered(item);
  611:     }
  612:     _collapsedBlockIds = Set<String>.unmodifiable(next);
  613:     _recompute();
  614:     return true;
  615:   }
  616: 
  617:   void _moveSelectionToHeadingIfCovered(OutlineItem item) {
  618:     final selection = _host.selection;
  619:     if (selection == null || !item.canCollapse) {
  620:       return;
  621:     }
  622:     final selectionStart = selection.start.blockIndex;
  623:     final selectionEnd = selection.end.blockIndex;
  624:     final rangeStart = item.collapseStartBlockIndex;
  625:     final rangeEnd = item.collapseEndBlockIndexExclusive - 1;
  626:     if (rangeStart > selectionEnd || rangeEnd < selectionStart) {
  627:       return;
  628:     }
  629:     final position = DocumentPosition.text(
  630:       blockId: item.blockId,
  631:       blockIndex: item.blockIndex,
  632:       offset: 0,
  633:     );
  634:     _host.setSelection(DocumentSelection(base: position, extent: position));
