  174:     if (blocks.isEmpty) {
  175:       return OutlineBlockProjection.all(blocks);
  176:     }
  177: 
  178:     final hiddenIndexes = <int>{};
  179:     for (final item in items) {
  180:       if (!item.isCollapsed || !item.canCollapse) {
  181:         continue;
  182:       }
  183:       final start = item.collapseStartBlockIndex.clamp(0, blocks.length);
  184:       final end = item.collapseEndBlockIndexExclusive.clamp(0, blocks.length);
  185:       for (var index = start; index < end; index++) {
  186:         hiddenIndexes.add(index);
  187:       }
  188:     }
  189: 
  190:     if (hiddenIndexes.isEmpty) {
  191:       return OutlineBlockProjection.all(blocks);
  192:     }
  193: 
  194:     final visibleBlocks = <BlockNode>[];
  195:     final visibleIndexes = <int>[];
  196:     final visibleIds = <String>{};
  197:     final hiddenIds = <String>{};
  198:     for (var index = 0; index < blocks.length; index++) {
  199:       final block = blocks[index];
  200:       if (hiddenIndexes.contains(index)) {
  201:         hiddenIds.add(block.id);
  202:         continue;
  203:       }
  204:       visibleBlocks.add(block);
  205:       visibleIndexes.add(index);
  206:       visibleIds.add(block.id);
  207:     }
  208: 
  209:     return OutlineBlockProjection._(
  210:       sourceBlockCount: blocks.length,
  211:       visibleBlocks: List<BlockNode>.unmodifiable(visibleBlocks),
  212:       visibleBlockIndexes: List<int>.unmodifiable(visibleIndexes),
  213:       visibleBlockIds: Set<String>.unmodifiable(visibleIds),
  214:       hiddenBlockIds: Set<String>.unmodifiable(hiddenIds),
  215:       hiddenBlockIndexes: Set<int>.unmodifiable(hiddenIndexes),
  216:     );
  217:   }
