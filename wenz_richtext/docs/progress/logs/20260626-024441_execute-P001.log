  684: OutlineCollapseRange _collapseRangeForHeading({
  685:   required List<BlockNode> blocks,
  686:   required int headingIndex,
  687:   required int headingLevel,
  688: }) {
  689:   final start = headingIndex + 1;
  690:   var end = start;
  691:   while (end < blocks.length) {
  692:     final block = blocks[end];
  693:     if (block is TextBlockNode && block.type == BlockType.heading) {
  694:       final level = (block.attributes.level ?? 1).clamp(1, 6).toInt();
  695:       if (level <= headingLevel) {
  696:         break;
  697:       }
  698:     }
  699:     end++;
  700:   }
  701:   return OutlineCollapseRange(
  702:     startBlockIndex: start,
  703:     endBlockIndexExclusive: end,
  704:     blockIds: List<String>.unmodifiable(
  705:       blocks.sublist(start, end).map((block) => block.id),
  706:     ),
  707:   );
  708: }
