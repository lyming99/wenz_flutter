  638:     if (_collapsedBlockIds.isEmpty) {
  639:       return const <OutlineItem>[];
  640:     }
  641:     final collapsedItems = <OutlineItem>[];
  642:     for (final item in _items) {
  643:       if (!item.isCollapsed || !item.canCollapse) {
  644:         continue;
  645:       }
  646:       if (item.collapseRange.containsBlockId(blockId)) {
  647:         collapsedItems.add(item);
