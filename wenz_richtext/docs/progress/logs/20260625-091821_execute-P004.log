+          IconButton(
+            tooltip: '复制代码',
+            visualDensity: VisualDensity.compact,
+            iconSize: 18,
+            color: tagColor,
+            disabledColor: tagColor.withAlpha(96),
+            onPressed: onCopyPressed,
+            icon: const Icon(Icons.copy),
+          ),
+        ],
+      ),
