-      case 'moveWordRight:':
-        _verticalPreferX = null;
-        controller.moveCaretByWord(forward: true);
-        return true;
-      case 'moveWordLeftAndModifySelection:':
-        _verticalPreferX = null;
-        controller.moveCaretByWord(forward: false, expandSelection: true);
-        return true;
-      case 'moveWordRightAndModifySelection:':
