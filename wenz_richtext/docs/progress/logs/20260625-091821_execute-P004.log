-      // length and return a valid (possibly collapsed) range, not throw.
-      final range = TextLayoutService().wordRangeAt(painter, 100);
-      expect(range.start, inInclusiveRange(0, 2));
-      expect(range.end, inInclusiveRange(0, 2));
