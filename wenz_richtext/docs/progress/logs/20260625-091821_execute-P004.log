-      return;
-    }
-    _inputGeometrySyncPending = true;
-    WidgetsBinding.instance.addPostFrameCallback((_) {
-      _inputGeometrySyncPending = false;
-      if (!mounted || !_inputClient.isAttached) {
-        return;
-      }
-      _inputClient.syncBuffer();
-    });
