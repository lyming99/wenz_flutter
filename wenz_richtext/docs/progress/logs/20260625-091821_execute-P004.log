-String _fileAccessibleLabel(FileBlockNode file) {
-  final parts = <String>[
-    file.displayName.isEmpty ? 'untitled file' : file.displayName,
-  ];
-  final metadata = _fileMetadata(file);
-  if (metadata.isNotEmpty) {
-    parts.add(metadata);
