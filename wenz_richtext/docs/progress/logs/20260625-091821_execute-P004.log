-    return oldDelegate.textSpan != textSpan ||
-        oldDelegate.offsetMapper != offsetMapper ||
-        oldDelegate.textAlign != textAlign ||
-        oldDelegate.textDirection != textDirection ||
-        oldDelegate.maxWidth != maxWidth ||
