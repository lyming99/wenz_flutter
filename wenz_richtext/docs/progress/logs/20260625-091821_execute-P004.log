-  void _scrollToDocumentBoundary({required bool forward}) {
-    if (!_scrollController.hasClients) {
-      return;
-    }
-    final position = _scrollController.position;
-    _jumpToScrollOffset(forward ? position.maxScrollExtent : 0);
