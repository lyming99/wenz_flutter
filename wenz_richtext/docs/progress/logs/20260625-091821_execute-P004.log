-    widget.registry.unregister(widget.blockId, widget.path, _surfaceKey);
-    super.dispose();
-  }
-
-  void _register() {
-    widget.registry.register(
-      BlockEntry(
-        blockId: widget.blockId,
-        blockIndex: widget.blockIndex,
-        path: widget.path,
-        textLength: _kAtomicBlockSelectionLength,
-        key: _surfaceKey,
