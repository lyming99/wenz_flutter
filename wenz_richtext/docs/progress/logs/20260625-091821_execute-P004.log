-  int logicalOffsetForHit(
-    TextPainter painter,
-    Offset localPosition,
-    int renderOffset,
-  ) {
-    final atomicHit = _atomicLogicalOffsetForHit(painter, localPosition);
-    if (atomicHit != null) {
-      return atomicHit;
-    }
-    return logicalOffsetForRenderOffset(renderOffset);
-  }
