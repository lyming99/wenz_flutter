-    }
-    final focusNode = _effectiveFocusNode;
-    if (widget.enableIme && focusNode.hasFocus && !widget.readOnly) {
-      _inputClient.attach();
-    } else {
-      _inputClient.detach();
-    }
-    setState(() {});
-  }
