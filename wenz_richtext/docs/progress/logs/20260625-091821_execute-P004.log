-class _BlockExtentCache {
-  final Map<String, double> _extents = <String, double>{};
-  final Map<String, int> _blockVersions = <String, int>{};
-  Set<String> _knownBlockIds = <String>{};
-  int _epoch = 0;
-  double? _contentWidth;
-
-  void clear() {
-    _epoch += 1;
-    _extents.clear();
