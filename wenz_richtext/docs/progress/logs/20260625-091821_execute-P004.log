+    testWidgets('selection exclusions follow registered render boxes', (
+      tester,
+    ) async {
+      final registry = BlockGeometryRegistry();
+      final key = GlobalKey();
+
+      await tester.pumpWidget(
+        MaterialApp(
+          home: Scaffold(
+            body: Stack(
+              children: <Widget>[
