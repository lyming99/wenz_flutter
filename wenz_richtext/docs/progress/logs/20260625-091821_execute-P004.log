-        id: _nextBlockId(),
-        assetId: block.assetId,
-        name: block.name,
-        size: block.size,
-        mimeType: block.mimeType,
-        file: block.file,
-        downloadUrl: block.downloadUrl,
-        uploadStatus: block.uploadStatus,
