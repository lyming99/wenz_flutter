-    if (width == null || !width.isFinite || width < 0) {
-      return;
-    }
-    final previous = _contentWidth;
-    if (previous != null && (previous - width).abs() <= 0.5) {
-      return;
-    }
-    _contentWidth = width;
-    clear();
-  }
-
