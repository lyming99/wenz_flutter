-      segments: safeLength == 0
-          ? const <_InlineOffsetSegment>[]
-          : <_InlineOffsetSegment>[
-              _InlineOffsetSegment(
-                logicalStart: 0,
-                logicalEnd: safeLength,
-                renderStart: 0,
