  421: /// A registered editable block's geometry and layout access.
  422: ///
  423: /// Each entry tracks **two** render boxes:
  424: /// - [renderBox] (via [key]) is the *text surface* — the box the laid-out
  425: ///   [TextPainter] is painted into. It anchors caret/selection painting and
  426: ///   [caretRectAt] global positioning, so it must be the box whose local
  427: ///   coordinate space matches the painter's.
  428: /// - [hitTestBox] (via [hitTestKey]) is the *hit-test frame* — the box used for
  429: ///   [BlockGeometryRegistry.positionFromGlobalOffset] containment and
  430: ///   nearest-block clamping. For plain surfaces these are the same box; for
  431: ///   table cells the hit-test frame is the whole cell (padding + centred text)
  432: ///   while the text surface is only the centred text region. [hitLocalToTextLocal]
  433: ///   translates a hit-test-local offset back into the text surface's local
  434: ///   space so [positionFromLocal] receives the coordinate the painter expects.
  435: class BlockEntry {
  436:   BlockEntry({
  437:     required this.blockId,
  438:     required this.blockIndex,
  439:     required this.path,
  440:     required this.textLength,
  441:     required this.key,
  442:     required this.positionFromLocal,
  443:     required this.wordRangeAt,
  444:     required this.caretRectAt,
  445:     required this.localCaretRectAt,
  446:     required this.localComposingRectForRange,
  447:     required this.verticalMoveAt,
  448:     this.hitTestKey,
  449:     Offset Function(Offset)? hitLocalToTextLocal,
  450:   }) : _hitLocalToTextLocal = hitLocalToTextLocal;
