-    if (block is TableBlockNode) {
-      return TableBlockNode(
-        id: _nextBlockId(),
-        table: TableModel(
-          rows: block.table.rows
-              .map(
-                (row) => row
-                    .map(
-                      (cell) => TableCellNode(
-                        id: _nextBlockId(),
-                        blocks:
-                            cell.blocks.map(_copyBlockWithFreshIds).toList(),
-                        rowSpan: cell.rowSpan,
