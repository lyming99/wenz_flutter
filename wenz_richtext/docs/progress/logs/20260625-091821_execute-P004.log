+      );
+      final p1Rect = tester.getRect(p1);
+      final p2Rect = tester.getRect(p2);
+      // Column 5 x: 5 characters in from p1's left.
+      final columnX = p1Rect.left + 5 * (p1Rect.width / 'abcdefghij'.length);
+      final gapY = (p1Rect.bottom + p2Rect.top) / 2;
