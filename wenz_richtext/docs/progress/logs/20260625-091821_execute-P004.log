-      extent,
-      forward,
-      preferX: _verticalPreferX,
-    );
-    final target = result?.targetOffset;
-    if (target != null) {
-      // Remember the local column for repeated vertical moves.
-      _verticalPreferX = result?.caretX ?? _verticalPreferX;
