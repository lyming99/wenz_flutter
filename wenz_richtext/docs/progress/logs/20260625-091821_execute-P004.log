-String _embedDisplayText(InlineEmbed embed) {
-  return switch (embed.embedType.trim()) {
-    'mention' => _mentionDisplayText(embed),
-    'image' => '[img]',
-    'formula' => _formulaDisplayText(embed),
-    'emoji' => _emojiDisplayText(embed),
-    _ => '[${embed.embedType}]',
-  };
-}
