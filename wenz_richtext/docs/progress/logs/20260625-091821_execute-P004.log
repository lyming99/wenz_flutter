+                child: IgnorePointer(
+                  child: RepaintBoundary(
+                    child: CustomPaint(
+                      key: _caretKey,
+                      foregroundPainter: caretPainter,
+                      child: const SizedBox.expand(),
+                    ),
+                  ),
+                ),
+              ),
+            ],
+            if (widget.showDebugOverlay)
