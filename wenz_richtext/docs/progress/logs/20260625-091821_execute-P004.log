  502:   /// The text surface render box (painter's local space). Null until laid out.
  503:   RenderBox? get renderBox {
  504:     final context = key.currentContext;
  505:     final object = context?.findRenderObject();
  506:     return object is RenderBox ? object : null;
  507:   }
  508: 
  509:   /// The hit-test frame render box. Falls back to [renderBox] when no separate
  510:   /// [hitTestKey] is registered (the common case).
  511:   RenderBox? get hitTestBox {
  512:     final hitKey = hitTestKey;
  513:     if (hitKey == null) {
