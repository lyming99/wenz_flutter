+
+  final String blockId;
+  final String blockPlainText;
+  final int blockIndex;
+  final int blockCount;
+  final double leadingIndent;
+  final bool canEdit;
+  final BlockGeometryRegistry registry;
+  final Widget child;
+  final ObjectBlockActionHandler? onAction;
