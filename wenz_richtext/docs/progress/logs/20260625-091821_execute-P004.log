-      if (controller.selection != before) {
-        // Moved within the table.
-        return;
-      }
-      // On the table boundary row: fall through to cross-block exit.
-      controller.moveCaretVertical(forward: forward, expandSelection: shift);
-      _verticalPreferX = null;
-      return;
-    }
