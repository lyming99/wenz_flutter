-String _formatFileSize(int bytes) {
-  if (bytes < 1024) {
-    return '$bytes B';
-  }
-  const units = <String>['KB', 'MB', 'GB', 'TB'];
-  var value = bytes.toDouble();
-  var unit = -1;
