-String _fileStatusText(FileBlockNode file) {
-  final status = _fileUploadStatusLabel(file.uploadStatus);
-  if (status.isEmpty) {
-    return '';
-  }
-  final error = file.uploadError.trim();
-  if (file.uploadStatus == FileUploadStatus.failed && error.isNotEmpty) {
-    return '$status · $error';
