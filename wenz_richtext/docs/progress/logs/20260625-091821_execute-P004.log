+                  icon: Icons.call_split,
+                  tooltip: '拆分单元格',
+                  action: TableToolbarAction.splitCell,
+                  enabled: canSplit,
+                ),
+                _button(
+                  icon: Icons.swap_horiz,
+                  tooltip: '重置列宽',
+                  action: TableToolbarAction.resetColumnWidth,
+                ),
+              ],
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+
+  Widget _button({
