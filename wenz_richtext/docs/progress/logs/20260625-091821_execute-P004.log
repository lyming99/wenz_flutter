    1: import 'package:flutter/widgets.dart';
    2: 
    3: import '../core/position/document_position.dart';
    4: 
    5: /// Resolves a global screen coordinate to a [DocumentPosition] across all
    6: /// registered editable blocks.
    7: ///
    8: /// Each [_TextSelectionSurface] registers itself (via [register]) with its
    9: /// block id, path, text length, a [GlobalKey] on its render object, and a
   10: /// callback that converts a *local* offset to a character offset using its
   11: /// own [TextLayoutService]. The document-level gesture overlay queries the
   12: /// registry during a drag to map the pointer position to a document position,
   13: /// which may live in a different block than where the drag started — enabling
   14: /// cross-block drag selection.
   15: class BlockGeometryRegistry {
   16:   BlockGeometryRegistry();
   17: 
   18:   /// Entries in block-index order, for ordered traversal (hit-testing,
   19:   /// nearest-block clamping, average height).
   20:   final List<BlockEntry> _entries = <BlockEntry>[];
   21: 
   22:   /// O(1) lookup by (blockId, path). Kept in sync with [_entries] on
   23:   /// register/unregister so hot paths (caret rect, word range, vertical move —
   24:   /// hit on every IME keystroke and every drag move) avoid a linear scan.
   25:   final Map<String, BlockEntry> _byKey = <String, BlockEntry>{};
   26: 
   27:   final Set<GlobalKey> _selectionExclusionKeys = <GlobalKey>{};
   28: 
   29:   /// Registers a block/path surface. Replaces any prior entry with the same
   30:   /// [blockId] and [BlockEntry.path].
   31:   void register(BlockEntry entry) {
   32:     final key = _key(entry.blockId, entry.path);
   33:     final existing = _byKey[key];
   34:     if (existing != null) {
   35:       final index = _entries.indexOf(existing);
   36:       _entries[index] = entry;
   37:     } else {
   38:       _entries.add(entry);
   39:       _entries.sort((a, b) {
   40:         final blockOrder = a.blockIndex.compareTo(b.blockIndex);
   41:         if (blockOrder != 0) {
   42:           return blockOrder;
   43:         }
   44:         return a.path.compare(b.path);
   45:       });
   46:     }
   47:     _byKey[key] = entry;
   48:   }
   49: 
   50:   /// Removes the entry for [blockId] and [path], if present. When [path] is not
   51:   /// provided, removes every surface for [blockId]. If [ownerKey] is provided,
   52:   /// the entry is removed only when it is still owned by that surface.
   53:   void unregister(String blockId, [PositionPath? path, GlobalKey? ownerKey]) {
   54:     if (path != null) {
   55:       final key = _key(blockId, path);
   56:       final entry = _byKey[key];
   57:       if (ownerKey != null && entry?.key != ownerKey) {
   58:         return;
   59:       }
   60:       _byKey.remove(key);
   61:       if (entry != null) {
   62:         _entries.remove(entry);
   63:       }
   64:       return;
   65:     }
   66:     _entries.removeWhere((e) {
   67:       if (e.blockId != blockId) {
   68:         return false;
   69:       }
   70:       if (ownerKey != null && e.key != ownerKey) {
   71:         return false;
   72:       }
   73:       _byKey.remove(_key(e.blockId, e.path));
   74:       return true;
   75:     });
   76:   }
   77: 
   78:   /// Registers an interactive control that should not start document selection.
   79:   void registerSelectionExclusion(GlobalKey key) {
   80:     _selectionExclusionKeys.add(key);
   81:   }
   82: 
   83:   void unregisterSelectionExclusion(GlobalKey key) {
   84:     _selectionExclusionKeys.remove(key);
   85:   }
   86: 
   87:   bool isSelectionExcluded(Offset global) {
   88:     for (final key in _selectionExclusionKeys) {
   89:       final renderObject = key.currentContext?.findRenderObject();
   90:       if (renderObject is! RenderBox || !renderObject.hasSize) {
   91:         continue;
   92:       }
   93:       final local = renderObject.globalToLocal(global);
   94:       if (local.dx >= 0 &&
   95:           local.dx <= renderObject.size.width &&
   96:           local.dy >= 0 &&
   97:           local.dy <= renderObject.size.height) {
   98:         return true;
   99:       }
  100:     }
  101:     return false;
  102:   }
  103: 
  104:   static String _key(String blockId, PositionPath path) =>
  105:       '$blockId@${path.hashCode}';
  106: 
  107:   /// All registered entries in block-index order.
  108:   @visibleForTesting
  109:   List<BlockEntry> get entries => List<BlockEntry>.unmodifiable(_entries);
  110: 
  111:   /// The bottom edge of the document content in global coordinates, taken from
  112:   /// the lowest mounted block surface. Used by the editor to tell whether a
  113:   /// page-jump target overshoots the document (a short doc paged past its end)
  114:   /// so the caret can jump to the document boundary instead of relying on the
  115:   /// ambiguous nearest-block clamp. Returns `null` when no surface is laid out.
  116:   double? contentExtent() {
  117:     double? bottom;
  118:     for (final entry in _entries) {
  119:       final box = entry.hitTestBox;
  120:       if (box == null || !box.hasSize) {
  121:         continue;
  122:       }
  123:       final rect = box.localToGlobal(Offset.zero) & box.size;
  124:       if (bottom == null || rect.bottom > bottom) {
  125:         bottom = rect.bottom;
  126:       }
  127:     }
  128:     return bottom;
  129:   }
  130: 
  131:   /// Average height of the currently-mounted block surfaces and the smallest
  132:   /// block index among them. Used by the editor to estimate a scroll offset
  133:   /// when a programmatic caret jump targets a virtualised (un-mounted) block:
  134:   /// the stride × index gives a rough pixel offset close enough for ListView
  135:   /// to build the target block, after which a follow-up frame pixel-aligns.
  136:   ///
  137:   /// Returns `null` when no surfaces are currently laid out.
  138:   ({double meanHeight, int firstBlockIndex})? averageMountedBlockHeight() {
  139:     var totalHeight = 0.0;
  140:     var counted = 0;
  141:     var firstIndex = -1;
  142:     for (final entry in _entries) {
  143:       final box = entry.hitTestBox;
  144:       if (box == null || !box.hasSize) {
  145:         continue;
  146:       }
  147:       if (firstIndex < 0) {
  148:         firstIndex = entry.blockIndex;
  149:       }
  150:       totalHeight += box.size.height;
  151:       counted += 1;
  152:     }
  153:     if (counted == 0 || firstIndex < 0) {
  154:       return null;
  155:     }
  156:     return (meanHeight: totalHeight / counted, firstBlockIndex: firstIndex);
  157:   }
  158: 
  159:   /// Resolves a global screen offset to a [DocumentPosition].
  160:   ///
  161:   /// If the point lands inside a registered block's hit-test box (the whole
  162:   /// cell frame for table cells, otherwise the text surface itself), the
  163:   /// position is computed from that block's *text-local* coordinates — the
  164:   /// hit-test local offset is first translated through the entry's
  165:   /// [BlockEntry.hitLocalToTextLocal] so padding/centring offsets are stripped.
  166:   /// Otherwise the nearest block is chosen by 2-D rect proximity and the caret
  167:   /// is clamped to that block's start or end — so a drag into the gap between
  168:   /// blocks (or beyond the last block) still extends the selection predictably.
  169:   DocumentPosition? positionFromGlobalOffset(Offset global) {
  170:     BlockEntry? hitEntry;
  171:     Offset? hitTextLocal;
  172:     var nearestHitDelta = double.infinity;
  173:     for (final entry in _entries) {
  174:       final box = entry.hitTestBox;
  175:       if (box == null) {
  176:         continue;
  177:       }
  178:       final local = box.globalToLocal(global);
  179:       if (local.dx >= 0 &&
  180:           local.dx <= box.size.width &&
  181:           local.dy >= 0 &&
  182:           local.dy <= box.size.height) {
  183:         final rect = box.localToGlobal(Offset.zero) & box.size;
  184:         final delta = (global - rect.center).distanceSquared;
  185:         if (delta < nearestHitDelta) {
  186:           nearestHitDelta = delta;
  187:           hitEntry = entry;
  188:           hitTextLocal = entry.hitLocalToTextLocal(local);
  189:         }
  190:       }
  191:     }
  192:     if (hitEntry != null && hitTextLocal != null) {
  193:       return DocumentPosition(
  194:         blockId: hitEntry.blockId,
  195:         blockIndex: hitEntry.blockIndex,
  196:         path: hitEntry.path,
  197:         offset: hitEntry.positionFromLocal(hitTextLocal),
  198:       );
  199:     }
  200:     // Missed every block: clamp to the nearest block's start/end.
  201:     return _clampToNearest(global);
  202:   }
  203: 
  204:   DocumentPosition? _clampToNearest(Offset global) {
  205:     if (_entries.isEmpty) {
  206:       return null;
  207:     }
  208:     BlockEntry? nearest;
  209:     var nearestDelta = double.infinity;
  210:     var clampToEnd = false;
  211:     for (final entry in _entries) {
  212:       final box = entry.hitTestBox;
  213:       if (box == null) {
  214:         continue;
  215:       }
  216:       final rect = box.localToGlobal(Offset.zero) & box.size;
  217:       // 2-D distance from the point to the rect (0 when inside). Using both
  218:       // axes — not just vertical proximity — keeps a tap in a table cell's
  219:       // padding from being mis-attributed to a neighbouring cell/column, and a
  220:       // tap above/below a short cell from jumping to an adjacent row.
  221:       final dx = global.dx < rect.left
  222:           ? rect.left - global.dx
  223:           : (global.dx > rect.right ? global.dx - rect.right : 0.0);
  224:       final dy = global.dy < rect.top
  225:           ? rect.top - global.dy
  226:           : (global.dy > rect.bottom ? global.dy - rect.bottom : 0.0);
  227:       final delta = dx * dx + dy * dy;
  228:       if (delta < nearestDelta) {
  229:         nearestDelta = delta;
  230:         nearest = entry;
  231:         // Clamp to the end when the point sits to the right of / below the
  232:         // rect, to the start otherwise. This generalises the old vertical-only
  233:         // rule and behaves identically for paragraph cross-block drags while
  234:         // also handling 2-D table geometries.
  235:         clampToEnd = global.dx > rect.right || global.dy > rect.bottom;
  236:       }
  237:     }
  238:     if (nearest == null) {
  239:       return null;
  240:     }
  241:     // Resolve the caret using the tap's horizontal column when it falls inside
  242:     // the block's width. Project the point onto the block's nearest edge so it
  243:     // lands on the block's first line (above) / last line (below), then let the
  244:     // block's own layout map the (x, line) to a character offset. This keeps a
  245:     // gap-tap on the 4th column landing at ~offset 4 instead of always 0/end.
  246:     // Only when the tap is horizontally outside the block do we fall back to the
  247:     // hard 0 / textLength edges.
  248:     final box = nearest.hitTestBox;
  249:     if (box != null) {
  250:       final origin = box.localToGlobal(Offset.zero);
  251:       if (global.dx >= origin.dx && global.dx <= origin.dx + box.size.width) {
  252:         final rect = origin & box.size;
  253:         final edgeY = clampToEnd ? rect.bottom - 1 : rect.top + 1;
  254:         final clamped = Offset(global.dx, edgeY.clamp(rect.top, rect.bottom));
  255:         final local = box.globalToLocal(clamped);
  256:         final textLocal = nearest.hitLocalToTextLocal(local);
  257:         return DocumentPosition(
  258:           blockId: nearest.blockId,
  259:           blockIndex: nearest.blockIndex,
  260:           path: nearest.path,
  261:           offset: nearest.positionFromLocal(textLocal),
  262:         );
  263:       }
  264:     }
  265:     final offset = clampToEnd ? nearest.textLength : 0;
  266:     return DocumentPosition(
  267:       blockId: nearest.blockId,
  268:       blockIndex: nearest.blockIndex,
  269:       path: nearest.path,
  270:       offset: offset,
  271:     );
  272:   }
  273: 
  274:   /// Returns the global [Rect] of the block whose hit-test box contains
  275:   /// [global], or the nearest block's rect if none contains it. Used by the
  276:   /// gesture overlay to drive auto-scroll near viewport edges.
  277:   Rect? blockRectFromGlobalOffset(Offset global) {
  278:     for (final entry in _entries) {
  279:       final box = entry.hitTestBox;
  280:       if (box == null) {
  281:         continue;
  282:       }
  283:       final local = box.globalToLocal(global);
  284:       if (local.dx >= 0 &&
  285:           local.dx <= box.size.width &&
  286:           local.dy >= 0 &&
  287:           local.dy <= box.size.height) {
  288:         final origin = box.localToGlobal(Offset.zero);
  289:         return origin & box.size;
  290:       }
  291:     }
  292:     // Fall back to the 2-D-nearest block's rect.
  293:     BlockEntry? nearest;
  294:     var nearestDelta = double.infinity;
  295:     for (final entry in _entries) {
  296:       final box = entry.hitTestBox;
  297:       if (box == null) {
  298:         continue;
  299:       }
  300:       final rect = box.localToGlobal(Offset.zero) & box.size;
  301:       final dx = global.dx < rect.left
  302:           ? rect.left - global.dx
  303:           : (global.dx > rect.right ? global.dx - rect.right : 0.0);
  304:       final dy = global.dy < rect.top
  305:           ? rect.top - global.dy
  306:           : (global.dy > rect.bottom ? global.dy - rect.bottom : 0.0);
  307:       final delta = dx * dx + dy * dy;
  308:       if (delta < nearestDelta) {
  309:         nearestDelta = delta;
  310:         nearest = entry;
  311:       }
  312:     }
  313:     if (nearest == null) {
  314:       return null;
  315:     }
  316:     final box = nearest.hitTestBox!;
  317:     final origin = box.localToGlobal(Offset.zero);
  318:     return origin & box.size;
  319:   }
