-double _indentStartFor(BlockNode block) {
-  final indent = _blockIndentLevel(block).toDouble();
-  final step =
-      _isListItemBlock(block) ? _kListTextInset : _kIndentPixelsPerLevel;
-  return indent * step;
-}
