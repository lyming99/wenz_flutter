-            intent.blockIndex >= widget.controller.document.blocks.length - 1) {
-          return;
-        }
-        _moveBlock(intent.blockIndex, intent.blockIndex + 1);
-        return;
-      case ObjectBlockAction.delete:
-        if (widget.readOnly) {
-          return;
-        }
