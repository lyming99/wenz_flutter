-
-  void _deleteByWord({required bool forward}) {
-    final selection = widget.controller.selection;
-    if (selection == null) {
-      return;
-    }
-    if (!selection.isCollapsed) {
-      widget.controller.deleteSelection();
-      return;
-    }
-    widget.controller.moveCaretByWord(
-      forward: forward,
-      expandSelection: true,
-    );
-    widget.controller.deleteSelection();
-  }
