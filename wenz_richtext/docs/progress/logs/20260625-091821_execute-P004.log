-String? _prefixFor(TextBlockNode block) {
-  return switch (block.type) {
-    BlockType.quote => '|',
-    BlockType.listItem => switch (block.attributes.listType) {
-        'ordered' => '1.',
-        'task' => block.attributes.checked == true ? '[x]' : '[ ]',
-        _ => '-',
-      },
-    _ => null,
-  };
-}
