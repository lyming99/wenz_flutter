+                top: 0,
+                right: 0,
+                child: IgnorePointer(
+                  child: _DebugSelectionTag(
+                    blockId: widget.blockId,
+                    blockIndex: widget.blockIndex,
+                    path: widget.path,
+                    offset: caretOffset ?? selectionRange?.end,
+                  ),
+                ),
+              ),
+          ],
+        );
+      },
+    );
+  }
+}
