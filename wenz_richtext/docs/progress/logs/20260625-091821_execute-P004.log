+          layoutService: _layoutService,
+          textSpan: widget.textSpan,
+          offsetMapper: widget.offsetMapper,
+          textAlign: widget.textAlign,
+          textDirection: direction,
+          maxWidth: maxWidth,
+          caretOffset: caretOffset,
