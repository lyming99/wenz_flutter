-
-String _videoPreviewTitle(VideoBlockNode video) {
-  final title = video.title.trim();
-  if (title.isNotEmpty) {
-    return title;
-  }
-  final source = _videoSourceLabel(video);
-  return source == 'unknown' ? 'Video preview' : source;
