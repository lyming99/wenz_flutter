+    // unnecessary once the editor is gone.
+    _layoutCache.dispose();
+    _internalFocusNode?.dispose();
+    super.dispose();
+  }
+
+  void _handleFindControllerChanged() {
+    if (mounted) {
+      setState(() {});
+    }
+  }
+
+  void _handleSlashMenuChanged() {
+    if (mounted) {
+      setState(() {});
+    }
+  }
