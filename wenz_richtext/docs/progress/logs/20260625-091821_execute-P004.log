-    return null;
-  }
-  final indent = _blockIndentLevel(block);
-  return switch (block.attributes.listType) {
-    'ordered' => '${_orderedListNumberFor(blocks, index, indent)}.',
-    'task' => null,
-    _ => _unorderedListBullet(indent),
-  };
-}
