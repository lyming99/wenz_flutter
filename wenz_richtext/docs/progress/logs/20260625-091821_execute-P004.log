-class _MeasuredVirtualBlockListState extends State<_MeasuredVirtualBlockList> {
-  @override
-  void initState() {
-    super.initState();
-    widget.controller.addListener(_handleScroll);
-  }
-
-  @override
-  void didUpdateWidget(covariant _MeasuredVirtualBlockList oldWidget) {
