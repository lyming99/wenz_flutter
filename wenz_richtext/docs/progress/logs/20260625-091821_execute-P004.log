+  Future<void> _showMenu() async {
+    if (!_enabled || _dragging || _menuOpen || !mounted) {
+      return;
+    }
+    final button =
+        _hitTestKey.currentContext?.findRenderObject() as RenderBox?;
+    final overlay = Overlay.of(context).context.findRenderObject() as RenderBox?;
+    if (button == null ||
+        overlay == null ||
+        !button.hasSize ||
+        !overlay.hasSize) {
+      return;
+    }
+    final buttonTopLeft = button.localToGlobal(Offset.zero, ancestor: overlay);
+    final position = RelativeRect.fromRect(
+      buttonTopLeft & button.size,
+      Offset.zero & overlay.size,
+    );
+    _handleMenuOpened();
+    final action = await showMenu<ObjectBlockAction>(
+      context: context,
+      position: position,
+      semanticLabel: '块操作',
+      items: _buildMenuItems(context),
+    );
+    if (!mounted) {
+      return;
+    }
+    _handleMenuClosed();
+    if (action != null) {
+      _handleActionSelected(action);
+    }
+  }
