-bool _isFormulaEmbedType(String embedType) => embedType.trim() == 'formula';
-
-String _inlineDisplayText(InlineNode node) {
-  return switch (node) {
-    TextRun() => node.text,
-    InlineEmbed() => _embedDisplayText(node),
-    _ => node.plainText,
-  };
