-      children: <Widget>[
-        _ObjectActionButton(
-          icon: Icons.copy,
-          tooltip: '复制块引用',
-          onPressed: () => _dispatch(ObjectBlockAction.copyReference),
-        ),
-        if (canEdit) ...<Widget>[
-          _ObjectActionButton(
-            icon: Icons.content_copy,
