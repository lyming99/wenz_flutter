+    }
+    return _ownedLayoutService ??= TextLayoutService();
+  }
+
+  @override
+  void initState() {
+    super.initState();
+    _register();
+  }
+
+  @override
+  void didUpdateWidget(covariant _TextSelectionSurface oldWidget) {
+    super.didUpdateWidget(oldWidget);
