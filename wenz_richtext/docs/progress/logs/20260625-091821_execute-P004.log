-  if (fontSize <= 0) {
-    return baseStyle;
-  }
-  final lineHeight = math.max(
-    _lineHeightFor(baseStyle),
-    _kTodoCheckboxHeight,
-  );
-  return baseStyle.copyWith(height: lineHeight / fontSize);
