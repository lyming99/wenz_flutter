-    this.textStyle,
-    this.physics,
-    this.focusNode,
-    this.autofocus = false,
-    this.readOnly = false,
-    this.showDebugOverlay = false,
-    this.enableIme = true,
-    this.blockRenderers,
-    this.mediaResolver,
-    this.inlineEmbedRenderer,
-    this.findController,
-    this.onFindRequested,
-    this.onReplaceRequested,
-    this.slashMenuController,
-    this.accessibility = const WenzRichTextEditorAccessibility(),
