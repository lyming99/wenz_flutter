+      painter,
+      localPosition,
+      renderOffset,
+    );
+  }
+
+  TextRange _wordRangeAt(int offset) {
+    final painter = _layoutService.layout(
+      span: widget.textSpan,
+      textAlign: widget.textAlign,
+      textDirection: Directionality.of(context),
+      maxWidth: _lastMaxWidth,
+    );
