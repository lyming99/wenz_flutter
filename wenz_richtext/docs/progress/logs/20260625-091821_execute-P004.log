+  return _withSelectableObjectBlock(
+    file,
+    rc,
+    _FileBlockContent(
+      block: file,
+      blockIndex: rc.blockIndex,
+      selected: _objectBlockSelected(file, rc),
+      canEdit: rc.canEdit,
+      onAction: rc.onObjectBlockAction,
+    ),
+  );
