+              maxWidth: maxWidth,
+              range: selectionRange,
+              color: highlightColor,
+            ),
+            child: ConstrainedBox(
+              constraints: BoxConstraints(minHeight: widget.minHeight),
+              child: RichText(
+                text: widget.textSpan,
+                textAlign: widget.textAlign,
+                textDirection: direction,
+              ),
+            ),
+          ),
+        );
