+    this.hint =
+        'Edit rich text content with text input and keyboard shortcuts.',
+    this.readOnlyHint = 'Read-only rich text document.',
+    this.highContrastFocusColor,
+    this.highContrastFocusWidth = 3,
+  }) : assert(highContrastFocusWidth >= 0);
