  452:   final String blockId;
  453:   final int blockIndex;
  454:   final PositionPath path;
  455:   final int textLength;
  456: 
  457:   /// GlobalKey on the text surface render box (painter's local space).
  458:   final GlobalKey key;
  459: 
  460:   /// GlobalKey on the hit-test frame render box. When `null`, [key] is used.
  461:   /// Set for table cells where the hit-test frame (whole cell) differs from
  462:   /// the text surface (centred text).
  463:   final GlobalKey? hitTestKey;
  464: 
  465:   bool matches(String otherBlockId, PositionPath otherPath) {
  466:     return blockId == otherBlockId && path == otherPath;
  467:   }
