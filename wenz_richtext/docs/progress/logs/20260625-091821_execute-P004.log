-  /// Resets the blink phase to visible and restarts the timer, so a caret that
-  /// is mid-hidden-phase snaps back into view immediately. No-op when the
-  /// caret is not currently blinking.
-  void _resetBlinkPhase() {
-    if (!_blinkActive) {
-      return;
