-            path: PositionPath.blockObject(block.id),
-            offset: 0,
-          ),
-      _ => DocumentPosition(
-          blockId: block.id,
-          blockIndex: blockIndex,
-          path: PositionPath.blockObject(block.id),
-          offset: 0,
-        ),
