+class _ViewportAwareTableToolbar extends StatefulWidget {
+  const _ViewportAwareTableToolbar({
+    required this.fallbackHeight,
+    required this.gap,
+    required this.child,
+  });
+
+  final double fallbackHeight;
+  final double gap;
+  final Widget child;
+
+  @override
+  State<_ViewportAwareTableToolbar> createState() =>
+      _ViewportAwareTableToolbarState();
+}
+
+class _ViewportAwareTableToolbarState
+    extends State<_ViewportAwareTableToolbar> {
+  double? _top;
+  double? _toolbarHeight;
+
+  double get _preferredTop =>
+      -((_toolbarHeight ?? widget.fallbackHeight) + widget.gap);
+  double get _effectiveTop => _top ?? _preferredTop;
+
+  @override
+  Widget build(BuildContext context) {
+    WidgetsBinding.instance.addPostFrameCallback((_) => _syncTopWithViewport());
+    return PositionedDirectional(
+      top: _effectiveTop,
+      start: 0,
+      child: widget.child,
+    );
+  }
+
+  void _syncTopWithViewport() {
+    if (!mounted) {
+      return;
+    }
+    final renderObject = context.findRenderObject();
+    final scrollable = Scrollable.maybeOf(context);
+    final viewportObject = scrollable?.context.findRenderObject();
+    if (renderObject is! RenderBox ||
+        !renderObject.hasSize ||
+        viewportObject is! RenderBox ||
+        !viewportObject.hasSize) {
+      _setTopIfNeeded(_preferredTop);
+      return;
+    }
+    final toolbarHeight = renderObject.size.height;
+    final preferredTop = -(toolbarHeight + widget.gap);
+    final toolbarTop = renderObject.localToGlobal(Offset.zero).dy;
+    final stackTop = toolbarTop - _effectiveTop;
+    final viewportTop = viewportObject.localToGlobal(Offset.zero).dy;
+    final visibleTop = viewportTop - stackTop;
+    _setToolbarGeometryIfNeeded(
+      toolbarHeight: toolbarHeight,
+      top: math.max(preferredTop, visibleTop),
+    );
+  }
+
+  void _setTopIfNeeded(double nextTop) {
+    if ((_effectiveTop - nextTop).abs() < 0.5) {
+      return;
+    }
+    setState(() {
+      _top = nextTop;
+    });
+  }
+
+  void _setToolbarGeometryIfNeeded({
+    required double toolbarHeight,
+    required double top,
+  }) {
+    final heightChanged = _toolbarHeight == null ||
+        (_toolbarHeight! - toolbarHeight).abs() >= 0.5;
+    final topChanged = (_effectiveTop - top).abs() >= 0.5;
+    if (!heightChanged && !topChanged) {
+      return;
+    }
+    setState(() {
+      _toolbarHeight = toolbarHeight;
+      _top = top;
+    });
+  }
+}
