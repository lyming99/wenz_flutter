 7205:   switch (CalloutBlockNode.normalizeVariant(variant)) {
 7206:     case CalloutBlockNode.successVariant:
 7207:       return scheme.tertiaryContainer.withAlpha(90);
 7208:     case 'warning':
 7209:       return Colors.amber
 7210:           .withAlpha(theme.brightness == Brightness.dark ? 64 : 48);
 7211:     case CalloutBlockNode.dangerVariant:
 7212:       return scheme.errorContainer.withAlpha(90);
 7213:     case CalloutBlockNode.infoVariant:
 7214:     default:
 7215:       return scheme.surfaceContainerHighest;
 7216:   }
 7217: }
