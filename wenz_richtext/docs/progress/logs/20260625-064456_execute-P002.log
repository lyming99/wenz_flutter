 7284: /// Builds the inline spans for a text block, overlaying the IME composition
 7285: /// decoration (underline) on the runs that fall inside [compositionRange].
 7286: _InlineTextLayout _inlineTextLayoutFor(
 7287:   BuildContext context,
 7288:   List<InlineNode> nodes,
 7289:   TextStyle baseStyle,
 7290:   _LocalSelectionRange? compositionRange,
 7291:   InlineEmbedRenderer? inlineEmbedRenderer,
 7292: ) {
 7293:   final spans = <InlineSpan>[];
 7294:   final segments = <_InlineOffsetSegment>[];
 7295:   var logicalCursor = 0;
 7296:   var renderCursor = 0;
 7297:   for (final node in nodes) {
 7298:     final logicalLength = inlineLength(node);
 7299:     final nodeStart = logicalCursor;
 7300:     final nodeEnd = logicalCursor + logicalLength;
 7301:     final overlapStart = compositionRange == null
 7302:         ? nodeStart
 7303:         : (nodeStart < compositionRange.start
 7304:             ? compositionRange.start
 7305:             : nodeStart);
 7306:     final overlapEnd = compositionRange == null
 7307:         ? nodeStart
 7308:         : (nodeEnd > compositionRange.end ? compositionRange.end : nodeEnd);
 7309:     final nodeSpans = compositionRange != null && overlapStart < overlapEnd
 7310:         ? _inlineSpansForNodeWithComposition(
 7311:             context,
 7312:             node,
 7313:             baseStyle,
 7314:             inlineEmbedRenderer,
 7315:             start: overlapStart - nodeStart,
 7316:             end: overlapEnd - nodeStart,
 7317:           )
 7318:         : <InlineSpan>[
 7319:             _inlineSpanFor(
 7320:               context,
 7321:               node,
 7322:               baseStyle,
 7323:               inlineEmbedRenderer,
 7324:               decorate: false,
 7325:             )
 7326:           ];
 7327:     final renderLength = _inlineSpanTextLength(nodeSpans);
 7328:     spans.addAll(nodeSpans);
 7329:     if (logicalLength > 0 || renderLength > 0) {
 7330:       segments.add(
 7331:         _InlineOffsetSegment(
 7332:           logicalStart: logicalCursor,
 7333:           logicalEnd: logicalCursor + logicalLength,
 7334:           renderStart: renderCursor,
 7335:           renderEnd: renderCursor + renderLength,
--- lib/src/widgets/wenz_rich_text_editor.dart:7335-7465
 7335:           renderEnd: renderCursor + renderLength,
 7336:           atomic: node is InlineEmbed,
 7337:         ),
 7338:       );
 7339:     }
 7340:     logicalCursor += logicalLength;
 7341:     renderCursor += renderLength;
 7342:   }
 7343:   return _InlineTextLayout(
 7344:     spans: spans,
 7345:     offsetMapper: _InlineOffsetMapper(
 7346:       segments: segments,
 7347:       logicalLength: logicalCursor,
 7348:       renderLength: renderCursor,
 7349:     ),
 7350:   );
 7351: }
