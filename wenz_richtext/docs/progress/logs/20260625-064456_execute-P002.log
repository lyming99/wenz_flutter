 7415: InlineSpan _inlineSpanFor(
 7416:   BuildContext context,
 7417:   InlineNode node,
 7418:   TextStyle baseStyle,
 7419:   InlineEmbedRenderer? inlineEmbedRenderer, {
 7420:   bool decorate = false,
 7421: }) {
 7422:   final undecoratedStyle = switch (node) {
 7423:     final TextRun textRun =>
 7424:       _textStyleForAttributes(baseStyle, textRun.attributes),
 7425:     final InlineEmbed embed =>
 7426:       _textStyleForAttributes(baseStyle, embed.attributes),
 7427:     _ => baseStyle,
 7428:   };
 7429:   final style =
 7430:       decorate ? _compositionTextStyle(undecoratedStyle) : undecoratedStyle;
 7431:   return switch (node) {
 7432:     final TextRun textRun => TextSpan(text: textRun.text, style: style),
 7433:     final InlineEmbed embed => _inlineEmbedSpanFor(
 7434:         context,
 7435:         embed,
 7436:         baseStyle,
 7437:         inlineEmbedRenderer,
 7438:         decorate: decorate,
 7439:       ),
 7440:     _ => TextSpan(text: node.plainText, style: style),
 7441:   };
 7442: }
