+  void _moveBlock(int fromIndex, int toIndex) {
+    final blocks = widget.controller.document.blocks;
+    if (fromIndex < 0 ||
+        fromIndex >= blocks.length ||
+        toIndex < 0 ||
+        toIndex >= blocks.length ||
+        fromIndex == toIndex) {
+      return;
+    }
+    final start = fromIndex < toIndex ? fromIndex : toIndex;
+    final first = blocks[start];
+    final second = blocks[start + 1];
+    final moved = blocks[fromIndex];
+    widget.controller.replaceBlocks(
+      index: start,
+      deleteCount: 2,
+      blocks: <BlockNode>[
+        if (fromIndex < toIndex) second.copy() else moved.copy(),
+        if (fromIndex < toIndex) moved.copy() else first.copy(),
+      ],
+      selection: _selectionForBlock(moved, toIndex),
+    );
+  }
+
+  void _deleteBlock(int blockIndex) {
+    final blocks = widget.controller.document.blocks;
+    if (blockIndex < 0 || blockIndex >= blocks.length) {
+      return;
+    }
+    if (blocks.length == 1) {
+      final replacement = TextBlockNode(
+        id: _nextBlockId(),
+        type: BlockType.paragraph,
+        content: const <InlineNode>[],
+      );
