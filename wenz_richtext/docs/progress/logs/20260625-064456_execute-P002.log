 7222:     case CalloutBlockNode.successVariant:
 7223:       return scheme.onTertiaryContainer;
 7224:     case CalloutBlockNode.warningVariant:
 7225:       return theme.brightness == Brightness.dark
 7226:           ? Colors.amber.shade200
 7227:           : Colors.amber.shade900;
 7228:     case CalloutBlockNode.dangerVariant:
 7229:       return scheme.onErrorContainer;
 7230:     case CalloutBlockNode.infoVariant:
 7231:     default:
 7232:       return scheme.onSurfaceVariant;
 7233:   }
