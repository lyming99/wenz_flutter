 6112: List<String> _underlinedTexts(InlineSpan span) {
 6113:   final result = <String>[];
 6114: 
 6115:   void visit(InlineSpan current, TextStyle? inheritedStyle) {
 6116:     if (current is! TextSpan) {
 6117:       return;
 6118:     }
 6119:     final style = current.style ?? inheritedStyle;
 6120:     final text = current.text;
 6121:     if (text != null &&
 6122:         text.isNotEmpty &&
 6123:         style?.decoration?.contains(TextDecoration.underline) == true) {
 6124:       result.add(text);
 6125:     }
 6126:     final children = current.children;
 6127:     if (children != null) {
 6128:       for (final child in children) {
 6129:         visit(child, style);
 6130:       }
 6131:     }
 6132:   }
 6133: 
 6134:   visit(span, null);
 6135:   return result;
 6136: }
