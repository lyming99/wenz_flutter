+    decorationColor: decorationColor,
+    decorationStyle:
+        hasRemark ? TextDecorationStyle.dotted : baseStyle.decorationStyle,
+    decorationThickness: hasRemark ? 2 : baseStyle.decorationThickness,
   );
 }
 
