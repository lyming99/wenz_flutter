 7353: int _inlineSpanTextLength(List<InlineSpan> spans) {
 7354:   var length = 0;
 7355:   for (final span in spans) {
 7356:     length += span.toPlainText().length;
 7357:   }
 7358:   return length;
 7359: }
 7360: 
 7361: List<InlineSpan> _inlineSpansForNodeWithComposition(
 7362:   BuildContext context,
 7363:   InlineNode node,
 7364:   TextStyle baseStyle,
 7365:   InlineEmbedRenderer? inlineEmbedRenderer, {
 7366:   required int start,
 7367:   required int end,
 7368: }) {
 7369:   if (node is TextRun) {
 7370:     final text = node.text;
 7371:     final safeStart = start.clamp(0, text.length).toInt();
 7372:     final safeEnd = end.clamp(safeStart, text.length).toInt();
 7373:     final style = _textStyleForAttributes(baseStyle, node.attributes);
 7374:     return <InlineSpan>[
 7375:       if (safeStart > 0)
 7376:         TextSpan(text: text.substring(0, safeStart), style: style),
 7377:       if (safeStart < safeEnd)
 7378:         TextSpan(
 7379:           text: text.substring(safeStart, safeEnd),
 7380:           style: _compositionTextStyle(style),
 7381:         ),
 7382:       if (safeEnd < text.length)
 7383:         TextSpan(text: text.substring(safeEnd), style: style),
 7384:     ];
 7385:   }
 7386: 
 7387:   if (node is InlineEmbed) {
 7388:     return <InlineSpan>[
 7389:       _inlineEmbedSpanFor(
 7390:         context,
 7391:         node,
 7392:         baseStyle,
 7393:         inlineEmbedRenderer,
 7394:         decorate: true,
 7395:       ),
 7396:     ];
 7397:   }
 7398: 
 7399:   final text = node.plainText;
 7400:   final safeStart = start.clamp(0, text.length).toInt();
 7401:   final safeEnd = end.clamp(safeStart, text.length).toInt();
 7402:   return <InlineSpan>[
 7403:     if (safeStart > 0)
 7404:       TextSpan(text: text.substring(0, safeStart), style: baseStyle),
 7405:     if (safeStart < safeEnd)
 7406:       TextSpan(
 7407:         text: text.substring(safeStart, safeEnd),
 7408:         style: _compositionTextStyle(baseStyle),
 7409:       ),
 7410:     if (safeEnd < text.length)
 7411:       TextSpan(text: text.substring(safeEnd), style: baseStyle),
 7412:   ];
 7413: }
