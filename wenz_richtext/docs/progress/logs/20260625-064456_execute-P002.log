 7736: /// Splits a code string into up to three spans, underlining the composition
 7737: /// region.
 7738: TextSpan _codeSpan(
 7739:   String code,
 7740:   String language,
 7741:   TextStyle codeStyle,
 7742:   ColorScheme colorScheme,
 7743:   _LocalSelectionRange? compositionRange,
 7744: ) {
 7745:   return CodeSyntaxHighlighter(
 7746:     language: language,
 7747:     baseStyle: codeStyle,
 7748:     palette: CodeSyntaxPalette.fromColorScheme(colorScheme),
 7749:     compositionStart: compositionRange?.start,
 7750:     compositionEnd: compositionRange?.end,
 7751:   ).highlight(code);
 7752: }
