9169`tTextStyle _blockTextStyle(
9170`t  BuildContext context,
9171`t  TextBlockNode block,
9172`t  TextStyle? textStyle,
9173`t) {
9174`t  final theme = Theme.of(context);
9175`t  final baseStyle = _richTextBodyStyle(theme, textStyle);
9176`t  return switch (block.type) {
9177`t    BlockType.heading => baseStyle.merge(
9178`t        _headingTextStyle(theme, baseStyle, block.attributes.level),
9179`t      ),
9180`t    BlockType.quote => baseStyle.merge(
9181`t        TextStyle(
9182`t          color: theme.colorScheme.onSurfaceVariant,
9183`t          fontStyle: FontStyle.italic,
9184`t        ),
9185`t      ),
9186`t    _ => baseStyle,
9187`t  };
