9123`tColor _calloutTint(String variant) {
9124`t  switch (CalloutBlockNode.normalizeVariant(variant)) {
9125`t    case CalloutBlockNode.successVariant:
9126`t      return const Color(_kCalloutSuccessBackgroundColor);
9127`t    case CalloutBlockNode.warningVariant:
9128`t      return const Color(_kCalloutWarningBackgroundColor);
9129`t    case CalloutBlockNode.dangerVariant:
9130`t      return const Color(_kCalloutDangerBackgroundColor);
9131`t    case CalloutBlockNode.infoVariant:
9132`t    default:
9133`t      return const Color(_kCalloutInfoBackgroundColor);
9134`t  }
9135`t}
