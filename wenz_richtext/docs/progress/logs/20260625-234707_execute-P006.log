5486`tTableCellRange? _activeTableRange(
5487`t  DocumentSelection? selection,
5488`t  TableBlockNode tableBlock,
5489`t  int blockIndex,
5490`t) {
5491`t  final range = selection?.tableCellRange;
5492`t  if (range == null ||
5493`t      range.tableBlockId != tableBlock.id ||
5494`t      range.blockIndex != blockIndex) {
5495`t    return null;
5496`t  }
5497`t  final rowCount = tableBlock.table.rowCount;
5498`t  final columnCount = tableBlock.table.columnCount;
5499`t  if (rowCount == 0 || columnCount == 0) {
5500`t    return null;
5501`t  }
5502`t  return TableCellRange(
5503`t    tableBlockId: tableBlock.id,
5504`t    blockIndex: blockIndex,
5505`t    startRow: range.startRow.clamp(0, rowCount - 1).toInt(),
5506`t    endRow: range.endRow.clamp(0, rowCount - 1).toInt(),
5507`t    startColumn: range.startColumn.clamp(0, columnCount - 1).toInt(),
5508`t    endColumn: range.endColumn.clamp(0, columnCount - 1).toInt(),
5509`t  );
