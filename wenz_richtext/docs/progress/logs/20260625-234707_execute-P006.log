9137`tColor _calloutForeground(String variant) {
9138`t  switch (CalloutBlockNode.normalizeVariant(variant)) {
9139`t    case CalloutBlockNode.successVariant:
9140`t      return const Color(_kCalloutSuccessForegroundColor);
9141`t    case CalloutBlockNode.warningVariant:
9142`t      return const Color(_kCalloutWarningForegroundColor);
9143`t    case CalloutBlockNode.dangerVariant:
9144`t      return const Color(_kCalloutDangerForegroundColor);
9145`t    case CalloutBlockNode.infoVariant:
9146`t    default:
9147`t      return const Color(_kCalloutInfoForegroundColor);
9148`t  }
9149`t}
