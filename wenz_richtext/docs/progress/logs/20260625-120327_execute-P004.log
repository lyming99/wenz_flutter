  757:             _lastScrollCheckedCaret = caretKey;
  758:             if (!skipCaretScroll) {
  759:               _scrollCaretIntoView();
  760:             }
  761:           }
  762:         } else {
  763:           _skipNextCaretScrollIntoView = false;
  764:           _lastScrollCheckedCaret = null;
  765:         }
  766:       });
  767:       setState(() {});
  768:     }
