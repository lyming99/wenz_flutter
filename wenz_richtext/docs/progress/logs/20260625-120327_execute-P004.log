  710:   void _handleControllerChanged() {
  711:     if (mounted) {
  712:       // Drop the cached laid-out painter for blocks whose content changed so a
  713:       // stale painter is not reused on the next build. Selection-only /
  714:       // composition-only changes (empty set) do not invalidate anything.
  715:       //
  716:       // The block *extent* cache is intentionally NOT invalidated here. While a
  717:       // block's text is being edited (most acutely during IME composition such
  718:       // as pinyin input) its content mutates on every keystroke, but its height
  719:       // barely changes. Dropping the cached height mid-edit would fall back to
  720:       // the document-wide average height for one frame, repositioning every
  721:       // following block — a visible flicker of the content below the caret. The
  722:       // real (possibly unchanged) height is reconciled on the next frame by the
  723:       // measured-block widget, so leaving the stale value yields one frame of a
  724:       // near-correct height instead of one frame of a wrong average.
  725:       final dirty = widget.controller.lastChangedBlockIds;
  726:       if (dirty == null) {
  727:         _extentCache.clear();
  728:       } else if (dirty.isNotEmpty) {
  729:         for (final id in dirty) {
  730:           _layoutCache.removeBlock(id);
  731:         }
  732:       }
