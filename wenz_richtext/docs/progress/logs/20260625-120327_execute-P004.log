  750:           final skipCaretScroll = _skipNextCaretScrollIntoView;
  751:           _skipNextCaretScrollIntoView = false;
  752:           final caretKey = _CaretKey(
  753:             selection!.extent.blockIndex,
  754:             selection.extent.offset,
  755:           );
