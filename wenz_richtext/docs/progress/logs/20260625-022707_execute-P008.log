 7055: Size _inlineFormulaPlaceholderSize(String formula, TextStyle style) {
 7056:   final fontSize = style.fontSize ?? 14;
 7057:   final runeCount = formula.trim().isEmpty ? 7 : formula.runes.length;
 7058:   final width = math.max(
 7059:     fontSize * 2.2,
 7060:     math.min(fontSize * 28, runeCount * fontSize * 0.62 + 12),
 7061:   );
 7062:   return Size(width, fontSize * 1.65);
 7063: }
 7064: 
 7065: String _formulaSourceText(
 7066:   Map<String, Object?> data, {
 7067:   String fallbackText = '',
 7068: }) {
 7069:   final fallback = fallbackText.trim();
 7070:   if (fallback.isNotEmpty) {
 7071:     return fallback;
 7072:   }
 7073:   for (final key in const <String>['text', 'latex', 'value', 'formula']) {
 7074:     final value = data[key];
 7075:     if (value != null && value.toString().trim().isNotEmpty) {
 7076:       return value.toString().trim();
 7077:     }
 7078:   }
 7079:   return '';
 7080: }
 7081: 
 7082: TextStyle _defaultInlineEmbedStyle(
 7083:   BuildContext context,
 7084:   InlineEmbed embed,
 7085:   TextStyle style,
 7086: ) {
 7087:   final scheme = Theme.of(context).colorScheme;
 7088:   return switch (embed.embedType) {
 7089:     'mention' => style.copyWith(
 7090:         color: scheme.primary,
 7091:         fontWeight: FontWeight.w600,
 7092:         backgroundColor: scheme.primaryContainer.withAlpha(80),
 7093:       ),
 7094:     'formula' => style.copyWith(
 7095:         color: scheme.onSecondaryContainer,
 7096:         backgroundColor: scheme.secondaryContainer.withAlpha(90),
 7097:         fontFamily: 'monospace',
 7098:       ),
 7099:     'emoji' => style,
 7100:     _ => style.copyWith(
 7101:         color: scheme.onSurfaceVariant,
 7102:         fontStyle: FontStyle.italic,
 7103:       ),
 7104:   };
 7105: }
 7106: 
 7107: TextStyle _compositionTextStyle(TextStyle style) {
 7108:   final decoration = style.decoration;
 7109:   return style.copyWith(
 7110:     decoration: decoration == null
 7111:         ? TextDecoration.underline
 7112:         : TextDecoration.combine(<TextDecoration>[
 7113:             decoration,
 7114:             TextDecoration.underline,
 7115:           ]),
 7116:   );
 7117: }
 7118: 
 7119: TextStyle _completedTodoTextStyle(BuildContext context, TextStyle baseStyle) {
 7120:   final decoration = baseStyle.decoration;
 7121:   return baseStyle.copyWith(
 7122:     color: Theme.of(context).colorScheme.onSurfaceVariant,
 7123:     decoration: decoration == null
 7124:         ? TextDecoration.lineThrough
 7125:         : TextDecoration.combine(<TextDecoration>[
 7126:             decoration,
 7127:             TextDecoration.lineThrough,
 7128:           ]),
 7129:   );
 7130: }
 7131: 
 7132: String _embedDisplayText(InlineEmbed embed) {
 7133:   return switch (embed.embedType) {
 7134:     'mention' => _mentionDisplayText(embed),
 7135:     'image' => '[img]',
 7136:     'formula' => _formulaDisplayText(embed),
 7137:     'emoji' => _emojiDisplayText(embed),
 7138:     _ => '[${embed.embedType}]',
 7139:   };
 7140: }
 7141: 
 7142: String _inlineDisplayText(InlineNode node) {
 7143:   return switch (node) {
 7144:     TextRun() => node.text,
 7145:     InlineEmbed() => _embedDisplayText(node),
 7146:     _ => node.plainText,
 7147:   };
 7148: }
 7149: 
 7150: String _mentionDisplayText(InlineEmbed embed) {
 7151:   final raw = embed.data['label'] ?? embed.data['id'];
 7152:   final label = raw?.toString() ?? '';
 7153:   return label.isEmpty ? '@mention' : '@$label';
 7154: }
