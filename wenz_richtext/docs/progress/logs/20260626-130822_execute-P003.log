9020: Future<void> _performPlatformSelectors(
9021:   WidgetTester tester,
9022:   List<String> selectors,
9023: ) async {
9024:   await tester.binding.defaultBinaryMessenger.handlePlatformMessage(
9025:     SystemChannels.textInput.name,
9026:     SystemChannels.textInput.codec.encodeMethodCall(
9027:       MethodCall('TextInputClient.performSelectors', <dynamic>[
9028:         -1,
9029:         selectors,
9030:       ]),
9031:     ),
9032:     (_) {},
9033:   );
9034: }
9035: 
9036: Future<void> _sendCtrlShortcut(
9037:   WidgetTester tester,
9038:   LogicalKeyboardKey key, {
9039:   bool shift = false,
9040: }) async {
9041:   await tester.sendKeyDownEvent(LogicalKeyboardKey.controlLeft);
9042:   if (shift) {
9043:     await tester.sendKeyDownEvent(LogicalKeyboardKey.shiftLeft);
9044:   }
9045:   await tester.sendKeyEvent(key);
9046:   if (shift) {
9047:     await tester.sendKeyUpEvent(LogicalKeyboardKey.shiftLeft);
9048:   }
9049:   await tester.sendKeyUpEvent(LogicalKeyboardKey.controlLeft);
9050: }
9051: 
9052: Future<void> _sendShiftArrowRight(WidgetTester tester) async {
9053:   await tester.sendKeyDownEvent(LogicalKeyboardKey.shiftLeft);
9054:   await tester.sendKeyEvent(LogicalKeyboardKey.arrowRight);
9055:   await tester.sendKeyUpEvent(LogicalKeyboardKey.shiftLeft);
9056:   await tester.pump();
9057: }
