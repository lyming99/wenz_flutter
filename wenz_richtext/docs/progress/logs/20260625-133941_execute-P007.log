                        id: 'cell-c-p',
                        type: BlockType.paragraph,
                        content: <InlineNode>[TextRun(text: 'CC')],
                      ),
                    ],
                  ),
                  TableCellNode(
                    id: 'cell-d',
                    blocks: <BlockNode>[
                      TextBlockNode(
                        id: 'cell-d-p',
                        type: BlockType.paragraph,
                        content: <InlineNode>[TextRun(text: 'DD')],
                      ),
                    ],
                  ),
                ],
              ],
            ),
          ),
