+        home: Scaffold(
+          body: WenzRichTextEditor(
+            controller: controller,
+            blockRenderers: registry,
+          ),
+        ),
+      ),
+    );
+    await tester.pump();
+
+    // The override rendered for the divider.
+    expect(
+      find.byWidgetPredicate(
+        (widget) =>
+            widget is ColoredBox && widget.color == const Color(0xFF123456),
+      ),
+      findsOneWidget,
