+              ),
+              TextRun(text: ' middle '),
+              InlineEmbed(
+                embedType: 'formula',
+                data: <String, Object?>{
+                  'text': r'\frac{\sum_{i=1}^{n} i}{\sqrt{n}}',
+                },
+              ),
+              TextRun(text: ' after'),
+            ],
+          ),
