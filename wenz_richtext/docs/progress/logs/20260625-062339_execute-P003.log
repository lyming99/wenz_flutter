-    await tester.sendKeyRepeatEvent(LogicalKeyboardKey.arrowRight);
-    await tester.pump();
-    expect(controller.selection?.extent.offset, 3);
-
-    await tester.sendKeyUpEvent(LogicalKeyboardKey.arrowRight);
-    await tester.pump();
-    expect(controller.selection?.extent.offset, 3);
-  });
