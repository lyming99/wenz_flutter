+        scheme.error,
+      );
+      expect(
+        _leafSpan(_richTextSpan(tester, markdownCode), '#')?.style?.color,
+        scheme.primary,
+      );
+      expect(
+        _leafSpan(_richTextSpan(tester, markdownCode), '`code`')?.style?.color,
+        scheme.tertiary,
+      );
+
+      final unsupportedSpan = _richTextSpan(tester, unsupportedCode);
