+            content: <InlineNode>[
+              TextRun(text: 'Before '),
+              InlineEmbed(
+                embedType: 'formula',
+                data: <String, Object?>{'text': 'x^2'},
+              ),
+              TextRun(text: ' middle '),
+              InlineEmbed(
+                embedType: 'formula',
+                data: <String, Object?>{
+                  'text': r'\frac{\sum_{i=1}^{n} i}{\sqrt{n}}',
+                },
+              ),
+              TextRun(text: ' after'),
+            ],
+          ),
+        ],
+      ),
+    );
+
+    await tester.pumpWidget(
+      MaterialApp(
+        home: Scaffold(
+          body: SizedBox(
+            width: 720,
+            height: 160,
+            child: WenzRichTextEditor(
+              controller: controller,
+              enableIme: false,
+            ),
+          ),
+        ),
+      ),
+    );
