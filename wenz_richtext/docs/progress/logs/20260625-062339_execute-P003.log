+  group('virtualisation', () {
+    RichTextDocument bigDocument({int count = 500}) {
+      return RichTextDocument(
+        blocks: <BlockNode>[
+          for (var i = 0; i < count; i++)
+            TextBlockNode(
+              id: 'p$i',
+              type: BlockType.paragraph,
+              content: <InlineNode>[TextRun(text: 'block-$i-content')],
+            ),
+        ],
+      );
+    }
