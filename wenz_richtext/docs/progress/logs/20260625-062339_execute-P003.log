-double _richTextFirstLineCenterY(WidgetTester tester, Finder finder) {
-  final richText = tester.widget<RichText>(finder);
-  final painter = _richTextPainter(tester, finder, richText);
-  final firstLine = painter.computeLineMetrics().first;
-  return tester.getTopLeft(finder).dy +
-      firstLine.baseline -
-      firstLine.ascent +
-      firstLine.height / 2;
-}
-
-int _richTextLineCount(WidgetTester tester, Finder finder) {
-  final richText = tester.widget<RichText>(finder);
-  return _richTextPainter(tester, finder, richText).computeLineMetrics().length;
-}
