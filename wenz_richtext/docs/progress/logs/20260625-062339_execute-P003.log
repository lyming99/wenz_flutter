+  testWidgets('keeps inline formulas centered and sizes tall formulas',
+      (tester) async {
+    const renderedText =
+        'Before $_formulaPlaceholder middle $_formulaPlaceholder after';
+    final controller = WenzRichTextController(
+      document: const RichTextDocument(
+        blocks: <BlockNode>[
+          TextBlockNode(
+            id: 'formula-baseline',
