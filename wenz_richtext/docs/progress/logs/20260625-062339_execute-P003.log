-        await tester.pump(const Duration(milliseconds: 16));
-      }
-      final scrollBeforeRelease = _scrollOffset(tester);
-
-      // Release the pointer — the ticker must stop.
-      await gesture.up();
-      await tester.pump();
-      final scrollAtRelease = _scrollOffset(tester);
