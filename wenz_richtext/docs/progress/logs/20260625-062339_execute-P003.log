+      expect(_leafSpan(dartSpan, 'final')?.style?.color, scheme.primary);
+      expect(_leafSpan(dartSpan, 'String')?.style?.color, scheme.secondary);
+      expect(_leafSpan(dartSpan, '42')?.style?.color, scheme.error);
+      expect(_leafSpan(dartSpan, '"Ada"')?.style?.color, scheme.tertiary);
+      expect(
+        _leafSpan(dartSpan, '// done')?.style?.color,
+        scheme.onSurfaceVariant,
+      );
+
+      expect(
+        _leafSpan(_richTextSpan(tester, jsCode), 'const')?.style?.color,
+        scheme.primary,
+      );
+      expect(
+        _leafSpan(_richTextSpan(tester, jsonCode), 'true')?.style?.color,
+        scheme.primary,
+      );
+      expect(
