+
+double _lineHeightFor(TextStyle style) {
+  final fontSize = style.fontSize ?? 14;
+  if (fontSize <= 0) {
+    return _kTodoCheckboxHeight;
+  }
+  return fontSize * (style.height ?? _kBlockMinHeightFactor);
+}
