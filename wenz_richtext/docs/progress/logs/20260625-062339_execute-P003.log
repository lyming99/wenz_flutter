-  testWidgets('block renderer registry overrides block rendering', (
-    tester,
-  ) async {
-    final controller = WenzRichTextController(
-      document: const RichTextDocument(
-        blocks: <BlockNode>[
-          TextBlockNode(
-            id: 'p1',
