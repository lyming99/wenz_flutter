+  testWidgets('keeps inline formulas centered and sizes tall formulas',
+      (tester) async {
+    const renderedText =
+        'Before $_formulaPlaceholder middle $_formulaPlaceholder after';
+    final controller = WenzRichTextController(
+      document: const RichTextDocument(
+        blocks: <BlockNode>[
+          TextBlockNode(
+            id: 'formula-baseline',
+            type: BlockType.paragraph,
+            content: <InlineNode>[
+              TextRun(text: 'Before '),
+              InlineEmbed(
+                embedType: 'formula',
+                data: <String, Object?>{'text': 'x^2'},
+              ),
+              TextRun(text: ' middle '),
+              InlineEmbed(
+                embedType: 'formula',
+                data: <String, Object?>{
+                  'text': r'\frac{\sum_{i=1}^{n} i}{\sqrt{n}}',
+                },
+              ),
+              TextRun(text: ' after'),
+            ],
+          ),
+        ],
+      ),
+    );
+
+    await tester.pumpWidget(
+      MaterialApp(
+        home: Scaffold(
+          body: SizedBox(
+            width: 720,
+            height: 160,
+            child: WenzRichTextEditor(
+              controller: controller,
+              enableIme: false,
+            ),
+          ),
+        ),
+      ),
+    );
+    await tester.pump();
+
+    final formulaFinder = find.byKey(_inlineFormulaKey);
+    expect(formulaFinder, findsNWidgets(2));
+    final textRect = tester.getRect(_richText(renderedText));
+    final textCenterY = textRect.center.dy;
+    final normalFormulaRect = tester.getRect(formulaFinder.at(0));
+    final tallFormulaRect = tester.getRect(formulaFinder.at(1));
+    final normalFormulaCenterOffset = normalFormulaRect.center.dy - textCenterY;
+    final tallFormulaCenterOffset = tallFormulaRect.center.dy - textCenterY;
+
+    expect(normalFormulaRect.height, moreOrLessEquals(20.3, epsilon: 0.1));
+    expect(tallFormulaRect.height, greaterThan(normalFormulaRect.height + 12));
+    expect(tallFormulaRect.height, lessThan(48));
+    expect(normalFormulaCenterOffset, moreOrLessEquals(0, epsilon: 0.75));
+    expect(tallFormulaCenterOffset, moreOrLessEquals(0, epsilon: 0.75));
+  });
