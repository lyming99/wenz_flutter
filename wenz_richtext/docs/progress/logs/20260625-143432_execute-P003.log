+              _button(
+                icon: Icons.format_align_right,
+                tooltip: '列右对齐',
+                action: TableToolbarAction.alignRight,
+              ),
+              _button(
+                icon: Icons.format_align_justify,
+                tooltip: '清除列对齐',
+                action: TableToolbarAction.clearAlignment,
+              ),
+              _divider(theme),
+              _button(
