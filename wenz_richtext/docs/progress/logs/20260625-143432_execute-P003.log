300:/// Exposes the editor's [SharedTextLayoutCache] down the subtree so each
301:/// [_TextSelectionSurface] can fetch (and reuse) its [TextLayoutService] across
302:/// remount, without threading the cache through every renderer widget.
303:class _SharedLayoutCacheScope extends InheritedWidget {
304:  const _SharedLayoutCacheScope({required this.cache, required super.child});
305:
306:  final SharedTextLayoutCache cache;
307:
308:  static SharedTextLayoutCache? of(BuildContext context) {
309:    final scope =
310:        context.dependOnInheritedWidgetOfExactType<_SharedLayoutCacheScope>();
311:    return scope?.cache;
312:  }
313:
314:  @override
315:  bool updateShouldNotify(_SharedLayoutCacheScope oldWidget) =>
316:      cache != oldWidget.cache;
317:}
