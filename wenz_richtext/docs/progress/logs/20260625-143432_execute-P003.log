5119:double _measureInlineSpanWidth(InlineSpan span, TextDirection textDirection) {
5120:  final painter = TextPainter(
5121:    text: span,
5122:    textDirection: textDirection,
5123:  )..layout(maxWidth: double.infinity);
5124:  final width = painter.width;
5125:  painter.dispose();
5126:  return width.isFinite ? width : 0;
5127:}
