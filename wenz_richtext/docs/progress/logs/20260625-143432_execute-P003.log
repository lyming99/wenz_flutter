+      fontSize: textStyle.fontSize ?? 14,
+    );
+    if (source.isEmpty) {
+      return _FormulaFallbackText(formula: '[formula]', textStyle: style);
+    }
+    return Math.tex(
+      source,
+      mathStyle: displayMode ? MathStyle.display : MathStyle.text,
+      textStyle: style,
+      textScaleFactor: 1,
+      settings: const TexParserSettings(strict: Strict.ignore),
+      options: MathOptions(
