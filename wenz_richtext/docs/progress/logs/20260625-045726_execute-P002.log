1079:   void _pasteInline(List<InlineNode> runs) {
1080:     if (runs.isEmpty) {
1081:       return;
1082:     }
1083:     // Insert each run at the current caret; InsertTextCommand handles attribute
1084:     // preservation per run, and InsertInlineEmbedCommand re-inserts embeds
1085:     // (formula/mention/image) so rich inline elements survive paste. Inserting
1086:     // as separate commands lets them coalesce only when attributes match.
1087:     for (final run in runs) {
1088:       if (run is TextRun) {
1089:         if (run.text.isEmpty) {
1090:           continue;
1091:         }
1092:         insertText(
1093:           run.text,
1094:           attributes: run.attributes,
1095:           applyMarkdownShortcuts: false,
1096:         );
