791: class ReplaceBlocksCommand extends EditorCommand {
792:   const ReplaceBlocksCommand({
793:     required this.index,
794:     required this.deleteCount,
795:     required this.blocks,
796:     this.selection,
797:   });
798: 
799:   final int index;
800:   final int deleteCount;
801:   final List<BlockNode> blocks;
802:   final DocumentSelection? selection;
803: 
804:   @override
805:   String get description => 'replaceBlocks';
806: 
807:   @override
808:   CommandResult execute(DocumentSession session) {
809:     if (index < 0 || index > session.document.blocks.length) {
810:       return const CommandResult(recordHistory: false);
811:     }
812:     final safeDeleteCount =
813:         deleteCount.clamp(0, session.document.blocks.length - index).toInt();
814:     final nextBlocks = <BlockNode>[
815:       for (var i = 0; i < index; i++) session.document.blocks[i].copy(),
816:       ...blocks.map((block) => block.copy()),
817:       for (var i = index + safeDeleteCount;
818:           i < session.document.blocks.length;
819:           i++)
820:         session.document.blocks[i].copy(),
821:     ];
822:     session.document = RichTextDocument(
823:       version: session.document.version,
824:       blocks: nextBlocks,
825:     );
826:     return CommandResult(selection: selection);
827:   }
828: }
