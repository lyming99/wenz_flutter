+class UpdateVideoBlockCommand extends EditorCommand {
+  const UpdateVideoBlockCommand({
+    required this.blockIndex,
+    this.assetId,
+    this.playbackUrl,
+    this.file,
+    this.coverUrl,
+    this.title,
+    this.description,
