607:   }
608:   if (block is CodeBlockNode) {
609:     return CodeBlockNode(
610:       id: id,
611:       code: block.code,
612:       language: block.language,
613:       attributes: block.attributes,
614:     );
615:   }
616:   if (block is ImageBlockNode) {
617:     return ImageBlockNode(
618:       id: id,
619:       assetId: block.assetId,
620:       file: block.file,
621:       width: block.width,
622:       height: block.height,
623:       showWidth: block.showWidth,
624:       showHeight: block.showHeight,
625:       caption: block.caption,
626:       altText: block.altText,
627:       attributes: block.attributes,
628:     );
629:   }
630:   if (block is TableBlockNode) {
631:     return TableBlockNode(
632:       id: id,
633:       table: _copyTableForPaste(block.table, ids),
634:       attributes: block.attributes,
635:     );
636:   }
637:   if (block is DividerBlockNode) {
638:     return DividerBlockNode(id: id, attributes: block.attributes);
639:   }
640:   if (block is VideoBlockNode) {
641:     return VideoBlockNode(
642:       id: id,
643:       assetId: block.assetId,
644:       file: block.file,
645:       attributes: block.attributes,
646:     );
647:   }
648:   if (block is BlockEmbedNode) {
649:     return BlockEmbedNode(
650:       id: id,
651:       embedType: block.embedType,
652:       data: Map<String, Object?>.from(block.data),
653:       fallbackText: block.fallbackText,
654:       attributes: block.attributes,
655:     );
656:   }
657:   if (block is CalloutBlockNode) {
658:     return CalloutBlockNode(
659:       id: id,
660:       content: block.content.map((node) => node.copy()).toList(),
661:       variant: block.variant,
662:       title: block.title,
663:       icon: block.icon,
664:       attributes: block.attributes,
665:     );
666:   }
667:   if (block is FileBlockNode) {
668:     return FileBlockNode(
669:       id: id,
670:       assetId: block.assetId,
671:       name: block.name,
672:       size: block.size,
673:       mimeType: block.mimeType,
674:       file: block.file,
675:       downloadUrl: block.downloadUrl,
676:       uploadStatus: block.uploadStatus,
677:       uploadError: block.uploadError,
678:       attributes: block.attributes,
679:     );
680:   }
681:   return block.copy();
682: }
