13: class InsertBlocksCommand extends EditorCommand {
14:   const InsertBlocksCommand({
15:     required this.index,
16:     required this.blocks,
17:     this.selection,
18:   });
19: 
20:   final int index;
21:   final List<BlockNode> blocks;
22:   final DocumentSelection? selection;
23: 
24:   @override
25:   String get description => 'insertBlocks';
26: 
27:   @override
28:   CommandResult execute(DocumentSession session) {
29:     if (blocks.isEmpty) {
30:       return const CommandResult(recordHistory: false);
31:     }
32:     final insertIndex = index.clamp(0, session.document.blocks.length).toInt();
33:     final replacementIndex = _emptyParagraphReplacementIndex(
34:       session,
35:       insertIndex,
36:       blocks,
37:     );
38:     if (replacementIndex != null) {
39:       final nextBlocks = <BlockNode>[
40:         for (var i = 0; i < replacementIndex; i++)
41:           session.document.blocks[i].copy(),
42:         ...blocks.map((block) => block.copy()),
43:         for (var i = replacementIndex + 1;
44:             i < session.document.blocks.length;
45:             i++)
46:           session.document.blocks[i].copy(),
47:       ];
48:       session.document = RichTextDocument(
49:         version: session.document.version,
50:         blocks: nextBlocks,
51:       );
52:       return CommandResult(
53:         selection: selection ??
54:             _defaultSelectionForInsertedBlock(replacementIndex, blocks.first),
55:       );
56:     }
57:     final splitInsertion = _splitInsertionAtCaret(
58:       session,
59:       insertIndex,
60:       blocks,
61:     );
62:     if (splitInsertion != null) {
63:       final nextBlocks = <BlockNode>[
64:         for (var i = 0; i < splitInsertion.replacedIndex; i++)
65:           session.document.blocks[i].copy(),
66:         ...splitInsertion.replacementBlocks,
67:         for (var i = splitInsertion.replacedIndex + 1;
68:             i < session.document.blocks.length;
69:             i++)
70:           session.document.blocks[i].copy(),
71:       ];
72:       session.document = RichTextDocument(
73:         version: session.document.version,
74:         blocks: nextBlocks,
75:       );
76:       return CommandResult(
77:         selection: selection ??
78:             _defaultSelectionForInsertedBlock(
79:               splitInsertion.insertedIndex,
80:               blocks.first,
81:             ),
82:       );
83:     }
84:     final nextBlocks = <BlockNode>[
85:       for (var i = 0; i < insertIndex; i++) session.document.blocks[i].copy(),
86:       ...blocks.map((block) => block.copy()),
87:       for (var i = insertIndex; i < session.document.blocks.length; i++)
88:         session.document.blocks[i].copy(),
89:     ];
90:     session.document = RichTextDocument(
91:       version: session.document.version,
92:       blocks: nextBlocks,
93:     );
94:     return CommandResult(selection: selection);
95:   }
96: }
