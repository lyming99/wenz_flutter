+      expect(video.aspectRatio, 4 / 3);
+      expect(video.uploadStatus, FileUploadStatus.uploading);
+      expect(controller.selection?.start.blockId, 'video1');
+      expect(controller.selection?.start.path.isBlockObject, isTrue);
