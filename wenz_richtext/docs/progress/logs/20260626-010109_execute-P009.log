10565: 
10566: String _fileStatusText(FileBlockNode file) {
10567:   final status = _fileUploadStatusLabel(file.uploadStatus);
10568:   if (status.isEmpty) {
10569:     return '';
10570:   }
10571:   final error = file.uploadError.trim();
10572:   if (file.uploadStatus == FileUploadStatus.failed && error.isNotEmpty) {
10573:     return '$status · $error';
10574:   }
10575:   return status;
10576: }
10577: 
10578: String _fileTypeLabel(FileBlockNode file) {
10579:   final displayName = file.displayName.trim();
10580:   final extension = _fileTypeSegment(displayName);
10581:   if (extension.isNotEmpty) {
10582:     return extension;
10583:   }
10584:   final mimeType = file.mimeType.trim();
10585:   if (mimeType.isNotEmpty) {
10586:     final subtype = mimeType.contains('/')
10587:         ? mimeType.substring(mimeType.indexOf('/') + 1)
10588:         : mimeType;
10589:     final cleaned = _normalizeFileTypeLabel(
10590:       subtype.split(RegExp(r'[+;]')).first,
10591:     );
10592:     if (cleaned.isNotEmpty) {
10593:       return cleaned;
10594:     }
10595:   }
10596:   return 'FILE';
10597: }
10598: 
10599: String _fileTypeSegment(String displayName) {
10600:   final cleanName = displayName.split('?').first.trim();
10601:   final dot = cleanName.lastIndexOf('.');
10602:   if (dot < 0 || dot == cleanName.length - 1) {
10603:     return '';
10604:   }
10605:   return _normalizeFileTypeLabel(cleanName.substring(dot + 1));
10606: }
10607: 
10608: String _normalizeFileTypeLabel(String value) {
10609:   final cleaned = value.replaceAll(RegExp(r'[^A-Za-z0-9]'), '').trim();
10610:   if (cleaned.isEmpty) {
10611:     return '';
10612:   }
10613:   final truncated = cleaned.length > 4 ? cleaned.substring(0, 4) : cleaned;
10614:   return truncated.toUpperCase();
10615: }
10616: 
10617: String _fileUploadStatusLabel(FileUploadStatus status) {
10618:   return switch (status) {
10619:     FileUploadStatus.none => '',
10620:     FileUploadStatus.pending => 'Pending upload',
10621:     FileUploadStatus.uploading => 'Uploading',
10622:     FileUploadStatus.uploaded => 'Uploaded',
10623:     FileUploadStatus.failed => 'Upload failed',
10624:   };
10625: }

