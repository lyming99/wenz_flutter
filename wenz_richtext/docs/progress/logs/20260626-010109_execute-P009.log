+  final aspectRatio = _safeVideoAspectRatio(block.effectiveAspectRatio);
+  unawaited(
+    showDialog<void>(
+      context: context,
+      builder: (context) {
+        return Dialog(
+          clipBehavior: Clip.antiAlias,
+          child: ConstrainedBox(
+            constraints: const BoxConstraints(maxWidth: 720, maxHeight: 560),
+            child: Semantics(
