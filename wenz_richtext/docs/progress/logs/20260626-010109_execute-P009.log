8443: class _ObjectBlockToolbar extends StatelessWidget {
8444:   const _ObjectBlockToolbar({
8445:     required this.blockIndex,
8446:     required this.blockCount,
8447:     required this.canEdit,
8448:     required this.imageActions,
8449:     required this.fileActions,
8450:     this.onAction,
8451:   });
8452: 
8453:   final int blockIndex;
8454:   final int blockCount;
8455:   final bool canEdit;
8456:   final bool imageActions;
8457:   final bool fileActions;
8458:   final ObjectBlockActionHandler? onAction;
8459: 
8460:   @override
8461:   Widget build(BuildContext context) {
8462:     final canDispatch = onAction != null;
8463:     final canRunMutation = canEdit && canDispatch;
8464:     final hasMoreActions =
8465:         canRunMutation && (blockCount > 1 || imageActions || fileActions);
8466:     return Wrap(
8467:       spacing: 2,
8468:       crossAxisAlignment: WrapCrossAlignment.center,
8469:       children: <Widget>[
8470:         _ObjectActionButton(
8471:           icon: Icons.copy,
8472:           tooltip: '复制块引用',
8473:           onPressed: canDispatch
8474:               ? () => _dispatch(ObjectBlockAction.copyReference)
8475:               : null,
8476:         ),
8477:         if (canEdit) ...<Widget>[
8478:           _ObjectActionButton(
8479:             icon: Icons.content_copy,
8480:             tooltip: '创建块副本',
8481:             onPressed: canRunMutation
8482:                 ? () => _dispatch(ObjectBlockAction.duplicate)
8483:                 : null,
8484:           ),
8485:           if (hasMoreActions)
8486:             _ObjectMoreMenu(
8487:               blockIndex: blockIndex,
8488:               blockCount: blockCount,
8489:               canRunMutation: canRunMutation,
8490:               imageActions: imageActions,
8491:               fileActions: fileActions,
8492:               onSelected: _dispatchSelection,
8493:             ),
8494:           _ObjectActionButton(
8495:             icon: Icons.delete_outline,
8496:             tooltip: '删除块',
8497:             onPressed: canRunMutation
8498:                 ? () => _dispatch(ObjectBlockAction.delete)
8499:                 : null,
8500:           ),
8501:         ],
8502:       ],
8503:     );
8504:   }
8505: 
8506:   void _dispatchSelection(_ObjectMenuSelection selection) {
8507:     final action = selection.action;
8508:     if (action != null) {
8509:       _dispatch(action, selection.value);
8510:     }
8511:   }
8512: 
8513:   void _dispatch(ObjectBlockAction action, [Object? value]) {
8514:     onAction?.call(
8515:       ObjectBlockActionIntent(
8516:         action: action,
8517:         blockIndex: blockIndex,
8518:         value: value,
8519:       ),
8520:     );
8521:   }
8522: }
8523: 
