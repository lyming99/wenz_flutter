+            constraints: const BoxConstraints(maxWidth: 720, maxHeight: 560),
+            child: Semantics(
+              label: _videoAccessibleLabel(block),
+              image: true,
+              child: AspectRatio(
+                aspectRatio: aspectRatio,
+                child: media,
+              ),
+            ),
+          ),
+        );
+      },
+    ),
+  );
+}
