+            child: Semantics(
+              label: label,
+              image: true,
+              child: InteractiveViewer(
+                minScale: 0.5,
+                maxScale: 4,
+                child: Center(child: media),
+              ),
+            ),
+          ),
+        );
+      },
+    ),
+  );
+}
+
+void _showVideoPreview(
+  BuildContext context,
+  VideoBlockNode block,
+  BlockRenderContext rc,
+) {
+  final media =
