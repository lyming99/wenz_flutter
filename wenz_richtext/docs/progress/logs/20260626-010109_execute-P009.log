6620:   int _offsetForLocalPosition(Offset localPosition) {
6621:     final box = _surfaceKey.currentContext?.findRenderObject();
6622:     final width = box is RenderBox && box.hasSize ? box.size.width : 0.0;
6623:     if (width <= 0) {
6624:       return 0;
6625:     }
6626:     final after = switch (Directionality.of(context)) {
6627:       TextDirection.ltr => localPosition.dx >= width / 2,
6628:       TextDirection.rtl => localPosition.dx < width / 2,
6629:     };
6630:     return after ? _kAtomicBlockSelectionLength : 0;
