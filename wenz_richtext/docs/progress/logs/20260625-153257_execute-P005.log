 4106: double _spacingBetweenBlocks(
 4107:   BlockNode previous,
 4108:   BlockNode next,
 4109:   double fallback,
 4110: ) {
 4111:   if ((fallback - _kDefaultBlockSpacing).abs() > 0.01) {
 4112:     return fallback;
 4113:   }
 4114:   if (_isListItemBlock(previous) && _isListItemBlock(next)) {
 4115:     final previousIndent = _blockIndentLevel(previous);
 4116:     final nextIndent = _blockIndentLevel(next);
 4117:     return previousIndent > 0 || nextIndent > 0
 4118:         ? _kNestedListItemSpacing
 4119:         : _kListItemSpacing;
 4120:   }
 4121:   return math.max(
 4122:     _blockMarginAfter(previous, fallback),
 4123:     _blockMarginBefore(next, fallback),
 4124:   );
 4125: }
 4126: 
 4127: double _blockMarginBefore(BlockNode block, double fallback) {
 4128:   if (block is TextBlockNode && block.type == BlockType.heading) {
 4129:     return _kRichTextBodyFontSize * _kHeadingMarginTopEm;
 4130:   }
 4131:   return fallback;
 4132: }
