 4134: double _blockMarginAfter(BlockNode block, double fallback) {
 4135:   if (block is TextBlockNode && block.type == BlockType.heading) {
 4136:     return _kRichTextBodyFontSize * _kHeadingMarginBottomEm;
 4137:   }
 4138:   return fallback;
