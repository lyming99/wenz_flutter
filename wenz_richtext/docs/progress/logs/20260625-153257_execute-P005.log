 1127:   Offset _slashMenuOffset() {
 1128:     final fallback = widget.padding.resolve(TextDirection.ltr).topLeft;
 1129:     final selection = widget.controller.selection;
 1130:     final overlayContext = _editorOverlayKey.currentContext;
 1131:     final overlayBox = overlayContext?.findRenderObject();
 1132:     if (selection == null ||
 1133:         !selection.isCollapsed ||
 1134:         overlayBox is! RenderBox ||
 1135:         !overlayBox.hasSize) {
 1136:       return fallback;
 1137:     }
 1138:     final caret = _registry.caretRectForPosition(selection.extent);
 1139:     if (caret == null) {
 1140:       return fallback;
 1141:     }
 1142:     final local = overlayBox.globalToLocal(caret.bottomLeft);
 1143:     final maxLeft = overlayBox.size.width - 280;
 1144:     return Offset(
 1145:       local.dx.clamp(0, maxLeft > 0 ? maxLeft : 0).toDouble(),
 1146:       (local.dy + 6).clamp(0, overlayBox.size.height).toDouble(),
 1147:     );
 1148:   }
