 9681: int? _caretOffsetForPath(
 9682:   DocumentSelection? selection,
 9683:   bool showCaret,
 9684:   String blockId,
 9685:   PositionPath path,
 9686:   int textLength,
 9687: ) {
 9688:   if (!showCaret || selection == null || !selection.isCollapsed) {
 9689:     return null;
 9690:   }
 9691:   final position = selection.extent;
 9692:   if (position.blockId != blockId || position.path != path) {
 9693:     return null;
 9694:   }
 9695:   return position.offset.clamp(0, textLength).toInt();
 9696: }
 9697: 
 9698: bool _selectionTouchesPath(
 9699:   DocumentSelection? selection,
 9700:   int blockIndex,
 9701:   String blockId,
 9702:   PositionPath path,
 9703:   int textLength,
 9704: ) {
 9705:   if (selection == null) {
 9706:     return false;
 9707:   }
 9708:   if (_selectionRangeForPath(selection, blockIndex, path, textLength) != null) {
 9709:     return true;
 9710:   }
 9711:   if (!selection.isCollapsed) {
 9712:     return false;
 9713:   }
 9714:   final position = selection.extent;
 9715:   return position.blockId == blockId && position.path == path;
 9716: }
