1043:
1044:/// Whether [position] sits on a non-editable leaf that is the document's last
1045:/// block, so forward caret motion should escape it by appending a paragraph.
1046:///
1047:/// Two cases:
1048:/// - An object block (image/divider/video/file) that is the final block. The
1049:///   caret cannot live "inside" it, so Down/Right off it would otherwise stall.
1050:/// - A table cell on the table's last row *and* last column when the table is
1051:///   the final block.
1052:///
1053:/// Editable blocks (paragraph/code) are excluded on purpose: Enter or typing
1054:/// already adds content there, and we must not auto-append a paragraph just
1055:/// because the user arrowed off the end of a normal text block.
1056:bool _isAtTrailingLeaf(RichTextDocument document, DocumentPosition position) {
1057:  final block = _blockAt(document, position.blockIndex);
1058:  if (block == null) {
1059:    return false;
1060:  }
1061:  final isLastBlock = position.blockIndex == document.blocks.length - 1;
1062:  if (position.path.isBlockObject) {
1063:    return isLastBlock;
1064:  }
1065:  if (position.path.isTableCellText && block is TableBlockNode) {
1066:    final rowIndex = position.path.tableRowIndex;
1067:    final columnIndex = position.path.tableColumnIndex;
1068:    if (rowIndex == null || columnIndex == null) {
1069:      return false;
1070:    }
1071:    return isLastBlock &&
1072:        rowIndex == block.table.rowCount - 1 &&
1073:        columnIndex == block.table.columnCount - 1;
1074:  }
1075:  return false;
1076:}
1077:
1078:/// Appends an empty paragraph after [afterBlockIndex] and returns a collapsed
1079:/// selection inside it. Used as the escape hatch when forward caret motion runs
1080:/// off the end of a trailing object/table block (mirrors the
1081:/// `_insertRowAfterLastCell` pattern for Tab on the last table cell). Returns
1082:/// `null` when there is no block to append after.
1083:DocumentSelection? _appendParagraphAfter(
1084:  DocumentSession session,
1085:  int afterBlockIndex,
1086:) {
1087:  if (afterBlockIndex < 0 ||
1088:      afterBlockIndex >= session.document.blocks.length) {
1089:    return null;
1090:  }
1091:  final afterBlock = session.document.blocks[afterBlockIndex];
1092:  final nextBlockId = '${afterBlock.id}-next';
1093:  final nextBlockIndex = afterBlockIndex + 1;
1094:  final nextPosition = DocumentPosition.text(
1095:    blockId: nextBlockId,
1096:    blockIndex: nextBlockIndex,
1097:    offset: 0,
1098:  );
1099:  InsertBlocksCommand(
1100:    index: nextBlockIndex,
1101:    blocks: <BlockNode>[
1102:      TextBlockNode(
1103:        id: nextBlockId,
1104:        type: BlockType.paragraph,
1105:        content: const <InlineNode>[],
1106:      ),
1107:    ],
1108:    selection: DocumentSelection(base: nextPosition, extent: nextPosition),
1109:  ).execute(session);
1110:  // InsertBlocksCommand does not set session.selection itself (only the
1111:  // executor does), so set it here so the caller's returned selection is real.
1112:  session.selection =
1113:      DocumentSelection(base: nextPosition, extent: nextPosition);
1114:  return session.selection;
1115:}
