 1935:   bool _handleSlashMenuKeyEvent(KeyEvent event) {
 1936:     final slashMenu = widget.slashMenuController;
 1937:     if (slashMenu == null || !slashMenu.isOpen) {
 1938:       return false;
 1939:     }
 1940:     if (event is! KeyDownEvent && event is! KeyRepeatEvent) {
 1941:       return false;
 1942:     }
 1943:     final key = event.logicalKey;
 1944:     if (key == LogicalKeyboardKey.arrowDown) {
 1945:       slashMenu.moveHighlight(1);
 1946:       return true;
 1947:     }
 1948:     if (key == LogicalKeyboardKey.arrowUp) {
 1949:       slashMenu.moveHighlight(-1);
 1950:       return true;
 1951:     }
 1952:     if (key == LogicalKeyboardKey.enter ||
 1953:         key == LogicalKeyboardKey.numpadEnter) {
 1954:       slashMenu.activateHighlighted();
 1955:       return true;
 1956:     }
 1957:     if (key == LogicalKeyboardKey.escape) {
 1958:       slashMenu.close();
 1959:       return true;
 1960:     }
 1961:     return false;
 1962:   }
