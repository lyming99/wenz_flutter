 1907:   bool _handleCodeBlockTabKeyEvent(KeyEvent event) {
 1908:     if (widget.readOnly ||
 1909:         (event is! KeyDownEvent && event is! KeyRepeatEvent) ||
 1910:         event.logicalKey != LogicalKeyboardKey.tab) {
 1911:       return false;
 1912:     }
 1913:     final selection = widget.controller.selection;
 1914:     if (selection == null ||
 1915:         selection.start.blockIndex != selection.end.blockIndex ||
 1916:         selection.start.path != selection.end.path ||
 1917:         !selection.start.path.isBlockCode) {
 1918:       return false;
 1919:     }
 1920:     if (selection.start.blockIndex < 0 ||
 1921:         selection.start.blockIndex >=
 1922:             widget.controller.document.blocks.length) {
 1923:       return false;
 1924:     }
 1925:     final block = widget.controller.document.blocks[selection.start.blockIndex];
 1926:     if (block is! CodeBlockNode) {
 1927:       return false;
 1928:     }
 1929:     widget.controller.indentCodeBlock(
 1930:       outdent: HardwareKeyboard.instance.isShiftPressed,
 1931:     );
 1932:     return true;
 1933:   }
