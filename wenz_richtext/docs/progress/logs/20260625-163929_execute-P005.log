 4440:   final selected = _selectionTouchesPath(
 4441:     rc.selection,
 4442:     rc.blockIndex,
 4443:     block.id,
 4444:     path,
 4445:     _kAtomicBlockSelectionLength,
 4446:   );
 4447:   return _withBlockSemantics(
 4448:     block,
 4449:     _BlockObjectSelectionSurface(
 4450:       blockId: block.id,
 4451:       blockIndex: rc.blockIndex,
 4452:       path: path,
 4453:       selection: rc.selection,
 4454:       registry: rc.registry,
 4455:       showDebugOverlay: rc.showDebugOverlay,
 4456:       child: child,
 4457:     ),
 4458:     selected: selected,
 4459:   );
 4460: }
