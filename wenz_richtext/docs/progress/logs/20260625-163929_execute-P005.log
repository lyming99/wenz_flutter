 4507: class _TextBlockRenderer extends StatelessWidget {
 4508:   const _TextBlockRenderer({
 4509:     required this.block,
 4510:     required this.blockIndex,
 4511:     required this.selection,
 4512:     required this.compositionState,
 4513:     required this.registry,
 4514:     required this.showCaret,
 4515:     this.textStyle,
 4516:     this.showDebugOverlay = false,
 4517:     this.listMarker,
 4518:     this.inlineEmbedRenderer,
 4519:     this.headingCollapseState,
 4520:     this.onHeadingCollapseToggled,
 4521:     this.onToolbarAction,
 4522:     this.onColumnResize,
 4523:     this.onTodoCheckedChanged,
 4524:     this.findMatches = const <FindReplaceMatch>[],
 4525:     this.currentFindMatch,
 4526:   });
 4527: 
 4528:   final TextBlockNode block;
 4529:   final int blockIndex;
 4530:   final DocumentSelection? selection;
 4531:   final CompositionState? compositionState;
 4532:   final BlockGeometryRegistry registry;
 4533:   final bool showCaret;
 4534:   final TextStyle? textStyle;
 4535:   final bool showDebugOverlay;
 4536:   final String? listMarker;
 4537:   final InlineEmbedRenderer? inlineEmbedRenderer;
 4538:   final HeadingCollapseState? headingCollapseState;
 4539:   final ValueChanged<String>? onHeadingCollapseToggled;
 4540:   final TableToolbarActionHandler? onToolbarAction;
 4541:   final TableColumnResizeHandler? onColumnResize;
 4542:   final TodoCheckedChangeHandler? onTodoCheckedChanged;
 4543:   final List<FindReplaceMatch> findMatches;
 4544:   final FindReplaceMatch? currentFindMatch;
 4545: 
 4546:   @override
 4547:   Widget build(BuildContext context) {
 4548:     final isTaskListItem =
 4549:         block.type == BlockType.listItem && block.attributes.listType == 'task';
 4550:     final isTaskChecked = block.attributes.checked == true;
 4551:     final baseStyle = _blockTextStyle(context, block, textStyle);
 4552:     final todoStyle = isTaskListItem ? _todoTextStyle(baseStyle) : baseStyle;
 4553:     final effectiveStyle = isTaskListItem && isTaskChecked
 4554:         ? _completedTodoTextStyle(context, todoStyle)
 4555:         : todoStyle;
 4556:     final compositionRange = _localCompositionRange(
 4557:       compositionState,
 4558:       block.id,
 4559:       blockIndex,
 4560:       PositionPath.blockText(block.id),
 4561:     );
 4562:     final path = PositionPath.blockText(block.id);
 4563:     final textLength = inlineNodesLength(block.content);
 4564:     final inlineTextLayout = _inlineTextLayoutFor(
 4565:       context,
 4566:       block.content,
 4567:       effectiveStyle,
 4568:       compositionRange,
 4569:       inlineEmbedRenderer,
 4570:     );
 4571:     final selected = _selectionRangeForPath(
 4572:           selection,
 4573:           blockIndex,
 4574:           path,
 4575:           textLength,
 4576:         ) !=
 4577:         null;
 4578:     final text = _TextSelectionSurface(
 4579:       blockId: block.id,
 4580:       blockIndex: blockIndex,
 4581:       path: path,
 4582:       textLength: textLength,
 4583:       textSpan: TextSpan(
 4584:         style: effectiveStyle,
 4585:         children: inlineTextLayout.spans,
 4586:       ),
 4587:       offsetMapper: inlineTextLayout.offsetMapper,
 4588:       textAlign: _textAlign(block.attributes.alignment),
 4589:       minHeight: isTaskListItem
 4590:           ? _lineHeightFor(effectiveStyle)
 4591:           : (effectiveStyle.fontSize ?? 14) * _kBlockMinHeightFactor,
 4592:       selection: selection,
 4593:       showCaret: showCaret,
 4594:       registry: registry,
 4595:       showDebugOverlay: showDebugOverlay,
 4596:       findRanges: _findRangesForPath(
 4597:         findMatches,
 4598:         currentFindMatch,
 4599:         blockIndex,
 4600:         path,
 4601:         textLength,
 4602:       ),
 4603:     );
 4604:     final prefix = listMarker ?? _prefixFor(block);
 4605:     if (block.type == BlockType.quote) {
 4606:       return _withBlockSemantics(
 4607:         block,
 4608:         _QuoteBlockSurface(child: text),
 4609:         selected: selected,
 4610:       );
 4611:     }
 4612:     if (isTaskListItem) {
 4613:       return _withBlockSemantics(
 4614:         block,
 4615:         Padding(
 4616:           padding: const EdgeInsetsDirectional.only(
 4617:             start: _kTaskListPaddingLeft,
 4618:           ),
 4619:           child: Row(
 4620:             crossAxisAlignment: CrossAxisAlignment.start,
 4621:             children: <Widget>[
 4622:               _TodoCheckbox(
 4623:                 blockId: block.id,
 4624:                 registry: registry,
 4625:                 checked: isTaskChecked,
 4626:                 onChanged: onTodoCheckedChanged == null
 4627:                     ? null
 4628:                     : (checked) {
 4629:                         onTodoCheckedChanged!(
 4630:                           blockIndex: blockIndex,
 4631:                           checked: checked,
 4632:                         );
 4633:                       },
 4634:               ),
 4635:               const SizedBox(width: _kTodoTextGap),
 4636:               Expanded(child: text),
 4637:             ],
 4638:           ),
 4639:         ),
 4640:         selected: selected,
 4641:       );
 4642:     }
 4643:     if (block.type == BlockType.heading && headingCollapseState != null) {
 4644:       return _withBlockSemantics(
 4645:         block,
 4646:         Row(
 4647:           crossAxisAlignment: CrossAxisAlignment.start,
 4648:           children: <Widget>[
 4649:             _HeadingCollapseButton(
 4650:               blockId: block.id,
 4651:               state: headingCollapseState!,
 4652:               registry: registry,
 4653:               onToggled: onHeadingCollapseToggled,
 4654:             ),
 4655:             Expanded(child: text),
 4656:           ],
 4657:         ),
 4658:         selected: selected,
 4659:       );
 4660:     }
 4661:     if (prefix == null) {
 4662:       return _withBlockSemantics(block, text, selected: selected);
 4663:     }
 4664:     return _withBlockSemantics(
 4665:       block,
 4666:       Row(
 4667:         crossAxisAlignment: CrossAxisAlignment.start,
 4668:         children: <Widget>[
 4669:           SizedBox(
 4670:             key: ValueKey<String>('wenz-richtext-list-marker-${block.id}'),
 4671:             width: _kListMarkerWidth,
 4672:             child:
 4673:                 Text(prefix, style: effectiveStyle, textAlign: TextAlign.end),
 4674:           ),
 4675:           const SizedBox(width: _kListMarkerGap),
 4676:           Expanded(child: text),
 4677:         ],
 4678:       ),
 4679:       selected: selected,
 4680:     );
 4681:   }
 4682: }
