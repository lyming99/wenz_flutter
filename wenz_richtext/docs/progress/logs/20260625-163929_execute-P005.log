 4701: class _HeadingCollapseButtonState extends State<_HeadingCollapseButton> {
 4702:   final GlobalKey _hitTestKey = GlobalKey();
 4703:   final FocusNode _focusNode = FocusNode(
 4704:     debugLabel: 'Wenz heading collapse button',
 4705:   );
 4706: 
 4707:   @override
 4708:   void initState() {
 4709:     super.initState();
 4710:     widget.registry.registerSelectionExclusion(_hitTestKey);
 4711:   }
 4712: 
 4713:   @override
 4714:   void didUpdateWidget(covariant _HeadingCollapseButton oldWidget) {
 4715:     super.didUpdateWidget(oldWidget);
 4716:     if (oldWidget.registry != widget.registry) {
 4717:       oldWidget.registry.unregisterSelectionExclusion(_hitTestKey);
 4718:       widget.registry.registerSelectionExclusion(_hitTestKey);
 4719:     }
 4720:   }
 4721: 
 4722:   @override
 4723:   void dispose() {
 4724:     widget.registry.unregisterSelectionExclusion(_hitTestKey);
 4725:     _focusNode.dispose();
 4726:     super.dispose();
 4727:   }
 4728: 
 4729:   void _toggle() {
 4730:     _focusNode.requestFocus();
 4731:     widget.onToggled?.call(widget.blockId);
 4732:     WidgetsBinding.instance.addPostFrameCallback((_) {
 4733:       if (mounted && widget.state.canCollapse) {
 4734:         _focusNode.requestFocus();
 4735:       }
 4736:     });
 4737:   }
 4738: 
 4739:   KeyEventResult _handleKeyEvent(FocusNode node, KeyEvent event) {
 4740:     if (!widget.state.canCollapse ||
 4741:         widget.onToggled == null ||
 4742:         (event is! KeyDownEvent && event is! KeyRepeatEvent)) {
 4743:       return KeyEventResult.ignored;
 4744:     }
 4745:     final key = event.logicalKey;
 4746:     if (key == LogicalKeyboardKey.enter ||
 4747:         key == LogicalKeyboardKey.numpadEnter ||
 4748:         key == LogicalKeyboardKey.space) {
 4749:       _toggle();
 4750:       return KeyEventResult.handled;
 4751:     }
 4752:     return KeyEventResult.ignored;
 4753:   }
 4754: 
 4755:   @override
 4756:   Widget build(BuildContext context) {
 4757:     final theme = Theme.of(context);
 4758:     final scheme = theme.colorScheme;
 4759:     final enabled = widget.state.canCollapse && widget.onToggled != null;
 4760:     final overlay = scheme.primary.withAlpha(22);
 4761:     return MouseRegion(
 4762:       cursor: enabled ? SystemMouseCursors.click : SystemMouseCursors.basic,
 4763:       child: SizedBox(
 4764:         key: _hitTestKey,
 4765:         width: _kHeadingCollapseSlotWidth,
 4766:         height: _kHeadingCollapseButtonSize,
 4767:         child: Align(
 4768:           alignment: AlignmentDirectional.topStart,
 4769:           child: Focus(
 4770:             canRequestFocus: false,
 4771:             skipTraversal: true,
 4772:             onKeyEvent: _handleKeyEvent,
 4773:             child: IconButton(
 4774:               key: ValueKey<String>(
 4775:                 'wenz-richtext-heading-collapse-${widget.blockId}',
 4776:               ),
 4777:               focusNode: _focusNode,
 4778:               tooltip: _headingCollapseTooltip(widget.state),
 4779:               onPressed: enabled ? _toggle : null,
 4780:               iconSize: _kHeadingCollapseIconSize,
 4781:               padding: EdgeInsets.zero,
 4782:               constraints: const BoxConstraints.tightFor(
 4783:                 width: _kHeadingCollapseButtonSize,
 4784:                 height: _kHeadingCollapseButtonSize,
 4785:               ),
 4786:               visualDensity: VisualDensity.compact,
 4787:               splashRadius: _kHeadingCollapseButtonSize / 2,
 4788:               color: scheme.onSurfaceVariant,
 4789:               disabledColor: scheme.outline.withAlpha(110),
 4790:               focusColor: overlay,
 4791:               hoverColor: overlay,
 4792:               highlightColor: scheme.primary.withAlpha(34),
 4793:               icon: _HeadingCollapseGlyph(
 4794:                 state: widget.state,
 4795:                 enabled: enabled,
 4796:               ),
 4797:             ),
 4798:           ),
 4799:         ),
 4800:       ),
 4801:     );
 4802:   }
 4803: }
