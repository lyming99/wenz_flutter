 5157: double _measureInlineSpanWidth(InlineSpan span, TextDirection textDirection) {
 5158:   final painter = TextPainter(
 5159:     text: span,
 5160:     textDirection: textDirection,
 5161:   )..layout(maxWidth: double.infinity);
 5162:   final width = painter.width;
 5163:   painter.dispose();
 5164:   return width.isFinite ? width : 0;
 5165: }
