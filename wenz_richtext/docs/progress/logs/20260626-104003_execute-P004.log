22`t/// Immutable payload sent from a table renderer to the editor-owned overlay host.
23`t///
24`t/// The table renderer owns only the anchor and the current toolbar payload. The
25`t/// editor owns [TableFloatingToolbarOverlayHost], which renders this payload with
26`t/// Flutter's system [OverlayPortal]. This keeps the toolbar outside the table
27`t/// block's internal [Stack], so it can cross parent bounds and participate in
28`t/// overlay hit testing without making renderers manage overlay entries directly.
29`t@immutable
30`tclass TableFloatingToolbarOverlayRequest {
31`t  const TableFloatingToolbarOverlayRequest({
32`t    required this.owner,
33`t    required this.anchorLink,
34`t    required this.anchorRect,
35`t    required this.visibleTop,
36`t    required this.tableBlockId,
37`t    required this.blockIndex,
38`t    required this.selectionRange,
39`t    required this.toolbarBuilder,
40`t    this.enabled = true,
41`t    this.minWidth = 0,
42`t    this.gap = 4,
43`t    this.fallbackHeight = 40,
44`t  });
45`t
46`t  /// Opaque identity of the renderer anchor that published this request.
47`t  final Object owner;
48`t
49`t  /// Link followed by the system overlay entry.
50`t  final LayerLink anchorLink;
51`t
52`t  /// Current rect of the table block anchor in the target overlay coordinates.
53`t  final Rect anchorRect;
54`t
55`t  /// Top edge of the visible editor viewport in target overlay coordinates.
56`t  final double visibleTop;
57`t
58`t  /// Active table identity used by hosts/tests to reason about request staleness.
59`t  final String tableBlockId;
60`t
61`t  /// Active table block index in the source document.
62`t  final int blockIndex;
63`t
64`t  /// Current table-cell selection range that the toolbar actions target.
65`t  final TableCellRange selectionRange;
66`t
67`t  /// Builds toolbar chrome. The renderer captures the table action callback here
68`t  /// so the overlay host never calls back into renderer state directly.
69`t  final TableFloatingToolbarOverlayBuilder toolbarBuilder;
70`t
71`t  /// Whether this request may be shown. Hosts hide disabled requests.
72`t  final bool enabled;
73`t
74`t  /// Minimum toolbar width, independent from the table block's layout width.
75`t  final double minWidth;
76`t
77`t  /// Gap between the toolbar bottom and the table anchor top.
78`t  final double gap;
79`t
