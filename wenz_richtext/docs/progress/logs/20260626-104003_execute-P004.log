186`tclass _TableFloatingToolbarOverlayHostState
187`t    extends State<TableFloatingToolbarOverlayHost> {
188`t  final OverlayPortalController _portalController = OverlayPortalController();
189`t  TableFloatingToolbarOverlayRequest? _request;
190`t
191`t  @override
192`t  void initState() {
193`t    super.initState();
194`t    _request = widget.controller.request;
195`t    widget.controller.addListener(_handleControllerChanged);
196`t    WidgetsBinding.instance.addPostFrameCallback((_) => _syncPortal());
197`t  }
198`t
199`t  @override
200`t  void didUpdateWidget(covariant TableFloatingToolbarOverlayHost oldWidget) {
201`t    super.didUpdateWidget(oldWidget);
202`t    if (oldWidget.controller == widget.controller) {
203`t      return;
204`t    }
205`t    oldWidget.controller.removeListener(_handleControllerChanged);
206`t    _request = widget.controller.request;
207`t    widget.controller.addListener(_handleControllerChanged);
208`t    WidgetsBinding.instance.addPostFrameCallback((_) => _syncPortal());
209`t  }
210`t
211`t  @override
212`t  void dispose() {
213`t    widget.controller.removeListener(_handleControllerChanged);
214`t    if (_portalController.isShowing) {
215`t      _portalController.hide();
216`t    }
217`t    super.dispose();
218`t  }
219`t
220`t  @override
221`t  Widget build(BuildContext context) {
222`t    return OverlayPortal.overlayChildLayoutBuilder(
223`t      controller: _portalController,
224`t      overlayChildBuilder: (context, info) {
225`t        final request = _request;
226`t        if (request == null || !request.enabled) {
227`t          return const SizedBox.shrink();
228`t        }
229`t        return _TableFloatingToolbarOverlayEntry(
230`t          request: request,
231`t          overlaySize: info.overlaySize,
232`t        );
233`t      },
234`t      child: widget.child,
235`t    );
236`t  }
237`t
238`t  void _handleControllerChanged() {
239`t    if (!mounted) {
240`t      return;
241`t    }
242`t    setState(() {
243`t      _request = widget.controller.request;
244`t    });
245`t    _syncPortalSafely();
246`t  }
247`t
248`t  void _syncPortalSafely() {
249`t    if (SchedulerBinding.instance.schedulerPhase ==
250`t        SchedulerPhase.persistentCallbacks) {
251`t      WidgetsBinding.instance.addPostFrameCallback((_) => _syncPortal());
252`t      return;
253`t    }
254`t    _syncPortal();
255`t  }
256`t
257`t  void _syncPortal() {
258`t    if (!mounted) {
259`t      return;
260`t    }
261`t    final shouldShow = _request?.enabled == true;
262`t    if (shouldShow) {
263`t      if (!_portalController.isShowing) {
264`t        _portalController.show();
265`t      }
266`t    } else if (_portalController.isShowing) {
267`t      _portalController.hide();
268`t    }
269`t  }
270`t}
