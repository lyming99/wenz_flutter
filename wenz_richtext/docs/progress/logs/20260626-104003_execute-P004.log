104`t/// Editor-owned controller for the active table toolbar overlay request.
105`tclass TableFloatingToolbarOverlayController extends ChangeNotifier {
106`t  TableFloatingToolbarOverlayRequest? _request;
107`t  final Map<String, TableFloatingToolbarAnchorSnapshot> _anchors =
108`t      <String, TableFloatingToolbarAnchorSnapshot>{};
109`t
110`t  TableFloatingToolbarOverlayRequest? get request => _request;
111`t
112`t  TableFloatingToolbarAnchorSnapshot? anchorFor(
113`t    String tableBlockId, {
114`t    int? blockIndex,
115`t  }) {
116`t    final anchor = _anchors[tableBlockId];
117`t    if (anchor == null ||
118`t        (blockIndex != null && anchor.blockIndex != blockIndex)) {
119`t      return null;
120`t    }
121`t    return anchor;
122`t  }
123`t
124`t  void updateAnchor(TableFloatingToolbarAnchorSnapshot anchor) {
125`t    _anchors[anchor.tableBlockId] = anchor;
126`t  }
127`t
128`t  void unregisterAnchor({required Object owner}) {
129`t    _anchors.removeWhere((_, anchor) => identical(anchor.owner, owner));
130`t    hide(owner: owner);
131`t  }
132`t
133`t  void show(
134`t    TableFloatingToolbarOverlayRequest request, {
135`t    bool replaceDifferentRequest = true,
136`t  }) {
137`t    final current = _request;
138`t    if (!replaceDifferentRequest &&
139`t        current != null &&
140`t        !_targetsSameActiveSelection(current, request)) {
141`t      return;
142`t    }
143`t    _request = request;
144`t    notifyListeners();
145`t  }
146`t
147`t  bool _targetsSameActiveSelection(
148`t    TableFloatingToolbarOverlayRequest current,
149`t    TableFloatingToolbarOverlayRequest next,
150`t  ) {
151`t    return identical(current.owner, next.owner) ||
152`t        (current.tableBlockId == next.tableBlockId &&
153`t            current.blockIndex == next.blockIndex &&
154`t            current.selectionRange == next.selectionRange);
155`t  }
156`t
157`t  void hide({Object? owner}) {
158`t    final current = _request;
159`t    if (current == null) {
160`t      return;
161`t    }
162`t    if (owner != null && !identical(current.owner, owner)) {
163`t      return;
164`t    }
165`t    _request = null;
166`t    notifyListeners();
167`t  }
168`t}
