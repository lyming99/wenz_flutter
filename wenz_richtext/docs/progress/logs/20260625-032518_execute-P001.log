 5210: Offset _globalTextOffset(WidgetTester tester, String text, int offset) {
 5211:   final finder = _richText(text);
 5212:   final richText = tester.widget<RichText>(finder);
 5213:   final size = tester.getSize(finder);
 5214:   final painter = TextPainter(
 5215:     text: richText.text,
 5216:     textAlign: richText.textAlign,
 5217:     textDirection: TextDirection.ltr,
 5218:   )..layout(maxWidth: size.width);
 5219:   final local = painter.getOffsetForCaret(
 5220:     TextPosition(offset: offset),
 5221:     Rect.zero,
 5222:   );
 5223:   return tester.getTopLeft(finder) +
 5224:       local +
 5225:       Offset(1, painter.preferredLineHeight / 2);
 5226: }
