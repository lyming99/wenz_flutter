              InlineEmbed(
                embedType: 'mention',
                data: <String, Object?>{'id': 'u1', 'label': 'Ada'},
              ),
              TextRun(text: '\nsecond line'),
            ],
          ),
          TextBlockNode(
            id: 'quote2',
