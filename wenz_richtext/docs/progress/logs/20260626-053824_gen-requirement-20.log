101:_Shortcut? _matchShortcut(TextBlockNode block, String prefix) {
102:  if (block.type == BlockType.paragraph) {
103:    final heading = RegExp(r'^(#{1,6}) $').firstMatch(prefix);
104:    if (heading != null) {
105:      return _Shortcut.heading(heading.group(1)!.length);
106:    }
107:    final ordered = RegExp(r'^\d+\. $').firstMatch(prefix);
108:    if (ordered != null) {
109:      return const _Shortcut(_ShortcutKind.orderedList);
110:    }
111:    switch (prefix) {
112:      case '- [ ] ':
113:        return const _Shortcut(_ShortcutKind.taskList, checked: false);
114:      case '- [x] ':
115:      case '- [X] ':
116:        return const _Shortcut(_ShortcutKind.taskList, checked: true);
117:      case '- ':
118:      case '* ':
119:        return const _Shortcut(_ShortcutKind.unorderedList);
120:      case '> ':
121:        return const _Shortcut(_ShortcutKind.quote);
122:      case '```':
123:        return const _Shortcut(_ShortcutKind.codeBlock);
124:      case '---':
125:        return const _Shortcut(_ShortcutKind.divider);
126:    }
127:  }
128:  if (block.type == BlockType.listItem && block.attributes.listType != 'task') {
129:    switch (prefix) {
130:      case '[ ] ':
131:        return const _Shortcut(_ShortcutKind.taskList, checked: false);
132:      case '[x] ':
133:      case '[X] ':
134:        return const _Shortcut(_ShortcutKind.taskList, checked: true);
135:    }
136:  }
137:  return null;
