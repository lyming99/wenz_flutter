7:/// Exports and imports a [RichTextDocument] as GitHub-Flavored Markdown.
8:///
9:/// **Export** (`encode`) maps every block to its Markdown representation and
10:/// every inline run to `**bold**` / `*italic*` / `~~strike~~` / `<u>underline</u>`
11:/// / `[text](url)` syntax, joining blocks with blank lines.
12:///
13:/// **Import** (`decode`) runs a line-oriented state machine that recognises:
14:/// ATX headings (`#{1,6}`), unordered (`- `/`* `), ordered (`1. `), and task
15:/// (`- [x] `/`- [ ]`) lists, blockquotes (`> `), fenced code blocks
16:/// (``` ``` ```), GFM pipe tables, thematic breaks (`---`/`***`), images
17:/// (`![alt](url)`), Wenz video placeholders (`![video](url "wenz-video; 鈥?)`), and inline
18:/// `**bold**`/`*italic*`/`~~strike~~`/`<u>u</u>`/`[text](url)`. Anything
19:/// unrecognised falls back to a paragraph (Markdown's usual leniency 鈥?
20:/// [decode] never throws for content).
21:///
22:/// Coverage is aligned with the `gpt_markdown` syntax matrix for the block/
23:/// inline kinds this package models; LaTeX / radio buttons have no model
24:/// counterpart and are left as plain text. Underline uses `<u>` because GFM
25:/// has no native underline syntax.
26:///
27:/// The codec serializes document content only. Editor-owned view state such as
28:/// heading collapse is not emitted, so imported Markdown starts expanded while
29:/// preserving every block in source order.
30:class MarkdownCodec {
31:  const MarkdownCodec();
32:
33:  // ---------------------------------------------------------------------------
34:  // Export: document -> Markdown
35:  // ---------------------------------------------------------------------------
36:
37:  /// Encodes [document] to a Markdown string. Blocks are separated by a blank
38:  /// line; media blocks without a Markdown form emit a best-effort placeholder.
39:  String encode(RichTextDocument document) {
40:    final sections = <String>[];
41:    for (final block in document.blocks) {
42:      final rendered = _encodeBlock(block);
43:      if (rendered != null) {
44:        sections.add(rendered);
45:      }
46:    }
47:    return sections.join('\n\n');
48:  }
49:
50:  String? _encodeBlock(BlockNode block) {
51:    switch (block.type) {
52:      case BlockType.heading:
53:        final text = block as TextBlockNode;
54:        final level = text.attributes.level ?? 1;
55:        final hashes = '#' * level.clamp(1, 6);
56:        return '$hashes ${_encodeInline(text.content)}';
57:      case BlockType.paragraph:
58:        final text = block as TextBlockNode;
59:        if (text.content.isEmpty) {
60:          return null;
61:        }
62:        return _encodeInline(text.content);
63:      case BlockType.quote:
64:        final text = block as TextBlockNode;
65:        final body = _encodeInline(text.content);
66:        // Prefix every line with `> ` so multi-line quotes stay valid.
67:        return body.split('\n').map((line) => '> $line').join('\n');
68:      case BlockType.listItem:
69:        return _encodeListItem(block as TextBlockNode);
