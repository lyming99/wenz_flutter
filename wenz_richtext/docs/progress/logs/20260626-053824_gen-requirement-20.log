263:/// Sets the checked state of an existing task list item without moving the
264:/// current selection.
265:class SetTodoCheckedCommand extends EditorCommand {
266:  const SetTodoCheckedCommand({
267:    required this.blockIndex,
268:    required this.checked,
269:  });
270:
271:  final int blockIndex;
272:  final bool checked;
273:
274:  @override
275:  String get description => 'setTodoChecked';
276:
277:  @override
278:  CommandResult execute(DocumentSession session) {
279:    if (blockIndex < 0 || blockIndex >= session.document.blocks.length) {
280:      return const CommandResult(recordHistory: false);
281:    }
282:    final block = session.document.blocks[blockIndex];
283:    if (block is! TextBlockNode ||
284:        block.type != BlockType.listItem ||
285:        block.attributes.listType != 'task' ||
286:        block.attributes.checked == checked) {
287:      return const CommandResult(recordHistory: false);
288:    }
289:    final blocks = session.document.blocks.map((node) => node.copy()).toList();
290:    blocks[blockIndex] = _textBlockWithChecked(block, checked);
291:    session.document = RichTextDocument(
292:      version: session.document.version,
293:      blocks: blocks,
294:    );
295:    return const CommandResult();
296:  }
297:}
