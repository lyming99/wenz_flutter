 353: List<FindReplaceMatch> _findInTable(
 354:   TableBlockNode block,
 355:   int blockIndex,
 356:   String query,
 357:   FindReplaceOptions options,
 358: ) {
 359:   final matches = <FindReplaceMatch>[];
 360:   for (var row = 0; row < block.table.rows.length; row++) {
 361:     final cells = block.table.rows[row];
 362:     for (var column = 0; column < cells.length; column++) {
 363:       final cell = cells[column];
 364:       if (cell.covered) {
 365:         continue;
 366:       }
 367:       final inline = _firstTextBlockInline(cell);
 368:       final path = PositionPath.tableCellText(block.id, row, column);
 369:       matches.addAll(
 370:         _findInText(
 371:           text: _inlinePlainText(inline),
 372:           query: query,
 373:           options: options,
 374:           positionBuilder: (offset) => DocumentPosition.tableCell(
 375:             tableBlockId: block.id,
 376:             blockIndex: blockIndex,
 377:             tableRowIndex: row,
 378:             tableColumnIndex: column,
 379:             offset: offset,
 380:           ),
 381:           blockId: block.id,
 382:           blockIndex: blockIndex,
 383:           path: path,
 384:         ),
 385:       );
 386:     }
 387:   }
 388:   return matches;
 389: }
 390: 
 391: List<InlineNode> _firstTextBlockInline(TableCellNode cell) {
 392:   for (final block in cell.blocks) {
 393:     if (block is TextBlockNode) {
 394:       return block.content;
 395:     }
 396:   }
 397:   return const <InlineNode>[];
 398: }
 399: 
 400: List<FindReplaceMatch> _findInText({
 401:   required String text,
 402:   required String query,
 403:   required FindReplaceOptions options,
 404:   required DocumentPosition Function(int offset) positionBuilder,
 405:   required String blockId,
 406:   required int blockIndex,
 407:   required PositionPath path,
 408: }) {
 409:   if (text.isEmpty || query.isEmpty) {
 410:     return const <FindReplaceMatch>[];
 411:   }
 412:   final haystack = options.caseSensitive ? text : text.toLowerCase();
 413:   final needle = options.caseSensitive ? query : query.toLowerCase();
 414:   final matches = <FindReplaceMatch>[];
 415:   var index = 0;
 416:   while (index <= haystack.length - needle.length) {
 417:     final found = haystack.indexOf(needle, index);
 418:     if (found == -1) {
 419:       break;
 420:     }
 421:     final end = found + needle.length;
 422:     if (!options.wholeWord || _isWholeWord(haystack, found, end)) {
 423:       final startPosition = positionBuilder(found);
 424:       final endPosition = positionBuilder(end);
 425:       matches.add(
 426:         FindReplaceMatch(
 427:           selection: DocumentSelection(
 428:             base: startPosition,
 429:             extent: endPosition,
 430:           ),
 431:           text: text.substring(found, end),
 432:           blockId: blockId,
 433:           blockIndex: blockIndex,
 434:           path: path,
 435:           start: found,
 436:           end: end,
 437:         ),
 438:       );
 439:     }
 440:     index = found + needle.length;
 441:   }
 442:   return matches;
 443: }
 444: 
 445: String _inlinePlainText(List<InlineNode> nodes) {
 446:   final buffer = StringBuffer();
 447:   for (final node in nodes) {
 448:     if (node is InlineEmbed) {
 449:       buffer.write(' ' * inlineLength(node));
 450:     } else {
 451:       buffer.write(node.plainText);
 452:     }
 453:   }
 454:   return buffer.toString();
 455: }
 456: 
 457: bool _isWholeWord(String text, int start, int end) {
 458:   final before = start == 0 ? null : text.codeUnitAt(start - 1);
 459:   final after = end >= text.length ? null : text.codeUnitAt(end);
 460:   return !_isWordCodeUnit(before) && !_isWordCodeUnit(after);
 461: }
 462: 
 463: bool _isWordCodeUnit(int? codeUnit) {
 464:   if (codeUnit == null) {
 465:     return false;
 466:   }
 467:   return (codeUnit >= 0x30 && codeUnit <= 0x39) ||
 468:       (codeUnit >= 0x41 && codeUnit <= 0x5A) ||
 469:       (codeUnit >= 0x61 && codeUnit <= 0x7A) ||
 470:       codeUnit == 0x5F;
 471: }

