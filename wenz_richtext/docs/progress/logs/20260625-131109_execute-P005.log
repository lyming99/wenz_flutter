 576: OutlineCollapseRange _collapseRangeForHeading({
 577:   required List<BlockNode> blocks,
 578:   required int headingIndex,
 579:   required int headingLevel,
 580: }) {
 581:   final start = headingIndex + 1;
 582:   var end = start;
