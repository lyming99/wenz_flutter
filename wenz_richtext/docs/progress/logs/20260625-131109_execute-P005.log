+    if (_collapsedBlockIds.isEmpty) {
+      return const <OutlineItem>[];
+    }
+    final collapsedItems = <OutlineItem>[];
+    for (final item in _items) {
+      if (!item.isCollapsed || !item.canCollapse) {
+        continue;
