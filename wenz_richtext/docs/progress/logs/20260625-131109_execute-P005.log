+  bool expandToRevealBlockIndex(int blockIndex) {
+    final blocks = _host.document.blocks;
+    if (blockIndex < 0 || blockIndex >= blocks.length) {
+      return false;
+    }
+    return expandToRevealBlockId(blocks[blockIndex].id);
+  }
