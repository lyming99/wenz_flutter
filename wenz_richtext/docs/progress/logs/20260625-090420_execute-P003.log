+  }
+
+  void _setHovered(bool value) {
+    if (_hovered != value && mounted) {
+      setState(() => _hovered = value);
+    }
+  }
+
+  void _setFocused(bool value) {
+    if (_focused != value && mounted) {
+      setState(() => _focused = value);
+    }
   }
 }
 
