+  testWidgets('callout body participates in selection and copy', (
+    tester,
+  ) async {
+    const body = 'Info body selectable';
+    final controller = WenzRichTextController(
+      document: const RichTextDocument(
+        blocks: <BlockNode>[
+          TextBlockNode(
+            id: 'before',
