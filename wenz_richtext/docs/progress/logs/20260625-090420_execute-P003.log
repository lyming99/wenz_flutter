+
+    await tester.pumpWidget(
+      MaterialApp(
+        home: Scaffold(
+          body: SizedBox(
+            height: 64,
+            child: WenzRichTextEditor(
+              controller: controller,
+              autofocus: true,
+            ),
+          ),
+        ),
+      ),
+    );
+    controller.requestFocus();
+    await tester.pump();
+    await tester.pump();
+
+    expect(tester.testTextInput.hasAnyClients, isTrue);
