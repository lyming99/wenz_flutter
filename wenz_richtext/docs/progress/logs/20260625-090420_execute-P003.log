+    find.descendant(
+      of: find.byKey(
+        ValueKey<String>(
+            'table-cell-border-$tableBlockId-$rowIndex-$columnIndex'),
+      ),
+      matching: find.byType(DecoratedBox),
+    ),
+  );
+  return decoratedBoxes.firstWhere((box) {
