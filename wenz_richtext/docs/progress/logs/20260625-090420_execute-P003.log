+      const unsupportedCode = 'final value = 42;';
+      final controller = WenzRichTextController(
+        document: const RichTextDocument(
+          blocks: <BlockNode>[
+            CodeBlockNode(id: 'dart1', code: dartCode, language: 'dart'),
