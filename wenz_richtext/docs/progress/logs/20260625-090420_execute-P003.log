3188: double _spacingBetweenBlocks(
3189:   BlockNode previous,
3190:   BlockNode next,
3191:   double fallback,
3192: ) {
3193:   if ((fallback - _kDefaultBlockSpacing).abs() > 0.01) {
3194:     return fallback;
3195:   }
3196:   if (_isListItemBlock(previous) && _isListItemBlock(next)) {
3197:     final previousIndent = _blockIndentLevel(previous);
3198:     final nextIndent = _blockIndentLevel(next);
3199:     return previousIndent > 0 || nextIndent > 0
3200:         ? _kNestedListItemSpacing
3201:         : _kListItemSpacing;
3202:   }
3203:   return math.max(
3204:     _blockMarginAfter(previous, fallback),
3205:     _blockMarginBefore(next, fallback),
3206:   );
3207: }
