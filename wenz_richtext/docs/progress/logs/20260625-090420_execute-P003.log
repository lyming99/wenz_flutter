0370:   }
0371: 
0372:   /// Whether a builder is registered for [type].
0373:   bool has(BlockType type) => _builders.containsKey(type);
0374: 
0375:   /// Registers [builder] for a custom [BlockEmbedNode.embedType]. Returning the
0376:   /// previous builder lets callers chain or wrap an existing business renderer.
0377:   BlockRendererBuilder? registerEmbed(
0378:     String embedType,
0379:     BlockRendererBuilder builder,
0380:   ) {
0381:     final previous = _embedBuilders[embedType];
0382:     _embedBuilders[embedType] = builder;
0383:     return previous;
0384:   }
0385: 
0386:   /// Removes the builder for [embedType], if any. The editor then falls back to
0387:   /// the generic [BlockType.embed] renderer.
0388:   void unregisterEmbed(String embedType) {
0389:     _embedBuilders.remove(embedType);
0390:   }
0391: 
0392:   /// Whether a builder is registered for [embedType].
0393:   bool hasEmbed(String embedType) => _embedBuilders.containsKey(embedType);
0394: 
0395:   /// Resolves the best builder for [block]. Custom [BlockEmbedNode.embedType]
0396:   /// builders win over the generic [BlockType.embed] builder; all other blocks
0397:   /// use their [BlockType] mapping.
0398:   BlockRendererBuilder resolveForBlock(
0399:     BlockNode block, {
0400:     required BlockRendererBuilder fallback,
