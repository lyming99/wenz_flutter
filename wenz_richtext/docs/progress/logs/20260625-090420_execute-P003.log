-        await tester.pump(const Duration(milliseconds: 16));
-      }
-      final scrollAfterRelease = _scrollOffset(tester);
-
-      expect(scrollAtRelease, greaterThan(0));
-      expect(scrollAfterRelease, equals(scrollBeforeRelease));
-    });
-  });
