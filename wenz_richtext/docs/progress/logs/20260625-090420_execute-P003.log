-  expect(tooltipFinder, findsOneWidget);
-  final matchedWidget = tooltipFinder.evaluate().single.widget;
-  final button = matchedWidget is IconButton
-      ? matchedWidget
-      : tester.widget<IconButton>(
-          find.ancestor(
-            of: tooltipFinder,
-            matching: find.byType(IconButton),
