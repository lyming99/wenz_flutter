+  testWidgets('todo checkbox toggles checked state without selecting text',
+      (tester) async {
+    final initialSelection = collapsedTextSelection('task1', 0, 4);
+    final controller = WenzRichTextController(
+      document: const RichTextDocument(
+        blocks: <BlockNode>[
+          TextBlockNode(
+            id: 'task1',
