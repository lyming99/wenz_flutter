+      ),
+    );
+
+    final target = _globalTextOffset(tester, 'hello world', 2);
+    await tester.tapAt(target);
+    await tester.pump(const Duration(milliseconds: 50));
+    await tester.tapAt(target);
+    await tester.pump(const Duration(milliseconds: 50));
+    await tester.tapAt(target);
