+    final emojiRight = _globalTextRangePoint(tester, renderedText, 1, 3, 0.75);
+    final mentionLeft = _globalTextRangePoint(tester, renderedText, 4, 8, 0.25);
+    final mentionMiddle =
+        _globalTextRangePoint(tester, renderedText, 4, 8, 0.50);
