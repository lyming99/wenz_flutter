+                data: <String, Object?>{'id': 'u1', 'label': 'Ada'},
+              ),
+            ],
+          ),
+        ],
+      ),
+    );
+    final renderer = InlineEmbedRendererCallback((context, embed, style) {
+      if (embed.embedType == 'formula') {
+        return TextSpan(text: 'formula(${embed.data['text']})', style: style);
+      }
+      return null;
