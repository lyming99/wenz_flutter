0326:   BlockRendererRegistry({
0327:     Map<BlockType, BlockRendererBuilder> builders =
0328:         const <BlockType, BlockRendererBuilder>{},
0329:     Map<String, BlockRendererBuilder> embedBuilders =
0330:         const <String, BlockRendererBuilder>{},
0331:   }) {
