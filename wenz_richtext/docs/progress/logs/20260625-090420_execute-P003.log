2922:     required this.blockChanged,
2923:     required this.selection,
2924:     required this.compositionState,
2925:     required this.registry,
2926:     required this.blockRenderers,
2927:     required this.showCaret,
2928:     this.textStyle,
2929:     this.showDebugOverlay = false,
2930:     this.canEdit = true,
2931:     this.mediaResolver,
2932:     this.inlineEmbedRenderer,
2933:     this.onCodeLanguageChanged,
2934:     this.onCodeCopied,
2935:     this.onCalloutVariantChanged,
2936:     this.onTableToolbarAction,
2937:     this.onTableColumnResize,
2938:     this.onTodoCheckedChanged,
2939:     this.onObjectBlockAction,
2940:     this.findMatches = const <FindReplaceMatch>[],
2941:     this.currentFindMatch,
2942:   });
