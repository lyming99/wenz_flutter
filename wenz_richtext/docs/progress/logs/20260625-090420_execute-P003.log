+            : _hovered
+                ? BlockDragHandleSpec.hoverOpacity
+                : BlockDragHandleSpec.idleOpacity;
+    final theme = Theme.of(context);
+    final active = _menuOpen || _focused;
+    final backgroundColor = active
+        ? theme.colorScheme.primaryContainer.withAlpha(180)
+        : _hovered
