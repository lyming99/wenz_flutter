+      blockId: 'p-inline',
+      blockIndex: 0,
+      baseOffset: 3,
+      extentOffset: 5,
+    );
+
+    await _waitPastMultiClickWindow(tester);
+    await tester.dragFrom(mentionMiddle, followingEnd - mentionMiddle);
+    await tester.pump();
+    expect(controller.selection?.base.offset, inInclusiveRange(3, 4));
+    _expectBlockTextSelection(
