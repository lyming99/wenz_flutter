3062:   /// Whether the current selection could affect this block's rendering: it is
3063:   /// an endpoint, or it lies strictly between the selection's start and end
3064:   /// (so it would be fully highlighted), or the selection is collapsed inside
3065:   /// it (the caret).
3066:   bool _selectionTouchesBlock(_KeepAliveBlock w) {
3067:     final selection = w.selection;
3068:     if (selection == null) {
3069:       return false;
3070:     }
3071:     final index = w.blockIndex;
3072:     final start = selection.start;
3073:     final end = selection.end;
3074:     if (start.blockIndex == index || end.blockIndex == index) {
3075:       return true;
3076:     }
3077:     // Interior block of a multi-block range is fully highlighted.
3078:     return index > start.blockIndex && index < end.blockIndex;
3079:   }
3080: 
3081:   /// Whether an active IME composition affects this block (composition lives in
3082:   /// the caret's block). Only that block needs to repaint the underline span.
3083:   bool _compositionTouchesBlock(_KeepAliveBlock w) {
3084:     final composition = w.compositionState;
3085:     if (composition == null) {
3086:       return false;
3087:     }
3088:     final selection = w.selection;
3089:     return selection != null && selection.extent.blockIndex == w.blockIndex;
3090:   }
3091: }
