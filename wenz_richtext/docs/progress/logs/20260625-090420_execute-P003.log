+                data: <String, Object?>{'emoji': '😄'},
+              ),
+              TextRun(text: 'B'),
+              InlineEmbed(
+                embedType: 'mention',
+                data: <String, Object?>{'label': 'bob'},
+              ),
+              TextRun(text: 'C'),
+            ],
+          ),
+        ],
+      ),
+    );
+
+    await tester.pumpWidget(
+      MaterialApp(
+        home: Scaffold(
