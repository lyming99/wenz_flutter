0333:     _embedBuilders.addAll(embedBuilders);
0334:   }
0335: 
0336:   final Map<BlockType, BlockRendererBuilder> _builders =
0337:       <BlockType, BlockRendererBuilder>{};
0338:   final Map<String, BlockRendererBuilder> _embedBuilders =
0339:       <String, BlockRendererBuilder>{};
0340: 
0341:   /// Registered block types in insertion order.
