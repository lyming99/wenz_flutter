-    // measurement and the subsequent re-layout.
-    await tester.pump();
-    await tester.pump();
-
-    expect(_scrollOffset(tester), greaterThan(scrollBefore));
-    tester.testTextInput.log.clear();
-
-    await tester.pump();
-
-    expect(
-      tester.testTextInput.log.where(
