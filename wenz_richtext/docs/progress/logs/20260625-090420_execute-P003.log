-
-    // Initial press.
-    await tester.sendKeyDownEvent(LogicalKeyboardKey.arrowRight);
-    await tester.pump();
-    expect(controller.selection?.extent.offset, 1);
-
-    // Auto-repeat events while the key stays down.
