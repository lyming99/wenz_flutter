-      }
-
-      final scrollAfter = _scrollOffset(tester);
-      final extentAfter = controller.selection!.extent.blockIndex;
-      expect(scrollAfter, greaterThan(scrollBefore));
-      expect(extentAfter, greaterThan(extentBefore));
-
-      await gesture.up();
-    });
