0343: 
0344:   /// Registered custom block embed types in insertion order.
0345:   Iterable<String> get embedTypes => _embedBuilders.keys;
0346: 
0347:   /// Registers [builder] for [type], replacing any existing builder for that
0348:   /// type. Returning the previous builder (if any) lets callers chain or wrap
0349:   /// the default renderer.
0350:   BlockRendererBuilder? register(BlockType type, BlockRendererBuilder builder) {
0351:     final previous = _builders[type];
0352:     _builders[type] = builder;
0353:     return previous;
0354:   }
0355: 
0356:   /// Removes the builder for [type], if any. The editor falls back to its
0357:   /// plain-text default for that type.
