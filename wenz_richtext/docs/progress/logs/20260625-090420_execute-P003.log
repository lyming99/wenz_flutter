+      ),
+      PopupMenuItem<ObjectBlockAction>(
+        value: ObjectBlockAction.moveDown,
+        enabled: canMoveDown,
+        child: const Text('下移块'),
+      ),
+      const PopupMenuDivider(),
+      const PopupMenuItem<ObjectBlockAction>(
+        value: ObjectBlockAction.delete,
+        child: Text('删除块'),
+      ),
