+  }
+
+  void _handleMenuOpened() {
+    if (mounted) {
+      setState(() => _menuOpen = true);
+    }
+  }
+
+  void _handleMenuClosed() {
+    if (mounted) {
+      setState(() => _menuOpen = false);
+    }
+  }
+
+  void _handleActionSelected(ObjectBlockAction action) {
+    _handleMenuClosed();
+    widget.onAction?.call(
