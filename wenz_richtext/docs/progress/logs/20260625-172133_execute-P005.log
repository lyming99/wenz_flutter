  829:     return TableFloatingToolbarOverlayRequest(
  830:       owner: anchor.owner,
  831:       anchorLink: anchor.anchorLink,
  832:       anchorRect: anchor.anchorRect,
  833:       visibleTop: anchor.visibleTop,
  834:       tableBlockId: tableBlock.id,
  835:       blockIndex: tableRange.blockIndex,
  836:       selectionRange: normalizedRange,
  837:       minWidth: _kTableToolbarMinWidth,
  838:       gap: _kTableFloatingToolbarGap,
