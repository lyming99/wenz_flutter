 1237:   void _handleTableToolbarAction(TableToolbarActionIntent intent) {
 1238:     final tableBlock = _tableBlockAt(intent.blockIndex);
 1239:     if (tableBlock == null) {
 1240:       return;
 1241:     }
 1242: 
 1243:     final range = _currentTableRange(tableBlock, intent);
