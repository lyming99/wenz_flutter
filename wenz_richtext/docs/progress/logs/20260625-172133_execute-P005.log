 1199:   bool _handleTapBeyondContent(Offset _) {
 1200:     if (widget.readOnly) {
 1201:       return false;
 1202:     }
 1203:     final blocks = widget.controller.document.blocks;
 1204:     if (blocks.isEmpty) {
 1205:       return false;
 1206:     }
 1207:     final last = blocks.last;
 1208:     if (last is TextBlockNode || last is CodeBlockNode) {
 1209:       return false;
 1210:     }
 1211: 
 1212:     final nextBlockId = _nextBlockId();
 1213:     final nextBlockIndex = blocks.length;
 1214:     final nextPosition = DocumentPosition.text(
 1215:       blockId: nextBlockId,
 1216:       blockIndex: nextBlockIndex,
 1217:       offset: 0,
 1218:     );
 1219:     final nextSelection =
 1220:         DocumentSelection(base: nextPosition, extent: nextPosition);
 1221:     _skipNextCaretScrollIntoView = true;
 1222:     widget.controller.insertBlocks(
 1223:       index: nextBlockIndex,
 1224:       blocks: <BlockNode>[
 1225:         TextBlockNode(
 1226:           id: nextBlockId,
 1227:           type: BlockType.paragraph,
 1228:           content: const <InlineNode>[],
 1229:         ),
 1230:       ],
 1231:       selection: nextSelection,
 1232:     );
 1233:     _inputClient.syncBuffer();
 1234:     return true;
 1235:   }
