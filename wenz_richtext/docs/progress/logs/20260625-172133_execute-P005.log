 1249:     switch (intent.action) {
 1250:       case TableToolbarAction.insertRowAbove:
 1251:         widget.controller.insertTableRow(
 1252:           blockIndex: intent.blockIndex,
 1253:           rowIndex: range.startRow,
 1254:         );
 1255:         return;
 1256:       case TableToolbarAction.insertRowBelow:
 1257:         widget.controller.insertTableRow(
 1258:           blockIndex: intent.blockIndex,
 1259:           rowIndex: range.endRow + 1,
 1260:         );
 1261:         return;
 1262:       case TableToolbarAction.deleteRow:
 1263:         for (var row = range.endRow; row >= range.startRow; row--) {
 1264:           final current = _tableBlockAt(intent.blockIndex);
 1265:           if (current == null || current.table.rowCount <= 1) {
 1266:             break;
 1267:           }
 1268:           widget.controller.deleteTableRow(
 1269:             blockIndex: intent.blockIndex,
 1270:             rowIndex: row,
 1271:           );
 1272:         }
 1273:         return;
 1274:       case TableToolbarAction.insertColumnBefore:
 1275:         widget.controller.insertTableColumn(
 1276:           blockIndex: intent.blockIndex,
 1277:           columnIndex: range.startColumn,
 1278:         );
 1279:         return;
 1280:       case TableToolbarAction.insertColumnAfter:
 1281:         widget.controller.insertTableColumn(
 1282:           blockIndex: intent.blockIndex,
 1283:           columnIndex: range.endColumn + 1,
 1284:         );
 1285:         return;
 1286:       case TableToolbarAction.deleteColumn:
 1287:         for (var column = range.endColumn;
 1288:             column >= range.startColumn;
 1289:             column--) {
 1290:           final current = _tableBlockAt(intent.blockIndex);
 1291:           if (current == null || current.table.columnCount <= 1) {
 1292:             break;
 1293:           }
 1294:           widget.controller.deleteTableColumn(
