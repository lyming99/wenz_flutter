 1168:   Offset _slashMenuOffset() {
 1169:     final fallback = widget.padding.resolve(TextDirection.ltr).topLeft;
 1170:     final selection = widget.controller.selection;
 1171:     final overlayContext = _editorOverlayKey.currentContext;
 1172:     final overlayBox = overlayContext?.findRenderObject();
 1173:     if (selection == null ||
 1174:         !selection.isCollapsed ||
 1175:         overlayBox is! RenderBox ||
 1176:         !overlayBox.hasSize) {
 1177:       return fallback;
 1178:     }
 1179:     final caret = _registry.caretRectForPosition(selection.extent);
 1180:     if (caret == null) {
 1181:       return fallback;
 1182:     }
 1183:     final local = overlayBox.globalToLocal(caret.bottomLeft);
 1184:     final maxLeft = overlayBox.size.width - 280;
 1185:     return Offset(
 1186:       local.dx.clamp(0, maxLeft > 0 ? maxLeft : 0).toDouble(),
 1187:       (local.dy + 6).clamp(0, overlayBox.size.height).toDouble(),
 1188:     );
 1189:   }
