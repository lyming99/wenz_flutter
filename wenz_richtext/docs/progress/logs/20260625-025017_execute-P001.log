      _ViewportAwareTableToolbarState();
}

class _ViewportAwareTableToolbarState
    extends State<_ViewportAwareTableToolbar> {
  double? _top;

  double get _effectiveTop => _top ?? widget.preferredTop;

  @override
  Widget build(BuildContext context) {
    WidgetsBinding.instance.addPostFrameCallback((_) => _syncTopWithViewport());
    return PositionedDirectional(
      top: _effectiveTop,
      start: 0,
      child: widget.child,
    );
  }

  void _syncTopWithViewport() {
    if (!mounted) {
      return;
    }
    final renderObject = context.findRenderObject();
    final scrollable = Scrollable.maybeOf(context);
    final viewportObject = scrollable?.context.findRenderObject();
    if (renderObject is! RenderBox ||
        !renderObject.hasSize ||
        viewportObject is! RenderBox ||
        !viewportObject.hasSize) {
      _setTopIfNeeded(widget.preferredTop);
      return;
    }
    final toolbarTop = renderObject.localToGlobal(Offset.zero).dy;
    final stackTop = toolbarTop - _effectiveTop;
    final viewportTop = viewportObject.localToGlobal(Offset.zero).dy;
    if (stackTop < viewportTop) {
      final visibleTop = viewportTop - stackTop;
      _setTopIfNeeded(math.max(widget.preferredTop, visibleTop));
      return;
    }
    _setTopIfNeeded(widget.preferredTop);
  }

  void _setTopIfNeeded(double nextTop) {
    if ((_effectiveTop - nextTop).abs() < 0.5) {
      return;
    }
    setState(() {
      _top = nextTop;
    });
  }
}

