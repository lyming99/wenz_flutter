 432: void _replaceCurrentBlock(
 433:   WenzRichTextController editor,
 434:   SlashMenuContext context,
 435:   BlockNode Function(TextBlockNode block) buildBlock,
 436:   DocumentSelection Function(BlockNode block) buildSelection,
 437: ) {
 438:   final index = context.blockIndex;
 439:   if (index < 0 || index >= editor.document.blocks.length) {
 440:     return;
 441:   }
 442:   final block = editor.document.blocks[index];
 443:   if (block is! TextBlockNode) {
 444:     return;
 445:   }
 446:   final nextBlock = buildBlock(block);
 447:   editor.replaceBlocks(
 448:     index: index,
 449:     deleteCount: 1,
 450:     blocks: <BlockNode>[nextBlock],
 451:     selection: buildSelection(nextBlock),
 452:   );
 453: }
 454: 
 455: SlashMenuTrigger? _detectTrigger(WenzRichTextController editor) {
 456:   if (!editor.canEdit) {
 457:     return null;
 458:   }
 459:   final selection = editor.selection;
 460:   if (selection == null || !selection.isCollapsed) {
 461:     return null;
 462:   }
 463:   final position = selection.extent;
 464:   if (!position.path.isBlockText) {
 465:     return null;
 466:   }
 467:   if (position.blockIndex < 0 ||
 468:       position.blockIndex >= editor.document.blocks.length) {
 469:     return null;
 470:   }
 471:   final block = editor.document.blocks[position.blockIndex];
 472:   if (block is! TextBlockNode) {
 473:     return null;
 474:   }
 475:   final text = block.plainText;
 476:   final caret = position.offset.clamp(0, text.length).toInt();
 477:   final slashStart = _slashStartBeforeCaret(text, caret);
 478:   if (slashStart == null) {
 479:     return null;
 480:   }
 481:   return SlashMenuTrigger(
 482:     blockId: block.id,
 483:     blockIndex: position.blockIndex,
 484:     path: position.path,
 485:     start: slashStart,
 486:     end: caret,
 487:     query: text.substring(slashStart + 1, caret),
 488:   );
 489: }
 490: 
 491: List<String> _blockIdsFor(List<BlockNode> blocks) {
 492:   return <String>[
 493:     for (final block in blocks) block.id,
 494:   ];
 495: }
 496: 
 497: int? _slashStartBeforeCaret(String text, int caret) {
 498:   var index = caret - 1;
 499:   while (index >= 0) {
 500:     final codeUnit = text.codeUnitAt(index);
 501:     if (_isQueryTerminator(codeUnit)) {
 502:       return null;
 503:     }
 504:     if (codeUnit == 0x2F) {
 505:       if (index == 0 || _isTriggerBoundary(text.codeUnitAt(index - 1))) {
 506:         return index;
 507:       }
 508:       return null;
 509:     }
 510:     index -= 1;
 511:   }
 512:   return null;
 513: }
 514: 
 515: bool _isQueryTerminator(int codeUnit) {
 516:   return codeUnit == 0x20 ||
 517:       codeUnit == 0x09 ||
 518:       codeUnit == 0x0A ||
 519:       codeUnit == 0x0D;
 520: }
 521: 
 522: bool _isTriggerBoundary(int codeUnit) {
 523:   return _isQueryTerminator(codeUnit);
 524: }
 525: 
 526: bool _sameTrigger(SlashMenuTrigger? a, SlashMenuTrigger? b) {
 527:   if (a == null || b == null) {
 528:     return a == b;
 529:   }
 530:   return a.blockId == b.blockId &&
 531:       a.blockIndex == b.blockIndex &&
 532:       a.path == b.path &&
 533:       a.start == b.start &&
 534:       a.end == b.end &&
 535:       a.query == b.query;
 536: }
