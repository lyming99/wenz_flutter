 140:   List<SlashMenuItem> get items => List<SlashMenuItem>.unmodifiable(_items);
 141:   List<SlashMenuItem> _items = const <SlashMenuItem>[];
 142: 
 143:   int get highlightedIndex => _highlightedIndex;
 144:   int _highlightedIndex = 0;
 145: 
 146:   bool get isOpen => _trigger != null && _items.isNotEmpty && !_closedManually;
 147: 
 148:   SlashMenuItem? get highlightedItem {
 149:     if (!isOpen ||
 150:         _highlightedIndex < 0 ||
 151:         _highlightedIndex >= _items.length) {
 152:       return null;
 153:     }
 154:     return _items[_highlightedIndex];
 155:   }
 156: 
 157:   bool _closedManually = false;
 158:   List<String> _documentBlockIds = const <String>[];
 159:   int _generatedSequence = 0;
 160: 
 161:   void attachEditor(WenzRichTextController editor) {
 162:     if (identical(_editor, editor)) {
 163:       return;
 164:     }
 165:     _editor.removeListener(_handleEditorChanged);
 166:     _editor = editor;
 167:     _editor.addListener(_handleEditorChanged);
 168:     refresh();
 169:   }
 170: 
 171:   void refresh() {
 172:     final nextDocumentBlockIds = _blockIdsFor(_editor.document.blocks);
 173:     final structureChanged =
 174:         !listEquals(_documentBlockIds, nextDocumentBlockIds);
 175:     final nextTrigger = _detectTrigger(_editor);
 176:     final sameTrigger = _sameTrigger(_trigger, nextTrigger);
 177:     final selectionOnlyTriggerChange =
 178:         _editor.lastChangedBlockIds?.isEmpty == true && !sameTrigger;
 179:     final closeForStructureChange = structureChanged && _trigger != null;
 180:     _documentBlockIds = nextDocumentBlockIds;
 181:     _trigger = nextTrigger;
 182:     if (closeForStructureChange || selectionOnlyTriggerChange) {
 183:       _closedManually = true;
 184:     } else if (!sameTrigger) {
 185:       _closedManually = false;
 186:     }
 187:     _items = nextTrigger == null
 188:         ? const <SlashMenuItem>[]
 189:         : registry.filter(nextTrigger.query);
 190:     if (_items.isEmpty) {
 191:       _highlightedIndex = 0;
 192:     } else if (_highlightedIndex >= _items.length) {
 193:       _highlightedIndex = _items.length - 1;
 194:     }
 195:     notifyListeners();
 196:   }
 197: 
 198:   void close() {
 199:     if (_closedManually) {
 200:       return;
 201:     }
 202:     _closedManually = true;
 203:     notifyListeners();
 204:   }
 205: 
 206:   void selectIndex(int index) {
 207:     if (_items.isEmpty) {
 208:       return;
 209:     }
 210:     final next = index.clamp(0, _items.length - 1).toInt();
 211:     if (next == _highlightedIndex) {
 212:       return;
 213:     }
 214:     _highlightedIndex = next;
 215:     notifyListeners();
 216:   }
 217: 
 218:   void moveHighlight(int delta) {
 219:     if (_items.isEmpty || delta == 0) {
 220:       return;
 221:     }
 222:     final next = (_highlightedIndex + delta) % _items.length;
 223:     _highlightedIndex = next < 0 ? next + _items.length : next;
 224:     notifyListeners();
 225:   }
 226: 
 227:   bool activateHighlighted() {
 228:     final item = highlightedItem;
 229:     if (item == null) {
 230:       return false;
 231:     }
 232:     return activate(item);
 233:   }
 234: 
 235:   bool activate(SlashMenuItem item) {
 236:     final activeTrigger = _trigger;
 237:     if (activeTrigger == null) {
 238:       return false;
 239:     }
 240:     _closedManually = true;
 241:     _editor.deleteSelection(activeTrigger.selection);
 242:     item.action(
 243:       _editor,
 244:       SlashMenuContext(
 245:         trigger: activeTrigger,
 246:         generatedId: _nextGeneratedId,
 247:       ),
 248:     );
 249:     _trigger = null;
 250:     _items = const <SlashMenuItem>[];
 251:     _highlightedIndex = 0;
 252:     notifyListeners();
 253:     return true;
 254:   }
 255: 
 256:   String _nextGeneratedId(String prefix) {
 257:     _generatedSequence += 1;
 258:     return '$prefix-${DateTime.now().microsecondsSinceEpoch}-$_generatedSequence';
 259:   }
 260: 
 261:   void _handleEditorChanged() {
 262:     refresh();
 263:   }
 264: 
