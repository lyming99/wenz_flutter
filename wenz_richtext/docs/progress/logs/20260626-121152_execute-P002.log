 120: class SlashMenuController extends ChangeNotifier {
 121:   SlashMenuController({
 122:     required WenzRichTextController editor,
 123:     SlashMenuRegistry? registry,
 124:   })  : _editor = editor,
 125:         registry = registry ?? SlashMenuRegistry.defaults() {
 126:     _editor.addListener(_handleEditorChanged);
 127:     refresh();
 128:   }
