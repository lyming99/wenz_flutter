 469:   void _syncSelection(TextSelection platformSelection) {
 470:     final selection = _controller.selection;
 471:     if (selection == null ||
 472:         platformSelection.baseOffset < 0 ||
 473:         platformSelection.extentOffset < 0) {
 474:       return;
 475:     }
 476:     final position = selection.extent;
 477:     final textLength = _plainTextForPosition(position).length;
 478:     final baseOffset =
 479:         platformSelection.baseOffset.clamp(0, textLength).toInt();
 480:     final extentOffset =
 481:         platformSelection.extentOffset.clamp(0, textLength).toInt();
 482:     final base = position.copyWith(offset: baseOffset);
 483:     final extent = position.copyWith(offset: extentOffset);
 484:     _controller.setSelection(DocumentSelection(base: base, extent: extent));
 485:   }
