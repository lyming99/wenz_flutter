 487:   void _syncComposition(TextRange composing) {
 488:     final selection = _controller.selection;
 489:     // Only TextRange.empty (start == -1) means "no composition". A collapsed
 490:     // range (start == end == n) is a valid composition region that simply has
 491:     // no characters yet — some IMEs emit it at the start/end of a session.
 492:     // Clearing it would drop the composition semantics mid-session; we keep it
 493:     // (it renders as a zero-width range, i.e. no underline, which is correct).
 494:     if (selection == null || composing == TextRange.empty) {
 495:       _controller.setCompositionState(null);
 496:       return;
 497:     }
 498:     final position = selection.extent;
 499:     final textLength = _plainTextForPosition(position).length;
 500:     final safeComposing = _clampTextRange(composing, textLength);
 501:     _controller.setCompositionState(
 502:       CompositionState(
 503:         blockId: position.blockId,
 504:         blockIndex: position.blockIndex,
 505:         path: position.path,
 506:         startOffset: safeComposing.start,
 507:         endOffset: safeComposing.end,
 508:       ),
 509:     );
 510:   }
