 525:     }
 526:     if (_applyDetachedCompositionEditingValue(value)) {
 527:       return;
 528:     }
 529:     final old = _buffer;
 530:     if (old.text != value.text) {
 531:       final diff = _TextDiff.between(old.text, value.text);
 532:       if (diff.oldStart < diff.oldEnd) {
 533:         _deleteRange(diff.oldStart, diff.oldEnd);
 534:       }
 535:       _placeCaretAt(diff.oldStart);
 536:       if (diff.replacement.isNotEmpty) {
 537:         _controller.insertText(diff.replacement);
 538:       }
 539:     }
 540:     _syncSelection(value.selection);
 541:     _syncComposition(value.composing);
 542:     _syncBuffer();
 543:   }
