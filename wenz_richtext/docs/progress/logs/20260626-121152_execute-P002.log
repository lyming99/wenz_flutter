  10: /// Bridges the platform text input (IME) to the editor document model.
  11: ///
  12: /// Uses the [DeltaTextInputClient] mixin so it receives [TextEditingDelta]
  13: /// streams, which describe precisely what the IME changed. Each delta is
  14: /// translated into editor commands on the bound [WenzRichTextController]; the
  15: /// composing region is mirrored to
  16: /// [WenzRichTextController.setCompositionState] for rendering.
  17: ///
  18: /// In addition to shuttling text deltas, the client reports the caret's
  19: /// geometry to the platform so the system IME (e.g. the Chinese pinyin
  20: /// candidate window) positions itself at the caret rather than at a default
  21: /// screen location. The widget layer supplies [caretRectProvider], which
  22: /// returns the caret's global [Rect]; it is pushed to the platform via
  23: /// [TextInputConnection.setEditableSizeAndTransform] on attach and whenever
  24: /// the caret moves.
  25: ///
  26: /// Scope (stage 1): IME edits target the caret's current editable block. The
  27: /// platform is shown a single-block plain-text buffer (the current block's
  28: /// text), so deltas map cleanly onto offsets within that block. Cross-block
  29: /// edits still go through the key-event path (Enter, arrows) which bypass IME.
  30: class EditorTextInputClient with DeltaTextInputClient {
  31:   EditorTextInputClient(this._controller);
  32: 
  33:   final WenzRichTextController _controller;
  34:   TextInputConnection? _connection;
  35: 
  36:   /// The buffer currently shown to the platform: the plain text of the
  37:   /// focused block plus the caret/composing regions expressed against it.
  38:   TextEditingValue _buffer = TextEditingValue.empty;
  39: 
  40:   /// Injected by the widget layer: returns the current caret's global [Rect]
  41:   /// (top-left + height), or `null` when no caret is visible. Used to position
  42:   /// the platform IME candidate window at the caret.
  43:   Rect? Function()? caretRectProvider;
  44: 
  45:   /// Injected by the widget layer: returns TextField-style geometry for the
  46:   /// active editable surface. Prefer this over [caretRectProvider] because the
  47:   /// platform expects the editable box transform plus local caret/composing
  48:   /// rects, not a caret-sized editable box.
  49:   EditorTextInputGeometry? Function()? textInputGeometryProvider;
  50: 
  51:   /// Injected by the widget layer: returns the [FlutterView.viewId] the editor
  52:   /// is currently attached to, or `null` when no view is resolvable yet (e.g.
  53:   /// before the editor is mounted). The platform text-input engine (notably
  54:   /// Android) rejects `setClient` with `PlatformException(Bad Arguments, ...
  55:   /// view ID is null)` when the [TextInputConfiguration.viewId] is missing, so
  56:   /// this must be populated before [attach] runs.
  57:   int? Function()? viewIdProvider;
  58: 
  59:   /// Injected by the widget layer: handles platform text-input selectors
  60:   /// (macOS/iOS-style commands such as `moveLeft:` or `deleteBackward:`).
  61:   /// The widget layer owns focus, read-only state, clipboard, and geometry, so
  62:   /// it is the right place to translate these selectors into editor commands.
  63:   void Function(String selectorName)? performSelectorHandler;
  64: 
  65:   bool get isAttached => _connection?.attached ?? false;
  66: 
  67:   /// Attaches to the platform text input, seeding the buffer from the
  68:   /// controller's current selection.
  69:   void attach() {
  70:     _syncBuffer();
  71:     if (_connection != null && _connection!.attached) {
  72:       _connection!.show();
  73:       _reportCaretGeometry();
  74:       return;
  75:     }
  76:     final viewId = viewIdProvider?.call();
  77:     _lastViewId = viewId;
  78:     _connection = TextInput.attach(
  79:       this,
  80:       TextInputConfiguration(
 487:   void _syncComposition(TextRange composing) {
 488:     final selection = _controller.selection;
 489:     // Only TextRange.empty (start == -1) means "no composition". A collapsed
 490:     // range (start == end == n) is a valid composition region that simply has
 491:     // no characters yet — some IMEs emit it at the start/end of a session.
 492:     // Clearing it would drop the composition semantics mid-session; we keep it
 493:     // (it renders as a zero-width range, i.e. no underline, which is correct).
 494:     if (selection == null || composing == TextRange.empty) {
 495:       _controller.setCompositionState(null);
 496:       return;
 497:     }
 498:     final position = selection.extent;
 499:     final textLength = _plainTextForPosition(position).length;
 500:     final safeComposing = _clampTextRange(composing, textLength);
 501:     _controller.setCompositionState(
 502:       CompositionState(
 503:         blockId: position.blockId,
 504:         blockIndex: position.blockIndex,
 505:         path: position.path,
 506:         startOffset: safeComposing.start,
 507:         endOffset: safeComposing.end,
 508:       ),
 509:     );
 510:   }
 511: 
 512:   // ---- TextInputClient ----
 513: 
 514:   @override
 515:   void updateEditingValue(TextEditingValue value) {
 516:     // Non-delta fallback. Some desktop IMEs still exercise this path during
 517:     // composition, so handle it like EditableText: diff the previous editing
 518:     // value against the new one and apply only the changed span.
 519:     final activeSelection = _controller.selection;
 520:     if (activeSelection != null &&
 521:         !activeSelection.isCollapsed &&
 522:         !_isSingleTextInputTarget(activeSelection)) {
 523:       _replaceCrossTargetSelectionFromEditingValue(activeSelection, value);
 524:       return;
 525:     }
 526:     if (_applyDetachedCompositionEditingValue(value)) {
 527:       return;
 528:     }
 529:     final old = _buffer;
 530:     if (old.text != value.text) {
 531:       final diff = _TextDiff.between(old.text, value.text);
 532:       if (diff.oldStart < diff.oldEnd) {
 533:         _deleteRange(diff.oldStart, diff.oldEnd);
 534:       }
 535:       _placeCaretAt(diff.oldStart);
 536:       if (diff.replacement.isNotEmpty) {
 537:         _controller.insertText(diff.replacement);
 538:       }
 539:     }
 540:     _syncSelection(value.selection);
 541:     _syncComposition(value.composing);
 542:     _syncBuffer();
 543:   }
 544: 
 545:   void _replaceCrossTargetSelectionFromEditingValue(
 546:     DocumentSelection selection,
 547:     TextEditingValue value,
 548:   ) {
 549:     final shift = selection.start.offset;
 550:     if (value.text.isEmpty) {
 551:       _controller.deleteSelection(selection);
 552:     } else {
 553:       _controller.insertText(value.text);
 554:     }
 555:     _syncSelection(_shiftSelection(value.selection, shift));
 556:     _syncComposition(_shiftRange(value.composing, shift));
 557:     _syncBuffer();
 558:   }
 559: 
 560:   bool _applyDetachedCompositionEditingValue(TextEditingValue value) {
 561:     final composition = _controller.compositionState;
 562:     final selection = _controller.selection;
 563:     if (composition == null ||
 564:         selection == null ||
 565:         _buffer.text == value.text) {
 566:       return false;
 567:     }
 568:     final position = selection.extent;
 569:     if (composition.blockId != position.blockId ||
 570:         composition.blockIndex != position.blockIndex ||
 571:         composition.path != position.path) {
 572:       return false;
 573:     }
 574: 
 575:     final currentText = _plainTextForPosition(position);
