-String _fileDetailText(FileBlockNode file) {
-  final uploadError = file.uploadError.trim();
-  if (file.uploadStatus == FileUploadStatus.failed) {
-    return uploadError.isEmpty ? 'Upload failed' : uploadError;
-  }
-  if (file.uploadStatus == FileUploadStatus.uploading) {
-    return 'Upload in progress';
-  }
-  if (file.uploadStatus == FileUploadStatus.pending) {
-    return 'Waiting to upload';
-  }
-  if (file.effectiveDownloadUrl.isNotEmpty) {
-    return file.effectiveDownloadUrl;
-  }
-  if (file.assetId.isNotEmpty) {
-    return file.assetId;
-  }
-  return 'File attachment';
-}
