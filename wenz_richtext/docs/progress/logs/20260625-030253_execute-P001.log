 4479:   if (selection == null || selection.isCollapsed) {
 4480:     return false;
 4481:   }
 4482:   // Intra-table cell range (drag within the table): highlight cells inside the
 4483:   // range via the structured TableCellRange.
 4484:   final range = selection.tableCellRange;
 4485:   if (range != null) {
 4486:     if (range.isSingleCell) {
 4487:       return false;
 4488:     }
 4489:     return range.tableBlockId == tableBlockId &&
 4490:         range.blockIndex == blockIndex &&
 4491:         range.containsCell(rowIndex, columnIndex);
 4492:   }
 4493:   // Cross-block selection that spans this table block (e.g. select-all across
 4494:   // a paragraph + table): when the table block sits strictly between the
 4495:   // selection endpoints, every cell is part of the selection and highlights.
 4496:   final start = selection.start;
 4497:   final end = selection.end;
 4498:   final tableCovered =
 4499:       start.blockIndex < blockIndex && end.blockIndex > blockIndex;
 4500:   if (tableCovered) {
 4501:     return true;
 4502:   }
 4503:   final cellPath = PositionPath.tableCellText(
 4504:     tableBlockId,
 4505:     rowIndex,
 4506:     columnIndex,
 4507:   );
 4508:   if (start.blockIndex == blockIndex &&
 4509:       start.path.isTableCellText &&
 4510:       end.blockIndex > blockIndex) {
 4511:     return start.blockId == tableBlockId && cellPath.compare(start.path) > 0;
 4512:   }
 4513:   if (end.blockIndex == blockIndex &&
 4514:       end.path.isTableCellText &&
 4515:       start.blockIndex < blockIndex) {
 4516:     return end.blockId == tableBlockId && cellPath.compare(end.path) < 0;
 4517:   }
 4518:   return false;
 4519: }
