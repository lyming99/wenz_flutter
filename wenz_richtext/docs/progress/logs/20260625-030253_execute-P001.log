-List<String> _codeLanguageOptions(String current) {
-  if (current.isEmpty || _kDefaultCodeLanguages.contains(current)) {
-    return _kDefaultCodeLanguages;
-  }
-  return <String>[current, ..._kDefaultCodeLanguages];
-}
