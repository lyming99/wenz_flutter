 4370: List<double> _resolveTableColumnWidths(TableModel table, double maxWidth) {
 4371:   final columnCount = table.columnCount;
 4372:   final widths = List<double>.filled(columnCount, 0);
 4373:   var fixedWidth = 0.0;
 4374:   var flexCount = 0;
 4375:   for (var i = 0; i < columnCount; i++) {
 4376:     final explicit = table.columnWidths[i];
 4377:     if (explicit != null && explicit > 0) {
 4378:       widths[i] = explicit;
 4379:       fixedWidth += explicit;
 4380:     } else {
 4381:       flexCount += 1;
 4382:     }
 4383:   }
 4384:   if (flexCount == 0) {
 4385:     return widths;
 4386:   }
 4387:   final remaining = maxWidth - fixedWidth;
 4388:   final flexWidth = remaining > 0 ? remaining / flexCount : 80.0;
 4389:   for (var i = 0; i < columnCount; i++) {
 4390:     if (widths[i] == 0) {
 4391:       widths[i] = flexWidth;
 4392:     }
 4393:   }
 4394:   return widths;
 4395: }
