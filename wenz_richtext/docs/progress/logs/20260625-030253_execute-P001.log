-const List<String> _kDefaultCodeLanguages = <String>[
-  '',
-  'dart',
-  'javascript',
-  'typescript',
-  'python',
-  'java',
-  'kotlin',
-  'swift',
-  'go',
-  'rust',
-  'sql',
-  'json',
-  'yaml',
-  'html',
-  'css',
-  'markdown',
-  'bash',
-];
