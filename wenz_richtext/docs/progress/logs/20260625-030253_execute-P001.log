+      widget.selection,
+      widget.blockIndex,
+      widget.path,
+      widget.textLength,
+    );
+    final caretOffset = _caretOffsetForPath(
+      widget.selection,
+      widget.showCaret,
+      widget.blockId,
+      widget.path,
+      widget.textLength,
+    );
+    final theme = Theme.of(context);
+    final highlightColor = theme.colorScheme.primary.withAlpha(54);
+    final findHighlightColor = theme.colorScheme.tertiaryContainer.withAlpha(
