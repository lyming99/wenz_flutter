+            _lastScrollCheckedCaret = caretKey;
+            if (!skipCaretScroll) {
+              _scrollCaretIntoView();
+            }
+          }
+        } else {
+          _skipNextCaretScrollIntoView = false;
+          _lastScrollCheckedCaret = null;
+        }
+      });
+      setState(() {});
+    }
+  }
