-        backgroundColor: scheme.secondaryContainer.withAlpha(90),
-        fontFamily: 'monospace',
-      ),
-    'emoji' => style,
-    _ => style.copyWith(
-        color: scheme.onSurfaceVariant,
-        fontStyle: FontStyle.italic,
