-              child: RichText(
-                text: widget.textSpan,
-                textAlign: widget.textAlign,
-                textDirection: direction,
-              ),
-            ),
-          ),
-        );
-        // Keep the blink timer in step with whether the caret is showing.
-        // Deferred to post-frame so we do not mutate timer state mid-build.
