-Size _inlineFormulaPlaceholderSize(String formula, TextStyle style) {
-  final fontSize = style.fontSize ?? 14;
-  final runeCount = formula.trim().isEmpty ? 7 : formula.runes.length;
-  final width = math.max(
-    fontSize * 2.2,
-    math.min(fontSize * 28, runeCount * fontSize * 0.62 + 12),
-  );
-  return Size(width, fontSize * 1.65);
-}
