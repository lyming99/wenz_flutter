 4397: double _measureTableCellHeight(
 4398:   TableCellNode cell,
 4399:   TextStyle textStyle,
 4400:   TextDirection textDirection,
 4401:   double cellWidth,
 4402: ) {
 4403:   final effectiveTextStyle = cell.isHeader
 4404:       ? textStyle.copyWith(fontWeight: FontWeight.w600)
 4405:       : textStyle;
 4406:   final text = _tableCellDisplayText(cell);
 4407:   final displayText = text.isEmpty ? ' ' : text;
 4408:   final innerWidth = cellWidth - 16;
 4409:   final painter = TextPainter(
 4410:     text: TextSpan(text: displayText, style: effectiveTextStyle),
 4411:     textAlign: TextAlign.start,
 4412:     textDirection: textDirection,
 4413:   )..layout(maxWidth: innerWidth > 0 ? innerWidth : 0);
 4414:   final height = painter.height + 16;
 4415:   painter.dispose();
 4416:   final minimum = _minimumTableCellHeight(textStyle);
 4417:   return height > minimum ? height : minimum;
 4418: }
