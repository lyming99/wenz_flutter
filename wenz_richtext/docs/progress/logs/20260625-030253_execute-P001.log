-    return _TableGridMetrics(
-      width: _sumTableRange(columnWidths, 0, columnWidths.length),
-      height: _sumTableRange(rowHeights, 0, rowHeights.length),
-      columnWidths: columnWidths,
-      columnLefts: lefts,
-      cells: cells,
