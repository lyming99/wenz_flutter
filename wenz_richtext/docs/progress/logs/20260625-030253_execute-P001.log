-List<FindReplaceMatch> _matchesForBlock(
-  List<FindReplaceMatch> matches,
-  int blockIndex,
-) {
-  if (matches.isEmpty) {
-    return const <FindReplaceMatch>[];
-  }
-  return <FindReplaceMatch>[
-    for (final match in matches)
-      if (match.blockIndex == blockIndex) match,
-  ];
