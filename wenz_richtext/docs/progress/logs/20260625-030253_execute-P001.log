+      widget.selection,
+      widget.blockIndex,
+      widget.path,
+      widget.textLength,
+    );
+    final caretOffset = _caretOffsetForPath(
+      widget.selection,
+      widget.showCaret,
+      widget.blockId,
+      widget.path,
+      widget.textLength,
