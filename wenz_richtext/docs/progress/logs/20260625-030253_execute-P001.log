-  return baseStyle.copyWith(
-    color: Theme.of(context).colorScheme.onSurfaceVariant,
-    decoration: decoration == null
-        ? TextDecoration.lineThrough
-        : TextDecoration.combine(<TextDecoration>[
-            decoration,
-            TextDecoration.lineThrough,
-          ]),
-  );
