 4420: List<InlineNode> _tableCellInlineContent(TableCellNode? cell) {
 4421:   if (cell == null) {
 4422:     return const <InlineNode>[];
 4423:   }
 4424:   for (final block in cell.blocks) {
 4425:     if (block is TextBlockNode) {
 4426:       return block.content;
 4427:     }
 4428:   }
 4429:   return <InlineNode>[TextRun(text: cell.plainText)];
 4430: }
