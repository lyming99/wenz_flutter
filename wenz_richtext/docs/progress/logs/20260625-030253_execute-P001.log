-            readOnly: widget.readOnly,
-            onSelectionChanged: _handleSelectionChanged,
-            onTapBeyondContent: _handleTapBeyondContent,
-            child: editor,
-          ),
-          if (widget.slashMenuController?.isOpen == true)
-            Positioned(
-              left: _slashMenuOffset().dx,
-              top: _slashMenuOffset().dy,
