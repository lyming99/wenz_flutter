+      widget.registry.unregister(oldWidget.blockId, oldWidget.path);
+    }
+    if (oldWidget.blockId != widget.blockId ||
+        oldWidget.blockIndex != widget.blockIndex ||
+        oldWidget.path != widget.path ||
