import 'attributes.dart';
import 'inline_node.dart';
import 'table_model.dart';

enum BlockType {
  paragraph('paragraph'),
  heading('heading'),
  quote('quote'),
  listItem('listItem'),
  code('code'),
  image('image'),
  table('table'),
  divider('divider'),
  video('video'),
  embed('embed'),
  callout('callout'),
  file('file');

  const BlockType(this.name);

  final String name;

  static BlockType parse(Object? value) {
    final text = value?.toString();
    return BlockType.values.firstWhere(
      (type) => type.name == text,
      orElse: () => BlockType.paragraph,
    );
  }
}

enum FileUploadStatus {
  none('none'),
  pending('pending'),
  uploading('uploading'),
  uploaded('uploaded'),
  failed('failed');

  const FileUploadStatus(this.name);


