+  final SharedTextLayoutCache cache;
+
+  static SharedTextLayoutCache? of(BuildContext context) {
+    final scope =
+        context.dependOnInheritedWidgetOfExactType<_SharedLayoutCacheScope>();
+    return scope?.cache;
