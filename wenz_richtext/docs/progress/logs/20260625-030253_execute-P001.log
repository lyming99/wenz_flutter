+                  border: Border.all(color: selectedColor, width: 2),
+                  borderRadius: BorderRadius.circular(6),
+                ),
+              ),
+            ),
+          ),
+        if (widget.showDebugOverlay)
+          Positioned(
+            top: 0,
+            right: 0,
+            child: IgnorePointer(
+              child: _DebugSelectionTag(
+                blockId: widget.blockId,
+                blockIndex: widget.blockIndex,
+                path: widget.path,
+                offset: debugOffset,
