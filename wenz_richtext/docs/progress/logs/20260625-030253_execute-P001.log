-  /// tolerate that — the attach path still works on platforms that do not
-  /// enforce the viewId contract.
-  int? _resolveViewId() {
-    if (!mounted) {
-      return null;
-    }
-    final context = this.context;
-    return View.maybeOf(context)?.viewId;
-  }
