-  @override
-  Widget build(BuildContext context) {
-    final isTaskListItem =
-        block.type == BlockType.listItem && block.attributes.listType == 'task';
-    final isTaskChecked = block.attributes.checked == true;
-    final baseStyle = _blockTextStyle(
-      context,
-      block,
