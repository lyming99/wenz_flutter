+            registry: _registry,
+            scrollController: _scrollController,
+            focusNode: focusNode,
+            readOnly: widget.readOnly,
+            onSelectionChanged: _handleSelectionChanged,
+            onTapBeyondContent: _handleTapBeyondContent,
