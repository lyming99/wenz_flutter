4732:  /// (Re)arms the blink timer with the caret forced visible. Called when the
4733:  /// caret first becomes visible, and again on every selection change while it
4734:  /// stays visible, so the caret snaps back to its visible phase instead of
4735:  /// possibly lingering in the hidden half-cycle.
4736:  void _startBlinkTimer() {
4737:    _blinkActive = true;
4738:    _blinkValue = 1.0;
