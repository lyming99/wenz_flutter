4:/// Single-block text layout cache.
5:///
6:/// Wraps a [TextPainter] and caches the laid-out instance keyed by
7:/// `(span, textAlign, direction, maxWidth)`. Consumers within a single
8:/// `_TextSelectionSurface` call [layout] repeatedly (caret placement, hit
9:/// testing, selection boxes, painting) for the same content each frame;
10:/// caching avoids re-creating and re-laying-out the painter on every call.
11:///
12:/// Scope (stage 0): single block only. Cross-block selection layout is a
13:/// stage 2 concern. This class is internal — it is not exported from the
14:/// public package API until the layout layer stabilises.
15:@internal
16:class TextLayoutService {
17:  TextLayoutData? _cache;
18:
19:  /// Returns a laid-out [TextPainter] for the given inputs, reusing a cached
20:  /// instance when all inputs match.
21:  TextPainter layout({
22:    required InlineSpan span,
23:    required TextAlign textAlign,
24:    required TextDirection textDirection,
25:    required double maxWidth,
26:  }) {
27:    final cache = _cache;
28:    if (cache != null &&
29:        cache.span == span &&
30:        cache.textAlign == textAlign &&
31:        cache.textDirection == textDirection &&
32:        cache.maxWidth == maxWidth) {
33:      return cache.painter;
34:    }
35:    final painter = TextPainter(
36:      text: span,
37:      textAlign: textAlign,
38:      textDirection: textDirection,
39:    )..layout(maxWidth: maxWidth);
40:    _cache = TextLayoutData(
41:      span: span,
42:      textAlign: textAlign,
43:      textDirection: textDirection,
44:      maxWidth: maxWidth,
45:      painter: painter,
46:    );
47:    return painter;
48:  }
49:
50:  /// Caret top-left for [offset].
51:  Offset caretOffset(TextPainter painter, int offset) {
52:    return painter.getOffsetForCaret(TextPosition(offset: offset), Rect.zero);
53:  }
54:
55:  /// Caret height for [offset], or `null` when unavailable.
56:  double? caretHeight(TextPainter painter, int offset) {
57:    return painter.getFullHeightForCaret(
58:      TextPosition(offset: offset),
59:      Rect.zero,
60:    );
61:  }
62:
63:  /// Character offset under [localPosition].
64:  int offsetAt(TextPainter painter, Offset localPosition, int textLength) {
65:    final position = painter.getPositionForOffset(localPosition);
66:    return position.offset.clamp(0, textLength).toInt();
67:  }
68:
69:  /// Selection highlight boxes for [start, end).
70:  List<TextBox> selectionBoxes(TextPainter painter, int start, int end) {
71:    return painter.getBoxesForSelection(
72:      TextSelection(baseOffset: start, extentOffset: end),
73:    );
74:  }
75:
76:  /// Returns the word range covering [offset] using the platform text
77:  /// segmentation exposed by [TextPainter.getWordBoundary]. This handles
78:  /// CJK and locale-specific boundaries, which a hand-rolled ASCII rule
79:  /// cannot. Used by double-click select-word.
80:  TextRange wordRangeAt(TextPainter painter, int offset) {
81:    final clamped = offset.clamp(0, _textLength(painter)).toInt();
82:    return painter.getWordBoundary(TextPosition(offset: clamped));
83:  }
84:
85:  /// Returns the full editable range of the block. Stage 2 treats a "paragraph"
86:  /// as a single block (the block itself is the paragraph unit); triple-click
87:  /// selects the whole block.
88:  TextRange paragraphRange(TextPainter painter) {
89:    return TextRange(start: 0, end: _textLength(painter));
90:  }
91:
92:  /// Resolves the caret offset one visual line up ([forward] = false) or down
93:  /// ([forward] = true) from [offset], keeping the horizontal position at
94:  /// [preferX] (the remembered column for repeated vertical moves).
95:  ///
96:  /// Returns:
97:  /// - the new offset if a neighbouring visual line exists within this block;
98:  /// - `null` if the caret is already on the first (Up) / last (Down) line and
99:  ///   the caller should fall back to cross-block / boundary motion.
100:  int? verticalMoveOffset(
101:    TextPainter painter,
102:    int offset,
103:    bool forward, {
104:    double? preferX,
105:  }) {
106:    final textLength = _textLength(painter);
107:    final clamped = offset.clamp(0, textLength).toInt();
108:    final caret = painter.getOffsetForCaret(
109:      TextPosition(offset: clamped),
110:      Rect.zero,
111:    );
112:    // preferX is in the painter's LOCAL coordinate space (same as caret).
113:    final prefer = preferX ?? caret.dx;
114:    // Use exact line metrics to find the current line and step to the neighbour.
115:    // Estimating with caret.dy ± lineHeight is imprecise at line boundaries
116:    // (leading/strut shifts the caret y off the line's top), so getPositionForOffset
117:    // resolves back to the same line.
118:    final metrics = painter.computeLineMetrics();
119:    if (metrics.isEmpty) {
120:      return null;
121:    }
122:    int currentIndex = -1;
123:    for (var i = 0; i < metrics.length; i++) {
124:      final m = metrics[i];
125:      if (caret.dy >= m.baseline - m.height && caret.dy <= m.baseline + 1) {
126:        currentIndex = i;
127:        break;
128:      }
129:    }
130:    if (currentIndex < 0) {
131:      // Fallback: pick the line whose top is nearest the caret.
132:      currentIndex = 0;
133:      var bestDelta = (caret.dy - metrics[0].baseline).abs();
134:      for (var i = 1; i < metrics.length; i++) {
135:        final d = (caret.dy - metrics[i].baseline).abs();
136:        if (d < bestDelta) {
137:          bestDelta = d;
138:          currentIndex = i;
139:        }
140:      }
141:    }
142:    final targetIndex = forward ? currentIndex + 1 : currentIndex - 1;
143:    if (targetIndex < 0 || targetIndex >= metrics.length) {
144:      return null; // at the first/last line: caller crosses blocks
145:    }
146:    final targetLine = metrics[targetIndex];
147:    final pos = painter.getPositionForOffset(
148:      Offset(prefer, targetLine.baseline - targetLine.height / 2),
149:    );
150:    final next = pos.offset.clamp(0, textLength).toInt();
151:    if (next == clamped) {
152:      return null;
153:    }
154:    return next;
155:  }
156:
157:  /// Returns the caret's LOCAL x for [offset] (painter coordinate space), used
158:  /// to seed the remembered column for repeated vertical moves.
159:  double caretLocalX(TextPainter painter, int offset) {
160:    final clamped = offset.clamp(0, _textLength(painter)).toInt();
161:    return painter.getOffsetForCaret(TextPosition(offset: clamped), Rect.zero).dx;
162:  }
163:
164:  int _textLength(TextPainter painter) {
165:    return painter.text?.toPlainText().length ?? 0;
166:  }
167:
168:  /// Drop the cached painter (e.g. when the owning surface is disposed).
169:  void forget() {
170:    _cache = null;
171:  }
172:}
