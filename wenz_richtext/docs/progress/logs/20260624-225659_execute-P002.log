63:List<InlineNode> deleteInline(List<InlineNode> nodes, int start, int end) {
64:  if (end <= start) {
65:    return nodes.map((node) => node.copy()).toList();
66:  }
67:
68:  final result = <InlineNode>[];
69:  var cursor = 0;
70:  for (final node in nodes) {
71:    final nodeStart = cursor;
72:    final nodeEnd = cursor + inlineLength(node);
73:    cursor = nodeEnd;
74:
75:    if (nodeEnd <= start || nodeStart >= end) {
76:      result.add(node.copy());
77:      continue;
78:    }
79:
80:    if (node is! TextRun) {
81:      continue;
82:    }
83:
84:    final keepBefore = (start - nodeStart).clamp(0, node.text.length);
85:    final keepAfter = (end - nodeStart).clamp(0, node.text.length);
86:    final before = node.text.substring(0, keepBefore);
87:    final after = node.text.substring(keepAfter);
88:    if (before.isNotEmpty) {
89:      result.add(TextRun(text: before, attributes: node.attributes));
90:    }
91:    if (after.isNotEmpty) {
92:      result.add(TextRun(text: after, attributes: node.attributes));
93:    }
94:  }
95:
96:  return mergeTextRuns(result);
97:}
