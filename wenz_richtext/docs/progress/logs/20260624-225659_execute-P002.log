4785:  /// Maps a tap offset in the registered hit-test frame's local space into
4786:  /// this surface's text-local space. Only used when a separate [hitTestKey]
4787:  /// was provided (table cells); otherwise the registry treats the text
4788:  /// surface itself as the hit-test box and this is never called.
4789:  ///
4790:  /// Resolves both render boxes at hit-test time and adds the global delta
4791:  /// between them — robust to padding and to the vertical centring gap that
4792:  /// `TableCellVerticalAlignment.middle` introduces for short cells.
4793:  Offset _hitLocalToTextLocal(Offset hitLocal) {
4794:    final hitKey = widget.hitTestKey;
4795:    if (hitKey == null) {
4796:      return hitLocal;
4797:    }
4798:    final cellBox = hitKey.currentContext?.findRenderObject();
4799:    final textBox = _surfaceKey.currentContext?.findRenderObject();
4800:    if (cellBox is! RenderBox || textBox is! RenderBox) {
4801:      // Layout not ready: fall back to stripping the known 8px cell padding.
4802:      // There is no centring correction here, but this path is only hit
4803:      // before first layout and is strictly better than the raw offset.
4804:      return hitLocal - const Offset(8, 8);
4805:    }
4806:    final cellOrigin = cellBox.localToGlobal(Offset.zero);
4807:    final textOrigin = textBox.localToGlobal(Offset.zero);
4808:    // hitLocal is cell-relative; convert to text-surface-relative. Since both
4809:    // boxes share global space: textLocal = hitLocal + (cellOrigin - textOrigin).
4810:    // (cellOrigin < textOrigin because the text sits inside the padding, so this
4811:    // subtracts the padding/centring offset, landing the tap on the text.)
4812:    final textLocal = hitLocal +
4813:        Offset(cellOrigin.dx - textOrigin.dx, cellOrigin.dy - textOrigin.dy);
4814:    // Clamp into the text surface so an off-text tap (e.g. a bottom gutter
4815:    // below a centred short cell) maps to the nearest caret edge rather than a
4816:    // point outside the painter's line metrics.
4817:    return Offset(
4818:      textLocal.dx.clamp(0, textBox.size.width),
4819:      textLocal.dy.clamp(0, textBox.size.height),
4820:    );
4821:  }
