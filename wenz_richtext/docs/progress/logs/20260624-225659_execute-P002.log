205:InlineSplit splitInline(List<InlineNode> nodes, int offset) {
206:  final before = <InlineNode>[];
207:  final after = <InlineNode>[];
208:  var cursor = 0;
209:
210:  for (final node in nodes) {
211:    final nodeStart = cursor;
212:    final nodeEnd = cursor + inlineLength(node);
213:    cursor = nodeEnd;
214:
215:    if (nodeEnd <= offset) {
216:      before.add(node.copy());
217:      continue;
218:    }
219:    if (nodeStart >= offset) {
220:      after.add(node.copy());
221:      continue;
222:    }
223:
224:    if (node is TextRun) {
225:      final local = offset - nodeStart;
226:      final left = node.text.substring(0, local);
227:      final right = node.text.substring(local);
228:      if (left.isNotEmpty) {
229:        before.add(TextRun(text: left, attributes: node.attributes));
230:      }
231:      if (right.isNotEmpty) {
232:        after.add(TextRun(text: right, attributes: node.attributes));
233:      }
234:    } else {
235:      after.add(node.copy());
236:    }
237:  }
238:
239:  return InlineSplit(
240:    before: mergeTextRuns(before),
241:    after: mergeTextRuns(after),
242:  );
243:}
