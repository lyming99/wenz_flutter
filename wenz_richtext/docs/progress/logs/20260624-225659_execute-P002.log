245:List<InlineNode> mergeTextRuns(List<InlineNode> nodes) {
246:  final result = <InlineNode>[];
247:  for (final node in nodes) {
248:    if (node is TextRun &&
249:        result.isNotEmpty &&
250:        result.last is TextRun &&
251:        (result.last as TextRun).attributes == node.attributes) {
252:      final previous = result.removeLast() as TextRun;
253:      result.add(
254:        TextRun(
255:          text: previous.text + node.text,
256:          attributes: previous.attributes,
257:        ),
258:      );
259:    } else {
260:      result.add(node);
261:    }
262:  }
263:  return result;
264:}
